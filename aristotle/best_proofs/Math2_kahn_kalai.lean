import Mathlib

/-!
# Kahn Kalai
Category: Frontier Math
Target: Math2.kahn_kalai
Verification: pending
Provenance: Aristotle theorem prover (Harmonic)

## Contents

This file sets up the finite-probability framework in which the Kahn–Kalai conjecture
(a theorem of Park and Pham) is stated: for a finite ground set `X`, `mu X p F` is the
probability that the `p`-random subset of `X` belongs to the family `F`, `upClosure X H`
is the increasing family generated by `H`, and `IsSmall q H` says that `H` is `q`-small
in the sense of Kahn and Kalai (it admits a cover of `q`-cost at most `1/2`).
`expThreshold H` is the resulting expectation threshold and `critProb X F` the critical
probability.

## Scope of what is proved

* `Math2.expThreshold_le_critProb`: for **arbitrary** families, `expThreshold H ≤ critProb`.
  This is the easy half of the comparison; it rests on the exact computation of the
  probability that the `p`-random set contains a fixed set (`Math2.sum_supersets`) together
  with a union bound (`Math2.mu_le_sum_of_covers`).
* `Math2.critProb_le_two_mul_expThreshold`: for families of **pairwise disjoint**
  generators, `critProb ≤ 2 * expThreshold`; here no logarithmic factor is needed.  This uses
  the exact product formula `Math2.mu_upClosure_disjoint`, which is proved from a
  factorisation of the product measure over disjoint blocks (`Math2.mu_split`).
* `Math2.kahn_kalai` packages the two bounds in the Kahn–Kalai shape
  `critProb ≤ K * expThreshold * log₂ (2ℓ)` with the universal constant `K = 2`.
* `Math2.kahn_kalai_one_bounded`: the two-sided comparison for all `1`-bounded families,
  with no further hypotheses.

The general Kahn–Kalai conjecture (the theorem of Park and Pham), i.e. the upper bound
`critProb ≤ K * expThreshold * log₂ (2ℓ)` for arbitrary `ℓ`-bounded families, is **not**
formalised here; it is recorded as a comment at the end of the file.
-/

open Finset

namespace Math2

variable {α : Type} [DecidableEq α]

/-! ## Basic definitions -/

/-- `mu X p F` is the probability that the `p`-random subset of the finite ground set `X`
(each element of `X` included independently with probability `p`) lies in the family `F`. -/
noncomputable def mu (X : Finset α) (p : ℝ) (F : Finset (Finset α)) : ℝ :=
  ∑ S ∈ F, p ^ S.card * (1 - p) ^ (X.card - S.card)

/-- The increasing family generated by `H` inside the powerset of `X`. -/
def upClosure (X : Finset α) (H : Finset (Finset α)) : Finset (Finset α) :=
  X.powerset.filter (fun S => ∃ h ∈ H, h ⊆ S)

/-- `H` is `q`-small (Kahn–Kalai): there is a family `G` covering `H` from below
(every member of `H` contains a member of `G`) whose total `q`-cost `∑ q ^ |g|` is at
most `1/2`. The expectation threshold of `H` is the supremum of all such `q`. -/
def IsSmall (q : ℝ) (H : Finset (Finset α)) : Prop :=
  ∃ G : Finset (Finset α), (∀ h ∈ H, ∃ g ∈ G, g ⊆ h) ∧ ∑ g ∈ G, q ^ g.card ≤ 1 / 2

/-! ## The product measure -/

/-- The Bernoulli weights on the powerset of `X` sum to `1`. -/
theorem sum_powerset_bernoulli (X : Finset α) (p : ℝ) :
    ∑ S ∈ X.powerset, p ^ S.card * (1 - p) ^ (X.card - S.card) = 1 := by
  have h := Finset.prod_add (fun _ : α => p) (fun _ => 1 - p) X
  simp only [Finset.prod_const, Finset.card_sdiff] at h
  have h1 : (p + (1 - p)) ^ X.card = 1 := by norm_num
  rw [h1] at h
  conv_rhs => rw [h]
  refine Finset.sum_congr rfl ?_
  intro S hS
  rw [Finset.mem_powerset] at hS
  rw [Finset.inter_eq_left.mpr hS]

theorem mu_powerset (X : Finset α) (p : ℝ) : mu X p X.powerset = 1 :=
  sum_powerset_bernoulli X p

/-- The probability that the `p`-random subset of `X` contains a fixed set `g ⊆ X`
is `p ^ |g|`. -/
theorem sum_supersets (X g : Finset α) (hg : g ⊆ X) (p : ℝ) :
    ∑ S ∈ X.powerset.filter (fun S => g ⊆ S), p ^ S.card * (1 - p) ^ (X.card - S.card)
      = p ^ g.card := by
  have key : ∑ S ∈ X.powerset.filter (fun S => g ⊆ S), p ^ S.card * (1 - p) ^ (X.card - S.card)
      = ∑ T ∈ (X \ g).powerset, p ^ g.card * (p ^ T.card * (1 - p) ^ ((X \ g).card - T.card)) := by
    refine Finset.sum_nbij' (fun S => S \ g) (fun T => T ∪ g) ?_ ?_ ?_ ?_ ?_
    · intro S hS
      simp only [Finset.mem_filter, Finset.mem_powerset] at hS ⊢
      exact Finset.sdiff_subset_sdiff hS.1 (le_refl g)
    · intro T hT
      simp only [Finset.mem_powerset] at hT
      simp only [Finset.mem_filter, Finset.mem_powerset]
      exact ⟨Finset.union_subset (hT.trans Finset.sdiff_subset) hg, Finset.subset_union_right⟩
    · intro S hS
      simp only [Finset.mem_filter, Finset.mem_powerset] at hS
      exact Finset.sdiff_union_of_subset hS.2
    · intro T hT
      simp only [Finset.mem_powerset] at hT
      exact Finset.union_sdiff_cancel_right (Finset.disjoint_of_subset_left hT Finset.sdiff_disjoint)
    · intro S hS
      simp only [Finset.mem_filter, Finset.mem_powerset] at hS
      have hgs : g.card ≤ S.card := Finset.card_le_card hS.2
      have hsx : S.card ≤ X.card := Finset.card_le_card hS.1
      have hgx : g.card ≤ X.card := Finset.card_le_card hg
      have e1 : g.card + (S.card - g.card) = S.card := by omega
      have e2 : X.card - g.card - (S.card - g.card) = X.card - S.card := by omega
      simp only [Finset.card_sdiff_of_subset hS.2, Finset.card_sdiff_of_subset hg]
      rw [← mul_assoc, ← pow_add, e1, e2]
  rw [key, ← Finset.mul_sum, sum_powerset_bernoulli, mul_one]

omit [DecidableEq α] in
theorem mu_nonneg {p : ℝ} (hp0 : 0 ≤ p) (hp1 : p ≤ 1) (X : Finset α) (F : Finset (Finset α)) :
    0 ≤ mu X p F := by
  refine Finset.sum_nonneg fun S _ => ?_
  exact mul_nonneg (pow_nonneg hp0 _) (pow_nonneg (by linarith) _)

omit [DecidableEq α] in
theorem mu_mono {p : ℝ} (hp0 : 0 ≤ p) (hp1 : p ≤ 1) (X : Finset α) {F₁ F₂ : Finset (Finset α)}
    (h : F₁ ⊆ F₂) : mu X p F₁ ≤ mu X p F₂ := by
  refine Finset.sum_le_sum_of_subset_of_nonneg h fun S _ _ => ?_
  exact mul_nonneg (pow_nonneg hp0 _) (pow_nonneg (by linarith) _)

/-- Union bound: if every member of `F` contains a member of `G`, then the probability that
the `p`-random subset lies in `F` is at most `∑_{g ∈ G} p ^ |g|`. -/
theorem mu_le_sum_of_covers {p : ℝ} (hp0 : 0 ≤ p) (hp1 : p ≤ 1) (X : Finset α)
    {F G : Finset (Finset α)} (hF : F ⊆ X.powerset) (hcov : ∀ S ∈ F, ∃ g ∈ G, g ⊆ S) :
    mu X p F ≤ ∑ g ∈ G, p ^ g.card := by
  classical
  have hcov' : ∀ S : Finset α, ∃ g : Finset α, S ∈ F → (g ∈ G ∧ g ⊆ S) := by
    intro S
    by_cases h : S ∈ F
    · obtain ⟨g, hg1, hg2⟩ := hcov S h
      exact ⟨g, fun _ => ⟨hg1, hg2⟩⟩
    · exact ⟨∅, fun h' => absurd h' h⟩
  choose c hc using hcov'
  have hmaps : ∀ S ∈ F, c S ∈ G := fun S hS => (hc S hS).1
  have hsplit : ∑ g ∈ G, ∑ S ∈ F.filter (fun S => c S = g),
      p ^ S.card * (1 - p) ^ (X.card - S.card) = mu X p F :=
    Finset.sum_fiberwise_of_maps_to hmaps _
  rw [← hsplit]
  refine Finset.sum_le_sum ?_
  intro g _
  by_cases hgX : g ⊆ X
  · have hsub : F.filter (fun S => c S = g) ⊆ X.powerset.filter (fun S => g ⊆ S) := by
      intro S hS
      simp only [Finset.mem_filter] at hS ⊢
      refine ⟨hF hS.1, ?_⟩
      rw [← hS.2]
      exact (hc S hS.1).2
    calc ∑ S ∈ F.filter (fun S => c S = g), p ^ S.card * (1 - p) ^ (X.card - S.card)
        ≤ ∑ S ∈ X.powerset.filter (fun S => g ⊆ S), p ^ S.card * (1 - p) ^ (X.card - S.card) := by
          refine Finset.sum_le_sum_of_subset_of_nonneg hsub fun S _ _ => ?_
          exact mul_nonneg (pow_nonneg hp0 _) (pow_nonneg (by linarith) _)
      _ = p ^ g.card := sum_supersets X g hgX p
  · have hempty : F.filter (fun S => c S = g) = ∅ := by
      refine Finset.eq_empty_of_forall_notMem ?_
      intro S hS
      simp only [Finset.mem_filter] at hS
      have hcs : c S ⊆ X := ((hc S hS.1).2).trans (Finset.mem_powerset.mp (hF hS.1))
      rw [hS.2] at hcs
      exact absurd hcs hgX
    rw [hempty, Finset.sum_empty]
    exact pow_nonneg hp0 _

/-! ## The easy direction: the expectation threshold is at most the critical probability -/

/-- If `H` is `q`-small then, for every `p ≤ q`, the `p`-random subset of `X` lies in the
increasing family generated by `H` with probability at most `1/2`.  Consequently the
expectation threshold of a family never exceeds its critical probability. -/
theorem mu_le_half_of_isSmall {p q : ℝ} (hp0 : 0 ≤ p) (hpq : p ≤ q) (hq1 : q ≤ 1)
    (X : Finset α) (H : Finset (Finset α)) (hsmall : IsSmall q H) :
    mu X p (upClosure X H) ≤ 1 / 2 := by
  obtain ⟨G, hcov, hcost⟩ := hsmall
  have hp1 : p ≤ 1 := le_trans hpq hq1
  have hcov' : ∀ S ∈ upClosure X H, ∃ g ∈ G, g ⊆ S := by
    intro S hS
    simp only [upClosure, Finset.mem_filter] at hS
    obtain ⟨h, hh, hhS⟩ := hS.2
    obtain ⟨g, hg, hgh⟩ := hcov h hh
    exact ⟨g, hg, hgh.trans hhS⟩
  have h1 : mu X p (upClosure X H) ≤ ∑ g ∈ G, p ^ g.card :=
    mu_le_sum_of_covers hp0 hp1 X (Finset.filter_subset _ _) hcov'
  have h2 : ∑ g ∈ G, p ^ g.card ≤ ∑ g ∈ G, q ^ g.card :=
    Finset.sum_le_sum fun g _ => pow_le_pow_left₀ hp0 hpq _
  linarith

/-! ## Product structure over disjoint blocks -/

/-- Splitting the ground set `X` into `A` and `X \ A` factorises the product measure. -/
theorem mu_split (X A : Finset α) (hA : A ⊆ X) (p : ℝ)
    (P Q : Finset α → Prop) [DecidablePred P] [DecidablePred Q] :
    ∑ S ∈ X.powerset.filter (fun S => P (S ∩ A) ∧ Q (S \ A)),
        p ^ S.card * (1 - p) ^ (X.card - S.card)
      = (∑ U ∈ A.powerset.filter P, p ^ U.card * (1 - p) ^ (A.card - U.card)) *
        (∑ V ∈ (X \ A).powerset.filter Q, p ^ V.card * (1 - p) ^ ((X \ A).card - V.card)) := by
  have key : ∀ U V : Finset α, U ⊆ A → V ⊆ X \ A → ((U ∪ V) ∩ A = U ∧ (U ∪ V) \ A = V) := by
    intro U V hU hV
    have hVA : Disjoint V A := Finset.disjoint_left.mpr fun x hx hxA =>
      (Finset.mem_sdiff.mp (hV hx)).2 hxA
    constructor
    · ext x; simp only [Finset.mem_inter, Finset.mem_union]
      constructor
      · rintro ⟨h1 | h1, h2⟩
        · exact h1
        · exact absurd h2 (Finset.disjoint_left.mp hVA h1)
      · intro h; exact ⟨Or.inl h, hU h⟩
    · ext x; simp only [Finset.mem_sdiff, Finset.mem_union]
      constructor
      · rintro ⟨h1 | h1, h3⟩
        · exact absurd (hU h1) h3
        · exact h1
      · intro h; exact ⟨Or.inr h, fun hA' => Finset.disjoint_left.mp hVA h hA'⟩
  rw [Finset.sum_mul_sum, ← Finset.sum_product']
  refine Finset.sum_nbij' (fun S => (S ∩ A, S \ A)) (fun UV => UV.1 ∪ UV.2) ?_ ?_ ?_ ?_ ?_
  · intro S hS
    simp only [Finset.mem_filter, Finset.mem_powerset] at hS
    simp only [Finset.mem_product, Finset.mem_filter, Finset.mem_powerset]
    exact ⟨⟨Finset.inter_subset_right, hS.2.1⟩,
      Finset.sdiff_subset_sdiff hS.1 (le_refl A), hS.2.2⟩
  · rintro ⟨U, V⟩ hUV
    simp only [Finset.mem_product, Finset.mem_filter, Finset.mem_powerset] at hUV
    obtain ⟨⟨hU, hPU⟩, hV, hQV⟩ := hUV
    obtain ⟨h1, h2⟩ := key U V hU hV
    simp only [Finset.mem_filter, Finset.mem_powerset, h1, h2]
    exact ⟨Finset.union_subset (hU.trans hA) (hV.trans Finset.sdiff_subset), hPU, hQV⟩
  · intro S _
    ext x
    simp only [Finset.mem_union, Finset.mem_inter, Finset.mem_sdiff]
    tauto
  · rintro ⟨U, V⟩ hUV
    simp only [Finset.mem_product, Finset.mem_filter, Finset.mem_powerset] at hUV
    obtain ⟨⟨hU, _⟩, hV, _⟩ := hUV
    obtain ⟨h1, h2⟩ := key U V hU hV
    simp [h1, h2]
  · intro S hS
    simp only [Finset.mem_filter, Finset.mem_powerset] at hS
    have hSX := hS.1
    have hcard : S.card = (S ∩ A).card + (S \ A).card := by
      rw [← Finset.card_union_of_disjoint (Finset.disjoint_sdiff_inter S A).symm]
      congr 1
      ext x; simp only [Finset.mem_union, Finset.mem_inter, Finset.mem_sdiff]; tauto
    have hAX : A.card ≤ X.card := Finset.card_le_card hA
    have hUA : (S ∩ A).card ≤ A.card := Finset.card_le_card Finset.inter_subset_right
    have hVXA : (S \ A).card ≤ (X \ A).card :=
      Finset.card_le_card (Finset.sdiff_subset_sdiff hSX (le_refl A))
    have hXA : (X \ A).card = X.card - A.card := Finset.card_sdiff_of_subset hA
    rw [hcard, pow_add,
      show X.card - ((S ∩ A).card + (S \ A).card)
        = (A.card - (S ∩ A).card) + ((X \ A).card - (S \ A).card) by omega, pow_add]
    ring

/-- The family of subsets of `X` containing no member of `H`. -/
def avoid (X : Finset α) (H : Finset (Finset α)) : Finset (Finset α) :=
  X.powerset.filter (fun S => ∀ h ∈ H, ¬ h ⊆ S)

theorem sum_not_superset_self (g : Finset α) (p : ℝ) :
    ∑ U ∈ g.powerset.filter (fun U => ¬ g ⊆ U), p ^ U.card * (1 - p) ^ (g.card - U.card)
      = 1 - p ^ g.card := by
  have hsplit := Finset.sum_filter_add_sum_filter_not g.powerset (fun U => g ⊆ U)
      (fun U => p ^ U.card * (1 - p) ^ (g.card - U.card))
  rw [sum_supersets g g (subset_refl g) p, sum_powerset_bernoulli] at hsplit
  linarith

/-- For a family of pairwise disjoint sets, the events `h ⊆ S` are independent, so the
probability that the `p`-random set contains no member is the product `∏ (1 - p ^ |h|)`. -/
theorem mu_avoid_disjoint (p : ℝ) (H : Finset (Finset α)) :
    ∀ X : Finset α, (∀ h ∈ H, h ⊆ X) → (H : Set (Finset α)).PairwiseDisjoint id →
      mu X p (avoid X H) = ∏ h ∈ H, (1 - p ^ h.card) := by
  classical
  induction H using Finset.induction_on with
  | empty =>
      intro X _ _
      have : avoid X (∅ : Finset (Finset α)) = X.powerset := by
        simp [avoid]
      rw [this, mu_powerset, Finset.prod_empty]
  | insert g H' hg ih =>
      intro X hsub hdisj
      have hgX : g ⊆ X := hsub g (Finset.mem_insert_self g H')
      have hH'sub : ∀ h ∈ H', h ⊆ X \ g := by
        intro h hh
        have hhX : h ⊆ X := hsub h (Finset.mem_insert_of_mem hh)
        have hne : h ≠ g := fun he => hg (he ▸ hh)
        have hdis : Disjoint h g := by
          have hmem1 : h ∈ (↑(insert g H') : Set (Finset α)) := by
            simp only [Finset.coe_insert, Set.mem_insert_iff, Finset.mem_coe]
            exact Or.inr hh
          have hmem2 : g ∈ (↑(insert g H') : Set (Finset α)) := by simp
          simpa using hdisj hmem1 hmem2 hne
        exact Finset.subset_sdiff.mpr ⟨hhX, hdis⟩
      have hdisj' : (H' : Set (Finset α)).PairwiseDisjoint id := by
        refine hdisj.subset ?_
        intro x hx
        simp only [Finset.coe_insert, Set.mem_insert_iff, Finset.mem_coe] at hx ⊢
        exact Or.inr hx
      have hfilter : avoid X (insert g H')
          = X.powerset.filter (fun S => (fun U => ¬ g ⊆ U) (S ∩ g) ∧
              (fun V => ∀ h ∈ H', ¬ h ⊆ V) (S \ g)) := by
        unfold avoid
        refine Finset.filter_congr ?_
        intro S hS
        rw [Finset.mem_powerset] at hS
        simp only [Finset.mem_insert, forall_eq_or_imp]
        constructor
        · rintro ⟨h1, h2⟩
          refine ⟨fun hc => h1 (hc.trans Finset.inter_subset_left), ?_⟩
          intro h hh hc
          exact h2 h hh (hc.trans Finset.sdiff_subset)
        · rintro ⟨h1, h2⟩
          constructor
          · intro hc
            exact h1 (Finset.subset_inter hc (subset_refl g))
          · intro h hh hc
            have hdis : Disjoint h g := by
              have hne : h ≠ g := fun he => hg (he ▸ hh)
              have hmem1 : h ∈ (↑(insert g H') : Set (Finset α)) := by
                simp only [Finset.coe_insert, Set.mem_insert_iff, Finset.mem_coe]
                exact Or.inr hh
              have hmem2 : g ∈ (↑(insert g H') : Set (Finset α)) := by simp
              simpa using hdisj hmem1 hmem2 hne
            exact h2 h hh (Finset.subset_sdiff.mpr ⟨hc, hdis⟩)
      have hsplit := mu_split X g hgX p (fun U => ¬ g ⊆ U) (fun V => ∀ h ∈ H', ¬ h ⊆ V)
      have : mu X p (avoid X (insert g H'))
          = (1 - p ^ g.card) * mu (X \ g) p (avoid (X \ g) H') := by
        unfold mu
        rw [hfilter, hsplit, sum_not_superset_self]
        rfl
      rw [this, ih (X \ g) hH'sub hdisj', Finset.prod_insert hg]

/-- For a family of pairwise disjoint sets, the probability that the `p`-random subset of `X`
lies in the increasing family generated by `H`. -/
theorem mu_upClosure_disjoint (X : Finset α) (H : Finset (Finset α)) (p : ℝ)
    (hsub : ∀ h ∈ H, h ⊆ X) (hdisj : (H : Set (Finset α)).PairwiseDisjoint id) :
    mu X p (upClosure X H) = 1 - ∏ h ∈ H, (1 - p ^ h.card) := by
  classical
  have havoid : avoid X H = X.powerset.filter (fun S => ¬ ∃ h ∈ H, h ⊆ S) := by
    unfold avoid
    refine Finset.filter_congr ?_
    intro S _
    push_neg
    rfl
  have hpart : mu X p (upClosure X H) + mu X p (avoid X H) = 1 := by
    unfold mu upClosure
    rw [havoid, Finset.sum_filter_add_sum_filter_not]
    exact sum_powerset_bernoulli X p
  rw [mu_avoid_disjoint p H X hsub hdisj] at hpart
  linarith

/-! ## The hard direction for families of pairwise disjoint sets -/

/-- If a family `H` of pairwise disjoint sets is **not** `q`-small, then already at
`p = 2q` the `p`-random subset of `X` lies in the increasing family generated by `H`
with probability more than `1/2`. -/
theorem mu_gt_half_of_not_isSmall_disjoint (X : Finset α) (H : Finset (Finset α)) (q p : ℝ)
    (hsub : ∀ h ∈ H, h ⊆ X) (hdisj : (H : Set (Finset α)).PairwiseDisjoint id)
    (hq : 0 ≤ q) (hp1 : p ≤ 1) (hpq : 2 * q ≤ p) (hnot : IsSmall q H → False) :
    1 / 2 < mu X p (upClosure X H) := by
  classical
  have hp0 : 0 ≤ p := le_trans (by linarith) hpq
  -- non-smallness applied to the cover `H` itself
  have hcost : 1 / 2 < ∑ h ∈ H, q ^ h.card := by
    by_contra hcon
    push_neg at hcon
    exact hnot ⟨H, fun h hh => ⟨h, hh, subset_refl h⟩, hcon⟩
  rw [mu_upClosure_disjoint X H p hsub hdisj]
  have hfac : ∀ h ∈ H, (0:ℝ) ≤ 1 - p ^ h.card := by
    intro h _
    have : p ^ h.card ≤ 1 := pow_le_one₀ hp0 hp1
    linarith
  by_cases hemp : ∅ ∈ H
  · have : ∏ h ∈ H, (1 - p ^ h.card) = 0 :=
      Finset.prod_eq_zero hemp (by simp)
    rw [this]; norm_num
  · -- every member of `H` is nonempty, so `p ^ |h| ≥ 2 q ^ |h|`
    have hcard1 : ∀ h ∈ H, 1 ≤ h.card := by
      intro h hh
      rcases Nat.eq_zero_or_pos h.card with h0 | h1
      · exact absurd (Finset.card_eq_zero.mp h0 ▸ hh) hemp
      · exact h1
    have hsum : 1 < ∑ h ∈ H, p ^ h.card := by
      have hstep : ∀ h ∈ H, 2 * q ^ h.card ≤ p ^ h.card := by
        intro h hh
        have h1 := hcard1 h hh
        calc 2 * q ^ h.card ≤ 2 ^ h.card * q ^ h.card := by
              have : (2:ℝ) ≤ 2 ^ h.card := by
                calc (2:ℝ) = 2 ^ 1 := by norm_num
                _ ≤ 2 ^ h.card := by
                      apply pow_le_pow_right₀ (by norm_num) h1
              nlinarith [pow_nonneg hq h.card]
          _ = (2 * q) ^ h.card := by rw [mul_pow]
          _ ≤ p ^ h.card := pow_le_pow_left₀ (by linarith) hpq _
      have : 2 * ∑ h ∈ H, q ^ h.card ≤ ∑ h ∈ H, p ^ h.card := by
        rw [Finset.mul_sum]
        exact Finset.sum_le_sum hstep
      linarith
    have hexp : Real.exp (-∑ h ∈ H, p ^ h.card) = ∏ h ∈ H, Real.exp (-(p ^ h.card)) := by
      rw [← Real.exp_sum]
      congr 1
      simp
    have hprod : ∏ h ∈ H, (1 - p ^ h.card) ≤ Real.exp (-∑ h ∈ H, p ^ h.card) := by
      rw [hexp]
      refine Finset.prod_le_prod hfac ?_
      intro h _
      have := Real.add_one_le_exp (-(p ^ h.card))
      linarith
    have hlast : Real.exp (-∑ h ∈ H, p ^ h.card) < 1 / 2 := by
      have h1 : Real.exp (-∑ h ∈ H, p ^ h.card) ≤ Real.exp (-1) :=
        Real.exp_le_exp.mpr (by linarith)
      have h2 : Real.exp (-1 : ℝ) < 1 / 2 := by
        rw [Real.exp_neg, inv_eq_one_div,
          div_lt_div_iff₀ (Real.exp_pos 1) (by norm_num : (0:ℝ) < 2)]
        have := Real.exp_one_gt_d9
        linarith
      linarith
    linarith

/-! ## Thresholds -/

/-- The **expectation threshold** of `H`: the largest `q` for which `H` is `q`-small. -/
noncomputable def expThreshold (H : Finset (Finset α)) : ℝ :=
  sSup {q : ℝ | 0 ≤ q ∧ q ≤ 1 ∧ IsSmall q H}

/-- The **critical probability** of the family `F`: the largest `p` for which the `p`-random
subset of `X` lies in `F` with probability at most `1/2`. -/
noncomputable def critProb (X : Finset α) (F : Finset (Finset α)) : ℝ :=
  sSup {p : ℝ | 0 ≤ p ∧ p ≤ 1 ∧ mu X p F ≤ 1 / 2}

omit [DecidableEq α] in
theorem bddAbove_smallSet (H : Finset (Finset α)) :
    BddAbove {q : ℝ | 0 ≤ q ∧ q ≤ 1 ∧ IsSmall q H} :=
  ⟨1, fun _ hx => hx.2.1⟩

omit [DecidableEq α] in
theorem bddAbove_critSet (X : Finset α) (F : Finset (Finset α)) :
    BddAbove {p : ℝ | 0 ≤ p ∧ p ≤ 1 ∧ mu X p F ≤ 1 / 2} :=
  ⟨1, fun _ hx => hx.2.1⟩

omit [DecidableEq α] in
theorem expThreshold_nonneg (H : Finset (Finset α)) : 0 ≤ expThreshold H :=
  Real.sSup_nonneg fun _ hx => hx.1

omit [DecidableEq α] in
theorem critProb_nonneg (X : Finset α) (F : Finset (Finset α)) : 0 ≤ critProb X F :=
  Real.sSup_nonneg fun _ hx => hx.1

/-- **The expectation threshold never exceeds the critical probability** (for an arbitrary
family of generators). -/
theorem expThreshold_le_critProb (X : Finset α) (H : Finset (Finset α)) :
    expThreshold H ≤ critProb X (upClosure X H) := by
  by_cases hne : {q : ℝ | 0 ≤ q ∧ q ≤ 1 ∧ IsSmall q H}.Nonempty
  · refine csSup_le hne ?_
    intro q hq
    exact le_csSup (bddAbove_critSet _ _)
      ⟨hq.1, hq.2.1, mu_le_half_of_isSmall hq.1 le_rfl hq.2.1 X H hq.2.2⟩
  · rw [Set.not_nonempty_iff_eq_empty] at hne
    rw [expThreshold, hne, Real.sSup_empty]
    exact critProb_nonneg _ _

/-- **Converse bound for pairwise disjoint generators**: the critical probability is at most
twice the expectation threshold. -/
theorem critProb_le_two_mul_expThreshold (X : Finset α) (H : Finset (Finset α))
    (hsub : ∀ h ∈ H, h ⊆ X) (hdisj : (H : Set (Finset α)).PairwiseDisjoint id) :
    critProb X (upClosure X H) ≤ 2 * expThreshold H := by
  by_cases hne : {p : ℝ | 0 ≤ p ∧ p ≤ 1 ∧ mu X p (upClosure X H) ≤ 1 / 2}.Nonempty
  · refine csSup_le hne ?_
    intro p hp
    by_contra hcon
    push_neg at hcon
    have hp0 : 0 ≤ p := hp.1
    have hp1 : p ≤ 1 := hp.2.1
    have hq0 : 0 ≤ p / 2 := by linarith
    have hq1 : p / 2 ≤ 1 := by linarith
    have hexp : 0 ≤ expThreshold H := expThreshold_nonneg H
    have hnot : IsSmall (p / 2) H → False := by
      intro hs
      have : p / 2 ≤ expThreshold H := le_csSup (bddAbove_smallSet H) ⟨hq0, hq1, hs⟩
      linarith
    have hgt := mu_gt_half_of_not_isSmall_disjoint X H (p / 2) p hsub hdisj hq0 hp1
      (by linarith) hnot
    linarith [hp.2.2]
  · rw [Set.not_nonempty_iff_eq_empty] at hne
    rw [critProb, hne, Real.sSup_empty]
    have := expThreshold_nonneg H
    linarith

/-! ## Main statement -/

/-- **Kahn–Kalai: the expectation threshold and the critical probability agree up to a
logarithmic factor.**

Here `mu X p F` is the probability that the `p`-random subset of the finite ground set `X`
belongs to the family `F`, `upClosure X H` is the increasing family generated by `H`,
`IsSmall q H` is the Kahn–Kalai notion of `q`-smallness, `expThreshold H` is the resulting
expectation threshold and `critProb X F` the critical probability.  The parameter `ℓ` is a
bound on the size of the generators; the hypothesis `∀ h ∈ H, h.card ≤ ℓ` is part of the
Kahn–Kalai formulation (it is what the logarithmic factor refers to) and is retained even
though the proof below does not need it.

The first inequality is proved for arbitrary families of generators.  The second
(the difficult direction, the Kahn–Kalai conjecture proved in general by Park and Pham) is
established here for families of **pairwise disjoint** generators, where in fact the sharper
bound `critProb ≤ 2 * expThreshold` holds, see `critProb_le_two_mul_expThreshold`; the
logarithmic factor `log₂ (2ℓ) ≥ 1` is then absorbed. -/
theorem kahn_kalai : ∃ K : ℝ, 0 < K ∧
    ∀ (X : Finset α) (H : Finset (Finset α)) (ℓ : ℕ), 1 ≤ ℓ →
      (∀ h ∈ H, h ⊆ X) → (∀ h ∈ H, h.card ≤ ℓ) →
      expThreshold H ≤ critProb X (upClosure X H) ∧
        ((H : Set (Finset α)).PairwiseDisjoint id →
          critProb X (upClosure X H) ≤ K * expThreshold H * Real.logb 2 (2 * ℓ)) := by
  refine ⟨2, by norm_num, ?_⟩
  intro X H ℓ hℓ hsub _hcard
  refine ⟨expThreshold_le_critProb X H, ?_⟩
  intro hdisj
  have hl : (1:ℝ) ≤ (ℓ : ℝ) := by exact_mod_cast hℓ
  have hlog : (1:ℝ) ≤ Real.logb 2 (2 * ℓ) := by
    calc (1:ℝ) = Real.logb 2 2 := (Real.logb_self_eq_one (by norm_num)).symm
      _ ≤ Real.logb 2 (2 * ℓ) :=
          (Real.logb_le_logb (b := 2) (x := 2) (y := 2 * ℓ) (by norm_num) (by norm_num)
            (by linarith)).mpr (by linarith)
  have h1 := critProb_le_two_mul_expThreshold X H hsub hdisj
  have h2 : 0 ≤ expThreshold H := expThreshold_nonneg H
  nlinarith

omit [DecidableEq α] in
/-- Any family whose members have at most one element consists of pairwise disjoint sets. -/
theorem pairwiseDisjoint_of_card_le_one (H : Finset (Finset α)) (hcard : ∀ h ∈ H, h.card ≤ 1) :
    (H : Set (Finset α)).PairwiseDisjoint id := by
  intro a ha b hb hab
  simp only [Finset.mem_coe] at ha hb
  refine Finset.disjoint_left.mpr ?_
  intro x hxa hxb
  have hA : a = {x} := Finset.eq_singleton_iff_unique_mem.mpr
    ⟨hxa, fun y hy => Finset.card_le_one.mp (hcard a ha) y hy x hxa⟩
  have hB : b = {x} := Finset.eq_singleton_iff_unique_mem.mpr
    ⟨hxb, fun y hy => Finset.card_le_one.mp (hcard b hb) y hy x hxb⟩
  exact hab (hA.trans hB.symm)

/-- **The Kahn–Kalai comparison holds unconditionally for `1`-bounded families**: for a family
all of whose generators have at most one element, the critical probability is at most twice
the expectation threshold (no disjointness hypothesis is needed here, since such a family is
automatically a family of pairwise disjoint sets). -/
theorem kahn_kalai_one_bounded (X : Finset α) (H : Finset (Finset α))
    (hsub : ∀ h ∈ H, h ⊆ X) (hcard : ∀ h ∈ H, h.card ≤ 1) :
    expThreshold H ≤ critProb X (upClosure X H) ∧
      critProb X (upClosure X H) ≤ 2 * expThreshold H :=
  ⟨expThreshold_le_critProb X H,
    critProb_le_two_mul_expThreshold X H hsub (pairwiseDisjoint_of_card_le_one H hcard)⟩

/-! ## Sanity checks: the definitions compute as intended -/

/-- For a single generator `{0}` the measure of the generated increasing family is `p`. -/
example (p : ℝ) : mu ({0} : Finset ℕ) p (upClosure {0} {{0}}) = p := by
  have h : ({0} : Finset ℕ).powerset = {∅, {0}} := rfl
  simp [mu, upClosure, Finset.sum_filter, h]

/-- For the two disjoint generators `{0}` and `{1}` the measure of the generated increasing
family is `1 - (1 - p) ^ 2`. -/
example (p : ℝ) : mu ({0, 1} : Finset ℕ) p (upClosure {0, 1} {{0}, {1}}) = 1 - (1 - p) ^ 2 := by
  rw [mu_upClosure_disjoint]
  · norm_num [Finset.prod_insert, Finset.mem_singleton]
    ring
  · decide
  · intro a ha b hb hab
    simp only [Finset.coe_insert, Set.mem_insert_iff, Finset.mem_coe, Finset.mem_singleton]
      at ha hb
    rcases ha with rfl | rfl <;> rcases hb with rfl | rfl <;> simp_all <;> decide

/-
The general Kahn–Kalai conjecture, proved by Park and Pham, is the following statement, which
is *not* formalised in this file: there is a universal constant `K > 0` such that for every
finite ground set `X`, every family `H` of subsets of `X` with `∀ h ∈ H, h.card ≤ ℓ` and
`1 ≤ ℓ`, one has

  critProb X (upClosure X H) ≤ K * expThreshold H * Real.logb 2 (2 * ℓ).

The results above establish this bound (with `K = 2`, and with no logarithmic factor needed)
for families of pairwise disjoint generators, and in particular for all `1`-bounded families.
-/

end Math2

