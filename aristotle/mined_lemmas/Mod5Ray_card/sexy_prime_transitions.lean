/-- Ray classification based on mod 5 residues -/
inductive Mod5Ray : Type
  | ray_0 : Mod5Ray  -- n ≡ 0 (mod 5)
  | ray_1 : Mod5Ray  -- n ≡ 1 (mod 5) 
  | ray_2 : Mod5Ray  -- n ≡ 2 (mod 5)
  | ray_3 : Mod5Ray  -- n ≡ 3 (mod 5)
  | ray_4 : Mod5Ray  -- n ≡ 4 (mod 5)
  deriving DecidableEq, Inhabited, Fintype


theorem sexy_prime_transitions (p : ℕ) (hp : Nat.Prime p) (hp6 : Nat.Prime (p + 6))
    (h : p > 5) :
    rayTransition p 6 ∈
    ({(Mod5Ray.ray_1, Mod5Ray.ray_2),
      (Mod5Ray.ray_2, Mod5Ray.ray_3),
      (Mod5Ray.ray_3, Mod5Ray.ray_4)} : Finset (Mod5Ray × Mod5Ray)) := by
        -- Since p is prime and greater than 5, its residue modulo 5 must be 1, 2, 3, or 4. Therefore, the ray of p is either ray_1, ray_2, ray_3, or ray_4.
        have h_residue : p % 5 = 1 ∨ p % 5 = 2 ∨ p % 5 = 3 ∨ p % 5 = 4 := by
          -- Since p is a prime greater than 5, it cannot be divisible by 5. Therefore, p % 5 must be 1, 2, 3, or 4.
          have h_mod : p % 5 ≠ 0 := by
            exact fun con => by have := Nat.dvd_of_mod_eq_zero con; rw [ hp.dvd_iff_eq ] at this <;> linarith;
          generalize_proofs at *; (
          -- Since p is a prime greater than 5, it cannot be divisible by 5. Therefore, p % 5 must be 1, 2, 3, or 4. We can use the fact that the remainder when dividing by 5 can only be 0, 1, 2, 3, or 4.
          have h_mod : p % 5 < 5 := by
            exact Nat.mod_lt _ ( by decide )
          generalize_proofs at *; (
          interval_cases p % 5 <;> trivial;));
        -- By definition of rayTransition, we have rayTransition p 6 = (assignRay p, assignRay (p + 6)).
        simp [rayTransition, assignRay];
        rcases h_residue with ( h | h | h | h ) <;> norm_num [ Nat.add_mod, h ];
        -- Since $p \equiv 4 \pmod{5}$ and $p + 6 \equiv 0 \pmod{5}$, we have $p + 6$ is divisible by 5.
        have h_div : 5 ∣ (p + 6) := by
          norm_num [ Nat.dvd_iff_mod_eq_zero, Nat.add_mod, h ];
        rw [ hp6.dvd_iff_eq ] at h_div <;> linarith

