/-- `H` covers all residue classes modulo `p`. -/

def IsAdmissible (H : Finset ℕ) : Prop :=
  ∀ p : ℕ, p.Prime → ¬ CoversAllResidues H p

/-- Covering all residues mod `p` forces `p ≤ |H|`. -/
