open Complex

-- D₅: dihedral group of order 10, symmetries of the pentagon
abbrev D5 := DihedralGroup 5


noncomputable def isotypicProjectorFormula {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (ρ : D5 → (H ≃ₗᵢ[ℂ] H)) (idx : D5IrrepIndex) : H →L[ℂ] H :=
  (D5IrrepDimension idx * (Fintype.card D5 : ℂ)⁻¹) • ∑ g : D5, star (D5_character idx g) • repCLM ρ g

#check RH_of_BrockianSystem_v2

class D5ProjectorProperties (H : Type*) [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (ρ : D5 → (H ≃ₗᵢ[ℂ] H)) where
  idempotent : ∀ idx, isotypicProjectorFormula ρ idx * isotypicProjectorFormula ρ idx = isotypicProjectorFormula ρ idx
  selfAdjoint : ∀ idx, (isotypicProjectorFormula ρ idx).adjoint = isotypicProjectorFormula ρ idx
  orthogonal : ∀ i j, i ≠ j → isotypicProjectorFormula ρ i * isotypicProjectorFormula ρ j = 0
  complete : isotypicProjectorFormula ρ .trivial + isotypicProjectorFormula ρ .sign + isotypicProjectorFormula ρ .golden + isotypicProjectorFormula ρ .conjugate = 1
  golden_nonzero : isotypicProjectorFormula ρ .golden ≠ 0
  golden_proper : isotypicProjectorFormula ρ .golden ≠ 1

structure BrockianSystem_v3 (H : Type*) [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H] where
  ρ : D5 → (H ≃ₗᵢ[ℂ] H)
  [props : D5ProjectorProperties H ρ]
  Δ : H →L[ℂ] H
  hΔ : IsSelfAdjoint Δ
  V : H →L[ℂ] H
  hV : IsSelfAdjoint V
  B : H →L[ℂ] H
  hB_def : B = (isotypicProjectorFormula ρ .golden) * Δ * (isotypicProjectorFormula ρ .golden) + V
  hB_selfAdjoint : IsSelfAdjoint B
  hB_spec : ∀ s : ℂ, completedRiemannZeta₀ (1/2 + I * s) = 0 ↔ ∃ mu ∈ spectrum ℂ B, s = mu

