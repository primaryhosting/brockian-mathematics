/-! ## Part I: Foundations - D₅ and Golden Symmetry -/

abbrev D5 := DihedralGroup 5

theorem B_selfAdjoint {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (BS : BrockianSystem H) : IsSelfAdjoint BS.B := by
      -- Since $B$ is defined as $P_golden * \Delta * P_golden + V$, and both $\Delta$ and $V$ are self-adjoint, their product and sum are also self-adjoint.
      have hB_self_adjoint : IsSelfAdjoint (BS.projectors.projector .golden * BS.Δ * BS.projectors.projector .golden) := by
        -- Since $BS.Δ$ is self-adjoint and $BS.projectors.projector .golden$ is self-adjoint, their product is also self-adjoint.
        have h_self_adjoint : IsSelfAdjoint (BS.projectors.projector .golden) ∧ IsSelfAdjoint BS.Δ := by
          exact ⟨ by rw [ IsSelfAdjoint ] ; exact BS.projectors.selfAdjoint _, by exact BS.hΔ ⟩;
        simp_all +decide [ IsSelfAdjoint, ContinuousLinearMap.isSelfAdjoint_iff' ];
        rw [ mul_assoc ];
      rw [ BS.hB_def ];
      exact hB_self_adjoint.add BS.hV

