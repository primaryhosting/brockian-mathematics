theorem RH_of_BrockianSystem_v3 {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    [BrockianAxioms] (BS : BrockianSystem_v3 H) : RiemannHypothesis := by
      cases' BS with ρ props Δ hΔ V hV B hB_def hB_selfAdjoint hB_spec;
      -- By definition of $B$, we know that its spectrum corresponds to the non-trivial zeros of the completed Riemann zeta function.
      have hB_spectrum : ∀ s ∈ NontrivialZeros, ∃ mu ∈ spectrum ℂ B, s = 1 / 2 + Complex.I * mu := by
        intro s hs
        obtain ⟨mu, hmu⟩ : ∃ mu ∈ spectrum ℂ B, s = 1 / 2 + Complex.I * mu := by
          have := hB_spec ( ( s - 1 / 2 ) / Complex.I );
          rw [ mul_div_cancel₀ ] at this <;> norm_num at *;
          exact ⟨ - ( ( s - 1 / 2 ) * Complex.I ), this.mp hs.1, by ring_nf; norm_num ⟩
        use mu;
      -- Since the spectrum of B is real, for any s in the non-trivial zeros, we have s.re = 1/2.
      have h_real_spectrum : ∀ s : ℂ, s ∈ NontrivialZeros → s.re = 1 / 2 := by
        intro s hs
        obtain ⟨mu, hmu_spectrum, hmu_eq⟩ := hB_spectrum s hs
        have h_mu_real : mu.im = 0 := by
          apply selfAdjoint_spectrum_real B hB_selfAdjoint mu hmu_spectrum
        simp [hmu_eq, h_mu_real];
      exact?
