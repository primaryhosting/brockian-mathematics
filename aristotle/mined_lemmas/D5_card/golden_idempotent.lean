/-
Define D5 as the Dihedral Group of order 10 and prove its cardinality is 10.
-/
abbrev D5 := DihedralGroup 5


theorem golden_idempotent {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] (ρ : D5 → (H ≃ₗᵢ[ℂ] H)) [IP : IsotypicProjectors H ρ] :
    IP.projector .golden * IP.projector .golden = IP.projector .golden :=
  IP.idempotent .golden

/-
Define the BrockianSystem structure containing the representation, projectors, and operators.
-/
structure BrockianSystem (H : Type*) [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] where
  /-- D₅ representation on H. -/
  ρ : D5 → (H ≃ₗᵢ[ℂ] H)
  /-- Isotypic projectors for the D₅-action. -/
  [projectors : IsotypicProjectors H ρ]
  /-- Laplacian / scaling operator. -/
  Δ : H →L[ℂ] H
  /-- Δ is self-adjoint. -/
  hΔ : IsSelfAdjoint Δ
  /-- Regularized potential. -/
  V : H →L[ℂ] H
  /-- V is self-adjoint. -/
  hV : IsSelfAdjoint V

attribute [instance] BrockianSystem.projectors

