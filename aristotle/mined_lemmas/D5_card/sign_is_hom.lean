abbrev D5 := DihedralGroup 5


lemma sign_is_hom (g h : D5) :
    χ_elem .sign (g * h) = χ_elem .sign g * χ_elem .sign h := by
      induction' g using DihedralGroup.rec with n m;
      · unfold χ_elem;
        unfold toConjClass;
        fin_cases n <;> induction h <;> simp +decide;
        all_goals simp +decide [ χ_val ];
        · rename_i k; fin_cases k <;> rfl;
        · rename_i k;
          fin_cases k <;> rfl;
        · rename_i k; fin_cases k <;> rfl;
        · rename_i k; fin_cases k <;> rfl;
      · induction' h using DihedralGroup.rec with n m;
        · unfold χ_elem;
          fin_cases m <;> fin_cases n <;> simp +decide [ toConjClass ];
          all_goals norm_num [ χ_val ] ;
        · unfold χ_elem;
          unfold χ_val;
          unfold toConjClass; simp +decide [ DihedralGroup.sr ];
          rename_i k; fin_cases k <;> fin_cases m <;> trivial;

/-
