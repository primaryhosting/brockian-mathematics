/-
Define D5 as the Dihedral Group of order 10 and prove its cardinality is 10.
-/
abbrev D5 := DihedralGroup 5


theorem B_self_adjoint {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (BS : BrockianSystem H) : IsSelfAdjoint (B BS) := by
      -- The Brockian operator B is given by P_golden BS * BS.Δ * P_golden BS + BS.V, where Δ is self-adjoint and V is self-adjoint.
      have hB : IsSelfAdjoint (P_golden BS * BS.Δ * P_golden BS) ∧ IsSelfAdjoint BS.V := by
        -- Since $P_golden BS$ is a projector, it is self-adjoint. Also, $\Delta$ is self-adjoint by assumption. Therefore, $P_golden BS * \Delta * P_golden BS$ is self-adjoint.
        have h_self_adjoint : IsSelfAdjoint (P_golden BS) ∧ IsSelfAdjoint BS.Δ := by
          exact ⟨ BS.projectors.selfAdjoint _, BS.hΔ ⟩;
        simp_all +decide [ IsSelfAdjoint, star_mul ];
        exact ⟨ by rw [ mul_assoc ], BS.hV ⟩;
      exact IsSelfAdjoint.add hB.1 hB.2

/-
Check the definition of RiemannHypothesis and the existence of the spectrum lemma.
