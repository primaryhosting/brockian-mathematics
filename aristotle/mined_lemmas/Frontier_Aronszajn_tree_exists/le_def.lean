/-! ## Cofinal `ω`-sequences in countable limit ordinals -/

/-- `c` is a nondecreasing `ω`-indexed sequence, starting at `0`, cofinal in `l`. -/

theorem le_def {s t : Node} : s ≤ t ↔ s.len ≤ t.len ∧ ∀ ξ < s.len, s.fn ξ = t.fn ξ := Iff.rfl

