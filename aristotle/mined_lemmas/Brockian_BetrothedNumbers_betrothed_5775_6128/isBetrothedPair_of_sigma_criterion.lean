/-- The sum-of-divisors function `σ₁ n = ∑_{d ∣ n} d`. -/

theorem isBetrothedPair_of_sigma_criterion {k p a : ℕ} (hp : p.Prime) (hp2 : p ≠ 2)
    (ha : 0 < a) (hne : a ≠ 2 ^ k * p)
    (hsum : a + 2 ^ k * p + 1 + (p + 1) = 2 ^ (k + 1) * (p + 1))
    (hsa : sigma1 a + (p + 1) = 2 ^ (k + 1) * (p + 1)) :
    IsBetrothedPair a (2 ^ k * p) := by
  have hb : 0 < 2 ^ k * p := Nat.mul_pos (by positivity) hp.pos
  have hsb := sigma1_two_pow_mul_prime (k := k) hp hp2
  exact ⟨ha, hb, hne, by omega, by omega⟩

/-- **(5775, 6128) is generated by the sigma criterion with `k = 4`, `p = 383`:**
`6128 = 2 ^ 4 * 383` with `383` prime, `σ₁ (2 ^ 4 * 383) = (2 ^ 5 - 1) * 384 = 11904`,
and the partner is `5775 = 11904 - 6128 - 1`. -/
