/-!
# Lieb–Robinson bound: an effective light cone for local spin dynamics

We work in an arbitrary C\*-algebra `A` (e.g. the algebra of observables of a finite
spin system, `Matrix (Fin n) (Fin n) ℂ`).  Given a self-adjoint Hamiltonian `H : A`,
the Heisenberg dynamics is `τ_t(a) = e^{itH} a e^{-itH}`.

The base case of the Lieb–Robinson estimate is the linear-in-time bound

`‖⁅τ_t a, b⁆‖ ≤ ‖⁅a, b⁆‖ + 2 |t| ‖a‖ ‖⁅H, b⁆‖`,

which is the first step of the standard iteration producing the light cone: if `a` and
`b` are supported on disjoint regions then `⁅a, b⁆ = 0`, and only those terms of a local
Hamiltonian `H` that overlap the support of `b` contribute to `⁅H, b⁆`.  Hence the
commutator of `b` with the evolved observable can only grow at a rate set by the local
interaction strength — an effective light cone.
-/

namespace Frontier

open NormedSpace

variable {A : Type*} [CStarAlgebra A]

/-- `NormedSpace.exp` lemmas in Mathlib are phrased over `ℚ`-normed algebras; every complex
normed algebra is one by restriction of scalars. -/
noncomputable local instance normedAlgebraRatOfCStarAlgebra (A : Type*) [CStarAlgebra A] :
    NormedAlgebra ℚ A := .restrictScalars ℚ ℂ A

/-- The one-parameter unitary group `t ↦ e^{i t H}` generated by `H`. -/

lemma norm_heisenberg_sub_le {H : A} (hH : IsSelfAdjoint H) (b : A) (t : ℝ) :
    ‖heisenberg H t b - b‖ ≤ |t| * ‖⁅H, b⁆‖ := by
  have hb : heisenberg H 0 b = b := heisenberg_zero H b
  have key : ‖(fun s : ℝ => heisenberg H s b) t - (fun s : ℝ => heisenberg H s b) 0‖
      ≤ ‖⁅H, b⁆‖ * ‖t - 0‖ := by
    apply Convex.norm_image_sub_le_of_norm_hasDerivWithin_le
      (f := fun s : ℝ => heisenberg H s b)
      (f' := fun s : ℝ => uGroup H s * (Complex.I • ⁅H, b⁆) * uGroup H (-s))
      (s := Set.univ)
    · intro s _
      exact ((hasDerivAt_heisenberg H b s).hasDerivWithinAt)
    · intro s _
      rw [norm_conj_uGroup hH, norm_smul]
      simp
    · exact convex_univ
    · trivial
    · trivial
  simp only [hb, sub_zero, Real.norm_eq_abs] at key
  linarith [key]

/-- The elementary bound on the norm of a commutator. -/
