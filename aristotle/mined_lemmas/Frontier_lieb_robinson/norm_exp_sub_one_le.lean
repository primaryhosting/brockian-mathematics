/-- In a complex Banach algebra, `exp (x + y) = exp x * exp y` for commuting `x`, `y`. -/

theorem norm_exp_sub_one_le {𝒜 : Type*} [NormedRing 𝒜] [NormedAlgebra ℂ 𝒜] [CompleteSpace 𝒜]
    (x : 𝒜) : ‖exp x - 1‖ ≤ Real.exp ‖x‖ - 1 := by
  have hnorm : Summable (fun n : ℕ => ‖((Nat.factorial n : ℂ))⁻¹ • x ^ n‖) :=
    norm_expSeries_summable' (𝕂 := ℂ) x
  have hsum : Summable (fun n : ℕ => ((Nat.factorial n : ℂ))⁻¹ • x ^ n) := hnorm.of_norm
  have h1 : exp x = ∑' n : ℕ, ((Nat.factorial n : ℂ))⁻¹ • x ^ n := by
    rw [exp_eq_tsum ℂ]
  have h2 : exp x - 1 = ∑' n : ℕ, ((Nat.factorial (n + 1) : ℂ))⁻¹ • x ^ (n + 1) := by
    rw [h1, hsum.tsum_eq_zero_add]
    simp
  have hRs : Summable (fun n : ℕ => ‖x‖ ^ n / (Nat.factorial n : ℝ)) :=
    Real.summable_pow_div_factorial ‖x‖
  have hR : Real.exp ‖x‖ = ∑' n : ℕ, ‖x‖ ^ n / (Nat.factorial n : ℝ) := by
    simp only [Real.exp_eq_exp_ℝ, NormedSpace.exp_eq_tsum_div]
  have h3 : Real.exp ‖x‖ - 1 = ∑' n : ℕ, ‖x‖ ^ (n + 1) / (Nat.factorial (n + 1) : ℝ) := by
    rw [hR, hRs.tsum_eq_zero_add]
    simp
  rw [h2, h3]
  have hn1 : Summable (fun n : ℕ => ‖((Nat.factorial (n + 1) : ℂ))⁻¹ • x ^ (n + 1)‖) :=
    hnorm.comp_injective (add_left_injective 1)
  refine le_trans (norm_tsum_le_tsum_norm hn1) ?_
  refine Summable.tsum_le_tsum ?_ hn1 (hRs.comp_injective (add_left_injective 1))
  intro n
  rw [norm_smul, div_eq_inv_mul]
  gcongr
  · simp
  · exact norm_pow_le' x (Nat.succ_pos n)

