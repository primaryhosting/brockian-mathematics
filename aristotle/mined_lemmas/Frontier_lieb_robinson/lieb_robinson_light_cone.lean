/-!
## Setting

We work in a unital C*-algebra `A` (the algebra of observables of a quantum spin system).
For a self-adjoint Hamiltonian `H` the Heisenberg dynamics is
`τ_t(a) = exp(i t H) * a * exp(-i t H)`.

The Lieb–Robinson bound asserts that if `a` and `b` are observables supported in
regions that are not coupled by the "free" part `H₀` of the Hamiltonian, then the
commutator `⁅τ_t(a), b⁆` stays small for small times: it is controlled by the strength
of the coupling term `V` times the elapsed time.  This is exactly the base case
(first order in `t`) of the Lieb–Robinson series which produces the exponential
light cone `e^{v|t| - d}`.
-/

namespace Frontier

open NormedSpace

variable {A : Type*} [CStarAlgebra A] [Nontrivial A]

noncomputable local instance ratAlg : NormedAlgebra ℚ A := .restrictScalars ℚ ℂ A

/-- The Heisenberg time evolution of the observable `a` generated by the Hamiltonian `H`:
`τ_t(a) = exp(i t H) * a * exp(-i t H)`. -/

theorem lieb_robinson_light_cone {H₀ V a b : A} (hH₀ : IsSelfAdjoint H₀) (hV : IsSelfAdjoint V)
    (hH₀b : Commute H₀ b) (hab : Commute a b) {ε : ℝ} (hε : 0 < ε) :
    ∃ δ > 0, ∀ t : ℝ, |t| < δ → ‖⁅heisenberg (H₀ + V) t a, b⁆‖ ≤ ε := by
  set C : ℝ := 4 * ‖V‖ * ‖a‖ * ‖b‖ with hC
  have hC0 : 0 ≤ C := by positivity
  refine ⟨ε / (C + 1), by positivity, fun t ht => ?_⟩
  have h1 : ‖⁅heisenberg (H₀ + V) t a, b⁆‖ ≤ |t| * C := by
    have := lieb_robinson hH₀ hV hH₀b hab t
    calc ‖⁅heisenberg (H₀ + V) t a, b⁆‖ ≤ 4 * |t| * ‖V‖ * ‖a‖ * ‖b‖ := this
      _ = |t| * C := by rw [hC]; ring
  have h2 : |t| * C ≤ (ε / (C + 1)) * C := by
    have : (0:ℝ) ≤ C := hC0
    nlinarith [abs_nonneg t]
  have h3 : (ε / (C + 1)) * C ≤ ε := by
    rw [div_mul_eq_mul_div, div_le_iff₀ (by positivity)]
    nlinarith
  linarith

end Frontier

#print axioms Frontier.lieb_robinson
#print axioms Frontier.lieb_robinson_light_cone

