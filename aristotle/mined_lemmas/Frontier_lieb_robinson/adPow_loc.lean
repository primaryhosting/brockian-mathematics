variable {A : Type*} [NormedRing A] [NormedAlgebra ℝ A]

/-- The inner derivation (adjoint action) `ad H x = H * x - x * H`. -/

lemma adPow_loc
    (loc_mono : ∀ {p q p' q' : ℤ} {x : A}, p' ≤ p → q ≤ q' → loc p q x → loc p' q' x)
    (loc_comm : ∀ {p q p' q' : ℤ} {x y : A}, q < p' → loc p q x → loc p' q' y → x * y = y * x)
    (loc_zero : ∀ p q : ℤ, loc p q 0)
    (loc_add : ∀ {p q : ℤ} {x y : A}, loc p q x → loc p q y → loc p q (x + y))
    (loc_neg : ∀ {p q : ℤ} {x : A}, loc p q x → loc p q (-x))
    (loc_mul : ∀ {p q : ℤ} {x y : A}, loc p q x → loc p q y → loc p q (x * y))
    (Λ : Finset ℤ) (hh : ℤ → A) (H : A) (hH : H = ∑ z ∈ Λ, hh z)
    (hhloc : ∀ z ∈ Λ, loc z (z + 1) (hh z))
    {p q : ℤ} {x : A} (hx : loc p q x) (n : ℕ) :
    loc (p - n) (q + n) ((ad H)^[n] x) := by
  induction n with
  | zero => simpa using hx
  | succ n ih =>
      rw [Function.iterate_succ_apply']
      have hstep := ad_loc loc loc_mono loc_comm loc_zero loc_add loc_neg loc_mul Λ hh H hH
        hhloc ih
      have e1 : p - ((n : ℤ) + 1) = (p - n) - 1 := by ring
      have e2 : q + ((n : ℤ) + 1) = (q + n) + 1 := by ring
      simpa [e1, e2] using hstep

end Locality

/-- **Lieb–Robinson bound** (base case: nearest–neighbour interactions on a chain,
with the light-cone velocity governed by the total interaction strength `‖H‖`).

`loc p q x` means "the observable `x` is supported in the interval of sites `[p, q]`";
the hypotheses on `loc` are the standard quasi-locality axioms of a spin chain:
supports may be enlarged, observables with disjoint supports commute, and the
observables supported in a fixed interval form a subalgebra.

`H = ∑ z ∈ Λ, hh z` is a nearest–neighbour Hamiltonian, `hh z` being supported on the
bond `[z, z + 1]`, and `tau H t a` is the Heisenberg evolution of `a` generated by `H`.

If `a` is supported in `[pa, qa]`, `b` is supported in `[pb, qb]` and the two supports
are separated by a distance at least `d`, then the commutator of the evolved observable
with `b` obeys

`‖[tau H t a, b]‖ ≤ 2 ‖a‖ ‖b‖ (2‖H‖|t|)^d / d ! * exp (2‖H‖|t|)`,

which is super-exponentially small in `d` once `d ≫ e · 2‖H‖|t|`: an effective light cone
with velocity proportional to `‖H‖`. -/
