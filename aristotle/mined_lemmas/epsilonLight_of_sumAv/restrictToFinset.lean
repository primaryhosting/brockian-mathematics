/-- PSD ordering: M ⪯ N means N - M is PSD -/

def restrictToFinset {V : Type*} [Fintype V] [DecidableEq V] (G : SimpleGraph V) (S : Finset V) : SimpleGraph V where
  Adj i j := i ∈ S ∧ j ∈ S ∧ G.Adj i j
  symm := by
    -- Since adjacency is symmetric in a simple graph, if i is adjacent to j, then j is also adjacent to i. Therefore, the symmetric property holds.
    intros i j hij; exact ⟨hij.2.1, hij.1, hij.2.2.symm⟩
  loopless := by
    -- Since adjacency is irreflexive in a simple graph, the relation defined here is also irreflexive.
    intros i hi
    aesop

/-- L_S = Laplacian of G_S -/
abbrev Ls {V : Type*} [Fintype V] [DecidableEq V] (G : SimpleGraph V) (S : Finset V) : Matrix V V ℝ :=
  L (restrictToFinset G S)

