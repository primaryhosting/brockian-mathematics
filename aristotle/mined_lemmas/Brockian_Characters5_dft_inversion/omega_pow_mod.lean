/-- A primitive fifth root of unity. -/

lemma omega_pow_mod (m : ℕ) : omega ^ (m % 5) = omega ^ m := by
  conv_rhs => rw [← Nat.div_add_mod m 5, pow_add, pow_mul, omega_pow_five, one_pow, one_mul]

