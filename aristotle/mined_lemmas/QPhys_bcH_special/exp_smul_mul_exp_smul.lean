import Mathlib

open scoped BigOperators
open scoped Real
open scoped Nat
open scoped Classical
open scoped Pointwise

set_option maxHeartbeats 8000000
set_option maxRecDepth 4000
set_option synthInstance.maxHeartbeats 20000
set_option synthInstance.maxSize 128

set_option relaxedAutoImplicit false
set_option autoImplicit false

set_option grind.warning false

/-!
# A special case of the Baker–Campbell–Hausdorff formula

If the commutator `C = A * B - B * A` commutes with both `A` and `B` (i.e. `[A, B]` is central
for the subalgebra generated by `A` and `B`), then in a Banach algebra

`exp A * exp B = exp (A + B + (1/2) • (A * B - B * A))`.
-/

namespace QPhys

open NormedSpace

section BanachAlgebra

variable {𝔸 : Type*} [NormedRing 𝔸] [NormedAlgebra ℝ 𝔸] [CompleteSpace 𝔸]

/-- The scalar tower `ℚ → ℝ → 𝔸` makes any real Banach algebra a rational one; this is what
Mathlib's exponential API is phrased over. -/
noncomputable local instance ratNormedAlgebra : NormedAlgebra ℚ 𝔸 :=
  NormedAlgebra.restrictScalars ℚ ℝ 𝔸

/-- `exp (t • X)` and `exp (-t • X)` are mutually inverse. -/

lemma exp_smul_mul_exp_smul (A B : 𝔸) (hCA : Commute (A * B - B * A) A)
    (hCB : Commute (A * B - B * A) B) (t : ℝ) :
    exp (t • A) * exp (t • B) = exp (t • (A + B) + (t ^ 2 / 2) • (A * B - B * A)) := by
  obtain ⟨C, hCdef⟩ : ∃ C : 𝔸, C = A * B - B * A := ⟨_, rfl⟩
  rw [← hCdef] at hCA hCB ⊢
  have hCsum : Commute C (A + B) := hCA.add_right hCB
  -- the product of the two flows with the inverse of the conjectured answer has zero derivative
  have key : ∀ s : ℝ, HasDerivAt (fun r : ℝ =>
      (exp (r • A) * exp (r • B)) * (exp ((-r) • (A + B)) * exp ((-(r ^ 2 / 2)) • C))) 0 s := by
    intro s
    have hu : HasDerivAt (fun r : ℝ => exp (r • A)) (exp (s • A) * A) s :=
      hasDerivAt_exp_smul_const A s
    have hv : HasDerivAt (fun r : ℝ => exp (r • B)) (exp (s • B) * B) s :=
      hasDerivAt_exp_smul_const B s
    have hneg : HasDerivAt (fun r : ℝ => -r) (-1 : ℝ) s := by
      simpa using (hasDerivAt_id s).neg
    have hnegsq : HasDerivAt (fun r : ℝ => -(r ^ 2 / 2)) (-s) s := by
      simpa using ((hasDerivAt_pow 2 s).div_const 2).neg
    have hE1 : HasDerivAt (fun r : ℝ => exp ((-r) • (A + B)))
        ((-1 : ℝ) • (exp ((-s) • (A + B)) * (A + B))) s :=
      (hasDerivAt_exp_smul_const (A + B) (-s)).scomp s hneg
    have hE2 : HasDerivAt (fun r : ℝ => exp ((-(r ^ 2 / 2)) • C))
        ((-s) • (exp ((-(s ^ 2 / 2)) • C) * C)) s := by
      exact (hasDerivAt_exp_smul_const C (-(s ^ 2 / 2))).scomp s hnegsq
    have hprod := (hu.mul hv).mul (hE1.mul hE2)
    set E1 : 𝔸 := exp ((-s) • (A + B)) with hE1def
    set E2 : 𝔸 := exp ((-(s ^ 2 / 2)) • C) with hE2def
    convert hprod using 1
    symm
    simp only [Pi.mul_apply]
    -- commutation facts
    have h1 : E1 * (A + B) = (A + B) * E1 :=
      (((Commute.refl (A + B)).smul_left (-s)).exp_left).eq
    have h2 : E2 * C = C * E2 := (((Commute.refl C).smul_left (-(s ^ 2 / 2))).exp_left).eq
    have h3 : E1 * C = C * E1 := ((hCsum.symm.smul_left (-s)).exp_left).eq
    have hshift : A * exp (s • B) = exp (s • B) * (A + s • C) := by
      rw [hCdef]; exact mul_exp_smul_eq A B (hCdef ▸ hCB) s
    have hP : exp (s • A) * A * exp (s • B) + exp (s • A) * (exp (s • B) * B)
        = (exp (s • A) * exp (s • B)) * (A + B + s • C) := by
      rw [mul_assoc (exp (s • A)) A (exp (s • B)), hshift]
      simp [mul_add, mul_assoc]
      abel
    have hQ : ((-1 : ℝ) • (E1 * (A + B))) * E2 + E1 * ((-s) • (E2 * C))
        = -((A + B + s • C) * (E1 * E2)) := by
      have hcc : E1 * (C * E2) = C * (E1 * E2) := by rw [← mul_assoc, h3, mul_assoc]
      rw [neg_one_smul, h1]
      simp [add_mul, mul_assoc, h2, hcc]
      abel
    rw [hP, hQ, mul_neg, mul_assoc, add_neg_cancel]
  -- hence it is constantly equal to its value `1` at `t = 0`
  have hconst := is_const_of_deriv_eq_zero (f := fun r : ℝ =>
      (exp (r • A) * exp (r • B)) * (exp ((-r) • (A + B)) * exp ((-(r ^ 2 / 2)) • C)))
    (fun r => (key r).differentiableAt) (fun r => (key r).deriv) t 0
  simp only [zero_smul, neg_zero, exp_zero, mul_one, zero_pow, ne_eq,
    OfNat.ofNat_ne_zero, not_false_eq_true, zero_div] at hconst
  -- multiply by the inverse to conclude
  have hinv : (exp ((-t) • (A + B)) * exp ((-(t ^ 2 / 2)) • C))
      * (exp ((t ^ 2 / 2) • C) * exp (t • (A + B))) = 1 := by
    have e2 : exp ((-(t ^ 2 / 2)) • C) * exp ((t ^ 2 / 2) • C) = 1 := by
      have := exp_smul_mul_exp_neg_smul C (-(t ^ 2 / 2))
      rwa [neg_neg] at this
    calc (exp ((-t) • (A + B)) * exp ((-(t ^ 2 / 2)) • C))
          * (exp ((t ^ 2 / 2) • C) * exp (t • (A + B)))
        = exp ((-t) • (A + B)) * (exp ((-(t ^ 2 / 2)) • C) * exp ((t ^ 2 / 2) • C))
            * exp (t • (A + B)) := by noncomm_ring
      _ = exp ((-t) • (A + B)) * exp (t • (A + B)) := by rw [e2, mul_one]
      _ = 1 := by
          have := exp_smul_mul_exp_neg_smul (A + B) (-t)
          rwa [neg_neg] at this
  have hsplit : exp (t • (A + B) + (t ^ 2 / 2) • C)
      = exp ((t ^ 2 / 2) • C) * exp (t • (A + B)) := by
    rw [add_comm (t • (A + B)) ((t ^ 2 / 2) • C)]
    exact exp_add_of_commute ((hCsum.smul_left (t ^ 2 / 2)).smul_right t)
  calc exp (t • A) * exp (t • B)
      = (exp (t • A) * exp (t • B))
          * ((exp ((-t) • (A + B)) * exp ((-(t ^ 2 / 2)) • C))
            * (exp ((t ^ 2 / 2) • C) * exp (t • (A + B)))) := by rw [hinv, mul_one]
    _ = ((exp (t • A) * exp (t • B))
          * (exp ((-t) • (A + B)) * exp ((-(t ^ 2 / 2)) • C)))
            * (exp ((t ^ 2 / 2) • C) * exp (t • (A + B))) := (mul_assoc _ _ _).symm
    _ = exp ((t ^ 2 / 2) • C) * exp (t • (A + B)) := by rw [hconst, one_mul]
    _ = exp (t • (A + B) + (t ^ 2 / 2) • C) := hsplit.symm

/-- **Special case of the Baker–Campbell–Hausdorff formula.**  In a Banach algebra, if the
commutator `[A, B] = A * B - B * A` commutes with both `A` and `B`, then
`exp A * exp B = exp (A + B + (1/2) • [A, B])`. -/
