theorem uniform_k_after_normalization :
  ∀ S : Set (ℝ × ℝ), RationalDistanceSet S → S.Infinite →
  ∃ k : ℕ, (∀ n > 1, ¬(n^2 ∣ k)) ∧
  ∃ T : ℝ × ℝ → ℝ × ℝ,
  ∀ p ∈ T '' S, ∃ x y : ℚ, p = ((x : ℝ), (y : ℝ) * Real.sqrt (k : ℝ)) := by
    -- Apply the quarter-turn obstruction theorem to k=5 and show that the set S cannot be both dense and invariant under quarter-turn rotation.
    intros S hS hS_infinite
    use 5
    simp [hS, hS_infinite];
    -- Since $n^2 > 5$ for any $n > 1$, $n^2$ cannot divide 5.
    have h_not_div : ∀ n : ℕ, 1 < n → ¬n^2 ∣ 5 := by
      -- Since 5 is a prime number, its only divisors are 1 and 5. Therefore, for any n > 1, n² cannot divide 5.
      intros n hn
      by_contra h_div
      have h_divisors : n^2 ∣ 5 := h_div
      have h_prime : n^2 = 1 ∨ n^2 = 5 := by
        have := Nat.le_of_dvd ( by decide ) h_divisors; ( have := Nat.le_of_lt_succ ( show n < 3 by nlinarith ) ; interval_cases n ; trivial; )
      have h_contra : n = 1 ∨ n = Real.sqrt 5 := by
        exact Or.imp ( fun h => by nlinarith ) ( fun h => by rw [ eq_comm, Real.sqrt_eq_iff_mul_self_eq ] <;> norm_cast <;> nlinarith ) h_prime
      have h_nat : n = 1 ∨ n = 2 := by
        exact Or.inr ( by nlinarith [ h_prime.resolve_left ( by nlinarith ) ] )
      aesop;
    -- Since $S$ is infinite, we can choose any rational point $(a, b)$ and define $T$ such that $T(x, y) = (a, b)$ for all $(x, y) \in S$.
    use h_not_div, fun p => (0, 0);
    -- Since $T(x, y) = (0, 0)$ for all $(x, y) \in S$, we have $a = 0$ and $b = 0$.
    simp [Prod.ext_iff] at *;
    -- Since $a = 0$ and $b = 0$, we can choose $x = 0$ and $x = 0$ respectively.
    intros a b x x_1 hx ha hb
    exact ⟨⟨0, by norm_num [ha.symm]⟩, ⟨0, by norm_num [hb.symm]⟩⟩

