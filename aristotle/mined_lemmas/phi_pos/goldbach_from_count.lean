theorem goldbach_from_count {n : ℕ} (h : 1 ≤ goldbachCount n) :
    ∃ p q, Nat.Prime p ∧ Nat.Prime q ∧ p + q = n := by
      -- Since $1 \leq \text{goldbachCount } n$, there exists at least one pair of primes $p$ and $q$ such that $p + q = n$ by definition of $\text{goldbachCount}$.
      obtain ⟨p, hp⟩ : ∃ p ∈ Finset.range n, Nat.Prime p ∧ Nat.Prime (n - p) := by
        -- Since the cardinality of the set is at least 1, the set is non-empty.
        have h_nonempty : Finset.Nonempty (Finset.filter (fun p => Nat.Prime p ∧ Nat.Prime (n - p)) (Finset.range n)) := by
          -- Since the cardinality of the set is at least 1, the set is nonempty by definition.
          apply Finset.card_pos.mp h;
        -- Since the set is non-empty, we can obtain an element p from it.
        obtain ⟨p, hp⟩ := h_nonempty;
        use p;
        aesop;
      exact ⟨ p, n - p, hp.2.1, hp.2.2, Nat.add_sub_of_le ( Finset.mem_range_le hp.1 ) ⟩

structure GoldbachSpectralModel where
