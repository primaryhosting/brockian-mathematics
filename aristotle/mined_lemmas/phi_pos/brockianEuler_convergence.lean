/-- The golden conjugate ψ = (1 - √5)/2 ≈ -0.618... -/
noncomputable def ψ : ℝ := (1 - Real.sqrt 5) / 2

/-- The golden ratio φ = (1 + √5)/2 ≈ 1.618... -/

theorem brockianEuler_convergence (σ : ℝ) (hσ : 1 < σ) :
    Summable fun p : BPrime => ‖spiralTerm p (σ : ℂ)‖ := by
      -- By definition of $spiralTerm$, we know that its norm is $(p.val : ℝ) ^ (-σ)$.
      have h_norm : ∀ p : BPrime, ‖spiralTerm p (σ : ℂ)‖ = (p.val : ℝ) ^ (-σ) := by
        exact?;
      -- Since the sum over all primes converges, the sum over BPrime also converges.
      have h_summable_primes : Summable (fun p : ℕ => if Nat.Prime p then (p : ℝ) ^ (-σ) else 0) := by
        exact?;
      convert h_summable_primes.comp_injective ( show Function.Injective ( fun p : BPrime => p.val ) from fun a b h => by cases a; cases b; aesop ) using 1;
      -- By definition of $spiralTerm$, we know that its norm is $(p.val : ℝ) ^ (-σ)$ for any BPrime $p$.
      funext p; exact (by
      convert h_norm p using 1;
      exact if_pos p.isPrime)

