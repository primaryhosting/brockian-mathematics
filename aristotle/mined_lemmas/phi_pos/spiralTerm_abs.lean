import Mathlib

set_option linter.mathlibStandardSet false

open scoped BigOperators
open scoped Real
open scoped Nat
open scoped Classical
open scoped Pointwise

set_option maxHeartbeats 0
set_option maxRecDepth 4000
set_option synthInstance.maxHeartbeats 20000
set_option synthInstance.maxSize 128

set_option relaxedAutoImplicit false
set_option autoImplicit false

noncomputable section

open Complex Real BigOperators

open scoped ComplexConjugate

/-
The golden ratio φ = (1 + √5)/2 ≈ 1.618...
-/
def φ : ℝ := (1 + Real.sqrt 5) / 2

/-
The golden conjugate ψ = (1 - √5)/2 ≈ -0.618...
-/
def ψ : ℝ := (1 - Real.sqrt 5) / 2

/-
φ is positive
-/

theorem spiralTerm_abs (p : BPrime) (t : ℝ) :
    Complex.abs (spiralTerm p t) = (p.val : ℝ) ^ (-t) := by
      unfold spiralTerm;
      norm_num [ Complex.abs_exp ];
      rw [ Real.rpow_def_of_pos ( Nat.cast_pos.mpr p.isPrime.pos ) ] ; norm_num [ Complex.log_re, Complex.log_im ] ; ring

