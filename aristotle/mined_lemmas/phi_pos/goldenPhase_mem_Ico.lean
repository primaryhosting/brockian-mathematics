/-- The golden conjugate ψ = (1 - √5)/2 ≈ -0.618... -/
noncomputable def ψ : ℝ := (1 - Real.sqrt 5) / 2

/-- The golden ratio φ = (1 + √5)/2 ≈ 1.618... -/

theorem goldenPhase_mem_Ico (p : BPrime) :
    goldenPhase p ∈ Set.Ico (0 : ℝ) (2 * Real.pi) := by
      -- By definition of modulo, the golden phase is the remainder when phi * log(p) is divided by 2π, which means it's between 0 and 2π.
      have h_mod : ∀ x : ℝ, 0 ≤ x % (2 * Real.pi) ∧ x % (2 * Real.pi) < 2 * Real.pi := by
        -- By definition of modulo, the remainder when x is divided by 2π is always between 0 and 2π.
        intros x
        simp [EuclideanDomain.mod_eq_sub_mul_div];
        -- Since π is a positive real number, we have 0 < π.
        exact Real.pi_pos;
      exact h_mod _

