theorem spiralTerm_abs_real (p : BPrime) (σ : ℝ) :
    ‖spiralTerm p (σ : ℂ)‖ = (p.val : ℝ) ^ (-σ) := by
      -- Apply the property of the norm of an exponential function: ‖exp(z)‖ = exp(Re(z)).
      have h_norm_exp : ‖Complex.exp (-σ * ((1 : ℂ) + ((phi : ℝ) : ℂ) * I) * Real.log (p.val : ℝ))‖ = Real.exp (-σ * Real.log (p.val : ℝ)) := by
        -- The norm of the exponential of a complex number is the exponential of the real part of that complex number.
        have h_norm_exp : ∀ z : ℂ, ‖Complex.exp z‖ = Real.exp (z.re) := by
          -- The norm of the exponential of a complex number is the exponential of the real part of that complex number, by definition of the exponential function.
          intros z
          simp [Complex.norm_exp];
        -- Apply the norm of the exponential function to the complex number -(σ * (1 + phi * Complex.I) * Real.log (p.val)).
        simp [h_norm_exp];
        norm_num [ Complex.log_re, Complex.log_im ];
      -- Substitute h_norm_exp into the goal.
      convert h_norm_exp using 1;
      rw [ Real.rpow_def_of_pos ( Nat.cast_pos.mpr p.isPrime.pos ), mul_comm ]

