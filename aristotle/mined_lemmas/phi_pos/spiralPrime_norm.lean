/-- The golden ratio φ = (1 + √5)/2 ≈ 1.618... -/

theorem spiralPrime_norm (p : BPrime) : ‖spiralPrime p‖ = (p.val : ℝ) := by
  -- By definition of $spiralPrime$, we have $spiralPrime p = \exp(\log(p.val) * (1 + \phi * I))$.
  have h_spiralPrime : spiralPrime p = Complex.exp (Real.log (p.val : ℝ) * (1 + phi * I)) := by
    -- By definition of $spiralPrime$, we have $spiralPrime p = \exp(\log(p.val) * (1 + \phi * I))$ because $spiral(t) = \exp(t(1 + i\phi))$.
    simp [spiralPrime, spiral];
    -- By simplifying, we can see that the two expressions are indeed equal.
    ring;
  -- The norm of the exponential of a complex number is the exponential of the real part of that complex number.
  have h_norm_exp : ∀ z : ℂ, ‖Complex.exp z‖ = Real.exp (z.re) := by
    exact?;
  convert h_norm_exp _ using 1 ; norm_num [ h_spiralPrime ];
  norm_num [ Complex.log_re, Complex.log_im ];
  rw [ Real.exp_log ( Nat.cast_pos.mpr p.isPrime.pos ) ]

