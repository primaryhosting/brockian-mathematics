-- The action of the symmetry group `G` of a molecular skeleton `S` on the set of
-- substitution patterns `S → C` (assignments of substituents from `C` to the sites of `S`),
-- given by `(g • F) s = F (g⁻¹ • s)`.
attribute [local instance] arrowAction

variable {G S C : Type*} [Group G] [MulAction G S]

/-- The number of cycles of the skeleton symmetry `g` acting on the site set `S`,
i.e. the number of orbits of the cyclic group generated by `g`. -/

theorem index_zmultiples_zmod (n : ℕ) [NeZero n] (k : ZMod n) :
    (AddSubgroup.zmultiples k).index = Nat.gcd n k.val := by
  have hn : n ≠ 0 := NeZero.ne n
  have hk : ((k.val : ℕ) : ZMod n) = k := ZMod.natCast_zmod_val k
  have hord : addOrderOf k = n / Nat.gcd n k.val := by
    conv_lhs => rw [← hk]
    rw [ZMod.addOrderOf_coe _ hn]
  have hcard : Nat.card (AddSubgroup.zmultiples k) * (AddSubgroup.zmultiples k).index = n := by
    rw [AddSubgroup.card_mul_index, Nat.card_zmod]
  rw [Nat.card_zmultiples, hord] at hcard
  have hdvd : Nat.gcd n k.val ∣ n := Nat.gcd_dvd_left _ _
  have hgpos : 0 < Nat.gcd n k.val := Nat.gcd_pos_of_pos_left _ (Nat.pos_of_ne_zero hn)
  have hq : n / Nat.gcd n k.val * Nat.gcd n k.val = n := Nat.div_mul_cancel hdvd
  have hqpos : 0 < n / Nat.gcd n k.val :=
    Nat.div_pos (Nat.le_of_dvd (Nat.pos_of_ne_zero hn) hdvd) hgpos
  exact Nat.eq_of_mul_eq_mul_left hqpos (hcard.trans hq.symm)

/-- The rotation by `k` of an `n`-membered ring has `gcd n k` cycles. -/
