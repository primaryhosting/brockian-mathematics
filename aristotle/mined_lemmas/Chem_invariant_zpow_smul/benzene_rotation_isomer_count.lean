-- The action of the symmetry group `G` of a molecular skeleton `S` on the set of
-- substitution patterns `S → C` (assignments of substituents from `C` to the sites of `S`),
-- given by `(g • F) s = F (g⁻¹ • s)`.
attribute [local instance] arrowAction

variable {G S C : Type*} [Group G] [MulAction G S]

/-- The number of cycles of the skeleton symmetry `g` acting on the site set `S`,
i.e. the number of orbits of the cyclic group generated by `g`. -/

theorem benzene_rotation_isomer_count :
    Nat.card (orbitRel.Quotient (Multiplicative (ZMod 6)) (ZMod 6 → Bool)) = 14 := by
  have hterm : ∀ k : ZMod 6,
      (2 : ℕ) ^ Nat.gcd 6 k.val
        = Nat.card Bool ^ cycleCount (ZMod 6) (Multiplicative.ofAdd k) := by
    intro k
    rw [cycleCount_zmod_rotation]
    norm_num [Nat.card_eq_fintype_card]
  have hsum : ∑ g : Multiplicative (ZMod 6), Nat.card Bool ^ cycleCount (ZMod 6) g = 84 := by
    rw [← Fintype.sum_equiv (Multiplicative.ofAdd (α := ZMod 6))
      (fun k : ZMod 6 => (2 : ℕ) ^ Nat.gcd 6 k.val) _ hterm]
    decide
  have hG : Nat.card (Multiplicative (ZMod 6)) = 6 := by
    simp [Nat.card_eq_fintype_card]
  have h := polya_isomer_count (G := Multiplicative (ZMod 6)) (S := ZMod 6) (C := Bool)
  rw [hsum, hG] at h
  omega

end CyclicSkeleton

