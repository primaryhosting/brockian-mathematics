theorem RH_from_spectral_realization {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (B : SelfAdjointUnbounded H)
    (C : ℂ) (hC : C ≠ 0)
    (h_det : ∀ s : ℂ, detReg B s = C * completedRiemannZeta (1/2 + Complex.I * s))
    (h_spec : ∀ s, detReg B s = 0 ↔ B.hasEigenvalue s)
    (h_real : ∀ mu, B.hasEigenvalue mu → mu.im = 0)
    : ∀ (s : ℂ), completedRiemannZeta s = 0 → s.re = 1/2 := by
      -- Assume that the completed Riemann zeta function has a zero at some point $s$.
      intro s hs
      by_contra h_contra;
      -- Since $s$ is a zero of the completed Riemann zeta function, we have $detReg B ((s - 1/2) / Complex.I) = 0$.
      have h_det_zero : detReg B ((s - 1 / 2) / Complex.I) = 0 := by
        rw [ h_det, mul_comm ];
