open Matrix Polynomial

/-- A primitive 17-th root of unity. -/

lemma F17_apply (i j : Fin 17) : F17 i j = zeta (i * j) := by
  simp only [F17, Matrix.vandermonde_apply, zeta, Fin.val_mul, om_pow_mod, ← pow_mul]

