namespace QPhys

open NormedSpace

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]

/-- The time-evolution operator `U(t) = exp(-i H t / ℏ)` generated by a bounded operator `H`
(the Hamiltonian) on a complex Hilbert space `E`, with reduced Planck constant `ℏ`. -/

theorem timeEvolution_star_mul_self (hbar : ℝ) (H : E →L[ℂ] E) (hH : IsSelfAdjoint H) (t : ℝ) :
    star (timeEvolution hbar H t) * timeEvolution hbar H t = 1 ∧
      timeEvolution hbar H t * star (timeEvolution hbar H t) = 1 :=
  Unitary.mem_iff.mp (unitary_time_evolution hbar H hH t)

end QPhys

