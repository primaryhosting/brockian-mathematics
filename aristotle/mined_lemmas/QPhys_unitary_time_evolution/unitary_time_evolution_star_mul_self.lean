/-!
# Unitary Time Evolution
Category: Quantum Physics
Target: QPhys.unitary_time_evolution
Verification: pending
Provenance: Aristotle theorem prover (Harmonic)
-/

open NormedSpace Complex

namespace QPhys

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]

/-- The time-evolution operator `U(t) = exp(-i H t / ℏ)` generated by a Hamiltonian `H`
acting on a complex Hilbert space `E`. -/

theorem unitary_time_evolution_star_mul_self {H : E →L[ℂ] E} (hH : IsSelfAdjoint H) (hbar t : ℝ) :
    star (timeEvolution hbar H t) * timeEvolution hbar H t = 1 ∧
      timeEvolution hbar H t * star (timeEvolution hbar H t) = 1 :=
  ⟨(Unitary.mem_iff.mp (unitary_time_evolution hH hbar t)).1,
    (Unitary.mem_iff.mp (unitary_time_evolution hH hbar t)).2⟩

end QPhys

