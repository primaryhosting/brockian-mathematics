variable {A : Type*} [NormedRing A] [NormedAlgebra ℂ A] [StarRing A] [ContinuousStar A]
  [CompleteSpace A] [StarModule ℂ A]

/-- The time-evolution operator `U t = exp (-i H t / ℏ)` generated by a Hamiltonian `H`. -/

theorem inner_timeEvolution_hilbert (H : E →L[ℂ] E) (hH : IsSelfAdjoint H) (hbar t : ℝ)
    (x y : E) :
    inner ℂ (timeEvolution H hbar t x) (timeEvolution H hbar t y) = inner ℂ x y := by
  have h := (unitary_time_evolution_hilbert H hH hbar t).1
  have : ((star (timeEvolution H hbar t) * timeEvolution H hbar t : E →L[ℂ] E)) y = y := by
    rw [h]; simp
  calc inner ℂ (timeEvolution H hbar t x) (timeEvolution H hbar t y)
      = inner ℂ x ((star (timeEvolution H hbar t) * timeEvolution H hbar t : E →L[ℂ] E) y) := by
        simp [ContinuousLinearMap.star_eq_adjoint, ContinuousLinearMap.adjoint_inner_right]
    _ = inner ℂ x y := by rw [this]

end HilbertSpace

end QPhys

