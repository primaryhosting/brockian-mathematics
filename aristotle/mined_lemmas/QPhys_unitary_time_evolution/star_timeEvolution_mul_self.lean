namespace QPhys

open NormedSpace Complex

section Algebra

variable {A : Type*} [NormedRing A] [NormedAlgebra ℂ A] [StarRing A] [ContinuousStar A]
  [CompleteSpace A] [StarModule ℂ A]

/-- The time-evolution operator `U t = exp (-i H t / ℏ)` generated by a Hamiltonian `H`. -/

theorem star_timeEvolution_mul_self (H : A) (hH : IsSelfAdjoint H) (hbar t : ℝ) :
    star (timeEvolution H hbar t) * timeEvolution H hbar t = 1 ∧
      timeEvolution H hbar t * star (timeEvolution H hbar t) = 1 :=
  unitary_time_evolution H hH hbar t

end Algebra

section HilbertSpace

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]

/-- **Unitary time evolution on a Hilbert space.** For a bounded self-adjoint Hamiltonian
`H : E →L[ℂ] E` on a complex Hilbert space `E`, the evolution operator
`U t = exp (-i H t / ℏ)` is unitary for every real time `t`. -/
