import Mathlib

/-!
# Unitary time evolution

For a self-adjoint (Hermitian) Hamiltonian `H` acting on a finite-dimensional complex
Hilbert space, the time-evolution operator

  `U t = exp (-(I * t / ℏ) • H)`

is unitary for every real time `t`.  The proof observes that `-(I * t / ℏ) • H` is a
skew-adjoint element of the (Banach) star algebra of matrices, and that the exponential
of a skew-adjoint element is unitary.

We also record the two defining identities `U(t)ᴴ * U(t) = 1`, `U(t) * U(t)ᴴ = 1`, together
with the one-parameter group law `U(s + t) = U(s) * U(t)` and `U 0 = 1`.
-/

namespace QPhys

open scoped Matrix

attribute [local instance] Matrix.linftyOpNormedRing Matrix.linftyOpNormedAlgebra

variable {n : Type*} [Fintype n] [DecidableEq n]

/-- The time-evolution operator `U t = exp (-i H t / ℏ)` generated by a Hamiltonian `H`
(with reduced Planck constant `ℏ`). -/

theorem timeEvolution_add (hbar : ℝ) (H : Matrix n n ℂ) (s t : ℝ) :
    timeEvolution hbar H (s + t) = timeEvolution hbar H s * timeEvolution hbar H t := by
  have hs : (-(Complex.I * (((s + t : ℝ) : ℂ) / (hbar : ℂ))))
      = (-(Complex.I * ((s : ℂ) / hbar))) + (-(Complex.I * ((t : ℂ) / hbar))) := by
    push_cast; ring
  rw [timeEvolution, timeEvolution, timeEvolution, hs, add_smul,
    NormedSpace.exp_add_of_commute ((Commute.refl H).smul_left _ |>.smul_right _)]

end QPhys

