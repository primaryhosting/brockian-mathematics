import Mathlib

namespace QPhys

open Matrix NormedSpace

variable {n : Type*} [Fintype n] [DecidableEq n]

/-- The time-evolution operator `U(t) = exp(-i H t / ℏ)` generated by a Hamiltonian `H`. -/

lemma conjTranspose_exp_smul (c : ℂ) (A : Matrix n n ℂ) :
    (exp (c • A))ᴴ = exp ((starRingEnd ℂ c) • Aᴴ) := by
  rw [← Matrix.exp_conjTranspose]
  congr 1
  ext i j
  simp [Matrix.conjTranspose_apply]

/-- **Unitary time evolution.** If `H` is self-adjoint (Hermitian), then for every real time `t`
the operator `U(t) = exp(-i H t / ℏ)` is unitary. -/
