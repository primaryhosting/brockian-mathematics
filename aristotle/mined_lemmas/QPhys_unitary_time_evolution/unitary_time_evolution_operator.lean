import Mathlib

/-!
# Unitary Time Evolution
Category: Quantum Physics
Target: QPhys.unitary_time_evolution
Verification: pending
Provenance: Aristotle theorem prover (Harmonic)
-/

open NormedSpace Complex

namespace QPhys

section StarAlgebra

variable {A : Type*} [NormedRing A] [NormedAlgebra ℂ A] [StarRing A] [ContinuousStar A]
  [CompleteSpace A] [StarModule ℂ A]

/-- The time-evolution operator `U(t) = exp(-i H t / ℏ)` generated by a Hamiltonian `H`
(an element of a complex Banach star-algebra, e.g. a bounded operator on a Hilbert space). -/

theorem unitary_time_evolution_operator {H : E →L[ℂ] E} (hH : IsSelfAdjoint H) (hbar t : ℝ) :
    evolution hbar H t ∈ unitary (E →L[ℂ] E) :=
  unitary_time_evolution hH hbar t

/-- Time evolution preserves inner products (hence probabilities). -/
