open NormedSpace Complex

namespace QPhys

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]

/-- The time-evolution operator `U(t) = exp(-i H t / ℏ)` generated by a Hamiltonian `H`
acting on a complex Hilbert space `E`. -/

theorem neg_I_smul_mem_skewAdjoint {H : E →L[ℂ] E} (hH : IsSelfAdjoint H) (hbar t : ℝ) :
    (-(Complex.I * (t / hbar))) • H ∈ skewAdjoint (E →L[ℂ] E) := by
  rw [skewAdjoint.mem_iff, star_smul, hH.star_eq, ← neg_smul]
  congr 1
  simp

/-- **Unitary time evolution.** For a self-adjoint Hamiltonian `H` on a complex Hilbert space,
the time-evolution operator `U(t) = exp(-i H t / ℏ)` is unitary for every real time `t`. -/
