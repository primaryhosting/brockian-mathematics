import Mathlib

namespace QPhys

open Matrix NormedSpace

variable {n : Type*} [Fintype n] [DecidableEq n]

/-- The time-evolution operator `U(t) = exp(-i H t / ℏ)` generated by a Hamiltonian `H`. -/

theorem timeEvolution_mul_conjTranspose_self (H : Matrix n n ℂ) (hH : H.IsHermitian)
    (hbar t : ℝ) : timeEvolution H hbar t * (timeEvolution H hbar t)ᴴ = 1 :=
  (unitary_time_evolution H hH hbar t).2

/-- Unitary evolution preserves the Euclidean norm of state vectors:
`‖U(t) v‖ = ‖v‖` (stated as equality of the squared norms via the dot product). -/
