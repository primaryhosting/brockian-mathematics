namespace Frontier

variable {n : ℕ}

/-- The Euclidean pairing `⟨c, x⟩ = ∑ⱼ cⱼ xⱼ` on `Fin n → ℝ`. -/

lemma abs_le_l1Norm (k : Fin n → ℤ) (j : Fin n) : |(k j : ℝ)| ≤ l1Norm k :=
  Finset.single_le_sum (f := fun i => |(k i : ℝ)|) (fun _ _ => abs_nonneg _) (Finset.mem_univ j)

