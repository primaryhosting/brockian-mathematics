/-
This module defines a Brockian circle embedding on the 5-cycle using the 5th root of unity.
It defines `ω` as the 5th root of unity, `emb` as the embedding function, and `dist` as the Euclidean distance.
It proves that the rotation `a ↦ a + 1` is an isometry with respect to this distance.
-/

import Mathlib

set_option linter.mathlibStandardSet false

open scoped BigOperators
open scoped Real
open scoped Nat
open scoped Classical
open scoped Pointwise

set_option maxHeartbeats 0
set_option maxRecDepth 4000
set_option synthInstance.maxHeartbeats 20000
set_option synthInstance.maxSize 128

set_option relaxedAutoImplicit false
set_option autoImplicit false

noncomputable section

open scoped BigOperators

#check IsCyclotomicExtension.zeta

#check Complex.normSq

#check Complex.re
#check Real.sqrt
#synth Norm ℂ

/-
Defining Complex.zeta and Complex.abs as helpers. Complex.zeta n is exp(2πi/n). Complex.abs z is the norm of z.
-/
/-- Helper: Define Complex.zeta since it is missing -/

theorem dist_succ_succ (a b : Fin 5) : dist (a + 1) (b + 1) = dist a b := by
  unfold _root_.dist; ring;
  -- We can factor out ω from the difference, giving us ω * (emb a - emb b).
  have h_factor : emb (a + 1) - emb (b + 1) = ω * (emb a - emb b) := by
    rw [ emb_succ, emb_succ, mul_sub ];
  rw [ h_factor, abs_mul_ω ]
