/-
Defining Complex.zeta and Complex.abs as helpers. Complex.zeta n is exp(2πi/n). Complex.abs z is the norm of z.
-/
/-- Helper: Define Complex.zeta since it is missing -/

noncomputable def dist (a b : Fin 5) : ℝ := Complex.abs (emb a - emb b)

/-
Lemma: ω is not zero. Proof uses Complex.zeta_ne_zero.
-/
lemma ω_ne_zero : (ω : ℂ) ≠ 0 := by
  exact Complex.exp_ne_zero _

/-
