/-
Defining Complex.zeta and Complex.abs as helpers. Complex.zeta n is exp(2πi/n). Complex.abs z is the norm of z.
-/
/-- Helper: Define Complex.zeta since it is missing -/

lemma emb_succ (a : Fin 5) : emb (a + 1) = ω * emb a := by
  fin_cases a <;> simp +decide [ pow_succ', ← mul_assoc ];
  · unfold emb; norm_num [ pow_succ' ] ;
  · unfold emb; norm_num [ mul_comm ω, pow_succ' ] ;
  · unfold emb; ring;
    exact?;
  · unfold emb; ring; norm_num [ pow_succ, Complex.exp_ne_zero ] ;
    ring;
  · unfold emb;
    simp +decide [ ← pow_succ' ];
    rw [ show ω = Complex.exp ( 2 * Real.pi * Complex.I / 5 ) by rfl, ← Complex.exp_nat_mul, mul_comm ] ; norm_num

/-
Theorem: dist(a+1, b+1) = dist(a, b). Proof uses the definition of distance, the rotation property, and the fact that multiplication by ω preserves absolute value.
-/
/-- Rotation isometry: shifting both points by +1 preserves distance. -/
