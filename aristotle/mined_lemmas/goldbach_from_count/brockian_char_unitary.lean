theorem brockian_char_unitary (n : ℕ) (hn : n ≠ 0) :
    ‖brockianChar n‖ = 1 := by
      -- Since $n \neq 0$, we can apply the definition of `brockianChar` to get $\|brockianChar n\| = \|\exp(i \phi \log n)\|$.
