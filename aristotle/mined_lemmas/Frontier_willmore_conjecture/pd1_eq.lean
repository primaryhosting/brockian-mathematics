/-! ## Partial derivatives of functions of two real variables -/

/-- Partial derivative with respect to the first variable. -/

lemma pd1_eq {f g : ℝ → ℝ → ℝ} (h : ∀ u v, HasDerivAt (fun t => f t v) (g u v) u) :
    pd1 f = g := by
  funext u v; exact (h u v).deriv

