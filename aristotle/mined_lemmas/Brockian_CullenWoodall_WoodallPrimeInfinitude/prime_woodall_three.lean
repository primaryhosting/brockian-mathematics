/-- The `n`-th Woodall number `W n = n * 2 ^ n - 1` (natural subtraction; `W 0 = 0`). -/

lemma prime_woodall_three : Nat.Prime (woodall 3) := by
  rw [woodall_three]; norm_num

/-- `383 = W 6` is a Woodall prime. -/
