namespace Brockian.CullenWoodall

/-- The `n`-th Woodall number `W n = n * 2 ^ n - 1` (natural subtraction; `W 0 = 0`). -/

lemma lt_woodall_of_four_le {n : ℕ} (hn : 4 ≤ n) : 3 < woodall n :=
  lt_of_lt_of_le (by omega) (le_woodall (by omega))

