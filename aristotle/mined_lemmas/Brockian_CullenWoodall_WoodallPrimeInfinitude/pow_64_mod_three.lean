import Mathlib

namespace Brockian
namespace CullenWoodall

/-- The `n`-th Woodall number `W n = n * 2 ^ n - 1` (natural subtraction; `W 0 = 0`). -/

lemma pow_64_mod_three (k : ℕ) : (64 : ℕ) ^ k % 3 = 1 := by
  induction k with
  | zero => rfl
  | succ m ih => rw [pow_succ, Nat.mul_mod, ih]

/-- For every `k`, the Woodall number `W (6 k + 4)` is divisible by `3`. -/
