def goldbach_ray_equidistribution : Prop :=
  ∀ n : ℕ, n % 2 = 0 → n > 1000 →
    ∀ (pair1 pair2 : Fin 5 × Fin 5),
      pair1 ∈ validGoldbachRayPairs ⟨n % 5, Nat.mod_lt _ (by decide)⟩ →
      pair2 ∈ validGoldbachRayPairs ⟨n % 5, Nat.mod_lt _ (by decide)⟩ →
      let s1 := ((Finset.range (n + 1)).product (Finset.range (n + 1))).filter
        (fun x => x.1.Prime ∧ x.2.Prime ∧ x.1 + x.2 = n ∧ ray x.1 = pair1.1 ∧ ray x.2 = pair1.2)
      let s2 := ((Finset.range (n + 1)).product (Finset.range (n + 1))).filter
        (fun x => x.1.Prime ∧ x.2.Prime ∧ x.1 + x.2 = n ∧ ray x.1 = pair2.1 ∧ ray x.2 = pair2.2)
      abs ((s1.card : ℤ) - (s2.card : ℤ)) < 10
