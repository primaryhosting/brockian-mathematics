open Real Matrix SimpleGraph

namespace Chem

/-- The adjacency matrix (over `ℝ`) of the cycle graph `C₈`, i.e. the Hückel matrix of
cyclooctatetraene in units where `α = 0` and `β = 1`. -/

lemma vk_ne_zero (k : ℕ) : vk k ≠ 0 := by
  intro h
  have := congrFun h 0
  rw [vk_zero] at this
  norm_num at this

