/-- The adjacency matrix (over `ℝ`) of the cycle graph `C₈`, i.e. the Hückel matrix of
cyclooctatetraene in units where `α = 0` and `β = 1`. -/

lemma vk_zero (k : ℕ) : vk k 0 = 1 := by
  simp [vk, gk]

