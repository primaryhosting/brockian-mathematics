import Mathlib

namespace Chem

open Complex Matrix

/-- The adjacency matrix of the cycle graph `C₈`, indexed by `Fin 8` with cyclic
successor/predecessor. -/

lemma isPrimitiveRoot_om : IsPrimitiveRoot om 8 := by
  have := Complex.isPrimitiveRoot_exp 8 (by norm_num)
  simpa [om] using this

