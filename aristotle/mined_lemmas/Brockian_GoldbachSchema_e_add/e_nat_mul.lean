noncomputable section

/-- The additive character `e(x) = exp(2πi x)` on the circle. -/

lemma e_nat_mul (k : ℕ) (x : ℝ) : e (k * x) = (e x) ^ k := by
  unfold e
  rw [← Complex.exp_nat_mul]
  push_cast
  ring_nf

/-- `e x = 1` exactly when `x` is an integer. -/
