namespace Brockian.RieselCovering

/-- The Riesel number under consideration. -/

lemma covPrime_dvd_M (r : ℕ) : covPrime r ∣ M := by
  have h : r % 24 < 24 := Nat.mod_lt _ (by norm_num)
  unfold covPrime
  interval_cases h' : (r % 24) <;> decide

