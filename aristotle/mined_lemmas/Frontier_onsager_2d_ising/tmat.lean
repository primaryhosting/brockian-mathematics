/-! ## The model -/

/-- The real value `±1` of a spin encoded as a `Bool`. -/

def tmat (K : ℝ) : ℕ → Bool → Bool → ℝ
  | 0, a, b => if a = b then 1 else 0
  | (k + 1), a, b => ∑ c : Bool, tmat K k a c * tw K c b

