/-- The set of primes p ≤ n/2 such that n - p is also prime.
We restrict to p ≤ n/2 to avoid counting (p, n-p) and (n-p, p) separately. -/

theorem goldbach_from_spectral_model
    (M : SpectralModel)
    (h_small : ∀ n, n ≤ max 2 M.N₀ → n > 2 → Even n → Goldbach n) :
    ∀ n, n > 2 → Even n → Goldbach n := by
  intro n hn_gt_2 hEven
  by_cases hcase : n ≤ max 2 M.N₀
  · -- Small case: use computational verification
    exact h_small n hcase hn_gt_2 hEven
  · -- Large case: use spectral model
    push_neg at hcase
    have hn_large : n > max 2 M.N₀ := hcase
    -- Spectral model guarantees G(n) ≥ 1
    have h_reps : goldbachReps n ≥ 1 :=
      goldbachReps_ge_one_of_model M n hn_large hEven
    -- Convert to existence of prime pair
    obtain ⟨p, q, hp, hq, hsum⟩ := goldbach_rep_exists h_reps
    exact ⟨p, q, hp, hq, hsum⟩

