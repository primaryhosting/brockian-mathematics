namespace Phys

variable {S : Type*} [Fintype S] [Nonempty S] {N : ℕ}

/-- `pt x k` is the state of the trajectory `x` (of length `N + 1`) at time `k`. -/

lemma gibbs_pos (k : ℕ) (s : S) : 0 < P.gibbs k s :=
  div_pos (Real.exp_pos _) (P.Z_pos k)

