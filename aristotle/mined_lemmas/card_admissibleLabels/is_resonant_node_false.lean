lemma is_resonant_node_false (p : ℕ) (hp : p.Prime) : ¬ is_resonant_node p := by
  intro h
  unfold is_resonant_node at h
  -- We have ∀ t, ∃ k, 0.1 * p * t - ... = 2 * π * k
  -- The LHS is continuous in t, the RHS is discrete.
  -- This implies the LHS is constant, so 0.1 * p = 0, which is false.
