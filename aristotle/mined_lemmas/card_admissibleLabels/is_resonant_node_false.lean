  -- The image of a connected set (ℝ) under a continuous map is connected.
  -- The image is a subset of {2πk | k ∈ ℤ}, which is discrete.
  -- So the image must be a singleton.
  -- Thus the function is constant.
  -- Thus the derivative is 0.
  -- The derivative is 0.1 * p.
  -- So 0.1 * p = 0.
  -- So p = 0.
  -- But p is prime, so p ≥ 2. Contradiction.
  have h_image : Set.Countable (Set.range (fun t : ℝ => (fun t : ℝ => (0.1 * p * t - 2 * Real.pi * (p % 5) / 5)) t)) := by
    exact Set.Countable.mono ( Set.range_subset_iff.mpr fun t => by obtain ⟨ k, hk ⟩ := h_image t; exact ⟨ k, hk ▸ by ring ⟩ ) ( Set.countable_range fun k : ℤ => 2 * Real.pi * k );
