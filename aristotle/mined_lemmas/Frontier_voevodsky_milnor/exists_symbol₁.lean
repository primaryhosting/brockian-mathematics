import Mathlib

/-!
# Mod-2 Milnor K-theory of a field

We define, for a field `F` and `n : ℕ`, the group `k^M_n(F) = K^M_n(F)/2`, the `n`-th mod-2
Milnor K-theory group, as the quotient of the free `𝔽₂`-vector space on `n`-tuples of units of
`F` by the submodule generated by

* multiplicativity in each slot: `{…, ab, …} = {…, a, …} + {…, b, …}`, and
* the Steinberg relation: `{a₁, …, aₙ} = 0` whenever `aᵢ + aⱼ = 1` for some `i ≠ j`.

Since the coefficients are `𝔽₂`, this is exactly `K^M_n(F) ⊗ 𝔽₂ = K^M_n(F)/2`.
-/

open scoped Classical

namespace Frontier

universe u

variable (F : Type u) [Field F]

/-- The set of defining relations for mod-2 Milnor K-theory in degree `n`. -/

theorem exists_symbol₁ (x : MilnorK2 F 1) : ∃ a : Fˣ, x = symbol₁ a := by
  induction x using Submodule.Quotient.induction_on with
  | H v =>
    classical
    induction v using Finsupp.induction_linear with
    | zero => exact ⟨1, by rw [symbol₁_one]; simp⟩
    | add f g hf hg =>
      obtain ⟨a, ha⟩ := hf
      obtain ⟨b, hb⟩ := hg
      refine ⟨a * b, ?_⟩
      rw [symbol₁_mul, ← ha, ← hb, ← Submodule.Quotient.mk_add]
    | single t c =>
      refine ⟨if c = 0 then 1 else t 0, ?_⟩
      have h2 : c = 0 ∨ c = 1 := by
        revert c; decide
      rcases h2 with rfl | rfl
      · simp [symbol₁_one]
      · have ht : t = fun _ => t 0 := by funext k; fin_cases k; rfl
        simp only [if_neg (one_ne_zero : (1 : ZMod 2) ≠ 0)]
        rw [symbol₁, symbol, ← ht]
end Degree1

end Frontier

