import Mathlib

/-!
# Mod-2 Milnor K-theory of a field

We define, for a field `F` and `n : ℕ`, the group `k^M_n(F) = K^M_n(F)/2`, the `n`-th mod-2
Milnor K-theory group, as the quotient of the free `𝔽₂`-vector space on `n`-tuples of units of
`F` by the submodule generated by

* multiplicativity in each slot: `{…, ab, …} = {…, a, …} + {…, b, …}`, and
* the Steinberg relation: `{a₁, …, aₙ} = 0` whenever `aᵢ + aⱼ = 1` for some `i ≠ j`.

Since the coefficients are `𝔽₂`, this is exactly `K^M_n(F) ⊗ 𝔽₂ = K^M_n(F)/2`.
-/

open scoped Classical

namespace Frontier

universe u

variable (F : Type u) [Field F]

/-- The set of defining relations for mod-2 Milnor K-theory in degree `n`. -/

theorem milnorRelations_le_ker_normResidueCochain₁ (hF : (2 : F) ≠ 0) :
    milnorRelations F 1 ≤ LinearMap.ker (normResidueCochain₁ hF) := by
  rw [milnorRelations, Submodule.span_le]
  rintro x (⟨i, a, b, t, rfl⟩ | ⟨i, j, t, hij, -, rfl⟩)
  · simp only [SetLike.mem_coe, LinearMap.mem_ker, map_sub]
    have hi : i = 0 := Subsingleton.elim _ _
    subst hi
    simp only [normResidueCochain₁, Finsupp.linearCombination_single, one_smul,
      Function.update_self]
    ext g
    simp only [AddSubgroupClass.coe_sub, ZeroMemClass.coe_zero, LocallyConstant.sub_apply,
      LocallyConstant.zero_apply, kummerCochain_apply]
    rw [kummerChar_mul hF a b (g 0)]
    ring_nf
  · exact absurd (Subsingleton.elim i j) hij

/-- The degree-one norm residue map `k^M_1(F) → H^1(F, ℤ/2)`. -/
