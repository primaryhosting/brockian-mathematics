/-- The number of distinct residues of a finite set modulo p -/

theorem nu_p_eq_p_implies_divisor (G : Finset ℕ) (p : ℕ) [Fact (Nat.Prime p)]
    (h : nu_p G p = p) :
    ∀ n : ℕ, ∃ g ∈ G, p ∣ (n + g) := by
      -- Since $nu_p G p = p$, the set $G \mod p$ covers all residues modulo $p$.
      have h_covers_all_residues : ∀ r : ℕ, r < p → ∃ g ∈ G, g % p = r := by
        contrapose! h;
        obtain ⟨ r, hr, hr' ⟩ := h; exact ne_of_lt ( lt_of_lt_of_le ( Finset.card_lt_card <| Finset.ssubset_iff_subset_ne.2 ⟨ Finset.image_subset_iff.2 fun x hx => Finset.mem_range.2 <| Nat.mod_lt _ <| Nat.Prime.pos Fact.out, fun h => by have := Finset.mem_image.1 ( h.symm ▸ Finset.mem_range.2 hr ) ; aesop ⟩ ) <| by simp +decide [ Finset.card_image_of_injOn ] ) ;
      intro n;
      obtain ⟨ g, hg₁, hg₂ ⟩ := h_covers_all_residues ( ( p - ( n % p ) ) % p ) ( Nat.mod_lt _ ( Nat.Prime.pos Fact.out ) );
      exact ⟨ g, hg₁, Nat.dvd_of_mod_eq_zero ( by rw [ Nat.add_mod, hg₂ ] ; simp +decide [ Nat.add_sub_of_le ( Nat.mod_lt n ( Nat.Prime.pos Fact.out ) |> Nat.le_of_lt ) ] ) ⟩

