/-- The number of distinct residues of a finite set modulo p -/

lemma summable_log_local_factor (G : Finset ℕ)
    (h_adm : ∀ p : ℕ, Nat.Prime p → nu_p G p < p) :
    Summable (fun p : ℕ => if Nat.Prime p then log (localFactor G p) else 0) := by
      -- We'll use the fact that if the series $\sum_{p} \left| \log \left( \frac{1 - \nu_p(G)/p}{(1 - 1/p)^k} \right) \right|$ converges, then the series $\sum_{p} \log \left( \frac{1 - \nu_p(G)/p}{(1 - 1/p)^k} \right)$ also converges.
      have h_log_summable : Summable (fun p : ℕ => if Nat.Prime p then |Real.log (localFactor G p)| else 0) := by
        have h_log_summable : Summable (fun p : ℕ => if Nat.Prime p then |localFactor G p - 1| else 0) := by
          exact?;
        have h_log_bound : ∀ᶠ p in Filter.atTop, Nat.Prime p → |Real.log (localFactor G p)| ≤ 2 * |localFactor G p - 1| := by
          have h_log_bound : ∀ᶠ p in Filter.atTop, Nat.Prime p → |localFactor G p - 1| < 1 / 2 := by
            have := h_log_summable.tendsto_atTop_zero;
            filter_upwards [ this.eventually ( gt_mem_nhds <| show 0 < 1 / 2 by norm_num ) ] with p hp hp' using by aesop;
          filter_upwards [ h_log_bound ] with p hp hp' using log_bound_near_one _ ( hp hp' );
        rw [ ← summable_nat_add_iff ( Classical.choose ( Filter.eventually_atTop.mp h_log_bound ) ) ] at *;
        refine' .of_nonneg_of_le ( fun n => _ ) ( fun n => _ ) ( h_log_summable.mul_left 2 );
        · positivity;
        · have := Classical.choose_spec ( Filter.eventually_atTop.mp h_log_bound ) ( n + Classical.choose ( Filter.eventually_atTop.mp h_log_bound ) ) ( by linarith ) ; aesop;
      exact Summable.of_norm <| h_log_summable.congr fun p => by aesop;

