/-- The number of distinct residues of a finite set modulo p -/

theorem singular_series_converges (G : Finset ℕ)
    (h_adm : ∀ p : ℕ, Nat.Prime p → nu_p G p < p)
    (h_nonempty : G.Nonempty) :
    ∃ S : ℝ, 0 < S ∧
    Filter.Tendsto (singularSeriesFinite G) Filter.atTop (nhds S) := by
      -- Using the lemma on summability of logarithms, we can exponentiate the sum to get the product.
      have h_exp_sum : ∃ S, 0 < S ∧ Filter.Tendsto (fun P => Real.exp (∑ p ∈ ((Finset.range (P + 1)).filter Nat.Prime), Real.log (localFactor G p))) Filter.atTop (nhds S) := by
        have h_exp_sum : Summable (fun p => if Nat.Prime p then Real.log (localFactor G p) else 0) := by
          -- Apply the summable_log_local_factor lemma with the given hypothesis h_adm.
          apply summable_log_local_factor; assumption;
        use Real.exp (∑' p : ℕ, if Nat.Prime p then Real.log (localFactor G p) else 0);
        exact ⟨ Real.exp_pos _, Real.continuous_exp.continuousAt.tendsto.comp <| by simpa [ Finset.sum_filter ] using h_exp_sum.hasSum.tendsto_sum_nat.comp <| Filter.tendsto_add_atTop_nat 1 ⟩;
      convert h_exp_sum using 5;
      rw [ Real.exp_sum, Finset.prod_congr rfl fun p hp => Real.exp_log <| ?_ ] ; aesop;
      exact div_pos ( sub_pos.mpr <| by rw [ div_lt_iff₀ ] <;> norm_cast <;> linarith [ h_adm p <| Finset.mem_filter.mp hp |>.2, Nat.Prime.one_lt <| Finset.mem_filter.mp hp |>.2 ] ) <| pow_pos ( sub_pos.mpr <| by rw [ div_lt_iff₀ ] <;> norm_cast <;> linarith [ h_adm p <| Finset.mem_filter.mp hp |>.2, Nat.Prime.one_lt <| Finset.mem_filter.mp hp |>.2 ] ) _

