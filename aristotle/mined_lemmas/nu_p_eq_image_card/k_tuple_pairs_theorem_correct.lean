/-- The number of distinct residues of a finite set modulo p -/

theorem k_tuple_pairs_theorem_correct (q : ℕ) [Fact (Nat.Prime q)]
    (g : ℕ → ℕ) (hga : AdmissiblePair q g) :
    (PrincipalKTuples q g 2).card = q - 2 := by
      -- Let's first show that the number of elements in the finite set `PrincipalKTuples q g 2` is equal to `q - 2`.
      have h_card : (Finset.univ.filter (fun n : ZMod q => ∀ i : Fin 2, (n + g i) ≠ 0)).card = q - 2 := by
        -- Since the tuple is admissible, the numbers $-g(0)$ and $-g(1)$ are distinct modulo $q$.
        have h_distinct : (-(g 0 : ZMod q)) ≠ (-(g 1 : ZMod q)) := by
          exact fun h => hga <| by simpa [ ← ZMod.natCast_eq_natCast_iff' ] using neg_inj.mp h;
        simp_all +decide [ Fin.forall_fin_two, Finset.filter_ne', Finset.card_sdiff ];
        rw [ show ( Finset.univ.filter fun n : ZMod q => ¬n + ( g 0 : ZMod q ) = 0 ∧ ¬n + ( g 1 : ZMod q ) = 0 ) = Finset.univ \ { - ( g 0 : ZMod q ), - ( g 1 : ZMod q ) } by ext; simp +decide [ add_eq_zero_iff_eq_neg ] ] ; rw [ Finset.card_sdiff ] ; norm_num [ Finset.card_univ, h_distinct ];
      convert h_card using 1;
      refine' Finset.card_bij ( fun n hn => n ) _ _ _ <;> simp +decide [ Finset.mem_filter, Finset.mem_range ];
      · simp_all +decide [ ← ZMod.val_natCast, Finset.mem_filter, Finset.mem_range, PrincipalKTuples ];
      · simp +decide [ PrincipalKTuples ];
        exact fun a₁ ha₁ ha₂ a₂ ha₃ ha₄ h => Nat.mod_eq_of_lt ha₁ ▸ Nat.mod_eq_of_lt ha₃ ▸ by simpa [ ← ZMod.natCast_eq_natCast_iff' ] using h;
      · intro b hb₀ hb₁; use b.val; simp_all +decide [ PrincipalKTuples ] ;
        exact ⟨ ZMod.val_lt b, fun i hi => by rw [ ← ZMod.val_natCast ] ; interval_cases i <;> simp_all +decide [ ← ZMod.natCast_eq_zero_iff ] ⟩

