namespace Frontier

/-- `RestrictedBurnside m n` is the statement of the *restricted Burnside problem* for
`m` generators and exponent `n`: there is a uniform bound `N` on the order of every finite
group that is generated by `m` elements and has exponent dividing `n`.

(Equivalently, there are only finitely many isomorphism classes of such groups.)
Zelmanov's theorem asserts that `RestrictedBurnside m n` holds for all `m` and all `n ≥ 1`. -/

theorem restrictedBurnside_one_generator {n : ℕ} (hn : 0 < n) : RestrictedBurnside 1 n := by
  refine ⟨n, fun G _ _ g hgen hexp => ?_⟩
  have hcyc : IsCyclic G := by
    refine ⟨g 0, fun x => ?_⟩
    have hx : x ∈ Subgroup.closure (Set.range g) := hgen ▸ Subgroup.mem_top x
    have hr : Set.range g = {g 0} := by
      ext y
      simp [eq_comm]
    rw [hr, Subgroup.mem_closure_singleton] at hx
    obtain ⟨k, hk⟩ := hx
    exact ⟨k, hk⟩
  letI : CommGroup G := IsCyclic.commGroup
  have := card_le_of_commGroup (G := G) (ι := Fin 1) hn g hgen hexp
  simpa [Nat.card_eq_fintype_card] using this

