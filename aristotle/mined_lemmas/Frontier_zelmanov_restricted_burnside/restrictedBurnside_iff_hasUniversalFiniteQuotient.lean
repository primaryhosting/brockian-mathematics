/-- `IsBurnsideQuotient m n G` says that the group `G` is generated by `m` elements and has
exponent dividing `n`. -/

theorem restrictedBurnside_iff_hasUniversalFiniteQuotient (m n : ℕ) :
    RestrictedBurnside m n ↔ HasUniversalFiniteQuotient m n := by
  constructor
  · rintro ⟨B, hB⟩
    set S : Set ℕ :=
      {k | ∃ N : Subgroup (FreeGroup (Fin m)), IsBurnsideKernel m n N ∧ N.index = k}
    have htop : IsBurnsideKernel m n (⊤ : Subgroup (FreeGroup (Fin m))) :=
      ⟨inferInstance, by simp, fun g => trivial⟩
    have hne : S.Nonempty := ⟨(⊤ : Subgroup (FreeGroup (Fin m))).index, ⟨⊤, htop, rfl⟩⟩
    have hbdd : BddAbove S := by
      refine ⟨B, ?_⟩
      rintro k ⟨N, hN, rfl⟩
      exact index_le_of_isBurnsideKernel hB hN
    obtain ⟨N, hN, hNk⟩ : sSup S ∈ S := Nat.sSup_mem hne hbdd
    refine ⟨N, hN, ?_⟩
    intro M hM
    haveI := hN.normal
    haveI := hM.normal
    have hinf : IsBurnsideKernel m n (N ⊓ M) :=
      ⟨inferInstance, Subgroup.index_inf_ne_zero hN.index_ne_zero hM.index_ne_zero,
        fun g => ⟨hN.pow_mem g, hM.pow_mem g⟩⟩
    have h1 : (N ⊓ M).index ≤ N.index := by
      rw [hNk]
      exact le_csSup hbdd ⟨N ⊓ M, hinf, rfl⟩
    have h2 : (N ⊓ M).relIndex N * N.index = (N ⊓ M).index :=
      Subgroup.relIndex_mul_index inf_le_left
    have hipos : 0 < N.index := Nat.pos_of_ne_zero hN.index_ne_zero
    have h3 : (N ⊓ M).relIndex N = 1 := by
      rcases Nat.lt_or_ge ((N ⊓ M).relIndex N) 2 with h | h
      · interval_cases hr : (N ⊓ M).relIndex N
        · exact absurd (by rw [← h2, zero_mul]) hinf.index_ne_zero
        · rfl
      · exfalso
        have hlt : N.index < N.index :=
          calc N.index < 2 * N.index := by omega
            _ ≤ (N ⊓ M).relIndex N * N.index := Nat.mul_le_mul_right _ h
            _ = (N ⊓ M).index := h2
            _ ≤ N.index := h1
        exact lt_irrefl _ hlt
    exact le_trans (Subgroup.relIndex_eq_one.mp h3) inf_le_right
  · rintro ⟨N, hN, hmin⟩
    refine ⟨N.index, ?_⟩
    intro G _ _ hG
    obtain ⟨K, hK, hKcard⟩ := exists_kernel_of_isBurnsideQuotient G hG
    have hdvd : K.index ∣ N.index := Subgroup.index_dvd_of_le (hmin K hK)
    have hle := Nat.le_of_dvd (Nat.pos_of_ne_zero hN.index_ne_zero) hdvd
    omega

end Reduction

