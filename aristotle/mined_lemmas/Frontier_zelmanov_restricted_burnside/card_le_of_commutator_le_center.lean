namespace Frontier

/-- `RestrictedBurnside m n` is the statement of the *restricted Burnside problem* for
`m` generators and exponent `n`: there is a uniform bound `N` on the order of every finite
group that is generated by `m` elements and has exponent dividing `n`.

(Equivalently, there are only finitely many isomorphism classes of such groups.)
Zelmanov's theorem asserts that `RestrictedBurnside m n` holds for all `m` and all `n ≥ 1`. -/

theorem card_le_of_commutator_le_center {m n : ℕ} (hn : 0 < n) (g : Fin m → G)
    (hgen : Subgroup.closure (Set.range g) = ⊤) (hexp : ∀ x : G, x ^ n = 1)
    (hcent : commutator G ≤ Subgroup.center G) :
    Nat.card G ≤ n ^ m * n ^ (m * m) := by
  have h1 := card_abelianization_le hn g hgen hexp
  have h2 := card_commutator_le hn g hgen hexp hcent
  have h3 : Nat.card G = Nat.card (G ⧸ commutator G) * Nat.card (commutator G) :=
    Subgroup.card_eq_card_quotient_mul_card_subgroup _
  have h4 : Nat.card (G ⧸ commutator G) = Nat.card (Abelianization G) := rfl
  rw [h3, h4]
  exact Nat.mul_le_mul h1 h2

end ClassTwo

/-- The restricted Burnside problem has a positive solution for groups of nilpotency class at
most `2`, with the explicit bound `n ^ m * n ^ (m * m)`. -/
