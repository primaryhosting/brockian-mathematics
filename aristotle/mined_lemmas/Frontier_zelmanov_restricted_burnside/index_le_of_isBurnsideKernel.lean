/-- `IsBurnsideQuotient m n G` says that the group `G` is generated by `m` elements and has
exponent dividing `n`. -/

theorem index_le_of_isBurnsideKernel {B : ℕ}
    (hB : ∀ (G : Type) [Group G] [Finite G], IsBurnsideQuotient m n G → Nat.card G ≤ B)
    {N : Subgroup (FreeGroup (Fin m))} (hN : IsBurnsideKernel m n N) : N.index ≤ B := by
  haveI := hN.normal
  haveI := finite_quotient_of_index_ne_zero hN.index_ne_zero
  have h := hB (FreeGroup (Fin m) ⧸ N) (isBurnsideQuotient_quotient hN.pow_mem)
  rwa [← Subgroup.index_eq_card] at h

/-- If the restricted Burnside property holds for exponent `n`, it holds for every divisor
of `n`. -/
