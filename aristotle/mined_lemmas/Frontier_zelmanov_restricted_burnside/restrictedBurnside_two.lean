/-- `IsBurnsideQuotient m n G` says that the group `G` is generated by `m` elements and has
exponent dividing `n`. -/

theorem restrictedBurnside_two (m : ℕ) : RestrictedBurnside m 2 := by
  refine ⟨2 ^ m, ?_⟩
  intro G _ _ hG
  have hinv : ∀ g : G, g⁻¹ = g := by
    intro g
    have : g * g = 1 := by simpa [pow_two] using hG.1 g
    exact inv_eq_of_mul_eq_one_left this
  letI : CommGroup G :=
    { (inferInstance : Group G) with
      mul_comm := by
        intro a b
        calc a * b = (a * b)⁻¹ := (hinv _).symm
          _ = b⁻¹ * a⁻¹ := mul_inv_rev a b
          _ = b * a := by rw [hinv, hinv] }
  exact restrictedBurnsideComm m 2 (by norm_num) G hG

/-- **Sharpness of the hypothesis `0 < n`.** For exponent `n = 0` the condition `g ^ n = 1` is
vacuous, and the restricted Burnside property fails as soon as there is at least one
generator: the cyclic groups of all orders are generated by one element. -/
