/-- `IsBurnsideQuotient m n G` says that the group `G` is generated by `m` elements and has
exponent dividing `n`. -/

theorem restrictedBurnside_zero_gen (n : ℕ) : RestrictedBurnside 0 n := by
  refine ⟨1, ?_⟩
  intro G _ _ hG
  obtain ⟨-, f, hf⟩ := hG
  have hbot : (⊥ : Subgroup G) = ⊤ := by
    rw [← hf, Set.range_eq_empty f, Subgroup.closure_empty]
  have h : ∀ g : G, g = 1 := by
    intro g
    have : g ∈ (⊥ : Subgroup G) := by rw [hbot]; trivial
    simpa using this
  haveI : Subsingleton G := ⟨fun a b => by rw [h a, h b]⟩
  simp

/-- **Base case `m = 1`.** A cyclic group of exponent dividing `n` has order at most `n`. -/
