/-! ## Basic differential operators on `ℝ³` -/

/-- The physical space `ℝ³`, as functions `Fin 3 → ℝ`. -/
abbrev Vec := Fin 3 → ℝ

/-- The `i`-th partial derivative of a scalar field on `ℝ³`. -/

@[simp] theorem partialD_const (c : ℝ) (i : Fin 3) (x : Vec) :
    partialD (fun _ => c) i x = 0 := by
  simp [partialD]

