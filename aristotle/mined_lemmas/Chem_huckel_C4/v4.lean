/-! ### Values of `cos (2πm/4)` -/

/-- `cos (2πm/4)` only depends on `m % 4`. -/

noncomputable def v4 (k : Fin 4) : Fin 4 → ℝ :=
  fun j => Real.cos (2 * π * (k : ℕ) * (j : ℕ) / 4)

