/-! ## Basic notions -/

/-- The rank-one (orthogonal) projection onto the line spanned by a unit vector `v`,
written as the matrix `v vᴴ`. -/

private lemma fin_two_cases (j : Fin 2) : j = 0 ∨ j = 1 := by
  fin_cases j
  · exact Or.inl rfl
  · exact Or.inr rfl

