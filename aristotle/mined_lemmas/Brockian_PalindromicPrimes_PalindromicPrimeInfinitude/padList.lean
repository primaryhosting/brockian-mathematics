namespace Brockian.PalindromicPrimes

open Nat

/-- `IsPalindromic b n` says that the base-`b` digit expansion of `n` reads the same
forwards and backwards. -/

private def padList (k : ℕ) : List ℕ := 1 :: (List.replicate k 0 ++ [1])

