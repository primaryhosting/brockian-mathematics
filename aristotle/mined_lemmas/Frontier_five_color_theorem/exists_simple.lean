/-
Combinatorial maps (rotation systems) of genus zero, and Euler's formula.

A *combinatorial map* consists of a finite set `D` of darts, a permutation `σ`
whose cycles are the vertices, and a fixed-point-free involution `α` pairing the
two darts of each edge.  The cycles of `σ * α` are the faces.  A map is
*connected* when the group generated by `σ` and `α` acts transitively, and it has
*genus zero* (i.e. it is a plane map) when `V - E + F = 2`.

Here the vertices are labelled by a type `V` via a map `w : D → V` whose fibres
are exactly the cycles of `σ`.
-/
import RequestProject.CycleCount

namespace FiveColor

open Equiv Equiv.Perm SimpleGraph

section Counting

variable {D : Type*} [Fintype D] [DecidableEq D]

open scoped Classical in
/-- The cycle of `x` under `π`, as a `Finset`. -/

theorem exists_simple (M : Rot V) : ∃ N : Rot V, N.Simple ∧ M.graph ≤ N.graph :=
  exists_simple_aux _ M rfl

end Rot

end FiveColor

import Mathlib

open scoped BigOperators
open scoped Real
open scoped Nat
open scoped Classical
open scoped Pointwise

set_option maxHeartbeats 8000000
set_option maxRecDepth 4000
set_option synthInstance.maxHeartbeats 20000
set_option synthInstance.maxSize 128

set_option relaxedAutoImplicit false
set_option autoImplicit false

set_option pp.fullNames true
set_option pp.structureInstances true
set_option pp.coercions.types true
set_option pp.funBinderTypes true
set_option pp.letVarTypes true
set_option pp.piBinderTypes true

set_option grind.warning false

/-
Cycle counting toolkit for permutations of a finite type.

This file develops the combinatorial facts about numbers of cycles (orbits) of
permutations that are needed for Euler's formula for combinatorial maps:

* `numCycles π` : the number of cycles of a permutation `π`;
* `skip π S` : the permutation of the complement of `S` obtained from `π` by
  "skipping over" the elements of `S`;
* the effect on the number of cycles of multiplying by a transposition.
-/
import Mathlib

namespace FiveColor

open Equiv Equiv.Perm

variable {D : Type*} [Fintype D] [DecidableEq D]

/-- The class of `x` in the quotient by "being in the same cycle". -/
abbrev cyc (π : Perm D) (x : D) : Quotient (SameCycle.setoid π) :=
  Quotient.mk (SameCycle.setoid π) x

omit [Fintype D] [DecidableEq D] in
