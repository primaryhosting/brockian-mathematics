/-
Combinatorial maps (rotation systems) of genus zero, and Euler's formula.

A *combinatorial map* consists of a finite set `D` of darts, a permutation `σ`
whose cycles are the vertices, and a fixed-point-free involution `α` pairing the
two darts of each edge.  The cycles of `σ * α` are the faces.  A map is
*connected* when the group generated by `σ` and `α` acts transitively, and it has
*genus zero* (i.e. it is a plane map) when `V - E + F = 2`.

Here the vertices are labelled by a type `V` via a map `w : D → V` whose fibres
are exactly the cycles of `σ`.
-/
import RequestProject.CycleCount

namespace FiveColor

open Equiv Equiv.Perm SimpleGraph

section Counting

variable {D : Type*} [Fintype D] [DecidableEq D]

open scoped Classical in
/-- The cycle of `x` under `π`, as a `Finset`. -/

theorem cycFiber_of_fixed {π : Perm D} {x : D} (hx : π x = x) : cycFiber π x = {x} := by
  classical
  ext z
  simp only [mem_cycFiber, Finset.mem_singleton]
  constructor
  · rintro ⟨i, hi⟩
    have hfix : ∀ j : ℤ, (π ^ j) x = x := fun j =>
      Equiv.Perm.zpow_apply_eq_self_of_apply_eq_self hx j
    have h2 := congrArg (fun y => (π ^ (-i)) y) hi
    simp only [← Perm.mul_apply, ← zpow_add] at h2
    simp only [neg_add_cancel, zpow_zero, Perm.coe_one, id_eq] at h2
    rw [hfix (-i)] at h2
    exact h2
  · rintro rfl
    exact SameCycle.rfl

end Counting

/-- A connected genus-zero combinatorial map with vertices labelled by `V`. -/
structure Rot (V : Type*) where
  /-- the (finite) set of darts -/
  D : Type
  [fin : Fintype D]
  [dec : DecidableEq D]
  /-- the rotation: its cycles are the vertices -/
  σ : Perm D
  /-- the edge involution -/
  α : Perm D
  /-- the vertex labelling -/
  w : D → V
  α_inv : ∀ d, α (α d) = d
  w_sigma : ∀ d, w (σ d) = w d
  w_surj : Function.Surjective w
  w_cycle : ∀ d e, w d = w e → σ.SameCycle d e
  noloop : ∀ d, w (α d) ≠ w d
  conn : ∀ d e, Relation.ReflTransGen (fun x y => y = σ x ∨ y = α x) d e
  euler : 2 + numCycles α ≤ numCycles σ + numCycles (σ * α)

attribute [instance] Rot.fin Rot.dec

namespace Rot

variable {V : Type*} (M : Rot V)

/-- A map is simple when distinct edges have distinct pairs of endpoints. -/
