/-
Combinatorial maps (rotation systems) of genus zero, and Euler's formula.

A *combinatorial map* consists of a finite set `D` of darts, a permutation `σ`
whose cycles are the vertices, and a fixed-point-free involution `α` pairing the
two darts of each edge.  The cycles of `σ * α` are the faces.  A map is
*connected* when the group generated by `σ` and `α` acts transitively, and it has
*genus zero* (i.e. it is a plane map) when `V - E + F = 2`.

Here the vertices are labelled by a type `V` via a map `w : D → V` whose fibres
are exactly the cycles of `σ`.
-/
import RequestProject.CycleCount

namespace FiveColor

open Equiv Equiv.Perm SimpleGraph

section Counting

variable {D : Type*} [Fintype D] [DecidableEq D]

open scoped Classical in
/-- The cycle of `x` under `π`, as a `Finset`. -/

theorem three_le_face_card (hs : M.Simple) (hdeg : ∀ d, M.σ d ≠ d) (x : M.D) :
    3 ≤ (cycFiber (M.σ * M.α) x).card := by
  classical
  set φ := M.σ * M.α with hφ
  have hφa : ∀ z, φ z = M.σ (M.α z) := fun z => rfl
  have h1 : φ x ≠ x := by
    intro h
    have hw : M.w (M.σ (M.α x)) = M.w (M.α x) := M.w_sigma _
    rw [hφa] at h
    rw [h] at hw
    exact M.noloop x hw.symm
  have h2 : φ (φ x) ≠ x := by
    intro h
    have hy : M.w (φ x) = M.w (M.α x) := by rw [hφa]; exact M.w_sigma _
    have hx2 : M.w (M.α (φ x)) = M.w x := by
      have hw : M.w (M.σ (M.α (φ x))) = M.w (M.α (φ x)) := M.w_sigma _
      rw [← hw, ← hφa, h]
    by_cases hcase : φ x = M.α x
    · exact hdeg (M.α x) (by rw [hφa] at hcase; exact hcase)
    · exact hcase (hs (M.α x) (φ x) hy.symm (by rw [M.α_inv]; exact hx2.symm)).symm
  have h3 : φ x ≠ φ (φ x) := fun h => h1 ((Equiv.injective φ) h).symm
  have hsub : ({x, φ x, φ (φ x)} : Finset M.D) ⊆ cycFiber φ x := by
    intro z hz
    simp only [Finset.mem_insert, Finset.mem_singleton] at hz
    rcases hz with rfl | rfl | rfl
    · exact mem_cycFiber.2 SameCycle.rfl
    · exact mem_cycFiber.2 (show φ.SameCycle x (φ x) from ⟨1, by simp⟩).symm
    · refine mem_cycFiber.2 (show φ.SameCycle x (φ (φ x)) from ⟨2, ?_⟩).symm
      rw [show (2 : ℤ) = ((2 : ℕ) : ℤ) from rfl, zpow_natCast, pow_two]
      rfl
  have hnotmem1 : x ∉ ({φ x, φ (φ x)} : Finset M.D) := by
    simp only [Finset.mem_insert, Finset.mem_singleton]
    push_neg
    exact ⟨Ne.symm h1, Ne.symm h2⟩
  have hnotmem2 : φ x ∉ ({φ (φ x)} : Finset M.D) := by
    simp only [Finset.mem_singleton]
    exact h3
  have hc : ({x, φ x, φ (φ x)} : Finset M.D).card = 3 := by
    rw [Finset.card_insert_of_notMem hnotmem1, Finset.card_insert_of_notMem hnotmem2,
      Finset.card_singleton]
  calc 3 = ({x, φ x, φ (φ x)} : Finset M.D).card := hc.symm
    _ ≤ _ := Finset.card_le_card hsub

/-- Euler's formula: a simple plane map with no vertices of degree at most one
satisfies `E + 6 ≤ 3V`. -/
