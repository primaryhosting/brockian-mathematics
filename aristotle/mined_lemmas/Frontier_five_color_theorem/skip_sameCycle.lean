/-
Combinatorial maps (rotation systems) of genus zero, and Euler's formula.

A *combinatorial map* consists of a finite set `D` of darts, a permutation `σ`
whose cycles are the vertices, and a fixed-point-free involution `α` pairing the
two darts of each edge.  The cycles of `σ * α` are the faces.  A map is
*connected* when the group generated by `σ` and `α` acts transitively, and it has
*genus zero* (i.e. it is a plane map) when `V - E + F = 2`.

Here the vertices are labelled by a type `V` via a map `w : D → V` whose fibres
are exactly the cycles of `σ`.
-/
import RequestProject.CycleCount

namespace FiveColor

open Equiv Equiv.Perm SimpleGraph

section Counting

variable {D : Type*} [Fintype D] [DecidableEq D]

open scoped Classical in
/-- The cycle of `x` under `π`, as a `Finset`. -/

theorem skip_sameCycle {x y : {z : D // z ∉ S}} (h : π.SameCycle x.1 y.1) :
    (skip π S).SameCycle x y := by
  obtain ⟨n, hn⟩ := h.exists_nat_pow_eq
  clear h
  induction n using Nat.strong_induction_on generalizing x with
  | _ n ih =>
    rcases Nat.eq_zero_or_pos n with rfl | hn0
    · simp only [pow_zero, Perm.coe_one, id_eq] at hn
      exact (Subtype.ext hn : x = y) ▸ SameCycle.rfl
    · have hkpos : 1 ≤ skipIdx π S x := skipIdx_pos π S x
      have hkn : skipIdx π S x ≤ n := by
        by_contra hc
        push_neg at hc
        have := skipIdx_min π S (x := x) (k := n) hn0 (by omega)
        rw [hn] at this
        exact y.2 this
      have hx' : ((π ^ (n - skipIdx π S x)) (skip π S x).1) = y.1 := by
        rw [skip_apply, ← Perm.mul_apply, ← pow_add, Nat.sub_add_cancel hkn]
        exact hn
      have h2 := ih (n - skipIdx π S x) (by omega) (x := skip π S x) hx'
      exact (show (skip π S).SameCycle x (skip π S x) from ⟨1, by simp⟩).trans h2

