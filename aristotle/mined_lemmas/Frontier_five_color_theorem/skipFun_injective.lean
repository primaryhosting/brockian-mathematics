/-
Combinatorial maps (rotation systems) of genus zero, and Euler's formula.

A *combinatorial map* consists of a finite set `D` of darts, a permutation `σ`
whose cycles are the vertices, and a fixed-point-free involution `α` pairing the
two darts of each edge.  The cycles of `σ * α` are the faces.  A map is
*connected* when the group generated by `σ` and `α` acts transitively, and it has
*genus zero* (i.e. it is a plane map) when `V - E + F = 2`.

Here the vertices are labelled by a type `V` via a map `w : D → V` whose fibres
are exactly the cycles of `σ`.
-/
import RequestProject.CycleCount

namespace FiveColor

open Equiv Equiv.Perm SimpleGraph

section Counting

variable {D : Type*} [Fintype D] [DecidableEq D]

open scoped Classical in
/-- The cycle of `x` under `π`, as a `Finset`. -/

theorem skipFun_injective : Function.Injective (skipFun π S) := by
  intro x y hxy
  have hx : (π ^ (skipIdx π S x)) x.1 = (π ^ (skipIdx π S y)) y.1 := congrArg Subtype.val hxy
  rcases lt_trichotomy (skipIdx π S x) (skipIdx π S y) with h | h | h
  · exact absurd (skipFun_aux π S hx h) (by simp)
  · refine Subtype.ext ?_
    rw [h] at hx
    exact (Equiv.injective (π ^ (skipIdx π S y))) hx
  · exact absurd (skipFun_aux π S hx.symm h) (by simp)

/-- `π` with the elements of `S` skipped over: a permutation of the complement of `S`. -/
