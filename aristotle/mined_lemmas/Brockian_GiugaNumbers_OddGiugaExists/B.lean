namespace Brockian.GiugaNumbers

open Finset

/-- A *Giuga number* is a composite natural number `n > 1` such that every prime `p`
dividing `n` satisfies `p ∣ n / p - 1`. -/

noncomputable def B (k : ℕ) : ℚ := ∑ i ∈ range k, (1 : ℚ) / q i

