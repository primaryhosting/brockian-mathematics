/-! ## The root of unity -/

/-- A primitive `n`-th root of unity in `ℂ`. -/

lemma evec_zero_arg (n : ℕ) [NeZero n] (k : ZMod n) : evec n k 0 = 1 := by
  rw [evec_apply]; simp

