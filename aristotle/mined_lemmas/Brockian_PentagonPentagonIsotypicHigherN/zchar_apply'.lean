namespace Brockian

open DihedralGroup

noncomputable section

/-! ## The root of unity -/

/-- A primitive `n`-th root of unity in `ℂ`. -/

lemma zchar_apply' (n : ℕ) [NeZero n] (k x : ZMod n) :
    zchar n k x = (zta n) ^ (k * x).val := by
  rw [zchar_apply, ZMod.val_mul, zta_pow_mod]

