/-! ## The root of unity -/

/-- A primitive `n`-th root of unity in `ℂ`. -/

lemma isoPlane_neg (n : ℕ) [NeZero n] (k : ZMod n) : isoPlane n (-k) = isoPlane n k := by
  rw [isoPlane, isoPlane, neg_neg, Set.pair_comm]

