def PartitionSpace (n : ℕ) := EuclideanSpace ℂ (Fin (Fintype.card (Nat.Partition n)))

abbrev D5 := DihedralGroup 5
inductive D5IrrepIndex | trivial | sign | golden | conjugate deriving Fintype, DecidableEq

class IsotypicProjectors (H : Type*) [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H] where
  projector : D5IrrepIndex → (H →L[ℂ] H)
  selfAdjoint : ∀ idx, IsSelfAdjoint (projector idx)
  orthogonal : ∀ i j, i ≠ j → projector i * projector j = 0
  complete : ∑ i, projector i = 1

structure BrockianSystem (H : Type*) [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H] where
  ρ : D5 → (H ≃ₗᵢ[ℂ] H)
  [projectors : IsotypicProjectors H]
  Δ : H →L[ℂ] H
  hΔ : IsSelfAdjoint Δ
  V : H →L[ℂ] H
  hV : IsSelfAdjoint V

