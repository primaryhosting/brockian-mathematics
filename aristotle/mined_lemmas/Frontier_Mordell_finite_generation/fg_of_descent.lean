import Mathlib

/-!
# Mordell Finite Generation
Category: Frontier — Prime Numbers
Target: Frontier.Mordell_finite_generation
Verification: pending
Provenance: Aristotle theorem prover (Harmonic)
-/

namespace Frontier

open scoped Classical

/-- Multiplication by `m : ℕ` on an additive commutative group, as a group homomorphism. -/

theorem fg_of_descent {A : Type*} [AddCommGroup A] (m : ℕ) (hm : 2 ≤ m)
    (hquot : Finite (A ⧸ multiples A m))
    (h : A → ℝ)
    (hadd : ∀ Q : A, ∃ C : ℝ, ∀ P : A, h (P + Q) ≤ 2 * h P + C)
    (hmul : ∃ C : ℝ, ∀ P : A, (m : ℝ) ^ 2 * h P - C ≤ h (m • P))
    (hbdd : ∀ C : ℝ, {P : A | h P ≤ C}.Finite) :
    AddGroup.FG A := by
  classical
  obtain ⟨R, hRfin, hR⟩ := exists_finite_representatives m hquot
  obtain ⟨C₂, hC₂⟩ := hmul
  -- a uniform constant `C₁` working for all the (negatives of the) representatives
  choose g hg using hadd
  have hbddA : BddAbove ((fun Q => g (-Q)) '' R) := (hRfin.image _).bddAbove
  obtain ⟨C₁, hC₁⟩ := hbddA
  set C : ℝ := max 0 (C₁ + C₂) with hC
  have hC0 : 0 ≤ C := le_max_left _ _
  have hCle : C₁ + C₂ ≤ C := le_max_right _ _
  set B : ℝ := C + 3 with hB
  -- the finite generating set
  set S : Set A := R ∪ {P : A | h P ≤ B} with hS
  have hSfin : S.Finite := hRfin.union (hbdd B)
  -- the key descent step
  have key : ∀ P : A, 0 ≤ h P → ∃ Q ∈ R, ∃ P' : A, P = m • P' + Q ∧ h P' ≤ h P / 2 + C / 4 := by
    intro P hP0
    obtain ⟨Q, hQR, P', hP'⟩ := hR P
    refine ⟨Q, hQR, P', hP', ?_⟩
    have h1 : h (m • P') ≤ 2 * h P + g (-Q) := by
      have : m • P' = P + -Q := by rw [hP']; abel
      rw [this]
      exact hg (-Q) P
    have h2 : g (-Q) ≤ C₁ := hC₁ ⟨Q, hQR, rfl⟩
    have h3 : (m : ℝ) ^ 2 * h P' - C₂ ≤ h (m • P') := hC₂ P'
    have h4 : (m : ℝ) ^ 2 * h P' ≤ 2 * h P + (C₁ + C₂) := by linarith
    have hm4 : (4 : ℝ) ≤ (m : ℝ) ^ 2 := by
      have : (2 : ℝ) ≤ (m : ℝ) := by exact_mod_cast hm
      nlinarith
    rcases le_or_gt (h P') 0 with hneg | hpos
    · nlinarith
    · nlinarith
  -- every point lies in the subgroup generated by `S`
  have main : ∀ n : ℕ, ∀ P : A, h P ≤ (n : ℝ) → P ∈ AddSubgroup.closure S := by
    intro n
    induction n using Nat.strong_induction_on with
    | _ n ih =>
      intro P hPn
      rcases le_or_gt (h P) B with hle | hgt
      · exact AddSubgroup.subset_closure (Or.inr hle)
      · have hP0 : 0 ≤ h P := by simp only [hB] at hgt; linarith
        obtain ⟨Q, hQR, P', hPeq, hP'le⟩ := key P hP0
        have hn2 : (2 : ℝ) + C / 2 ≤ (n : ℝ) := by
          simp only [hB] at hgt
          linarith
        have hn1 : 1 ≤ n := by
          have h1 : (1 : ℝ) ≤ (n : ℝ) := by linarith
          exact_mod_cast h1
        set k : ℕ := n - 1 with hk
        have hkn : k < n := by omega
        have hkcast : (k : ℝ) = (n : ℝ) - 1 := by
          have : (k : ℕ) + 1 = n := by omega
          have := congrArg (fun t : ℕ => (t : ℝ)) this
          push_cast at this
          linarith
        have hP'k : h P' ≤ (k : ℝ) := by
          rw [hkcast]
          linarith
        have := ih k hkn P' hP'k
        rw [hPeq]
        exact AddSubgroup.add_mem _ (AddSubgroup.nsmul_mem _ this m)
          (AddSubgroup.subset_closure (Or.inl hQR))
  rw [AddGroup.fg_iff]
  refine ⟨S, ?_, hSfin⟩
  rw [eq_top_iff]
  intro P _
  exact main ⌈h P⌉₊ P (Nat.le_ceil _)

/-! ## Non-vacuity: the descent hypotheses are satisfiable

The hypotheses of `Frontier.fg_of_descent` are not vacuous: they hold, for instance, for the group
`ℤ` with the height `h n = n ^ 2` and `m = 2`, and the descent theorem then recovers the
(independently obvious) fact that `ℤ` is finitely generated. -/

