namespace Chem

open Complex

/-- The adjacency matrix of the cycle graph `C₇`, indexed by `ZMod 7`:
vertices `i` and `j` are adjacent iff they differ by `1` modulo `7`. -/

noncomputable def fourierVec (k : ℕ) : ZMod 7 → ℂ := fun j => zeta ^ (k * j.val)

