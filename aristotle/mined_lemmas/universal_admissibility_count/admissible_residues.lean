/-
Definition of admissible residues modulo q with gap g.
-/

def admissible_residues (q : ℕ) [Fact q.Prime] (g : ℕ) : Finset (ZMod q) :=
  univ.filter (fun n => n ≠ 0 ∧ n + g ≠ 0)

/-
The "q-2" Admissibility Law. For any prime `q` and any gap `g` not divisible by `q`, there are exactly `q - 2` residues that do not hit the "excluded" points (0 and -g).
