import Mathlib

open scoped BigOperators

set_option maxHeartbeats 8000000
set_option maxRecDepth 100000

namespace Chem

/-! # The character table of `D₆ₕ` (the point group of benzene)

The point group `D₆ₕ` of benzene is the direct product of the dihedral group `D₆`
(the symmetry group of the hexagon, of order 12) with the two element group
generated by the inversion `i`.  We model it as `DihedralGroup 6 × Multiplicative (ZMod 2)`.

We check that `D₆ₕ` has exactly 12 conjugacy classes, that the usual `12 × 12`
character table of `D₆ₕ` therefore has the right shape, and that its rows satisfy the
first orthogonality relation (so the 12 rows are 12 pairwise distinct irreducible
characters, and the sum of the squares of their dimensions is the group order 24 —
the completeness criterion). -/

/-- The point group `D₆ₕ`, realized as `D₆ × ⟨i⟩`. -/
abbrev D6h := DihedralGroup 6 × Multiplicative (ZMod 2)

/-- The inversion `i ∈ D₆ₕ`. -/

theorem d6hTable_orthogonal (i j : Fin 12) :
    ∑ c : Fin 12, classSize c * d6hTable i c * d6hTable j c = if i = j then 24 else 0 := by
  revert i j; decide

/-- The sum of the squares of the dimensions of the twelve irreducible representations
is the order of `D₆ₕ`. -/
