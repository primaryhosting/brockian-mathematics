/-! ## The wheel

The *wheel* of modulus `1153` is the trial-division wheel generated by the primes
below `√1153 < 34`.  A number `n ≤ 1153` is prime exactly when it is at least `2`
and no spoke of the wheel is a proper divisor of it. -/

/-- The spokes of the wheel: all primes `< 34`, enough to certify primality
below `34 ^ 2 = 1156`, in particular for all `n ≤ 1153`. -/

theorem wheelIsPrime_prime {n : ℕ} (hn : n ≤ 1153) (h : wheelIsPrime n = true) :
    Nat.Prime n := by
  simp only [wheelIsPrime, Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true] at h
  obtain ⟨h2, hall⟩ := h
  by_contra hnp
  set m := n.minFac with hm
  have hmp : Nat.Prime m := Nat.minFac_prime (by omega)
  have hdvd : m ∣ n := Nat.minFac_dvd n
  have hsq : m * m ≤ n := by
    have := Nat.minFac_sq_le_self (n := n) (by omega) hnp
    nlinarith [this, sq_nonneg m, pow_two m]
  have hm33 : m ≤ 33 := by nlinarith
  have hspoke := hall m (prime_mem_wheelSpokes m hm33 hmp)
  simp only [Bool.or_eq_true, beq_iff_eq, bne_iff_ne, ne_eq] at hspoke
  rcases hspoke with h1 | h1
  · exact hnp (h1 ▸ hmp)
  · exact h1 (Nat.dvd_iff_mod_eq_zero.mp hdvd)

/-! ## The Goldbach check -/

/-- For an even `n`, look for a small prime `p ≤ 100` on the wheel with `n - p` prime. -/
