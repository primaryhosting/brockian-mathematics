open Filter Topology Set MeasureTheory intervalIntegral
open scoped Real

namespace Math2

/-- The Sato–Tate density on `[0, π]`: `θ ↦ (2/π) sin²θ`. -/

noncomputable def trap (u v ε : ℝ) (x : ℝ) : ℝ := max 0 (min 1 (min ((x - u) / ε) ((v - x) / ε)))

