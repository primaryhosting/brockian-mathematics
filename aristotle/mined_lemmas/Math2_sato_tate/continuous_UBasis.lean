/-! ## The Sato–Tate distribution -/

/-- The Sato–Tate density `(2/π) sin²θ` on `[0, π]`. -/

lemma continuous_UBasis (k : ℕ) : Continuous (UBasis k) := by
  unfold UBasis
  exact (Polynomial.Chebyshev.U ℝ (k : ℤ)).continuous_aeval.comp Real.continuous_cos

