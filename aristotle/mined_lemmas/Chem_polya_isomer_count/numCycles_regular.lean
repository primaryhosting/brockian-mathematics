namespace Chem

attribute [local instance] arrowAction

variable {G P C : Type*} [Group G] [MulAction G P]

/-- A *substitution pattern* on a molecular skeleton with positions `P` and possible
substituents `C` is a labelling of every position by a substituent.  The symmetry group of
the skeleton acts on such labellings by `(g • c) p = c (g⁻¹ • p)`. -/
abbrev Coloring (P C : Type*) : Type _ := P → C

/-- Two substitution patterns describe the same *isomer* when they differ by a symmetry of the
skeleton; the isomers are therefore the orbits of the symmetry group `G` acting on colorings. -/
abbrev Isomer (G P C : Type*) [Group G] [MulAction G P] : Type _ :=
  MulAction.orbitRel.Quotient G (Coloring P C)

/-- The number of cycles of the symmetry `g` acting on the positions of the skeleton, i.e. the
number of orbits of the cyclic group generated by `g`.  This is the exponent appearing in the
Pólya cycle index. -/

lemma numCycles_regular {H : Type*} [Group H] [Fintype H] (g : H) :
    numCycles (G := H) (P := H) g = Nat.card H / orderOf g := by
  rw [numCycles, Nat.card_congr
    (MulAction.equivSubgroupOrbitsQuotientGroup (α := H) (β := H) (1 : H) (Subgroup.zpowers g)),
    ← Subgroup.index]
  have h := Subgroup.card_mul_index (Subgroup.zpowers g)
  rw [Nat.card_zpowers] at h
  rw [← h, Nat.mul_div_cancel_left _ (orderOf_pos g)]

/-- The additive order of an element of `ZMod 6`, computed from its representative. -/
