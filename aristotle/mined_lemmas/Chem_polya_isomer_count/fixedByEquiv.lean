/-!
# Pólya / Burnside counting of substitution isomers

A *skeleton* is a finite set of substitution positions `P` carrying an action of the
symmetry group `G` of the molecule.  A *substitution pattern* (a labelling of every
position by one of the available substituents, drawn from a finite set `S`) is a function
`P → S`, and two patterns describe the *same isomer* exactly when they differ by a symmetry
of the skeleton, i.e. when they lie in the same orbit of the induced action
`(g • c) p = c (g⁻¹ • p)` of `G` on `P → S`.

The main result `Chem.polya_isomer_count` says that the number of isomers is the
Burnside/Pólya cycle-index average

`#isomers = (1 / |G|) * ∑_{g ∈ G} |S| ^ (number of cycles of g on P)`,

stated in the division-free form `#isomers * |G| = ∑_{g ∈ G} |S| ^ c(g)`; the version with
an honest average over `ℚ` is `Chem.polya_isomer_count_average`.

Here the number of cycles of `g` acting on the positions is, as usual, the number of orbits
of the cyclic group `⟨g⟩` generated by `g` (`Chem.cycleCount`).
-/

namespace Chem

-- The action of `G` on substitution patterns: `(g • c) p = c (g⁻¹ • p)`.
attribute [local instance] arrowAction

variable {G P S : Type*} [Group G] [MulAction G P]

/-- The number of cycles of the symmetry `g` acting on the set of positions `P`, i.e. the
number of orbits of the cyclic group generated by `g`.  This is the exponent occurring in
the Pólya cycle index. -/

noncomputable def fixedByEquiv (g : G) :
    (MulAction.fixedBy (P → S) g) ≃ (MulAction.orbitRel.Quotient (Subgroup.zpowers g) P → S) where
  toFun c := Quotient.lift c.1 (by
    rintro a b hab
    obtain ⟨h, rfl⟩ := (hab : a ∈ MulAction.orbit (Subgroup.zpowers g) b)
    exact apply_smul_eq_of_mem_zpowers c.2 h.2 b)
  invFun F := ⟨fun a => F (Quotient.mk'' a), by
    funext a
    change F (Quotient.mk'' (g⁻¹ • a)) = F (Quotient.mk'' a)
    congr 1
    exact Quotient.sound ⟨⟨g⁻¹, Subgroup.inv_mem _ (Subgroup.mem_zpowers g)⟩, rfl⟩⟩
  left_inv _ := rfl
  right_inv F := by
    funext q
    induction q using Quotient.inductionOn' with
    | h a => rfl

/-- The number of substitution patterns fixed by a symmetry `g` is `|S| ^ (cycles of g)`. -/
