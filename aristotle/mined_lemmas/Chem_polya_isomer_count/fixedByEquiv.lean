namespace Chem

attribute [local instance] arrowAction

variable {G P C : Type*} [Group G] [MulAction G P]

/-- A *substitution pattern* on a molecular skeleton with positions `P` and possible
substituents `C` is a labelling of every position by a substituent.  The symmetry group of
the skeleton acts on such labellings by `(g • c) p = c (g⁻¹ • p)`. -/
abbrev Coloring (P C : Type*) : Type _ := P → C

/-- Two substitution patterns describe the same *isomer* when they differ by a symmetry of the
skeleton; the isomers are therefore the orbits of the symmetry group `G` acting on colorings. -/
abbrev Isomer (G P C : Type*) [Group G] [MulAction G P] : Type _ :=
  MulAction.orbitRel.Quotient G (Coloring P C)

/-- The number of cycles of the symmetry `g` acting on the positions of the skeleton, i.e. the
number of orbits of the cyclic group generated by `g`.  This is the exponent appearing in the
Pólya cycle index. -/

noncomputable def fixedByEquiv (g : G) :
    MulAction.fixedBy (Coloring P C) g ≃
      (MulAction.orbitRel.Quotient (Subgroup.zpowers g) P → C) where
  toFun := fun c =>
    Quotient.lift (fun p => (c : Coloring P C) p) (by
      rintro a b ⟨x, hx⟩
      have hc : ∀ p : P, (c : Coloring P C) (g • p) = (c : Coloring P C) p :=
        (smul_eq_self_iff g (c : Coloring P C)).mp c.2
      have h := coloring_const_on_zpowers_orbit hc x b
      rw [show (x : G) • b = a from hx] at h
      exact h)
  invFun := fun f => ⟨fun p => f (Quotient.mk _ p), by
    show g • (fun p : P => f (Quotient.mk _ p)) = _
    refine (smul_eq_self_iff g _).mpr ?_
    intro p
    exact congrArg f (Quotient.sound ⟨⟨g, Subgroup.mem_zpowers g⟩, rfl⟩)⟩
  left_inv := by intro c; ext p; rfl
  right_inv := by
    intro f
    funext q
    induction q using Quotient.inductionOn with
    | _ p => rfl

/-- **Pólya / Burnside enumeration of substitution isomers.**
For a finite symmetry group `G` acting on the finitely many positions `P` of a molecular
skeleton, with finitely many possible substituents `C`, the number of substitution isomers
(orbits of colorings) times the order of the symmetry group equals the sum over the group of
`|C|` raised to the number of cycles of each symmetry — that is, the number of isomers is the
average of the cycle-index terms, `(1/|G|) ∑_{g ∈ G} |C| ^ c(g)`. -/
