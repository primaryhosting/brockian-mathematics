import Mathlib

/-!
# Polya Isomer Count
Category: Chemistry
Target: Chem.polya_isomer_count
Verification: pending
Provenance: Aristotle theorem prover (Harmonic)
-/

open scoped BigOperators
open scoped Real
open scoped Nat
open scoped Classical
open scoped Pointwise

set_option maxHeartbeats 8000000
set_option maxRecDepth 4000
set_option synthInstance.maxHeartbeats 20000
set_option synthInstance.maxSize 128

set_option relaxedAutoImplicit false
set_option autoImplicit false

set_option pp.fullNames true
set_option pp.structureInstances true
set_option pp.coercions.types true
set_option pp.funBinderTypes true
set_option pp.letVarTypes true
set_option pp.piBinderTypes true

set_option grind.warning false

namespace Chem

attribute [local instance] arrowAction

variable {G P C : Type*} [Group G] [MulAction G P]

/-- A *substitution pattern* on a molecular skeleton with positions `P` and possible
substituents `C` is a labelling of every position by a substituent.  The symmetry group of
the skeleton acts on such labellings by `(g • c) p = c (g⁻¹ • p)`. -/
abbrev Coloring (P C : Type*) : Type _ := P → C

/-- Two substitution patterns describe the same *isomer* when they differ by a symmetry of the
skeleton; the isomers are therefore the orbits of the symmetry group `G` acting on colorings. -/
abbrev Isomer (G P C : Type*) [Group G] [MulAction G P] : Type _ :=
  MulAction.orbitRel.Quotient G (Coloring P C)

/-- The number of cycles of the symmetry `g` acting on the positions of the skeleton, i.e. the
number of orbits of the cyclic group generated by `g`.  This is the exponent appearing in the
Pólya cycle index. -/

theorem benzene_rotation_isomer_count :
    Nat.card (Isomer (Multiplicative (ZMod 6)) (Multiplicative (ZMod 6)) (Fin 2)) = 14 := by
  have hcard : Nat.card (Multiplicative (ZMod 6)) = 6 := by
    simp [Nat.card_eq_fintype_card]
  have hC : Nat.card (Fin 2) = 2 := by simp
  have key := polya_isomer_count (G := Multiplicative (ZMod 6))
    (P := Multiplicative (ZMod 6)) (C := Fin 2)
  have hsum : (∑ g : Multiplicative (ZMod 6),
      Nat.card (Fin 2) ^ numCycles (P := Multiplicative (ZMod 6)) g) = 84 := by
    have hterm : ∀ g : Multiplicative (ZMod 6),
        Nat.card (Fin 2) ^ numCycles (P := Multiplicative (ZMod 6)) g
          = 2 ^ (6 / (6 / Nat.gcd 6 (Multiplicative.toAdd g).val)) := by
      intro g
      have hord : orderOf g = addOrderOf (Multiplicative.toAdd g) := rfl
      rw [hC, numCycles_regular g, hcard, hord, addOrderOf_zmod_six]
    rw [Finset.sum_congr rfl fun g _ => hterm g]
    show (∑ a : ZMod 6, 2 ^ (6 / (6 / Nat.gcd 6 a.val))) = 84
    decide
  rw [hsum, hcard] at key
  omega

end Chem

