/-
# Polya Isomer Count
Category: Chemistry
Target: Chem.polya_isomer_count
Verification: pending
Provenance: Aristotle theorem prover (Harmonic)
-/

import Mathlib

/-!
## Setting

A molecular skeleton is modelled by a finite set `P` of substitution positions carrying an
action of a finite symmetry group `G`.  A *substitution pattern* is an assignment
`P → C` of a substituent (from a finite set `C`) to each position, and `G` acts on such
patterns by moving positions around (`arrowAction`).  Two patterns describe the same
*isomer* exactly when they lie in the same `G`-orbit, so the number of isomers is the
cardinality of the orbit space `Quotient (MulAction.orbitRel G (P → C))`.

Pólya's enumeration theorem says that this number is the average, over `g ∈ G`, of
`|C| ^ (number of cycles of g on P)`, the number of cycles of `g` being the number of
orbits of the cyclic group `⟨g⟩ = Subgroup.zpowers g` on `P`.
-/

namespace Chem

attribute [local instance] arrowAction

variable {G : Type*} [Group G] {P : Type*} [MulAction G P] {C : Type*}

/-- If a colouring `f : P → C` is fixed by `g`, then it is constant along the
orbits of the cyclic group generated by `g`. -/

theorem polya_two_equivalent_positions (C : Type*) [Finite C] :
    Nat.card (Quotient (MulAction.orbitRel (Equiv.Perm (Fin 2)) (Fin 2 → C))) * 2
      = Nat.card C ^ 2 + Nat.card C := by
  have hcard : Nat.card (Equiv.Perm (Fin 2)) = 2 := by
    simp [Nat.card_eq_fintype_card, Fintype.card_perm]
  have key := polya_isomer_count (Equiv.Perm (Fin 2)) (Fin 2) C
  rw [hcard] at key
  rw [key]
  have huniv : (Finset.univ : Finset (Equiv.Perm (Fin 2))) = {1, Equiv.swap 0 1} := by decide
  have hne : (1 : Equiv.Perm (Fin 2)) ≠ Equiv.swap 0 1 := by decide
  rw [huniv, Finset.sum_pair hne]
  have h1 : Nat.card (Quotient (MulAction.orbitRel
      (Subgroup.zpowers (1 : Equiv.Perm (Fin 2))) (Fin 2))) = 2 := by
    rw [card_cycles_one]
    simp
  have htrans : MulAction.IsPretransitive
      (Subgroup.zpowers (Equiv.swap (0 : Fin 2) 1)) (Fin 2) := by
    constructor
    intro x y
    by_cases h : x = y
    · exact ⟨1, by simp [h]⟩
    · refine ⟨⟨Equiv.swap 0 1, Subgroup.mem_zpowers _⟩, ?_⟩
      show Equiv.swap (0 : Fin 2) 1 x = y
      fin_cases x <;> fin_cases y <;> simp_all
  have h2 : Nat.card (Quotient (MulAction.orbitRel
      (Subgroup.zpowers (Equiv.swap (0 : Fin 2) 1)) (Fin 2))) = 1 :=
    card_orbits_of_pretransitive _ _
  rw [h1, h2, pow_one]

end Chem

