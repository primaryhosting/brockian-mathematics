namespace Chem

open MulAction

/- The symmetry group `G` of a skeleton acts on the substituted molecules (colourings of the
positions `P` by substituents `C`) by `(g • f) p = f (g⁻¹ • p)`. -/
attribute [local instance] arrowAction

variable {G P C : Type*} [Group G] [MulAction G P]

/-- A colouring fixed by `g` is constant along the orbits of the cyclic group generated by `g`. -/

noncomputable def fixedColoringsEquiv (g : G) :
    MulAction.fixedBy (P → C) g ≃ (MulAction.orbitRel.Quotient (Subgroup.zpowers g) P → C) where
  toFun F := Quotient.lift (fun p => (F : P → C) p) (by
    rintro p q hpq
    obtain ⟨⟨h, hh⟩, rfl⟩ := hpq
    exact coloring_invariant_of_fixed F.2 hh q)
  invFun q := ⟨fun p => q (Quotient.mk'' p), by
    ext p
    show q (Quotient.mk'' (g⁻¹ • p)) = q (Quotient.mk'' p)
    exact congrArg q (Quotient.sound ⟨⟨g⁻¹, Subgroup.inv_mem _ (Subgroup.mem_zpowers g)⟩, rfl⟩)⟩
  left_inv _ := rfl
  right_inv q := by ext x; induction x using Quotient.inductionOn with | _ p => rfl

/-- The number of colourings fixed by a symmetry `g` is `|C|` raised to the number of cycles
of `g` on the positions (the term appearing in Pólya's cycle index). -/
