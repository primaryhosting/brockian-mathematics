/-! ## Phases and signs -/

/-- Computational basis labels for `n` qubits: bit strings of length `n`. -/
abbrev Bits (n : ℕ) : Type := Fin n → ZMod 2

/-- The fourth root of unity `i ^ s` attached to `s : ZMod 4`. -/

def gateCost {n : ℕ} : Gate n → ℕ
  | .H _ => 3
  | .S _ => 2
  | .CZ _ _ => 3

