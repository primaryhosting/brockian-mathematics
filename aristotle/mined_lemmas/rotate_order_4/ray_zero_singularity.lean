/-- The pentagonal modulus -/

theorem ray_zero_singularity (p : ℕ) (hp : p.Prime) (h : p > 5) :
    ray p ≠ ⟨0, by decide⟩ := by
  intro hc
  have : 5 ∣ p := by
    rw [Nat.dvd_iff_mod_eq_zero]
    exact congr_arg Fin.val hc
  rw [Nat.dvd_prime hp] at this
  omega

/-- Twin prime transitions -/
