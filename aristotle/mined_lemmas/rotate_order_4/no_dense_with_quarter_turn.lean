/-- The pentagonal modulus -/

theorem no_dense_with_quarter_turn (k : ℕ) (hk : ∀ n > 1, ¬(n^2 ∣ k)) (hk_ne_one : k ≠ 1) :
    let L := QuadraticLattice k
    ¬(IsDensePlane L ∧ (∀ p ∈ L, quarter_turn p ∈ L)) := by
      -- If L is dense and closed under the quarter-turn, then by the quarter-turn obstruction, all elements in L must have a second coordinate of zero.
      have h_second_coord_zero : let L := QuadraticLattice k; (IsDensePlane L ∧ ∀ p ∈ L, quarter_turn p ∈ L) → ∀ p ∈ L, p.2 = 0 := by
        intros L hL p hp;
        apply quarter_turn_obstruction k hk hk_ne_one;
        · exact hL.2;
        · exact hp;
      -- If all elements in L have a second coordinate of zero, then L is contained in the x-axis, which cannot be dense in the plane.
      have h_subset_x_axis : let L := QuadraticLattice k; (∀ p ∈ L, p.2 = 0) → ¬IsDensePlane L := by
        intro L hL h_dense
        have h_subset_x_axis : L ⊆ {p : ℝ × ℝ | p.2 = 0} := by
          exact fun p hp => hL p hp;
        have := h_dense ( 0, 1 ) 1 ; norm_num at this;
        obtain ⟨ a, b, h₁, h₂ ⟩ := this; specialize hL _ h₁; norm_num [ hL, euclidean_dist ] at h₂;
        rw [ Real.sqrt_lt' ] at h₂ <;> nlinarith;
      exact fun h => h_subset_x_axis ( h_second_coord_zero h ) h.1

