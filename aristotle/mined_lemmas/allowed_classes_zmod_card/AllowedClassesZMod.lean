/-- The product over tuple shifts -/

def AllowedClassesZMod (q : ℕ) [Fact (Nat.Prime q)] (G : Finset ℕ) : 
    Finset (ZMod q) :=
  Finset.univ.filter fun r0 => 
    r0 ≠ 0 ∧ ∀ g ∈ G, (r0 + (g : ZMod q)) ≠ 0

