/-- `GoldbachK2 n` says that `n` is a sum of two primes (the `K = 2` Goldbach property). -/

theorem goldbachK2_of_le_727 (n : ℕ) (heven : Even n) (hlow : 4 ≤ n) (hhigh : n ≤ 727) :
    GoldbachK2 n :=
  GoldbachWheelK2_727 n heven hlow hhigh

