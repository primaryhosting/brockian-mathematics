variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]

/-- The one-parameter symmetry group generated by `T` moves a point `x` with velocity `T x`
at time `0`. -/

theorem hasDerivAt_expAction (T : E →L[ℝ] E) (x : E) :
    HasDerivAt (fun t : ℝ => (NormedSpace.exp (t • T)) x) (T x) 0 := by
  have h : HasDerivAt (fun t : ℝ => NormedSpace.exp (t • T))
      (NormedSpace.exp ((0 : ℝ) • T) * T) 0 := hasDerivAt_exp_smul_const T (0 : ℝ)
  have h2 := (ContinuousLinearMap.apply ℝ E x).hasFDerivAt.comp_hasDerivAt (0 : ℝ) h
  simpa using h2

/-- Infinitesimal form of the symmetry: if the potential `V` is invariant under the
one-parameter group generated by `T`, then its gradient is orthogonal to the orbit
direction `T x` at every point `x`. -/
