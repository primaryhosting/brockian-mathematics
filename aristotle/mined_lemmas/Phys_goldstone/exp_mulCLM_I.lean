variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]

/-- The one-parameter symmetry group generated by `T` moves a point `x` with velocity `T x`
at time `0`. -/

theorem exp_mulCLM_I (t : ℝ) (z : ℂ) :
    (NormedSpace.exp (t • mulCLM Complex.I)) z = Complex.exp (t * Complex.I) * z := by
  have h1 : t • (mulCLM Complex.I) = mulCLM (t * Complex.I) := by
    ext w; simp [mulCLM]; ring
  rw [h1, ← NormedSpace.map_exp mulCLM (ContinuousLinearMap.mul ℝ ℂ).continuous]
  simp [mulCLM, Complex.exp_eq_exp_ℂ]

/-- Goldstone's theorem applied to the Mexican hat potential: at the vacuum `z = 1` the
Hessian annihilates the (nonzero) tangential direction `I`, the massless Goldstone mode. -/
