/-- The one-parameter symmetry group generated by `T` moves a point `x` with velocity `T x`
at time `0`. -/

noncomputable def mulCLM : ℂ →+* (ℂ →L[ℝ] ℂ) where
  toFun w := ContinuousLinearMap.mul ℝ ℂ w
  map_one' := by ext z; simp
  map_mul' a b := by ext z; simp [mul_assoc]
  map_zero' := by ext z; simp
  map_add' a b := by ext z; simp

