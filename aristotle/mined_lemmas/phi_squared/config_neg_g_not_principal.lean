lemma config_neg_g_not_principal (p g : ℕ) (hp : Nat.Prime p) (hg : Nat.gcd g p = 1) :
    ∃ i : Fin p, i.val ≠ 0 ∧ (configForGap p g i).j.val = 0 ∧
    ¬(configForGap p g i).isPrincipal := by
      -- Since $g$ is coprime to $p$, there exists an $i$ such that $i + g \equiv 0 \pmod{p}$.
      obtain ⟨i, hi⟩ : ∃ i : Fin p, (i.val + g) % p = 0 := by
        -- Since $g$ is coprime to $p$, there exists an $i$ such that $i \equiv -g \pmod{p}$.
        obtain ⟨i, hi⟩ : ∃ i : ℕ, i < p ∧ i + g ≡ 0 [MOD p] := by
          -- Let $i = p - g \% p$. Then $i + g = p - g \% p + g = p + (g - g \% p)$, which is clearly divisible by $p$.
          use p - g % p;
          exact ⟨ Nat.sub_lt hp.pos ( Nat.pos_of_ne_zero fun h => by have := Nat.dvd_gcd ( Nat.dvd_of_mod_eq_zero h ) ( Nat.dvd_refl p ) ; aesop ), by rw [ Nat.modEq_zero_iff_dvd ] ; exact ⟨ g / p + 1, by linarith [ Nat.div_add_mod g p, Nat.sub_add_cancel ( Nat.mod_lt g hp.pos |> Nat.le_of_lt ) ] ⟩ ⟩;
        exact ⟨ ⟨ i, hi.1 ⟩, hi.2 ⟩;
      refine' ⟨ i, _, _, _ ⟩ <;> simp_all +decide [ configForGap ];
      · rw [ Nat.gcd_comm ] at hg; rw [ Nat.gcd_rec ] at hg; aesop;
