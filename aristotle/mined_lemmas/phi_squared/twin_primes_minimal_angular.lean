/-! ## Quantum State Structure -/

/-- Quantum state on n qubits -/
structure QuantumState (n : ℕ) where
  amplitude : Fin (2^n) → ℂ
  normalized : ∑ i, Complex.normSq (amplitude i) = 1

/-- Quantum gate (unitary operator) -/
structure QuantumGate (n : ℕ) where
  matrix : (Fin (2^n) → ℂ) →ₗ[ℂ] (Fin (2^n) → ℂ)
  unitary : ∀ ψ φ : QuantumState n, 
    ∑ i, Complex.normSq ((matrix ψ.amplitude) i) = 
    ∑ i, Complex.normSq (ψ.amplitude i)

/-! ## QAOA Structure -/

/-- Problem Hamiltonian -/
structure ProblemHamiltonian (n : ℕ) where
  H : (Fin (2^n) → ℂ) →ₗ[ℂ] (Fin (2^n) → ℂ)

/-- Standard QAOA circuit -/
structure QAOA_Circuit (n p : ℕ) where
  problem : ProblemHamiltonian n
  gamma : Fin p → ℝ
  beta : Fin p → ℝ

/-! ## Brockian Enhancements -/

/-- Brockian QAOA with golden ratio and D₅ symmetry -/
structure BrockianQAOA (n p : ℕ) extends QAOA_Circuit n p where
  golden_ratio_scaling : ∀ k : Fin p, beta k = gamma k * φ
  pentagonal_init : ∀ k : Fin (min p 5), gamma ⟨k.val, lt_of_lt_of_le k.isLt (min_le_left p 5)⟩ = k.val * pentagonalAngle

