theorem brockian_eigenvalues (p : ℕ) (hp : Prime p) :
    ∀ k : Fin p, ∃ f : ℕ → ℂ,
    brockianOperator p f =
      (fun n => Complex.exp (2 * Real.pi * Complex.I * k.val / p) * f n) := by
  -- For each $k$, define $f$ such that $f(n) = 0$ for all $n$.
