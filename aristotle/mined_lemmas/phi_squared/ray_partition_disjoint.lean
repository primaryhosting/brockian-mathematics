theorem ray_partition_disjoint (p : ℕ) (hp : Prime p) (i j : Fin p) (hij : i ≠ j) :
    Disjoint (Ray p i) (Ray p j) := by
      -- If there exists an element $n$ in both $Ray p i$ and $Ray p j$, then $n \mod p = i$ and $n \mod p = j$, which implies $i = j$, contradicting $i \ne j$.
      have h_contradiction : ∀ n, n ∈ Ray p i → n ∈ Ray p j → i = j := by
        -- If $n$ is in both $Ray p i$ and $Ray p j$, then $n \mod p = i$ and $n \mod p = j$, which implies $i = j$, contradicting $i \ne j$.
        intros n hn_i hn_j
        have h_mod : n % p = i.val ∧ n % p = j.val := by
          -- By definition of Ray, if n is in Ray p i, then n mod p = i.val. Similarly, if n is in Ray p j, then n mod p = j.val.
          apply And.intro (hn_i) (hn_j);
        -- Since $i$ and $j$ are elements of $\text{Fin } p$, their values are between $0$ and $p-1$. If $i.val = j.val$, then $i$ and $j$ must be the same element because they are both in the same finite set.
        apply Fin.ext
        exact h_mod.left.symm.trans h_mod.right;
      -- If there exists an element $n$ in both $Ray p i$ and $Ray p j$, then by $h_contradiction$, $i$ must equal $j$, which contradicts $hij$.
      apply Set.disjoint_left.mpr; intro n hn_i hn_j; exact hij (h_contradiction n hn_i hn_j)

