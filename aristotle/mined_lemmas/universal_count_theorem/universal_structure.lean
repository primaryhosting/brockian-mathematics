/-
For prime q and gap g, a residue pair (i,j) is principal if both are non-zero and satisfy the gap constraint j ≡ i+g (mod q)
-/

theorem universal_structure (q g : ℕ)
    (hq : Nat.Prime q) (hq_odd : q > 2) (hg : Nat.gcd g q = 1) :
    ∃ (pairs : Finset (Fin q × Fin q)),
      pairs.card = q - 2 ∧
      ∀ pair ∈ pairs,
        pair.1.val ≠ 0 ∧
        pair.2.val ≠ 0 ∧
        pair.2.val ≡ pair.1.val + g [MOD q] := by
