/-! ## The vacuum sector of a Euclidean (Osterwalder–Schrader) quantum field theory -/

/-- The Hilbert-space data of the vacuum sector of a quantum field theory:
a complex Hilbert space `Hilb`, a distinguished unit vector `vac` (the vacuum),
and the Euclidean-time semigroup `P t = e^{-tH}` generated by the Hamiltonian `H`.
The axioms say that `P` is a strongly-continuity-free, self-adjoint, contractive
one-parameter semigroup fixing the vacuum; equivalently `H` is a positive
self-adjoint operator annihilating the vacuum. -/
structure QFT where
  /-- The Hilbert space of states. -/
  Hilb : Type
  [instNormed : NormedAddCommGroup Hilb]
  [instInner : InnerProductSpace ℂ Hilb]
  [instComplete : CompleteSpace Hilb]
  /-- The Euclidean-time semigroup `P t = e^{-t H}`. -/
  P : ℝ → Hilb →L[ℂ] Hilb
  /-- The vacuum vector. -/
  vac : Hilb
  vac_norm : ‖vac‖ = 1
  P_zero : ∀ x, P 0 x = x
  P_add : ∀ s t, 0 ≤ s → 0 ≤ t → ∀ x, P (s + t) x = P s (P t x)
  /-- Each `P t` is self-adjoint (`H` is self-adjoint). -/
  P_symm : ∀ t, 0 ≤ t → ∀ x y, ⟪P t x, y⟫_ℂ = ⟪x, P t y⟫_ℂ
  /-- Each `P t` is a contraction (`H ≥ 0`, the spectrum condition). -/
  P_contract : ∀ t, 0 ≤ t → ∀ x, ‖P t x‖ ≤ ‖x‖
  /-- The vacuum has zero energy. -/
  P_vac : ∀ t, 0 ≤ t → P t vac = vac

attribute [instance] QFT.instNormed QFT.instInner QFT.instComplete

namespace QFT

variable (T : QFT)

/-- The states orthogonal to the vacuum, i.e. the physical excitations. -/

theorem hasMassGap_of_contraction {t₀ c : ℝ} (ht₀ : 0 < t₀) (hc0 : 0 < c) (hc1 : c < 1)
    (h : ∀ ψ : T.Hilb, T.IsExcitation ψ → ‖T.P t₀ ψ‖ ≤ c * ‖ψ‖) :
    T.HasMassGap (-Real.log c / t₀) := by
  intro ψ hψ t ht
  have hgoal : Real.exp (-(-Real.log c / t₀) * t) * ‖ψ‖
      = Real.exp (Real.log c / t₀ * t) * ‖ψ‖ := by
    congr 2
    ring
  rw [hgoal]
  refine le_of_pow_two_pow_le (b := Real.exp (Real.log c / t₀ * t) * ‖ψ‖)
    (by positivity) (inv_pos.mpr hc0) (fun k => ?_)
  have hexp : Real.exp (Real.log c / t₀ * ((2 : ℝ) ^ k * t))
      = Real.exp (Real.log c / t₀ * t) ^ (2 ^ k) := by
    rw [← Real.exp_nat_mul]
    congr 1
    push_cast
    ring
  have hpsi : ‖ψ‖ ^ (2 ^ k - 1) * ‖ψ‖ = ‖ψ‖ ^ (2 ^ k) := by
    rw [← pow_succ]
    congr 1
    have : 1 ≤ 2 ^ k := Nat.one_le_two_pow
    omega
  calc ‖T.P t ψ‖ ^ (2 ^ k)
      ≤ ‖ψ‖ ^ (2 ^ k - 1) * ‖T.P ((2 : ℝ) ^ k * t) ψ‖ := norm_P_pow_le ht ψ k
    _ ≤ ‖ψ‖ ^ (2 ^ k - 1) *
          (c⁻¹ * (Real.exp (Real.log c / t₀ * ((2 : ℝ) ^ k * t)) * ‖ψ‖)) := by
        refine mul_le_mul_of_nonneg_left ?_ (by positivity)
        exact norm_P_le_const_exp ht₀ hc0 hc1 h hψ (by positivity)
    _ = c⁻¹ * ((Real.exp (Real.log c / t₀ * t) * ‖ψ‖) ^ (2 ^ k)) := by
        rw [hexp, mul_pow]
        rw [← hpsi]
        ring

end QFT

/-! ## The target statement -/

/-- **Yang–Mills mass gap (Lean-checked reduction).**

For every compact gauge group `G`: if there exists a quantum Yang–Mills theory on `ℝ⁴`
whose Euclidean-time semigroup is a strict contraction on the orthogonal complement of the
vacuum at *some single* positive time, then there exists a quantum Yang–Mills theory on `ℝ⁴`
with a strictly positive mass gap.

The hypothesis is the (still open) constructive input — the existence of the Yang–Mills
measure together with one uniform contraction estimate; the conclusion is the Millennium
Prize statement `YangMillsMassGapStatement G`. Everything after the constructive input is
verified here: the single-time estimate is upgraded to the sharp exponential decay rate
`Δ = -log c / t₀` for all Euclidean times. -/
