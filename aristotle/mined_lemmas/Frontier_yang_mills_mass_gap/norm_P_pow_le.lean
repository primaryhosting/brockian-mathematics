/-! ## The vacuum sector of a Euclidean (Osterwalder–Schrader) quantum field theory -/

/-- The Hilbert-space data of the vacuum sector of a quantum field theory:
a complex Hilbert space `Hilb`, a distinguished unit vector `vac` (the vacuum),
and the Euclidean-time semigroup `P t = e^{-tH}` generated by the Hamiltonian `H`.
The axioms say that `P` is a strongly-continuity-free, self-adjoint, contractive
one-parameter semigroup fixing the vacuum; equivalently `H` is a positive
self-adjoint operator annihilating the vacuum. -/
structure QFT where
  /-- The Hilbert space of states. -/
  Hilb : Type
  [instNormed : NormedAddCommGroup Hilb]
  [instInner : InnerProductSpace ℂ Hilb]
  [instComplete : CompleteSpace Hilb]
  /-- The Euclidean-time semigroup `P t = e^{-t H}`. -/
  P : ℝ → Hilb →L[ℂ] Hilb
  /-- The vacuum vector. -/
  vac : Hilb
  vac_norm : ‖vac‖ = 1
  P_zero : ∀ x, P 0 x = x
  P_add : ∀ s t, 0 ≤ s → 0 ≤ t → ∀ x, P (s + t) x = P s (P t x)
  /-- Each `P t` is self-adjoint (`H` is self-adjoint). -/
  P_symm : ∀ t, 0 ≤ t → ∀ x y, ⟪P t x, y⟫_ℂ = ⟪x, P t y⟫_ℂ
  /-- Each `P t` is a contraction (`H ≥ 0`, the spectrum condition). -/
  P_contract : ∀ t, 0 ≤ t → ∀ x, ‖P t x‖ ≤ ‖x‖
  /-- The vacuum has zero energy. -/
  P_vac : ∀ t, 0 ≤ t → P t vac = vac

attribute [instance] QFT.instNormed QFT.instInner QFT.instComplete

namespace QFT

variable (T : QFT)

/-- The states orthogonal to the vacuum, i.e. the physical excitations. -/

theorem norm_P_pow_le {t : ℝ} (ht : 0 ≤ t) (ψ : T.Hilb) (k : ℕ) :
    ‖T.P t ψ‖ ^ (2 ^ k) ≤ ‖ψ‖ ^ (2 ^ k - 1) * ‖T.P (2 ^ k * t) ψ‖ := by
  induction k with
  | zero => simp
  | succ k ih =>
      have hone : 1 ≤ 2 ^ k := Nat.one_le_two_pow
      have hsq : ‖T.P ((2 : ℝ) ^ k * t) ψ‖ ^ 2 ≤ ‖ψ‖ * ‖T.P (2 * ((2 : ℝ) ^ k * t)) ψ‖ :=
        norm_P_sq_le (by positivity) ψ
      have e1 : ‖T.P t ψ‖ ^ (2 ^ (k + 1)) = (‖T.P t ψ‖ ^ (2 ^ k)) ^ 2 := by
        rw [← pow_mul]
        ring_nf
      have e2 : ‖ψ‖ ^ (2 ^ (k + 1) - 1) = ‖ψ‖ ^ (2 * (2 ^ k - 1)) * ‖ψ‖ := by
        rw [← pow_succ]
        congr 1
        have : 2 ^ (k + 1) = 2 * 2 ^ k := by ring
        omega
      have e3 : (2 : ℝ) ^ (k + 1) * t = 2 * ((2 : ℝ) ^ k * t) := by ring
      calc ‖T.P t ψ‖ ^ (2 ^ (k + 1)) = (‖T.P t ψ‖ ^ (2 ^ k)) ^ 2 := e1
        _ ≤ (‖ψ‖ ^ (2 ^ k - 1) * ‖T.P ((2 : ℝ) ^ k * t) ψ‖) ^ 2 :=
            pow_le_pow_left₀ (by positivity) ih 2
        _ = ‖ψ‖ ^ (2 * (2 ^ k - 1)) * ‖T.P ((2 : ℝ) ^ k * t) ψ‖ ^ 2 := by
            rw [mul_pow, ← pow_mul, mul_comm (2 ^ k - 1) 2]
        _ ≤ ‖ψ‖ ^ (2 * (2 ^ k - 1)) * (‖ψ‖ * ‖T.P (2 * ((2 : ℝ) ^ k * t)) ψ‖) :=
            mul_le_mul_of_nonneg_left hsq (by positivity)
        _ = ‖ψ‖ ^ (2 ^ (k + 1) - 1) * ‖T.P ((2 : ℝ) ^ (k + 1) * t) ψ‖ := by
            rw [e2, e3]; ring

/-- **Main reduction.** For the vacuum sector of a Euclidean quantum field theory, a
contraction bound `‖P t₀ ψ‖ ≤ c ‖ψ‖` with `c < 1` at a *single* positive Euclidean time,
valid on the orthogonal complement of the vacuum, already implies a mass gap
`Δ = -log c / t₀ > 0` (with the sharp exponential rate). -/
