open scoped InnerProductSpace

/-! ## The vacuum sector of a Euclidean (Osterwalder–Schrader) quantum field theory -/

/-- The Hilbert-space data of the vacuum sector of a quantum field theory:
a complex Hilbert space `Hilb`, a distinguished unit vector `vac` (the vacuum),
and the Euclidean-time semigroup `P t = e^{-tH}` generated by the Hamiltonian `H`.
The axioms say that `P` is a strongly-continuity-free, self-adjoint, contractive
one-parameter semigroup fixing the vacuum; equivalently `H` is a positive
self-adjoint operator annihilating the vacuum. -/
structure QFT where
  /-- The Hilbert space of states. -/
  Hilb : Type
  [instNormed : NormedAddCommGroup Hilb]
  [instInner : InnerProductSpace ℂ Hilb]
  [instComplete : CompleteSpace Hilb]
  /-- The Euclidean-time semigroup `P t = e^{-t H}`. -/
  P : ℝ → Hilb →L[ℂ] Hilb
  /-- The vacuum vector. -/
  vac : Hilb
  vac_norm : ‖vac‖ = 1
  P_zero : ∀ x, P 0 x = x
  P_add : ∀ s t, 0 ≤ s → 0 ≤ t → ∀ x, P (s + t) x = P s (P t x)
  /-- Each `P t` is self-adjoint (`H` is self-adjoint). -/
  P_symm : ∀ t, 0 ≤ t → ∀ x y, ⟪P t x, y⟫_ℂ = ⟪x, P t y⟫_ℂ
  /-- Each `P t` is a contraction (`H ≥ 0`, the spectrum condition). -/
  P_contract : ∀ t, 0 ≤ t → ∀ x, ‖P t x‖ ≤ ‖x‖
  /-- The vacuum has zero energy. -/
  P_vac : ∀ t, 0 ≤ t → P t vac = vac

attribute [instance] QFT.instNormed QFT.instInner QFT.instComplete

namespace QFT

variable (T : QFT)

/-- The states orthogonal to the vacuum, i.e. the physical excitations. -/

theorem norm_P_le_const_exp {t₀ c : ℝ} (ht₀ : 0 < t₀) (hc0 : 0 < c) (hc1 : c < 1)
    (h : ∀ ψ : T.Hilb, T.IsExcitation ψ → ‖T.P t₀ ψ‖ ≤ c * ‖ψ‖)
    {ψ : T.Hilb} (hψ : T.IsExcitation ψ) {t : ℝ} (ht : 0 ≤ t) :
    ‖T.P t ψ‖ ≤ c⁻¹ * (Real.exp (Real.log c / t₀ * t) * ‖ψ‖) := by
  set n : ℕ := ⌊t / t₀⌋₊ with hn
  have hfloor : (n : ℝ) ≤ t / t₀ := Nat.floor_le (by positivity)
  have hfloor' : t / t₀ < n + 1 := Nat.lt_floor_add_one _
  have hnt : (n : ℝ) * t₀ ≤ t := by
    have := mul_le_mul_of_nonneg_right hfloor ht₀.le
    rwa [div_mul_cancel₀ _ ht₀.ne'] at this
  have hdecomp : ‖T.P t ψ‖ ≤ c ^ n * ‖ψ‖ := by
    have h1 : T.P t ψ = T.P (t - n * t₀) (T.P (n * t₀) ψ) := by
      rw [← T.P_add _ _ (by linarith) (by positivity)]
      congr 1
      ring
    rw [h1]
    calc ‖T.P (t - n * t₀) (T.P (n * t₀) ψ)‖ ≤ ‖T.P (n * t₀) ψ‖ :=
          T.P_contract _ (by linarith) _
      _ ≤ c ^ n * ‖ψ‖ := norm_P_nsmul_le ht₀.le hc0.le h n hψ
  have hlog : Real.log c < 0 := Real.log_neg hc0 hc1
  have hc_pow : c ^ n = Real.exp ((n : ℝ) * Real.log c) := by
    rw [Real.exp_nat_mul, Real.exp_log hc0]
  have hinv : c⁻¹ = Real.exp (-Real.log c) := by
    rw [Real.exp_neg, Real.exp_log hc0]
  have hrw : Real.log c / t₀ * t = (t / t₀) * Real.log c := by
    field_simp
  have key : (n : ℝ) * Real.log c ≤ -Real.log c + Real.log c / t₀ * t := by
    have h1 : t / t₀ - 1 ≤ (n : ℝ) := by linarith
    have h2 : (n : ℝ) * Real.log c ≤ (t / t₀ - 1) * Real.log c :=
      mul_le_mul_of_nonpos_right h1 hlog.le
    rw [hrw]
    nlinarith
  calc ‖T.P t ψ‖ ≤ c ^ n * ‖ψ‖ := hdecomp
    _ ≤ (c⁻¹ * Real.exp (Real.log c / t₀ * t)) * ‖ψ‖ := by
        refine mul_le_mul_of_nonneg_right ?_ (norm_nonneg _)
        rw [hc_pow, hinv, ← Real.exp_add]
        exact Real.exp_le_exp.mpr key
    _ = c⁻¹ * (Real.exp (Real.log c / t₀ * t) * ‖ψ‖) := by ring

/-- Self-adjointness upgrade: `‖P t ψ‖ ^ 2 ≤ ‖ψ‖ * ‖P (2 t) ψ‖`. -/
