/-- The (real, radial) Higgs potential of the abelian Higgs toy model:
`V(φ) = -μ² φ² + λ φ⁴`, with quartic coupling `lam > 0`. -/

noncomputable def vev (mu2 lam : ℝ) : ℝ :=
  if 0 < mu2 then Real.sqrt (mu2 / (2 * lam)) else 0

