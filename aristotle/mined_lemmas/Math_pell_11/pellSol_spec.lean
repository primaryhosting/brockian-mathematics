import Mathlib

/-!
Supplementary results for `Math.pell_11` (stated with Mathlib available):
the Pell equation `x² − 11 y² = 1` has infinitely many integer solutions.
-/

namespace Math

/-- The step map generated by the fundamental solution `(10, 3)`. -/

theorem pellSol_spec (n : ℕ) :
    (pellSol n).1 ^ 2 - 11 * (pellSol n).2 ^ 2 = 1 ∧ 0 < (pellSol n).2 ∧
      0 < (pellSol n).1 ∧ (pellSol n).2 < (pellSol (n + 1)).2 := by
  induction n with
  | zero =>
    refine ⟨by norm_num [pellSol], by norm_num [pellSol], by norm_num [pellSol], ?_⟩
    simp [pellSol, pellStep]
  | succ n ih =>
    obtain ⟨hsol, hy, hx, -⟩ := ih
    have hstep : pellSol (n + 1) = pellStep (pellSol n) := by
      simp [pellSol, Function.iterate_succ_apply']
    have hstep2 : pellSol (n + 2) = pellStep (pellSol (n + 1)) := by
      simp [pellSol, Function.iterate_succ_apply']
    refine ⟨by rw [hstep]; exact pellStep_preserves _ hsol, ?_, ?_, ?_⟩
    · rw [hstep]; simp only [pellStep]; nlinarith
    · rw [hstep]; simp only [pellStep]; nlinarith
    · rw [hstep2]
      simp only [pellStep]
      rw [hstep]
      simp only [pellStep]
      nlinarith

/-- The set of integer solutions of `x² − 11 y² = 1` is infinite. -/
