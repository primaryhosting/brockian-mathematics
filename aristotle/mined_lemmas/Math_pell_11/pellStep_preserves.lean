import Mathlib

/-!
Supplementary results for `Math.pell_11` (stated with Mathlib available):
the Pell equation `x² − 11 y² = 1` has infinitely many integer solutions.
-/

namespace Math

/-- The step map generated by the fundamental solution `(10, 3)`. -/

theorem pellStep_preserves (p : ℤ × ℤ) (h : p.1 ^ 2 - 11 * p.2 ^ 2 = 1) :
    (pellStep p).1 ^ 2 - 11 * (pellStep p).2 ^ 2 = 1 := by
  simp only [pellStep]
  nlinarith [h]

/-- Every `pellSol n` solves the Pell equation, and its entries are positive
and strictly increasing, so there are infinitely many solutions. -/
