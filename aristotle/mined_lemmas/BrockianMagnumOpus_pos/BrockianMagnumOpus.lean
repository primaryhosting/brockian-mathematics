theorem BrockianMagnumOpus.goldbach_from_spectral_model
    (M : BrockianMagnumOpus.SpectralModel)
    (h_small :
      ∀ n, n ≤ max 2 M.N₀ → n > 2 → Even n → BrockianMagnumOpus.Goldbach n) :
    ∀ n, n > 2 → Even n → BrockianMagnumOpus.Goldbach n := by
  intro n hn2 hEven
  by_cases hcase : n ≤ max 2 M.N₀
  · exact h_small n hcase hn2 hEven
  · have hnlarge : n > max 2 M.N₀ := lt_of_not_ge hcase
    have hrep : BrockianMagnumOpus.goldbachReps n ≥ 1 :=
      BrockianMagnumOpus.goldbachReps_ge_one_of_model M n hnlarge hEven
    -- reps ≥ 1 ⇒ ∃ primes summing to n
    rcases BrockianMagnumOpus.goldbach_rep_exists (n := n) hrep with ⟨p, q, hp, hq, hpq⟩
    exact ⟨p, q, hp, hq, hpq⟩
