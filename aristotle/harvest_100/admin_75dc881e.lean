namespace QPhys

open NormedSpace

section OperatorAlgebra

variable {A : Type*} [NormedRing A] [NormedAlgebra ℂ A] [StarRing A] [ContinuousStar A]
  [CompleteSpace A] [StarModule ℂ A]

/-- The time evolution operator `U(t) = exp(-i H t / ℏ)` generated by a Hamiltonian `H`. -/
noncomputable def timeEvolution (hbar : ℝ) (H : A) (t : ℝ) : A :=
  exp ((-Complex.I * (t / hbar)) • H)

/-- **Unitary time evolution.** If the Hamiltonian `H` is self-adjoint, then for every real time
`t` the evolution operator `U(t) = exp(-i H t / ℏ)` is unitary, i.e. `U(t)⋆ U(t) = 1` and
`U(t) U(t)⋆ = 1`.

This is essentially `exp_mem_unitary_of_mem_skewAdjoint` applied to the skew-adjoint element
`(-i t / ℏ) • H` (cf. `selfAdjoint.expUnitary` in Mathlib). -/
theorem unitary_time_evolution {H : A} (hH : IsSelfAdjoint H) (hbar t : ℝ) :
    timeEvolution hbar H t ∈ unitary A := by
  have hr : (-Complex.I * (t / hbar)) ∈ skewAdjoint ℂ := by
    rw [skewAdjoint.mem_iff]
    simp
  let +nondep : NormedAlgebra ℚ A := .restrictScalars ℚ ℂ A
  exact exp_mem_unitary_of_mem_skewAdjoint (hH.smul_mem_skewAdjoint hr)

/-- Explicit form of unitarity: `U(t)⋆ * U(t) = 1`. -/
theorem star_timeEvolution_mul_self {H : A} (hH : IsSelfAdjoint H) (hbar t : ℝ) :
    star (timeEvolution hbar H t) * timeEvolution hbar H t = 1 :=
  (Unitary.mem_iff.mp (unitary_time_evolution hH hbar t)).1

/-- Explicit form of unitarity: `U(t) * U(t)⋆ = 1`. -/
theorem timeEvolution_mul_star {H : A} (hH : IsSelfAdjoint H) (hbar t : ℝ) :
    timeEvolution hbar H t * star (timeEvolution hbar H t) = 1 :=
  (Unitary.mem_iff.mp (unitary_time_evolution hH hbar t)).2

end OperatorAlgebra

section Hilbert

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]

/-- On a complex Hilbert space, time evolution generated by a self-adjoint Hamiltonian preserves
the inner product: `⟪U(t) x, U(t) y⟫ = ⟪x, y⟫`. -/
theorem inner_timeEvolution_timeEvolution {H : E →L[ℂ] E} (hH : IsSelfAdjoint H) (hbar t : ℝ)
    (x y : E) :
    inner ℂ (timeEvolution hbar H t x) (timeEvolution hbar H t y) = inner ℂ x y := by
  have h := star_timeEvolution_mul_self hH hbar t
  have : inner ℂ (timeEvolution hbar H t x) (timeEvolution hbar H t y)
      = inner ℂ x ((star (timeEvolution hbar H t) * timeEvolution hbar H t) y) := by
    simp [ContinuousLinearMap.star_eq_adjoint, ContinuousLinearMap.adjoint_inner_right]
  rw [this, h]
  simp

/-- Time evolution generated by a self-adjoint Hamiltonian preserves norms (conservation of
probability). -/
theorem norm_timeEvolution_apply {H : E →L[ℂ] E} (hH : IsSelfAdjoint H) (hbar t : ℝ) (x : E) :
    ‖timeEvolution hbar H t x‖ = ‖x‖ := by
  have h := inner_timeEvolution_timeEvolution hH hbar t x x
  rw [norm_eq_sqrt_re_inner (𝕜 := ℂ), norm_eq_sqrt_re_inner (𝕜 := ℂ), h]

end Hilbert

end QPhys
