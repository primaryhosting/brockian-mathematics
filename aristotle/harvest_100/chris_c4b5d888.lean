namespace Frontier

/-- The partial derivative of a Lagrangian `L : ℝ × ℝ → ℝ` with respect to its first
(position) argument, at the point `z = (q, v)`. -/
noncomputable def dL_dq (L : ℝ × ℝ → ℝ) (z : ℝ × ℝ) : ℝ := fderiv ℝ L z (1, 0)

/-- The partial derivative of a Lagrangian `L : ℝ × ℝ → ℝ` with respect to its second
(velocity) argument, at the point `z = (q, v)`; the *canonical momentum*. -/
noncomputable def dL_dv (L : ℝ × ℝ → ℝ) (z : ℝ × ℝ) : ℝ := fderiv ℝ L z (0, 1)

/-- **Key intermediate lemma**: a continuous linear functional on `ℝ × ℝ` decomposes into its
two partial components.  In particular the derivative of `L` in the direction `(a, b)` is
`a * ∂L/∂q + b * ∂L/∂v`. -/
theorem fderiv_apply_eq_partials (L : ℝ × ℝ → ℝ) (z : ℝ × ℝ) (a b : ℝ) :
    fderiv ℝ L z (a, b) = a * dL_dq L z + b * dL_dv L z := by
  have hab : ((a, b) : ℝ × ℝ) = a • (1, 0) + b • (0, 1) := by simp
  rw [dL_dq, dL_dv, hab, map_add, map_smul, map_smul]
  simp

/-- The Noether current associated with the infinitesimal generator `X` along the path `q`
with velocity `v`: `J t = (∂L/∂v)(q t, v t) · X (q t)`. -/
noncomputable def noetherCurrent (L : ℝ × ℝ → ℝ) (X q v : ℝ → ℝ) (t : ℝ) : ℝ :=
  dL_dv L (q t, v t) * X (q t)

/-- **Key intermediate lemma**: along a solution of the Euler–Lagrange equation, the Noether
current attached to an infinitesimal symmetry has vanishing time derivative. -/
theorem hasDerivAt_noetherCurrent_zero
    (L : ℝ × ℝ → ℝ) (X q v : ℝ → ℝ)
    (hq : ∀ t : ℝ, HasDerivAt q (v t) t)
    (hX : ∀ x : ℝ, DifferentiableAt ℝ X x)
    -- Euler–Lagrange equation: `d/dt (∂L/∂v) = ∂L/∂q` along the path.
    (hEL : ∀ t : ℝ, HasDerivAt (fun s : ℝ => dL_dv L (q s, v s)) (dL_dq L (q t, v t)) t)
    -- Infinitesimal invariance of the Lagrangian under the flow generated by `X`
    -- (whose prolongation to velocities is `v ↦ X'(q) · v`).
    (hsym : ∀ z : ℝ × ℝ, fderiv ℝ L z (X z.1, deriv X z.1 * z.2) = 0)
    (t : ℝ) : HasDerivAt (noetherCurrent L X q v) 0 t := by
  have hXq : HasDerivAt (fun s : ℝ => X (q s)) (deriv X (q t) * v t) t :=
    ((hX (q t)).hasDerivAt.comp t (hq t))
  have hmul :
      HasDerivAt (noetherCurrent L X q v)
        (dL_dq L (q t, v t) * X (q t)
          + dL_dv L (q t, v t) * (deriv X (q t) * v t)) t :=
    (hEL t).mul hXq
  have hz := hsym (q t, v t)
  rw [fderiv_apply_eq_partials] at hz
  have : dL_dq L (q t, v t) * X (q t)
      + dL_dv L (q t, v t) * (deriv X (q t) * v t) = 0 := by
    simpa [mul_comm] using hz
  rwa [this] at hmul

/-- **Noether's theorem (1D case).**  If `q` is a path with velocity `v` solving the
Euler–Lagrange equation for a Lagrangian `L : ℝ × ℝ → ℝ`, and `X` generates a smooth
one-parameter symmetry of the action (infinitesimal invariance of `L` under the prolonged
flow), then the associated Noether current `(∂L/∂v)(q, v) · X(q)` is conserved: it takes the
same value at all times. -/
theorem noether_conservation
    (L : ℝ × ℝ → ℝ) (X q v : ℝ → ℝ)
    (hq : ∀ t : ℝ, HasDerivAt q (v t) t)
    (hX : ∀ x : ℝ, DifferentiableAt ℝ X x)
    (hEL : ∀ t : ℝ, HasDerivAt (fun s : ℝ => dL_dv L (q s, v s)) (dL_dq L (q t, v t)) t)
    (hsym : ∀ z : ℝ × ℝ, fderiv ℝ L z (X z.1, deriv X z.1 * z.2) = 0) :
    ∀ t₁ t₂ : ℝ, noetherCurrent L X q v t₁ = noetherCurrent L X q v t₂ := by
  have hd : ∀ t : ℝ, HasDerivAt (noetherCurrent L X q v) 0 t :=
    hasDerivAt_noetherCurrent_zero L X q v hq hX hEL hsym
  exact is_const_of_deriv_eq_zero (fun t => (hd t).differentiableAt)
    (fun t => (hd t).deriv)


/-!
### Sanity check: the free particle

`L (q, v) = v * v` is invariant under space translations (generator `X ≡ 1`); the conserved
current is the momentum `2 v`, which is not identically zero.  This witnesses that the
hypotheses of `Frontier.noether_conservation` are satisfiable, i.e. the theorem is not vacuous.
-/

namespace FreeParticle

/-- The free-particle Lagrangian `L (q, v) = v * v`. -/
noncomputable def L : ℝ × ℝ → ℝ := fun z => z.2 * z.2

theorem hasFDerivAt_L (z : ℝ × ℝ) :
    HasFDerivAt L ((2 * z.2) • (ContinuousLinearMap.snd ℝ ℝ ℝ)) z := by
  have h : HasFDerivAt (fun z : ℝ × ℝ => z.2) (ContinuousLinearMap.snd ℝ ℝ ℝ) z :=
    (ContinuousLinearMap.snd ℝ ℝ ℝ).hasFDerivAt
  have h2 : HasFDerivAt (fun z : ℝ × ℝ => z.2 * z.2)
      (z.2 • ContinuousLinearMap.snd ℝ ℝ ℝ + z.2 • ContinuousLinearMap.snd ℝ ℝ ℝ) z := h.mul h
  refine h2.congr_fderiv ?_
  rw [← two_smul ℝ (z.2 • ContinuousLinearMap.snd ℝ ℝ ℝ), smul_smul]

theorem fderiv_L_apply (z : ℝ × ℝ) (a b : ℝ) : fderiv ℝ L z (a, b) = 2 * z.2 * b := by
  rw [(hasFDerivAt_L z).fderiv]; simp [mul_comm]

/-- The uniform motion `q t = c * t` with velocity `c`, together with the translation
generator `X ≡ 1`, satisfies all hypotheses of Noether's theorem, and the resulting conserved
current is the (nonzero, for `c ≠ 0`) momentum `2 * c`. -/
theorem noether_free_particle (c : ℝ) :
    (∀ t : ℝ, HasDerivAt (fun t : ℝ => c * t) c t) ∧
    (∀ x : ℝ, DifferentiableAt ℝ (fun _ : ℝ => (1 : ℝ)) x) ∧
    (∀ t : ℝ, HasDerivAt (fun s : ℝ => Frontier.dL_dv L (c * s, c))
      (Frontier.dL_dq L (c * t, c)) t) ∧
    (∀ z : ℝ × ℝ, fderiv ℝ L z ((fun _ : ℝ => (1 : ℝ)) z.1,
      deriv (fun _ : ℝ => (1 : ℝ)) z.1 * z.2) = 0) ∧
    (∀ t : ℝ, Frontier.noetherCurrent L (fun _ => 1) (fun t => c * t) (fun _ => c) t
      = 2 * c) := by
  refine ⟨fun t => by simpa using (hasDerivAt_id t).const_mul c,
    fun x => differentiableAt_const 1, ?_, ?_, ?_⟩
  · intro t
    simp only [Frontier.dL_dv, Frontier.dL_dq, fderiv_L_apply]
    simpa using hasDerivAt_const t (2 * c * 1)
  · intro z
    simp [fderiv_L_apply]
  · intro t
    simp [Frontier.noetherCurrent, Frontier.dL_dv, fderiv_L_apply]

end FreeParticle

end Frontier

