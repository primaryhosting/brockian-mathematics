        -- Since there are no edges between 0 and 2 in the original graph, the adjacency matrix of the induced subgraph is zero. Therefore, the statement holds.
        simp [adjacencyMatrix, SimpleGraph.cycleGraph];
        -- By examining all possible pairs (i, j) where i and j are in {0, 2}, we can verify that the implication holds.
        intro hij h_diff h_i
        fin_cases i <;> fin_cases j <;> simp +decide at hij h_diff h_i ⊢;
      exact h_adj_zero

theorem pentagon_independent_set_is_epsilon_light (ε : ℝ) (hε : 0 < ε) :
    IsEpsilonLight pentagon pentagon_independent_set ε := by
      -- Since the induced Laplacian is zero and the full Laplacian is positive semidefinite, their difference is ε times the full Laplacian, which is positive semidefinite for ε > 0.
      have h_pos_semidef : (ε • laplacianMatrix pentagon).PosSemidef := by
        -- The Laplacian matrix of any graph is positive semidefinite.
        have h_laplacian_pos_semidef : (laplacianMatrix pentagon).PosSemidef := by
          have h_pos_semidef : ∀ x : Fin 5 → ℝ, dotProduct x ((laplacianMatrix pentagon).mulVec x) ≥ 0 := by
            intro x
            have h_sum : dotProduct x ((laplacianMatrix pentagon).mulVec x) = ∑ e ∈ pentagon.edgeFinset, Sym2.lift ⟨fun u v => (x u - x v) ^ 2, fun u v => by simp; ring⟩ e := by
              -- Apply the theorem that states the quadratic form of the Laplacian matrix is equal to the sum of the squares of the differences over the edges.
              apply laplacian_quadratic_form_edges;
            exact h_sum.symm ▸ Finset.sum_nonneg fun e he => by rcases e with ⟨ u, v ⟩ ; exact by simpa using sq_nonneg _;
          constructor;
          · -- The Laplacian matrix is symmetric because it is the difference of two symmetric matrices: the degree matrix and the adjacency matrix.
            have h_symm : (laplacianMatrix pentagon).IsSymm := by
              exact?;
            exact?;
          · exact?;
        convert h_laplacian_pos_semidef.smul hε.le using 1;
      rw [ IsEpsilonLight ];
      rw [ show inducedLaplacian pentagon pentagon_independent_set = 0 from ?_ ];
      · simpa using h_pos_semidef;
      · exact?

theorem pentagon_epsilon_light_bound (ε : ℝ) (hε : 0 < ε) (hε1 : ε < 1) :
    ∃ S : Finset (Fin 5), IsEpsilonLight pentagon S ε ∧
    2 * φ * (S.card : ℝ) ≥ 5 * ε := by
      -- Since ε is less than 1, we can apply the result from case 1 to conclude the proof.
      have h_case1 : IsEpsilonLight pentagon pentagon_independent_set ε := by
        -- Since ε is positive and less than 1, we can apply the result from case 1 to conclude the proof.
        apply pentagon_independent_set_is_epsilon_light ε hε;
      -- Since ε is less than 1, we can choose S to be the independent set {0, 2}.
      use pentagon_independent_set;
      -- Since φ is greater than 1.6, we have 2 * φ > 3.2. φ, 3.2 ≥ 5 * ε.
      have h_phi_gt_1_6 : φ > 1.6 := by
        -- Since φ is defined as (1 + sqrt 5)/2 and we have φ > 1.6, we can directly use this fact.
        exact phi_value_bounds.left.trans_le' (by norm_num);
      -- Since the cardinality of the independent set is 2, we have 2 * φ * 2 = 4 * φ.
      have h_card : (pentagon_independent_set : Finset (Fin 5)).card = 2 := by
        rfl;
      exact ⟨ h_case1, by norm_num [ h_card ] ; linarith ⟩

lemma pentagon_bound_arithmetic (ε : ℝ) (hε1 : ε < 1) : 5 * ε ≤ 4 * φ := by
  have h_phi : 1.6 < φ := phi_value_bounds.1
  nlinarith

noncomputable def BrockianConstant : ℝ := 1 / (2 * φ)

theorem brockian_constant_pos : 0 < BrockianConstant := by
  unfold BrockianConstant
  have : 0 < 2 * φ := by
    have := phi_pos
    linarith
  exact div_pos one_pos this

theorem brockian_constant_bounds : 0.3 < BrockianConstant ∧ BrockianConstant < 0.32 := by
  -- We'll use that φ is approximately 1.618 to estimate the bounds.
  have h_phi_bounds : 1.618 < φ ∧ φ < 1.619 := by
    -- By definition of φ, we know that φ = (1 + sqrt(5)) / 2.
    have h_phi_def : φ = (1 + Real.sqrt 5) / 2 := by
      -- By definition of φ, we have φ = (1 + Real.sqrt 5) / 2.
      rw [show φ = (1 + Real.sqrt 5) / 2 from rfl];
    constructor <;> norm_num <;> nlinarith [ Real.sqrt_nonneg 5, Real.sq_sqrt ( show 0 ≤ 5 by norm_num ) ];
  -- By definition of BrockianConstant, we have BrockianConstant = 1 / (2 * φ).
  have h_brockian_def : BrockianConstant = 1 / (2 * φ) := by
    rfl;
  exact ⟨ by rw [ h_brockian_def ] ; rw [ lt_div_iff₀ ] <;> norm_num at * <;> linarith, by rw [ h_brockian_def ] ; rw [ div_lt_iff₀ ] <;> norm_num at * <;> linarith ⟩
