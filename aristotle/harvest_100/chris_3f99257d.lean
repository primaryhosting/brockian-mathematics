noncomputable def φ : ℝ := (1 + sqrt 5) / 2

theorem phi_pos : 0 < φ := by
  unfold φ
  have : 0 < sqrt 5 := sqrt_pos.mpr (by norm_num)
  linarith

theorem phi_gt_one : 1 < φ := by
  -- By definition of $φ$, we know that $φ = (1 + sqrt(5)) / 2$.
  have h_phi_def : φ = (1 + Real.sqrt 5) / 2 := by
    -- By definition of $φ$, we know that $φ = (1 + sqrt(5)) / 2$. We can use the fact that the definition of $φ$ is given as $(1 + sqrt(5)) / 2$.
    simp [φ]
  rw [h_phi_def]
  -- Since $sqrt(5) > 1$, we have $1 + sqrt(5) > 2$, thus $(1 + sqrt(5)) / 2 > 1$.
  have h_sqrt : Real.sqrt 5 > 1 := by
    -- Since $5 > 1$, we have $\sqrt{5} > \sqrt{1} = 1$.
    norm_num [Real.lt_sqrt]
  linarith [h_sqrt]

theorem phi_squared_eq : φ ^ 2 = φ + 1 := by
  unfold φ
  field_simp
  ring_nf
  rw [sq_sqrt]
  · ring
  · norm_num

theorem phi_reciprocal : 1 / φ = φ - 1 := by
  have h := phi_squared_eq
  have hφ : φ ≠ 0 := ne_of_gt (phi_pos)
  field_simp [hφ] at h ⊢
  linarith

theorem phi_value_bounds : 1.6 < φ ∧ φ < 1.7 := by
  -- By definition of $φ$, we know that $φ = (1 + Real.sqrt 5) / 2$.
  have h_phi_def : φ = (1 + Real.sqrt 5) / 2 := by
    -- By definition of φ, we know that φ = (1 + Real.sqrt 5) / 2. Therefore, the equality holds by definition.
    rw [show φ = (1 + Real.sqrt 5) / 2 from rfl]
  rw [h_phi_def]
  norm_num at *; constructor <;> nlinarith [Real.sqrt_nonneg 5, Real.sq_sqrt (show 0 ≤ 5 by norm_num)] ;

