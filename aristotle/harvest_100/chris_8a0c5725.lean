        intro x;
        -- The Laplacian matrix is positive semidefinite, so its quadratic form is non-negative.
        have h_pos_semidef : ∀ (x : V → ℝ), 0 ≤ x ⬝ᵥ (laplacianMatrix G).mulVec x := by
