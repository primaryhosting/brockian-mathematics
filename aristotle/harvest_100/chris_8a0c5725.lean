    expectation p (fun S => c * f S + g S) = c * expectation p f + expectation p g := by
      simp +decide only [expectation];
      simp +decide only [mul_add, mul_left_comm, sum_add_distrib, mul_sum]

lemma sum_probSubset_eq_one (p : ℝ) : ∑ S : Finset V, probSubset p S = 1 := by
  -- By the binomial theorem, the sum of the probabilities over all subsets S of V is equal to 1.
  have h_binom : ∑ S : Finset V, (p ^ S.card * (1 - p) ^ (Fintype.card V - S.card)) = (p + (1 - p)) ^ Fintype.card V := by
    exact?;
  aesop

lemma sum_degree_expansion_part2 (G : SimpleGraph V) (S : Finset V) (x : V → ℝ) :
    ∑ i ∈ S, ∑ j ∈ S, (if G.Adj i j then (1:ℝ) else 0) * (x j)^2 = ∑ i ∈ S, (degreeIn G S i : ℝ) * (x i)^2 := by
      simp +decide only [degreeIn];
      rw [ Finset.sum_comm ];
      -- By definition of neighborFinset, we can rewrite the inner sum as the cardinality of the intersection of the neighborFinset and S.
      have h_neighborFinset : ∀ y ∈ S, ∑ x_1 ∈ S, (if G.Adj x_1 y then 1 else 0) = #(G.neighborFinset y ∩ S) := by
        simp +decide [ SimpleGraph.neighborFinset, Finset.filter_mem_eq_inter ];
        simp +decide [ SimpleGraph.neighborSet, Finset.filter_congr ];
        simp +decide [ Finset.filter_inter, SimpleGraph.adj_comm ];
      exact Finset.sum_congr rfl fun y hy => by rw [ ← h_neighborFinset y hy ] ; simp +decide [ Finset.sum_ite ] ;

def is_heavy (G : SimpleGraph V) (S : Finset V) (ε : ℝ) (v : V) : Prop :=
  v ∈ S ∧ (degreeIn G S v : ℝ) > (1/2) * ε * (G.degree v : ℝ)

def count_heavy (G : SimpleGraph V) (S : Finset V) (ε : ℝ) : ℝ :=
  ∑ v ∈ S, if is_heavy G S ε v then 1 else 0

def size_light (G : SimpleGraph V) (S : Finset V) (ε : ℝ) : ℝ :=
  (S.card : ℝ) - count_heavy G S ε

lemma sum_prob_eq_one (p : ℝ) : ∑ S : Finset V, probSubset p S = 1 := by
  exact?

lemma prob_mem_eq_p (p : ℝ) (v : V) :
    ∑ S : Finset V, (if v ∈ S then probSubset p S else 0) = p := by
  -- We'll use the fact that $\sum_{S : \text{Finset } V} \text{if } v \in S \text{ then } p^{|S|} (1-p)^{n-|S|} \text{ else } 0$ is the sum over all subsets $S$ containing $v$.
  have h_sum : (∑ S : Finset V, (if v ∈ S then p ^ S.card * (1 - p) ^ (Fintype.card V - S.card) else 0)) = (∑ T : Finset (Finset.erase (Finset.univ : Finset V) v), p ^ (T.card + 1) * (1 - p) ^ (Fintype.card (Finset.erase (Finset.univ : Finset V) v) - T.card)) := by
    rw [ ← Finset.sum_filter ];
    refine' Finset.sum_bij ( fun S hS => Finset.univ.filter fun x : Finset.univ.erase v => x.val ∈ S ) _ _ _ _ <;> simp +decide [ Finset.card_erase_of_mem, * ];
    · intro a₁ ha₁ a₂ ha₂ h; ext x; by_cases hx : x = v <;> simp_all +decide [ Finset.ext_iff ] ;
    · intro b;
      refine' ⟨ Insert.insert v ( Finset.image Subtype.val b ), _, _ ⟩ <;> simp +decide [ Finset.ext_iff ];
      grind;
    · intro a ha
      have h_card : a.card = (Finset.univ.filter (fun x : Finset.univ.erase v => x.val ∈ a)).card + 1 := by
        rw [ ← Finset.card_erase_add_one ha ];
        rw [ ← Finset.card_image_of_injective _ Subtype.coe_injective ] ; congr ; ext ; aesop;
      simp_all +decide [ Nat.sub_sub, add_comm ];
  convert h_sum using 1;
  have h_sum : (∑ T : Finset (Finset.erase (Finset.univ : Finset V) v), p ^ T.card * (1 - p) ^ (Fintype.card (Finset.erase (Finset.univ : Finset V) v) - T.card)) = 1 := by
    convert sum_prob_eq_one p using 1;
    infer_instance;
  simp_all +decide [ pow_succ', mul_assoc, Finset.mul_sum _ _ _ ];
  rw [ ← Finset.mul_sum _ _ _, h_sum, mul_one ]

