/-- Probability of a subset S given inclusion probability p -/
noncomputable def probSubset (p : ℝ) (S : Finset V) : ℝ :=
  p ^ S.card * (1 - p) ^ (Fintype.card V - S.card)

/-- Expectation of a function f over subsets -/
noncomputable def expectation (p : ℝ) (f : Finset V → ℝ) : ℝ :=
  ∑ S : Finset V, probSubset p S * f S

