/-- The cycle graph C_n -/
def cycleGraph (n : ℕ) (hn : 2 ≤ n) : SimpleGraph (Fin n) where
  Adj i j := ((i.val + 1) % n = j.val) ∨ ((j.val + 1) % n = i.val)
  symm := by
    exact?
  loopless := by
    -- To prove irreflexivity, we show that for any vertex i, i is not adjacent to itself.
    intro i
    simp [SimpleGraph.mk];
    -- Since $n \geq 2$, we have $(i + 1) \mod n \neq i$ for any $i \in \{0, 1, \ldots, n-1\}$.
    have h_mod : ∀ i : Fin n, (i + 1) % n ≠ i := by
      -- Since $n \geq 2$, we have $(i + 1) \mod n \neq i$ for any $i \in \{0, 1, \ldots, n-1\}$ because $1 \mod n = 1 \neq 0$.
      intros i
      by_contra h_contra
      have h_eq : (i + 1 : ℕ) % n = i := by
        exact h_contra;
      have := Nat.mod_add_div ( i + 1 ) n; aesop;
    exact h_mod i

