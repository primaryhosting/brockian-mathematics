        -- Since S is an independent set, there are no edges within S. Therefore, the Laplacian of the induced subgraph G' on S is zero.
        have h_induced_laplacian : ∀ u v, u ∈ S → v ∈ S → (inducedLaplacian G S) u v = 0 := by
          simp +decide [ *, inducedLaplacian ];
          simp +contextual [ SimpleGraph.lapMatrix, SimpleGraph.degree, SimpleGraph.neighborFinset ];
          intro u v hu hv; by_cases huv : u = v <;> simp_all +decide [ SimpleGraph.degMatrix ] ;
          · simp +decide [ SimpleGraph.degree, SimpleGraph.neighborFinset ];
            intro a ha; by_cases h : v = a <;> aesop;
          · exact h_indep u v hu hv huv;
        -- By definition of inducedLaplacian, if S is an independent set, then the induced Laplacian is zero.
        ext u v; by_cases hu : u ∈ S <;> by_cases hv : v ∈ S <;> simp_all +decide [ inducedLaplacian ];
