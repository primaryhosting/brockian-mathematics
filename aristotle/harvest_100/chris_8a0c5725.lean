/-- Independent sets have no internal edges ⟹ ε-light for any ε > 0 -/
theorem independent_set_is_epsilon_light (G : SimpleGraph V) (S : Finset V)
    (h_indep : ∀ u v, u ∈ S → v ∈ S → u ≠ v → ¬G.Adj u v)
    (ε : ℝ) (hε : 0 < ε) :
