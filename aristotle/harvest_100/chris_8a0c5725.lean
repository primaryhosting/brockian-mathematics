lemma sum_prob_eq_one_v3 (p : ℝ) : ∑ S : Finset V, probSubset p S = 1 := by
  convert sum_probSubset_eq_one p using 1;
  -- Since $V$ is a finite type, we can use the fact that finite types have decidable equality.
  apply Classical.decEq

lemma sum_prob_eq_one_final (p : ℝ) : ∑ S : Finset V, probSubset p S = 1 := by
  exact?

lemma sum_prob_eq_one_v4 (p : ℝ) : ∑ S : Finset V, probSubset p S = 1 := by
  -- The sum of the probabilities of all subsets S of V is equal to 1 because each subset S has a probability of p^|S| * (1-p)^(n-|S|), and summing over all S gives (p + (1-p))^n = 1^n = 1.
  apply sum_prob_eq_one_final

lemma expectation_linear_v3 (p : ℝ) (f g : Finset V → ℝ) (c : ℝ) :
    expectation p (fun S => c * f S + g S) = c * expectation p f + expectation p g := by
  simp [expectation, probSubset, mul_add, Finset.sum_add_distrib, Finset.mul_sum]
  ring

lemma sum_prob_eq_one_v5 (p : ℝ) : ∑ S : Finset V, probSubset p S = 1 := by
  -- Apply the lemma sum_probSubset_eq_one, which states that the sum of the probabilities of all subsets S equals 1.
  apply sum_probSubset_eq_one

lemma sum_prob_eq_one_v6 (p : ℝ) : ∑ S : Finset V, probSubset p S = 1 := by
  simp only [probSubset]
  rw [Fintype.sum_pow_mul_eq_add_pow V p (1 - p)]
  simp

lemma expectation_linear_final (p : ℝ) (f g : Finset V → ℝ) (c : ℝ) :
    expectation p (fun S => c * f S + g S) = c * expectation p f + expectation p g := by
  simp [expectation, probSubset, mul_add, Finset.sum_add_distrib, Finset.mul_sum, mul_assoc, mul_left_comm]

lemma expectation_sum {ι : Type*} [Fintype ι] (p : ℝ) (f : Finset V → ι → ℝ) :
    expectation p (fun S => ∑ i : ι, f S i) = ∑ i : ι, expectation p (fun S => f S i) := by
  simp [expectation, Finset.sum_mul, Finset.mul_sum]
  rw [Finset.sum_comm]

lemma prob_mem_eq_p_v2 (p : ℝ) (v : V) :
    ∑ S : Finset V, (if v ∈ S then probSubset p S else 0) = p := by
      -- The sum of the probabilities of all subsets containing v is equal to p, since each subset containing v contributes probSubset p S to the sum.
      apply prob_mem_eq_p

lemma prob_mem_eq_p_v3 (p : ℝ) (v : V) :
    ∑ S : Finset V, (if v ∈ S then probSubset p S else 0) = p := by
      -- Apply the hypothesis `h_sum` directly to conclude the proof.
      apply prob_mem_eq_p_v2

lemma expectation_linear_unique (p : ℝ) (f g : Finset V → ℝ) (c : ℝ) :
    expectation p (fun S => c * f S + g S) = c * expectation p f + expectation p g := by
  simp [expectation, probSubset, mul_add, Finset.sum_add_distrib, Finset.mul_sum, mul_assoc, mul_left_comm]

lemma expectation_degreeIn (G : SimpleGraph V) (v : V) (p : ℝ) :
    expectation p (fun S => degreeIn G S v) = p * (G.degree v) := by
      -- By linearity of expectation, we can pull the sum out of the expectation.
      have h_linear : expectation p (fun S => ∑ u ∈ G.neighborFinset v, (if u ∈ S then 1 else 0)) = ∑ u ∈ G.neighborFinset v, expectation p (fun S => if u ∈ S then 1 else 0) := by
        unfold expectation;
        rw [ Finset.sum_comm, Finset.sum_congr rfl fun _ _ => Finset.mul_sum _ _ _ ];
      -- By definition of expectation, we can rewrite the inner expectation as the probability that $u$ is in $S$.
      have h_inner : ∀ u ∈ G.neighborFinset v, expectation p (fun S => if u ∈ S then 1 else 0) = p := by
        intro u hu
        simp [expectation, probSubset];
        convert prob_mem_eq_p_v3 p u using 1;
      convert h_linear using 1;
      · unfold degreeIn; aesop;
      · rw [ Finset.sum_congr rfl h_inner, Finset.sum_const, Finset.card_eq_sum_ones, nsmul_eq_mul, mul_comm ];
        simp +decide [ SimpleGraph.degree, SimpleGraph.neighborFinset ]

lemma probSubset_nonneg (p : ℝ) (S : Finset V) (hp : 0 ≤ p) (hp1 : p ≤ 1) : 
    0 ≤ probSubset p S := by
  unfold probSubset
  apply mul_nonneg
  · apply pow_nonneg hp
  · apply pow_nonneg (by linarith)

lemma prob_pair_mem_eq_p_sq (p : ℝ) (u v : V) (h_ne : u ≠ v) :
    ∑ S : Finset V, (if u ∈ S ∧ v ∈ S then probSubset p S else 0) = p^2 := by
      unfold probSubset;
      -- The sum over all subsets S can be split into two parts: those that contain both u and v, and those that don't. The terms where u and v are not both in S will contribute zero.
      have h_split : ∑ S : Finset V, (if u ∈ S ∧ v ∈ S then p ^ S.card * (1 - p) ^ (Fintype.card V - S.card) else 0) = ∑ S ∈ Finset.powerset (Finset.univ \ {u, v}), p ^ (S.card + 2) * (1 - p) ^ (Fintype.card V - (S.card + 2)) := by
        have h_split : Finset.filter (fun S => u ∈ S ∧ v ∈ S) Finset.univ = Finset.image (fun S => S ∪ {u, v}) (Finset.powerset (Finset.univ \ {u, v})) := by
          ext S; simp [Finset.mem_image];
          constructor <;> intro hS
          all_goals generalize_proofs at *;
          · exact ⟨ S \ { u, v }, fun x hx => by aesop, by ext x; by_cases hu : x = u <;> by_cases hv : x = v <;> aesop ⟩;
          · grind;
        rw [ ← Finset.sum_filter, h_split, Finset.sum_image ] <;> simp +decide [ Finset.card_union_add_card_inter, h_ne ];
        · refine' Finset.sum_congr rfl fun S hS => _ ; rw [ Finset.card_insert_of_notMem, Finset.card_insert_of_notMem ] <;> simp_all +decide [ Finset.mem_sdiff, Finset.mem_singleton ] ;
          · grind;
          · exact fun hu => by simpa [ hu ] using hS hu;
        · intro S hS T hT h_eq; simp_all +decide [ Finset.ext_iff, Set.ext_iff ] ;
          intro a; specialize h_eq a; replace hS := @hS a; replace hT := @hT a; aesop;
      have h_sum : ∑ S ∈ Finset.powerset (Finset.univ \ {u, v}), p ^ S.card * (1 - p) ^ (Fintype.card V - 2 - S.card) = 1 := by
        have h_sum : ∑ S ∈ Finset.powerset (Finset.univ \ {u, v}), p ^ S.card * (1 - p) ^ (Fintype.card V - 2 - S.card) = (p + (1 - p)) ^ (Fintype.card V - 2) := by
          rw [ add_pow ];
          rw [ Finset.sum_powerset ];
          simp +decide [ Finset.card_sdiff, Finset.card_singleton, Finset.card_univ, h_ne ];
          refine' Finset.sum_congr rfl fun x hx => _;
          rw [ Finset.sum_congr rfl fun t ht => by rw [ Finset.mem_powersetCard.mp ht |>.2 ] ] ; simp +decide [ mul_comm, Finset.card_sdiff, Finset.card_singleton, Finset.card_univ, h_ne ];
        aesop;
      simp_all +decide [ pow_add, mul_assoc, mul_comm, mul_left_comm, Finset.mul_sum _ _ _ ];
      convert congr_arg ( fun x : ℝ => p ^ 2 * x ) h_sum using 1;
      · rw [ Finset.mul_sum _ _ _ ] ; refine' Finset.sum_congr rfl fun x hx => _ ; rw [ Nat.sub_sub ] ; ring;
      · ring

