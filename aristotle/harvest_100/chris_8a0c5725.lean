lemma prob_mem_eq_p_proven (p : ℝ) (v : V) :
    ∑ S : Finset V, (if v ∈ S then probSubset p S else 0) = p := by
      -- Apply the lemma that states the sum of the probabilities where v is in S is equal to p.
      apply prob_mem_eq_p

lemma expectation_degree_indicator (G : SimpleGraph V) (v : V) (p : ℝ) :
    expectation p (fun S => if v ∈ S then (degreeIn G S v : ℝ) else 0) = p^2 * (G.degree v) := by
      -- The expectation of the degreeIn for a fixed vertex v is the sum over all subsets S that include v of the probability of S times the degreeIn of v in S.
      have h_sum : ∑ S : Finset V, (if v ∈ S then probSubset p S else 0) * (degreeIn G S v : ℝ) = ∑ w ∈ G.neighborFinset v, ∑ S : Finset V, (if v ∈ S ∧ w ∈ S then probSubset p S else 0) := by
        rw [ Finset.sum_comm, Finset.sum_congr rfl ];
        intro S hS;
        split_ifs <;> simp_all +decide [ Finset.sum_ite ];
        unfold degreeIn; ring;
      convert h_sum using 1;
      · unfold expectation; aesop;
      · rw [ Finset.sum_congr rfl fun w hw => prob_pair_mem_eq_p_sq p v w ( by aesop ) ] ; simp +decide [ mul_comm ]
