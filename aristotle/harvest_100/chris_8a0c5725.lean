/-- Degree of v in the induced subgraph on S -/
def degreeIn (G : SimpleGraph V) (S : Finset V) (v : V) : ℕ :=
  (G.neighborFinset v ∩ S).card

/-- 
A set S is (c, ε)-degree-light if for all v ∈ S, deg_S(v) ≤ c * ε * deg(v).
This is a local sparsity condition.
-/
def IsDegreeLight (G : SimpleGraph V) (S : Finset V) (c : ℝ) (ε : ℝ) : Prop :=
  ∀ v ∈ S, (degreeIn G S v : ℝ) ≤ c * ε * (G.degree v : ℝ)

