/-- SUB-LEMMA 5.7: The norm doesn't change with unit exponential -/
lemma norm_with_unit_exp (tp : TwinPrimePair) (ε₁ : ℂ) :
    ‖Complex.exp (phi * Real.log (tp.p : ℝ) * Complex.I) *
                 (twinComplexFactor + ε₁)‖ =
    ‖twinComplexFactor + ε₁‖ := by
      -- The norm of the exponential term is 1, so we can simplify the expression using the property of norms.
      simp [Complex.norm_exp];
      -- Since the logarithm of a real number is real, the imaginary part is zero.
      have h_log_real : Complex.log (tp.p : ℂ) = Real.log (tp.p : ℝ) := by
        exact?;
      -- Since the logarithm of a real number is real, its imaginary part is zero.
      have h_log_im : (Complex.log (tp.p : ℂ)).im = 0 := by
        exact?;
      -- Substitute h_log_im into the expression.
      rw [h_log_im]
      simp

/-- SUB-LEMMA 5.8: Error propagation in norm -/
lemma norm_close_to_constant (p : ℕ) (ε₁ : ℂ) (h : ‖ε₁‖ ≤ 20 / p) (hp : 11 ≤ p) :
    ∃ ε : ℝ, |ε| ≤ 20 / (p : ℝ) ∧
    ‖twinComplexFactor + ε₁‖ = twinSeparationConstant + ε := by
  -- Applying the reverse triangle inequality.
  have h_reverse_triangle : |‖twinComplexFactor + ε₁‖ - ‖twinComplexFactor‖| ≤ ‖ε₁‖ := by
    convert abs_norm_sub_norm_le ( twinComplexFactor + ε₁ ) ( twinComplexFactor ) using 1 ; ring;
  -- Let's set ε to be the difference between the norm of twinComplexFactor + ε₁ and the norm of twinComplexFactor.
  use ‖twinComplexFactor + ε₁‖ - ‖twinComplexFactor‖;
  exact ⟨ h_reverse_triangle.trans h, by rw [ show ‖twinComplexFactor‖ = twinSeparationConstant from abs_twinComplexFactor ] ; ring ⟩ -- ARISTOTLE: Triangle inequality
  -- HINT: ||a + ε| - |a|| ≤ |ε|
  -- So |abs(twinComplexFactor + ε₁) - twinSeparationConstant| ≤ 20/p

/-- 
MAIN THEOREM A: Universal Twin Prime Separation

For twin prime pairs (p, p+2) with p ≥ 11:
  |spiralPrime(p+2) - spiralPrime(p)| = 3.8042... + O(1/p)

PROOF OUTLINE:
1. Use separation_factored to factor the difference
2. Use inner_expression to approximate the inner term
3. Use norm_with_unit_exp to factor out the unit exponential
4. Use norm_close_to_constant to get final error bound
5. Combine to get |difference| = twinSeparationConstant + ε where |ε| ≤ 20/p
-/
theorem twin_prime_separation_main (tp : TwinPrimePair) (hp : 11 ≤ tp.p) :
    ∃ ε : ℝ, |ε| ≤ 20 / (tp.p : ℝ) ∧
    ‖spiralPrime ⟨tp.p + 2, tp.isPrime_p2⟩ - 
                 spiralPrime ⟨tp.p, tp.isPrime_p⟩‖ = 
    twinSeparationConstant + ε := by
  -- We need to show that the distance between spiralPrime(p+2) and spiralPrime(p) is approximately twinSeparationConstant.
  -- First, let's use the separation_factored lemma to express the difference.
  have h_sep : spiralPrime ⟨tp.p + 2, tp.isPrime_p2⟩ - spiralPrime ⟨tp.p, tp.isPrime_p⟩ =
      Complex.exp (phi * Real.log (tp.p : ℝ) * Complex.I) *
      (((tp.p + 2 : ℕ) : ℝ) * Complex.exp (phi * Real.log (1 + 2 / (tp.p : ℝ)) * Complex.I) - (tp.p : ℝ)) := by
    apply separation_factored
    norm_cast
    linarith
  
  -- Now, let's use the inner_expression lemma to approximate the inner term.
  obtain ⟨ε₁, hε₁_bound, hε₁_eq⟩ := inner_expression tp hp
  
  -- Substitute the inner expression into the separation formula.
  rw [h_sep, hε₁_eq]
  
  -- Use norm_with_unit_exp to simplify the norm.
  rw [norm_with_unit_exp tp ε₁]
  
  -- Finally, use norm_close_to_constant to get the final form.
  apply norm_close_to_constant tp.p ε₁ hε₁_bound hp

/-- A configuration modulo p -/
structure Configuration (p : ℕ) where
  i : Fin p
  j : Fin p

/-- Configuration is principal if both components are nonzero -/
def Configuration.isPrincipal {p : ℕ} (c : Configuration p) : Prop :=
  c.i.val ≠ 0 ∧ c.j.val ≠ 0

/-- Configuration for gap g -/
def configForGap (p g : ℕ) (i : Fin p) : Configuration p :=
  ⟨i, ⟨(i.val + g) % p, Nat.mod_lt _ (lt_of_le_of_lt (Nat.zero_le _) i.is_lt)⟩⟩

/-- Count of principal configurations -/
def principalConfigCount (p g : ℕ) (hp : Nat.Prime p) (hg : Nat.gcd g p = 1) : ℕ :=
  (Finset.univ.filter (fun (i : Fin p) => 
    (configForGap p g i).isPrincipal)).card

/-- SUB-LEMMA 7.1: Total configurations -/
lemma total_configurations (p : ℕ) : Fintype.card (Fin p) = p := by
  exact Fintype.card_fin p

/-- SUB-LEMMA 7.2: Configuration (0, g mod p) is not principal -/
lemma config_zero_not_principal (p g : ℕ) (hp : Nat.Prime p) (hg : Nat.gcd g p = 1) :
    ¬(configForGap p g ⟨0, hp.pos⟩).isPrincipal := by
  unfold Configuration.isPrincipal configForGap
  simp

/-- SUB-LEMMA 7.3: Configuration ((-g) mod p, 0) is not principal -/
lemma config_neg_g_not_principal (p g : ℕ) (hp : Nat.Prime p) (hg : Nat.gcd g p = 1) :
    ∃ i : Fin p, i.val ≠ 0 ∧ (configForGap p g i).j.val = 0 ∧
    ¬(configForGap p g i).isPrincipal := by
      -- Since $g$ is coprime to $p$, there exists an $i$ such that $i + g \equiv 0 \pmod{p}$.
      obtain ⟨i, hi⟩ : ∃ i : Fin p, (i.val + g) % p = 0 := by
        -- Since $g$ is coprime to $p$, there exists an $i$ such that $i \equiv -g \pmod{p}$.
        obtain ⟨i, hi⟩ : ∃ i : ℕ, i < p ∧ i + g ≡ 0 [MOD p] := by
          -- Let $i = p - g \% p$. Then $i + g = p - g \% p + g = p + (g - g \% p)$, which is clearly divisible by $p$.
          use p - g % p;
          exact ⟨ Nat.sub_lt hp.pos ( Nat.pos_of_ne_zero fun h => by have := Nat.dvd_gcd ( Nat.dvd_of_mod_eq_zero h ) ( Nat.dvd_refl p ) ; aesop ), by rw [ Nat.modEq_zero_iff_dvd ] ; exact ⟨ g / p + 1, by linarith [ Nat.div_add_mod g p, Nat.sub_add_cancel ( Nat.mod_lt g hp.pos |> Nat.le_of_lt ) ] ⟩ ⟩;
        exact ⟨ ⟨ i, hi.1 ⟩, hi.2 ⟩;
      refine' ⟨ i, _, _, _ ⟩ <;> simp_all +decide [ configForGap ];
      · rw [ Nat.gcd_comm ] at hg; rw [ Nat.gcd_rec ] at hg; aesop;
      · exact fun h => h.2 rfl

/-- SUB-LEMMA 7.4: These are the only two non-principal configs -/
lemma only_two_non_principal (p g : ℕ) (hp : Nat.Prime p) (hg : Nat.gcd g p = 1) :
    (Finset.univ.filter (fun (i : Fin p) =>
      ¬(configForGap p g i).isPrincipal)).card = 2 := by
        -- The set of non-principal configurations is exactly {⟨0, hp.pos⟩, ⟨(p - g % p) % p, Nat.mod_lt _ (Nat.pos_of_ne_zero hp.ne_zero)⟩}.
        have h_non_principal_set : Finset.filter (fun i : Fin p => ¬(configForGap p g i).isPrincipal) Finset.univ = {⟨0, hp.pos⟩, ⟨(p - g % p) % p, Nat.mod_lt _ (Nat.pos_of_ne_zero hp.ne_zero)⟩} := by
          -- To prove the equality of sets, we show each set is a subset of the other.
          apply Finset.ext
          intro i
          simp [configForGap, Configuration.isPrincipal];
          constructor <;> intro hi;
          · by_cases hi0 : ( i : ℕ ) = 0 <;> simp_all +decide [ Fin.ext_iff ];
            -- Since $(i + g) \equiv 0 \pmod{p}$, we have $i \equiv -g \pmod{p}$.
            have h_cong : (i : ℕ) ≡ p - g % p [MOD p] := by
              simp_all +decide [ ← ZMod.natCast_eq_natCast_iff, Nat.cast_sub ( show g % p ≤ p from Nat.le_of_lt <| Nat.mod_lt _ hp.pos ) ];
              exact eq_neg_of_add_eq_zero_left ( by simpa [ ← ZMod.natCast_eq_zero_iff ] using congr_arg ( fun x : ℕ => x : ℕ → ZMod p ) hi );
            rw [ ← h_cong, Nat.mod_eq_of_lt i.2 ];
          · rcases hi with ( rfl | rfl ) <;> norm_num [ Nat.mod_eq_of_lt hp.one_lt ];
            exact fun h => Nat.mod_eq_zero_of_dvd ⟨ g / p + 1, by linarith [ Nat.div_add_mod g p, Nat.sub_add_cancel ( show g % p ≤ p from Nat.le_of_lt ( Nat.mod_lt _ hp.pos ) ) ] ⟩;
        rw [ h_non_principal_set, Finset.card_insert_of_notMem, Finset.card_singleton ] ; norm_num;
        rw [ eq_comm, Nat.mod_eq_of_lt ] <;> norm_num [ hp.pos ];
        · exact Nat.sub_ne_zero_of_lt ( Nat.mod_lt _ hp.pos );
        · exact Nat.pos_of_ne_zero fun h => by have := Nat.dvd_gcd ( Nat.dvd_of_mod_eq_zero h ) ( Nat.dvd_refl p ) ; aesop;

/--
MAIN THEOREM C: Universal p-2 Law

For any prime p and gap g coprime to p, there are exactly p-2 principal configurations.

PROOF OUTLINE:
1. Total configurations = p (use total_configurations)
2. Non-principal configurations = 2 (use only_two_non_principal)
3. Principal configurations = p - 2 (subtract)
-/
theorem universal_p_minus_2_law (p g : ℕ) (hp : Nat.Prime p) (hg : Nat.gcd g p = 1) :
    principalConfigCount p g hp hg = p - 2 := by
      -- The total number of configurations is p, and the number of non-principal configurations is 2.
      have h_total : (Finset.univ.filter (fun (i : Fin p) =>
        ¬(configForGap p g i).isPrincipal)).card = 2 := by
          exact?;
      -- The cardinality of the set of principal configurations is the total number of configurations minus the number of non-principal configurations.
      have h_principal : (Finset.univ.filter (fun (i : Fin p) => (configForGap p g i).isPrincipal)).card = p - (Finset.univ.filter (fun (i : Fin p) => ¬(configForGap p g i).isPrincipal)).card := by
        -- The set of principal configurations is the complement of the set of non-principal configurations.
        have h_complement : Finset.filter (fun i : Fin p => (configForGap p g i).isPrincipal) Finset.univ = Finset.univ \ Finset.filter (fun i : Fin p => ¬(configForGap p g i).isPrincipal) Finset.univ := by
          -- The set of principal configurations is exactly the elements of Finset.univ that are not in the set of non-principal configurations.
          ext i
          simp [Finset.mem_sdiff, Finset.mem_filter];
        rw [ h_complement, Finset.card_sdiff ] ; norm_num [ Finset.card_univ ];
      rwa [ h_total ] at h_principal

