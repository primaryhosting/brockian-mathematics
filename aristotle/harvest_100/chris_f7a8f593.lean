/-- Tighter bound for exponential approximation -/
lemma exp_log_approx_tight (p : ℕ) (hp : 11 ≤ p) :
    let x := 2 / (p : ℝ)
    let θ := phi * Real.log (1 + x)
    ‖Complex.exp (θ * Complex.I) - (1 + θ * Complex.I)‖ ≤ 5 * phi^2 / (p : ℝ)^2 := by
      -- By Lemma 7, we have that the norm of the difference is bounded by θ^2.
      have h_exp_approx : ‖Complex.exp (phi * Real.log (1 + 2 / (p : ℝ)) * Complex.I) - (1 + phi * Real.log (1 + 2 / (p : ℝ)) * Complex.I)‖ ≤ (phi * Real.log (1 + 2 / (p : ℝ)))^2 := by
        have h_small_x : ‖Complex.exp (phi * Real.log (1 + 2 / (p : ℝ)) * Complex.I) - (1 + phi * Real.log (1 + 2 / (p : ℝ)) * Complex.I)‖ ≤ (phi * Real.log (1 + 2 / (p : ℝ)))^2 := by
          have h_x_small : |phi * Real.log (1 + 2 / (p : ℝ))| ≤ 1 / 2 := by
            rw [ abs_le ];
            constructor;
            · exact le_trans ( by norm_num ) ( mul_nonneg ( show 0 ≤ phi by exact div_nonneg ( add_nonneg zero_le_one ( Real.sqrt_nonneg _ ) ) zero_le_two ) ( Real.log_nonneg ( by norm_num; positivity ) ) );
            · refine' le_trans ( mul_le_mul_of_nonneg_left ( Real.log_le_sub_one_of_pos ( by positivity ) ) ( by exact div_nonneg ( add_nonneg zero_le_one ( Real.sqrt_nonneg _ ) ) zero_le_two ) ) _;
              norm_num [ phi ];
              rw [ mul_div, div_le_iff₀ ] <;> nlinarith [ Real.sqrt_nonneg 5, Real.sq_sqrt ( show 0 ≤ 5 by norm_num ), show ( p : ℝ ) ≥ 11 by norm_cast ]
          convert exp_I_small_approx ( phi * Real.log ( 1 + 2 / ( p : ℝ ) ) ) _ using 1 <;> aesop;
        -- Apply the hypothesis `h_small_x` to conclude the proof.
        exact h_small_x;
      -- Using the logarithm approximation, we can bound the term involving the logarithm. Since $p \geq 11$, we have $\log(1 + 2/p) \leq 2/p$.
      have h_log_bound : Real.log (1 + 2 / (p : ℝ)) ≤ 2 / (p : ℝ) := by
        exact le_trans ( Real.log_le_sub_one_of_pos ( by positivity ) ) ( by norm_num );
      refine le_trans ?_ ( h_exp_approx.trans ?_ );
      · norm_num [ mul_assoc ];
      · refine le_trans ( pow_le_pow_left₀ ( mul_nonneg ( show 0 ≤ phi by exact div_nonneg ( add_nonneg zero_le_one ( Real.sqrt_nonneg _ ) ) zero_le_two ) ( Real.log_nonneg ( by norm_num; positivity ) ) ) ( mul_le_mul_of_nonneg_left h_log_bound <| show 0 ≤ phi by exact div_nonneg ( add_nonneg zero_le_one ( Real.sqrt_nonneg _ ) ) zero_le_two ) _ ) ?_ ; ring_nf ; norm_num;
        exact mul_le_mul_of_nonneg_left ( by norm_num ) ( by positivity )

/-- SUB-LEMMA 5.6: Expand (p+2) * exp(...) - p -/
lemma inner_expression (tp : TwinPrimePair) (hp : 11 ≤ tp.p) :
    ∃ ε₁ : ℂ, ‖ε₁‖ ≤ 20 / (tp.p : ℝ) ∧
    ((tp.p + 2 : ℕ) : ℝ) * Complex.exp (phi * Real.log (1 + 2 / (tp.p : ℝ)) * Complex.I) -
    (tp.p : ℝ) = twinComplexFactor + ε₁ := by
      -- Let's choose $\epsilon_1 = (p + 2) * \exp(i\theta) - p - twinComplexFactor$.
      use ((tp.p + 2 : ℕ) : ℝ) * Complex.exp (phi * Real.log (1 + 2 / (tp.p : ℝ)) * Complex.I) - (tp.p : ℝ) - twinComplexFactor;
      -- Now use the given approximations to bound the norm.
      have h_bound : ‖((tp.p + 2 : ℕ) : ℝ) * Complex.exp (phi * Real.log (1 + 2 / (tp.p : ℝ)) * Complex.I) - (tp.p : ℝ) - twinComplexFactor‖ ≤ ‖(tp.p + 2 : ℕ) * Complex.exp (phi * Real.log (1 + 2 / (tp.p : ℝ)) * Complex.I) - (tp.p + 2 : ℕ) * (1 + phi * (2 / (tp.p : ℝ) - 2 / (tp.p : ℝ)^2) * Complex.I)‖ + ‖(tp.p + 2 : ℕ) * (1 + phi * (2 / (tp.p : ℝ) - 2 / (tp.p : ℝ)^2) * Complex.I) - (tp.p : ℝ) - twinComplexFactor‖ := by
        convert norm_add_le _ _ using 2 ; norm_num ; ring;
      -- Now use the given approximations to bound the norm of the first term.
      have h_bound_first_term : ‖(tp.p + 2 : ℕ) * Complex.exp (phi * Real.log (1 + 2 / (tp.p : ℝ)) * Complex.I) - (tp.p + 2 : ℕ) * (1 + phi * (2 / (tp.p : ℝ) - 2 / (tp.p : ℝ)^2) * Complex.I)‖ ≤ (tp.p + 2 : ℕ) * (5 * phi^2 / (tp.p : ℝ)^2 + 8 * phi / (3 * (tp.p : ℝ)^3)) := by
        -- Using the triangle inequality and the bounds from the approximations, we can combine them.
        have h_triangle : ‖Complex.exp (phi * Real.log (1 + 2 / (tp.p : ℝ)) * Complex.I) - (1 + phi * (2 / (tp.p : ℝ) - 2 / (tp.p : ℝ)^2) * Complex.I)‖ ≤ ‖Complex.exp (phi * Real.log (1 + 2 / (tp.p : ℝ)) * Complex.I) - (1 + phi * Real.log (1 + 2 / (tp.p : ℝ)) * Complex.I)‖ + ‖phi * Real.log (1 + 2 / (tp.p : ℝ)) * Complex.I - phi * (2 / (tp.p : ℝ) - 2 / (tp.p : ℝ)^2) * Complex.I‖ := by
          convert norm_add_le ( cexp ( phi * Real.log ( 1 + 2 / ( tp.p : ℝ ) ) * Complex.I ) - ( 1 + phi * Real.log ( 1 + 2 / ( tp.p : ℝ ) ) * Complex.I ) ) ( phi * Real.log ( 1 + 2 / ( tp.p : ℝ ) ) * Complex.I - phi * ( 2 / ( tp.p : ℝ ) - 2 / ( tp.p : ℝ ) ^ 2 ) * Complex.I ) using 2 ; ring;
        -- Using the bounds from the approximations, we can combine them.
        have h_bound_first_term : ‖Complex.exp (phi * Real.log (1 + 2 / (tp.p : ℝ)) * Complex.I) - (1 + phi * Real.log (1 + 2 / (tp.p : ℝ)) * Complex.I)‖ ≤ 5 * phi^2 / (tp.p : ℝ)^2 := by
          convert exp_log_approx_tight tp.p hp using 1;
          norm_num [ mul_assoc ];
        have h_bound_second_term : ‖phi * Real.log (1 + 2 / (tp.p : ℝ)) * Complex.I - phi * (2 / (tp.p : ℝ) - 2 / (tp.p : ℝ)^2) * Complex.I‖ ≤ 8 * phi / (3 * (tp.p : ℝ)^3) := by
          have h_bound_second_term : |Real.log (1 + 2 / (tp.p : ℝ)) - (2 / (tp.p : ℝ) - 2 / (tp.p : ℝ)^2)| ≤ 8 / (3 * (tp.p : ℝ)^3) := by
            convert log_twin_expansion tp.p hp using 1 ; ring;
          norm_num [ Complex.normSq, Complex.norm_def ] at *;
          norm_cast ; norm_num [ sq, mul_assoc, mul_comm, mul_left_comm ] at *;
          norm_num [ div_eq_mul_inv ] at *;
          rw [ Real.sqrt_mul_self_eq_abs, abs_le ];
          constructor <;> norm_num [ show ( tp.p : ℝ ) ≠ 0 by positivity ] at * <;> nlinarith [ abs_le.mp h_bound_second_term, show ( 0 : ℝ ) < phi by exact div_pos ( add_pos zero_lt_one ( Real.sqrt_pos.mpr ( show ( 5 : ℝ ) > 0 by norm_num ) ) ) zero_lt_two ];
        convert mul_le_mul_of_nonneg_left ( h_triangle.trans ( add_le_add h_bound_first_term h_bound_second_term ) ) ( Nat.cast_nonneg ( tp.p + 2 ) ) using 1 ; norm_num [ mul_sub, mul_add ];
        rw [ show ( ( tp.p : ℂ ) + 2 ) * cexp _ - ( ( tp.p : ℂ ) + 2 + ( ( tp.p : ℂ ) + 2 ) * ( ( phi * ( 2 / ( tp.p : ℂ ) ) - phi * ( 2 / ( tp.p : ℂ ) ^ 2 ) ) * Complex.I ) ) = ( ( tp.p : ℂ ) + 2 ) * ( cexp _ - ( 1 + ( ( phi * ( 2 / ( tp.p : ℂ ) ) - phi * ( 2 / ( tp.p : ℂ ) ^ 2 ) ) * Complex.I ) ) ) by ring, norm_mul ] ; norm_cast;
      -- Now use the given approximations to bound the norm of the second term.
      have h_bound_second_term : ‖(tp.p + 2 : ℕ) * (1 + phi * (2 / (tp.p : ℝ) - 2 / (tp.p : ℝ)^2) * Complex.I) - (tp.p : ℝ) - twinComplexFactor‖ ≤ 4 / (tp.p : ℝ) := by
        norm_num [ Complex.normSq, Complex.norm_def, twinComplexFactor ] ; ring_nf ; norm_num [ show ( tp.p : ℝ ) ≠ 0 by positivity ] ;
        norm_cast ; norm_num [ sq, mul_assoc, ne_of_gt ( by positivity : 0 < ( tp.p : ℝ ) ) ] ; ring_nf ; norm_num [ show ( tp.p : ℝ ) ≠ 0 by positivity ] ;
        rw [ Real.sqrt_le_left ] <;> ring_nf <;> norm_num [ show ( tp.p : ℝ ) ≠ 0 by positivity ];
        field_simp;
        rw [ show phi = ( 1 + Real.sqrt 5 ) / 2 by rfl ] ; ring_nf ; norm_num;
        nlinarith only [ show ( tp.p : ℝ ) ≥ 11 by norm_cast, Real.sqrt_nonneg 5, Real.sq_sqrt ( show 0 ≤ 5 by norm_num ), pow_two_nonneg ( ( tp.p : ℝ ) - 11 ) ];
      refine' ⟨ le_trans h_bound ( le_trans ( add_le_add h_bound_first_term h_bound_second_term ) _ ), _ ⟩ <;> norm_num;
      rw [ show phi = ( 1 + Real.sqrt 5 ) / 2 by rfl ] ; ring_nf ; norm_num;
      field_simp;
      nlinarith only [ show ( tp.p : ℝ ) ≥ 11 by norm_cast, Real.sqrt_nonneg 5, Real.sq_sqrt ( show 0 ≤ 5 by norm_num ), pow_two_nonneg ( Real.sqrt 5 - 2 : ℝ ), pow_two_nonneg ( Real.sqrt 5 + 2 : ℝ ), pow_two_nonneg ( tp.p - 11 : ℝ ) ]

