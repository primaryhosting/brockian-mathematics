/-- SUB-LEMMA 5.6: Expand (p+2) * exp(...) - p -/
lemma inner_expression_proven (tp : TwinPrimePair) (hp : 11 ≤ tp.p) :
    ∃ ε₁ : ℂ, ‖ε₁‖ ≤ 20 / (tp.p : ℝ) ∧
    ((tp.p + 2 : ℕ) : ℝ) * Complex.exp (phi * Real.log (1 + 2 / (tp.p : ℝ)) * Complex.I) -
