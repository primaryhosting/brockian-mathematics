  convert mul_le_mul_of_nonneg_left ( log_twin_expansion tp.p hp ) ( show 0 ≤ phi by exact div_nonneg ( add_nonneg zero_le_one <| Real.sqrt_nonneg _ ) zero_le_two ) using 1;
  · rw [ ← mul_sub, abs_mul, abs_of_nonneg ( show 0 ≤ phi by exact div_nonneg ( add_nonneg zero_le_one <| Real.sqrt_nonneg _ ) zero_le_two ) ] ; ring;
