/-! ## The point group D₆ₕ

The molecular point group of benzene is `D₆ₕ ≅ D₆ × {E, i}`, the direct product of the
dihedral group of order 12 with the two-element group generated by the inversion centre.
-/

/-- The point group `D₆ₕ` of benzene, realised as `D₆ × C_i`. -/
abbrev D6h := DihedralGroup 6 × Multiplicative (ZMod 2)

/-- The parity (`g`/`u`) sign attached to the inversion factor of `D₆ₕ`. -/
def par (e : Multiplicative (ZMod 2)) : ℤ := if Multiplicative.toAdd e = 0 then 1 else -1

/-- Character values of the two–dimensional irrep `E₁` on the rotations `Cₙ` of `D₆`. -/
def e1v : ℕ → ℤ | 0 => 2 | 1 => 1 | 2 => -1 | 3 => -2 | 4 => -1 | 5 => 1 | _ => 0

/-- Character values of the two–dimensional irrep `E₂` on the rotations `Cₙ` of `D₆`. -/
def e2v : ℕ → ℤ | 0 => 2 | 1 => -1 | 2 => -1 | 3 => 2 | 4 => -1 | 5 => -1 | _ => 0

/-- The alternating sign `(-1)ⁿ`, used for the `B`-type irreps. -/
def altv (n : ℕ) : ℤ := if n % 2 = 0 then 1 else -1

/-- The six irreducible characters of the dihedral group `D₆`, in the order
`A₁, A₂, B₁, B₂, E₁, E₂`. -/
def chiD6 : Fin 6 → DihedralGroup 6 → ℤ
  | 0, _ => 1
  | 1, .r _ => 1
  | 1, .sr _ => -1
  | 2, .r i => altv i.val
  | 2, .sr i => altv i.val
  | 3, .r i => altv i.val
  | 3, .sr i => -altv i.val
  | 4, .r i => e1v i.val
  | 4, .sr _ => 0
  | 5, .r i => e2v i.val
  | 5, .sr _ => 0

/-- The twelve irreducible characters of `D₆ₕ`:
`A₁g, A₂g, B₁g, B₂g, E₁g, E₂g, A₁u, A₂u, B₁u, B₂u, E₁u, E₂u`.
The `g` characters are the characters of `D₆` pulled back along the projection, and the `u`
characters are those multiplied by the parity sign of the inversion factor. -/
def chi (a : Fin 12) (x : D6h) : ℤ :=
  if h : a.val < 6 then chiD6 ⟨a.val, h⟩ x.1
  else par x.2 * chiD6 ⟨a.val - 6, by omega⟩ x.1

/-- The dimensions of the twelve irreps of `D₆ₕ`, read off the identity column. -/
def dim (a : Fin 12) : ℤ := chi a 1

/-! ## Basic facts -/

/-- `D₆ₕ` has order 24. -/
theorem card_D6h : Fintype.card D6h = 24 := by decide

/-- `D₆ₕ` has exactly 12 conjugacy classes. -/
theorem card_conjClasses_D6h : Fintype.card (ConjClasses D6h) = 12 := by decide

/-- Each of the twelve characters is a class function. -/
theorem chi_isClassFun (a : Fin 12) (x y : D6h) : chi a (y * x * y⁻¹) = chi a x := by
  revert a x y; decide

/-- The first orthogonality relation for the character table of `D₆ₕ`:
`∑_{x ∈ D₆ₕ} χ_a(x) χ_b(x) = |D₆ₕ| δ_{ab}`.  (All characters of `D₆ₕ` are real-valued, so no
complex conjugation is needed.) -/
theorem chi_orthogonal (a b : Fin 12) :
    (∑ x : D6h, chi a x * chi b x) = if a = b then 24 else 0 := by
  revert a b; decide

/-- The twelve characters are pairwise distinct. -/
theorem chi_injective : Function.Injective chi := by
  intro a b hab
  by_contra hne
  have h := chi_orthogonal a b
  rw [if_neg hne, ← hab] at h
  have h' := chi_orthogonal a a
  rw [if_pos rfl] at h'
  omega

/-- The dimensions of the irreps of `D₆ₕ` are `1,1,1,1,2,2` for the gerade set and the same for
the ungerade set. -/
theorem dim_values : ∀ a : Fin 12, dim a = if a = 4 ∨ a = 5 ∨ a = 10 ∨ a = 11 then 2 else 1 := by
  decide

/-- The sum of the squares of the dimensions of the twelve irreps is the order of the group. -/
theorem sum_dim_sq : (∑ a : Fin 12, dim a ^ 2) = 24 := by decide

/-! ## Main theorem -/

/-- **Character table of D₆ₕ (benzene).**

The data `chi : Fin 12 → D6h → ℤ` is a genuine character table for the point group `D₆ₕ` of
benzene, and it has the correct number of rows:

* the number of irreducible representations listed (12) equals the number of conjugacy
  classes of `D₆ₕ`;
* each listed character is a class function;
* the listed characters satisfy the first orthogonality relation, hence they are irreducible
  and pairwise inequivalent;
* the sum of the squares of their dimensions equals `|D₆ₕ| = 24`, so the list is complete.
-/
theorem benzene_D6h_irreps :
    Fintype.card (Fin 12) = Fintype.card (ConjClasses D6h) ∧
    Fintype.card D6h = 24 ∧
    (∀ (a : Fin 12) (x y : D6h), chi a (y * x * y⁻¹) = chi a x) ∧
    (∀ a b : Fin 12, (∑ x : D6h, chi a x * chi b x) = if a = b then 24 else 0) ∧
    Function.Injective chi ∧
    (∑ a : Fin 12, dim a ^ 2) = Fintype.card D6h := by
  refine ⟨?_, card_D6h, chi_isClassFun, chi_orthogonal, chi_injective, ?_⟩
  · rw [card_conjClasses_D6h, Fintype.card_fin]
  · rw [card_D6h, sum_dim_sq]
    norm_num

