open scoped BigOperators
open scoped Real
open scoped Nat
open scoped Classical
open scoped Pointwise

set_option maxHeartbeats 8000000
set_option maxRecDepth 4000
set_option synthInstance.maxHeartbeats 20000
set_option synthInstance.maxSize 128

set_option relaxedAutoImplicit false
set_option autoImplicit false

set_option grind.warning false

namespace Frontier.Spectral

open Matrix Polynomial

variable {n : ℕ} [NeZero n]

/-- The cyclic shift matrix on `ZMod n`: `shift n i j = 1` iff `i - j = 1`. -/
def shift (n : ℕ) [NeZero n] : Matrix (ZMod n) (ZMod n) ℂ :=
  Matrix.circulant (Pi.single 1 1)

/-- The graph Laplacian of the cycle graph `C n`, as the circulant matrix with `2` on the
diagonal and `-1` on the two cyclic off-diagonals. -/
def cycleLaplacian (n : ℕ) [NeZero n] : Matrix (ZMod n) (ZMod n) ℂ :=
  Matrix.circulant (fun i => if i = 0 then 2 else if i = 1 ∨ i = -1 then -1 else 0)

/-- The entries of the cycle Laplacian: `2` on the diagonal, `-1` on the two cyclic
off-diagonals, `0` elsewhere. -/
lemma cycleLaplacian_apply (i j : ZMod n) :
    cycleLaplacian n i j = if i = j then 2 else if i - j = 1 ∨ i - j = -1 then -1 else 0 := by
  simp [cycleLaplacian, Matrix.circulant_apply, sub_eq_zero]

/-- Multiplying a vector by the circulant matrix generated by `Pi.single a 1` shifts it by `a`. -/
lemma circulant_single_mulVec (a : ZMod n) (w : ZMod n → ℂ) :
    Matrix.circulant (Pi.single a (1 : ℂ)) *ᵥ w = fun i => w (i - a) := by
  funext i
  rw [Matrix.mulVec, dotProduct, Finset.sum_eq_single (i - a)]
  · rw [Matrix.circulant_apply, sub_sub_cancel, Pi.single_eq_same, one_mul]
  · intro b _ hb
    have h : i - b ≠ a := fun h => hb (by rw [← h]; ring)
    simp [Matrix.circulant_apply, h]
  · simp

lemma shift_mulVec (w : ZMod n → ℂ) : shift n *ᵥ w = fun i => w (i - 1) :=
  circulant_single_mulVec 1 w

/-- Powers of the shift matrix are again "single" circulants. -/
lemma shift_pow (k : ℕ) : shift n ^ k = Matrix.circulant (Pi.single ((k : ZMod n)) 1) := by
  induction k with
  | zero => simp
  | succ k ih =>
    rw [pow_succ, ih, shift, Matrix.circulant_mul]
    congr 1
    funext i
    rw [Matrix.mulVec, dotProduct, Finset.sum_eq_single (1 : ZMod n)]
    · rw [Matrix.circulant_apply, Pi.single_eq_same, mul_one, Pi.single_apply, Pi.single_apply]
      push_cast
      simp [sub_eq_iff_eq_add]
    · intro b _ hb; simp [Pi.single_apply, hb]
    · simp

lemma shift_pow_card : shift n ^ n = 1 := by
  rw [shift_pow]
  simp

-- If `ζ ^ n = 1` then powers of `ζ` only depend on the exponent mod `n`.
omit [NeZero n] in
lemma pow_mod_eq {ζ : ℂ} (hζ : ζ ^ n = 1) (a : ℕ) : ζ ^ (a % n) = ζ ^ a := by
  conv_rhs => rw [← Nat.div_add_mod a n, pow_add, pow_mul, hζ, one_pow, one_mul]

omit [NeZero n] in
lemma cast_pred_eq_neg_one (hn : 1 ≤ n) : ((n - 1 : ℕ) : ZMod n) = -1 := by
  have h : (((n - 1 : ℕ) : ZMod n) + 1 : ZMod n) = 0 := by
    have hc : ((n - 1 : ℕ) : ZMod n) + ((1 : ℕ) : ZMod n) = ((n - 1 + 1 : ℕ) : ZMod n) := by
      push_cast; ring
    rw [Nat.cast_one] at hc
    rw [hc, Nat.sub_add_cancel hn, ZMod.natCast_self]
  linear_combination h

/-- The cycle Laplacian is the polynomial `2 - X - X ^ (n-1)` evaluated at the shift matrix. -/
lemma cycleLaplacian_eq_aeval (hn : 3 ≤ n) :
    cycleLaplacian n = aeval (shift n) (C 2 - X - X ^ (n - 1) : ℂ[X]) := by
  have hne : Fact (1 < n) := ⟨by omega⟩
  have h1 : (1 : ZMod n) ≠ 0 := one_ne_zero
  have hm1 : (-1 : ZMod n) ≠ 0 := by simp [h1]
  have h1m : (1 : ZMod n) ≠ -1 := by
    intro h
    have h2 : ((2 : ℤ) : ZMod n) = 0 := by push_cast; linear_combination h
    have hd := (ZMod.intCast_zmod_eq_zero_iff_dvd 2 n).1 h2
    have : (n : ℤ) ≤ 2 := Int.le_of_dvd (by norm_num) hd
    omega
  have halg : (algebraMap ℂ (Matrix (ZMod n) (ZMod n) ℂ)) 2
      = Matrix.circulant (Pi.single (0 : ZMod n) (2 : ℂ)) := by
    rw [Matrix.circulant_single]
    ext i j
    simp [Matrix.algebraMap_eq_diagonal, Matrix.scalar_apply, Matrix.diagonal_apply]
  rw [map_sub, map_sub, map_pow, aeval_C, aeval_X, halg, shift_pow, cast_pred_eq_neg_one (by omega),
    shift, ← Matrix.circulant_sub, ← Matrix.circulant_sub, cycleLaplacian]
  congr 1
  funext i
  by_cases hi0 : i = 0
  · subst hi0; simp [h1.symm, hm1.symm]
  · by_cases hi1 : i = 1
    · subst hi1; simp [h1, h1m]
    · by_cases him : i = -1
      · subst him; simp [hm1, h1m.symm]
      · simp [hi0, hi1, him]

/-- The action of the cycle Laplacian on a vector: the discrete second difference. -/
lemma cycleLaplacian_mulVec (hn : 3 ≤ n) (w : ZMod n → ℂ) :
    cycleLaplacian n *ᵥ w = fun i => 2 * w i - w (i - 1) - w (i + 1) := by
  have halg : (algebraMap ℂ (Matrix (ZMod n) (ZMod n) ℂ)) 2 *ᵥ w = fun i => 2 * w i := by
    funext i
    rw [Matrix.algebraMap_eq_diagonal, Matrix.mulVec_diagonal]
    simp
  rw [cycleLaplacian_eq_aeval hn]
  rw [map_sub, map_sub, map_pow, aeval_C, aeval_X, Matrix.sub_mulVec, Matrix.sub_mulVec,
    shift_pow, cast_pred_eq_neg_one (by omega), circulant_single_mulVec, shift_mulVec, halg]
  funext i
  simp [sub_neg_eq_add]

/-- The spectrum of the shift matrix is the set of `n`-th roots of unity. -/
lemma spectrum_shift (hn : 1 < n) : spectrum ℂ (shift n) = {z : ℂ | z ^ n = 1} := by
  have hne : Fact (1 < n) := ⟨hn⟩
  ext μ
  constructor
  · intro hμ
    have h1 : μ ^ n ∈ spectrum ℂ (shift n ^ n) := spectrum.pow_mem_pow _ n hμ
    rw [shift_pow_card, spectrum.one_eq] at h1
    simpa using h1
  · intro (hz : μ ^ n = 1)
    set v : ZMod n → ℂ := fun i => μ ^ (-i).val with hv
    have hvne : v ≠ 0 := by
      intro h
      have h0 := congrFun h 0
      simp [hv] at h0
    have hmul : shift n *ᵥ v = μ • v := by
      rw [shift_mulVec]
      funext i
      have key : (-(i - 1)).val = ((-i).val + 1) % n := by
        have hi : -(i - 1) = -i + 1 := by ring
        rw [hi, ZMod.val_add, ZMod.val_one]
      show v (i - 1) = μ * v i
      simp only [hv]
      rw [key, pow_mod_eq hz, pow_succ]
      ring
    rw [← Matrix.spectrum_toLin', ← Module.End.hasEigenvalue_iff_mem_spectrum]
    refine Module.End.hasEigenvalue_of_hasEigenvector (x := v) ⟨?_, hvne⟩
    rw [Module.End.mem_eigenspace_iff, Matrix.toLin'_apply, hmul]

omit [NeZero n] in
lemma eval_at_root (hn : 1 ≤ n) {z : ℂ} (hz : z ^ n = 1) :
    eval z (C 2 - X - X ^ (n - 1) : ℂ[X]) = 2 - (z + z⁻¹) := by
  have hz0 : z ≠ 0 := by
    intro h; rw [h, zero_pow (by omega)] at hz; exact zero_ne_one hz
  have hzi : z ^ (n - 1) = z⁻¹ := by
    field_simp
    rw [← pow_succ, Nat.sub_add_cancel hn, hz]
  simp [hzi]
  ring

-- `exp (2 π I k / n) + exp (-2 π I k / n) = 2 cos (2 π k / n)`
omit [NeZero n] in
lemma root_sum_inv (k : ℕ) :
    (Complex.exp (2 * Real.pi * Complex.I / n)) ^ k
        + ((Complex.exp (2 * Real.pi * Complex.I / n)) ^ k)⁻¹
      = ((2 * Real.cos (2 * Real.pi * k / n) : ℝ) : ℂ) := by
  have hpow : (Complex.exp (2 * Real.pi * Complex.I / n)) ^ k
      = Complex.exp (((2 * Real.pi * k / n : ℝ) : ℂ) * Complex.I) := by
    rw [← Complex.exp_nat_mul]
    congr 1
    push_cast
    ring
  rw [hpow, ← Complex.exp_neg, ← neg_mul, Complex.ofReal_mul, Complex.ofReal_cos]
  push_cast
  exact (Complex.two_cos _).symm

/-- Any `n`-th root of unity `ζ` gives an eigenvector `i ↦ ζ ^ i.val` of the cycle Laplacian,
with eigenvalue `2 - (ζ + ζ⁻¹)`. -/
lemma cycleLaplacian_mulVec_root (hn : 3 ≤ n) {ζ : ℂ} (hζ : ζ ^ n = 1) :
    cycleLaplacian n *ᵥ (fun i : ZMod n => ζ ^ i.val)
      = (2 - (ζ + ζ⁻¹)) • (fun i : ZMod n => ζ ^ i.val) := by
  have hne : Fact (1 < n) := ⟨by omega⟩
  have hζ0 : ζ ≠ 0 := by
    intro h; rw [h, zero_pow (by omega)] at hζ; exact zero_ne_one hζ
  rw [cycleLaplacian_mulVec hn]
  funext i
  have hadd : ζ ^ (i + 1).val = ζ ^ i.val * ζ := by
    rw [ZMod.val_add, ZMod.val_one, pow_mod_eq hζ, pow_succ]
  have hsub : ζ ^ (i - 1).val = ζ⁻¹ * ζ ^ i.val := by
    have key : i.val = ((i - 1).val + 1) % n := by
      have hi : i = (i - 1) + 1 := by ring
      conv_lhs => rw [hi]
      rw [ZMod.val_add, ZMod.val_one]
    rw [key, pow_mod_eq hζ, pow_succ]
    field_simp
  show 2 * ζ ^ i.val - ζ ^ (i - 1).val - ζ ^ (i + 1).val = _
  rw [hadd, hsub]
  simp only [Pi.smul_apply, smul_eq_mul]
  ring

/-- The discrete Fourier vectors `v k j = exp (2 π I k j / n)` are eigenvectors of the cycle
Laplacian, with eigenvalue `2 - 2 cos (2 π k / n)`. -/
lemma cycleLaplacian_mulVec_fourier (hn : 3 ≤ n) (k : ℕ) :
    cycleLaplacian n *ᵥ (fun j : ZMod n => Complex.exp (2 * Real.pi * Complex.I * k * j.val / n)) =
      ((2 - 2 * Real.cos (2 * Real.pi * k / n) : ℝ) : ℂ) •
        (fun j : ZMod n => Complex.exp (2 * Real.pi * Complex.I * k * j.val / n)) := by
  have hn0 : n ≠ 0 := by omega
  set ξ : ℂ := Complex.exp (2 * Real.pi * Complex.I / n) with hξ
  have hξn : (ξ ^ k) ^ n = 1 := by
    rw [← pow_mul, mul_comm k n, pow_mul, hξ,
      (Complex.isPrimitiveRoot_exp n hn0).pow_eq_one, one_pow]
  have hv : (fun j : ZMod n => Complex.exp (2 * Real.pi * Complex.I * k * j.val / n))
      = fun j : ZMod n => (ξ ^ k) ^ j.val := by
    funext j
    rw [hξ, ← Complex.exp_nat_mul, ← Complex.exp_nat_mul]
    congr 1
    ring
  rw [hv, cycleLaplacian_mulVec_root hn hξn, root_sum_inv k]
  congr 1
  push_cast
  ring

/-- **Spectrum of the cycle Laplacian.** For `n ≥ 3` the eigenvalues of the graph Laplacian of
the cycle graph `C n` are exactly `2 - 2 cos (2 π k / n)` for `k = 0, …, n - 1`. -/
theorem cycle_laplacian_spectrum (n : ℕ) [NeZero n] (hn : 3 ≤ n) :
    spectrum ℂ (cycleLaplacian n) =
      (fun k : ℕ => ((2 - 2 * Real.cos (2 * Real.pi * k / n) : ℝ) : ℂ)) ''
        (Finset.range n : Set ℕ) := by
  have hn0 : n ≠ 0 := by omega
  have hshift : spectrum ℂ (shift n) = {z : ℂ | z ^ n = 1} := spectrum_shift (by omega)
  have hnonempty : (spectrum ℂ (shift n)).Nonempty := ⟨1, by rw [hshift]; simp⟩
  rw [cycleLaplacian_eq_aeval hn, spectrum.map_polynomial_aeval_of_nonempty _ _ hnonempty, hshift]
  ext x
  simp only [Set.mem_image, Set.mem_setOf_eq, Finset.coe_range, Set.mem_Iio]
  constructor
  · rintro ⟨z, hz, rfl⟩
    obtain ⟨k, hk, rfl⟩ := (Complex.isPrimitiveRoot_exp n hn0).eq_pow_of_pow_eq_one hz
    refine ⟨k, hk, ?_⟩
    rw [eval_at_root (by omega) hz, root_sum_inv k]
    push_cast
    ring
  · rintro ⟨k, hk, rfl⟩
    have hzn : (Complex.exp (2 * Real.pi * Complex.I / n) ^ k) ^ n = 1 := by
      rw [← pow_mul, mul_comm k n, pow_mul, (Complex.isPrimitiveRoot_exp n hn0).pow_eq_one,
        one_pow]
    refine ⟨Complex.exp (2 * Real.pi * Complex.I / n) ^ k, hzn, ?_⟩
    rw [eval_at_root (by omega) hzn, root_sum_inv k]
    push_cast
    ring

end Frontier.Spectral

