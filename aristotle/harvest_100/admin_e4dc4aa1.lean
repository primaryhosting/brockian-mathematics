/-!
# Voevodsky Milnor
Category: Frontier — Fields Medal Work
Target: Frontier.voevodsky_milnor
Verification: pending
Provenance: Aristotle theorem prover (Harmonic)
-/

/-!
## Overview

The Milnor conjecture, proved by Voevodsky, asserts that for a field `F` of characteristic `≠ 2`
the *norm residue map*

`k^M_n(F) = K^M_n(F)/2 ⟶ H^n(F, ℤ/2)`,  `{a₁, …, aₙ} ↦ χ_{a₁} ∪ ⋯ ∪ χ_{aₙ}`

is an isomorphism for every `n`, where `χ_a ∈ H^1(F, ℤ/2)` is the Kummer character of `a` and
`H^*(F, ℤ/2)` denotes continuous (Galois) cohomology of the absolute Galois group with trivial
`ℤ/2`-coefficients.

This file formalizes that statement (`Frontier.NormResidueIso`, `Frontier.MilnorConjecture`) in
terms of

* `Frontier.MilnorK2 F n`, mod-2 Milnor K-theory, defined by generators and relations
  (`RequestProject/MilnorK.lean`), and
* `Frontier.GaloisCohomologyMod2 F n`, continuous mod-2 cochain cohomology of `Gal(F^sep/F)`
  (`RequestProject/GaloisCohomology.lean`),

the cup product of Kummer characters being written out explicitly at the level of inhomogeneous
cochains as `Frontier.symbolCochain`.

The main theorem `Frontier.voevodsky_milnor` proves the base cases `n = 0` and `n = 1` of this
statement for every field with `2 ≠ 0`; the degree-one case is Kummer theory, i.e. the norm
residue isomorphism `F^×/(F^×)² ≅ H^1(F, ℤ/2)`.
-/

open scoped Classical

set_option maxHeartbeats 1000000
set_option synthInstance.maxHeartbeats 400000

namespace Frontier

universe u

variable {F : Type u} [Field F]

/-- The Kummer character of a unit, as a locally constant function on the absolute Galois
group. -/
noncomputable def kummerLC (a : Fˣ) : LocallyConstant (GaloisGroup F) (ZMod 2) :=
  ⟨kummerChar a, kummerChar_isLocallyConstant a⟩

/-- The inhomogeneous `n`-cochain representing the cup product
`χ_{a₁} ∪ ⋯ ∪ χ_{aₙ}` of the Kummer characters of an `n`-tuple of units. -/
noncomputable def symbolCochain {n : ℕ} (t : Fin n → Fˣ) : Cochain (GaloisGroup F) n :=
  ∏ i : Fin n, LocallyConstant.comap ⟨fun g => g i, continuous_apply i⟩ (kummerLC (t i))

theorem symbolCochain_apply {n : ℕ} (t : Fin n → Fˣ) (g : Fin n → GaloisGroup F) :
    symbolCochain t g = ∏ i : Fin n, kummerChar (t i) (g i) := by
  rw [symbolCochain]
  exact map_prod (LocallyConstant.evalRingHom g) _ Finset.univ

/-- **The Milnor conjecture in degree `n` for the field `F`** (Voevodsky's theorem): there is a
map from mod-2 Milnor K-theory to mod-2 Galois cohomology sending a symbol `{a₁, …, aₙ}` to the
cup product `χ_{a₁} ∪ ⋯ ∪ χ_{aₙ}` of the corresponding Kummer classes, and it is bijective. -/
def NormResidueIso (F : Type u) [Field F] (n : ℕ) : Prop :=
  ∃ nr : MilnorK2 F n →ₗ[ZMod 2] GaloisCohomologyMod2 F n,
    Function.Bijective nr ∧
      ∀ t : Fin n → Fˣ, ∃ h : symbolCochain t ∈ LinearMap.ker (dCochain (GaloisGroup F) n),
        nr (symbol t) = Submodule.Quotient.mk ⟨symbolCochain t, h⟩

/-- **The Milnor conjecture** (Voevodsky's theorem): for every field of characteristic different
from `2` the norm residue map `k^M_n(F) → H^n(F, ℤ/2)` is an isomorphism in every degree. -/
def MilnorConjecture : Prop :=
  ∀ (F : Type u) [Field F], (2 : F) ≠ 0 → ∀ n : ℕ, NormResidueIso F n

/-! ### The norm residue map in degrees `0` and `1` -/

/-- The constant cochain `1` is a `0`-cocycle. -/
theorem one_mem_ker_dCochain_zero :
    (1 : Cochain (GaloisGroup F) 0) ∈ LinearMap.ker (dCochain (GaloisGroup F) 0) := by
  rw [ker_dCochain_zero]; trivial

/-- The degree-zero norm residue map, at the level of cochains. -/
noncomputable def normResidueCochain₀ (F : Type u) [Field F] :
    ((Fin 0 → Fˣ) →₀ ZMod 2) →ₗ[ZMod 2] LinearMap.ker (dCochain (GaloisGroup F) 0) :=
  Finsupp.linearCombination (ZMod 2)
    (fun _ : Fin 0 → Fˣ => (⟨1, one_mem_ker_dCochain_zero⟩ :
      LinearMap.ker (dCochain (GaloisGroup F) 0)))

/-- The degree-zero norm residue map `k^M_0(F) → H^0(F, ℤ/2)`. -/
noncomputable def normResidue₀ (F : Type u) [Field F] :
    MilnorK2 F 0 →ₗ[ZMod 2] GaloisCohomologyMod2 F 0 :=
  (Submodule.mkQ _).comp
    (Submodule.liftQ _ (normResidueCochain₀ F)
      (by
        rw [milnorRelations, Submodule.span_le]
        rintro x (⟨i, -⟩ | ⟨i, -⟩) <;> exact i.elim0))

/-- The degree-one norm residue map, at the level of cochains. -/
noncomputable def normResidueCochain₁ (hF : (2 : F) ≠ 0) :
    ((Fin 1 → Fˣ) →₀ ZMod 2) →ₗ[ZMod 2] LinearMap.ker (dCochain (GaloisGroup F) 1) :=
  Finsupp.linearCombination (ZMod 2)
    (fun t : Fin 1 → Fˣ => (⟨kummerCochain (t 0), kummerCochain_mem_ker hF (t 0)⟩ :
      LinearMap.ker (dCochain (GaloisGroup F) 1)))

theorem milnorRelations_le_ker_normResidueCochain₁ (hF : (2 : F) ≠ 0) :
    milnorRelations F 1 ≤ LinearMap.ker (normResidueCochain₁ hF) := by
  rw [milnorRelations, Submodule.span_le]
  rintro x (⟨i, a, b, t, rfl⟩ | ⟨i, j, t, hij, -, rfl⟩)
  · simp only [SetLike.mem_coe, LinearMap.mem_ker, map_sub]
    have hi : i = 0 := Subsingleton.elim _ _
    subst hi
    simp only [normResidueCochain₁, Finsupp.linearCombination_single, one_smul,
      Function.update_self]
    ext g
    simp only [AddSubgroupClass.coe_sub, ZeroMemClass.coe_zero, LocallyConstant.sub_apply,
      LocallyConstant.zero_apply, kummerCochain_apply]
    rw [kummerChar_mul hF a b (g 0)]
    ring_nf
  · exact absurd (Subsingleton.elim i j) hij

/-- The degree-one norm residue map `k^M_1(F) → H^1(F, ℤ/2)`. -/
noncomputable def normResidue₁ (hF : (2 : F) ≠ 0) :
    MilnorK2 F 1 →ₗ[ZMod 2] GaloisCohomologyMod2 F 1 :=
  (Submodule.mkQ _).comp
    (Submodule.liftQ _ (normResidueCochain₁ hF) (milnorRelations_le_ker_normResidueCochain₁ hF))

/-! ### Computation of the norm residue maps on symbols -/

theorem normResidue₀_apply_symbol (t : Fin 0 → Fˣ) :
    normResidue₀ F (symbol t) = Submodule.Quotient.mk ⟨1, one_mem_ker_dCochain_zero⟩ := by
  simp [normResidue₀, symbol, normResidueCochain₀]

theorem normResidue₁_apply_symbol (hF : (2 : F) ≠ 0) (t : Fin 1 → Fˣ) :
    normResidue₁ hF (symbol t)
      = Submodule.Quotient.mk ⟨kummerCochain (t 0), kummerCochain_mem_ker hF (t 0)⟩ := by
  simp [normResidue₁, symbol, normResidueCochain₁]

/-! ### There are no coboundaries in degrees `0` and `1` -/

theorem comap_coboundaries_zero_eq_bot :
    Submodule.comap (LinearMap.ker (dCochain (GaloisGroup F) 0)).subtype
      (coboundaries (GaloisGroup F) 0) = ⊥ := by
  rw [show coboundaries (GaloisGroup F) 0 = ⊥ from rfl, Submodule.comap_bot,
    Submodule.ker_subtype]

theorem comap_coboundaries_one_eq_bot :
    Submodule.comap (LinearMap.ker (dCochain (GaloisGroup F) 1)).subtype
      (coboundaries (GaloisGroup F) 1) = ⊥ := by
  rw [coboundaries_one_eq_bot, Submodule.comap_bot, Submodule.ker_subtype]

/-! ### Bijectivity -/

theorem normResidue₀_bijective (F : Type u) [Field F] : Function.Bijective (normResidue₀ F) := by
  let t₀ : Fin 0 → Fˣ := fun i => i.elim0
  let g₀ : Fin 0 → GaloisGroup F := fun i => i.elim0
  have hsub : ∀ v : ((Fin 0 → Fˣ) →₀ ZMod 2), v = Finsupp.single t₀ (v t₀) := by
    intro v
    refine Finsupp.ext fun t => ?_
    have ht : t = t₀ := Subsingleton.elim _ _
    subst ht
    simp
  have key : ∀ c : ZMod 2, normResidue₀ F (Submodule.Quotient.mk (Finsupp.single t₀ c))
      = Submodule.Quotient.mk (c •
          (⟨1, one_mem_ker_dCochain_zero⟩ : LinearMap.ker (dCochain (GaloisGroup F) 0))) := by
    intro c
    simp [normResidue₀, normResidueCochain₀]
  constructor
  · rw [injective_iff_map_eq_zero]
    intro x hx
    induction x using Submodule.Quotient.induction_on with
    | H v =>
      have hv := hsub v
      rw [show Submodule.Quotient.mk v
          = Submodule.Quotient.mk (Finsupp.single t₀ (v t₀)) from congrArg _ hv, key] at hx
      have h2 := (Submodule.Quotient.mk_eq_zero _).1 hx
      rw [comap_coboundaries_zero_eq_bot, Submodule.mem_bot] at h2
      have h3 : v t₀ = 0 := by
        have h4 := congrArg
          (fun u : LinearMap.ker (dCochain (GaloisGroup F) 0) =>
            (u : Cochain (GaloisGroup F) 0) g₀) h2
        simpa using h4
      have hv0 : v = 0 := by
        conv_lhs => rw [hv]
        rw [h3, Finsupp.single_zero]
      rw [hv0]
      simp
  · intro z
    induction z using Submodule.Quotient.induction_on with
    | H w =>
      obtain ⟨f, hf⟩ := w
      refine ⟨Submodule.Quotient.mk (Finsupp.single t₀ (f g₀)), ?_⟩
      rw [key]
      refine congrArg _ (Subtype.ext ?_)
      ext g
      have hg : g = g₀ := Subsingleton.elim _ _
      simp [hg]

theorem normResidue₁_bijective (hF : (2 : F) ≠ 0) : Function.Bijective (normResidue₁ hF) := by
  constructor
  · rw [injective_iff_map_eq_zero]
    intro x hx
    obtain ⟨a, rfl⟩ := exists_symbol₁ x
    rw [symbol₁, normResidue₁_apply_symbol hF] at hx
    have h2 := (Submodule.Quotient.mk_eq_zero _).1 hx
    rw [comap_coboundaries_one_eq_bot, Submodule.mem_bot] at h2
    have hchar : ∀ σ : GaloisGroup F, kummerChar a σ = 0 := by
      intro σ
      have h3 := congrArg
        (fun u : LinearMap.ker (dCochain (GaloisGroup F) 1) => (u : Cochain (GaloisGroup F) 1)
          (fun _ => σ)) h2
      simpa [kummerCochain_apply] using h3
    obtain ⟨c, rfl⟩ := (kummerChar_eq_zero_iff hF a).1 hchar
    exact symbol₁_sq c
  · intro z
    induction z using Submodule.Quotient.induction_on with
    | H w =>
      obtain ⟨f, hf⟩ := w
      obtain ⟨a, ha⟩ := exists_kummerChar_eq hF f hf
      refine ⟨symbol₁ a, ?_⟩
      rw [symbol₁, normResidue₁_apply_symbol hF]
      exact congrArg _ (Subtype.ext ha)

/-! ### The norm residue maps send symbols to cup products of Kummer classes -/

theorem symbolCochain_zero (t : Fin 0 → Fˣ) :
    symbolCochain t = (1 : Cochain (GaloisGroup F) 0) := by
  simp [symbolCochain]

theorem symbolCochain_one (t : Fin 1 → Fˣ) :
    symbolCochain t = kummerCochain (t 0) := by
  ext g
  rw [symbolCochain_apply, kummerCochain_apply]
  simp

theorem normResidue₀_symbol (t : Fin 0 → Fˣ) :
    ∃ h : symbolCochain t ∈ LinearMap.ker (dCochain (GaloisGroup F) 0),
      normResidue₀ F (symbol t) = Submodule.Quotient.mk ⟨symbolCochain t, h⟩ := by
  refine ⟨by rw [symbolCochain_zero]; exact one_mem_ker_dCochain_zero, ?_⟩
  rw [normResidue₀_apply_symbol]
  exact congrArg _ (Subtype.ext (symbolCochain_zero t).symm)

theorem normResidue₁_symbol (hF : (2 : F) ≠ 0) (t : Fin 1 → Fˣ) :
    ∃ h : symbolCochain t ∈ LinearMap.ker (dCochain (GaloisGroup F) 1),
      normResidue₁ hF (symbol t) = Submodule.Quotient.mk ⟨symbolCochain t, h⟩ := by
  refine ⟨by rw [symbolCochain_one]; exact kummerCochain_mem_ker hF (t 0), ?_⟩
  rw [normResidue₁_apply_symbol hF]
  exact congrArg _ (Subtype.ext (symbolCochain_one t).symm)

/-- **The base cases of the Milnor conjecture.** For every field `F` in which `2 ≠ 0`, the norm
residue map `k^M_n(F) → H^n(F, ℤ/2)` is an isomorphism in degrees `n = 0` and `n = 1`. The
degree-one statement is Kummer theory: `F^×/(F^×)² ≅ H^1(F, ℤ/2)`. -/
theorem voevodsky_milnor (F : Type u) [Field F] (hF : (2 : F) ≠ 0) :
    NormResidueIso F 0 ∧ NormResidueIso F 1 :=
  ⟨⟨normResidue₀ F, normResidue₀_bijective F, normResidue₀_symbol⟩,
   ⟨normResidue₁ hF, normResidue₁_bijective hF, normResidue₁_symbol hF⟩⟩

end Frontier

import Mathlib

/-!
# Continuous mod-2 cohomology of a topological group, and mod-2 Galois cohomology

For a topological group `G` we define continuous cochain cohomology `H^n(G, ℤ/2)` with trivial
coefficients: `n`-cochains are the locally constant (equivalently, continuous for the discrete
topology on `ℤ/2`) functions `Gⁿ → ℤ/2`, with the usual inhomogeneous differential

`(d f)(g₀, …, gₙ) = f(g₁, …, gₙ) + Σᵢ f(g₀, …, gᵢgᵢ₊₁, …, gₙ) + f(g₀, …, gₙ₋₁)`

(the signs of the alternating sum are irrelevant modulo `2`), and `H^n` is the subquotient
`ker dⁿ / im dⁿ⁻¹`.

Applying this to the absolute Galois group `G_F = Gal(F^sep/F)` of a field `F`, equipped with the
Krull topology, gives mod-2 Galois cohomology `H^n(F, ℤ/2)`.
-/

open scoped Classical

namespace Frontier

universe u

section TopologicalGroup

variable (G : Type*) [Group G] [TopologicalSpace G] [IsTopologicalGroup G]

/-- Continuous (equivalently, locally constant) `n`-cochains of a topological group `G` with
values in the trivial module `ℤ/2`. -/
abbrev Cochain (n : ℕ) := LocallyConstant (Fin n → G) (ZMod 2)

variable {G}

/-- The face map dropping the first coordinate. -/
def faceTail (n : ℕ) : C(Fin (n + 1) → G, Fin n → G) :=
  ⟨fun g => Fin.tail g, continuous_pi fun _ => continuous_apply _⟩

/-- The face map dropping the last coordinate. -/
def faceInit (n : ℕ) : C(Fin (n + 1) → G, Fin n → G) :=
  ⟨fun g => Fin.init g, continuous_pi fun _ => continuous_apply _⟩

/-- The face map multiplying the `i`-th and the `(i+1)`-st coordinates. -/
def faceMul {n : ℕ} (i : Fin n) : C(Fin (n + 1) → G, Fin n → G) :=
  ⟨fun g j => if (j : ℕ) < (i : ℕ) then g j.castSucc
      else if (j : ℕ) = (i : ℕ) then g i.castSucc * g i.succ else g j.succ,
    continuous_pi fun j => by
      by_cases h1 : (j : ℕ) < (i : ℕ)
      · simp only [if_pos h1]; exact continuous_apply _
      · by_cases h2 : (j : ℕ) = (i : ℕ)
        · simp only [if_neg h1, if_pos h2]
          exact (continuous_apply _).mul (continuous_apply _)
        · simp only [if_neg h1, if_neg h2]; exact continuous_apply _⟩

variable (G)

/-- The differential on continuous cochains, `d : Cⁿ → Cⁿ⁺¹`. -/
noncomputable def dCochain (n : ℕ) : Cochain G n →ₗ[ZMod 2] Cochain G (n + 1) :=
  LocallyConstant.comapₗ (ZMod 2) (faceTail n) +
    (∑ i : Fin n, LocallyConstant.comapₗ (ZMod 2) (faceMul i)) +
    LocallyConstant.comapₗ (ZMod 2) (faceInit n)

/-- The submodule of continuous `n`-coboundaries. -/
noncomputable def coboundaries : (n : ℕ) → Submodule (ZMod 2) (Cochain G n)
  | 0 => ⊥
  | (n + 1) => LinearMap.range (dCochain G n)

/-- Continuous mod-2 cohomology `H^n(G, ℤ/2)` with trivial coefficients, defined as the
subquotient `ker dⁿ / im dⁿ⁻¹` of the complex of continuous cochains. -/
abbrev ContCohomologyMod2 (n : ℕ) :=
  (LinearMap.ker (dCochain G n)) ⧸
    (Submodule.comap (LinearMap.ker (dCochain G n)).subtype (coboundaries G n))

variable {G}

theorem dCochain_apply {n : ℕ} (f : Cochain G n) (g : Fin (n + 1) → G) :
    dCochain G n f g = f (Fin.tail g) + (∑ i : Fin n, f (faceMul i g)) + f (Fin.init g) := by
  have h : dCochain G n f = LocallyConstant.comapₗ (ZMod 2) (faceTail n) f
      + (∑ i : Fin n, LocallyConstant.comapₗ (ZMod 2) (faceMul i) f)
      + LocallyConstant.comapₗ (ZMod 2) (faceInit n) f := by
    simp [dCochain, LinearMap.sum_apply]
  rw [h]
  have hsum : (∑ i : Fin n, LocallyConstant.comapₗ (ZMod 2) (faceMul i) f) g
      = ∑ i : Fin n, (LocallyConstant.comapₗ (ZMod 2) (faceMul i) f) g :=
    map_sum (LocallyConstant.evalₗ (ZMod 2) g) _ Finset.univ
  simp only [LocallyConstant.add_apply, hsum]
  rfl

variable (G)

/-- In degree `0` the differential vanishes: the coefficients are trivial and `1 + 1 = 0`. -/
theorem dCochain_zero_eq_zero : dCochain G 0 = 0 := by
  ext f g
  rw [dCochain_apply]
  have h : Fin.tail g = Fin.init g := Subsingleton.elim _ _
  simp only [Finset.univ_eq_empty, Finset.sum_empty, add_zero, h]
  have : ∀ x : ZMod 2, x + x = 0 := by decide
  exact this _

/-- There are no nonzero mod-2 coboundaries in degree one (the coefficients are trivial). -/
theorem coboundaries_one_eq_bot : coboundaries G 1 = ⊥ := by
  rw [coboundaries, dCochain_zero_eq_zero, LinearMap.range_eq_bot.2 rfl]

/-- The degree-zero differential having trivial kernel condition: every `0`-cochain is a cocycle. -/
theorem ker_dCochain_zero : LinearMap.ker (dCochain G 0) = ⊤ := by
  rw [dCochain_zero_eq_zero]; exact LinearMap.ker_zero

variable {G}

/-- Degree-one cocycles are exactly the continuous homomorphisms `G → ℤ/2`. -/
theorem mem_ker_dCochain_one_iff (f : Cochain G 1) :
    f ∈ LinearMap.ker (dCochain G 1) ↔
      ∀ σ τ : G, f (fun _ => σ * τ) = f (fun _ => σ) + f (fun _ => τ) := by
  constructor
  · intro hf σ τ
    simp only [LinearMap.mem_ker] at hf
    have h2 : dCochain G 1 f ![σ, τ] = 0 := by rw [hf]; rfl
    rw [dCochain_apply] at h2
    have e1 : Fin.tail (![σ, τ] : Fin 2 → G) = fun _ => τ := by
      funext k; fin_cases k; rfl
    have e2 : Fin.init (![σ, τ] : Fin 2 → G) = fun _ => σ := by
      funext k; fin_cases k; rfl
    have e3 : faceMul (0 : Fin 1) (![σ, τ] : Fin 2 → G) = fun _ => σ * τ := by
      funext k; fin_cases k; simp [faceMul]
    rw [e1, e2] at h2
    simp only [Finset.univ_unique, Finset.sum_singleton] at h2
    rw [show (default : Fin 1) = 0 from rfl, e3] at h2
    have hchar : ∀ x y z : ZMod 2, x + y + z = 0 → y = z + x := by decide
    exact hchar _ _ _ h2
  · intro hf
    rw [LinearMap.mem_ker]
    ext g
    rw [dCochain_apply]
    have e1 : Fin.tail g = fun _ => g 1 := by funext k; fin_cases k; rfl
    have e2 : Fin.init g = fun _ => g 0 := by funext k; fin_cases k; rfl
    have e3 : faceMul (0 : Fin 1) g = fun _ => g 0 * g 1 := by
      funext k; fin_cases k; simp [faceMul]
    rw [e1, e2]
    simp only [Finset.univ_unique, Finset.sum_singleton]
    rw [show (default : Fin 1) = 0 from rfl, e3, hf (g 0) (g 1)]
    have : ∀ x y : ZMod 2, y + (x + y) + x = 0 := by decide
    exact this _ _

end TopologicalGroup

section Galois

variable (F : Type u) [Field F]

/-- The absolute Galois group `Gal(F^sep/F)` of a field `F`, with the Krull topology. -/
abbrev GaloisGroup := (SeparableClosure F) ≃ₐ[F] (SeparableClosure F)

/-- Mod-2 Galois cohomology `H^n(F, ℤ/2) = H^n(Gal(F^sep/F), ℤ/2)`, defined by continuous
cochains. -/
abbrev GaloisCohomologyMod2 (n : ℕ) := ContCohomologyMod2 (GaloisGroup F) n

end Galois

end Frontier

