import Mathlib

/-!
# Mod-2 Milnor K-theory of a field

We define, for a field `F` and `n : ℕ`, the group `k^M_n(F) = K^M_n(F)/2`, the `n`-th mod-2
Milnor K-theory group, as the quotient of the free `𝔽₂`-vector space on `n`-tuples of units of
`F` by the submodule generated by

* multiplicativity in each slot: `{…, ab, …} = {…, a, …} + {…, b, …}`, and
* the Steinberg relation: `{a₁, …, aₙ} = 0` whenever `aᵢ + aⱼ = 1` for some `i ≠ j`.

Since the coefficients are `𝔽₂`, this is exactly `K^M_n(F) ⊗ 𝔽₂ = K^M_n(F)/2`.
-/

open scoped Classical

namespace Frontier

universe u

variable (F : Type u) [Field F]

/-- The set of defining relations for mod-2 Milnor K-theory in degree `n`. -/
def MilnorRel (n : ℕ) : Set ((Fin n → Fˣ) →₀ ZMod 2) :=
  {x | ∃ (i : Fin n) (a b : Fˣ) (t : Fin n → Fˣ),
      x = Finsupp.single (Function.update t i (a * b)) 1
            - Finsupp.single (Function.update t i a) 1
            - Finsupp.single (Function.update t i b) 1} ∪
  {x | ∃ (i j : Fin n) (t : Fin n → Fˣ), i ≠ j ∧ ((t i : F) + (t j : F) = 1) ∧
      x = Finsupp.single t 1}

/-- The submodule of relations for mod-2 Milnor K-theory in degree `n`. -/
def milnorRelations (n : ℕ) : Submodule (ZMod 2) ((Fin n → Fˣ) →₀ ZMod 2) :=
  Submodule.span (ZMod 2) (MilnorRel F n)

/-- Mod-2 Milnor K-theory `k^M_n(F) = K^M_n(F)/2` of the field `F` in degree `n`. -/
abbrev MilnorK2 (n : ℕ) := ((Fin n → Fˣ) →₀ ZMod 2) ⧸ milnorRelations F n

variable {F}

/-- The symbol `{a₁, …, aₙ} ∈ k^M_n(F)` attached to an `n`-tuple of units. -/
noncomputable def symbol {n : ℕ} (t : Fin n → Fˣ) : MilnorK2 F n :=
  Submodule.Quotient.mk (Finsupp.single t 1)

/-- Multiplicativity of symbols in each slot. -/
theorem symbol_update_mul {n : ℕ} (i : Fin n) (a b : Fˣ) (t : Fin n → Fˣ) :
    symbol (F := F) (Function.update t i (a * b))
      = symbol (Function.update t i a) + symbol (Function.update t i b) := by
  have hmem : (Finsupp.single (Function.update t i (a * b)) 1
      - Finsupp.single (Function.update t i a) 1
      - Finsupp.single (Function.update t i b) (1 : ZMod 2)) ∈ milnorRelations F n :=
    Submodule.subset_span (Or.inl ⟨i, a, b, t, rfl⟩)
  have := (Submodule.Quotient.mk_eq_zero (milnorRelations F n)).2 hmem
  simp only [symbol]
  have h : (Submodule.Quotient.mk (Finsupp.single (Function.update t i (a * b)) (1 : ZMod 2))
      - Submodule.Quotient.mk (Finsupp.single (Function.update t i a) (1 : ZMod 2))
      - Submodule.Quotient.mk (Finsupp.single (Function.update t i b) (1 : ZMod 2))
      : MilnorK2 F n) = 0 := by
    rw [← Submodule.Quotient.mk_sub, ← Submodule.Quotient.mk_sub]; exact this
  linear_combination (norm := module) h

/-- The Steinberg relation. -/
theorem symbol_steinberg {n : ℕ} (i j : Fin n) (t : Fin n → Fˣ) (hij : i ≠ j)
    (h : (t i : F) + (t j : F) = 1) : symbol (F := F) t = 0 :=
  (Submodule.Quotient.mk_eq_zero _).2 (Submodule.subset_span (Or.inr ⟨i, j, t, hij, h, rfl⟩))

section Degree1

/-- The degree-one symbol `{a} ∈ k^M_1(F)`. -/
noncomputable def symbol₁ (a : Fˣ) : MilnorK2 F 1 := symbol (fun _ => a)

theorem symbol₁_mul (a b : Fˣ) : symbol₁ (F := F) (a * b) = symbol₁ a + symbol₁ b := by
  have h := symbol_update_mul (F := F) (0 : Fin 1) a b (fun _ => a)
  have e : ∀ c : Fˣ, Function.update (fun _ : Fin 1 => a) 0 c = fun _ => c := by
    intro c; funext k; fin_cases k; simp
  simpa [symbol₁, e] using h

theorem symbol₁_one : symbol₁ (F := F) 1 = 0 := by
  have := symbol₁_mul (F := F) 1 1
  simpa using this.symm

theorem add_self_eq_zero_of_mod2 {n : ℕ} (x : MilnorK2 F n) : x + x = 0 := by
  have h : ((2 : ℕ) : ZMod 2) • x = (2 : ℕ) • x := Nat.cast_smul_eq_nsmul _ _ _
  have h0 : ((2 : ℕ) : ZMod 2) = 0 := by decide
  rw [h0, zero_smul, two_nsmul] at h
  exact h.symm

theorem symbol₁_sq (a : Fˣ) : symbol₁ (F := F) (a * a) = 0 := by
  rw [symbol₁_mul]
  exact add_self_eq_zero_of_mod2 _

/-- Every element of `k^M_1(F)` is a symbol. -/
theorem exists_symbol₁ (x : MilnorK2 F 1) : ∃ a : Fˣ, x = symbol₁ a := by
  induction x using Submodule.Quotient.induction_on with
  | H v =>
    classical
    induction v using Finsupp.induction_linear with
    | zero => exact ⟨1, by rw [symbol₁_one]; simp⟩
    | add f g hf hg =>
      obtain ⟨a, ha⟩ := hf
      obtain ⟨b, hb⟩ := hg
      refine ⟨a * b, ?_⟩
      rw [symbol₁_mul, ← ha, ← hb, ← Submodule.Quotient.mk_add]
    | single t c =>
      refine ⟨if c = 0 then 1 else t 0, ?_⟩
      have h2 : c = 0 ∨ c = 1 := by
        revert c; decide
      rcases h2 with rfl | rfl
      · simp [symbol₁_one]
      · have ht : t = fun _ => t 0 := by funext k; fin_cases k; rfl
        simp only [if_neg (one_ne_zero : (1 : ZMod 2) ≠ 0)]
        rw [symbol₁, symbol, ← ht]
end Degree1

end Frontier

import RequestProject.GaloisCohomology
import RequestProject.MilnorK

/-!
# Kummer theory: the degree-one norm residue isomorphism

For a field `F` with `2 ≠ 0` we construct the Kummer character `χ_a : G_F → ℤ/2` attached to a
unit `a` of `F`: it sends `σ` to `0` or `1` according to whether `σ` fixes a chosen square root
of `a` in the separable closure. We show that `a ↦ χ_a` induces an isomorphism

`k^M_1(F) = F^×/(F^×)² ≅ H^1(F, ℤ/2)`,

which is the degree-one case of the Milnor conjecture (the norm residue isomorphism).
-/

open scoped Classical

namespace Frontier

universe u

variable {F : Type u} [Field F]

/-- A chosen square root in the separable closure of (the image of) a unit of `F`;
it is a genuine square root as soon as `2 ≠ 0` in `F`, see `sqrtSep_sq`. -/
noncomputable def sqrtSep (a : Fˣ) : SeparableClosure F :=
  if h : ∃ s : SeparableClosure F, s ^ 2 = algebraMap F (SeparableClosure F) a then h.choose else 0

theorem exists_sqrtSep (hF : (2 : F) ≠ 0) (a : Fˣ) :
    ∃ s : SeparableClosure F, s ^ 2 = algebraMap F (SeparableClosure F) a := by
  have h2 : ((2 : ℕ) : SeparableClosure F) ≠ 0 := by
    intro h
    apply hF
    have h' : algebraMap F (SeparableClosure F) 2 = 0 := by
      rw [map_ofNat]; simpa using h
    exact (map_eq_zero_iff _ (FaithfulSMul.algebraMap_injective F _)).1 h'
  haveI : NeZero ((2 : ℕ) : SeparableClosure F) := ⟨h2⟩
  exact IsSepClosed.exists_pow_nat_eq _ 2

theorem sqrtSep_sq (hF : (2 : F) ≠ 0) (a : Fˣ) :
    (sqrtSep a) ^ 2 = algebraMap F (SeparableClosure F) a := by
  rw [sqrtSep, dif_pos (exists_sqrtSep hF a)]
  exact (exists_sqrtSep hF a).choose_spec

/-- The Kummer character attached to a unit `a` of `F`. -/
noncomputable def kummerChar (a : Fˣ) (σ : GaloisGroup F) : ZMod 2 :=
  if σ (sqrtSep a) = sqrtSep a then 0 else 1

/-- Two square roots of the same element differ by a sign. -/
theorem eq_or_eq_neg_of_sq_eq_sq {L : Type*} [Field L] {s t : L} (h : s ^ 2 = t ^ 2) :
    s = t ∨ s = -t := by
  have : (s - t) * (s + t) = 0 := by ring_nf; linear_combination h
  rcases mul_eq_zero.1 this with h1 | h1
  · exact Or.inl (sub_eq_zero.1 h1)
  · exact Or.inr (by linear_combination h1)

/-- `2 ≠ 0` in the separable closure. -/
theorem two_ne_zero_sep (hF : (2 : F) ≠ 0) : (2 : SeparableClosure F) ≠ 0 := by
  intro h
  apply hF
  have h' : algebraMap F (SeparableClosure F) 2 = 0 := by rw [map_ofNat]; exact h
  exact (map_eq_zero_iff _ (FaithfulSMul.algebraMap_injective F _)).1 h'

theorem neg_ne_self_sep (hF : (2 : F) ≠ 0) {x : SeparableClosure F} (hx : x ≠ 0) : -x ≠ x := by
  intro h
  apply hx
  have h2 : (2 : SeparableClosure F) * x = 0 := by linear_combination -h
  rcases mul_eq_zero.1 h2 with h1 | h1
  · exact absurd h1 (two_ne_zero_sep hF)
  · exact h1

theorem sqrtSep_ne_zero (hF : (2 : F) ≠ 0) (a : Fˣ) : sqrtSep (F := F) a ≠ 0 := by
  intro h
  have hh := sqrtSep_sq hF a
  rw [h] at hh
  have h0 : algebraMap F (SeparableClosure F) (a : F) = 0 := by rw [← hh]; ring
  exact a.ne_zero ((map_eq_zero_iff _ (FaithfulSMul.algebraMap_injective F _)).1 h0)

/-- A Galois automorphism fixes a square root up to sign. -/
theorem map_sqrtSep (hF : (2 : F) ≠ 0) (a : Fˣ) (σ : GaloisGroup F) :
    σ (sqrtSep a) = sqrtSep a ∨ σ (sqrtSep a) = -sqrtSep a :=
  eq_or_eq_neg_of_sq_eq_sq (by rw [← map_pow, sqrtSep_sq hF, AlgEquiv.commutes])

/-- The Kummer character can be computed with any square root of `a`. -/
theorem kummerChar_eq_of_sq (hF : (2 : F) ≠ 0) (a : Fˣ) (s : SeparableClosure F)
    (hs : s ^ 2 = algebraMap F (SeparableClosure F) a) (σ : GaloisGroup F) :
    kummerChar a σ = if σ s = s then 0 else 1 := by
  have hsq : sqrtSep a ^ 2 = s ^ 2 := by rw [sqrtSep_sq hF, hs]
  rcases eq_or_eq_neg_of_sq_eq_sq hsq with h1 | h1
  · rw [kummerChar, h1]
  · simp only [kummerChar, h1, map_neg, neg_inj]

/-- The stabiliser of an element of the separable closure is open. -/
theorem isOpen_stabilizer (s : SeparableClosure F) :
    IsOpen {σ : GaloisGroup F | σ s = s} := by
  have hint : IsIntegral F s := Algebra.IsIntegral.isIntegral s
  haveI : FiniteDimensional F
      (IntermediateField.adjoin F {s} : IntermediateField F (SeparableClosure F)) :=
    IntermediateField.adjoin.finiteDimensional hint
  have hopen : IsOpen ((IntermediateField.adjoin F {s} :
      IntermediateField F (SeparableClosure F)).fixingSubgroup : Set (GaloisGroup F)) :=
    IntermediateField.fixingSubgroup_isOpen _
  have hle : (IntermediateField.adjoin F {s} :
      IntermediateField F (SeparableClosure F)).fixingSubgroup ≤
      MulAction.stabilizer (GaloisGroup F) s := by
    intro σ hσ
    exact (IntermediateField.mem_fixingSubgroup_iff _ σ).1 hσ s
      (IntermediateField.mem_adjoin_simple_self F s)
  exact Subgroup.isOpen_mono hle hopen

/-- The stabiliser of an element of the separable closure is closed. -/
theorem isClosed_stabilizer (s : SeparableClosure F) :
    IsClosed {σ : GaloisGroup F | σ s = s} :=
  Subgroup.isClosed_of_isOpen (MulAction.stabilizer (GaloisGroup F) s) (isOpen_stabilizer s)

theorem kummerChar_isLocallyConstant (a : Fˣ) : IsLocallyConstant (kummerChar (F := F) a) := by
  rw [IsLocallyConstant.iff_isOpen_fiber]
  intro y
  have hy : y = 0 ∨ y = 1 := by revert y; decide
  rcases hy with rfl | rfl
  · have h : (kummerChar (F := F) a) ⁻¹' {0}
        = {σ : GaloisGroup F | σ (sqrtSep a) = sqrtSep a} := by
      ext σ
      simp only [Set.mem_preimage, Set.mem_singleton_iff, Set.mem_setOf_eq, kummerChar]
      by_cases h : σ (sqrtSep a) = sqrtSep a <;> simp [h]
    rw [h]; exact isOpen_stabilizer _
  · have h : (kummerChar (F := F) a) ⁻¹' {1}
        = {σ : GaloisGroup F | σ (sqrtSep a) = sqrtSep a}ᶜ := by
      ext σ
      simp only [Set.mem_preimage, Set.mem_singleton_iff, Set.mem_compl_iff,
        Set.mem_setOf_eq, kummerChar]
      by_cases h : σ (sqrtSep a) = sqrtSep a <;> simp [h]
    rw [h]; exact (isClosed_stabilizer _).isOpen_compl

/-- The Kummer character as a continuous `1`-cochain. -/
noncomputable def kummerCochain (a : Fˣ) : Cochain (GaloisGroup F) 1 :=
  ⟨fun g => kummerChar a (g 0),
    (kummerChar_isLocallyConstant a).comp_continuous (continuous_apply 0)⟩

theorem kummerCochain_apply (a : Fˣ) (g : Fin 1 → GaloisGroup F) :
    kummerCochain a g = kummerChar a (g 0) := rfl

/-- The Kummer character is a homomorphism. -/
theorem kummerChar_hom (hF : (2 : F) ≠ 0) (a : Fˣ) (σ τ : GaloisGroup F) :
    kummerChar a (σ * τ) = kummerChar a σ + kummerChar a τ := by
  have hmul : (σ * τ) (sqrtSep a) = σ (τ (sqrtSep a)) := rfl
  rcases map_sqrtSep hF a σ with ha | ha <;> rcases map_sqrtSep hF a τ with hb | hb <;>
    simp only [kummerChar, hmul, hb, ha, map_neg]
  · simp
  · rw [if_neg (fun h => neg_ne_self_sep hF (sqrtSep_ne_zero hF a) (by linear_combination h))]
    simp
  · simp
  · rw [if_pos (neg_neg _)]
    simp [if_neg (neg_ne_self_sep hF (sqrtSep_ne_zero hF a))]
    decide

/-- The Kummer cochain of a unit is a `1`-cocycle. -/
theorem kummerCochain_mem_ker (hF : (2 : F) ≠ 0) (a : Fˣ) :
    kummerCochain a ∈ LinearMap.ker (dCochain (GaloisGroup F) 1) :=
  (mem_ker_dCochain_one_iff _).2 fun σ τ => kummerChar_hom hF a σ τ

/-- Multiplicativity of the Kummer character in `a`. -/
theorem kummerChar_mul (hF : (2 : F) ≠ 0) (a b : Fˣ) (σ : GaloisGroup F) :
    kummerChar (a * b) σ = kummerChar a σ + kummerChar b σ := by
  have hst : (sqrtSep (F := F) a * sqrtSep b) ^ 2
      = algebraMap F (SeparableClosure F) ((a * b : Fˣ) : F) := by
    rw [mul_pow, sqrtSep_sq hF, sqrtSep_sq hF, Units.val_mul, map_mul]
  have hne : sqrtSep (F := F) a * sqrtSep b ≠ 0 :=
    mul_ne_zero (sqrtSep_ne_zero hF a) (sqrtSep_ne_zero hF b)
  rw [kummerChar_eq_of_sq hF _ _ hst]
  rcases map_sqrtSep hF a σ with ha | ha <;> rcases map_sqrtSep hF b σ with hb | hb <;>
    simp only [kummerChar, map_mul, ha, hb]
  · simp
  · rw [if_neg (fun h => neg_ne_self_sep hF hne (by linear_combination h))]
    simp [if_neg (neg_ne_self_sep hF (sqrtSep_ne_zero hF b))]
  · rw [if_neg (fun h => neg_ne_self_sep hF hne (by linear_combination h))]
    simp [if_neg (neg_ne_self_sep hF (sqrtSep_ne_zero hF a))]
  · rw [if_pos (by rw [neg_mul_neg])]
    simp [if_neg (neg_ne_self_sep hF (sqrtSep_ne_zero hF a)),
      if_neg (neg_ne_self_sep hF (sqrtSep_ne_zero hF b))]
    decide

/-- The Kummer character of `a` is trivial exactly when `a` is a square in `F`. -/
theorem kummerChar_eq_zero_iff (hF : (2 : F) ≠ 0) (a : Fˣ) :
    (∀ σ : GaloisGroup F, kummerChar a σ = 0) ↔ ∃ c : Fˣ, a = c * c := by
  constructor
  · intro h
    have hfix : ∀ σ : GaloisGroup F, σ (sqrtSep a) = sqrtSep a := by
      intro σ
      by_contra hc
      have hz := h σ
      rw [kummerChar, if_neg hc] at hz
      exact one_ne_zero hz
    obtain ⟨c, hc⟩ : sqrtSep (F := F) a ∈ Set.range (algebraMap F (SeparableClosure F)) :=
      (InfiniteGalois.mem_range_algebraMap_iff_fixed _).2 hfix
    have hc2 : algebraMap F (SeparableClosure F) (c ^ 2)
        = algebraMap F (SeparableClosure F) a := by
      rw [map_pow, hc, sqrtSep_sq hF]
    have hc3 : c ^ 2 = (a : F) := FaithfulSMul.algebraMap_injective F _ hc2
    have hcne : c ≠ 0 := by
      intro h0
      rw [h0] at hc3
      simp at hc3
      exact a.ne_zero hc3.symm
    refine ⟨Units.mk0 c hcne, ?_⟩
    ext
    simp [← hc3]
    ring
  · rintro ⟨c, rfl⟩ σ
    have hs : (algebraMap F (SeparableClosure F) (c : F)) ^ 2
        = algebraMap F (SeparableClosure F) ((c * c : Fˣ) : F) := by
      rw [← map_pow, Units.val_mul]; ring_nf
    rw [kummerChar_eq_of_sq hF _ _ hs, if_pos (AlgEquiv.commutes σ _)]

/-- Surjectivity of the Kummer map: every continuous homomorphism `G_F → ℤ/2` is a Kummer
character. -/
theorem exists_kummerChar_eq (hF : (2 : F) ≠ 0) (f : Cochain (GaloisGroup F) 1)
    (hf : f ∈ LinearMap.ker (dCochain (GaloisGroup F) 1)) :
    ∃ a : Fˣ, kummerCochain a = f := by
  set chi : GaloisGroup F → ZMod 2 := fun σ => f (fun _ => σ) with hchi
  have hhom : ∀ σ τ, chi (σ * τ) = chi σ + chi τ := (mem_ker_dCochain_one_iff f).1 hf
  have hone : chi 1 = 0 := by
    have h := hhom 1 1
    rw [mul_one] at h
    have h2 : ∀ x : ZMod 2, x = x + x → x = 0 := by decide
    exact h2 _ h
  have hinv : ∀ σ, chi σ⁻¹ = chi σ := by
    intro σ
    have h := hhom σ σ⁻¹
    rw [mul_inv_cancel, hone] at h
    have h2 : ∀ x y : ZMod 2, 0 = x + y → y = x := by decide
    exact h2 _ _ h
  have hone_of_ne : ∀ x : ZMod 2, x ≠ 0 → x = 1 := by decide
  have hred : ∀ a : Fˣ, (∀ σ, kummerChar a σ = chi σ) → kummerCochain a = f := by
    intro a ha
    ext g
    have hg : (fun _ => g 0) = g := by funext k; fin_cases k; rfl
    rw [kummerCochain_apply, ha (g 0), hchi]
    exact congrArg f hg
  by_cases hzero : ∀ σ : GaloisGroup F, chi σ = 0
  · refine ⟨1, hred 1 ?_⟩
    intro σ
    rw [(kummerChar_eq_zero_iff hF 1).2 ⟨1, (one_mul 1).symm⟩ σ, hzero σ]
  · push_neg at hzero
    obtain ⟨σ₀, hσ₀⟩ := hzero
    have hσ₀' : chi σ₀ = 1 := hone_of_ne _ hσ₀
    let H : Subgroup (GaloisGroup F) :=
      { carrier := {σ | chi σ = 0}
        mul_mem' := by
          intro x y hx hy
          simp only [Set.mem_setOf_eq] at *
          rw [hhom, hx, hy, add_zero]
        one_mem' := hone
        inv_mem' := by
          intro x hx
          simp only [Set.mem_setOf_eq] at *
          rw [hinv, hx] }
    have hHmem : ∀ σ, σ ∈ H ↔ chi σ = 0 := fun _ => Iff.rfl
    have hopen : IsOpen (H : Set (GaloisGroup F)) := by
      have hlc : IsLocallyConstant chi :=
        f.isLocallyConstant.comp_continuous (continuous_pi fun _ => continuous_id)
      exact hlc.isOpen_fiber 0
    have hclosed : IsClosed (H : Set (GaloisGroup F)) := Subgroup.isClosed_of_isOpen H hopen
    have hfix : (IntermediateField.fixedField H).fixingSubgroup = H :=
      InfiniteGalois.fixingSubgroup_fixedField ⟨H, hclosed⟩
    have hex : ∃ x : SeparableClosure F, x ∈ IntermediateField.fixedField H ∧ σ₀ x ≠ x := by
      by_contra hc
      push_neg at hc
      have hmem : σ₀ ∈ (IntermediateField.fixedField H).fixingSubgroup :=
        (IntermediateField.mem_fixingSubgroup_iff _ _).2 fun x hx => hc x hx
      rw [hfix] at hmem
      exact hσ₀ ((hHmem σ₀).1 hmem)
    obtain ⟨x, hxE, hxne⟩ := hex
    have hxfix : ∀ h ∈ H, h x = x := (IntermediateField.mem_fixedField_iff H x).1 hxE
    set y : SeparableClosure F := x - σ₀ x with hy
    have hyne : y ≠ 0 := sub_ne_zero.2 (Ne.symm hxne)
    have hσ₀x : ∀ h ∈ H, h (σ₀ x) = σ₀ x := by
      intro h hh
      have hconj : σ₀⁻¹ * h * σ₀ ∈ H := by
        rw [hHmem] at *
        rw [hhom, hhom, hinv, hh, hσ₀']
        decide
      have hgroup : (h * σ₀) x = (σ₀ * (σ₀⁻¹ * h * σ₀)) x := by group
      calc h (σ₀ x) = (h * σ₀) x := rfl
        _ = (σ₀ * (σ₀⁻¹ * h * σ₀)) x := hgroup
        _ = σ₀ ((σ₀⁻¹ * h * σ₀) x) := rfl
        _ = σ₀ x := by rw [hxfix _ hconj]
    have hHy : ∀ h ∈ H, h y = y := by
      intro h hh
      rw [hy, map_sub, hxfix h hh, hσ₀x h hh]
    have hsq₀ : σ₀ * σ₀ ∈ H := by
      rw [hHmem, hhom, hσ₀']
      decide
    have hσ₀y : σ₀ y = -y := by
      have h1 : (σ₀ * σ₀) x = x := hxfix _ hsq₀
      have h2 : σ₀ y = σ₀ x - (σ₀ * σ₀) x := by rw [hy, map_sub]; rfl
      rw [h2, h1, hy]
      ring
    have hall : ∀ τ : GaloisGroup F, τ y = if chi τ = 0 then y else -y := by
      intro τ
      by_cases h : chi τ = 0
      · rw [if_pos h]
        exact hHy τ ((hHmem τ).2 h)
      · rw [if_neg h]
        have hτ : chi τ = 1 := hone_of_ne _ h
        have hmem : σ₀⁻¹ * τ ∈ H := by
          rw [hHmem, hhom, hinv, hσ₀', hτ]
          decide
        have hcompose : τ y = σ₀ ((σ₀⁻¹ * τ) y) := by
          have h3 : (σ₀ * (σ₀⁻¹ * τ)) y = σ₀ ((σ₀⁻¹ * τ) y) := rfl
          rw [← h3]
          congr 1
          group
        rw [hcompose, hHy _ hmem, hσ₀y]
    have hyfix : ∀ τ : GaloisGroup F, τ (y ^ 2) = y ^ 2 := by
      intro τ
      rw [map_pow, hall τ]
      by_cases h : chi τ = 0 <;> simp [h]
    obtain ⟨c, hc⟩ : y ^ 2 ∈ Set.range (algebraMap F (SeparableClosure F)) :=
      (InfiniteGalois.mem_range_algebraMap_iff_fixed _).2 hyfix
    have hcne : c ≠ 0 := by
      intro h0
      rw [h0, map_zero] at hc
      exact (pow_ne_zero 2 hyne) hc.symm
    refine ⟨Units.mk0 c hcne, hred _ ?_⟩
    intro τ
    have hroot : y ^ 2 = algebraMap F (SeparableClosure F) ((Units.mk0 c hcne : Fˣ) : F) := hc.symm
    rw [kummerChar_eq_of_sq hF _ _ hroot]
    by_cases h : chi τ = 0
    · rw [if_pos (by rw [hall τ, if_pos h]), h]
    · rw [if_neg (by rw [hall τ, if_neg h]; exact neg_ne_self_sep hF hyne),
        hone_of_ne _ h]

end Frontier

