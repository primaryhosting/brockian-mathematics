/-
A prime number with proof of primality
-/
structure BPrime where
  /-- The natural number value -/
  val : ℕ
  /-- Proof that val is prime -/
  isPrime : Nat.Prime val

instance : Coe BPrime ℕ where
  coe p := p.val

instance : DecidableEq BPrime :=
  fun p q => decidable_of_iff (p.val = q.val)
    ⟨fun h => by cases p; cases q; simp_all, fun h => by cases h; rfl⟩

/-
The prime embedding: Map each prime to the spiral at t = log p
-/
def spiralPrime (p : BPrime) : ℂ :=
  spiral (Real.log p.val)

/-
Fundamental embedding theorem: |spiralPrime(p)| = p
-/
theorem spiralPrime_norm (p : BPrime) :
    Complex.abs (spiralPrime p) = p.val := by
  unfold spiralPrime
  rw [spiral_norm]
  exact Real.exp_log (Nat.cast_pos.mpr p.isPrime.pos)

/-
The Brockian character: χ_B(n) = n^(iφ) = exp(iφ log n)
-/
def character (n : ℕ) : ℂ :=
  if n = 0 then 0 else Complex.exp (φ * I * Real.log n)

/-
χ_B(0) = 0
-/
@[simp]
theorem character_zero : character 0 = 0 := by
  unfold character
  simp

/-
χ_B(1) = 1
-/
@[simp]
theorem character_one : character 1 = 1 := by
  unfold character
  simp [Real.log_one]

/-
χ_B(n) ≠ 0 for n > 0
-/
theorem character_ne_zero {n : ℕ} (hn : n ≠ 0) : character n ≠ 0 := by
  unfold character; aesop;

/-
Complete multiplicativity χ_B(mn) = χ_B(m)χ_B(n)
-/
theorem character_multiplicative {m n : ℕ} (hm : m ≠ 0) (hn : n ≠ 0) :
    character (m * n) = character m * character n := by
      -- Using the properties of the exponential function and the logarithm, we can rewrite the right-hand side.
      have h_exp_log : Complex.exp (φ * I * (Real.log m + Real.log n)) = Complex.exp (φ * I * Real.log m) * Complex.exp (φ * I * Real.log n) := by
        rw [ ← Complex.exp_add, mul_add ];
      convert h_exp_log using 1;
      · unfold character;
        rw [ if_neg ( mul_ne_zero hm hn ), Nat.cast_mul, Real.log_mul ( by positivity ) ( by positivity ) ] ; push_cast ; ring;
      · unfold character; aesop;

/-
Unitarity |χ_B(n)| = 1 for n > 0
-/
theorem character_unitary {n : ℕ} (hn : n ≠ 0) :
    Complex.abs (character n) = 1 := by
      unfold character;
      norm_num [ hn, Complex.norm_exp ];
      norm_num [ Complex.log_im ]

/-
Character sum up to N
-/
def characterSum (N : ℕ) : ℂ :=
  ∑ n ∈ Finset.range (N + 1), character n

/-
Character sum over primes up to N
-/
def characterSumPrimes (N : ℕ) : ℂ :=
  ∑ p ∈ (Finset.range (N + 1)).filter Nat.Prime, character p

/-
The pentagonal rotation: shift by 2πik/5
-/
def pentagonalShift (k : Fin 5) (s : ℂ) : ℂ :=
  s + (2 * π * I * (k.val : ℂ)) / 5

/-
The pentagonal averaging operator: D₅-symmetric averaging
-/
def pentagonalAverage (f : ℂ → ℂ) (s : ℂ) : ℂ :=
  (1 / 5) * ∑ k : Fin 5, f (pentagonalShift k s)

/-
Pentagonal average is linear
-/
theorem pentagonal_average_linear (f g : ℂ → ℂ) (α β : ℂ) (s : ℂ) :
    pentagonalAverage (fun s => α * f s + β * g s) s =
      α * pentagonalAverage f s + β * pentagonalAverage g s := by
        -- By linearity of summation, we can split the sum into two parts.
        simp [pentagonalAverage, Finset.sum_add_distrib, mul_add, add_mul, Finset.mul_sum _ _ _, Finset.sum_mul];
        ac_rfl

/-
Pentagonal average of constant function
-/
theorem pentagonal_average_const (c : ℂ) (s : ℂ) :
    pentagonalAverage (fun _ => c) s = c := by
  unfold pentagonalAverage
  simp

/-
The five shifts form a symmetric configuration
-/
theorem pentagonalShift_add (k : Fin 5) (s t : ℂ) :
    pentagonalShift k (s + t) = pentagonalShift k s + t := by
  unfold pentagonalShift
  ring

/-
Shift by 0 is identity
-/
@[simp]
theorem pentagonalShift_zero (s : ℂ) :
    pentagonalShift 0 s = s := by
  unfold pentagonalShift
  simp

/-
Shifts have same real part
-/
theorem pentagonalShift_re (k : Fin 5) (s : ℂ) :
    (pentagonalShift k s).re = s.re := by
  unfold pentagonalShift
  simp [Complex.add_re, Complex.mul_re, Complex.div_re]

/-
The spiral term in the Euler product: p^(-s(1+iφ))
-/
def spiralTerm (p : BPrime) (s : ℂ) : ℂ :=
  Complex.exp (-s * (1 + φ * I) * Real.log p.val)

/-
The Brockian Euler factor: (1 - p^(-s(1+iφ)))^(-1)
-/
def brockianEulerFactor (p : BPrime) (s : ℂ) : ℂ :=
  (1 - spiralTerm p s)⁻¹

/-
Formal definition of Brockian zeta (product form)
-/
def brockianZeta (s : ℂ) : ℂ :=
  ∏' p : BPrime, brockianEulerFactor p s

/-
The spiral term has modulus p^(-t) for real t
-/
theorem spiralTerm_abs (p : BPrime) (t : ℝ) :
    Complex.abs (spiralTerm p t) = (p.val : ℝ) ^ (-t) := by
      unfold spiralTerm;
      norm_num [ Complex.abs_exp ];
      rw [ Real.rpow_def_of_pos ( Nat.cast_pos.mpr p.isPrime.pos ) ] ; norm_num [ Complex.log_re, Complex.log_im ] ; ring

/-
Convergence condition for the Euler product
-/
theorem brockianEuler_convergence_aux (σ : ℝ) (hσ : 1 < σ) :
    Summable fun p : BPrime => Complex.abs (spiralTerm p ⟨σ, 0⟩) := by
      have h_summable : Summable (fun p : ℕ => if Nat.Prime p then (p : ℝ) ^ (-σ) else 0) := by
        exact Summable.of_nonneg_of_le ( fun n => by positivity ) ( fun n => by split_ifs <;> first | positivity | rw [ Real.rpow_neg ( by positivity ) ] ) ( Real.summable_nat_rpow_inv.mpr hσ );
      have h_summable : Summable (fun p : BPrime => (p.val : ℝ) ^ (-σ)) := by
        convert h_summable.comp_injective ( show Function.Injective ( fun p : BPrime => p.val ) from fun p q h => by cases p; cases q; aesop ) using 1;
        exact funext fun p => by cases p; aesop;
      convert h_summable using 1;
      ext p; rw [ ← Real.exp_log ( Nat.cast_pos.mpr p.isPrime.pos ) ] ;
      unfold spiralTerm; norm_num [ Complex.norm_exp, mul_assoc, mul_comm, mul_left_comm ] ;
      norm_num [ Complex.log_re, Complex.log_im, ← Real.exp_mul ] ; ring

/-
Goldbach representation count
-/
def goldbachCount (n : ℕ) : ℕ :=
  (Finset.range n).filter (fun p => Nat.Prime p ∧ Nat.Prime (n - p)) |>.card

/-
If count ≥ 1, then Goldbach representation exists
-/
theorem goldbach_from_count {n : ℕ} (h : 1 ≤ goldbachCount n) :
    ∃ p q, Nat.Prime p ∧ Nat.Prime q ∧ p + q = n := by
      -- By definition of `goldbachCount`, if `1 ≤ goldbachCount n`, then there exists at least one prime `p` such that `n - p` is also prime.
      obtain ⟨p, hp⟩ : ∃ p ∈ Finset.range n, Nat.Prime p ∧ Nat.Prime (n - p) := by
        exact Exists.elim ( Finset.card_pos.mp h ) fun p hp => ⟨ p, Finset.mem_filter.mp hp |>.1, Finset.mem_filter.mp hp |>.2 ⟩;
      exact ⟨ p, n - p, hp.2.1, hp.2.2, Nat.add_sub_of_le ( Finset.mem_range_le hp.1 ) ⟩

/-
A spectral model predicting Goldbach counts
-/
structure GoldbachSpectralModel where
  /-- Main term prediction -/
  mainTerm : ℕ → ℝ
  /-- Error term bound -/
  errorBound : ℕ → ℝ
  /-- Error is non-negative -/
  error_nonneg : ∀ n, 0 ≤ errorBound n
  /-- Main term dominates error for large n -/
  margin_positive : ∀ n, mainTerm n ≥ errorBound n + 1

/-
Conditional Goldbach: Spectral model → Goldbach's conjecture
-/
theorem goldbach_conditional (M : GoldbachSpectralModel) (n : ℕ) (hn : Even n) (h2 : 2 < n)
    (h_correct : |(goldbachCount n : ℝ) - M.mainTerm n| ≤ M.errorBound n) :
    ∃ p q, Nat.Prime p ∧ Nat.Prime q ∧ p + q = n := by
      -- We'll use that the error bound is non-negative and the main term is at least the error bound plus one.
      have h_main_term : M.mainTerm n ≥ M.errorBound n + 1 := by
        exact M.margin_positive n;
      apply goldbach_from_count;
      exact Nat.pos_of_ne_zero fun h => by norm_num [ h ] at h_correct; linarith [ abs_le.mp h_correct ] ;

/-
Spectral density using Brockian character
-/
def brockianGoldbachDensity (n : ℕ) : ℂ :=
  ∑ p ∈ (Finset.range n).filter Nat.Prime,
    ∑ q ∈ (Finset.range n).filter Nat.Prime,
      if p + q = n then character p * conj (character q) else 0

/-
Golden phase of prime p
-/
def goldenPhase (p : BPrime) : ℝ :=
  (φ * Real.log p.val) % (2 * π)

/-
Bounded gaps between phases
-/
theorem phase_gap_bounded (p q : BPrime) (h : p.val < q.val) :
    ∃ k : ℤ, |goldenPhase q - goldenPhase p - 2 * π * (k : ℝ)| ≤ 2 * π := by
  use 0
  unfold goldenPhase
  simp only [Int.cast_zero, mul_zero, sub_zero]
  apply le_of_lt
  apply abs_sub_lt_iff.mpr
  constructor
  ·
    -- Since the modulo operation gives a result in the interval [0, 2π), the difference between two modulo operations is less than 2π.
    have h_mod_diff : ∀ x y : ℝ, x % (2 * Real.pi) - y % (2 * Real.pi) < 2 * Real.pi := by
      intro x y; rw [ sub_lt_iff_lt_add' ] ; norm_num [ EuclideanDomain.mod_eq_sub_mul_div ] ; ring_nf; norm_num [ Real.pi_pos ] ;
    exact h_mod_diff _ _
  ·
    norm_num [ EuclideanDomain.mod_eq_sub_mul_div ];
    positivity

