      -- We can apply the chain rule to find the first derivative of the spiral.
      have h_chain : deriv spiral = fun t => (1 + φ * Complex.I) * spiral t := by
        exact funext fun t => spiral_deriv t;
      simp +decide [ h_chain, pow_two, mul_assoc ]

/-
Phase wrapping modulo 2π
-/
theorem spiral_phase (t : ℝ) :
    ∃ k : ℤ, Complex.arg (spiral t) = φ * t - 2 * π * k := by
  -- By definition of arg, we know that spike_arg t = φ * t - 2 * π * k for some integer k.
  use Int.floor ((Complex.arg (spiral t) - φ * t) / (-2 * Real.pi));
  -- Let θ be the argument of the spiral at time t.
  set θ := Complex.arg (spiral t);
  -- By definition of argument, we know that $e^{i\theta} = e^{i(\varphi t + 2\pi k)}$ for some integer $k$.
  have h_arg : ∃ k : ℤ, θ = φ * t + 2 * Real.pi * k := by
    have h_arg : Complex.exp (θ * Complex.I) = Complex.exp (φ * t * Complex.I) := by
      have h_arg : Complex.exp (θ * Complex.I) = spiral t / Complex.abs (spiral t) := by
        nth_rw 1 [ ← Complex.norm_mul_exp_arg_mul_I ( spiral t ) ] ; ring;
        rw [ mul_right_comm, mul_inv_cancel₀ ( Complex.ofReal_ne_zero.mpr <| ne_of_gt <| norm_pos_iff.mpr <| spiral_ne_zero t ), one_mul, mul_comm ];
      -- Substitute the expression for the spiral into the equation.
      rw [h_arg]
      field_simp [spiral];
      unfold spiral; norm_num [ Complex.ext_iff, Complex.exp_re, Complex.exp_im ] ; ring;
      norm_num [ Complex.norm_exp, mul_comm ];
    rw [ Complex.exp_eq_exp_iff_exists_int ] at h_arg; obtain ⟨ k, hk ⟩ := h_arg; exact ⟨ k, by norm_num [ Complex.ext_iff ] at hk; linarith ⟩ ;
