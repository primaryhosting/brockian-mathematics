    spiral (t + 2 * π / φ) = spiral t * Complex.exp (2 * π / φ) := by
      unfold spiral; rw [ ← Complex.exp_add ] ; ring; norm_num [ Complex.ext_iff, Complex.exp_re, Complex.exp_im, Real.sqrt_div_self ] ; ring;
