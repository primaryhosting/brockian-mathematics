  unfold spiral
  continuity

/-
The golden differential equation γ'(t) = (1 + iφ)γ(t)
-/
theorem spiral_deriv (t : ℝ) :
    deriv spiral t = (1 + φ * I) * spiral t := by
      unfold spiral;
      convert HasDerivAt.deriv ( HasDerivAt.cexp ( HasDerivAt.mul ( hasDerivAt_id' t |> HasDerivAt.ofReal_comp ) ( hasDerivAt_const _ _ ) ) ) using 1 ; norm_num ; ring

