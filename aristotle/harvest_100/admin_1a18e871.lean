variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]

/-- The one-parameter symmetry group generated by `T` moves a point `x` with velocity `T x`
at time `0`. -/
theorem hasDerivAt_expAction (T : E →L[ℝ] E) (x : E) :
    HasDerivAt (fun t : ℝ => (NormedSpace.exp (t • T)) x) (T x) 0 := by
  have h : HasDerivAt (fun t : ℝ => NormedSpace.exp (t • T))
      (NormedSpace.exp ((0 : ℝ) • T) * T) 0 := hasDerivAt_exp_smul_const T (0 : ℝ)
  have h2 := (ContinuousLinearMap.apply ℝ E x).hasFDerivAt.comp_hasDerivAt (0 : ℝ) h
  simpa using h2

/-- Infinitesimal form of the symmetry: if the potential `V` is invariant under the
one-parameter group generated by `T`, then its gradient is orthogonal to the orbit
direction `T x` at every point `x`. -/
theorem fderiv_apply_generator_eq_zero {V : E → ℝ} (hV : Differentiable ℝ V) {T : E →L[ℝ] E}
    (hinv : ∀ (t : ℝ) (x : E), V (NormedSpace.exp (t • T) x) = V x) (x : E) :
    fderiv ℝ V x (T x) = 0 := by
  have hp : (fun t : ℝ => NormedSpace.exp (t • T) x) 0 = x := by simp
  have hVx : HasFDerivAt V (fderiv ℝ V x) ((fun t : ℝ => NormedSpace.exp (t • T) x) 0) := by
    rw [hp]; exact (hV x).hasFDerivAt
  have h1 : HasDerivAt (fun t : ℝ => V (NormedSpace.exp (t • T) x))
      (fderiv ℝ V x (T x)) 0 :=
    hVx.comp_hasDerivAt (0 : ℝ) (hasDerivAt_expAction T x)
  have h2 : HasDerivAt (fun t : ℝ => V (NormedSpace.exp (t • T) x)) 0 0 := by
    have : (fun t : ℝ => V (NormedSpace.exp (t • T) x)) = fun _ : ℝ => V x := by
      funext t; exact hinv t x
    rw [this]
    exact hasDerivAt_const 0 (V x)
  exact h1.unique h2

/-- **Goldstone's theorem** (finite-dimensional / field-theory-free core).

Let `V` be a `C²` potential on a real Banach space `E`, invariant under the continuous
one-parameter symmetry group `t ↦ exp (t • T)` generated by the bounded operator `T`.
Suppose `V` has a local minimum (a vacuum) at `v`, and that the symmetry is *spontaneously
broken* there, i.e. the vacuum is not invariant: `T v ≠ 0`.

Then the mass matrix — the second derivative (Hessian) of `V` at `v` — annihilates the
nonzero direction `T v`.  That is, there is a nonzero mode with vanishing mass:
the Goldstone boson. -/
theorem goldstone {V : E → ℝ} (hV : ContDiff ℝ 2 V) {T : E →L[ℝ] E}
    (hinv : ∀ (t : ℝ) (x : E), V (NormedSpace.exp (t • T) x) = V x)
    {v : E} (hmin : IsLocalMin V v) (hTv : T v ≠ 0) :
    ∃ u : E, u ≠ 0 ∧ ∀ y : E,
      fderiv ℝ (fderiv ℝ V) v u y = 0 ∧ fderiv ℝ (fderiv ℝ V) v y u = 0 := by
  have hVdiff : Differentiable ℝ V := hV.differentiable (by norm_num)
  -- the first derivative of `V` is differentiable, since `V` is `C²`
  have hV' : Differentiable ℝ (fderiv ℝ V) := by
    have := (hV.fderiv_right (m := 1) (by norm_num))
    exact this.differentiable (by norm_num)
  -- at the vacuum the first derivative vanishes
  have hgrad : fderiv ℝ V v = 0 := by
    have := hmin.hasFDerivAt_eq_zero (hVdiff v).hasFDerivAt
    exact this
  -- differentiate the infinitesimal invariance identity
  have hzero : ∀ y : E, fderiv ℝ (fderiv ℝ V) v y (T v) = 0 := by
    have hkey : HasFDerivAt (fun x : E => fderiv ℝ V x (T x))
        ((fderiv ℝ V v).comp T + (fderiv ℝ (fderiv ℝ V) v).flip (T v)) v :=
      HasFDerivAt.clm_apply (hV' v).hasFDerivAt (T.hasFDerivAt (x := v))
    have hconst : HasFDerivAt (fun x : E => fderiv ℝ V x (T x)) (0 : E →L[ℝ] ℝ) v := by
      have : (fun x : E => fderiv ℝ V x (T x)) = fun _ : E => (0 : ℝ) := by
        funext x
        exact fderiv_apply_generator_eq_zero hVdiff hinv x
      rw [this]
      exact hasFDerivAt_const 0 v
    have heq : (fderiv ℝ V v).comp T + (fderiv ℝ (fderiv ℝ V) v).flip (T v) = 0 :=
      hkey.unique hconst
    intro y
    have h0 : ((fderiv ℝ V v).comp T + (fderiv ℝ (fderiv ℝ V) v).flip (T v)) y = 0 := by
      rw [heq]; rfl
    simpa [hgrad] using h0
  refine ⟨T v, hTv, fun y => ⟨?_, hzero y⟩⟩
  -- symmetry of the second derivative transfers the vanishing to the other slot
  have hsymm : fderiv ℝ (fderiv ℝ V) v (T v) y = fderiv ℝ (fderiv ℝ V) v y (T v) :=
    second_derivative_symmetric (f := V) (f' := fderiv ℝ V) (f'' := fderiv ℝ (fderiv ℝ V) v)
      (fun z => (hVdiff z).hasFDerivAt) (hV' v).hasFDerivAt (T v) y
  rw [hsymm]
  exact hzero y

end Goldstone

section MexicanHat

/-! ### A concrete instance: the Mexican hat potential on `ℂ`

This shows the hypotheses of `Phys.goldstone` are consistent and non-degenerate: the
`U(1)`-invariant potential `V z = (‖z‖² - 1)²` has a circle of minima, each of which breaks
the rotation symmetry, and the corresponding tangential mode is massless. -/

/-- Multiplication in `ℂ`, viewed as a continuous ring homomorphism into the algebra of
`ℝ`-linear endomorphisms of `ℂ`.  Its image at `I` is the generator of the `U(1)` rotations. -/
noncomputable def mulCLM : ℂ →+* (ℂ →L[ℝ] ℂ) where
  toFun w := ContinuousLinearMap.mul ℝ ℂ w
  map_one' := by ext z; simp
  map_mul' a b := by ext z; simp [mul_assoc]
  map_zero' := by ext z; simp
  map_add' a b := by ext z; simp

/-- The Mexican hat (wine bottle) potential on `ℂ`. -/
noncomputable def mexicanHat : ℂ → ℝ := fun z => (‖z‖ ^ 2 - 1) ^ 2

/-- The one-parameter group generated by `mulCLM Complex.I` is multiplication by `exp (t I)`,
i.e. the group of rotations of the complex plane. -/
theorem exp_mulCLM_I (t : ℝ) (z : ℂ) :
    (NormedSpace.exp (t • mulCLM Complex.I)) z = Complex.exp (t * Complex.I) * z := by
  have h1 : t • (mulCLM Complex.I) = mulCLM (t * Complex.I) := by
    ext w; simp [mulCLM]; ring
  rw [h1, ← NormedSpace.map_exp mulCLM (ContinuousLinearMap.mul ℝ ℂ).continuous]
  simp [mulCLM, Complex.exp_eq_exp_ℂ]

/-- Goldstone's theorem applied to the Mexican hat potential: at the vacuum `z = 1` the
Hessian annihilates the (nonzero) tangential direction `I`, the massless Goldstone mode. -/
theorem goldstone_mexicanHat :
    ∃ u : ℂ, u ≠ 0 ∧ ∀ y : ℂ,
      fderiv ℝ (fderiv ℝ mexicanHat) 1 u y = 0 ∧ fderiv ℝ (fderiv ℝ mexicanHat) 1 y u = 0 := by
  have hC : ContDiff ℝ 2 mexicanHat := by
    have h : ContDiff ℝ 2 (fun z : ℂ => ‖z‖ ^ 2) := by
      simpa using (contDiff_norm_sq ℝ (E := ℂ) (n := 2))
    exact (h.sub contDiff_const).pow 2
  have hinv : ∀ (t : ℝ) (x : ℂ),
      mexicanHat (NormedSpace.exp (t • mulCLM Complex.I) x) = mexicanHat x := by
    intro t x
    rw [exp_mulCLM_I]
    simp [mexicanHat, Complex.norm_exp]
  have hmin : IsLocalMin mexicanHat 1 := by
    refine Filter.Eventually.of_forall (fun z => ?_)
    have h1 : mexicanHat 1 = 0 := by simp [mexicanHat]
    rw [h1]
    simp only [mexicanHat]
    positivity
  have hTv : (mulCLM Complex.I) 1 ≠ 0 := by simp [mulCLM]
  exact goldstone hC hinv hmin hTv

end MexicanHat

