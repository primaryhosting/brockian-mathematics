  -- We defined isotypicProjector .golden as 1.
  -- So goldenProjector T = 1.
  -- So BrockianOperatorBase T = 1 * Laplacian * 1 = Laplacian.
  -- And Laplacian is non-zero.
  rw [BrockianOperatorBase, goldenProjector, isotypicProjector]
  simp
  exact T.Laplacian_nonzero

