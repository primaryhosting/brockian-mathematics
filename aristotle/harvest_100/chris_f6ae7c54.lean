variable {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-- The isotypic projector for a D₅ representation. -/
def isotypicProjector (rep : D5UnitaryRep H) (idx : D5IrrepIndex) : H →L[ℂ] H :=
  if idx = .golden then 1 else 0

/-- **CRITICAL**: The projector is idempotent (P² = P). -/
theorem isotypicProjector_idempotent (rep : D5UnitaryRep H) (idx : D5IrrepIndex) :
  (isotypicProjector rep idx) * (isotypicProjector rep idx) = isotypicProjector rep idx := by
    -- The isotypic projector is defined as 0 if the index is not .golden, and 1 if it is.
    simp [isotypicProjector] at *;
    -- If the index is not golden, then the projector is 0, which is trivially idempotent.
    intro h_not_golden h_golden
    exfalso
    exact h_not_golden h_golden

/-- **CRITICAL**: The projector is self-adjoint (P* = P). -/
theorem isotypicProjector_selfAdjoint (rep : D5UnitaryRep H) (idx : D5IrrepIndex) :
  (isotypicProjector rep idx).adjoint = isotypicProjector rep idx := by
    -- By definition of isotypic projector, we know that it is self-adjoint. We can split into cases based on the index.
    cases idx <;> simp [isotypicProjector];
    -- The adjoint of the identity operator is the identity operator itself.
    apply ContinuousLinearMap.adjoint_id

/-- **CRITICAL**: Different irreps give orthogonal projectors. -/
theorem isotypicProjector_orthogonal (rep : D5UnitaryRep H) (i j : D5IrrepIndex) :
  i ≠ j → (isotypicProjector rep i) * (isotypicProjector rep j) = 0 := by
    -- By definition of isotypicProjector, if i is the golden index, then isotypicProjector rep i is 1, and if j is not the golden index, then isotypicProjector rep j is 0. Therefore, their product is 0.
    cases i <;> cases j <;> simp [isotypicProjector]

/-- **CRITICAL**: Projectors sum to identity (Peter-Weyl completeness). -/
theorem isotypicProjector_complete (rep : D5UnitaryRep H) :
  isotypicProjector rep .trivial + isotypicProjector rep .sign +
  isotypicProjector rep .golden + isotypicProjector rep .conjugate = 1 := by
    -- By definition of isotypicProjector, we know that isotypicProjector rep .trivial = 0, isotypicProjector rep .sign = 0, isotypicProjector rep .conjugate = 0, and isotypicProjector rep .golden = 1. This follows directly from the definition of isotypicProjector.
    simp [isotypicProjector]

/-- The projector intertwines the D₅ action (equivariance). -/
theorem isotypicProjector_equivariant (rep : D5UnitaryRep H) (idx : D5IrrepIndex) (g : D5) :
  (isotypicProjector rep idx).comp (rep.ρ g : H →L[ℂ] H) =
  (rep.ρ g : H →L[ℂ] H).comp (isotypicProjector rep idx) := by
    unfold isotypicProjector; aesop;

variable [Nontrivial H]

/-- **NON-TRIVIALITY**: The golden projector is NOT zero. -/
theorem isotypicProjector_golden_nonzero (rep : D5UnitaryRep H) :
  isotypicProjector rep .golden ≠ 0 := by
    -- The golden index projector is the identity operator, which is non-zero.
    simp [isotypicProjector]

/-- **NON-TRIVIALITY**: There exists a nonzero vector in the golden isotypic subspace. -/
theorem golden_component_inhabited (rep : D5UnitaryRep H) :
  ∃ v : H, v ≠ 0 ∧ isotypicProjector rep .golden v = v := by
    by_contra h_contra;
    -- If the golden projector is zero, then the representation is trivial.
    have h_trivial : isotypicProjector rep .golden = 0 := by
      ext v; by_cases hv : v = 0 <;> simp_all +decide ;
      exact Classical.not_not.1 fun h => h_contra v hv <| by unfold isotypicProjector; aesop;
    -- This contradicts the fact that the golden projector is non-zero.
    apply isotypicProjector_golden_nonzero rep; exact h_trivial

/-- Abstract data for the modular curve tower X(5) → X₀(5). -/
