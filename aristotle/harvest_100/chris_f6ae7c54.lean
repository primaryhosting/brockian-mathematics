    (BrockianOperator T pot).adjoint = BrockianOperator T pot := by
      apply Eq.symm; exact (by
      -- The Laplacian is self-adjoint, and the golden projector is self-adjoint, so their product is self-adjoint.
      have h_lap_self_adjoint : (T.Laplacian_full).adjoint = T.Laplacian_full := by
        -- Apply the hypothesis that the Laplacian is self-adjoint.
        apply T.Laplacian_selfAdjoint
      have h_gold_self_adjoint : (goldenProjector T).adjoint = goldenProjector T := by
        apply isotypicProjector_selfAdjoint T.D5_action .golden
