        unfold BrockianOperatorBase; aesop;
      have h_v_self_adjoint : (pot.V).adjoint = pot.V := by
        exact pot.V_selfAdjoint
      have h_brock_full_self_adjoint : (BrockianOperator T pot).adjoint = BrockianOperator T pot := by
        unfold BrockianOperator; aesop;
      exact h_brock_full_self_adjoint.symm)

