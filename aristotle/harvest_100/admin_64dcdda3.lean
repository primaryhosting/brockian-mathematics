/-!
# Steane Code
Category: Frontier Qi
Target: QI.steane_code
Verification: pending
Provenance: Aristotle theorem prover (Harmonic)
-/

/-
Formalization notes.

The 7-qubit Steane code is the CSS code built from the `[7,4,3]` Hamming code: its
stabilizer group is generated by three `X`-type generators and three `Z`-type
generators, whose supports are the rows of the Hamming parity-check matrix `H`.

A Pauli error on 7 qubits is described, up to an irrelevant global phase, by its
symplectic representation `(x, z) : Bits 7 × Bits 7`: qubit `i` carries an `X`
factor iff `x i = true` and a `Z` factor iff `z i = true` (so `x i = z i = true`
means a `Y` factor).  The error syndrome is the list of commutation relations of
the error with the stabilizer generators, which for a CSS code is exactly the pair
of Hamming syndromes `(H·x, H·z)`.

A stabilizer code corrects a set of errors precisely when the error is uniquely
determined by its syndrome (up to a stabilizer element, of which there are none of
weight `≤ 2` for the Steane code).  Accordingly, the theorem below exhibits an
explicit decoder `steaneDecode` and proves that it recovers *every* single-qubit
Pauli error `E` (arbitrary `X`, `Y`, `Z` or no error, on an arbitrary qubit) from
its syndrome, and that distinct single-qubit errors have distinct syndromes.

Everything is stated over `Bool` (the field with two elements), since the file is
required to begin with the header comment above and hence cannot carry an
`import` line.
-/

namespace QI

/-- Bit strings of length `n`, i.e. vectors over the two-element field. -/
abbrev Bits (n : Nat) := Fin n → Bool

/-- The parity-check matrix of the `[7,4,3]` Hamming code: the `q`-th column is
the binary expansion of `q + 1`. -/
def H (j : Fin 3) (q : Fin 7) : Bool := ((q.val + 1) / 2 ^ j.val) % 2 == 1

/-- The `j`-th Hamming parity check of a bit string, i.e. the mod-2 inner product
of the `j`-th row of `H` with `v`. -/
def parity (j : Fin 3) (v : Bits 7) : Bool :=
  Fin.foldr 7 (fun i acc => xor (H j i && v i) acc) false

/-- A Pauli error on 7 qubits in symplectic form `(x, z)`. -/
abbrev PauliError := Bits 7 × Bits 7

/-- The error syndrome of a Pauli error: the commutation pattern of the error with
the six stabilizer generators of the Steane code.  For a CSS code this is the pair
of Hamming syndromes of the `X`-part and of the `Z`-part. -/
def steaneSyndrome (E : PauliError) : Bits 3 × Bits 3 :=
  (fun j => parity j E.1, fun j => parity j E.2)

/-- The bit string supported on the single qubit `q`, with value `a` there. -/
def single (q : Fin 7) (a : Bool) : Bits 7 := fun i => if i = q then a else false

/-- A Pauli error acting on at most one qubit. -/
def IsSingleQubitError (E : PauliError) : Prop :=
  ∃ q : Fin 7, ∀ i : Fin 7, i ≠ q → E.1 i = false ∧ E.2 i = false

/-- Numerical value of a 3-bit Hamming syndrome. -/
def toNat (s : Bits 3) : Nat :=
  (if s 0 then 1 else 0) + (if s 1 then 2 else 0) + (if s 2 then 4 else 0)

/-- The Hamming decoder: a nonzero syndrome `s` points at the erroneous qubit
`toNat s - 1`; the zero syndrome means "no error". -/
def locate (s : Bits 3) : Bits 7 := fun i => decide (i.val + 1 = toNat s)

/-- The Steane decoder: correct the `X`-part and the `Z`-part separately, each by
Hamming decoding of the corresponding syndrome. -/
def steaneDecode (s : Bits 3 × Bits 3) : PauliError := (locate s.1, locate s.2)

/-- The `X`-type and `Z`-type stabilizer generators of the Steane code commute:
`H Hᵀ = 0` over the two-element field. -/
theorem steane_generators_commute (j k : Fin 3) :
    Fin.foldr 7 (fun i acc => xor (H j i && H k i) acc) false = false := by
  revert j k; decide

/-- A single-qubit error is determined by the qubit it acts on and its two bits. -/
theorem single_qubit_error_eq {E : PauliError} {q : Fin 7}
    (h : ∀ i : Fin 7, i ≠ q → E.1 i = false ∧ E.2 i = false) :
    E = (single q (E.1 q), single q (E.2 q)) := by
  have h1 : E.1 = single q (E.1 q) := by
    funext i
    by_cases hi : i = q
    · subst hi; simp [single]
    · simp [single, hi, (h i hi).1]
  have h2 : E.2 = single q (E.2 q) := by
    funext i
    by_cases hi : i = q
    · subst hi; simp [single]
    · simp [single, hi, (h i hi).2]
  exact Prod.ext h1 h2

/-- Key finite verification: Hamming decoding of the syndrome of a weight-`≤ 1`
error returns that error. -/
theorem locate_parity_single (q : Fin 7) (a : Bool) :
    locate (fun j => parity j (single q a)) = single q a := by
  funext i
  revert q a i
  decide

/-- The Steane decoder recovers every single-qubit Pauli error from its syndrome. -/
theorem steane_decode_syndrome (E : PauliError) (hE : IsSingleQubitError E) :
    steaneDecode (steaneSyndrome E) = E := by
  obtain ⟨q, hq⟩ := hE
  have hEq := single_qubit_error_eq hq
  rw [hEq]
  exact Prod.ext (locate_parity_single q (E.1 q)) (locate_parity_single q (E.2 q))

/--
**The 7-qubit Steane code corrects any single-qubit error.**

For Pauli errors on 7 qubits, written in symplectic form `(x, z)`:

* the explicit syndrome decoder `steaneDecode` recovers every single-qubit error
  (an arbitrary `X`, `Y`, `Z`, or no error at all, on an arbitrary one of the seven
  qubits) from its stabilizer syndrome; consequently
* distinct single-qubit errors have distinct syndromes, which is exactly the
  Knill–Laflamme correctability condition for the (nondegenerate) stabilizer code
  with respect to the set of single-qubit errors.
-/
theorem steane_code :
    (∀ E : PauliError, IsSingleQubitError E → steaneDecode (steaneSyndrome E) = E) ∧
      (∀ E F : PauliError, IsSingleQubitError E → IsSingleQubitError F →
        steaneSyndrome E = steaneSyndrome F → E = F) := by
  refine ⟨steane_decode_syndrome, ?_⟩
  intro E F hE hF hEF
  have h1 := steane_decode_syndrome E hE
  have h2 := steane_decode_syndrome F hF
  rw [← h1, ← h2, hEF]

end QI

