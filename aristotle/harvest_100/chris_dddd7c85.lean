/-
THEOREM 27: Euler's Totient Equals Active Ray Count
    This is WHY we have 4 active rays - it's Euler's φ(5)!
-/
theorem euler_totient_equals_active_rays :
    Nat.totient 5 = 4 := by
      rfl

/-
Fifth roots of unity
-/
def ω : ℂ := Complex.exp (2 * Real.pi * Complex.I / 5)

/-
THEOREM 28: Rays are Fifth Roots of Unity
-/
theorem rays_are_fifth_roots :
    ω^5 = 1 := by
      rw [ show ω = Complex.exp ( 2 * Real.pi * Complex.I / 5 ) by rfl, ← Complex.exp_nat_mul, mul_comm ] ; norm_num

/-
Prime triplet ray patterns
-/
def prime_triplet_ray_patterns : Prop :=
  ∀ p : ℕ, p.Prime → (p+2).Prime → (p+6).Prime → p > 5 →
    ((ray p = ⟨1, by decide⟩ ∧ ray (p+2) = ⟨3, by decide⟩ ∧ ray (p+6) = ⟨4, by decide⟩) ∨
     (ray p = ⟨4, by decide⟩ ∧ ray (p+2) = ⟨1, by decide⟩ ∧ ray (p+6) = ⟨2, by decide⟩))

/-
Prime quadruplet unique pattern
-/
def prime_quadruplet_ray_constraint : Prop :=
  ∀ p : ℕ, p.Prime → (p+2).Prime → (p+6).Prime → (p+8).Prime → p > 5 →
    ray p = ⟨1, by decide⟩ ∧
    ray (p+2) = ⟨3, by decide⟩ ∧
    ray (p+6) = ⟨2, by decide⟩ ∧
    ray (p+8) = ⟨4, by decide⟩

/-
Fibonacci ray equidistribution
-/
def fibonacci_ray_equidistribution : Prop :=
  ∀ j : Fin 5, #{n ∈ Finset.range pisano_period | Nat.fib n % 5 = j.val} = 4

/-
THEOREM 29: Golden Ratio in Fifth Roots
    The golden ratio appears in cos(2π/5)!
-/
theorem golden_ratio_in_cosine :
    Real.cos (2 * Real.pi / 5) = ((1 + Real.sqrt 5) / 2 - 1) / 2 := by
  rw [ show 2 * Real.pi / 5 = 2 * ( Real.pi / 5 ) by ring, Real.cos_two_mul ];
  -- Let's use the known value of $\cos(\pi/5)$.
  have h_cos_pi_5 : Real.cos (Real.pi / 5) = (1 + Real.sqrt 5) / 4 := by
    exact?;
  rw [ h_cos_pi_5 ] ; nlinarith [ Real.sq_sqrt ( show 0 ≤ 5 by norm_num ) ]

/-
Hardy-Littlewood twin prime constant (classical)
-/
noncomputable def C₂ : ℝ :=
  ∏' (p : {p : ℕ // p.Prime ∧ p > 2}), (1 - 1 / ((p : ℝ) - 1)^2)

/-
Constant for A→C transition (1→3)
-/
noncomputable def C_AC : ℝ := C₂ * ((1 + Real.sqrt 5) / 2)^2 / (1 + ((1 + Real.sqrt 5) / 2) + ((1 + Real.sqrt 5) / 2)^2)

/-
Constant for B→D transition (2→4)
-/
noncomputable def C_BD : ℝ := C₂ * ((1 + Real.sqrt 5) / 2) / (1 + ((1 + Real.sqrt 5) / 2) + ((1 + Real.sqrt 5) / 2)^2)

/-
Constant for D→A transition (4→1)
-/
noncomputable def C_DA : ℝ := C₂ * 1 / (1 + ((1 + Real.sqrt 5) / 2) + ((1 + Real.sqrt 5) / 2)^2)

/-
CONJECTURE: Constants Sum to Classical Constant
-/
def constants_sum_to_classical : Prop :=
  C_AC + C_BD + C_DA = C₂

/-
THEOREM 27: Euler's Totient Equals Active Ray Count
    This is WHY we have 4 active rays - it's Euler's φ(5)!
-/
theorem euler_totient_equals_active_rays_v2 :
    Nat.totient 5 = 4 := by rfl

/-
CONJECTURE: Golden Ratio in Constants ⭐⭐⭐⭐⭐
    The three constants stand in golden ratio proportions!
-/
def golden_ratio_in_constants : Prop :=
  C_AC / C_BD = (1 + Real.sqrt 5) / 2 ∧ C_BD / C_DA = (1 + Real.sqrt 5) / 2

/-
Full reflection operator on Fin 5
-/
def reflect_full (j : Fin 5) : Fin 5 :=
  if h : j = 0 then 0
  else
    let j_active : ActiveRay := ⟨j.val - 1, by
      have : j.val ≠ 0 := by
        intro h_eq
        apply h
        ext
        exact h_eq
      have : j.val < 5 := j.isLt
      omega⟩
    activeRayToResidue (reflect j_active)

/-
Golden Ratio
-/
noncomputable def phi : ℝ := (1 + Real.sqrt 5) / 2

/-
If golden ratio holds, explicit formulas for constants
-/
theorem explicit_constant_formulas (h : golden_ratio_in_constants) :
    C_AC = C₂ * phi^2 / (1 + phi + phi^2) ∧
    C_BD = C₂ * phi / (1 + phi + phi^2) ∧
    C_DA = C₂ * 1 / (1 + phi + phi^2) := by
  unfold phi
  unfold golden_ratio_in_constants at h
  unfold C_AC C_BD C_DA
  constructor
  · rfl
  · constructor
    · rfl
    · rfl

/-
Extended ray assignment for ALL integers (positive and negative)
-/
def rayℤ (n : ℤ) : Fin q :=
  ⟨(n % 5).natAbs, by
    have h_pos : (5 : ℤ) > 0 := by decide
    have h_nonneg : 0 ≤ n % 5 := Int.emod_nonneg n (by decide)
    have h_lt : n % 5 < 5 := Int.emod_lt_of_pos n h_pos
    have h_eq : ((n % 5).natAbs : ℤ) = n % 5 := Int.natAbs_of_nonneg h_nonneg
    rw [← h_eq] at h_lt
    exact Int.ofNat_lt.mp h_lt⟩
