noncomputable section

open scoped BigOperators Real Nat Classical Pointwise

open Nat Finset Real Complex Int

/-
The modulus q = 5 (pentagonal structure)
-/
def q : ℕ := 5

/-
Active rays (4 rays corresponding to residues coprime to 5)
-/
def ActiveRay := Fin 4

/-
Pentagonal angles for 3D visualization
-/
def pentagonalAngle (j : ActiveRay) : ℝ :=
  match j.val with
  | 0 => 90 * Real.pi / 180      -- 90° (Ray A in reindexed: residue 1)
  | 1 => 162 * Real.pi / 180     -- 162° (Ray B: residue 2)
  | 2 => 234 * Real.pi / 180     -- 234° (Ray C: residue 3)
  | 3 => 306 * Real.pi / 180     -- 306° (Ray D: residue 4)
  | _ => 0

/-
Ray assignment for natural numbers
-/
def ray (n : ℕ) : Fin q := ⟨n % q, Nat.mod_lt n (by decide)⟩

/-
Map active ray to residue class {1,2,3,4}
-/
def activeRayToResidue (j : ActiveRay) : Fin q :=
  ⟨j.val + 1, by have h := j.isLt; simp [q]; omega⟩

/-
THEOREM 1: Ray Zero Singularity
    Only prime 5 lies on ray 0; all primes > 5 avoid it
-/
theorem ray_zero_singularity (p : ℕ) (hp : p.Prime) (h_large : p > 5) :
    ray p ≠ ⟨0, by decide⟩ := by
  by_contra h_contra
  have h_div : 5 ∣ p := by
    rw [Nat.dvd_iff_mod_eq_zero]
    exact congr_arg Fin.val h_contra
  rw [Nat.dvd_prime hp] at h_div
  omega

/-
THEOREM 2: Ray Periodicity
    Ray assignment has period q = 5
-/
theorem ray_periodic (n k : ℕ) : ray (n + k * q) = ray n := by
  unfold ray
  simp [Nat.add_mod, Nat.mul_mod_right]

/-
Allowed twin prime transitions
-/
inductive AllowedTwinTransition : Fin q → Fin q → Prop
  | one_to_three : AllowedTwinTransition ⟨1, by decide⟩ ⟨3, by decide⟩
  | two_to_four  : AllowedTwinTransition ⟨2, by decide⟩ ⟨4, by decide⟩
  | four_to_one  : AllowedTwinTransition ⟨4, by decide⟩ ⟨1, by decide⟩

/-
THEOREM 3: Forbidden Transition 3→0
    If p ≡ 3 (mod 5), then p+2 ≡ 0 (mod 5), so p+2 divisible by 5
-/
theorem forbidden_transition :
    ¬∃ p : ℕ, p.Prime ∧ (p+2).Prime ∧ p > 5 ∧ ray p = ⟨3, by decide⟩ := by
      simp +zetaDelta at *;
      intro p hp hp' hp''; rw [ ray ] ; simp_all +arith +decide [ Nat.add_mod ] ; ( have := Nat.mod_lt p ( by decide : 5 > 0 ) ; interval_cases _ : p % 5 <;> simp_all +arith +decide [ ← Nat.dvd_iff_mod_eq_zero, hp.dvd_iff_eq, hp'.dvd_iff_eq ] ; );
      · unfold q; aesop;
      · exact ne_of_eq_of_ne ‹_› ( by decide );
      · have := Nat.dvd_of_mod_eq_zero ( show ( p + 2 ) % 5 = 0 by norm_num [ *, Nat.add_mod ] ) ; rw [ hp'.dvd_iff_eq ] at this <;> linarith;
      · unfold q; aesop;

/-
THEOREM 4: Twin Constraint
    Twin primes satisfy (p+2) mod 5 = (p + 2) mod 5
-/
theorem twin_constraint (p : ℕ) (hp : p.Prime) (hp2 : (p+2).Prime)
    (h_large : p > 3) :
    ray (p+2) = ⟨((ray p).val + 2) % q, Nat.mod_lt _ (by decide)⟩ := by
  exact Eq.symm (Fin.ext (by unfold ray; norm_num [Nat.add_mod]))

/-
THEOREM 5: Twins Follow Allowed Transitions
    All twin prime pairs follow exactly one of 3 patterns
-/
theorem twins_follow_allowed_transitions (p : ℕ)
    (hp : p.Prime) (hp2 : (p+2).Prime) (h_large : p > 5) :
    AllowedTwinTransition (ray p) (ray (p+2)) := by
      -- By theorem 4, we have that ray (p + 2) = ⟨((ray p).val + 2) % q, Nat.mod_lt _ (by decide)⟩
      have h_ray_add_two : ray (p + 2) = ⟨((ray p).val + 2) % q, Nat.mod_lt _ (by decide)⟩ := by
        convert twin_constraint p hp hp2 ( by linarith ) using 1;
      -- By theorem 1, we know that $ray p \neq ⟨0, by decide⟩$.
      have h_ray_p_ne_zero : ray p ≠ ⟨0, by decide⟩ := by
        exact ray_zero_singularity p hp h_large;
      -- By theorem 1, we know that $ray p \neq ⟨3, by decide⟩$.
      have h_ray_p_ne_three : ray p ≠ ⟨3, by decide⟩ := by
        exact fun h => forbidden_transition ⟨ p, hp, hp2, h_large, h ⟩;
      rcases x : ray p with ⟨ _ | _ | _ | _ | _ | n, hn ⟩ <;> simp_all +arith +decide;
      · exact AllowedTwinTransition.one_to_three;
      · exact AllowedTwinTransition.two_to_four;
      · exact AllowedTwinTransition.four_to_one;
      · cases hn.not_le ( by { exact Nat.le_add_left _ _ } )

/-
Rotation operator on active rays
-/
def rotate (j : ActiveRay) : ActiveRay :=
  ⟨(j.val + 1) % 4, Nat.mod_lt _ (by decide)⟩

/-
Inverse rotation
-/
def rotateInv (j : ActiveRay) : ActiveRay :=
  ⟨(j.val + 3) % 4, Nat.mod_lt _ (by decide)⟩

/-
Reflection operator
-/
def reflect (j : ActiveRay) : ActiveRay :=
  ⟨(4 - j.val) % 4, Nat.mod_lt _ (by decide)⟩

/-
THEOREM 6: Rotation Order 4
    Four rotations return to identity
-/
theorem rotate_order_4 (j : ActiveRay) :
    rotate (rotate (rotate (rotate j))) = j := by
      rcases j with ⟨ _ | _ | _ | _ | j, hj ⟩ <;> trivial

/-
THEOREM 7: Reflection Involution
    Reflection is self-inverse
-/
theorem reflect_involution (j : ActiveRay) :
    reflect (reflect j) = j := by
      rcases j with ⟨ _ | _ | _ | _ | j ⟩ <;> norm_cast

/-
THEOREM 8: Braid Relation
    Fundamental D₄ relation
-/
theorem reflection_rotation_braid (j : ActiveRay) :
    reflect (rotate (reflect j)) = rotate (rotate (rotate j)) := by
      rcases j with ⟨ _ | _ | _ | _ | j, hj ⟩ <;> trivial

/-
THEOREM 9: Rotation Left Inverse
-/
theorem rotate_leftInverse : Function.LeftInverse rotateInv rotate := by
  intro j
  cases j with | mk v hv =>
    apply Fin.ext
    simp [rotate, rotateInv]
    omega

/-
THEOREM 10: Rotation Right Inverse
-/
theorem rotate_rightInverse : Function.RightInverse rotateInv rotate := by
  intro j
  cases j with | mk v hv =>
    apply Fin.ext
    simp [rotate, rotateInv]
    omega

/-
THEOREM 11: Rotation Bijective
-/
theorem rotate_bijective : Function.Bijective rotate :=
  ⟨(fun a b h => (rotate_leftInverse a) ▸ (rotate_leftInverse b) ▸
     by simpa using congrArg rotateInv h),
   fun b => ⟨rotateInv b, rotate_rightInverse b⟩⟩

/-
THEOREM 12: Reflection Bijective
-/
theorem reflect_bijective : Function.Bijective reflect :=
  Function.bijective_iff_has_inverse.mpr
    ⟨reflect, reflect_involution, reflect_involution⟩

/-
THEOREM 13: Perfect Squares on Three Rays Only
    n² mod 5 ∈ {0, 1, 4} for all n
-/
theorem perfect_square_rays (n : ℕ) :
    (n^2) % 5 = 0 ∨ (n^2) % 5 = 1 ∨ (n^2) % 5 = 4 := by
  have h_cases : n % 5 = 0 ∨ n % 5 = 1 ∨ n % 5 = 2 ∨ n % 5 = 3 ∨ n % 5 = 4 := by
    have h_mod : n % 5 < 5 := Nat.mod_lt n (by decide)
    interval_cases n % 5 <;> trivial
  obtain h | h | h | h | h := h_cases <;> norm_num [Nat.pow_mod, h]

/-
THEOREM 14: Rays 2 and 3 Forbidden for Squares
-/
theorem perfect_square_forbidden_rays (n : ℕ) :
    (n^2) % 5 ≠ 2 ∧ (n^2) % 5 ≠ 3 := by
  have h := perfect_square_rays n
  omega

/-
THEOREM 15: Fibonacci Squares Constrained
-/
theorem fibonacci_square_ray_constraint (n : ℕ) (h_fib_square : ∃ k, Nat.fib k = n^2) :
    ray (n^2) = ⟨0, by decide⟩ ∨
    ray (n^2) = ⟨1, by decide⟩ ∨
    ray (n^2) = ⟨4, by decide⟩ := by
      -- By definition of $ray$, we know that $(n^2) \% 5$ must be $0$, $1$, or $4$.
      have h_mod : (n ^ 2) % 5 = 0 ∨ (n ^ 2) % 5 = 1 ∨ (n ^ 2) % 5 = 4 := by
        rw [ Nat.pow_mod ] ; have := Nat.mod_lt n ( by decide : 5 > 0 ) ; interval_cases n % 5 <;> trivial;
      unfold ray; aesop;

/-
Allowed sexy prime transitions
-/
inductive AllowedSexyTransition : Fin q → Fin q → Prop
  | one_to_two   : AllowedSexyTransition ⟨1, by decide⟩ ⟨2, by decide⟩
  | two_to_three : AllowedSexyTransition ⟨2, by decide⟩ ⟨3, by decide⟩
  | three_to_four : AllowedSexyTransition ⟨3, by decide⟩ ⟨4, by decide⟩

/-
THEOREM 16: Ray 4 Forbidden for Sexy Primes
    If p ≡ 4 (mod 5), then p+6 ≡ 0 (mod 5)
-/
theorem sexy_primes_not_ray_4 (p : ℕ) (hp : p.Prime) (hp6 : (p+6).Prime)
    (h_large : p > 5) :
    ray p ≠ ⟨4, by decide⟩ := by
  have h_mod_5 : p % 5 ≠ 4 := by
    by_contra h_contra
    have h_div : 5 ∣ (p + 6) := by
      norm_num [Nat.dvd_iff_mod_eq_zero, Nat.add_mod, h_contra]
    simp_all [Nat.Prime.dvd_iff_eq hp6]
  simp [ray, h_mod_5]
  convert h_mod_5 using 1

/-
THEOREM 17: Sexy Primes Follow Sequential Transitions
-/
theorem sexy_primes_follow_allowed_transitions (p : ℕ)
    (hp : p.Prime) (hp6 : (p+6).Prime) (h_large : p > 5) :
    AllowedSexyTransition (ray p) (ray (p+6)) := by
      -- By definition of $ray$, we know that $p \equiv ray p \mod 5$ and $p + 6 \equiv ray (p + 6) \mod 5$.
      have h_mod : (p % 5 = (ray p).val) ∧ ((p + 6) % 5 = (ray (p + 6)).val) := by
        exact ⟨ rfl, rfl ⟩;
      -- By examining all possible values of $p \mod 5$, we can see that the only valid transitions are $1 \to 2$, $2 \to 3$, and $3 \to 4$.
      have h_cases : (ray p).val = 1 ∨ (ray p).val = 2 ∨ (ray p).val = 3 := by
        have := Nat.mod_lt p ( by decide : 5 > 0 ) ; interval_cases _ : p % 5 <;> simp_all +decide [ ← Nat.dvd_iff_mod_eq_zero, hp.dvd_iff_eq, hp6.dvd_iff_eq ] ;
        · exact absurd ( Nat.dvd_of_mod_eq_zero ( show p % 5 = 0 by linarith ) ) ( by rw [ hp.dvd_iff_eq ] <;> linarith );
        · exact absurd ( Nat.dvd_of_mod_eq_zero ( show ( p + 6 ) % 5 = 0 from by omega ) ) ( by rw [ hp6.dvd_iff_eq ] <;> linarith );
      rcases h_cases with ( h | h | h ) <;> simp_all +decide [ Nat.add_mod ];
      · convert AllowedSexyTransition.one_to_two;
        exact h_mod.2.symm.trans ( by norm_num [ h_mod.1 ] );
      · convert AllowedSexyTransition.two_to_three;
        exact h_mod.2.symm.trans ( by simp +decide [ h_mod.1 ] );
      · convert AllowedSexyTransition.three_to_four;
        exact h_mod.2.symm.trans ( by norm_num [ h_mod.1 ] )

/-
Pisano period for mod 5
-/
def pisano_period : ℕ := 20

/-
THEOREM 18: Fibonacci Pisano Period 20
-/
theorem fibonacci_pisano_period :
    ∀ n : ℕ, Nat.fib (n + pisano_period) % 5 = Nat.fib n % 5 := by
  have h_pisano : ∀ n, Nat.fib (n + 20) % 5 = Nat.fib n % 5 := by
    intro n
    have h_fib_mod : ∀ n, Nat.fib n % 5 = Nat.fib (n % 20) % 5 := by
      intro n
      rw [← Nat.mod_add_div n 20]
      norm_num [Nat.fib_add, Nat.mul_mod, Nat.add_mod]
      have h_periodic : ∀ n, Nat.fib (n + 20) % 5 = Nat.fib n % 5 := by
        norm_num [Nat.fib_add, Nat.add_mod, Nat.mul_mod]
      exact Nat.recOn (n / 20) rfl fun k hk => by rw [Nat.mul_succ, ← add_assoc, h_periodic, hk]
    simp [h_fib_mod]
  assumption

/-
Valid Goldbach ray pairs for even n
-/
def validGoldbachRayPairs_corrected (n_mod_5 : Fin 5) : Finset (Fin 5 × Fin 5) :=
  match n_mod_5.val with
  | 0 => {(1,4), (2,3), (3,2), (4,1)}
  | 1 => {(2,4), (3,3), (4,2)}
  | 2 => {(1,1), (3,4), (4,3)}
  | 3 => {(1,2), (2,1), (4,4)}
  | 4 => {(1,3), (2,2), (3,1)}
  | _ => ∅

/-
THEOREM 19: Goldbach Ray Constraint
-/
theorem goldbach_ray_constraint (n p p2 : ℕ)
    (hn_even : n % 2 = 0) (hn_large : n > 2)
    (hp : p.Prime) (hq : p2.Prime) (h_sum : p + p2 = n) :
    ((ray p, ray p2) : Fin 5 × Fin 5) ∈ validGoldbachRayPairs_corrected (ray n) ∨
    p = 5 ∨ p2 = 5 := by
  by_cases hp5 : p = 5
  · right; left; exact hp5
  · by_cases hq5 : p2 = 5
    · right; right; exact hq5
    · left
      have h_residues : (p % 5 = 1 ∨ p % 5 = 2 ∨ p % 5 = 3 ∨ p % 5 = 4) ∧ 
                        (p2 % 5 = 1 ∨ p2 % 5 = 2 ∨ p2 % 5 = 3 ∨ p2 % 5 = 4) := by
        constructor
        · have := Nat.mod_lt p (by decide : 5 > 0)
          interval_cases _ : p % 5 <;> simp_all [← Nat.dvd_iff_mod_eq_zero, hp.dvd_iff_eq]
        · have := Nat.mod_lt p2 (by decide : 5 > 0)
          interval_cases _ : p2 % 5 <;> simp_all [← Nat.dvd_iff_mod_eq_zero, hq.dvd_iff_eq]
      unfold ray validGoldbachRayPairs_corrected
      simp_all [Nat.add_mod]
      unfold q
      norm_num [Nat.add_mod, h_sum.symm]
      rcases h_residues with ⟨hp | hp | hp | hp, hq | hq | hq | hq⟩ <;> simp [*]

/-
THEOREM 20: Framework Completeness - Primes on Unique Rays
-/
theorem framework_completeness_primes :
    ∀ p : ℕ, p.Prime → p > 5 →
      ∃! j : ActiveRay, ray p = activeRayToResidue j := by
        intro p hp hp_gt
        obtain ⟨j, hj⟩ : ∃ j : Fin q, ray p = j := by
          exact ⟨ _, rfl ⟩;
        -- Since $j$ is a residue modulo 5 and $p > 5$, $j$ must be one of $\{1, 2, 3, 4\}$.
        have hj_range : j.val ∈ ({1, 2, 3, 4} : Finset ℕ) := by
          have := Nat.mod_lt p ( by decide : 5 > 0 ) ; interval_cases _ : ( p % 5 : ℕ ) <;> simp_all +decide [ ray ] ;
          · exact absurd ( Nat.dvd_of_mod_eq_zero ‹_› ) ( by rw [ hp.dvd_iff_eq ] <;> linarith );
          · exact Or.inl ( by erw [ ← hj ] ; exact ‹p % 5 = 1› );
          · exact Or.inr <| Or.inl <| by subst hj; exact ‹p % 5 = 2›;
          · aesop;
          · exact hj ▸ by aesop;
        use ⟨j.val - 1, by
          grind⟩
        generalize_proofs at *;
        unfold activeRayToResidue; aesop;

/-
THEOREM 21: Framework Completeness - Each Ray Has Primes
-/
theorem framework_completeness_rays :
    ∀ j : ActiveRay, ∃ p : ℕ, p.Prime ∧ ray p = activeRayToResidue j := by
      intro j;
      -- By Dirichlet's theorem on arithmetic progressions, there are infinitely many primes in each of these progressions. So for each j, we can find a prime p such that p ≡ j+1 mod 5.
      have h_dirichlet : ∀ j : Fin 4, ∃ p : ℕ, Nat.Prime p ∧ p % 5 = j.val + 1 := by
        intro j;
        fin_cases j <;> [ exact ⟨ 11, by norm_num ⟩ ; exact ⟨ 7, by norm_num ⟩ ; exact ⟨ 3, by norm_num ⟩ ; exact ⟨ 19, by norm_num ⟩ ];
      obtain ⟨ p, hp₁, hp₂ ⟩ := h_dirichlet j; use p; unfold ray activeRayToResidue; aesop;

