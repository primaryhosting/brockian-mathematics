namespace Brockian.BetrothedNumbers

open ArithmeticFunction

/-- Two distinct positive naturals `m ≠ n` form a *betrothed* (quasi-amicable) pair when
each one's sum of divisors equals `m + n + 1`; equivalently, the sum of the divisors of
each, excluding `1` and the number itself, equals the other number. -/
def IsBetrothedPair (m n : ℕ) : Prop :=
  0 < m ∧ 0 < n ∧ m ≠ n ∧ sigma 1 m = m + n + 1 ∧ sigma 1 n = m + n + 1

/-- `σ(2 ^ k) = 2 ^ (k + 1) - 1`. -/
theorem sigma_one_two_pow (k : ℕ) : sigma 1 (2 ^ k) = 2 ^ (k + 1) - 1 := by
  rw [sigma_one_apply, Nat.sum_divisors_prime_pow Nat.prime_two]
  simp [Nat.geomSum_eq]

/-- `σ(p) = p + 1` for a prime `p`. -/
theorem sigma_one_prime {p : ℕ} (hp : p.Prime) : sigma 1 p = p + 1 := by
  rw [sigma_one_apply, hp.divisors, Finset.sum_pair hp.one_lt.ne, add_comm]

/-- `σ(2 ^ k * p) = (2 ^ (k + 1) - 1) * (p + 1)` for an odd prime `p`. -/
theorem sigma_one_two_pow_mul_prime {k p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) :
    sigma 1 (2 ^ k * p) = (2 ^ (k + 1) - 1) * (p + 1) := by
  have hcop : Nat.Coprime (2 ^ k) p :=
    Nat.Coprime.pow_left _ ((Nat.coprime_primes Nat.prime_two hp).mpr fun h => hp2 h.symm)
  rw [isMultiplicative_sigma.map_mul_of_coprime hcop, sigma_one_two_pow, sigma_one_prime hp]

/-- **The `σ`-criterion generating betrothed pairs of the shape `(m, 2 ^ k * p)`.**
If `p` is an odd prime, `m` is a positive number distinct from `2 ^ k * p` whose divisor sum
is `m + 2 ^ k * p + 1`, and the multiplicative value `σ(2 ^ k) · σ(p) = (2 ^ (k+1) - 1)(p + 1)`
also equals `m + 2 ^ k * p + 1`, then `(m, 2 ^ k * p)` is a betrothed pair. -/
theorem betrothed_of_sigma_criterion {k p m : ℕ} (hp : p.Prime) (hp2 : p ≠ 2)
    (hm : 0 < m) (hne : m ≠ 2 ^ k * p) (hsigma_m : sigma 1 m = m + 2 ^ k * p + 1)
    (hcrit : (2 ^ (k + 1) - 1) * (p + 1) = m + 2 ^ k * p + 1) :
    IsBetrothedPair m (2 ^ k * p) := by
  refine ⟨hm, ?_, hne, hsigma_m, ?_⟩
  · exact Nat.mul_pos (Nat.two_pow_pos k) hp.pos
  · rw [sigma_one_two_pow_mul_prime hp hp2, hcrit]

set_option maxRecDepth 100000 in
/-- Kernel-verified divisor sum: `σ(5775) = 11904`. -/
theorem sigma_one_5775 : sigma 1 5775 = 11904 := by
  rw [sigma_one_apply]
  decide +kernel

set_option maxRecDepth 100000 in
/-- Kernel-verified divisor sum: `σ(6128) = 11904`. -/
theorem sigma_one_6128 : sigma 1 6128 = 11904 := by
  rw [sigma_one_apply]
  decide +kernel

/-- **`(5775, 6128)` is a betrothed pair**, verified by kernel computation of both divisor
sums: `σ(5775) = σ(6128) = 11904 = 5775 + 6128 + 1`. -/
theorem betrothed_5775_6128 : IsBetrothedPair 5775 6128 := by
  refine ⟨by norm_num, by norm_num, by norm_num, ?_, ?_⟩
  · rw [sigma_one_5775]
  · rw [sigma_one_6128]

/-- `383` is prime. -/
theorem prime_383 : Nat.Prime 383 := by norm_num

/-- The pair `(5775, 6128)` is generated by the `σ`-criterion with `k = 4`, `p = 383`:
indeed `383` is an odd prime, `2 ^ 4 * 383 = 6128`, and
`σ(2 ^ 4) · σ(383) = 31 * 384 = 11904 = 5775 + 6128 + 1 = σ(5775)`. -/
theorem betrothed_5775_6128_of_criterion : IsBetrothedPair 5775 (2 ^ 4 * 383) := by
  refine betrothed_of_sigma_criterion prime_383 (by norm_num) (by norm_num) (by norm_num)
    ?_ (by norm_num)
  rw [sigma_one_5775]
  norm_num

/-- Summary of the `k = 4`, `p = 383` generation data for the betrothed pair `(5775, 6128)`. -/
theorem betrothed_5775_6128_criterion_data :
    Nat.Prime 383 ∧ (383 : ℕ) ≠ 2 ∧ 2 ^ 4 * 383 = 6128 ∧
      sigma 1 (2 ^ 4) * sigma 1 383 = 5775 + 6128 + 1 ∧
      IsBetrothedPair 5775 (2 ^ 4 * 383) := by
  refine ⟨prime_383, by norm_num, by norm_num, ?_, betrothed_5775_6128_of_criterion⟩
  rw [sigma_one_two_pow, sigma_one_prime prime_383]
  norm_num

end Brockian.BetrothedNumbers

