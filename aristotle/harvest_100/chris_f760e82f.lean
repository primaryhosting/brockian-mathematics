      have h_inner : ∀ k : D5, ∑ g : D5, starRingEnd ℂ (χ_elem .golden g) * χ_elem .trivial (g⁻¹ * k) = 0 := by
        convert golden_trivial_convolution using 1;
        -- Since $\chi_{\text{trivial}}(g) = 1$ for all $g$, we can simplify the expression.
        have h_trivial : ∀ g : D5, χ_elem .trivial g = 1 := by
          intro g
          simp [χ_elem];
          rcases g with ⟨ _ | _ | _ | _ | _ | _ | _ | _ | _ | _ | g ⟩ <;> trivial;
        simp_all +decide [ Complex.ext_iff ];
      ext x;
      have h_sum : ∑ g : D5, starRingEnd ℂ (χ_elem .golden g) • (∑ h : D5, χ_elem .trivial (h⁻¹ * g) • (ρ.toCLM h) x) = 0 := by
        have h_sum : ∑ g : D5, starRingEnd ℂ (χ_elem .golden g) • (∑ h : D5, χ_elem .trivial (g⁻¹ * h) • (ρ.toCLM h) x) = ∑ h : D5, (∑ g : D5, starRingEnd ℂ (χ_elem .golden g) * χ_elem .trivial (g⁻¹ * h)) • (ρ.toCLM h) x := by
          simp +decide only [smul_sum, sum_smul];
          exact Finset.sum_comm.trans ( Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => by simp +decide [ mul_assoc, MulAction.mul_smul ] );
        simp_all +decide [ mul_comm ];
        convert h_sum using 1;
      have h_sum : ∑ g : D5, starRingEnd ℂ (χ_elem .golden g) • (∑ h : D5, χ_elem .trivial h • (ρ.toCLM (h * g)) x) = 0 := by
        convert h_sum using 3;
        conv_rhs => rw [ ← Equiv.sum_comp ( Equiv.mulRight ‹_› ) ] ;
        congr! 2;
        rename_i g _ h _; fin_cases g <;> fin_cases h <;> rfl;
      convert congr_arg ( fun y => ( ( D5IrrepIndex.golden.dim / 10 : ℂ ) * ( D5IrrepIndex.trivial.dim / 10 : ℂ ) ) • y ) h_sum using 1;
      · simp +decide [ P_golden, P_trivial, Finset.smul_sum, Finset.sum_smul, mul_assoc, mul_left_comm, Finset.mul_sum _ _ _, Finset.sum_mul ];
        simp +decide [ isotypicProjector, Finset.smul_sum, Finset.sum_smul, MulAction.mul_smul ];
        refine' Finset.sum_comm.trans ( Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => _ );
        rw [ show χ_elem D5IrrepIndex.trivial _ = 1 from ?_ ] ; norm_num ; ring;
        · rw [ show ρ.toCLM ( _ * _ ) = ρ.toCLM _ ∘L ρ.toCLM _ from ?_ ];
          exact?;
          ext; simp +decide [ ρ.map_mul' ] ;
          exact congr_arg ( fun f => f ‹_› ) ( ρ.map_mul' _ _ );
        · rename_i k hk;
          fin_cases k <;> rfl;
      · simp +decide [ Algebra.smul_def ]

/-
All irreducible characters of D5 are real-valued.
-/
lemma χ_real (idx : D5IrrepIndex) (g : D5) : starRingEnd ℂ (χ_elem idx g) = χ_elem idx g := by
  unfold χ_elem
  cases idx <;> cases toConjClass g <;> simp [χ_val, Complex.ext_iff]
  all_goals {
    try norm_num
    try rw [Complex.conj_ofReal]
  }

/-
All isotypic projectors are self-adjoint.
-/
theorem isotypicProjector_selfAdjoint (ρ : UnitaryRep H) (idx : D5IrrepIndex) :
    IsSelfAdjoint (isotypicProjector ρ idx) := by
      -- Apply the definition of IsSelfAdjoint and use the properties of the characters and the representations.
      simp [IsSelfAdjoint, isotypicProjector];
      have h_star : ∀ g : D5, star (ρ.toCLM g) = ρ.toCLM g⁻¹ := by
        exact?;
      -- Since the characters are real, the star of the character is just the character itself.
      have h_char_real : ∀ g : D5, starRingEnd ℂ (χ_elem idx g) = χ_elem idx g := by
        exact?;
      rw [ ← Equiv.sum_comp ( Equiv.inv ( D5 ) ) ] ; aesop;

/-
The sign character is a homomorphism.
-/
lemma sign_is_hom (g h : D5) :
    χ_elem .sign (g * h) = χ_elem .sign g * χ_elem .sign h := by
      induction' g using DihedralGroup.rec with n m;
      · unfold χ_elem;
        unfold toConjClass;
        fin_cases n <;> induction h <;> simp +decide;
        all_goals simp +decide [ χ_val ];
        · rename_i k; fin_cases k <;> rfl;
        · rename_i k;
          fin_cases k <;> rfl;
        · rename_i k; fin_cases k <;> rfl;
        · rename_i k; fin_cases k <;> rfl;
      · induction' h using DihedralGroup.rec with n m;
        · unfold χ_elem;
          fin_cases m <;> fin_cases n <;> simp +decide [ toConjClass ];
          all_goals norm_num [ χ_val ] ;
        · unfold χ_elem;
          unfold χ_val;
          unfold toConjClass; simp +decide [ DihedralGroup.sr ];
          rename_i k; fin_cases k <;> fin_cases m <;> trivial;

/-
The convolution of an irreducible character with itself is equal to (|G|/dim) times the character.
-/
lemma char_convolution_self (idx : D5IrrepIndex) (k : D5) :
    ∑ g : D5, χ_elem idx g * χ_elem idx (g⁻¹ * k) = (10 / (idx.dim : ℂ)) * χ_elem idx k := by
      fin_cases idx <;> unfold χ_elem <;> norm_cast;
      · repeat' erw [ Finset.sum_eq_card_nsmul ] <;> norm_num;
        any_goals exact χ_val D5IrrepIndex.trivial ( toConjClass k );
        · erw [ show Fintype.card D5 = 10 by rfl ] ; norm_num [ D5IrrepIndex.dim ];
        · unfold χ_val; aesop;
      · fin_cases k <;> norm_cast;
        all_goals simp +decide [ Fin.sum_univ_succ, D5IrrepIndex.sign, D5IrrepIndex.dim ];
        all_goals simp +decide [ show ( χ_val D5IrrepIndex.sign ) = fun c => if c = .identity then 1 else if c = .rot1 then 1 else if c = .rot2 then 1 else if c = .reflection then -1 else 0 from by funext c; fin_cases c <;> rfl ] ;
        all_goals norm_cast;
      · convert golden_convolution k using 1;
        unfold χ_elem; norm_num [ D5IrrepIndex.dim ] ;
      · fin_cases k <;> norm_num [ Fin.sum_univ_succ, D5IrrepIndex.dim ] <;> norm_cast;
        all_goals erw [ Finset.sum_eq_multiset_sum ] ; norm_cast;
        all_goals erw [ Multiset.sum_coe ] ; norm_num [ Finset.sum ] ; ring!;
        all_goals simp +decide [ List.finRange ] ; ring!;
        all_goals repeat erw [ χ_val ] ; norm_num;
        · norm_cast ; norm_num [ phi_sq ] ; ring;
          rw [ show phi = ( 1 + Real.sqrt 5 ) / 2 by rfl ] ; nlinarith [ Real.sq_sqrt ( show 0 ≤ 5 by norm_num ) ];
        · norm_num [ Complex.ext_iff, sq ] ; ring;
          rw [ show phi = ( 1 + Real.sqrt 5 ) / 2 by rfl ] ; nlinarith [ Real.sq_sqrt ( show 0 ≤ 5 by norm_num ) ];
        · norm_num [ Complex.ext_iff, sq ] ; ring;
          rw [ show phi = ( 1 + Real.sqrt 5 ) / 2 by rfl ] ; nlinarith [ Real.sq_sqrt ( show 0 ≤ 5 by norm_num ) ];
        · norm_cast; ring;
          rw [ phi_sq ] ; ring;
        · norm_cast; ring;
          rw [ show phi = ( 1 + Real.sqrt 5 ) / 2 by rfl ] ; nlinarith [ Real.sq_sqrt ( show 0 ≤ 5 by norm_num ) ]

/-
Each isotypic projector is idempotent.
-/
theorem isotypicProjector_idempotent (ρ : UnitaryRep H) (idx : D5IrrepIndex) :
    isotypicProjector ρ idx * isotypicProjector ρ idx = isotypicProjector ρ idx := by
      -- Apply the convolution identity `char_convolution_self` to rewrite the product.
      have h_conv : ∑ g : D5, ∑ h : D5, starRingEnd ℂ (χ_elem idx g) • starRingEnd ℂ (χ_elem idx h) • ρ.toCLM (g * h) = (10 / (idx.dim : ℂ)) • ∑ g : D5, starRingEnd ℂ (χ_elem idx g) • ρ.toCLM g := by
        have h_conv : ∑ g : D5, ∑ h : D5, starRingEnd ℂ (χ_elem idx g) • starRingEnd ℂ (χ_elem idx h) • ρ.toCLM (g * h) = ∑ k : D5, (∑ g : D5, starRingEnd ℂ (χ_elem idx g) • starRingEnd ℂ (χ_elem idx (g⁻¹ * k))) • ρ.toCLM k := by
          have h_conv : ∀ g : D5, ∑ h : D5, starRingEnd ℂ (χ_elem idx g) • starRingEnd ℂ (χ_elem idx h) • ρ.toCLM (g * h) = ∑ k : D5, starRingEnd ℂ (χ_elem idx g) • starRingEnd ℂ (χ_elem idx (g⁻¹ * k)) • ρ.toCLM k := by
            intro g;
            conv_rhs => rw [ ← Equiv.sum_comp ( Equiv.mulLeft g ) ] ;
            simp +decide [ mul_assoc ];
          simp +decide only [h_conv, sum_smul];
          exact Finset.sum_comm.trans ( Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => by simp +decide [ mul_assoc, smul_smul ] );
        have h_conv : ∀ k : D5, ∑ g : D5, starRingEnd ℂ (χ_elem idx g) • starRingEnd ℂ (χ_elem idx (g⁻¹ * k)) = (10 / (idx.dim : ℂ)) * starRingEnd ℂ (χ_elem idx k) := by
          intro k
          have h_conv : ∑ g : D5, χ_elem idx g * χ_elem idx (g⁻¹ * k) = (10 / (idx.dim : ℂ)) * χ_elem idx k := by
            exact?;
          convert congr_arg Star.star h_conv using 1 <;> simp +decide [ mul_comm, Finset.mul_sum _ _ _, Finset.sum_mul ];
        simp_all +decide [ Finset.smul_sum, MulAction.mul_smul ];
      unfold isotypicProjector;
      -- Apply the convolution identity to rewrite the product of the projectors.
      have h_prod : (∑ g : D5, starRingEnd ℂ (χ_elem idx g) • ρ.toCLM g) * (∑ h : D5, starRingEnd ℂ (χ_elem idx h) • ρ.toCLM h) = (10 / (idx.dim : ℂ)) • ∑ g : D5, starRingEnd ℂ (χ_elem idx g) • ρ.toCLM g := by
        convert h_conv using 1;
        simp +decide [ Finset.sum_mul _ _ _, Finset.mul_sum, ContinuousLinearMap.ext_iff ];
        intro x;
        refine' Finset.sum_comm.trans ( Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => _ );
        simp +decide [ UnitaryRep.toCLM ];
        rw [ ρ.map_mul' ];
        exact?;
      convert congr_arg ( fun x => ( ( idx.dim : ℂ ) / 10 ) • ( ( idx.dim : ℂ ) / 10 ) • x ) h_prod using 1;
      · simp +decide [ mul_assoc, mul_comm, mul_left_comm, smul_smul ];
      · by_cases h : idx.dim = 0 <;> simp +decide [ h, div_eq_mul_inv, mul_assoc, smul_smul ]

/-
The convolution of the sign and trivial characters is zero.
-/
lemma sign_trivial_convolution (k : D5) :
    ∑ g : D5, χ_elem .sign g * χ_elem .trivial (g⁻¹ * k) = 0 := by
      erw [ show ( ∑ x : D5, χ_val D5IrrepIndex.sign ( toConjClass x ) * χ_val D5IrrepIndex.trivial ( toConjClass ( x⁻¹ * k ) ) ) = ∑ x : D5, χ_val D5IrrepIndex.sign ( toConjClass x ) * χ_val D5IrrepIndex.trivial ( toConjClass x⁻¹ ) by
              exact Finset.sum_congr rfl fun x hx => by rcases toConjClass x⁻¹ with ( _ | _ | _ | _ ) <;> rcases toConjClass ( x⁻¹ * k ) with ( _ | _ | _ | _ ) <;> rfl; ];
      erw [ show ( ∑ x : D5, χ_val D5IrrepIndex.sign ( toConjClass x ) * χ_val D5IrrepIndex.trivial ( toConjClass x⁻¹ ) ) = ∑ x : D5, χ_val D5IrrepIndex.sign ( toConjClass x ) * 1 by
              congr! 1;
              exact congr_arg _ ( by erw [ show χ_val D5IrrepIndex.trivial ( toConjClass _ ) = 1 from by { rename_i x hx; fin_cases x <;> rfl } ] ) ] ; norm_cast;
      simp +decide [ show χ_val D5IrrepIndex.sign = fun x => if x = D5ConjClass.reflection then -1 else 1 by ext x; fin_cases x <;> rfl ];
      norm_cast
