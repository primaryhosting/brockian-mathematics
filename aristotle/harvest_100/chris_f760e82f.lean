/-
The golden projector is idempotent (P² = P).
-/
theorem P_golden_idempotent (ρ : UnitaryRep H) :
    P_golden ρ * P_golden ρ = P_golden ρ := by
  unfold P_golden isotypicProjector
  -- P * P = (d/10) * sum_g ... * (d/10) * sum_h ...
  -- = (d/10)^2 * sum_g sum_h conj(χ(g)) conj(χ(h)) ρ(gh)
  -- We use the convolution lemma to simplify the sum
  -- The key is to reindex the double sum
  -- Using the convolution property of the golden character, we can simplify the expression.
  have h_conv : ∑ g : D5, ∑ h : D5, (starRingEnd ℂ (χ_elem .golden g) * starRingEnd ℂ (χ_elem .golden h)) • ρ.toCLM (g * h) = (5 : ℂ) • ∑ g : D5, (starRingEnd ℂ (χ_elem .golden g)) • ρ.toCLM g := by
    -- By changing the order of summation, we can rewrite the double sum as $\sum_{k} \rho(k) \sum_{g} \overline{\chi(g)} \overline{\chi(g^{-1}k)}$.
    have h_sum_change : ∑ g : D5, ∑ h : D5, (starRingEnd ℂ (χ_elem .golden g) * starRingEnd ℂ (χ_elem .golden h)) • ρ.toCLM (g * h) = ∑ k : D5, (∑ g : D5, starRingEnd ℂ (χ_elem .golden g) * starRingEnd ℂ (χ_elem .golden (g⁻¹ * k))) • ρ.toCLM k := by
      have h_sum_change : ∑ g : D5, ∑ h : D5, (starRingEnd ℂ (χ_elem .golden g) * starRingEnd ℂ (χ_elem .golden h)) • ρ.toCLM (g * h) = ∑ g : D5, ∑ k : D5, (starRingEnd ℂ (χ_elem .golden g) * starRingEnd ℂ (χ_elem .golden (g⁻¹ * k))) • ρ.toCLM k := by
        exact Finset.sum_congr rfl fun g _ => by rw [ ← Equiv.sum_comp ( Equiv.mulLeft g⁻¹ ) ] ; simp +decide ;
      rw [ h_sum_change, Finset.sum_comm ];
      simp +decide only [sum_smul];
    -- Using the convolution property of the golden character, we can simplify the inner sum.
    have h_inner_sum : ∀ k : D5, ∑ g : D5, starRingEnd ℂ (χ_elem .golden g) * starRingEnd ℂ (χ_elem .golden (g⁻¹ * k)) = 5 * starRingEnd ℂ (χ_elem .golden k) := by
      intro k
      have h_inner_sum : ∑ g : D5, χ_elem .golden g * χ_elem .golden (g⁻¹ * k) = 5 * χ_elem .golden k := by
        exact?;
      simpa [ Complex.ext_iff ] using congr_arg Star.star h_inner_sum;
    simp_all +decide [ Finset.smul_sum, MulAction.mul_smul ];
  convert congr_arg ( fun x : H →L[ℂ] H => ( 2 / 10 : ℂ ) • ( 2 / 10 : ℂ ) • x ) h_conv using 1;
  · simp +decide [ Finset.smul_sum, mul_smul, Finset.mul_sum _ _ _, Finset.sum_mul, ContinuousLinearMap.ext_iff ];
    intro x;
    refine' Finset.sum_congr rfl fun g _ => Finset.sum_congr rfl fun h _ => _;
    rw [ show ρ.toCLM ( g * h ) = ρ.toCLM h ∘L ρ.toCLM g from _ ];
    · simp +decide [ div_eq_mul_inv, mul_assoc, mul_left_comm, smul_smul ];
