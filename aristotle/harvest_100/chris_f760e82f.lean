abbrev D5 := DihedralGroup 5

theorem D5_card : Fintype.card D5 = 10 := by
  -- The cardinality of the dihedral group $D_5$ is $2 \times 5 = 10$.
  simp [DihedralGroup.card]

inductive D5IrrepIndex where
  | trivial    -- 1D
  | sign       -- 1D
  | golden     -- 2D
  | conjugate  -- 2D
  deriving DecidableEq, Repr, Fintype

def D5IrrepIndex.dim : D5IrrepIndex → ℕ
  | .trivial => 1
  | .sign => 1
  | .golden => 2
  | .conjugate => 2

theorem dimension_sum : ∑ idx : D5IrrepIndex, (idx.dim)^2 = 10 := by
  simp_all +decide [ Summable ]

def phi : ℝ := (1 + Real.sqrt 5) / 2

def phi_conj : ℝ := (1 - Real.sqrt 5) / 2

-- KEY IDENTITY: phi² = phi + 1
theorem phi_sq : phi ^ 2 = phi + 1 := by
  -- By definition of phi, we have phi = (1 + Real.sqrt 5) / 2.
  simp [phi]

theorem phi_sum : phi + phi_conj = 1 := by
  -- By definition of phi and phi_conj, we have phi + phi_conj = (1 + Real.sqrt 5) / 2 + (1 - Real.sqrt 5) / 2.
  simp [phi, phi_conj]

theorem phi_prod : phi * phi_conj = -1 := by
  -- By definition of phi and phi_conj, we have phi * phi_conj = (-1 + sqrt(5))/2 * (-1 - sqrt(5))/2.
  simp [phi, phi_conj]

theorem phi_pos : 0 < phi := by
  -- Since $\sqrt{5}$ is positive, adding 1 to it and dividing by 2 will also result in a positive number.
  apply div_pos; exact add_pos zero_lt_one (Real.sqrt_pos.mpr (by norm_num)); exact zero_lt_two

-- Character values: phi - 1 = 1/phi (the "golden" property)
theorem phi_minus_one : phi - 1 = 1 / phi := by
  -- By definition of phi, we know that phi = (1 + sqrt(5)) / 2.
  have h_phi_def : phi = (1 + Real.sqrt 5) / 2 := by
    -- By definition of phi, we have phi = (1 + Real.sqrt 5) / 2.
    simp [phi];
  -- Substitute the definition of phi into the equation and simplify.
  rw [h_phi_def]
  field_simp
  ring;
  -- We know that $(\sqrt{5})^2 = 5$, so substituting this in, we get $-1 + 5 = 4$.
  norm_num

inductive D5ConjClass where
  | identity    -- {1}
  | rot1        -- {r, r⁴}
  | rot2        -- {r², r³}
  | reflection  -- all reflections
  deriving DecidableEq, Repr, Fintype

def D5ConjClass.size : D5ConjClass → ℕ
  | .identity => 1
  | .rot1 => 2
  | .rot2 => 2
  | .reflection => 5

theorem conjClass_sizes_sum : 
    D5ConjClass.size .identity + D5ConjClass.size .rot1 + 
    D5ConjClass.size .rot2 + D5ConjClass.size .reflection = 10 := rfl

def χ_val : D5IrrepIndex → D5ConjClass → ℂ
  | .trivial,   .identity   => 1
  | .trivial,   .rot1       => 1
  | .trivial,   .rot2       => 1
  | .trivial,   .reflection => 1
  | .sign,      .identity   => 1
  | .sign,      .rot1       => 1
  | .sign,      .rot2       => 1
  | .sign,      .reflection => -1
  | .golden,    .identity   => 2
  | .golden,    .rot1       => (phi - 1 : ℝ)
  | .golden,    .rot2       => (-phi : ℝ)
  | .golden,    .reflection => 0
  | .conjugate, .identity   => 2
  | .conjugate, .rot1       => (-phi : ℝ)
  | .conjugate, .rot2       => (phi - 1 : ℝ)
  | .conjugate, .reflection => 0

-- Golden character is REAL (key for self-adjointness)
theorem χ_golden_real (c : D5ConjClass) : (χ_val .golden c).im = 0 := by
  cases c <;> simp [χ_val, phi]

-- Trivial character is real
theorem χ_trivial_real (c : D5ConjClass) : (χ_val .trivial c).im = 0 := by
  cases c <;> simp [χ_val]

def charInnerProduct (π₁ π₂ : D5IrrepIndex) : ℂ :=
  (1 / 10 : ℂ) * ∑ c : D5ConjClass, 
    (D5ConjClass.size c : ℂ) * χ_val π₁ c * starRingEnd ℂ (χ_val π₂ c)

/-
Summing a function over D5ConjClass is equivalent to summing the function values at identity, rot1, rot2, and reflection.
-/
lemma sum_D5ConjClass {α : Type*} [AddCommMonoid α] (f : D5ConjClass → α) :
  ∑ x : D5ConjClass, f x = f .identity + f .rot1 + f .rot2 + f .reflection := by
  rw [ show ( Finset.univ : Finset D5ConjClass ) = { D5ConjClass.identity, D5ConjClass.rot1, D5ConjClass.rot2, D5ConjClass.reflection } by decide, Finset.sum_insert, Finset.sum_insert, Finset.sum_insert ] <;> simp +decide [ add_assoc ]

/-
The inner product of the golden character and the trivial character is 0.
-/
theorem charInner_golden_trivial : charInnerProduct .golden .trivial = 0 := by
  simp only [charInnerProduct, χ_val, D5ConjClass.size]
  rw [sum_D5ConjClass]
  simp only [χ_val, D5ConjClass.size]
  -- Now we have an explicit sum:
  -- (1/10) * (1*2*1 + 2*(phi-1)*1 + 2*(-phi)*1 + 5*0*1)
  -- = (1/10) * (2 + 2*phi - 2 - 2*phi + 0)
  -- = 0
  ring_nf
  norm_num [ Complex.ext_iff ] ; ring

/-
The square of phi (as a complex number) is equal to phi plus 1.
-/
lemma phi_sq_complex : (phi : ℂ) ^ 2 = (phi : ℂ) + 1 := by
  norm_cast
  exact phi_sq

/-
The inner product of the golden character with itself is 1.
-/
lemma phi_complex_conj : starRingEnd ℂ (phi : ℂ) = (phi : ℂ) := by
  norm_num [ Complex.ext_iff ]

theorem charInner_golden_golden : charInnerProduct .golden .golden = 1 := by
  unfold charInnerProduct; norm_num [ sum_D5ConjClass ] ; ring; norm_num;
  unfold D5ConjClass.size χ_val; norm_num [ Complex.ext_iff ] ;
  rw [ show phi = ( 1 + Real.sqrt 5 ) / 2 by rfl ] ; ring_nf ; norm_num;

/-
The inner product of any two distinct irreducible characters of D5 is zero.
-/
theorem charInner_orthog (π₁ π₂ : D5IrrepIndex) (h : π₁ ≠ π₂) :
    charInnerProduct π₁ π₂ = 0 := by
      unfold charInnerProduct;
      rw [ sum_D5ConjClass ];
      unfold D5ConjClass.size χ_val; norm_num; ring;
