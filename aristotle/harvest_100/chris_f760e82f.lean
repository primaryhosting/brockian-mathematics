/-
The adjoint of the unitary representation of an element is the representation of its inverse.
-/
variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

structure UnitaryRep (H : Type*) [NormedAddCommGroup H] [InnerProductSpace ℂ H] where
  toFun : D5 → (H ≃ₗᵢ[ℂ] H)
  map_one' : toFun 1 = LinearIsometryEquiv.refl ℂ H
  map_mul' : ∀ g h, toFun (g * h) = (toFun g).trans (toFun h)

instance : CoeFun (UnitaryRep H) (fun _ => D5 → (H ≃ₗᵢ[ℂ] H)) where
  coe := UnitaryRep.toFun

def UnitaryRep.toCLM (ρ : UnitaryRep H) (g : D5) : H →L[ℂ] H :=
  (ρ g).toContinuousLinearEquiv.toContinuousLinearMap

-- Key: star(ρ(g)) = ρ(g⁻¹) for unitary reps
theorem UnitaryRep.star_eq_inv (ρ : UnitaryRep H) (g : D5) :
    star (ρ.toCLM g) = ρ.toCLM g⁻¹ := by
  -- The adjoint of a unitary operator is its inverse.
  -- ρ(g) is a LinearIsometryEquiv, so its adjoint is its inverse.
  -- ρ(g⁻¹) = ρ(g)⁻¹ because ρ is a group homomorphism.
  rw [UnitaryRep.toCLM, UnitaryRep.toCLM]
  -- We need to show star ((ρ g).toCLM) = (ρ g⁻¹).toCLM
  -- Since ρ is a homomorphism, ρ g⁻¹ = (ρ g)⁻¹
  have h_hom : ρ g⁻¹ = (ρ g).symm := by
    apply LinearIsometryEquiv.ext
    intro x
    -- This requires using map_mul' and map_one' to show it's a group hom
    -- But let's see if we can use the fact that it's a unitary rep directly
    have := ρ.2;
    -- By definition of unitary representation, we know that ρ(g⁻¹) is the inverse of ρ(g).
    have h_inv : ρ.toFun g⁻¹ = (ρ.toFun g).symm := by
      have := ρ.3;
      have := this g⁻¹ g;
      simp +zetaDelta at *;
      simp_all +decide [ LinearIsometryEquiv.ext_iff ];
      intro x; exact (by
      exact?);
    rw [h_inv]
  rw [h_hom]
  -- Now we need star ((ρ g).toCLM) = ((ρ g).symm).toCLM
  -- This is a property of LinearIsometryEquiv
  have h_star : ∀ (U : H ≃ₗᵢ[ℂ] H), star (U : H →L[ℂ] H) = U.symm := by
    simp +decide [ Star.star ];
  exact h_star _

-- Map D5 elements to their conjugacy class
def toConjClass : D5 → D5ConjClass
  | DihedralGroup.r 0 => .identity
  | DihedralGroup.r 1 => .rot1
  | DihedralGroup.r 4 => .rot1
  | DihedralGroup.r 2 => .rot2
  | DihedralGroup.r 3 => .rot2
  | DihedralGroup.sr _ => .reflection

def χ_elem (idx : D5IrrepIndex) (g : D5) : ℂ := χ_val idx (toConjClass g)

-- THE CONSTRUCTIVE PROJECTOR
def isotypicProjector (ρ : UnitaryRep H) (idx : D5IrrepIndex) : H →L[ℂ] H :=
  (idx.dim / 10 : ℂ) • ∑ g : D5, starRingEnd ℂ (χ_elem idx g) • ρ.toCLM g

def P_golden (ρ : UnitaryRep H) : H →L[ℂ] H := isotypicProjector ρ .golden
def P_trivial (ρ : UnitaryRep H) : H →L[ℂ] H := isotypicProjector ρ .trivial
def P_sign (ρ : UnitaryRep H) : H →L[ℂ] H := isotypicProjector ρ .sign
def P_conjugate (ρ : UnitaryRep H) : H →L[ℂ] H := isotypicProjector ρ .conjugate

/-
The golden projector is self-adjoint.
-/
lemma conjClass_inv_eq (g : D5) : toConjClass g⁻¹ = toConjClass g := by
  fin_cases g <;> rfl

theorem P_golden_selfAdjoint (ρ : UnitaryRep H) : IsSelfAdjoint (P_golden ρ) := by
  unfold P_golden;
  unfold isotypicProjector;
  simp +decide [ IsSelfAdjoint ];
  simp +decide [ charInner_golden_golden, UnitaryRep.star_eq_inv ];
  -- Since $\chi_{\text{golden}}$ is real, we have $\star(\chi_{\text{golden}}(g)) = \chi_{\text{golden}}(g)$.
  have h_real : ∀ g : D5, starRingEnd ℂ (χ_elem D5IrrepIndex.golden g) = χ_elem D5IrrepIndex.golden g := by
    intro g
    simp [χ_elem];
    cases toConjClass g <;> simp +decide [ χ_val ];
    norm_num [ Complex.ext_iff ];
  rw [ ← Equiv.sum_comp ( Equiv.inv D5 ) ] ; aesop

