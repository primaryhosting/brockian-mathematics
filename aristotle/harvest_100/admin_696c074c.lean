    ∃ p q : ℕ, Nat.Prime p ∧ Nat.Prime q ∧ p + q = n := by
  obtain ⟨k, rfl⟩ := hev
  have hk1 : 2 ≤ k := by omega
  have hk2 : k ≤ 525 := by omega
  clear h4 hn
  interval_cases k
