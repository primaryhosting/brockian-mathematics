/-- **Main result.** `(5775, 6128)` is a betrothed (quasi-amicable) pair:
`σ₁ 5775 = σ₁ 6128 = 5775 + 6128 + 1 = 11904`. Verified by kernel reduction. -/
theorem betrothed_5775_6128 : IsBetrothedPair 5775 6128 := by
  decide +kernel

/-- The pair `(5775, 6128)` is generated by the `k = 4, p = 383` sigma criterion:
`6128 = 2 ^ 4 * 383` with `383` prime, `σ₁ 6128 = (2 ^ 5 - 1) * (383 + 1) = 11904`,
and `5775 = σ₁ 6128 - 6128 - 1`. -/
theorem sigma_criterion_k4_p383 :
    Nat.Prime 383 ∧ (6128 : ℕ) = 2 ^ 4 * 383 ∧
      sigmaOne 6128 = (2 ^ (4 + 1) - 1) * (383 + 1) ∧
      (5775 : ℕ) = (2 ^ (4 + 1) - 1) * (383 + 1) - 6128 - 1 := by
  refine ⟨by norm_num, by norm_num, ?_, by norm_num⟩
  have h : (6128 : ℕ) = 2 ^ 4 * 383 := by norm_num
  rw [h, sigmaOne_two_pow_mul_prime (by norm_num) (by norm_num)]

/-- The betrothed pair `(5775, 6128)` obtained from the `k = 4, p = 383` criterion,
without any brute-force computation of `σ₁ 6128`. -/
theorem betrothed_5775_6128_of_criterion : IsBetrothedPair 5775 (2 ^ 4 * 383) :=
  isBetrothedPair_of_sigma_criterion (k := 4) (p := 383) (n := 5775)
    (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
    (by rw [sigmaOne_5775]; norm_num)

