def Brockian.SpectralTheory.emergence_measure : MeasureTheory.Measure Brockian.MathematicalTruth := MeasureTheory.Measure.count

def Brockian.SpectralTheory.inner (f g : Brockian.MathSpace) : ℂ := ∫ T, f T * star (g T) ∂Brockian.SpectralTheory.emergence_measure

def Brockian.SpectralTheory.PhiOperator (T : Brockian.MathematicalTruth) : Brockian.MathematicalTruth where
  statement := T.statement
  complexity := Brockian.φ * T.complexity
  complexity_pos := mul_pos Brockian.GoldenRatio.pos T.complexity_pos

def Brockian.SpectralTheory.phi_op (f : Brockian.MathSpace) : Brockian.MathSpace := fun T => f (Brockian.SpectralTheory.PhiOperator T)

def Brockian.SpectralTheory.TemporalLaplacian (f : Brockian.MathSpace) : Brockian.MathSpace := fun T => -(Brockian.φ : ℂ) * (Brockian.SpectralTheory.phi_op f T - f T)

def Brockian.RussellResolution.RussellParadox : Brockian.MathematicalTruth where
  statement := ∃ R : Set Brockian.MathematicalTruth, ∀ T, T ∈ R ↔ T ∉ R
  complexity := 3.5
  complexity_pos := by norm_num

def Brockian.RussellResolution.RussellQuestion : Brockian.MathematicalTruth where
  statement := ∀ R : Set Brockian.MathematicalTruth, (∃ T, T ∈ R ↔ T ∉ R) → False
  complexity := 4.2
  complexity_pos := by norm_num

def Brockian.SpectralTheory.SquareIntegrable (f : Brockian.MathSpace) : Prop :=
  MeasureTheory.MemLp f 2 Brockian.SpectralTheory.emergence_measure

def Brockian.SpectralTheory.inner_product (f g : Brockian.MathSpace) : ℂ := ∫ T, f T * star (g T) ∂Brockian.SpectralTheory.emergence_measure

theorem Brockian.SpectralTheory.inner_sesquilinear
  (f g h : Brockian.MathSpace)
  (hf : Brockian.SpectralTheory.SquareIntegrable f)
  (hg : Brockian.SpectralTheory.SquareIntegrable g)
  (hh : Brockian.SpectralTheory.SquareIntegrable h) :
  (∀ α : ℂ, Brockian.SpectralTheory.inner (fun T => α * f T + g T) h =
    α * Brockian.SpectralTheory.inner f h + Brockian.SpectralTheory.inner g h) ∧
  (∀ α : ℂ, Brockian.SpectralTheory.inner f (fun T => α * g T + h T) =
    star α * Brockian.SpectralTheory.inner f g + Brockian.SpectralTheory.inner f h) := by
      constructor <;> intro α <;> unfold Brockian.SpectralTheory.inner <;> simp +decide [ add_mul, mul_add, mul_assoc, mul_comm, mul_left_comm, MeasureTheory.integral_const_mul, MeasureTheory.integral_mul_const ] ; ring!; (
      rw [ ← MeasureTheory.integral_const_mul ] ; rw [ ← MeasureTheory.integral_add ] ; congr ; ext ; ring!; (
      refine' MeasureTheory.Integrable.const_mul _ _;
      refine' MeasureTheory.Integrable.mono' _ _ _;
      refine' fun T => ‖f T‖ ^ 2 + ‖h T‖ ^ 2;
      · exact MeasureTheory.Integrable.add ( hf.norm.integrable_sq ) ( hh.norm.integrable_sq );
      · exact MeasureTheory.AEStronglyMeasurable.mul ( hf.1 ) ( hh.1.star );
      · filter_upwards [ ] with T using by simpa using by nlinarith only [ norm_nonneg ( f T ), norm_nonneg ( h T ) ] ;);
      refine' MeasureTheory.Integrable.mono' _ _ _;
      refine' fun T => ‖g T‖ ^ 2 + ‖h T‖ ^ 2;
      · exact MeasureTheory.Integrable.add ( MeasureTheory.MemLp.integrable_sq ( by exact? ) ) ( MeasureTheory.MemLp.integrable_sq ( by exact? ) );
      · exact MeasureTheory.AEStronglyMeasurable.mul ( hg.1 ) ( hh.1.star );
      · filter_upwards [ ] with x using by simpa using by nlinarith only [ norm_nonneg ( g x ), norm_nonneg ( h x ) ] ;);
      rw [ ← MeasureTheory.integral_const_mul ] ; rw [ ← MeasureTheory.integral_add ] ; congr ; ext ; ring;
      · refine' MeasureTheory.Integrable.const_mul _ _;
        refine' MeasureTheory.Integrable.mono' _ _ _;
        refine' fun T => ‖f T‖ ^ 2 + ‖g T‖ ^ 2;
        · exact MeasureTheory.Integrable.add ( hf.norm.integrable_sq ) ( hg.norm.integrable_sq );
        · exact MeasureTheory.AEStronglyMeasurable.mul ( hf.1 ) ( hg.1.star );
        · filter_upwards [ ] with T using by simpa using by nlinarith only [ sq_nonneg ( ‖f T‖ - ‖g T‖ ), norm_nonneg ( f T ), norm_nonneg ( g T ) ] ;
      · refine' MeasureTheory.Integrable.mono' _ _ _;
        refine' fun T => ‖f T‖ ^ 2 + ‖h T‖ ^ 2;
        · exact MeasureTheory.Integrable.add ( by simpa [ sq ] using hf.norm.integrable_sq ) ( by simpa [ sq ] using hh.norm.integrable_sq );
        · exact MeasureTheory.AEStronglyMeasurable.mul ( hf.1 ) ( hh.1.star );
        · filter_upwards [ ] with T using by simpa using by nlinarith [ norm_nonneg ( f T ), norm_nonneg ( h T ) ] ;

theorem Brockian.SpectralTheory.inner_add_left
  (f g h : Brockian.MathSpace)
  (hf : Brockian.SpectralTheory.SquareIntegrable f)
  (hg : Brockian.SpectralTheory.SquareIntegrable g)
  (hh : Brockian.SpectralTheory.SquareIntegrable h) :
  Brockian.SpectralTheory.inner (fun T => f T + g T) h = Brockian.SpectralTheory.inner f h + Brockian.SpectralTheory.inner g h := by
    unfold Brockian.SpectralTheory.inner;
    rw [ ← MeasureTheory.integral_add ] ; congr ; ext ; ring;
    · refine' MeasureTheory.Integrable.mono' _ _ _;
      refine' fun T => ‖f T‖ ^ 2 + ‖h T‖ ^ 2;
      · exact MeasureTheory.Integrable.add ( hf.integrable_norm_pow two_ne_zero ) ( hh.integrable_norm_pow two_ne_zero );
      · exact MeasureTheory.AEStronglyMeasurable.mul ( hf.1 ) ( hh.1.star );
      · filter_upwards [ ] with T using by simpa [ Complex.normSq, Complex.norm_def ] using by nlinarith only [ sq_nonneg ( ‖f T‖ - ‖h T‖ ), norm_nonneg ( f T ), norm_nonneg ( h T ) ] ;
    · refine' MeasureTheory.Integrable.mono' _ _ _;
      refine' fun T => ‖g T‖ ^ 2 + ‖h T‖ ^ 2;
      · exact MeasureTheory.Integrable.add ( MeasureTheory.MemLp.integrable_sq ( by exact hg.norm ) ) ( MeasureTheory.MemLp.integrable_sq ( by exact hh.norm ) );
      · exact MeasureTheory.AEStronglyMeasurable.mul ( hg.1 ) ( hh.1.star );
      · filter_upwards [ ] with T using by simpa using by nlinarith [ norm_nonneg ( g T ), norm_nonneg ( h T ) ] ;

theorem Brockian.SpectralTheory.inner_smul_left
  (f h : Brockian.MathSpace)
  (α : ℂ)
  (hf : Brockian.SpectralTheory.SquareIntegrable f)
  (hh : Brockian.SpectralTheory.SquareIntegrable h) :
  Brockian.SpectralTheory.inner (fun T => α * f T) h = α * Brockian.SpectralTheory.inner f h := by
    -- The integral of a scalar multiple of a function is the scalar multiple of the integral.
    have h_integral : ∫ T, (α * f T) * star (h T) ∂Brockian.SpectralTheory.emergence_measure = α * ∫ T, f T * star (h T) ∂Brockian.SpectralTheory.emergence_measure := by
      simp +decide only [mul_assoc, MeasureTheory.integral_const_mul];
    exact h_integral

theorem Brockian.SpectralTheory.inner_add_right
  (f g h : Brockian.MathSpace)
  (hf : Brockian.SpectralTheory.SquareIntegrable f)
  (hg : Brockian.SpectralTheory.SquareIntegrable g)
  (hh : Brockian.SpectralTheory.SquareIntegrable h) :
  Brockian.SpectralTheory.inner f (fun T => g T + h T) = Brockian.SpectralTheory.inner f g + Brockian.SpectralTheory.inner f h := by
    convert MeasureTheory.integral_add ?_ ?_ using 2 ; ring;
    · exact MeasureTheory.integral_congr_ae ( Filter.Eventually.of_forall fun x => by simp +decide [ mul_add ] );
    · refine' MeasureTheory.Integrable.mono' _ _ _;
      refine' fun T => ‖f T‖ ^ 2 + ‖g T‖ ^ 2;
      · exact MeasureTheory.Integrable.add ( by simpa using hf.norm.integrable_sq ) ( by simpa using hg.norm.integrable_sq );
      · exact MeasureTheory.AEStronglyMeasurable.mul ( hf.1 ) ( hg.1.star );
      · exact Filter.Eventually.of_forall fun x => by simpa [ sq ] using by nlinarith only [ norm_nonneg ( f x ), norm_nonneg ( g x ) ] ;
    · refine' MeasureTheory.Integrable.mono' _ _ _;
      refine' fun T => ‖f T‖ ^ 2 + ‖h T‖ ^ 2;
      · convert MeasureTheory.Integrable.add ( hf.norm.integrable_sq ) ( hh.norm.integrable_sq ) using 1;
      · exact MeasureTheory.AEStronglyMeasurable.mul ( hf.1 ) ( hh.1.star );
      · simp [mul_comm, mul_assoc, mul_left_comm];
        exact Filter.Eventually.of_forall fun x => by nlinarith only [ sq_nonneg ( ‖f x‖ - ‖h x‖ ) ] ;

theorem Brockian.SpectralTheory.inner_smul_right
  (f g : Brockian.MathSpace)
  (α : ℂ)
  (hf : Brockian.SpectralTheory.SquareIntegrable f)
  (hg : Brockian.SpectralTheory.SquareIntegrable g) :
  Brockian.SpectralTheory.inner f (fun T => α * g T) = star α * Brockian.SpectralTheory.inner f g := by
    unfold Brockian.SpectralTheory.inner;
    simp +decide only [star_mul, mul_left_comm, mul_assoc, ← MeasureTheory.integral_const_mul];
    ac_rfl

#check (0 : Brockian.MathematicalTruth → ℂ)

theorem Brockian.SpectralTheory.inner_pos_def (f : Brockian.MathSpace) (hf : Brockian.SpectralTheory.SquareIntegrable f) :
  (Brockian.SpectralTheory.inner f f).re ≥ 0 ∧ (Brockian.SpectralTheory.inner f f = 0 ↔ f = (fun _ => 0)) := by
    constructor;
    · unfold Brockian.SpectralTheory.inner;
      norm_num [ mul_comm, Complex.mul_conj ];
      erw [ integral_ofReal ] ; norm_num;
      exact MeasureTheory.integral_nonneg fun _ => add_nonneg ( mul_self_nonneg _ ) ( mul_self_nonneg _ );
    · simp [Brockian.SpectralTheory.inner];
      -- If the integral of ‖f(T)‖^2 over the discrete measure is zero, then for each T, ‖f(T)‖^2 must be zero because the measure is counting measure.
      have h_zero : (∫ T, ‖f T‖^2 ∂Brockian.SpectralTheory.emergence_measure = 0) ↔ (∀ T, ‖f T‖^2 = 0) := by
        erw [ MeasureTheory.integral_eq_zero_iff_of_nonneg ];
        · simp +decide [ Filter.EventuallyEq, Brockian.SpectralTheory.emergence_measure ];
        · exact fun _ => sq_nonneg _;
        · convert hf.integrable_norm_pow two_ne_zero;
      simp_all +decide [ Complex.mul_conj, Complex.normSq_eq_norm_sq ];
      convert h_zero using 1;
      · norm_cast;
        erw [ integral_ofReal ] ; norm_num;
        rfl;
      · exact ⟨ fun h => fun T => h ▸ rfl, fun h => funext h ⟩

def Brockian.SpectralTheory.eigenmode (n : ℕ) : Brockian.MathSpace := fun T => (Brockian.φ : ℂ) ^ (-(T.complexity * n) : ℂ)

def Brockian.SpectralTheory.eigenvalue (n : ℕ) : ℂ := (Brockian.φ : ℂ) ^ n - 1

def Brockian.SpectralTheory.eigenmode_equation_prop (n : ℕ) : Prop :=
  Brockian.SpectralTheory.TemporalLaplacian (Brockian.SpectralTheory.eigenmode n) = (fun T => Brockian.SpectralTheory.eigenvalue n * Brockian.SpectralTheory.eigenmode n T)

theorem Brockian.SpectralTheory.eigenmode_equation_false : ¬ (∀ n, Brockian.SpectralTheory.eigenmode_equation_prop n) := by
  intro h
  have h1 := h 1
  let T1 : Brockian.MathematicalTruth := { statement := True, complexity := 1, complexity_pos := zero_lt_one }
  have eq1 := congr_fun h1 T1
  unfold Brockian.SpectralTheory.TemporalLaplacian Brockian.SpectralTheory.eigenmode Brockian.SpectralTheory.eigenvalue Brockian.SpectralTheory.phi_op Brockian.SpectralTheory.PhiOperator at eq1
  simp at eq1
  -- We have -φ * (φ^(-φ) - φ^(-1)) = (φ - 1) * φ^(-1)
  -- This implies φ = 2, which is false.
  have h_phi_pos : 0 < Brockian.φ := Brockian.GoldenRatio.pos
  have h_phi_ne_zero : (Brockian.φ : ℂ) ≠ 0 := by norm_cast; linarith
  have h_phi_sq : Brockian.φ ^ 2 = Brockian.φ + 1 := Brockian.GoldenRatio.defining_eq
  -- Substitute φ^φ = φ + 1 into the equation.
  have h_sub : (Brockian.φ : ℂ) ^ (-Brockian.φ : ℂ) = 1 / (Brockian.φ + 1) := by
    norm_num [ Complex.cpow_def ] at *;
    norm_num [ Complex.ext_iff, Complex.exp_re, Complex.exp_im, Complex.log_re, Complex.log_im, h_phi_pos.ne', h_phi_ne_zero ] at *;
    norm_num [ Complex.arg ] at *;
    norm_num [ Complex.normSq, h_phi_pos.le ] at *;
    norm_num [ Real.exp_neg, Real.exp_mul, Real.exp_log h_phi_pos ] at *;
    grind;
  norm_num [ Complex.ext_iff, sq ] at *;
  norm_num [ Complex.normSq, Complex.exp_re, Complex.exp_im, Complex.log_re, Complex.log_im, Complex.cpow_def ] at *;
  norm_num [ Complex.exp_re, Complex.exp_im, Complex.log_re, Complex.log_im, h_phi_ne_zero ] at *;
  norm_num [ show ( Brockian.φ : ℂ ).arg = 0 from Complex.arg_ofReal_of_nonneg h_phi_pos.le ] at *;
  norm_num [ mul_comm, Real.exp_neg, Real.exp_log h_phi_pos ] at eq1;
  norm_num [ show Brockian.φ * Real.log Brockian.φ = Real.log Brockian.φ * Brockian.φ by ring, Real.exp_mul, Real.exp_log h_phi_pos ] at eq1;
  -- Substitute h_sub into eq1 and simplify the expression.
  field_simp [h_sub] at eq1;
  nlinarith [ show 0 < Brockian.φ ^ Brockian.φ by positivity, show Brockian.φ ^ Brockian.φ < Brockian.φ ^ 2 by exact lt_of_lt_of_le ( Real.rpow_lt_rpow_of_exponent_lt ( by nlinarith ) ( show Brockian.φ < 2 by nlinarith ) ) ( by norm_num ) ]

def Brockian.SpectralTheory.eigenmode_corrected (n : ℕ) : Brockian.MathSpace := fun T => (T.complexity : ℂ) ^ n

def Brockian.SpectralTheory.TemporalLaplacian_corrected (f : Brockian.MathSpace) : Brockian.MathSpace := fun T => Brockian.SpectralTheory.phi_op f T - f T

theorem Brockian.SpectralTheory.eigenmode_equation_corrected (n : ℕ) :
    Brockian.SpectralTheory.TemporalLaplacian_corrected (Brockian.SpectralTheory.eigenmode_corrected n) = (fun T => Brockian.SpectralTheory.eigenvalue n * Brockian.SpectralTheory.eigenmode_corrected n T) := by
      -- By definition of the TemporalLaplacian_corrected, we have:
      funext T; simp [Brockian.SpectralTheory.TemporalLaplacian_corrected, Brockian.SpectralTheory.eigenmode_corrected, Brockian.SpectralTheory.eigenvalue];
      -- By definition of the corrected temporal Laplacian, we have that the eigenmode_corrected n satisfies the equation. Let's expand the left-hand side using the definition of Brockian.SpectralTheory.eigenmode_corrected.
      simp [Brockian.SpectralTheory.eigenmode_corrected, Brockian.SpectralTheory.phi_op];
      -- By definition of the PhiOperator, we have that its complexity is φ times the original complexity.
      have h_phi_op : (Brockian.SpectralTheory.PhiOperator T).complexity = Brockian.φ * T.complexity := by
        rfl;
      rw [ h_phi_op, sub_mul, one_mul, ← mul_pow ] ; norm_cast

def Brockian.MetaTheorems.PhiEigenspace : Set Brockian.MathematicalTruth :=
  {T | ∃ lam : ℝ, 0 < lam ∧ ∀ n : ℕ,
    (Brockian.SpectralTheory.PhiOperator^[n] T).complexity = lam ^ n * T.complexity}

theorem Brockian.RussellResolution.paradox_before_question : Brockian.t_emergence Brockian.RussellResolution.RussellParadox < Brockian.t_emergence Brockian.RussellResolution.RussellQuestion := by
  apply Brockian.TemporalDynamics.emergence_monotone
  unfold Brockian.RussellResolution.RussellQuestion Brockian.RussellResolution.RussellParadox; simp; norm_num

theorem Brockian.MetaTheorems.phi_uniqueness (c : ℝ) (hc : 1 < c) :
    (∀ T₁ T₂ : Brockian.MathematicalTruth, T₂.complexity = T₁.complexity + 1 →
      Brockian.t_emergence T₂ = c * Brockian.t_emergence T₁) → c = Brockian.φ := by
        intro h
        have := h ⟨True, 1, by norm_num⟩ ⟨True, 2, by norm_num⟩ (by norm_num)
        simp [Brockian.t_emergence] at this;
        unfold Brockian.t_Planck at this ; nlinarith [ show 0 < Brockian.φ by exact div_pos ( add_pos zero_lt_one ( Real.sqrt_pos.mpr ( show 0 < 5 by norm_num ) ) ) zero_lt_two, show 0 < Brockian.φ ^ 2 by exact pow_pos ( div_pos ( add_pos zero_lt_one ( Real.sqrt_pos.mpr ( show 0 < 5 by norm_num ) ) ) zero_lt_two ) 2 ]

structure Brockian.FormalSystem where
  axioms : Set Brockian.MathematicalTruth
  provable : Brockian.MathematicalTruth → Prop
  axiom_complexity_bound : ∃ M, ∀ A ∈ axioms, A.complexity ≤ M

theorem Brockian.SpectralTheory.eigenvalues_distinct (n m : ℕ) (h : n ≠ m) : Brockian.SpectralTheory.eigenvalue n ≠ Brockian.SpectralTheory.eigenvalue m := by
  -- Since the golden ratio is greater than 1, the function (phi^n - 1) is strictly increasing. Therefore, if n ≠ m, then (phi^n - 1) ≠ (phi^m - 1).
  have h_increasing : StrictMono (fun n : ℕ => (Brockian.φ : ℝ) ^ n - 1) := by
    -- Since Brockian.φ is greater than 1, raising it to a higher power will result in a larger number. Therefore, the function f(n) = (Brockian.φ)^n - 1 is strictly increasing.
    have h_increasing : ∀ n m : ℕ, n < m → (Brockian.φ : ℝ) ^ n < (Brockian.φ : ℝ) ^ m := by
      exact fun n m hnm => pow_lt_pow_right₀ ( show 1 < ( 1 + Real.sqrt 5 ) / 2 by nlinarith [ Real.sqrt_nonneg 5, Real.sq_sqrt ( show 0 ≤ 5 by norm_num ) ] ) hnm;
    exact strictMono_nat_of_lt_succ fun n => by simpa using h_increasing _ _ n.lt_succ_self;
  -- Since the eigenvalues are real numbers, their complex representations are equal if and only if their real parts are equal.
  have h_complex_eq : ∀ n m : ℕ, (Brockian.φ ^ n - 1 : ℂ) = (Brockian.φ ^ m - 1 : ℂ) ↔ (Brockian.φ ^ n - 1 : ℝ) = (Brockian.φ ^ m - 1 : ℝ) := by
    norm_cast ; norm_num;
  -- Apply the strict monotonicity result to conclude that the real parts are distinct.
  have h_real_distinct : (Brockian.φ ^ n - 1 : ℝ) ≠ (Brockian.φ ^ m - 1 : ℝ) := by
    exact h_increasing.injective.ne h;
  exact h_complex_eq n m |>.not.mpr h_real_distinct

