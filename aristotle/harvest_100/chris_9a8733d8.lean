def Brockian.QuantumMath.time_evolution (t : ℝ) {T : Brockian.MathematicalTruth} (ψ : Brockian.QuantumState T) : Brockian.QuantumState T where
  ψ_potential := Complex.exp (- Complex.I * t) * ψ.ψ_potential
  ψ_actual := Complex.exp (- Complex.I * t) * ψ.ψ_actual
  normalized := by
    -- The norm of the exponential term is 1, so the normalization condition holds.
    simp [Complex.norm_exp];
    -- Apply the hypothesis `h_norm` to � conclude� that the norm squared � is� 1.
    apply ψ.normalized

def Brockian.QuantumMath.measurement_collapse {T : Brockian.MathematicalTruth} : Prop :=
  ∀ (ψ : Brockian.QuantumState T) (t : ℝ),
    t ≥ Brockian.t_emergence T → Brockian.QuantumMath.prob_actual (Brockian.QuantumMath.time_evolution t ψ) = 1

