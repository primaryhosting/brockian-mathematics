/-!
# Ed25519 verification soundness over an arbitrary abelian group (Mathlib restatement)

`RequestProject.Ed25519VerifySound` proves soundness and completeness of Ed25519 signature
verification for the abstract model `PCA.Cert.EdModel`, using nothing but Lean's core
library (so that the required header comment can be the very first thing in that file).

Here we connect that development to Mathlib: every additive commutative group `G` with a
point `B` of order `L` — in particular the Ed25519 twisted-Edwards curve group with its
standard base point — yields an `EdModel`, and the soundness and completeness statements
take their familiar form

  `[S]B = R + [h]A`  with  `A = [s]B`, `R = [r]B`  ⟺  `S ≡ r + h * s [ZMOD L]`.

`PCA.Cert.edModel_zmod` records the non-vacuity witness `G = ZMod p`, `B = 1`.
-/

set_option autoImplicit false

namespace PCA.Cert

variable {G : Type*} [AddCommGroup G]

/-- Every abelian group `G` with a point `B` of order exactly `L > 1` gives an `EdModel`.
The Ed25519 curve group with its standard base point is such a group, with
`L = 2 ^ 252 + 27742317777372353535851937790883648493`. -/
def EdModel.ofAddCommGroup (B : G) (L : ℕ) (hL : 1 < L)
    (hord : ∀ n : ℤ, n • B = 0 ↔ (L : ℤ) ∣ n) : EdModel G where
  add := (· + ·)
  smul := (· • ·)
  B := B
  L := (L : ℤ)
  one_lt_L := by exact_mod_cast hL
  smul_add_base x y := (add_smul x y B).symm
  smul_smul_base x y := smul_smul x y B
  base_eq_iff x y := by
    constructor
    · intro hxy
      refine (hord (x - y)).1 ?_
      rw [sub_smul, hxy, sub_self]
    · intro hdvd
      have h0 : (x - y) • B = 0 := (hord (x - y)).2 hdvd
      rw [sub_smul, sub_eq_zero] at h0
      exact h0

/-- **Soundness of Ed25519 verification, stated over an arbitrary abelian group.**

If the verification equation `[S]B = R + [h]A` holds, where the public key is `A = [s]B` and
the commitment is `R = [r]B` for a base point `B` of order `L`, then the response `S` is
congruent modulo `L` to the honest Schnorr response `r + h * s`. -/
theorem ed25519_verify_sound_group {B : G} {L : ℕ} (hL : 1 < L)
    (hord : ∀ n : ℤ, n • B = 0 ↔ (L : ℤ) ∣ n) {s r h S : ℤ}
    (hver : S • B = r • B + h • (s • B)) :
    S ≡ r + h * s [ZMOD (L : ℤ)] := by
  have hdvd : ((L : ℤ)) ∣ (S - (r + h * s)) :=
    ed25519_verify_sound (M := EdModel.ofAddCommGroup B L hL hord) hver
  exact (Int.modEq_iff_dvd.2 hdvd).symm

/-- **Completeness of Ed25519 verification, stated over an arbitrary abelian group.**
Honestly produced signatures verify. -/
theorem ed25519_verify_complete_group {B : G} {L : ℕ} (hL : 1 < L)
    (hord : ∀ n : ℤ, n • B = 0 ↔ (L : ℤ) ∣ n) (s r h S : ℤ)
    (hS : S ≡ r + h * s [ZMOD (L : ℤ)]) :
    S • B = r • B + h • (s • B) := by
  have hdvd : ((L : ℤ)) ∣ (S - (r + h * s)) := Int.ModEq.dvd hS.symm
  have := (EdModel.ofAddCommGroup B L hL hord).base_eq_iff S (r + h * s)
  have hbase : S • B = (r + h * s) • B := this.2 hdvd
  rw [hbase, add_smul, smul_smul]

/-- Verification succeeds **iff** the response is the honest one modulo the group order. -/
theorem ed25519_verify_iff_group {B : G} {L : ℕ} (hL : 1 < L)
    (hord : ∀ n : ℤ, n • B = 0 ↔ (L : ℤ) ∣ n) (s r h S : ℤ) :
    S • B = r • B + h • (s • B) ↔ S ≡ r + h * s [ZMOD (L : ℤ)] :=
  ⟨ed25519_verify_sound_group hL hord, ed25519_verify_complete_group hL hord s r h S⟩

/-- Non-vacuity witness in Mathlib terms: `ZMod p` with base point `1` is a model of order
`p` for every prime `p`. -/
def edModel_zmod (p : ℕ) [Fact (Nat.Prime p)] : EdModel (ZMod p) :=
  EdModel.ofAddCommGroup (1 : ZMod p) p (Fact.out (p := Nat.Prime p)).one_lt (by
    intro n
    have : n • (1 : ZMod p) = ((n : ZMod p)) := by
      simp
    rw [this, ZMod.intCast_zmod_eq_zero_iff_dvd])

end PCA.Cert

