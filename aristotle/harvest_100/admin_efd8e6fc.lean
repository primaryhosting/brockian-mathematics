/-! ## The vacuum sector of a Euclidean (Osterwalder–Schrader) quantum field theory -/

/-- The Hilbert-space data of the vacuum sector of a quantum field theory:
a complex Hilbert space `Hilb`, a distinguished unit vector `vac` (the vacuum),
and the Euclidean-time semigroup `P t = e^{-tH}` generated by the Hamiltonian `H`.
The axioms say that `P` is a strongly-continuity-free, self-adjoint, contractive
one-parameter semigroup fixing the vacuum; equivalently `H` is a positive
self-adjoint operator annihilating the vacuum. -/
structure QFT where
  /-- The Hilbert space of states. -/
  Hilb : Type
  [instNormed : NormedAddCommGroup Hilb]
  [instInner : InnerProductSpace ℂ Hilb]
  [instComplete : CompleteSpace Hilb]
  /-- The Euclidean-time semigroup `P t = e^{-t H}`. -/
  P : ℝ → Hilb →L[ℂ] Hilb
  /-- The vacuum vector. -/
  vac : Hilb
  vac_norm : ‖vac‖ = 1
  P_zero : ∀ x, P 0 x = x
  P_add : ∀ s t, 0 ≤ s → 0 ≤ t → ∀ x, P (s + t) x = P s (P t x)
  /-- Each `P t` is self-adjoint (`H` is self-adjoint). -/
  P_symm : ∀ t, 0 ≤ t → ∀ x y, ⟪P t x, y⟫_ℂ = ⟪x, P t y⟫_ℂ
  /-- Each `P t` is a contraction (`H ≥ 0`, the spectrum condition). -/
  P_contract : ∀ t, 0 ≤ t → ∀ x, ‖P t x‖ ≤ ‖x‖
  /-- The vacuum has zero energy. -/
  P_vac : ∀ t, 0 ≤ t → P t vac = vac

attribute [instance] QFT.instNormed QFT.instInner QFT.instComplete

namespace QFT

variable (T : QFT)

/-- The states orthogonal to the vacuum, i.e. the physical excitations. -/
def IsExcitation (ψ : T.Hilb) : Prop := ⟪T.vac, ψ⟫_ℂ = 0

/-- `T` has a mass gap `Δ`: the Hamiltonian is bounded below by `Δ` on the orthogonal
complement of the vacuum, expressed (equivalently) as the exponential decay
`‖e^{-tH} ψ‖ ≤ e^{-Δ t} ‖ψ‖` of the Euclidean-time semigroup on that subspace. -/
def HasMassGap (Δ : ℝ) : Prop :=
  ∀ ψ : T.Hilb, T.IsExcitation ψ → ∀ t : ℝ, 0 ≤ t → ‖T.P t ψ‖ ≤ Real.exp (-Δ * t) * ‖ψ‖

end QFT

/-! ## Yang–Mills theories -/

/-- Euclidean space-time `ℝ⁴`. -/
abbrev Spacetime : Type := EuclideanSpace ℝ (Fin 4)

/-- The time-zero slice `ℝ³` of `ℝ⁴`. -/
abbrev Slice : Type := EuclideanSpace ℝ (Fin 3)

/-- A (partial, Hilbert-space level) axiomatization of a quantum Yang–Mills theory on `ℝ⁴`
with compact gauge group `G`.

On top of the vacuum-sector data of a quantum field theory we require:

* a unitary representation of the spatial translation group `ℝ³` on the physical
  Hilbert space, fixing the vacuum and commuting with Euclidean time evolution;
* gauge-invariant Wilson-loop observables `wilson γ χ` — the observable
  `χ (hol γ)` obtained by evaluating a continuous class function `χ` of the gauge group
  on the holonomy of the gauge field around the (time-zero) loop `γ` — which are
  additive in `χ`, reduce to the identity operator for the trivial weight, and
  transform covariantly under spatial translations;
* non-triviality of the theory: there is a non-zero state orthogonal to the vacuum.

This is the structure with respect to which the mass gap is stated. -/
structure YangMillsTheory (G : Type) [Group G] [TopologicalSpace G] [CompactSpace G]
    extends QFT where
  /-- Unitary implementation of the spatial translations of the time-zero slice `ℝ³`. -/
  transl : Slice → (Hilb ≃ₗᵢ[ℂ] Hilb)
  transl_zero : ∀ x, transl 0 x = x
  transl_add : ∀ a b x, transl (a + b) x = transl a (transl b x)
  transl_vac : ∀ a, transl a vac = vac
  transl_comm : ∀ a t, 0 ≤ t → ∀ x, P t (transl a x) = transl a (P t x)
  /-- Wilson loop observables, indexed by a loop in the time-zero slice and a continuous
  class function (weight) on the gauge group. -/
  wilson : C(Circle, Slice) → C(G, ℂ) → (Hilb →L[ℂ] Hilb)
  wilson_add : ∀ γ χ₁ χ₂ x, wilson γ (χ₁ + χ₂) x = wilson γ χ₁ x + wilson γ χ₂ x
  wilson_one : ∀ γ x, wilson γ 1 x = x
  wilson_transl : ∀ γ χ a x,
    transl a (wilson γ χ x) =
      wilson ⟨fun z => γ z + a, by fun_prop⟩ χ (transl a x)
  /-- The theory is non-trivial: the vacuum is not the whole story. -/
  nontrivial_sector : ∃ ψ : Hilb, ⟪vac, ψ⟫_ℂ = 0 ∧ ψ ≠ 0

/-- The Millennium Prize statement: for the compact gauge group `G` there exists a quantum
Yang–Mills theory on `ℝ⁴` with a strictly positive mass gap. -/
def YangMillsMassGapStatement (G : Type) [Group G] [TopologicalSpace G] [CompactSpace G] :
    Prop :=
  ∃ T : YangMillsTheory G, ∃ Δ : ℝ, 0 < Δ ∧ T.toQFT.HasMassGap Δ

/-! ## The reduction: a single-time contraction bound implies a mass gap -/

/-- An elementary real-analysis lemma: if `a ^ (2 ^ k) ≤ K * b ^ (2 ^ k)` for every `k`
with a fixed constant `K > 0`, then `a ≤ b`.  This is what removes the constant from a
"exponential decay up to a constant" bound. -/
theorem le_of_pow_two_pow_le {a b K : ℝ} (hb : 0 ≤ b) (hK : 0 < K)
    (h : ∀ k : ℕ, a ^ (2 ^ k) ≤ K * b ^ (2 ^ k)) : a ≤ b := by
  by_contra hlt
  push_neg at hlt
  rcases eq_or_lt_of_le hb with hb0 | hb0
  · have h1 := h 1
    rw [← hb0] at h1
    norm_num at h1
    nlinarith
  · have hr : 1 < a / b := (one_lt_div hb0).mpr hlt
    obtain ⟨n, hn⟩ := pow_unbounded_of_one_lt K hr
    have h2 : (a / b) ^ n ≤ (a / b) ^ (2 ^ n) :=
      pow_le_pow_right₀ hr.le (Nat.lt_two_pow_self).le
    have h3 : (a / b) ^ (2 ^ n) ≤ K := by
      rw [div_pow, div_le_iff₀ (by positivity)]
      linarith [h n]
    linarith

namespace QFT

variable {T : QFT}

/-- Euclidean time evolution preserves the orthogonal complement of the vacuum. -/
theorem isExcitation_P {ψ : T.Hilb} (hψ : T.IsExcitation ψ) {t : ℝ} (ht : 0 ≤ t) :
    T.IsExcitation (T.P t ψ) := by
  show ⟪T.vac, T.P t ψ⟫_ℂ = 0
  rw [← T.P_symm t ht, T.P_vac t ht]
  exact hψ

/-- Iterating a single-time contraction bound on the excitation subspace. -/
theorem norm_P_nsmul_le {t₀ c : ℝ} (ht₀ : 0 ≤ t₀) (hc0 : 0 ≤ c)
    (h : ∀ ψ : T.Hilb, T.IsExcitation ψ → ‖T.P t₀ ψ‖ ≤ c * ‖ψ‖)
    (n : ℕ) {ψ : T.Hilb} (hψ : T.IsExcitation ψ) :
    ‖T.P (n * t₀) ψ‖ ≤ c ^ n * ‖ψ‖ := by
  induction n with
  | zero => simp [T.P_zero]
  | succ n ih =>
      have hxn : T.IsExcitation (T.P (n * t₀) ψ) := isExcitation_P hψ (by positivity)
      have hsplit : T.P ((n + 1 : ℕ) * t₀) ψ = T.P t₀ (T.P (n * t₀) ψ) := by
        rw [← T.P_add t₀ (n * t₀) ht₀ (by positivity)]
        push_cast
        ring_nf
      calc ‖T.P ((n + 1 : ℕ) * t₀) ψ‖ = ‖T.P t₀ (T.P (n * t₀) ψ)‖ := by rw [hsplit]
        _ ≤ c * ‖T.P (n * t₀) ψ‖ := h _ hxn
        _ ≤ c * (c ^ n * ‖ψ‖) := mul_le_mul_of_nonneg_left ih hc0
        _ = c ^ (n + 1) * ‖ψ‖ := by ring

/-- A single-time contraction bound gives exponential decay with a (non-optimal) constant. -/
theorem norm_P_le_const_exp {t₀ c : ℝ} (ht₀ : 0 < t₀) (hc0 : 0 < c) (hc1 : c < 1)
    (h : ∀ ψ : T.Hilb, T.IsExcitation ψ → ‖T.P t₀ ψ‖ ≤ c * ‖ψ‖)
    {ψ : T.Hilb} (hψ : T.IsExcitation ψ) {t : ℝ} (ht : 0 ≤ t) :
    ‖T.P t ψ‖ ≤ c⁻¹ * (Real.exp (Real.log c / t₀ * t) * ‖ψ‖) := by
  set n : ℕ := ⌊t / t₀⌋₊ with hn
  have hfloor : (n : ℝ) ≤ t / t₀ := Nat.floor_le (by positivity)
  have hfloor' : t / t₀ < n + 1 := Nat.lt_floor_add_one _
  have hnt : (n : ℝ) * t₀ ≤ t := by
    have := mul_le_mul_of_nonneg_right hfloor ht₀.le
    rwa [div_mul_cancel₀ _ ht₀.ne'] at this
  have hdecomp : ‖T.P t ψ‖ ≤ c ^ n * ‖ψ‖ := by
    have h1 : T.P t ψ = T.P (t - n * t₀) (T.P (n * t₀) ψ) := by
      rw [← T.P_add _ _ (by linarith) (by positivity)]
      congr 1
      ring
    rw [h1]
    calc ‖T.P (t - n * t₀) (T.P (n * t₀) ψ)‖ ≤ ‖T.P (n * t₀) ψ‖ :=
          T.P_contract _ (by linarith) _
      _ ≤ c ^ n * ‖ψ‖ := norm_P_nsmul_le ht₀.le hc0.le h n hψ
  have hlog : Real.log c < 0 := Real.log_neg hc0 hc1
  have hc_pow : c ^ n = Real.exp ((n : ℝ) * Real.log c) := by
    rw [Real.exp_nat_mul, Real.exp_log hc0]
  have hinv : c⁻¹ = Real.exp (-Real.log c) := by
    rw [Real.exp_neg, Real.exp_log hc0]
  have hrw : Real.log c / t₀ * t = (t / t₀) * Real.log c := by
    field_simp
  have key : (n : ℝ) * Real.log c ≤ -Real.log c + Real.log c / t₀ * t := by
    have h1 : t / t₀ - 1 ≤ (n : ℝ) := by linarith
    have h2 : (n : ℝ) * Real.log c ≤ (t / t₀ - 1) * Real.log c :=
      mul_le_mul_of_nonpos_right h1 hlog.le
    rw [hrw]
    nlinarith
  calc ‖T.P t ψ‖ ≤ c ^ n * ‖ψ‖ := hdecomp
    _ ≤ (c⁻¹ * Real.exp (Real.log c / t₀ * t)) * ‖ψ‖ := by
        refine mul_le_mul_of_nonneg_right ?_ (norm_nonneg _)
        rw [hc_pow, hinv, ← Real.exp_add]
        exact Real.exp_le_exp.mpr key
    _ = c⁻¹ * (Real.exp (Real.log c / t₀ * t) * ‖ψ‖) := by ring

/-- Self-adjointness upgrade: `‖P t ψ‖ ^ 2 ≤ ‖ψ‖ * ‖P (2 t) ψ‖`. -/
theorem norm_P_sq_le {t : ℝ} (ht : 0 ≤ t) (ψ : T.Hilb) :
    ‖T.P t ψ‖ ^ 2 ≤ ‖ψ‖ * ‖T.P (2 * t) ψ‖ := by
  have h1 : ⟪T.P t ψ, T.P t ψ⟫_ℂ = ⟪ψ, T.P (2 * t) ψ⟫_ℂ := by
    rw [two_mul, T.P_add t t ht ht, T.P_symm t ht]
  have h2 : ‖T.P t ψ‖ ^ 2 = (⟪T.P t ψ, T.P t ψ⟫_ℂ).re := norm_sq_eq_re_inner (𝕜 := ℂ) _
  rw [h2, h1]
  calc (⟪ψ, T.P (2 * t) ψ⟫_ℂ).re ≤ ‖⟪ψ, T.P (2 * t) ψ⟫_ℂ‖ := Complex.re_le_norm _
    _ ≤ ‖ψ‖ * ‖T.P (2 * t) ψ‖ := norm_inner_le_norm _ _

/-- Iterated self-adjointness upgrade. -/
theorem norm_P_pow_le {t : ℝ} (ht : 0 ≤ t) (ψ : T.Hilb) (k : ℕ) :
    ‖T.P t ψ‖ ^ (2 ^ k) ≤ ‖ψ‖ ^ (2 ^ k - 1) * ‖T.P (2 ^ k * t) ψ‖ := by
  induction k with
  | zero => simp
  | succ k ih =>
      have hone : 1 ≤ 2 ^ k := Nat.one_le_two_pow
      have hsq : ‖T.P ((2 : ℝ) ^ k * t) ψ‖ ^ 2 ≤ ‖ψ‖ * ‖T.P (2 * ((2 : ℝ) ^ k * t)) ψ‖ :=
        norm_P_sq_le (by positivity) ψ
      have e1 : ‖T.P t ψ‖ ^ (2 ^ (k + 1)) = (‖T.P t ψ‖ ^ (2 ^ k)) ^ 2 := by
        rw [← pow_mul]
        ring_nf
      have e2 : ‖ψ‖ ^ (2 ^ (k + 1) - 1) = ‖ψ‖ ^ (2 * (2 ^ k - 1)) * ‖ψ‖ := by
        rw [← pow_succ]
        congr 1
        have : 2 ^ (k + 1) = 2 * 2 ^ k := by ring
        omega
      have e3 : (2 : ℝ) ^ (k + 1) * t = 2 * ((2 : ℝ) ^ k * t) := by ring
      calc ‖T.P t ψ‖ ^ (2 ^ (k + 1)) = (‖T.P t ψ‖ ^ (2 ^ k)) ^ 2 := e1
        _ ≤ (‖ψ‖ ^ (2 ^ k - 1) * ‖T.P ((2 : ℝ) ^ k * t) ψ‖) ^ 2 :=
            pow_le_pow_left₀ (by positivity) ih 2
        _ = ‖ψ‖ ^ (2 * (2 ^ k - 1)) * ‖T.P ((2 : ℝ) ^ k * t) ψ‖ ^ 2 := by
            rw [mul_pow, ← pow_mul, mul_comm (2 ^ k - 1) 2]
        _ ≤ ‖ψ‖ ^ (2 * (2 ^ k - 1)) * (‖ψ‖ * ‖T.P (2 * ((2 : ℝ) ^ k * t)) ψ‖) :=
            mul_le_mul_of_nonneg_left hsq (by positivity)
        _ = ‖ψ‖ ^ (2 ^ (k + 1) - 1) * ‖T.P ((2 : ℝ) ^ (k + 1) * t) ψ‖ := by
            rw [e2, e3]; ring

/-- **Main reduction.** For the vacuum sector of a Euclidean quantum field theory, a
contraction bound `‖P t₀ ψ‖ ≤ c ‖ψ‖` with `c < 1` at a *single* positive Euclidean time,
valid on the orthogonal complement of the vacuum, already implies a mass gap
`Δ = -log c / t₀ > 0` (with the sharp exponential rate). -/
theorem hasMassGap_of_contraction {t₀ c : ℝ} (ht₀ : 0 < t₀) (hc0 : 0 < c) (hc1 : c < 1)
    (h : ∀ ψ : T.Hilb, T.IsExcitation ψ → ‖T.P t₀ ψ‖ ≤ c * ‖ψ‖) :
    T.HasMassGap (-Real.log c / t₀) := by
  intro ψ hψ t ht
  have hgoal : Real.exp (-(-Real.log c / t₀) * t) * ‖ψ‖
      = Real.exp (Real.log c / t₀ * t) * ‖ψ‖ := by
    congr 2
    ring
  rw [hgoal]
  refine le_of_pow_two_pow_le (b := Real.exp (Real.log c / t₀ * t) * ‖ψ‖)
    (by positivity) (inv_pos.mpr hc0) (fun k => ?_)
  have hexp : Real.exp (Real.log c / t₀ * ((2 : ℝ) ^ k * t))
      = Real.exp (Real.log c / t₀ * t) ^ (2 ^ k) := by
    rw [← Real.exp_nat_mul]
    congr 1
    push_cast
    ring
  have hpsi : ‖ψ‖ ^ (2 ^ k - 1) * ‖ψ‖ = ‖ψ‖ ^ (2 ^ k) := by
    rw [← pow_succ]
    congr 1
    have : 1 ≤ 2 ^ k := Nat.one_le_two_pow
    omega
  calc ‖T.P t ψ‖ ^ (2 ^ k)
      ≤ ‖ψ‖ ^ (2 ^ k - 1) * ‖T.P ((2 : ℝ) ^ k * t) ψ‖ := norm_P_pow_le ht ψ k
    _ ≤ ‖ψ‖ ^ (2 ^ k - 1) *
          (c⁻¹ * (Real.exp (Real.log c / t₀ * ((2 : ℝ) ^ k * t)) * ‖ψ‖)) := by
        refine mul_le_mul_of_nonneg_left ?_ (by positivity)
        exact norm_P_le_const_exp ht₀ hc0 hc1 h hψ (by positivity)
    _ = c⁻¹ * ((Real.exp (Real.log c / t₀ * t) * ‖ψ‖) ^ (2 ^ k)) := by
        rw [hexp, mul_pow]
        rw [← hpsi]
        ring

end QFT

/-! ## The target statement -/

/-- **Yang–Mills mass gap (Lean-checked reduction).**

For every compact gauge group `G`: if there exists a quantum Yang–Mills theory on `ℝ⁴`
whose Euclidean-time semigroup is a strict contraction on the orthogonal complement of the
vacuum at *some single* positive time, then there exists a quantum Yang–Mills theory on `ℝ⁴`
with a strictly positive mass gap.

The hypothesis is the (still open) constructive input — the existence of the Yang–Mills
measure together with one uniform contraction estimate; the conclusion is the Millennium
Prize statement `YangMillsMassGapStatement G`. Everything after the constructive input is
verified here: the single-time estimate is upgraded to the sharp exponential decay rate
`Δ = -log c / t₀` for all Euclidean times. -/
theorem yang_mills_mass_gap (G : Type) [Group G] [TopologicalSpace G] [CompactSpace G]
    (hYM : ∃ T : YangMillsTheory G, ∃ t₀ : ℝ, 0 < t₀ ∧ ∃ c : ℝ, 0 < c ∧ c < 1 ∧
      ∀ ψ : T.Hilb, T.toQFT.IsExcitation ψ → ‖T.P t₀ ψ‖ ≤ c * ‖ψ‖) :
    YangMillsMassGapStatement G := by
  obtain ⟨T, t₀, ht₀, c, hc0, hc1, h⟩ := hYM
  refine ⟨T, -Real.log c / t₀, ?_, QFT.hasMassGap_of_contraction ht₀ hc0 hc1 h⟩
  have : Real.log c < 0 := Real.log_neg hc0 hc1
  exact div_pos (neg_pos.mpr this) ht₀

end Frontier

