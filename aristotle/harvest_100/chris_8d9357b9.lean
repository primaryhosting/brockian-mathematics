/-!
# Ed 25519 Verify Sound
Category: Proof-Carrying Apps
Target: PCA.Cert.ed25519_verify_sound
Verification: pending
Provenance: Aristotle theorem prover (Harmonic)
-/

namespace PCA.Cert

/-- The Ed25519 group order
`ℓ = 2^252 + 27742317777372353535851937790883648493`,
the (prime) order of the standard base point of `edwards25519`. -/
def ell : Nat := 2 ^ 252 + 27742317777372353535851937790883648493

/--
Abstract algebraic model of the Ed25519 setting: the prime-order subgroup of `edwards25519`
generated by the standard base point `B`, acted on by the ring of scalars taken modulo the
group order `ell`.

The carrier types are abstract; all the structure that the signature scheme's soundness
argument depends on is recorded as fields:

* `Scalar` is an additive abelian group with a multiplication (`smul`) that distributes over
  the action, i.e. exactly the fragment of the scalar ring `ZMod ell` that is used;
* `Pt` is an additive abelian group (the curve group);
* `act` is scalar multiplication of points, compatible with scalar addition and
  multiplication;
* `base_injective` says that `B` has exact order `ell`, i.e. distinct scalars (mod `ell`)
  give distinct multiples of `B`. This is the standard prime-order-subgroup hypothesis.
-/
structure Curve where
  /-- Scalars, i.e. residues modulo the group order. -/
  Scalar : Type
  /-- Points of the prime-order subgroup. -/
  Pt : Type
  /-- Addition of scalars. -/
  sadd : Scalar → Scalar → Scalar
  /-- Negation of scalars. -/
  sneg : Scalar → Scalar
  /-- The zero scalar. -/
  szero : Scalar
  /-- Multiplication of scalars. -/
  smul : Scalar → Scalar → Scalar
  /-- Addition of points. -/
  padd : Pt → Pt → Pt
  /-- Negation of points. -/
  pneg : Pt → Pt
  /-- The neutral point. -/
  pzero : Pt
  /-- Scalar multiplication of a point. -/
  act : Scalar → Pt → Pt
  /-- The base point. -/
  B : Pt
  /-- Associativity of point addition. -/
  padd_assoc : ∀ p q r, padd (padd p q) r = padd p (padd q r)
  /-- Commutativity of point addition. -/
  padd_comm : ∀ p q, padd p q = padd q p
  /-- Neutrality of `pzero`. -/
  padd_zero : ∀ p, padd p pzero = p
  /-- `pneg` gives additive inverses. -/
  padd_neg : ∀ p, padd p (pneg p) = pzero
  /-- `sneg` gives additive inverses of scalars. -/
  sadd_neg : ∀ a, sadd a (sneg a) = szero
  /-- The action is additive in the scalar. -/
  act_sadd : ∀ a b p, act (sadd a b) p = padd (act a p) (act b p)
  /-- The action is multiplicative in the scalar. -/
  act_smul : ∀ a b p, act (smul a b) p = act a (act b p)
  /-- The zero scalar acts trivially. -/
  act_szero : ∀ p, act szero p = pzero
  /-- The base point has exact order `ell`: distinct scalars give distinct multiples. -/
  base_injective : ∀ a b, act a B = act b B → a = b

namespace Curve

variable (C : Curve)

/-- Subtraction of scalars. -/
def ssub (a b : C.Scalar) : C.Scalar := C.sadd a (C.sneg b)

/-- `pzero` is also a left unit for point addition. -/
theorem zero_padd (p : C.Pt) : C.padd C.pzero p = p := by
  rw [C.padd_comm, C.padd_zero]

/-- Additive inverses in the point group are unique. -/
theorem pneg_unique {p q : C.Pt} (h : C.padd p q = C.pzero) : q = C.pneg p := by
  have h1 : C.padd (C.pneg p) (C.padd p q) = C.padd (C.pneg p) C.pzero := by rw [h]
  rw [← C.padd_assoc, C.padd_zero, C.padd_comm (C.pneg p) p, C.padd_neg, C.zero_padd] at h1
  exact h1

/-- A negated scalar acts as the negation of the action. -/
theorem act_sneg (a : C.Scalar) (p : C.Pt) : C.act (C.sneg a) p = C.pneg (C.act a p) := by
  refine C.pneg_unique ?_
  rw [← C.act_sadd, C.sadd_neg, C.act_szero]

/-- The action turns scalar subtraction into point subtraction. -/
theorem act_ssub (a b : C.Scalar) (p : C.Pt) :
    C.act (C.ssub a b) p = C.padd (C.act a p) (C.pneg (C.act b p)) := by
  rw [ssub, C.act_sadd, C.act_sneg]

end Curve

variable (C : Curve)

/-- The public key associated with the secret scalar `a`, namely `A = [a] B`. -/
def pubkey (a : C.Scalar) : C.Pt := C.act a C.B

/-- The commitment (the `R` component of a signature) for the nonce scalar `r`,
namely `R = [r] B`. -/
def commit (r : C.Scalar) : C.Pt := C.act r C.B

/-- The Ed25519 verification equation `[S] B = R + [h] A`, where `A` is the public key,
`(R, S)` is the candidate signature and `h` is the hash scalar `H(R, A, M)`. -/
def Verify (A R : C.Pt) (h S : C.Scalar) : Prop :=
  C.act S C.B = C.padd R (C.act h A)

/-- The Ed25519 signing algorithm, in its algebraic form: with secret scalar `a`, nonce
scalar `r` and hash function `H`, the signature of the message `m` is
`(R, S) = ([r] B, r + H(R, A, M) * a)`. -/
def sign {Msg : Type} (H : C.Pt → C.Pt → Msg → C.Scalar) (a r : C.Scalar) (m : Msg) :
    C.Pt × C.Scalar :=
  (commit C r, C.sadd r (C.smul (H (commit C r) (pubkey C a) m) a))

/-- The verification equation for a public key `[a] B` and a commitment `[r] B` holds
exactly when the scalar identity `S = r + h * a` holds. -/
theorem verify_iff_scalar (a r h S : C.Scalar) :
    Verify C (pubkey C a) (commit C r) h S ↔ S = C.sadd r (C.smul h a) := by
  have key : C.act (C.sadd r (C.smul h a)) C.B
      = C.padd (commit C r) (C.act h (pubkey C a)) := by
    rw [C.act_sadd, C.act_smul, commit, pubkey]
  constructor
  · intro hv
    refine C.base_injective _ _ ?_
    rw [hv, key]
  · intro hv
    rw [Verify, hv, key]

/-- Completeness: an honestly produced Ed25519 signature always verifies. -/
theorem ed25519_verify_complete {Msg : Type} (H : C.Pt → C.Pt → Msg → C.Scalar)
    (a r : C.Scalar) (m : Msg) :
    Verify C (pubkey C a) (sign C H a r m).1
      (H (sign C H a r m).1 (pubkey C a) m) (sign C H a r m).2 :=
  (verify_iff_scalar C a r (H (commit C r) (pubkey C a) m)
    (C.sadd r (C.smul (H (commit C r) (pubkey C a) m) a))).2 rfl

/-- Extraction: any accepted signature for the public key `A = [a] B` determines the
discrete logarithm of its commitment, namely `R = [S - h * a] B`. In particular every
accepting signature has the honest algebraic shape. -/
theorem verify_extract (a h S : C.Scalar) (R : C.Pt)
    (hv : Verify C (pubkey C a) R h S) :
    R = C.act (C.ssub S (C.smul h a)) C.B := by
  rw [C.act_ssub]
  rw [Verify, pubkey, ← C.act_smul] at hv
  rw [hv, C.padd_assoc, C.padd_neg, C.padd_zero]

/--
**Ed25519 verification is sound and complete** with respect to the signing algorithm.

For a key pair with secret scalar `a` and a nonce `r`, the verification equation accepts the
candidate signature `([r] B, S)` on the message `m` *if and only if* `([r] B, S)` is exactly
the signature produced by the signing algorithm on `(a, r, m)`.

The forward implication is soundness: nothing except the honest signature is accepted, so an
accepting signature witnesses the relation `S = r + H(R, A, M) * a`. The backward implication
is completeness: the honest signature is always accepted.
-/
theorem ed25519_verify_sound {Msg : Type} (H : C.Pt → C.Pt → Msg → C.Scalar)
    (a r : C.Scalar) (m : Msg) (S : C.Scalar) :
    Verify C (pubkey C a) (commit C r) (H (commit C r) (pubkey C a) m) S
      ↔ (commit C r, S) = sign C H a r m := by
  rw [verify_iff_scalar, sign, Prod.mk.injEq]
  constructor
  · intro h; exact ⟨rfl, h⟩
  · intro h; exact h.2

end PCA.Cert

import Mathlib
import PCA.Cert

/-!
# A concrete instance of the Ed25519 algebraic model

This file witnesses that `PCA.Cert.Curve` is inhabited, so that the soundness and
completeness theorems of `PCA.Cert` are not vacuous: the cyclic group `ZMod n` with scalar
ring `ZMod n`, acting by multiplication and generated by `B = 1`, satisfies all the axioms
of the model (in particular the base point has exact order `n`).
-/

namespace PCA.Cert

set_option autoImplicit false

/-- The cyclic model: scalars and points are both `ZMod n`, the action is multiplication and
the base point is `1`. -/
def cyclicCurve (n : ℕ) : Curve where
  Scalar := ZMod n
  Pt := ZMod n
  sadd := (· + ·)
  sneg := (- ·)
  szero := 0
  smul := (· * ·)
  padd := (· + ·)
  pneg := (- ·)
  pzero := 0
  act := (· * ·)
  B := 1
  padd_assoc := add_assoc
  padd_comm := add_comm
  padd_zero := add_zero
  padd_neg := fun p => add_neg_cancel p
  sadd_neg := fun a => add_neg_cancel a
  act_sadd := fun a b p => add_mul a b p
  act_smul := fun a b p => mul_assoc a b p
  act_szero := fun p => zero_mul p
  base_injective := fun a b h => by simpa using h

/-- The Ed25519-sized instance of the model, with scalars modulo the group order `ell`. -/
def ed25519Curve : Curve := cyclicCurve ell

end PCA.Cert

