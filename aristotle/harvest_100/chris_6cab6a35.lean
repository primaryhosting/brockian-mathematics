  match n.val with
  | 0 => {(⟨1,by decide⟩, ⟨4,by decide⟩), (⟨2,by decide⟩, ⟨3,by decide⟩),
          (⟨3,by decide⟩, ⟨2,by decide⟩), (⟨4,by decide⟩, ⟨1,by decide⟩)}
  | 2 => {(⟨1,by decide⟩, ⟨1,by decide⟩), (⟨3,by decide⟩, ⟨4,by decide⟩),
          (⟨4,by decide⟩, ⟨3,by decide⟩)}
  | 4 => {(⟨1,by decide⟩, ⟨3,by decide⟩), (⟨2,by decide⟩, ⟨2,by decide⟩),
          (⟨3,by decide⟩, ⟨1,by decide⟩)}
  | _ => ∅

theorem prime_unique_ray (p : ℕ) (hp : p.Prime) (h : p > 5) :
    ∃! j : ActiveRay, ray p = activeRayToResidue j := by
      -- Since $p$ is a prime greater than 5, $ray p$ cannot be 0. Therefore, $ray p$ must be one of 1, 2, 3, or 4.
      have h_ray_nonzero : ray p ≠ ⟨0, by decide⟩ := by
        -- By the ray_unique_factorization theorem, there exists a unique r such that ray p = r.
        apply ray_zero_singularity p hp h;
      -- Since $ray p$ is not 0, it must be one of 1, 2, 3, or 4. For each of these cases, there's a unique $j$ that maps to $ray p$ via $activeRayToResidue$.
      have h_cases : ∀ r : RaySpace, r ≠ ⟨0, by decide⟩ → ∃! j : ActiveRay, r = activeRayToResidue j := by
        simp +decide [ ExistsUnique ];
        simp +decide [ Fin.forall_fin_succ, Fin.exists_fin_succ, ActiveRay, RaySpace ];
      -- Apply the hypothesis `h_cases` to `ray p` and `h_ray_nonzero`.
      apply h_cases; assumption

theorem ray_has_primes (j : ActiveRay) :
    ∀ N : ℕ, ∃ p > N, p.Prime ∧ ray p = activeRayToResidue j := by
      intro N
      have h_inf_primes : Set.Infinite {p : ℕ | Nat.Prime p ∧ ray p = activeRayToResidue j} := by
        -- By Dirichlet's theorem on arithmetic progressions, there are infinitely many primes in the residue class $j \mod 5$.
        have h_dirichlet : ∀ j : Fin 5, j ≠ ⟨0, by decide⟩ → Set.Infinite {p : ℕ | Nat.Prime p ∧ p % 5 = j.val} := by
          intro j hj_ne_zero
          have h_dirichlet : Set.Infinite {p : ℕ | Nat.Prime p ∧ p % 5 = j.val} := by
            have := @Nat.setOf_prime_and_eq_mod_infinite;
            convert @this 5 ( by infer_instance ) ( j : ZMod 5 ) _ using 1;
            · simp +decide [ Fin.ext_iff, ZMod ];
            · fin_cases j <;> simp_all +decide
          exact h_dirichlet;
        convert h_dirichlet ( activeRayToResidue j ) _ using 1;
        · exact Set.ext fun x => and_congr_right fun hx => by erw [ Fin.ext_iff ] ; rfl;
        · exact ne_of_gt ( Nat.succ_pos _ );
      exact Exists.imp ( by aesop ) ( h_inf_primes.exists_gt N )

theorem euler_totient : Nat.totient 5 = 4 := by rfl

noncomputable def ω : ℂ := Complex.exp (2 * Real.pi * Complex.I / 5)

theorem omega_primitive : ω ^ 5 = 1 ∧ ∀ k : ℕ, k < 5 → k > 0 → ω ^ k ≠ 1 := by
  constructor
  · rw [show ω = Complex.exp (2 * Real.pi * Complex.I / 5) by rfl]
    rw [← Complex.exp_nat_mul, mul_comm]
    norm_num
  · unfold ω
    have h_primitive : ∀ k : ℕ, k < 5 → k > 0 → Complex.exp (2 * Real.pi * Complex.I * k / 5) ≠ 1 := by
      intro k hk_lt hk_pos
      by_contra h_eq_one
      have h_int : ∃ m : ℤ, 2 * Real.pi * k / 5 = 2 * Real.pi * m := by
        rw [Complex.exp_eq_one_iff] at h_eq_one
        obtain ⟨m, hm⟩ := h_eq_one
        exact ⟨m, by norm_num [Complex.ext_iff] at hm; linarith⟩
      obtain ⟨m, hm⟩ : ∃ m : ℤ, k = 5 * m := by
        exact ⟨h_int.choose, by 
          rw [← @Int.cast_inj ℝ]
          push_cast
          nlinarith [Real.pi_pos, h_int.choose_spec]⟩
      omega
    exact fun k hk₁ hk₂ => by 
      rw [← Complex.exp_nat_mul]
      convert h_primitive k hk₁ hk₂ using 1
      ring

theorem fifth_roots_sum_zero :
    ∑ k : Fin 5, ω ^ k.val = 0 := by
  have h_sum : ∑ k ∈ Finset.range 5, ω ^ k = 0 := by
    have h_omega_5 : ω ^ 5 = 1 := by
      have h_omega_def : ω = Complex.exp (2 * Real.pi * Complex.I / 5) := by simp [ω]
      rw [h_omega_def, ← Complex.exp_nat_mul, mul_comm]
      norm_num
    have h_omega_ne_one : ω ≠ 1 := by
      unfold ω
      norm_num [Complex.ext_iff, Complex.exp_re, Complex.exp_im]
      exact fun _ => ne_of_gt (Real.sin_pos_of_pos_of_lt_pi (by positivity) (by linarith [Real.pi_pos]))
    rw [geom_sum_eq] <;> aesop
  rwa [Finset.sum_range] at h_sum

def ind (n : ℕ) : ℕ :=
  match n % 5 with
  | 1 => 0
  | 2 => 1
  | 3 => 3
  | 4 => 2
  | _ => 0

noncomputable def χ (j : Fin 4) (n : ℕ) : ℂ :=
  if Nat.Coprime n 5 then
    Complex.exp (2 * Real.pi * Complex.I * (j.val + 1 : ℂ) * (ind n : ℂ) / 4)
  else 0

theorem chi_multiplicative (j : Fin 4) (a b : ℕ) :
    χ j (a * b) = χ j a * χ j b := by
  unfold χ
  split_ifs <;> simp_all [Nat.coprime_mul_iff_left, Nat.coprime_mul_iff_right]
  have h_ind : ind (a * b) ≡ ind a + ind b [MOD 4] := by
    have h_ind : ∀ a b : ℕ, Nat.Coprime a 5 → Nat.Coprime b 5 → 
        ind (a * b) ≡ ind a + ind b [MOD 4] := by
      intros a b ha hb
      have h_cases : ∀ a b : ℕ, a % 5 = 1 ∨ a % 5 = 2 ∨ a % 5 = 3 ∨ a % 5 = 4 → 
          b % 5 = 1 ∨ b % 5 = 2 ∨ b % 5 = 3 ∨ b % 5 = 4 → 
          ind (a * b) ≡ ind a + ind b [MOD 4] := by
        rintro a b (ha | ha | ha | ha) (hb | hb | hb | hb) <;> 
        norm_num [Nat.ModEq, Nat.add_mod, Nat.mul_mod, ha, hb, ind]
      exact h_cases a b (by 
        rw [Nat.Coprime, Nat.gcd_comm, Nat.gcd_rec] at ha
        have := Nat.mod_lt a (by decide : 5 > 0)
        interval_cases a % 5 <;> trivial) (by 
        rw [Nat.Coprime, Nat.gcd_comm, Nat.gcd_rec] at hb
        have := Nat.mod_lt b (by decide : 5 > 0)
        interval_cases b % 5 <;> trivial)
    exact h_ind a b ‹_› ‹_›
  rw [← Complex.exp_add]
  obtain ⟨k, hk⟩ := h_ind.symm.dvd
  ring
  rw [Complex.exp_eq_exp_iff_exists_int]
  exact ⟨k * (j + 1), by 
    push_cast [← @Int.cast_inj ℂ] at *
    linear_combination hk * (Real.pi * Complex.I * (j + 1) / 2)⟩

theorem chi_periodic (j : Fin 4) (n : ℕ) :
    χ j (n + 5) = χ j n := by
  have h_periodic : ∀ n : ℕ, χ j (n + 5) = χ j n := by
    intro n
    simp [χ]
    have h_ind_periodic : ∀ n : ℕ, ind (n + 5) = ind n := by
      intros n
      simp [ind]
    simp [h_ind_periodic]
  exact h_periodic n

noncomputable def L_function (j : Fin 4) (s : ℂ) : ℂ :=
  ∑' n : ℕ, if n = 0 then 0 else χ j n / (n : ℂ)^s

noncomputable def twinMatrix : Matrix (Fin 3) (Fin 3) ℝ :=
  ![![1/3, 1/3, 1/3],
    ![1/3, 1/3, 1/3],
    ![1/3, 1/3, 1/3]]

theorem twin_matrix_stochastic :
    (∀ i, ∑ j, twinMatrix i j = 1) ∧ (∀ j, ∑ i, twinMatrix i j = 1) := by
  simp [twinMatrix]
  norm_num [Fin.forall_fin_succ, Fin.sum_univ_succ]

theorem stationary_uniform :
    let v : Fin 3 → ℝ := fun _ => 1/3
    ∀ i, ∑ j, twinMatrix j i * v j = v i := by
  simp [twinMatrix]
  intro i
  simp [Fin.sum_univ_succ, Fin.sum_univ_zero]
  field_simp
  ring
  fin_cases i <;> norm_num

noncomputable def spectral_gap (M : Matrix (Fin 3) (Fin 3) ℝ) : ℝ := 0

instance : Fintype RaySpace := inferInstanceAs (Fintype (Fin 5))

noncomputable def rayFourier (f : RaySpace → ℂ) (k : Fin 5) : ℂ :=
  ∑ j : RaySpace, f j * ω^(j.val * k.val)

theorem fourier_inversion (f : RaySpace → ℂ) (j : RaySpace) :
    f j = (1 / 5 : ℂ) * ∑ k : Fin 5, rayFourier f k * ω^(-(j.val * k.val : ℤ)) := by
  have h_fubini : ∑ k : Fin 5, (∑ j' : Fin 5, f (ray j') * ω^(k.val * j'.val : ℤ)) * 
      ω^(-((j.val : ℤ) * k.val : ℤ)) = 
      ∑ j' : Fin 5, f (ray j') * (∑ k : Fin 5, ω^(k.val * (j'.val - j.val : ℤ) : ℤ)) := by
    simp only [mul_comm, Finset.mul_sum _ _ _, mul_assoc]
    rw [Finset.sum_comm]
    congr
    ext
    congr
    ext
    ring
    simp [mul_assoc, sub_eq_add_neg, zpow_add₀ (show ω ≠ 0 from Complex.exp_ne_zero _)]
  have h_root_of_unity : ∀ j' j : Fin 5, 
      ∑ k : Fin 5, ω^(k.val * (j'.val - j.val : ℤ) : ℤ) = if j' = j then 5 else 0 := by
    intro j' j
    split_ifs <;> simp_all [zpow_mul']
    have h_geo_series : ∑ k ∈ Finset.range 5, (ω^(j'.val - j.val : ℤ))^k = 0 := by
      rw [geom_sum_eq] <;> norm_num [ω]
      · rw [← zpow_natCast, ← zpow_mul]
        norm_num [← Complex.exp_int_mul, mul_div_cancel₀]
        exact Or.inl (sub_eq_zero_of_eq <| Complex.exp_eq_one_iff.mpr ⟨j'.val - j, by push_cast; ring⟩)
      · rw [← Complex.exp_int_mul, mul_comm, Complex.exp_eq_one_iff]
        norm_num [Complex.ext_iff]
        intro x hx
        exact ‹¬j' = j› (Fin.ext <| by 
          rw [← @Nat.cast_inj ℝ]
          nlinarith [Real.pi_pos, 
            show (x : ℝ) = 0 by rcases x with ⟨_ | _ | x⟩ <;> norm_num at * <;> 
              nlinarith [Real.pi_pos, 
                show (j' : ℝ) < 5 by exact_mod_cast Fin.is_lt j', 
                show (j : ℝ) < 5 by exact_mod_cast Fin.is_lt j]])
    simpa only [Finset.sum_range] using h_geo_series
  simp_all [Finset.sum_ite, Finset.filter_eq', Finset.filter_ne']
  convert congr_arg (fun x : ℂ => x / 5) h_fubini.symm using 1
  ring!
  · congr! 1
    exact Eq.symm (Fin.ext <| Nat.mod_eq_of_lt <| Fin.is_lt _)
  · norm_num [rayFourier]
    ring!

noncomputable def π_ray (j : ActiveRay) (x : ℝ) : ℝ :=
  (Finset.filter (fun p => Nat.Prime p ∧ ray p = activeRayToResidue j) 
    (Finset.range (Nat.floor x + 1))).card

def rayℤ (n : ℤ) : RaySpace :=
  ⟨(n % 5).natAbs, by
    have h1 : 0 ≤ n % 5 := Int.emod_nonneg n (by decide)
    have h2 : n % 5 < 5 := Int.emod_lt_of_pos n (by decide)
    have : ((n % 5).natAbs : ℤ) = n % 5 := Int.natAbs_of_nonneg h1
    rw [← this] at h2
    exact Int.ofNat_lt.mp h2⟩

def reflectℤ (r : RaySpace) : RaySpace :=
  ⟨(5 - r.val) % 5, Nat.mod_lt _ (by decide)⟩

theorem reflect_Z_involution (r : RaySpace) :
    reflectℤ (reflectℤ r) = r := by
  apply Fin.ext
  unfold reflectℤ
  simp
  omega

structure GeneralizedFramework (q : ℕ) where
  ray_count : ℕ
  has_symmetry : Prop
  equidistribution : Prop
  golden_connection : Prop

def framework_7_exists : GeneralizedFramework 7 := {
  ray_count := Nat.totient 7,
  has_symmetry := True,
  equidistribution := True,
  golden_connection := True
}

def framework_11_exists : GeneralizedFramework 11 := {
  ray_count := Nat.totient 11,
  has_symmetry := True,
  equidistribution := True,
  golden_connection := True
}

instance : MeasurableSpace ActiveRay := ⊤

noncomputable def primeMeasure : MeasureTheory.Measure ActiveRay := 
  (1/4 : ENNReal) • MeasureTheory.Measure.count

theorem prime_measure_uniform :
    ∀ j : ActiveRay, primeMeasure {j} = 1/4 := by
  intros j
  simp [primeMeasure]

def rayWalk (n : ℕ) (start : ActiveRay) : ActiveRay :=
  ⟨(start.val + n) % 4, Nat.mod_lt _ (by decide)⟩

noncomputable def equal_constants_conjecture : Prop :=
  ∃ C : ℝ, ∀ (r₁ r₂ : RaySpace), TwinTransition r₁ r₂ → 
    ∃ C_trans : ℝ, C_trans = C / 3

noncomputable def pentagonal_RH : Prop :=
  ∀ j : Fin 4, ∀ ρ : ℂ, 
    L_function j ρ = 0 → ρ ≠ 0 → ρ ≠ 1 → ρ.re = 1/2

noncomputable def GUE_conjecture : Prop :=
  ∃ K : ℝ → ℝ,
    (∀ s ≥ 0, K s = (32 / Real.pi^2) * s^2 * Real.exp (-4 * s^2 / Real.pi)) ∧
    ∀ j : Fin 4, ∀ ε > 0, ∃ T₀ : ℝ, ∀ T > T₀, True

def unique_quadruplet : Prop :=
  ∀ p : ℕ, p.Prime → (p+2).Prime → (p+6).Prime → (p+8).Prime → p > 5 →
    ray p = ⟨1, by decide⟩ ∧
    ray (p+2) = ⟨3, by decide⟩ ∧
    ray (p+6) = ⟨2, by decide⟩ ∧
    ray (p+8) = ⟨4, by decide⟩

noncomputable def modular_form_exists : Prop :=
  ∃ Θ : ℂ → ℂ,
    (∀ τ : ℂ, Θ (τ + 1) = Θ τ) ∧
    (∀ τ : ℂ, τ.im > 0 → Θ (-1/τ) = 0) ∧
    ∀ j : Fin 4, True

noncomputable def pentagonal_gap_conjecture : Prop :=
  ∀ ε > 0, ∃ X₀, ∀ X > X₀,
    let gaps := {x | ∃ p : ℕ, p.Prime ∧ (p : ℝ) ≤ X ∧ x = p.succ - p}
    ∀ g ∈ gaps, ∃ k : ℕ, |(g : ℝ) - 5 * k| < ε * X

noncomputable def sato_tate_rays : Prop :=
  ∀ j : Fin 4, ∃ μ : MeasureTheory.Measure ℝ,
    ∀ a b : ℝ, a < b → True

def montgomery_conjecture : Prop :=
  ∀ ε : ℝ, ε > 0 → ∃ N₀ : ℕ, ∀ N > N₀, True

theorem negative_mirror_symmetry :
  ∀ n : ℕ, n > 0 → rayℤ (-(n : ℤ)) = reflectℤ (ray n) := by
    -- By definition of rayℤ and reflectℤ, we can show that for any positive integer n, rayℤ (-n) equals reflectℤ (ray n).
    intros n hn
    simp [rayℤ, reflectℤ, ray];
    -- Since $-n \equiv 5 - n \pmod{5}$, we have $(-n) \% 5 = (5 - n \% 5) \% 5$.
    have h_mod : (-n : ℤ) % 5 = (5 - n % 5) % 5 := by
      omega;
    -- Since $n$ is a natural number, $n \% 5$ is already a natural number, so the cast to ℤ doesn't change its value.
    norm_cast at *;
    -- Since $Int.subNatNat 5 (n \% 5)$ is equivalent to $(5 - n \% 5)$ as a natural number, we can conclude the equality.
    have h_nat : Int.subNatNat 5 (n % 5) = (5 - n % 5 : ℕ) := by
      -- Since $n \% 5$ is a natural number between 0 and 4, we can check each case individually.
      have h_cases : n % 5 < 5 := by
        exact Nat.mod_lt _ ( by decide );
      interval_cases n % 5 <;> trivial;
    aesop

def universal_framework : Prop :=
  ∀ q : ℕ, q.Prime → Nonempty (GeneralizedFramework q)

noncomputable def spectral_rigidity_conjecture : Prop :=
  ∃ Δ₃ : ℝ → ℝ, ∀ j : Fin 4, True

noncomputable def has_positive_spectral_gap : Prop :=
  spectral_gap twinMatrix > 0

noncomputable def phi : ℝ := (1 + Real.sqrt 5) / 2

noncomputable def golden_ratio : ℝ := phi

theorem golden_in_cosine :
    Real.cos (2 * Real.pi / 5) = (phi - 1) / 2 := by
  have h_cos_72 : Real.cos (2 * Real.pi / 5) = (Real.sqrt 5 - 1) / 4 := by
    have h_cos_72 : Real.cos (2 * Real.pi / 5) = 2 * (Real.cos (Real.pi / 5))^2 - 1 := by
      rw [← Real.cos_two_mul]
      ring
    set x : ℝ := Real.cos (Real.pi / 5)
    have hx_poly : 4 * x^2 - 2 * x - 1 = 0 := by
      have := Real.cos_three_mul (Real.pi / 5)
      rw [show 3 * (Real.pi / 5) = Real.pi - 2 * (Real.pi / 5) by ring, 
          Real.cos_pi_sub, Real.cos_two_mul] at this
      nlinarith [show 0 < Real.cos (Real.pi / 5) from 
        Real.cos_pos_of_mem_Ioo ⟨by linarith [Real.pi_pos], by linarith [Real.pi_pos]⟩]
    nlinarith [show 1/2 < Real.cos (Real.pi / 5) from by 
        nth_rw 1 [← Real.cos_pi_div_three]
        exact Real.cos_lt_cos_of_nonneg_of_le_pi (by positivity) (by linarith [Real.pi_pos]) (by linarith [Real.pi_pos]),
      Real.sqrt_nonneg 5, Real.sq_sqrt (show 0 ≤ 5 by norm_num)]
  exact h_cos_72.trans (by rw [show phi = (1 + Real.sqrt 5) / 2 by rfl]; ring)

theorem phi_equation : phi^2 = phi + 1 := by
  unfold phi
  field_simp
  ring_nf
  rw [Real.sq_sqrt (by norm_num : (0:ℝ) ≤ 5)]
  ring

theorem fibonacci_binet (n : ℕ) :
    (Nat.fib n : ℝ) = (phi^n - (1 - phi)^n) / Real.sqrt 5 := by
  have h_binet : ∀ n : ℕ, Nat.fib n = (phi^n - (1 - phi)^n) / Real.sqrt 5 := by
    intro n
    induction' n using Nat.strong_induction_on with n ih
    rcases n with (_ | _ | n) <;> norm_num [Nat.fib_add_two]
    · ring_nf
      norm_num [phi]
      field_simp
      ring
    · rw [ih n (by linarith), ih (n + 1) (by linarith)]
      ring
      rw [show phi = (1 + Real.sqrt 5) / 2 by rfl]
      ring
      norm_num
      ring
  exact h_binet n

noncomputable def golden_ratio_conjecture : Prop :=
  ∃ C_AC C_BD C_DA : ℝ,
    (C_AC / C_BD = phi) ∧ (C_BD / C_DA = phi) ∧
    C_AC + C_BD + C_DA = ∏' p : {p : ℕ // p.Prime ∧ p > 2}, (1 - 1 / ((p : ℝ) - 1)^2)
