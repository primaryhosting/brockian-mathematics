namespace Frontier

/-- **Infinitesimal invariance in coordinates.**

If the Lagrangian `L : ℝ × ℝ → ℝ` (position, velocity) has total derivative described by the
partials `Lq` (with respect to position) and `Lv` (with respect to velocity), and if `L` is
invariant to first order under the one-parameter family of transformations
`(x, y) ↦ (x + ε X x, y + ε X' x * y)` generated by the vector field `X` (with derivative `X'`),
then the pointwise identity `Lq * X + Lv * (X' * y) = 0` holds. -/
theorem noether_symmetry_identity
    (L Lq Lv : ℝ × ℝ → ℝ)
    (hL : ∀ p : ℝ × ℝ, HasFDerivAt L
      (Lq p • ContinuousLinearMap.fst ℝ ℝ ℝ + Lv p • ContinuousLinearMap.snd ℝ ℝ ℝ) p)
    (X X' : ℝ → ℝ) (x y : ℝ)
    (hsym : HasDerivAt (fun e : ℝ => L (x + e * X x, y + e * (X' x * y))) 0 0) :
    Lq (x, y) * X x + Lv (x, y) * (X' x * y) = 0 := by
  have hc : HasDerivAt (fun e : ℝ => (x + e * X x, y + e * (X' x * y))) (X x, X' x * y) 0 := by
    have h1 : HasDerivAt (fun e : ℝ => x + e * X x) (X x) 0 := by
      simpa using ((hasDerivAt_id (0:ℝ)).mul_const (X x)).const_add x
    have h2 : HasDerivAt (fun e : ℝ => y + e * (X' x * y)) (X' x * y) 0 := by
      simpa using ((hasDerivAt_id (0:ℝ)).mul_const (X' x * y)).const_add y
    exact h1.prodMk h2
  have hcomp := (hL ((fun e : ℝ => (x + e * X x, y + e * (X' x * y))) 0)).comp_hasDerivAt (0:ℝ) hc
  simp only [zero_mul, add_zero] at hcomp
  have h0 := hcomp.unique hsym
  simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply,
    ContinuousLinearMap.coe_fst', ContinuousLinearMap.coe_snd', smul_eq_mul] at h0
  linarith [h0]

/-- **The Noether current has vanishing derivative.**

Along a solution `q` of the Euler–Lagrange equation, the Noether current
`J t = Lv (q t, q' t) * X (q t)` has derivative `Lq * X + Lv * (X' * q')`, which vanishes by
infinitesimal invariance. -/
theorem noether_hasDerivAt_current
    (Lq Lv : ℝ × ℝ → ℝ) (X X' q v : ℝ → ℝ)
    (hX : ∀ x : ℝ, HasDerivAt X (X' x) x)
    (hq : ∀ t : ℝ, HasDerivAt q (v t) t)
    (hEL : ∀ t : ℝ, HasDerivAt (fun s : ℝ => Lv (q s, v s)) (Lq (q t, v t)) t)
    (hsym : ∀ x y : ℝ, Lq (x, y) * X x + Lv (x, y) * (X' x * y) = 0)
    (t : ℝ) :
    HasDerivAt (fun s : ℝ => Lv (q s, v s) * X (q s)) 0 t := by
  have hXq : HasDerivAt (fun s : ℝ => X (q s)) (X' (q t) * v t) t :=
    (hX (q t)).comp t (hq t)
  have h := (hEL t).mul hXq
  have hzero : Lq (q t, v t) * X (q t) + Lv (q t, v t) * (X' (q t) * v t) = 0 :=
    hsym (q t) (v t)
  simpa [hzero] using h

/-- **Noether's theorem, one-dimensional case.**

Let `L : ℝ × ℝ → ℝ` be a Lagrangian in position and velocity whose total derivative is given by
the partial derivatives `Lq` and `Lv`.  Let `X : ℝ → ℝ` be a smooth vector field with derivative
`X'`, generating the one-parameter family of transformations `x ↦ x + ε X x` (with the induced
action `y ↦ y + ε X' x * y` on velocities).  Assume the action is invariant to first order,
i.e. `ε ↦ L (x + ε X x, y + ε X' x * y)` has vanishing derivative at `ε = 0` for every `(x, y)`.

Then along any solution `q` of the Euler–Lagrange equation
`d/dt (Lv (q t, q' t)) = Lq (q t, q' t)` the Noether current
`Lv (q t, q' t) * X (q t)` is conserved: it is constant in time. -/
theorem noether_conservation
    (L Lq Lv : ℝ × ℝ → ℝ)
    (hL : ∀ p : ℝ × ℝ, HasFDerivAt L
      (Lq p • ContinuousLinearMap.fst ℝ ℝ ℝ + Lv p • ContinuousLinearMap.snd ℝ ℝ ℝ) p)
    (X X' q v : ℝ → ℝ)
    (hX : ∀ x : ℝ, HasDerivAt X (X' x) x)
    (hq : ∀ t : ℝ, HasDerivAt q (v t) t)
    (hEL : ∀ t : ℝ, HasDerivAt (fun s : ℝ => Lv (q s, v s)) (Lq (q t, v t)) t)
    (hsym : ∀ x y : ℝ, HasDerivAt (fun e : ℝ => L (x + e * X x, y + e * (X' x * y))) 0 0) :
    ∀ t₁ t₂ : ℝ, Lv (q t₁, v t₁) * X (q t₁) = Lv (q t₂, v t₂) * X (q t₂) := by
  have hid : ∀ x y : ℝ, Lq (x, y) * X x + Lv (x, y) * (X' x * y) = 0 := fun x y =>
    noether_symmetry_identity L Lq Lv hL X X' x y (hsym x y)
  have hJ : ∀ t : ℝ, HasDerivAt (fun s : ℝ => Lv (q s, v s) * X (q s)) 0 t :=
    noether_hasDerivAt_current Lq Lv X X' q v hX hq hEL hid
  intro t₁ t₂
  exact is_const_of_deriv_eq_zero (fun t => (hJ t).differentiableAt)
    (fun t => (hJ t).deriv) t₁ t₂

end Frontier

