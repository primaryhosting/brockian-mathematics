/-- The Brockian quasi-character: χ_B(n) = n^(iφ) -/
noncomputable def character (n : ℕ) : ℂ :=
  if h : n = 0 then 0 else Complex.exp (((phi * Real.log (n : ℝ)) : ℂ) * I)

@[simp] theorem character_zero : character 0 = 0 := by simp [character]

@[simp] theorem character_one : character 1 = 1 := by
  simp [character, Real.log_one]

theorem character_ne_zero {n : ℕ} (hn : n ≠ 0) : character n ≠ 0 := by
  simp [character, hn, Complex.exp_ne_zero]

/-- ★★★ COMPLETE MULTIPLICATIVITY: χ_B(mn) = χ_B(m)χ_B(n) -/
theorem character_multiplicative {m n : ℕ} (hm : m ≠ 0) (hn : n ≠ 0) :
    character (m * n) = character m * character n := by
      -- By definition of character, we can rewrite the left-hand side using the properties of exponents and logarithms.
      simp [character];
      -- Since $m$ and $n$ are non-zero, we can apply the properties of exponents and logarithms to show the equality.
      simp [hm, hn, Real.log_mul, Complex.exp_add];
      -- Apply the property of exponents that states $e^{a + b} = e^a \cdot e^b$.
      rw [←Complex.exp_add]
      ring

theorem character_pow {n : ℕ} (hn : n ≠ 0) (k : ℕ) :
    character (n ^ k) = (character n) ^ k := by
  induction k with
  | zero => simp [character_one]
  | succ k ih =>
      have hnk : n ^ k ≠ 0 := pow_ne_zero k hn
      simp [pow_succ, character_multiplicative hnk hn, ih, pow_succ]

theorem character_on_unit_circle {n : ℕ} (hn : n ≠ 0) :
    ∃ θ : ℝ, character n = Complex.exp (θ * I) := by
      -- By definition of $character$, we know that $character n = e^{i \phi \log n}$.
      use phi * Real.log n;
      -- By definition of $character$, we know that $character n = e^{i \phi \log n}$ for $n \neq 0$.
      simp [character, hn]

def pentagonalShift (k : Fin 5) (s : ℂ) : ℂ :=
  s + (2 * Real.pi * I * (k.val : ℂ)) / 5

def pentagonalAverage (f : ℂ → ℂ) (s : ℂ) : ℂ :=
  (1 / 5 : ℂ) * ∑ k : Fin 5, f (pentagonalShift k s)

/-- ★★★ LINEARITY -/
theorem pentagonal_average_linear (f g : ℂ → ℂ) (α β : ℂ) (s : ℂ) :
    pentagonalAverage (fun z => α * f z + β * g z) s =
      α * pentagonalAverage f s + β * pentagonalAverage g s := by
  classical
  unfold pentagonalAverage
  simp [Finset.mul_sum, Finset.sum_add_distrib, mul_add, add_mul]
  ring

theorem pentagonal_average_const (c : ℂ) (s : ℂ) :
    pentagonalAverage (fun _ => c) s = c := by
  classical
  unfold pentagonalAverage
  simp

@[simp]
theorem pentagonalShift_zero (s : ℂ) : pentagonalShift 0 s = s := by
  unfold pentagonalShift
  simp

theorem pentagonalShift_re (k : Fin 5) (s : ℂ) :
    (pentagonalShift k s).re = s.re := by
