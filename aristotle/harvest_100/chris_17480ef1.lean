/-- ★★★★★ FUNDAMENTAL EMBEDDING THEOREM: |spiralPrime(p)| = p

    THE CORNERSTONE OF THE ENTIRE FRAMEWORK.
-/
theorem spiralPrime_norm (p : BPrime) : ‖spiralPrime p‖ = (p.val : ℝ) := by
  -- By definition of $spiralPrime$, we have $spiralPrime p = \exp(\log(p.val) * (1 + \phi * I))$.
  have h_spiralPrime : spiralPrime p = Complex.exp (Real.log (p.val : ℝ) * (1 + phi * I)) := by
    -- By definition of $spiralPrime$, we have $spiralPrime p = \exp(\log(p.val) * (1 + \phi * I))$ because $spiral(t) = \exp(t(1 + i\phi))$.
    simp [spiralPrime, spiral];
    -- By simplifying, we can see that the two expressions are indeed equal.
    ring;
  -- The norm of the exponential of a complex number is the exponential of the real part of that complex number.
  have h_norm_exp : ∀ z : ℂ, ‖Complex.exp z‖ = Real.exp (z.re) := by
    exact?;
  convert h_norm_exp _ using 1 ; norm_num [ h_spiralPrime ];
  norm_num [ Complex.log_re, Complex.log_im ];
  rw [ Real.exp_log ( Nat.cast_pos.mpr p.isPrime.pos ) ]

/-- ★★★ UNITARITY: |χ_B(n)| = 1 for n ≠ 0 -/
theorem character_unitary {n : ℕ} (hn : n ≠ 0) : ‖character n‖ = 1 := by
  -- Since $e^{i\theta}$ has an absolute value of 1 for any real $\theta$, we have $\|e^{i\phi \log n}\| = 1$.
  simp [character, Complex.norm_exp];
  -- Since $n \neq 0$, we can simplify the expression to $\exp(i \phi \log n)$.
  simp [hn, Complex.norm_exp];
  -- Since $n$ is a positive integer, its logarithm is real, so the imaginary part of $\log(n)$ is zero.
  simp [Complex.log_im]

theorem spiralTerm_abs_real (p : BPrime) (σ : ℝ) :
    ‖spiralTerm p (σ : ℂ)‖ = (p.val : ℝ) ^ (-σ) := by
      -- Apply the property of the norm of an exponential function: ‖exp(z)‖ = exp(Re(z)).
      have h_norm_exp : ‖Complex.exp (-σ * ((1 : ℂ) + ((phi : ℝ) : ℂ) * I) * Real.log (p.val : ℝ))‖ = Real.exp (-σ * Real.log (p.val : ℝ)) := by
        -- The norm of the exponential of a complex number is the exponential of the real part of that complex number.
        have h_norm_exp : ∀ z : ℂ, ‖Complex.exp z‖ = Real.exp (z.re) := by
          -- The norm of the exponential of a complex number is the exponential of the real part of that complex number, by definition of the exponential function.
          intros z
          simp [Complex.norm_exp];
        -- Apply the norm of the exponential function to the complex number -(σ * (1 + phi * Complex.I) * Real.log (p.val)).
        simp [h_norm_exp];
        norm_num [ Complex.log_re, Complex.log_im ];
      -- Substitute h_norm_exp into the goal.
      convert h_norm_exp using 1;
      rw [ Real.rpow_def_of_pos ( Nat.cast_pos.mpr p.isPrime.pos ), mul_comm ]

/-- ★★★ CONVERGENCE: For σ > 1, the Brockian Euler product converges -/
theorem brockianEuler_convergence (σ : ℝ) (hσ : 1 < σ) :
    Summable fun p : BPrime => ‖spiralTerm p (σ : ℂ)‖ := by
      -- By definition of $spiralTerm$, we know that its norm is $(p.val : ℝ) ^ (-σ)$.
      have h_norm : ∀ p : BPrime, ‖spiralTerm p (σ : ℂ)‖ = (p.val : ℝ) ^ (-σ) := by
        exact?;
      -- Since the sum over all primes converges, the sum over BPrime also converges.
      have h_summable_primes : Summable (fun p : ℕ => if Nat.Prime p then (p : ℝ) ^ (-σ) else 0) := by
        exact?;
      convert h_summable_primes.comp_injective ( show Function.Injective ( fun p : BPrime => p.val ) from fun a b h => by cases a; cases b; aesop ) using 1;
      -- By definition of $spiralTerm$, we know that its norm is $(p.val : ℝ) ^ (-σ)$ for any BPrime $p$.
      funext p; exact (by
      convert h_norm p using 1;
      exact if_pos p.isPrime)

theorem omega_abs : ‖ω‖ = 1 := by
  unfold ω
  rw [Complex.norm_exp]
  simp

theorem omega_pow_abs (k : ℕ) : ‖ω ^ k‖ = 1 := by
  rw [norm_pow, omega_abs, one_pow]

/-- ★★★ EXACT EXPONENTIAL NORM: |γ(t)| = e^t -/
theorem spiral_norm (t : ℝ) : ‖spiral t‖ = Real.exp t := by
  unfold spiral
  have hre : (((t : ℂ) + ((t * phi : ℝ) : ℂ) * I) : ℂ).re = t := by simp
  simpa [hre] using Complex.norm_exp ((t : ℂ) + ((t * phi : ℝ) : ℂ) * I)

/-- ★★ CONDITIONAL GOLDBACH THEOREM -/
theorem goldbach_conditional_v2 (M : GoldbachSpectralModel) (n : ℕ) 
    (hn : Even n) (h2 : 2 < n)
    (h_correct : |(goldbachCount n : ℝ) - M.mainTerm n| ≤ M.errorBound n) :
    ∃ p q, Nat.Prime p ∧ Nat.Prime q ∧ p + q = n := by
  apply goldbach_from_count
  have h_main : M.mainTerm n ≥ M.errorBound n + 1 := M.margin_positive n
  have : (goldbachCount n : ℝ) ≥ M.mainTerm n - M.errorBound n := by
    have := abs_le.mp h_correct
    linarith
  have : (goldbachCount n : ℝ) ≥ 1 := by linarith
  exact Nat.one_le_cast.mp this

