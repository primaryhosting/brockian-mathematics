/-- The prime embedding: p ↦ γ(log p) -/
noncomputable def spiralPrime (p : BPrime) : ℂ :=
  spiral (Real.log (p.val : ℝ))

theorem spiralPrime_ne_zero (p : BPrime) : spiralPrime p ≠ 0 := by
  unfold spiralPrime
  exact spiral_ne_zero _

