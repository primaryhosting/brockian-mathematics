  classical
  refine fun p q => decidable_of_iff (p.val = q.val) ?_
  constructor
  · intro h; cases p; cases q; simp_all
  · intro h; cases p; cases q; cases h; rfl

theorem bprime_pos (p : BPrime) : 0 < p.val := p.isPrime.pos

theorem bprime_cast_pos (p : BPrime) : 0 < (p.val : ℝ) :=
