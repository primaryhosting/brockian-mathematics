/-- Axiom: Standard result that prime p-series converges for σ > 1 -/
theorem Real.summable_prime_rpow_inv {σ : ℝ} (hσ : 1 < σ) :
    Summable fun p : ℕ => if Nat.Prime p then (p : ℝ) ^ (-σ) else 0 := by
      -- Since the primes are a subset of the natural numbers, and the series $\sum_{n=1}^{\infty} n^{-\sigma}$ converges for $\sigma > 1$, it follows that the sum over primes also converges.
      have h_summable_nat : Summable (fun n : ℕ => if Nat.Prime n then (n : ℝ) ^ (-σ) else 0) := by
        have h_summable_nat : Summable (fun n : ℕ => (n : ℝ) ^ (-σ)) := by
          -- Apply the p-series test to conclude that the series is summable.
          apply Real.summable_nat_rpow.mpr; linarith
        -- Since the primes are a subset of the natural numbers, and the series sum_{n=2}^\infty n^{-\sigma} converges, we can apply the comparison test.
        have h_comparison : ∀ n : ℕ, (if Nat.Prime n then (n : ℝ) ^ (-σ) else 0) ≤ (n : ℝ) ^ (-σ) := by
          intro n; split_ifs <;> first | positivity | aesop;
        generalize_proofs at *; (
        -- Apply the comparison test to conclude that the sum over primes converges.
        apply Summable.of_nonneg_of_le (fun n => by positivity) h_comparison h_summable_nat)
      generalize_proofs at *; (
      exact?)

def goldbachCount (n : ℕ) : ℕ :=
  (Finset.range n).filter (fun p => Nat.Prime p ∧ Nat.Prime (n - p)) |>.card

theorem goldbach_from_count {n : ℕ} (h : 1 ≤ goldbachCount n) :
    ∃ p q, Nat.Prime p ∧ Nat.Prime q ∧ p + q = n := by
      -- Since $1 \leq \text{goldbachCount } n$, there exists at least one pair of primes $p$ and $q$ such that $p + q = n$ by definition of $\text{goldbachCount}$.
      obtain ⟨p, hp⟩ : ∃ p ∈ Finset.range n, Nat.Prime p ∧ Nat.Prime (n - p) := by
        -- Since the cardinality of the set is at least 1, the set is non-empty.
        have h_nonempty : Finset.Nonempty (Finset.filter (fun p => Nat.Prime p ∧ Nat.Prime (n - p)) (Finset.range n)) := by
          -- Since the cardinality of the set is at least 1, the set is nonempty by definition.
          apply Finset.card_pos.mp h;
        -- Since the set is non-empty, we can obtain an element p from it.
        obtain ⟨p, hp⟩ := h_nonempty;
        use p;
        aesop;
      exact ⟨ p, n - p, hp.2.1, hp.2.2, Nat.add_sub_of_le ( Finset.mem_range_le hp.1 ) ⟩

structure GoldbachSpectralModel where
  mainTerm : ℕ → ℝ
  errorBound : ℕ → ℝ
  error_nonneg : ∀ n, 0 ≤ errorBound n
  margin_positive : ∀ n, mainTerm n ≥ errorBound n + 1

/-- ★★ CONDITIONAL GOLDBACH THEOREM -/
theorem goldbach_conditional (M : GoldbachSpectralModel) (n : ℕ) 
    (hn : Even n) (h2 : 2 < n)
    (h_correct : |(goldbachCount n : ℝ) - M.mainTerm n| ≤ M.errorBound n) :
    ∃ p q, Nat.Prime p ∧ Nat.Prime q ∧ p + q = n := by
  apply goldbach_from_count
  have h_main : M.mainTerm n ≥ M.errorBound n + 1 := M.margin_positive n
  have : (goldbachCount n : ℝ) ≥ M.mainTerm n - M.errorBound n := by
    have := abs_le.mp h_correct
    linarith
  have : (goldbachCount n : ℝ) ≥ 1 := by linarith
  exact Nat.one_le_cast.mp this

