/-- The Brockian operator is self-adjoint.

    Proof: P_φ is self-adjoint (isotypic projector property), Δ is self-adjoint,
    V is self-adjoint, and the sum/composition of self-adjoints is self-adjoint. -/
theorem BrockianSystem.B_selfAdjoint {H : Type*}
    [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (BS : BrockianSystem H) : IsSelfAdjoint BS.B := by
      unfold IsSelfAdjoint;
      -- Since $P_\varphi$ is a projection, we have $P_\varphi^* = P_\varphi$.
      have hP_star : (BS.projectors.projector .golden).adjoint = BS.projectors.projector .golden := by
        exact BS.projectors.selfAdjoint _;
      -- Since Δ and V are self-adjoint, their adjoints are themselves.
      have hΔ_star : (BS.Δ).adjoint = BS.Δ := by
        exact BS.hΔ
      have hV_star : (BS.V).adjoint = BS.V := by
        -- Since $V$ is self-adjoint, we have $V^* = V$.
        apply BS.hV;
      -- By definition of $B$, we have $B = P_\varphi \Delta P_\varphi + V$.
      have hB_def : BS.B = (BS.projectors.projector .golden) * BS.Δ * (BS.projectors.projector .golden) + BS.V := by
        exact BS.hB_def;
      simp +decide [ hB_def, hP_star, hΔ_star, hV_star, ContinuousLinearMap.adjoint ];
      simp_all +decide [ Star.star ];
      rw [ mul_assoc ]

