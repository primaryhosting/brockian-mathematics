open Finset

/-- The sum-of-divisors function `σ₁ n = ∑_{d ∣ n} d`.  It agrees with Mathlib's
`ArithmeticFunction.sigma 1` (see `sigmaOne_eq`). -/
def sigmaOne (n : ℕ) : ℕ := ∑ d ∈ n.divisors, d

lemma sigmaOne_eq (n : ℕ) : sigmaOne n = ArithmeticFunction.sigma 1 n := by
  rw [ArithmeticFunction.sigma_one_apply, sigmaOne]

/-- `m` and `n` form a *betrothed* (quasi-amicable) pair: they are distinct positive
integers such that the sum of the divisors of each, excluding the number itself and `1`,
equals the other one.  Equivalently `σ(m) = σ(n) = m + n + 1`. -/
def IsBetrothedPair (m n : ℕ) : Prop :=
  0 < m ∧ 0 < n ∧ m ≠ n ∧ sigmaOne m = m + n + 1 ∧ sigmaOne n = m + n + 1

/-- `σ₁` is multiplicative on coprime arguments. -/
lemma sigmaOne_mul_of_coprime {a b : ℕ} (h : Nat.Coprime a b) :
    sigmaOne (a * b) = sigmaOne a * sigmaOne b := by
  simp only [sigmaOne_eq]
  exact ArithmeticFunction.isMultiplicative_sigma.map_mul_of_coprime h

/-- `σ₁(2 ^ k) = 2 ^ (k+1) - 1`. -/
lemma sigmaOne_two_pow (k : ℕ) : sigmaOne (2 ^ k) = 2 ^ (k + 1) - 1 := by
  rw [sigmaOne, Nat.sum_divisors_prime_pow Nat.prime_two]
  simp [Nat.geomSum_eq]

/-- `σ₁(p) = p + 1` for a prime `p`. -/
lemma sigmaOne_prime {p : ℕ} (hp : p.Prime) : sigmaOne p = p + 1 := by
  rw [sigmaOne, hp.sum_divisors]

/-- The sigma value of a number of the form `2 ^ k * p` with `p` an odd prime. -/
lemma sigmaOne_two_pow_mul_prime {k p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) :
    sigmaOne (2 ^ k * p) = (2 ^ (k + 1) - 1) * (p + 1) := by
  have hcop : Nat.Coprime (2 ^ k) p :=
    Nat.Coprime.pow_left _ ((Nat.coprime_primes Nat.prime_two hp).2 (Ne.symm hp2))
  rw [sigmaOne_mul_of_coprime hcop, sigmaOne_two_pow, sigmaOne_prime hp]

/-- **Sigma criterion.**  If `p` is an odd prime, `m` is a positive integer different from
`n = 2 ^ k * p` with `σ₁(m) = m + n + 1`, and the multiplicative formula
`σ₁(n) = (2 ^ (k+1) - 1)(p + 1)` also equals `m + n + 1`, then `(m, n)` is a betrothed pair. -/
theorem isBetrothedPair_of_sigma_criterion {k p m : ℕ} (hp : p.Prime) (hp2 : p ≠ 2)
    (hm : 0 < m) (hne : m ≠ 2 ^ k * p)
    (hsm : sigmaOne m = m + 2 ^ k * p + 1)
    (hcrit : (2 ^ (k + 1) - 1) * (p + 1) = m + 2 ^ k * p + 1) :
    IsBetrothedPair m (2 ^ k * p) := by
  refine ⟨hm, ?_, hne, hsm, ?_⟩
  · exact Nat.mul_pos (Nat.two_pow_pos k) hp.pos
  · rw [sigmaOne_two_pow_mul_prime hp hp2, hcrit]

/-- The kernel-checked value `σ₁(5775) = 11904`. -/
lemma sigmaOne_5775 : sigmaOne 5775 = 11904 := by
  rw [sigmaOne]; decide

/-- The kernel-checked value `σ₁(6128) = 11904`. -/
lemma sigmaOne_6128 : sigmaOne 6128 = 11904 := by
  rw [sigmaOne]; decide

/-- `6128 = 2 ^ 4 * 383` with `383` prime, and the sigma criterion
`(2 ^ 5 - 1)(383 + 1) = 5775 + 6128 + 1` holds:  the pair `(5775, 6128)` is generated by
the `k = 4, p = 383` sigma criterion. -/
theorem sigma_criterion_4_383 :
    Nat.Prime 383 ∧ (383 : ℕ) ≠ 2 ∧ 2 ^ 4 * 383 = 6128 ∧
      (2 ^ (4 + 1) - 1) * (383 + 1) = 5775 + 6128 + 1 := by
  refine ⟨by norm_num, by norm_num, by norm_num, by norm_num⟩

/-- **Main result.**  `(5775, 6128)` is a betrothed (quasi-amicable) pair. -/
theorem betrothed_5775_6128 : IsBetrothedPair 5775 6128 := by
  have h : IsBetrothedPair 5775 (2 ^ 4 * 383) := by
    refine isBetrothedPair_of_sigma_criterion (k := 4) (p := 383) (by norm_num) (by norm_num)
      (by norm_num) (by norm_num) ?_ (by norm_num)
    rw [sigmaOne_5775]; norm_num
  simpa using h

/-- The betrothed pair `(5775, 6128)` arises from the `k = 4, p = 383` sigma criterion. -/
theorem betrothed_5775_6128_from_criterion :
    IsBetrothedPair 5775 (2 ^ 4 * 383) ∧ Nat.Prime 383 ∧
      sigmaOne (2 ^ 4 * 383) = (2 ^ (4 + 1) - 1) * (383 + 1) ∧
      (2 ^ (4 + 1) - 1) * (383 + 1) = 5775 + 6128 + 1 := by
  refine ⟨by simpa using betrothed_5775_6128, by norm_num, ?_, by norm_num⟩
  exact sigmaOne_two_pow_mul_prime (by norm_num) (by norm_num)

/-- A second, purely computational proof of the main result: both sigma values are
kernel-verified by `decide`. -/
theorem betrothed_5775_6128_direct : IsBetrothedPair 5775 6128 :=
  ⟨by norm_num, by norm_num, by norm_num, by rw [sigmaOne_5775], by rw [sigmaOne_6128]⟩

