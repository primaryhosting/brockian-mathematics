  hV : IsSelfAdjoint V
  B : H →L[ℂ] H := (goldenProjector ρ) * Δ * (goldenProjector ρ) + V
  hB_spec : ∀ s : ℂ, completedRiemannZeta₀ (1/2 + I * s) = 0 ↔ ∃ mu ∈ spectrum ℂ B, s = mu

