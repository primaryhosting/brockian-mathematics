class D5ProjectorProperties (H : Type*) [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (ρ : D5 → (H ≃ₗᵢ[ℂ] H)) where
  idempotent : ∀ idx, isotypicProjectorFormula ρ idx * isotypicProjectorFormula ρ idx = isotypicProjectorFormula ρ idx
  selfAdjoint : ∀ idx, (isotypicProjectorFormula ρ idx).adjoint = isotypicProjectorFormula ρ idx
  orthogonal : ∀ i j, i ≠ j → isotypicProjectorFormula ρ i * isotypicProjectorFormula ρ j = 0
  complete : isotypicProjectorFormula ρ .trivial + isotypicProjectorFormula ρ .sign + isotypicProjectorFormula ρ .golden + isotypicProjectorFormula ρ .conjugate = 1
  golden_nonzero : isotypicProjectorFormula ρ .golden ≠ 0
  golden_proper : isotypicProjectorFormula ρ .golden ≠ 1

