/-
This file is deliberately import-free (Lean core only), so that the header comment
above is literally the first thing in the file.  All arithmetic therefore takes
place in the rational numbers `Rat` of Lean core.  A companion file
`RequestProject/HiggsMassToyReal.lean` develops the same toy model over the real
numbers with genuine derivatives (`Frontier.higgs_mass_toy_real`).
-/

namespace Frontier

/-! ### Auxiliary order facts for `Rat` (core only) -/

theorem mul_self_nonneg_rat (x : Rat) : 0 ≤ x * x := by
  rcases (Rat.le_total (a := 0) (b := x)) with h | h
  · exact Rat.mul_nonneg h h
  · have h' : 0 ≤ -x := by grind
    have := Rat.mul_nonneg h' h'
    grind

theorem mul_self_pos_rat {x : Rat} (hx : x ≠ 0) : 0 < x * x := by
  rcases (Rat.le_total (a := 0) (b := x)) with h | h
  · have hx' : 0 < x := by grind
    exact Rat.mul_pos hx' hx'
  · have h' : 0 < -x := by grind
    have := Rat.mul_pos h' h'
    grind

theorem sq_nonneg_rat (x : Rat) : 0 ≤ x ^ 2 := by
  have := mul_self_nonneg_rat x
  grind

theorem sq_pos_rat {x : Rat} (hx : x ≠ 0) : 0 < x ^ 2 := by
  have := mul_self_pos_rat hx
  grind

/-! ### The abelian Higgs toy model -/

/-- The "Mexican hat" scalar potential of the abelian Higgs toy model, written as a
function of the modulus `r = |φ|` of the complex scalar field:
`V(r) = lam * (r ^ 2 - v ^ 2) ^ 2`.
Its minima form the circle `|φ| = v`: choosing one of them is the spontaneous
breaking of the `U(1)` gauge symmetry. -/
def higgsPotential (lam v r : Rat) : Rat := lam * (r ^ 2 - v ^ 2) ^ 2

/-- The gauge-boson mass squared generated by the covariant derivative
`D_μ φ = (∂_μ - i * g * A_μ) φ`: on the vacuum `|φ| = v` the kinetic term
`|D_μ φ| ^ 2` contains `g ^ 2 * v ^ 2 * A_μ A^μ`, a mass term for `A_μ`. -/
def gaugeMassSq (g v : Rat) : Rat := g ^ 2 * v ^ 2

/-- The mass squared of the radial (Higgs) excitation, i.e. the curvature
`V''(v)` of the potential at the vacuum. -/
def higgsMassSq (lam v : Rat) : Rat := 8 * lam * v ^ 2

/-- The vacuum `r = v` is a global minimum of the Mexican-hat potential. -/
theorem higgsPotential_min {lam : Rat} (hlam : 0 ≤ lam) (v r : Rat) :
    higgsPotential lam v v ≤ higgsPotential lam v r := by
  have h0 : higgsPotential lam v v = 0 := by grind [higgsPotential]
  have h1 : 0 ≤ lam * (r ^ 2 - v ^ 2) ^ 2 :=
    Rat.mul_nonneg hlam (sq_nonneg_rat _)
  grind [higgsPotential]

/-- Exact expansion of the potential around the vacuum `r = v + h`.  There is no
term linear in `h` (so `v` is a stationary point), and the quadratic coefficient is
`(1/2) * V''(v) = 4 * lam * v ^ 2 = (1/2) * higgsMassSq lam v`. -/
theorem higgsPotential_expansion (lam v h : Rat) :
    higgsPotential lam v (v + h)
      = (1 / 2) * higgsMassSq lam v * h ^ 2 + 4 * lam * v * h ^ 3 + lam * h ^ 4 := by
  unfold higgsPotential higgsMassSq
  grind

/--
**Abelian Higgs toy model: spontaneous symmetry breaking gives the gauge boson a mass.**

Assume a strictly positive quartic coupling `lam`, a nonzero gauge coupling `g`, and a
nonzero vacuum expectation value `v` (the spontaneously broken phase).  Then:

1. the vacuum `|φ| = v` has zero potential energy and is a global minimum of the
   Mexican-hat potential;
2. expanding around the vacuum, `V(v + h)` has no linear term and quadratic
   coefficient `(1/2) * higgsMassSq lam v`, i.e. the radial excitation has mass
   squared `V''(v) = 8 * lam * v ^ 2`, which is strictly positive;
3. the gauge boson acquires a strictly positive mass squared
   `gaugeMassSq g v = g ^ 2 * v ^ 2 = (g * v) ^ 2 > 0`;
4. by contrast, in the unbroken phase `v = 0` the gauge boson stays exactly massless
   and the radial mode is massless as well.
-/
theorem higgs_mass_toy {lam g v : Rat} (hlam : 0 < lam) (hg : g ≠ 0) (hv : v ≠ 0) :
    (higgsPotential lam v v = 0 ∧
      ∀ r : Rat, higgsPotential lam v v ≤ higgsPotential lam v r) ∧
    (∀ h : Rat, higgsPotential lam v (v + h)
      = (1 / 2) * higgsMassSq lam v * h ^ 2 + 4 * lam * v * h ^ 3 + lam * h ^ 4) ∧
    0 < higgsMassSq lam v ∧
    gaugeMassSq g v = (g * v) ^ 2 ∧
    0 < gaugeMassSq g v ∧
    (∀ g' lam' : Rat, gaugeMassSq g' 0 = 0 ∧ higgsMassSq lam' 0 = 0) := by
  have hv2 : 0 < v ^ 2 := sq_pos_rat hv
  have hg2 : 0 < g ^ 2 := sq_pos_rat hg
  refine ⟨⟨by grind [higgsPotential], fun r => higgsPotential_min (Rat.le_of_lt hlam) v r⟩,
    higgsPotential_expansion lam v, ?_, ?_, ?_, ?_⟩
  · have h8 : 0 < 8 * lam := by grind
    have := Rat.mul_pos h8 hv2
    grind [higgsMassSq]
  · unfold gaugeMassSq; grind
  · have := Rat.mul_pos hg2 hv2
    grind [gaugeMassSq]
  · intro g' lam'
    exact ⟨by grind [gaugeMassSq], by grind [higgsMassSq]⟩

/-- A concrete instance: `lam = 1`, `v = 2`, `g = 3` gives gauge boson mass squared
`36` and Higgs mass squared `32`. -/
example : gaugeMassSq 3 2 = 36 ∧ higgsMassSq 1 2 = 32 := by
  exact ⟨by grind [gaugeMassSq], by grind [higgsMassSq]⟩

end Frontier

