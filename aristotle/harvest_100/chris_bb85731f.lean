/-!
# Zelmanov Restricted Burnside
Category: Frontier — Fields Medal Work
Target: Frontier.zelmanov_restricted_burnside
Verification: pending
Provenance: Aristotle theorem prover (Harmonic)
-/

namespace Frontier

/-- `RestrictedBurnside m n` is the statement of the *restricted Burnside problem* for
`m` generators and exponent `n`: there is a uniform bound `N` on the order of every finite
group that is generated by `m` elements and has exponent dividing `n`.

(Equivalently, there are only finitely many isomorphism classes of such groups.)
Zelmanov's theorem asserts that `RestrictedBurnside m n` holds for all `m` and all `n ≥ 1`. -/
def RestrictedBurnside (m n : ℕ) : Prop :=
  ∃ N : ℕ, ∀ (G : Type) [Group G] [Fintype G] (g : Fin m → G),
    Subgroup.closure (Set.range g) = ⊤ → (∀ x : G, x ^ n = 1) → Fintype.card G ≤ N

/-- The full statement solved by Zelmanov: the restricted Burnside problem has a positive
solution for every number of generators and every positive exponent. -/
def ZelmanovConjecture : Prop := ∀ m n : ℕ, 0 < n → RestrictedBurnside m n

/-- The restricted Burnside problem for groups that are nilpotent of class at most `2`
(i.e. whose commutator subgroup is central). -/
def RestrictedBurnsideClassTwo (m n : ℕ) : Prop :=
  ∃ N : ℕ, ∀ (G : Type) [Group G] [Fintype G] (g : Fin m → G),
    Subgroup.closure (Set.range g) = ⊤ → (∀ x : G, x ^ n = 1) →
    commutator G ≤ Subgroup.center G → Fintype.card G ≤ N

/-! ## The abelian case -/

/-- An abelian group of exponent dividing `n > 0` generated by a finite family indexed by `ι`
has order at most `n ^ #ι`. -/
theorem card_le_of_commGroup {G : Type} [CommGroup G] {ι : Type} [Finite ι] {n : ℕ} (hn : 0 < n)
    (g : ι → G) (hgen : Subgroup.closure (Set.range g) = ⊤)
    (hexp : ∀ x : G, x ^ n = 1) : Nat.card G ≤ n ^ Nat.card ι := by
  haveI : NeZero n := ⟨hn.ne'⟩
  haveI : Fintype ι := Fintype.ofFinite ι
  have hnsmul : ∀ x : Additive G, n • x = 0 := fun x => by simpa using hexp (Additive.toMul x)
  haveI : Module (ZMod n) (Additive G) := AddCommGroup.zmodModule hnsmul
  let v : ι → Additive G := fun i => Additive.ofMul (g i)
  have hclos : AddSubgroup.closure (Set.range v) = ⊤ := by
    have := congrArg Subgroup.toAddSubgroup hgen
    rw [Subgroup.toAddSubgroup_closure] at this
    simpa [v, Set.ext_iff] using this
  have hspan : Submodule.span (ZMod n) (Set.range v) = ⊤ := by
    rw [Submodule.eq_top_iff']
    intro x
    have hle : AddSubgroup.closure (Set.range v) ≤
        (Submodule.span (ZMod n) (Set.range v)).toAddSubgroup :=
      AddSubgroup.closure_le _ |>.mpr Submodule.subset_span
    rw [hclos] at hle
    exact hle (AddSubgroup.mem_top x)
  have hsurj : Function.Surjective ⇑(Fintype.linearCombination (ZMod n) v) := by
    rw [← LinearMap.range_eq_top, Fintype.range_linearCombination, hspan]
  have h1 := Nat.card_le_card_of_surjective _ hsurj
  rwa [Nat.card_fun, Nat.card_eq_fintype_card (α := ZMod n), ZMod.card,
    Nat.card_congr (Additive.toMul)] at h1

/-- A group of exponent `2` is commutative. -/
theorem mul_comm_of_sq_eq_one {G : Type} [Group G] (h : ∀ x : G, x ^ 2 = 1) (a b : G) :
    a * b = b * a := by
  have hinv : ∀ x : G, x⁻¹ = x := by
    intro x
    have hx : x * x = 1 := by rw [← pow_two]; exact h x
    exact inv_eq_of_mul_eq_one_right hx
  conv_lhs => rw [← hinv (a * b)]
  rw [mul_inv_rev, hinv a, hinv b]

/-! ## Base cases of the restricted Burnside problem -/

/-- Base case: exponent `1`. -/
theorem restrictedBurnside_exponent_one (m : ℕ) : RestrictedBurnside m 1 := by
  refine ⟨1, fun G _ _ g _ hexp => ?_⟩
  rw [Fintype.card_le_one_iff]
  intro a b
  simpa using (hexp a).trans (hexp b).symm

/-- Base case: zero generators. -/
theorem restrictedBurnside_zero_generators (n : ℕ) : RestrictedBurnside 0 n := by
  refine ⟨1, fun G _ _ g hgen _ => ?_⟩
  have hg : Set.range g = ∅ := by
    simp [Set.range_eq_empty]
  rw [hg, Subgroup.closure_empty] at hgen
  rw [Fintype.card_le_one_iff]
  intro a b
  have ha : a ∈ (⊥ : Subgroup G) := hgen ▸ Subgroup.mem_top a
  have hb : b ∈ (⊥ : Subgroup G) := hgen ▸ Subgroup.mem_top b
  rw [Subgroup.mem_bot] at ha hb
  rw [ha, hb]

/-- Base case: exponent `2`, with the sharp bound `2 ^ m`. -/
theorem restrictedBurnside_exponent_two (m : ℕ) : RestrictedBurnside m 2 := by
  refine ⟨2 ^ m, fun G _ _ g hgen hexp => ?_⟩
  letI : CommGroup G := { (inferInstance : Group G) with
    mul_comm := mul_comm_of_sq_eq_one hexp }
  have := card_le_of_commGroup (G := G) (ι := Fin m) (by norm_num) g hgen hexp
  simpa [Nat.card_eq_fintype_card] using this

/-- Base case: one generator (cyclic groups), with the sharp bound `n`. -/
theorem restrictedBurnside_one_generator {n : ℕ} (hn : 0 < n) : RestrictedBurnside 1 n := by
  refine ⟨n, fun G _ _ g hgen hexp => ?_⟩
  have hcyc : IsCyclic G := by
    refine ⟨g 0, fun x => ?_⟩
    have hx : x ∈ Subgroup.closure (Set.range g) := hgen ▸ Subgroup.mem_top x
    have hr : Set.range g = {g 0} := by
      ext y
      simp [eq_comm]
    rw [hr, Subgroup.mem_closure_singleton] at hx
    obtain ⟨k, hk⟩ := hx
    exact ⟨k, hk⟩
  letI : CommGroup G := IsCyclic.commGroup
  have := card_le_of_commGroup (G := G) (ι := Fin 1) hn g hgen hexp
  simpa [Nat.card_eq_fintype_card] using this

/-! ## Reductions -/

/-- Reduction along divisibility of the exponent. -/
theorem restrictedBurnside_of_dvd {m n k : ℕ} (hdvd : n ∣ k) (h : RestrictedBurnside m k) :
    RestrictedBurnside m n := by
  obtain ⟨N, hN⟩ := h
  refine ⟨N, fun G _ _ g hgen hexp => ?_⟩
  refine hN G g hgen (fun x => ?_)
  obtain ⟨c, rfl⟩ := hdvd
  rw [pow_mul, hexp x, one_pow]

/-- Reduction in the number of generators. -/
theorem restrictedBurnside_of_le_generators {m m' n : ℕ} (hm : m' ≤ m)
    (h : RestrictedBurnside m n) : RestrictedBurnside m' n := by
  obtain ⟨N, hN⟩ := h
  refine ⟨N, fun G _ _ g hgen hexp => ?_⟩
  classical
  refine hN G (fun i => if h : (i : ℕ) < m' then g ⟨i, h⟩ else 1) ?_ hexp
  rw [eq_top_iff, ← hgen, Subgroup.closure_le]
  rintro y ⟨i, rfl⟩
  refine Subgroup.subset_closure ⟨⟨i, lt_of_lt_of_le i.isLt hm⟩, ?_⟩
  simp

/-- The hypothesis `0 < n` is necessary: with `n = 0` the exponent condition is vacuous and
cyclic groups of arbitrary order occur. -/
theorem not_restrictedBurnside_exponent_zero : ¬ RestrictedBurnside 1 0 := by
  rintro ⟨N, hN⟩
  have hcard : Fintype.card (Multiplicative (ZMod (N + 1))) ≤ N := by
    refine hN (Multiplicative (ZMod (N + 1))) (fun _ => Multiplicative.ofAdd 1) ?_ (fun x => rfl)
    rw [eq_top_iff]
    intro x _
    have hr : Set.range (fun _ : Fin 1 => (Multiplicative.ofAdd 1 : Multiplicative (ZMod (N+1))))
        = {Multiplicative.ofAdd 1} := by
      ext y; simp
    rw [hr, Subgroup.mem_closure_singleton]
    refine ⟨((Multiplicative.toAdd x).val : ℤ), ?_⟩
    apply Multiplicative.toAdd.injective
    simp [ZMod.natCast_val]
  simp at hcard

/-! ## The case of nilpotency class at most two

Commutator calculus in a group whose commutators are central, leading to the positive solution
of the restricted Burnside problem for groups of nilpotency class at most `2`. -/

section ClassTwo

variable {G : Type} [Group G]

/-- In a group with central commutators, the commutator is multiplicative in its first
argument. -/
theorem commutatorElement_mul_left_of_central
    (hc : ∀ a b : G, ⁅a, b⁆ ∈ Subgroup.center G) (x y z : G) :
    ⁅x * y, z⁆ = ⁅x, z⁆ * ⁅y, z⁆ := by
  have key : ⁅x * y, z⁆ = (x * ⁅y, z⁆ * x⁻¹) * ⁅x, z⁆ := by
    simp only [commutatorElement_def]; group
  have h1 : x * ⁅y, z⁆ * x⁻¹ = ⁅y, z⁆ := by
    rw [(Subgroup.mem_center_iff.mp (hc y z)) x]; group
  rw [key, h1, ((Subgroup.mem_center_iff.mp (hc y z)) ⁅x, z⁆).symm]

/-- In a group with central commutators, inverting the first argument of a commutator inverts
the commutator. -/
theorem commutatorElement_inv_left_of_central
    (hc : ∀ a b : G, ⁅a, b⁆ ∈ Subgroup.center G) (x z : G) : ⁅x⁻¹, z⁆ = ⁅x, z⁆⁻¹ := by
  have h := commutatorElement_mul_left_of_central hc x x⁻¹ z
  rw [mul_inv_cancel, commutatorElement_one_left] at h
  exact eq_inv_of_mul_eq_one_right h.symm

/-- In a group of nilpotency class at most `2` generated by a set `S`, the commutator subgroup is
generated by the commutators of the generators. -/
theorem commutator_le_closure_of_central {S : Set G} (hS : Subgroup.closure S = ⊤)
    (hc : ∀ a b : G, ⁅a, b⁆ ∈ Subgroup.center G) :
    commutator G ≤ Subgroup.closure {c : G | ∃ s ∈ S, ∃ t ∈ S, ⁅s, t⁆ = c} := by
  set H := Subgroup.closure {c : G | ∃ s ∈ S, ∃ t ∈ S, ⁅s, t⁆ = c} with hH
  let L : G → Subgroup G := fun z =>
    { carrier := {x | ⁅x, z⁆ ∈ H}
      one_mem' := by simp [commutatorElement_one_left]
      mul_mem' := by
        intro a b ha hb
        simp only [Set.mem_setOf_eq] at *
        rw [commutatorElement_mul_left_of_central hc]
        exact H.mul_mem ha hb
      inv_mem' := by
        intro a ha
        simp only [Set.mem_setOf_eq] at *
        rw [commutatorElement_inv_left_of_central hc]
        exact H.inv_mem ha }
  have step1 : ∀ z ∈ S, ∀ x : G, ⁅x, z⁆ ∈ H := by
    intro z hz x
    have hle : (⊤ : Subgroup G) ≤ L z := by
      rw [← hS, Subgroup.closure_le]
      intro s hs
      exact Subgroup.subset_closure ⟨s, hs, z, hz, rfl⟩
    exact hle (Subgroup.mem_top x)
  have step2 : ∀ z x : G, ⁅x, z⁆ ∈ H := by
    intro z x
    have hle : (⊤ : Subgroup G) ≤ L z := by
      rw [← hS, Subgroup.closure_le]
      intro s hs
      show ⁅s, z⁆ ∈ H
      rw [show ⁅s, z⁆ = ⁅z, s⁆⁻¹ by rw [commutatorElement_inv]]
      exact H.inv_mem (step1 s hs z)
    exact hle (Subgroup.mem_top x)
  rw [commutator_eq_closure, Subgroup.closure_le]
  rintro c ⟨x, y, rfl⟩
  exact step2 y x

/-- The abelianization of an `m`-generated group of exponent dividing `n > 0` has order at most
`n ^ m`. -/
theorem card_abelianization_le {m n : ℕ} (hn : 0 < n) (g : Fin m → G)
    (hgen : Subgroup.closure (Set.range g) = ⊤) (hexp : ∀ x : G, x ^ n = 1) :
    Nat.card (Abelianization G) ≤ n ^ m := by
  have hsurj : Function.Surjective (Abelianization.of (G := G)) :=
    fun y => Quot.inductionOn y fun x => ⟨x, rfl⟩
  have hgen' : Subgroup.closure (Set.range fun i => Abelianization.of (g i)) = ⊤ := by
    rw [show (Set.range fun i => Abelianization.of (g i))
        = (Abelianization.of (G := G)) '' Set.range g by rw [← Set.range_comp]; rfl,
      ← MonoidHom.map_closure, hgen, Subgroup.map_top_of_surjective _ hsurj]
  have hexp' : ∀ y : Abelianization G, y ^ n = 1 := by
    intro y
    obtain ⟨x, rfl⟩ := hsurj y
    rw [← map_pow, hexp x, map_one]
  simpa using card_le_of_commGroup hn (fun i => Abelianization.of (g i)) hgen' hexp'

/-- In an `m`-generated group of exponent dividing `n > 0` and nilpotency class at most `2`, the
commutator subgroup has order at most `n ^ (m * m)`. -/
theorem card_commutator_le {m n : ℕ} (hn : 0 < n) (g : Fin m → G)
    (hgen : Subgroup.closure (Set.range g) = ⊤) (hexp : ∀ x : G, x ^ n = 1)
    (hcent : commutator G ≤ Subgroup.center G) :
    Nat.card (commutator G) ≤ n ^ (m * m) := by
  have hc : ∀ a b : G, ⁅a, b⁆ ∈ Subgroup.center G := fun a b =>
    hcent (Subgroup.commutator_mem_commutator (Subgroup.mem_top a) (Subgroup.mem_top b))
  set c : Fin m × Fin m → G := fun p => ⁅g p.1, g p.2⁆ with hcdef
  have hset : {x : G | ∃ s ∈ Set.range g, ∃ t ∈ Set.range g, ⁅s, t⁆ = x} = Set.range c := by
    ext x
    constructor
    · rintro ⟨s, ⟨i, rfl⟩, t, ⟨j, rfl⟩, rfl⟩
      exact ⟨(i, j), rfl⟩
    · rintro ⟨p, rfl⟩
      exact ⟨g p.1, ⟨p.1, rfl⟩, g p.2, ⟨p.2, rfl⟩, rfl⟩
  have hK : commutator G = Subgroup.closure (Set.range c) := by
    refine le_antisymm ?_ ?_
    · have := commutator_le_closure_of_central hgen hc
      rwa [hset] at this
    · rw [Subgroup.closure_le]
      rintro x ⟨p, rfl⟩
      exact Subgroup.commutator_mem_commutator (Subgroup.mem_top _) (Subgroup.mem_top _)
  set K := Subgroup.closure (Set.range c) with hKdef
  have hKcent : (K : Set G) ⊆ Subgroup.center G := fun x hx => hcent (hK ▸ hx)
  letI : CommGroup K := { (inferInstance : Group K) with
    mul_comm := by
      intro a b
      refine Subtype.ext ?_
      push_cast
      exact (Subgroup.mem_center_iff.mp (hKcent a.2) b).symm }
  let v : Fin m × Fin m → K := fun p => ⟨c p, Subgroup.subset_closure ⟨p, rfl⟩⟩
  have hgenK : Subgroup.closure (Set.range v) = ⊤ := by
    have h := Subgroup.closure_closure_coe_preimage (k := Set.range c)
    rwa [show (Subtype.val ⁻¹' Set.range c : Set K) = Set.range v by
      ext x
      constructor
      · rintro ⟨p, hp⟩
        exact ⟨p, Subtype.ext hp⟩
      · rintro ⟨p, rfl⟩
        exact ⟨p, rfl⟩] at h
  have hexpK : ∀ x : K, x ^ n = 1 := fun x => Subtype.ext (by simpa using hexp (x : G))
  have hcard := card_le_of_commGroup (G := K) hn v hgenK hexpK
  rw [hK]
  simpa using hcard

/-- An `m`-generated group of exponent dividing `n > 0` and nilpotency class at most `2` has
order at most `n ^ m * n ^ (m * m)`. -/
theorem card_le_of_commutator_le_center {m n : ℕ} (hn : 0 < n) (g : Fin m → G)
    (hgen : Subgroup.closure (Set.range g) = ⊤) (hexp : ∀ x : G, x ^ n = 1)
    (hcent : commutator G ≤ Subgroup.center G) :
    Nat.card G ≤ n ^ m * n ^ (m * m) := by
  have h1 := card_abelianization_le hn g hgen hexp
  have h2 := card_commutator_le hn g hgen hexp hcent
  have h3 : Nat.card G = Nat.card (G ⧸ commutator G) * Nat.card (commutator G) :=
    Subgroup.card_eq_card_quotient_mul_card_subgroup _
  have h4 : Nat.card (G ⧸ commutator G) = Nat.card (Abelianization G) := rfl
  rw [h3, h4]
  exact Nat.mul_le_mul h1 h2

end ClassTwo

/-- The restricted Burnside problem has a positive solution for groups of nilpotency class at
most `2`, with the explicit bound `n ^ m * n ^ (m * m)`. -/
theorem restrictedBurnsideClassTwo_of_pos {m n : ℕ} (hn : 0 < n) :
    RestrictedBurnsideClassTwo m n := by
  refine ⟨n ^ m * n ^ (m * m), fun G _ _ g hgen hexp hcent => ?_⟩
  rw [← Nat.card_eq_fintype_card]
  exact card_le_of_commutator_le_center hn g hgen hexp hcent

/-- **Restricted Burnside problem** (Zelmanov).  The predicate `RestrictedBurnside m n` is the
formalization of the restricted Burnside problem: finite `m`-generated groups of exponent
dividing `n` have uniformly bounded order.  Zelmanov's theorem states that this holds for all `m`
and all `n ≥ 1` (recorded as `ZelmanovConjecture`).

This theorem records a Lean-checked package around that formalization: the base cases (exponent
`1`, exponent `2` with the sharp bound `2 ^ m`, no generators, one generator with the sharp bound
`n`), the two reductions (in the exponent and in the number of generators), the positive solution
for groups of nilpotency class at most `2`, and the sharpness of the hypothesis `n ≥ 1`. -/
theorem zelmanov_restricted_burnside :
    (∀ m : ℕ, RestrictedBurnside m 1) ∧
    (∀ n : ℕ, RestrictedBurnside 0 n) ∧
    (∀ n : ℕ, 0 < n → RestrictedBurnside 1 n) ∧
    (∀ m : ℕ, RestrictedBurnside m 2) ∧
    (∀ m n : ℕ, 0 < n → RestrictedBurnsideClassTwo m n) ∧
    (∀ m n k : ℕ, n ∣ k → RestrictedBurnside m k → RestrictedBurnside m n) ∧
    (∀ m m' n : ℕ, m' ≤ m → RestrictedBurnside m n → RestrictedBurnside m' n) ∧
    ¬ RestrictedBurnside 1 0 :=
  ⟨restrictedBurnside_exponent_one, restrictedBurnside_zero_generators,
    fun _ hn => restrictedBurnside_one_generator hn, restrictedBurnside_exponent_two,
    fun _ _ hn => restrictedBurnsideClassTwo_of_pos hn,
    fun _ _ _ hdvd h => restrictedBurnside_of_dvd hdvd h,
    fun _ _ _ hm h => restrictedBurnside_of_le_generators hm h,
    not_restrictedBurnside_exponent_zero⟩

end Frontier

