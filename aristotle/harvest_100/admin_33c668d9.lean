/-!
# Loeb No Self Trust
Category: Frontier Mind
Target: Frontier.loeb_no_self_trust
Verification: pending
Provenance: Aristotle theorem prover (Harmonic)
-/

set_option relaxedAutoImplicit false
set_option autoImplicit false

namespace Frontier

/-! ## The language

We work in the language of propositional provability logic: propositional atoms, falsum,
implication, and a unary modality `box`, which is read as the arithmetized provability
predicate `Prov(⌜·⌝)` of the theory under consideration. -/

/-- Formulas of the language of provability logic. `Formula.box a` is read as the formal
sentence `Prov(⌜a⌝)`, i.e. "`a` is provable in the theory". -/
inductive Formula : Type
  /-- A propositional atom. -/
  | atom : Nat → Formula
  /-- Falsum. -/
  | bot : Formula
  /-- Implication. -/
  | imp : Formula → Formula → Formula
  /-- The provability modality `Prov(⌜·⌝)`. -/
  | box : Formula → Formula

@[inherit_doc] scoped infixr:26 " ⟶ " => Formula.imp
@[inherit_doc] scoped prefix:max "□" => Formula.box
/-- Falsum. -/
scoped notation "⊥'" => Formula.bot

/-! ## Propositional (tautological) consequence

A *valuation* is any assignment of truth values to formulas that treats falsum and
implication classically; atoms and boxed formulas may receive arbitrary truth values.  A
formula is a *tautology* when it is true under every valuation; these are exactly the
formulas that are substitution instances of propositional tautologies in the modal
language. -/

/-- `v` respects the classical meaning of falsum and implication. -/
structure IsValuation (v : Formula → Prop) : Prop where
  /-- Falsum is false. -/
  bot : ¬ v ⊥'
  /-- Implication is material implication. -/
  imp : ∀ a b : Formula, v (a ⟶ b) ↔ (v a → v b)

/-- A formula is a tautology if it holds under every valuation. -/
def Tautology (a : Formula) : Prop := ∀ v : Formula → Prop, IsValuation v → v a

/-- The valuation generated by an assignment `f` on atoms and `g` on boxed formulas. -/
def stdVal (f : Nat → Prop) (g : Formula → Prop) : Formula → Prop
  | .atom n => f n
  | .bot => False
  | .imp a b => stdVal f g a → stdVal f g b
  | .box a => g a

theorem isValuation_stdVal (f : Nat → Prop) (g : Formula → Prop) :
    IsValuation (stdVal f g) where
  bot := by intro h; exact h
  imp := by intro a b; exact Iff.rfl

/-- Valuations exist, so `Tautology` is not vacuously true of every formula: falsum is not a
tautology. -/
theorem not_tautology_bot : ¬ Tautology ⊥' := by
  intro h
  exact (isValuation_stdVal (fun _ => True) (fun _ => True)).bot
    (h _ (isValuation_stdVal (fun _ => True) (fun _ => True)))

/-! ## Theories with a provability predicate

We axiomatize a theory by its set `Thm` of theorems, subject to the Hilbert–Bernays–Löb
derivability conditions for `box`, together with the diagonal (fixed point) lemma. -/

/-- A theory, presented by its set of theorems `Thm`, equipped with an internal provability
predicate `box` satisfying the Hilbert–Bernays–Löb derivability conditions and the diagonal
lemma.  These are the standard properties enjoyed by `Prov_T(⌜·⌝)` for a recursively
axiomatized, sufficiently strong theory `T`. -/
structure Theory : Type where
  /-- The theorems of the theory. -/
  Thm : Formula → Prop
  /-- The theory contains all propositional tautologies. -/
  taut : ∀ a : Formula, Tautology a → Thm a
  /-- The theory is closed under modus ponens. -/
  mp : ∀ a b : Formula, Thm (a ⟶ b) → Thm a → Thm b
  /-- First derivability condition (necessitation): if `a` is provable, then the theory
  proves that `a` is provable. -/
  nec : ∀ a : Formula, Thm a → Thm (□a)
  /-- Second derivability condition (internal modus ponens, axiom K). -/
  distrib : ∀ a b : Formula, Thm (□(a ⟶ b) ⟶ (□a ⟶ □b))
  /-- Third derivability condition (provable `Σ₁`-completeness, axiom 4). -/
  four : ∀ a : Formula, Thm (□a ⟶ □□a)
  /-- Diagonal (fixed point) lemma: every formula `a` has a fixed point `d` that the theory
  proves equivalent to `□d ⟶ a`. -/
  diag : ∀ a : Formula, ∃ d : Formula, Thm (d ⟶ (□d ⟶ a)) ∧ Thm ((□d ⟶ a) ⟶ d)

/-- A theory is consistent when it does not prove falsum. -/
def Theory.Consistent (T : Theory) : Prop := ¬ T.Thm ⊥'

/-- The local reflection principle for `a`: "if `a` is provable then `a`", i.e.
`Prov(⌜a⌝) → a`. -/
def Theory.reflection (_T : Theory) (a : Formula) : Formula := □a ⟶ a

namespace Theory

variable (T : Theory)

/-- Modus ponens against a tautological implication. -/
theorem mpTaut {a b : Formula} (h : Tautology (a ⟶ b)) (ha : T.Thm a) : T.Thm b :=
  T.mp _ _ (T.taut _ h) ha

/-- Modus ponens against a tautological implication with two premises. -/
theorem mpTaut₂ {a b c : Formula} (h : Tautology (a ⟶ (b ⟶ c))) (ha : T.Thm a)
    (hb : T.Thm b) : T.Thm c :=
  T.mp _ _ (T.mp _ _ (T.taut _ h) ha) hb

/-- Chaining two provable implications. -/
theorem imp_trans {a b c : Formula} (h₁ : T.Thm (a ⟶ b)) (h₂ : T.Thm (b ⟶ c)) :
    T.Thm (a ⟶ c) := by
  refine T.mpTaut₂ (a := a ⟶ b) (b := b ⟶ c) (c := a ⟶ c) ?_ h₁ h₂
  intro v hv
  simp only [hv.imp]
  exact fun hab hbc x => hbc (hab x)

/-- Distributing a provable implication over a shared antecedent. -/
theorem imp_dedup {a b c : Formula} (h₁ : T.Thm (a ⟶ (b ⟶ c))) (h₂ : T.Thm (a ⟶ b)) :
    T.Thm (a ⟶ c) := by
  refine T.mpTaut₂ (a := a ⟶ (b ⟶ c)) (b := a ⟶ b) (c := a ⟶ c) ?_ h₁ h₂
  intro v hv
  simp only [hv.imp]
  exact fun habc hab x => habc x (hab x)

/-- Key step in Löb's proof: if `d` is a diagonal formula for `a`, then the theory proves
`□d ⟶ □a`. -/
theorem box_diag_imp_box {a d : Formula} (h₁ : T.Thm (d ⟶ (□d ⟶ a))) :
    T.Thm (□d ⟶ □a) := by
  have n1 : T.Thm (□(d ⟶ (□d ⟶ a))) := T.nec _ h₁
  have s1 : T.Thm (□d ⟶ □(□d ⟶ a)) := T.mp _ _ (T.distrib _ _) n1
  have s2 : T.Thm (□d ⟶ (□□d ⟶ □a)) := T.imp_trans s1 (T.distrib _ _)
  exact T.imp_dedup s2 (T.four d)

/-- **Löb's theorem.** If a theory proves the reflection principle for `a`, then it proves
`a` itself. -/
theorem loeb (a : Formula) (h : T.Thm (T.reflection a)) : T.Thm a := by
  obtain ⟨d, h₁, h₂⟩ := T.diag a
  have s3 : T.Thm (□d ⟶ □a) := T.box_diag_imp_box h₁
  have s4 : T.Thm (□d ⟶ a) := T.imp_trans s3 h
  have s5 : T.Thm d := T.mp _ _ h₂ s4
  have s6 : T.Thm (□d) := T.nec _ s5
  exact T.mp _ _ s4 s6

end Theory

/-! ## The main result -/

/-- **Löb: no self trust.**

A consistent theory `T` — satisfying the Hilbert–Bernays–Löb derivability conditions and the
diagonal lemma — cannot prove its own reflection principle `Prov(⌜a⌝) → a` for any sentence
`a` that it does not already prove.  Moreover, by consistency such an unprovable sentence
exists, so the statement is not vacuous.

The second conjunct is the reflection failure itself, an immediate consequence of Löb's
theorem `Frontier.Theory.loeb`. -/
theorem loeb_no_self_trust (T : Theory) (hcon : T.Consistent) :
    (∃ a : Formula, ¬ T.Thm a) ∧ (∀ a : Formula, ¬ T.Thm a → ¬ T.Thm (T.reflection a)) := by
  refine ⟨⟨⊥', hcon⟩, ?_⟩
  intro a ha hrefl
  exact ha (T.loeb a hrefl)

/-- A consistent theory cannot prove the *uniform* reflection schema either: if it proved
`Prov(⌜a⌝) → a` for every sentence `a`, it would prove every sentence, contradicting
consistency. -/
theorem no_uniform_reflection (T : Theory) (hcon : T.Consistent) :
    ¬ (∀ a : Formula, T.Thm (T.reflection a)) := fun h => hcon (T.loeb ⊥' (h ⊥'))

/-- A concrete instance of `Frontier.loeb_no_self_trust`: a consistent theory does not prove
the reflection principle for falsum, i.e. it does not prove its own consistency statement
`Prov(⌜⊥⌝) → ⊥`.  (Gödel's second incompleteness theorem, in its Löb-derived form.) -/
theorem not_provable_consistency (T : Theory) (hcon : T.Consistent) :
    ¬ T.Thm (T.reflection ⊥') := (loeb_no_self_trust T hcon).2 ⊥' hcon

/-! ## Non-vacuity: a consistent theory satisfying all the conditions exists

The axioms of `Frontier.Theory` are satisfiable together with consistency: take the theorems
to be the formulas true at the single world of the one-point irreflexive Kripke frame (where
every boxed formula is true and every atom is false). -/

/-- Truth at the single world of the one-point irreflexive Kripke frame. -/
def oneWorld : Formula → Prop := stdVal (fun _ => False) (fun _ => True)

/-- A theory satisfying all the derivability conditions and the diagonal lemma. -/
def oneWorldTheory : Theory where
  Thm := oneWorld
  taut _ h := h _ (isValuation_stdVal _ _)
  mp _ _ h₁ h₂ := h₁ h₂
  nec _ _ := trivial
  distrib _ _ := fun _ _ => trivial
  four _ := fun _ => trivial
  diag a := ⟨a, fun ha _ => ha, fun h => h trivial⟩

/-- The witnessing theory is consistent, so `Frontier.loeb_no_self_trust` is not vacuous. -/
theorem oneWorldTheory_consistent : oneWorldTheory.Consistent := fun h => h

end Frontier

