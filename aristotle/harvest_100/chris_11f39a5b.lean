/-
Theorems about the resolution mechanism and the paradox resolving to false.
-/
theorem Brockian.RussellResolution.Corrected.resolution_mechanism :
    ∀ t ∈ Brockian.RussellResolution.Corrected.resolution_gap,
      ∃ (meta_proof : Brockian.RussellResolution.Corrected.RussellQuestion.statement),
        ¬(∃ R : Set Brockian.MathematicalTruth, ∀ T, T ∈ R ↔ T ∉ R) := by
          -- By definition of the resolution gap, we know that the Russell Question is true at any time t in the gap. Hence, we can conclude that the statement holds.
          intros t ht
          simp [Brockian.RussellResolution.Corrected.resolution_gap] at ht
          exact ⟨by
          intro R hR;
          obtain ⟨ T, hT ⟩ := hR; by_cases h : T ∈ R <;> simp_all +decide ;, by
            exact fun ⟨ R, hR ⟩ => by specialize hR ⟨ False, 1, by norm_num ⟩ ; tauto;⟩

theorem Brockian.RussellResolution.Corrected.paradox_resolves_to_false (t : ℝ) (ht : t ≥ Brockian.t_emergence Brockian.RussellResolution.Corrected.RussellParadox) :
    Brockian.RussellResolution.Corrected.RussellParadox.statement = False := by
      -- The statement of the Russell Paradox is that there exists a set R such that for all T, T is in R if and only if T is not in R. This is a contradiction, so the statement must be false.
      simp [Brockian.RussellResolution.Corrected.RussellParadox];
      -- The set of mathematical truths is nonempty because there exists at least one such truth.
      use True, 1, by norm_num

/-
Property: Spectral decomposition exists.
-/
def Brockian.SpectralTheory.SpectralDecompositionProperty : Prop := 
  ∀ f : Brockian.MathSpace, ∃ (c : ℕ → ℂ), f = fun T => ∑' n, c n * Brockian.SpectralTheory.eigenmode n T
