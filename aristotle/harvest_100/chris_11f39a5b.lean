/-
Definition of a Formal System with bounded axiom complexity and consistency.
-/
structure Brockian.FormalSystem where
  axioms : Set Brockian.MathematicalTruth
  provable : Brockian.MathematicalTruth → Prop
  axiom_complexity_bound : ∃ M, ∀ A ∈ axioms, A.complexity ≤ M
  consistent : ¬∃ T : Brockian.MathematicalTruth, provable T ∧ 
    provable ⟨¬T.statement, T.complexity, T.complexity_pos⟩

/-
Definition of Gödel complexity and proof that it is positive.
-/
noncomputable def Brockian.GoedelResolution.goedel_complexity (S : Brockian.FormalSystem) : ℝ :=
  let M := Classical.choose S.axiom_complexity_bound
  (max M 1) * Brockian.phi ^ 2

lemma Brockian.GoedelResolution.goedel_complexity_pos (S : Brockian.FormalSystem) : 0 < Brockian.GoedelResolution.goedel_complexity S := by
  unfold Brockian.GoedelResolution.goedel_complexity
  have h_phi : 0 < Brockian.phi := Brockian.GoldenRatio.pos
  have h_phi_sq : 0 < Brockian.phi ^ 2 := pow_pos h_phi 2
  have h_max : 0 < max (Classical.choose S.axiom_complexity_bound) 1 := 
    lt_of_lt_of_le zero_lt_one (le_max_right _ _)
  apply mul_pos h_max h_phi_sq

/-
Definition of the Gödel sentence and proof that its complexity exceeds all axioms.
-/
def Brockian.GoedelResolution.GoedelSentence (S : Brockian.FormalSystem) : Brockian.MathematicalTruth where
  statement := ∃ n : ℕ, True
  complexity := Brockian.GoedelResolution.goedel_complexity S
  complexity_pos := Brockian.GoedelResolution.goedel_complexity_pos S

theorem Brockian.GoedelResolution.complexity_exceeds_all_axioms (S : Brockian.FormalSystem) 
    (A : Brockian.MathematicalTruth) (hA : A ∈ S.axioms) :
    A.complexity < (Brockian.GoedelResolution.GoedelSentence S).complexity := by
  unfold Brockian.GoedelResolution.GoedelSentence Brockian.GoedelResolution.goedel_complexity; simp
  let M := Classical.choose S.axiom_complexity_bound
  have hM : ∀ A ∈ S.axioms, A.complexity ≤ M := Classical.choose_spec S.axiom_complexity_bound
  have h_le : A.complexity ≤ M := hM A hA
  have h_M_le_max : M ≤ max M 1 := le_max_left M 1
  have h_phi_sq_gt_one : 1 < Brockian.phi ^ 2 := by
    rw [Brockian.GoldenRatio.defining_eq]; linarith [Brockian.GoldenRatio.gt_one]
  have h_max_pos : 0 < max M 1 := lt_of_lt_of_le zero_lt_one (le_max_right M 1)
  calc A.complexity ≤ M := h_le
    _ ≤ max M 1 := h_M_le_max
    _ < max M 1 * Brockian.phi ^ 2 := by
      nth_rw 1 [← mul_one (max M 1)]
      apply mul_lt_mul_of_pos_left h_phi_sq_gt_one h_max_pos

/-
Definitions for Gödel resolution: axiom emergence supremum, provability at a time, and the incompleteness gap.
-/
noncomputable def Brockian.GoedelResolution.axiom_emergence_sup (S : Brockian.FormalSystem) : ℝ :=
  sSup {Brockian.t_emergence A | A ∈ S.axioms}

def Brockian.GoedelResolution.provable_at (T : Brockian.MathematicalTruth) (S : Brockian.FormalSystem) (t : ℝ) : Prop :=
  Brockian.TemporalDynamics.is_actualized T t ∧
  ∃ (proof : List Brockian.MathematicalTruth),
    (∀ P ∈ proof, P ∈ S.axioms ∨ Brockian.TemporalDynamics.is_actualized P t) ∧ T ∈ proof

noncomputable def Brockian.GoedelResolution.incompleteness_gap (S : Brockian.FormalSystem) : Set ℝ :=
  {t | Brockian.GoedelResolution.axiom_emergence_sup S ≤ t ∧ t < Brockian.t_emergence (Brockian.GoedelResolution.GoedelSentence S)}

/-
Temporal incompleteness theorem, assuming the axioms as variables.
-/
section GoedelAxioms

variable (axioms_nonempty : ∀ S : Brockian.FormalSystem, S.axioms.Nonempty)
variable (axiom_emergence_bounded : ∀ S : Brockian.FormalSystem, ∃ B, ∀ A ∈ S.axioms, Brockian.t_emergence A ≤ B)

theorem Brockian.GoedelResolution.temporal_incompleteness (S : Brockian.FormalSystem) :
    let G := Brockian.GoedelResolution.GoedelSentence S
    ∀ t ∈ Brockian.GoedelResolution.incompleteness_gap S,
      ¬Brockian.GoedelResolution.provable_at G S t ∧ 
      ¬Brockian.GoedelResolution.provable_at ⟨¬G.statement, G.complexity, G.complexity_pos⟩ S t := by
  intro G t ht
  unfold Brockian.GoedelResolution.incompleteness_gap at ht
  constructor
  · intro ⟨h_act, _⟩; exact not_le.mpr ht.2 h_act
  · intro ⟨h_act, _⟩; exact not_le.mpr ht.2 h_act

end GoedelAxioms

