#check Brockian.SpectralTheory.MeasureSpace

/-
Lemma: The real part of the inner product is the integral of the squared norm.
-/
theorem Brockian.SpectralTheory.inner_re_eq_integral_normSq (f : Brockian.MathSpace) :
    (Brockian.SpectralTheory.inner f f).re = ∫ T, Complex.normSq (f T) ∂Brockian.SpectralTheory.MeasureSpace := by
      convert congr_arg Complex.re ( Brockian.SpectralTheory.inner_eq_integral_norm_sq f ) using 1;
      convert integral_ofReal.symm;
      erw [ integral_ofReal ] ; norm_cast

