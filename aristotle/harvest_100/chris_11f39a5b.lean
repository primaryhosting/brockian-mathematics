theorem Brockian.MetaTheorems.phi_uniqueness (c : ℝ) (hc : 1 < c) :
    (∀ T₁ T₂ : Brockian.MathematicalTruth, T₂.complexity = T₁.complexity + 1 →
      Brockian.t_emergence T₂ = c * Brockian.t_emergence T₁) → c = Brockian.phi := by
        intro h
        have := h ⟨True, 1, by norm_num⟩ ⟨True, 2, by norm_num⟩ (by norm_num)
        simp [Brockian.t_emergence] at this;
        nlinarith [ show 0 < Brockian.t_Planck * Brockian.phi by exact mul_pos ( by norm_num [ Brockian.t_Planck ] ) ( by exact Brockian.GoldenRatio.pos ) ]

