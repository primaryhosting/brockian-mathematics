/-
Definitions of the golden ratio φ and its conjugate φ_bar.
-/
open scoped BigOperators Real Nat Classical Pointwise
open Real Complex Nat Filter Set

noncomputable def Brockian.phi : ℝ := (1 + Real.sqrt 5) / 2
noncomputable def Brockian.phi_bar : ℝ := (1 - Real.sqrt 5) / 2

/-
Basic inequalities for the golden ratio.
-/
theorem Brockian.GoldenRatio.pos : 0 < Brockian.phi := by
  exact div_pos ( by positivity ) ( by positivity )

theorem Brockian.GoldenRatio.gt_one : 1 < Brockian.phi := by
  exact lt_div_iff₀' ( by norm_num ) |>.2 ( by nlinarith [ Real.sqrt_nonneg 5, Real.sq_sqrt ( show 0 ≤ 5 by norm_num ) ] )

/-
The defining equation of the golden ratio.
-/
theorem Brockian.GoldenRatio.defining_eq : Brockian.phi ^ 2 = Brockian.phi + 1 := by
  unfold Brockian.phi; ring_nf; norm_num;
  ring

theorem Brockian.GoldenRatio.polynomial : Brockian.phi ^ 2 - Brockian.phi - 1 = 0 := by
  unfold Brockian.phi; ring_nf; norm_num;

/-
Reciprocal, sum, and product properties of the golden ratio and its conjugate.
-/
theorem Brockian.GoldenRatio.reciprocal : Brockian.phi⁻¹ = Brockian.phi - 1 := by
  rw [ inv_eq_of_mul_eq_one_right ] ; unfold Brockian.phi ; ring ; norm_num;

theorem Brockian.GoldenRatio.sum_conj : Brockian.phi + Brockian.phi_bar = 1 := by
  unfold Brockian.phi Brockian.phi_bar; ring;

theorem Brockian.GoldenRatio.prod_conj : Brockian.phi * Brockian.phi_bar = -1 := by
  unfold Brockian.phi Brockian.phi_bar; ring_nf; norm_num;

/-
Properties of the conjugate of the golden ratio.
-/
theorem Brockian.GoldenRatio.conj_neg : Brockian.phi_bar < 0 := by
  exact div_neg_of_neg_of_pos ( sub_neg_of_lt ( Real.lt_sqrt_of_sq_lt ( by norm_num ) ) ) ( by norm_num )

theorem Brockian.GoldenRatio.conj_abs_lt_1 : |Brockian.phi_bar| < 1 := by
  exact abs_lt.mpr ⟨ by rw [ show Brockian.phi_bar = ( 1 - Real.sqrt 5 ) / 2 by rfl ] ; nlinarith [ Real.sqrt_nonneg 5, Real.sq_sqrt ( show 0 ≤ 5 by norm_num ) ], by rw [ show Brockian.phi_bar = ( 1 - Real.sqrt 5 ) / 2 by rfl ] ; nlinarith [ Real.sqrt_nonneg 5, Real.sq_sqrt ( show 0 ≤ 5 by norm_num ) ] ⟩

/-
The golden ratio grows exponentially faster than linear.
-/
theorem Brockian.GoldenRatio.pow_grows (n : ℕ) (hn : 0 < n) : (n : ℝ) < Brockian.phi ^ n := by
  induction hn <;> simp_all +decide [ pow_succ' ];
  · exact?;
  · rw [ pow_succ ];
    rename_i k hk ih₂;
    rcases k with ( _ | _ | k ) <;> norm_num at *;
    · rw [ show Brockian.phi = ( 1 + Real.sqrt 5 ) / 2 by rfl ] ; nlinarith [ Real.sqrt_nonneg 5, Real.sq_sqrt ( show 0 ≤ 5 by norm_num ) ];
    · nlinarith [ show ( Brockian.phi : ℝ ) > 1 by exact lt_of_le_of_lt ( by norm_num ) ( Brockian.GoldenRatio.gt_one ), show ( Brockian.phi : ℝ ) ^ 2 = Brockian.phi + 1 by exact Brockian.GoldenRatio.defining_eq ]

/-
Definitions for ray structure and prime theory.
-/
def Brockian.q : ℕ := 5

abbrev Brockian.RaySpace := Fin Brockian.q
abbrev Brockian.ActiveRay := Fin 4

def Brockian.ray (n : ℕ) : Brockian.RaySpace := ⟨n % Brockian.q, Nat.mod_lt n (by decide)⟩

def Brockian.activeRayToResidue (j : Brockian.ActiveRay) : Brockian.RaySpace :=
  ⟨j.val + 1, by
    exact Nat.lt_of_le_of_lt ( Nat.succ_le_of_lt j.is_lt ) ( by decide )⟩

/-
Basic properties of rays: additivity, multiplicativity, and periodicity.
-/
theorem Brockian.RayTheory.ray_add (a b : ℕ) :
    Brockian.ray (a + b) = ⟨((Brockian.ray a).val + (Brockian.ray b).val) % Brockian.q, Nat.mod_lt _ (by decide)⟩ := by
      -- By definition of Brockian.ray, we have that Brockian.ray (a + b) = (a + b) % q.
      simp [Brockian.ray]

theorem Brockian.RayTheory.ray_mul (a b : ℕ) :
    Brockian.ray (a * b) = ⟨((Brockian.ray a).val * (Brockian.ray b).val) % Brockian.q, Nat.mod_lt _ (by decide)⟩ := by
      unfold Brockian.ray; aesop;

theorem Brockian.RayTheory.periodic (n k : ℕ) : Brockian.ray (n + k * Brockian.q) = Brockian.ray n := by
  -- By definition of Brockian.ray, we have Brockian.ray (n + k * q) = (n + k * q) % q.
  simp [Brockian.ray]

/-
Ray 0 contains only prime p=5 (ray zero singularity).
-/
theorem Brockian.PrimeRays.ray_zero_singularity (p : ℕ) (hp : p.Prime) (h : p > 5) :
    Brockian.ray p ≠ ⟨0, by decide⟩ := by
  intro h_contra
  have : 5 ∣ p := by rw [Nat.dvd_iff_mod_eq_zero]; exact congr_arg Fin.val h_contra
  rw [Nat.dvd_prime hp] at this; omega

/-
Every prime p > 5 lies on a unique active ray.
-/
theorem Brockian.PrimeRays.prime_on_unique_active_ray (p : ℕ) (hp : p.Prime) (h : p > 5) :
    ∃! j : Brockian.ActiveRay, Brockian.ray p = Brockian.activeRayToResidue j := by
      -- By definition of $Brockian.ray$, there exists a unique $j$ such that $p \mod 5 = j + 1$.
      obtain ⟨j, hj⟩ : ∃ j : Fin 4, p % 5 = j + 1 := by
        have := Nat.mod_lt p ( by decide : 5 > 0 ) ; interval_cases _ : p % 5 <;> simp_all +decide [ ← Nat.dvd_iff_mod_eq_zero, hp.dvd_iff_eq ] ;
      -- To prove uniqueness, assume there exists another $j'$ such that $p \mod 5 = j' + 1$. Since $p \mod 5$ is fixed, this implies $j' = j$.
      have h_unique : ∀ j' : Fin 4, p % 5 = j' + 1 → j' = j := by
        exact fun j' hj' => by fin_cases j <;> fin_cases j' <;> simp_all +decide only ;
      exact ⟨ j, by aesop, fun j' hj' => h_unique j' <| by simpa [ Fin.ext_iff ] using congr_arg ( fun x : Fin 5 => ( x : ℕ ) ) hj' ⟩

/-
Dirichlet's theorem on arithmetic progressions applied to rays, and totient calculation.
-/
theorem Brockian.PrimeRays.each_ray_has_infinitely_many_primes (j : Brockian.ActiveRay) :
    ∀ N, ∃ p > N, p.Prime ∧ Brockian.ray p = Brockian.activeRayToResidue j := by
  intro N
  obtain ⟨p, hp_prime, hp_gt_N, hp_ray⟩ : ∃ p > N, Nat.Prime p ∧ p % Brockian.q = Brockian.activeRayToResidue j := by
    have h_dirichlet : ∀ j : Fin 4, Set.Infinite {p : ℕ | Nat.Prime p ∧ p % 5 = j.val + 1} := by
      intro j
      have := @Nat.setOf_prime_and_eq_mod_infinite
      convert @this 5 (by infer_instance) (j + 1 : ZMod 5) _ using 1
      · ext; simp [← ZMod.val_natCast]
        fin_cases j <;> simp [ZMod]
        · exact fun _ => by erw [Fin.ext_iff]; rfl
        · exact fun _ => ⟨fun h => Fin.ext h, fun h => h.symm ▸ rfl⟩
        · exact fun _ => ⟨fun h => by simpa [Fin.ext_iff] using h, 
                         fun h => by simpa [Fin.ext_iff] using h⟩
        · exact fun _ => by erw [Fin.ext_iff]; simp [ZMod.val]
      · fin_cases j <;> decide
    have := h_dirichlet j; have := this.exists_gt N; aesop
  exact ⟨p, hp_prime, hp_gt_N, Fin.ext hp_ray⟩

theorem Brockian.PrimeRays.totient_equals_active : Nat.totient Brockian.q = 4 := by rfl

/-
Inductive definition of allowed twin prime transitions.
-/
inductive Brockian.TwinTransition : Brockian.RaySpace → Brockian.RaySpace → Prop
  | one_three : Brockian.TwinTransition ⟨1, by decide⟩ ⟨3, by decide⟩
  | two_four  : Brockian.TwinTransition ⟨2, by decide⟩ ⟨4, by decide⟩
  | four_one  : Brockian.TwinTransition ⟨4, by decide⟩ ⟨1, by decide⟩

/-
Transition 3→0 is forbidden for twin primes.
-/
theorem Brockian.TwinPrimes.forbidden_transition (p : ℕ) (hp : p.Prime) (hp2 : (p + 2).Prime) 
    (h : p > 5) (h_ray : Brockian.ray p = ⟨3, by decide⟩) : False := by
  have : p % 5 = 3 := congr_arg Fin.val h_ray
  have : (p + 2) % 5 = 0 := by omega
  have : 5 ∣ (p + 2) := Nat.dvd_of_mod_eq_zero this
  rw [hp2.dvd_iff_eq] at this <;> omega

/-
Twin primes follow allowed transitions, and a conjecture about twin prime constants.
-/
theorem Brockian.TwinPrimes.follow_allowed_transitions (p : ℕ) (hp : p.Prime) (hp2 : (p + 2).Prime)
    (h : p > 5) : Brockian.TwinTransition (Brockian.ray p) (Brockian.ray (p + 2)) := by
      -- By definition of $p$ and $p+2$, their remainders when divided by $5$ must be $1$, $2$, $3$, or $4$.
      have h_mod : (p % 5 = 1 ∨ p % 5 = 2 ∨ p % 5 = 3 ∨ p % 5 = 4) ∧ ((p + 2) % 5 = 1 ∨ (p + 2) % 5 = 2 ∨ (p + 2) % 5 = 3 ∨ (p + 2) % 5 = 4) := by
        exact ⟨ by have := Nat.mod_lt p ( by decide : 5 > 0 ) ; interval_cases _ : p % 5 <;> simp_all +decide [ ← Nat.dvd_iff_mod_eq_zero, hp.dvd_iff_eq ], by have := Nat.mod_lt ( p + 2 ) ( by decide : 5 > 0 ) ; interval_cases _ : ( p + 2 ) % 5 <;> simp_all +decide [ ← Nat.dvd_iff_mod_eq_zero, hp2.dvd_iff_eq ] ⟩;
      -- By checking each possible value of p mod 5, we can see that the only valid transitions are (1,3), (2,4), and (4,1).
      have h_cases : (p % 5 = 1 ∧ (p + 2) % 5 = 3) ∨ (p % 5 = 2 ∧ (p + 2) % 5 = 4) ∨ (p % 5 = 4 ∧ (p + 2) % 5 = 1) := by
        rcases h_mod with ⟨ h | h | h | h, h' | h' | h' | h' ⟩ <;> simp_all +decide [ Nat.add_mod ];
      rcases h_cases with ( h_cases | h_cases | h_cases ) <;> simp_all +decide [ Brockian.ray ];
      · convert Brockian.TwinTransition.one_three;
        · exact h_cases.1;
        · exact h_cases.2;
      · convert Brockian.TwinTransition.two_four;
        · exact h_cases.1;
        · exact h_cases.2;
      · convert Brockian.TwinTransition.four_one;
        · exact h_cases.1;
        · exact h_cases.2

/-- Conjecture: Twin prime constants satisfy φ-ratios -/
def Brockian.TwinPrimes.phi_ratio_conjecture : Prop :=
  ∃ C₁₃ C₂₄ C₄₁ : ℝ, 0 < C₁₃ ∧ 0 < C₂₄ ∧ 0 < C₄₁ ∧
    C₁₃ / C₂₄ = Brockian.phi ∧ C₂₄ / C₄₁ = Brockian.phi

/-
Definitions of rotation and reflection for the dihedral symmetry of active rays.
-/
def Brockian.DihedralSymmetry.rotate (j : Brockian.ActiveRay) : Brockian.ActiveRay := ⟨(j.val + 1) % 4, Nat.mod_lt _ (by decide)⟩

def Brockian.DihedralSymmetry.reflect (j : Brockian.ActiveRay) : Brockian.ActiveRay := ⟨(4 - j.val) % 4, Nat.mod_lt _ (by decide)⟩

/-
Basic properties of the dihedral symmetry operations: order 4 rotation, reflection involution, and braid relation.
-/
theorem Brockian.DihedralSymmetry.rotate_order_4 (j : Brockian.ActiveRay) : 
    Brockian.DihedralSymmetry.rotate (Brockian.DihedralSymmetry.rotate (Brockian.DihedralSymmetry.rotate (Brockian.DihedralSymmetry.rotate j))) = j := by fin_cases j <;> rfl

theorem Brockian.DihedralSymmetry.reflect_involution (j : Brockian.ActiveRay) : 
    Brockian.DihedralSymmetry.reflect (Brockian.DihedralSymmetry.reflect j) = j := by fin_cases j <;> rfl

theorem Brockian.DihedralSymmetry.braid_relation (j : Brockian.ActiveRay) :
    Brockian.DihedralSymmetry.reflect (Brockian.DihedralSymmetry.rotate (Brockian.DihedralSymmetry.reflect j)) = Brockian.DihedralSymmetry.rotate (Brockian.DihedralSymmetry.rotate (Brockian.DihedralSymmetry.rotate j)) := by fin_cases j <;> rfl

/-
Bijectivity of rotation and reflection.
-/
theorem Brockian.DihedralSymmetry.rotate_bijective : Function.Bijective Brockian.DihedralSymmetry.rotate := by
  constructor
  · intro a b hab; fin_cases a <;> fin_cases b <;> simp [Brockian.DihedralSymmetry.rotate] at hab <;> try rfl
  · intro b; use ⟨(b.val + 3) % 4, Nat.mod_lt _ (by decide)⟩; fin_cases b <;> rfl

theorem Brockian.DihedralSymmetry.reflect_bijective : Function.Bijective Brockian.DihedralSymmetry.reflect :=
  Function.bijective_iff_has_inverse.mpr ⟨Brockian.DihedralSymmetry.reflect, Brockian.DihedralSymmetry.reflect_involution, Brockian.DihedralSymmetry.reflect_involution⟩

/-
The active rays form a D4 dihedral group structure.
-/
theorem Brockian.DihedralSymmetry.is_dihedral_group :
    ∃ (r s : Brockian.ActiveRay → Brockian.ActiveRay),
      (∀ j, r (r (r (r j))) = j) ∧ (∀ j, s (s j) = j) ∧ 
      (∀ j, s (r (s j)) = r (r (r j))) := by
  use Brockian.DihedralSymmetry.rotate, Brockian.DihedralSymmetry.reflect
  exact ⟨Brockian.DihedralSymmetry.rotate_order_4, Brockian.DihedralSymmetry.reflect_involution, Brockian.DihedralSymmetry.braid_relation⟩

/-
Checking for Binet's formula in Mathlib.
-/
#check Real.coe_fib_eq

/-
Binet's formula for Fibonacci numbers using our definitions of phi and phi_bar.
-/
theorem Brockian.Fibonacci.binet : ∀ n : ℕ, (Nat.fib n : ℝ) = (Brockian.phi ^ n - Brockian.phi_bar ^ n) / Real.sqrt 5 := by
  intro n
  rw [Real.coe_fib_eq]
  unfold Brockian.phi Brockian.phi_bar Real.goldenRatio Real.goldenConj
  rfl

/-
The ratio of consecutive Fibonacci numbers converges to the golden ratio.
-/
open Filter Topology

theorem Brockian.Fibonacci.ratio_converges : 
    Tendsto (fun n : ℕ => (Nat.fib (n + 1) : ℝ) / Nat.fib n) atTop (𝓝 Brockian.phi) := by
  have h_binet : ∀ n, (Nat.fib n : ℝ) = (Brockian.phi ^ n - Brockian.phi_bar ^ n) / Real.sqrt 5 := Real.coe_fib_eq
  simp_rw [h_binet]
  suffices h_simplify : Tendsto 
      (fun n => (Brockian.phi - Brockian.phi_bar * (Brockian.phi_bar / Brockian.phi) ^ n) / (1 - (Brockian.phi_bar / Brockian.phi) ^ n)) atTop (𝓝 Brockian.phi) by
    convert h_simplify using 2
    field_simp
    convert mul_div_mul_left _ _ (pow_ne_zero _ (show Brockian.phi ≠ 0 by exact ne_of_gt Brockian.GoldenRatio.pos)) 
      using 1
    ring
    norm_num [mul_assoc, mul_comm, mul_left_comm, ne_of_gt (show 0 < Brockian.phi from Brockian.GoldenRatio.pos)]
    convert rfl using 2; ring
    all_goals congr! 1
    · norm_num [show Brockian.phi ≠ 0 by exact ne_of_gt Brockian.GoldenRatio.pos]
      exact mul_div_cancel_left₀ _ (pow_ne_zero _ (ne_of_gt Brockian.GoldenRatio.pos))
    · simp [mul_left_comm (Brockian.phi ^ _), mul_assoc, ne_of_gt (show 0 < Brockian.phi from Brockian.GoldenRatio.pos)]
  have h_abs : |Brockian.phi_bar / Brockian.phi| < 1 := by
    norm_num [abs_div, Brockian.phi, Brockian.phi_bar]
    rw [div_lt_iff₀] <;> cases abs_cases (1 - Real.sqrt 5) <;> cases abs_cases (1 + Real.sqrt 5) <;> 
      nlinarith [Real.sqrt_nonneg 5, Real.sq_sqrt (show 0 ≤ 5 by norm_num)]
  exact le_trans (Tendsto.div (tendsto_const_nhds.sub 
      (tendsto_const_nhds.mul (tendsto_pow_atTop_nhds_zero_of_abs_lt_one h_abs))) 
    (tendsto_const_nhds.sub (tendsto_pow_atTop_nhds_zero_of_abs_lt_one h_abs)) 
    (by norm_num)) (by norm_num)

/-
Stability of the Fibonacci ratio convergence to the golden ratio.
-/
theorem Brockian.Fibonacci.phi_stability (n : ℕ) (hn : 4 ≤ n) :
    |(Nat.fib (n + 1) : ℝ) / Nat.fib n - Brockian.phi| ≤ |Brockian.phi_bar| ^ n / Real.sqrt 5 := by
  have h_binet : ∀ n : ℕ, n > 0 → 
      ((Nat.fib (n + 1) : ℝ) / (Nat.fib n : ℝ) - Brockian.phi) = 
      (Brockian.phi_bar^n * (Brockian.phi - Brockian.phi_bar)) / (Nat.fib n * Real.sqrt 5) := by
    have h_binet : ∀ n : ℕ, (Nat.fib n : ℝ) = (Brockian.phi^n - Brockian.phi_bar^n) / Real.sqrt 5 := Brockian.Fibonacci.binet
    intro n hn; rw [h_binet, h_binet]; ring
    field_simp
    rw [add_div']
    · ring
    · exact sub_ne_zero_of_ne <| ne_of_gt <| by 
        exact lt_of_abs_lt <| by 
          norm_num [abs_of_pos, Brockian.phi, Brockian.phi_bar]
          exact pow_lt_pow_left₀ 
            (show |(1 - Real.sqrt 5) / 2| < (1 + Real.sqrt 5) / 2 by 
              rw [abs_of_neg] <;> nlinarith [Real.sqrt_nonneg 5, Real.sq_sqrt (show 0 ≤ 5 by norm_num)]) 
            (abs_nonneg _) (by linarith)
  have h_abs : |(Nat.fib (n + 1) : ℝ) / (Nat.fib n : ℝ) - Brockian.phi| = 
      |Brockian.phi_bar|^n * |Brockian.phi - Brockian.phi_bar| / (Nat.fib n * Real.sqrt 5) := by
    rw [h_binet n (by linarith), abs_div, abs_mul, abs_pow, 
        abs_of_nonneg (by positivity : (0 : ℝ) ≤ Nat.fib n * Real.sqrt 5)]
  rw [h_abs, div_le_div_iff₀] <;> norm_num [abs_of_pos, Brockian.phi, Brockian.phi_bar] <;> ring <;> norm_num
  · rw [mul_right_comm]; gcongr; ring_nf
    nlinarith only [Real.sqrt_nonneg 5, Real.sq_sqrt (show 0 ≤ 5 by norm_num), 
      show (Nat.fib n : ℝ) ≥ 3 by exact_mod_cast le_trans (by norm_num) (Nat.fib_mono hn)]
  · linarith

/-
Definitions for temporal dynamics: MathematicalTruth structure, Planck time, and emergence time.
-/
structure Brockian.MathematicalTruth where
  statement : Prop
  complexity : ℝ
  complexity_pos : 0 < complexity

def Brockian.t_Planck : ℝ := 1

def Brockian.t_emergence (T : Brockian.MathematicalTruth) : ℝ := Brockian.phi ^ T.complexity * Brockian.t_Planck

/-
Theorems about temporal dynamics: time is positive, emergence is monotone with complexity, and phi-quantized steps.
-/
theorem Brockian.TemporalDynamics.time_positive (T : Brockian.MathematicalTruth) : 0 < Brockian.t_emergence T := by
  unfold Brockian.t_emergence Brockian.t_Planck
  apply mul_pos; exact rpow_pos_of_pos Brockian.GoldenRatio.pos _; norm_num

theorem Brockian.TemporalDynamics.emergence_monotone {T₁ T₂ : Brockian.MathematicalTruth} (h : T₁.complexity < T₂.complexity) :
    Brockian.t_emergence T₁ < Brockian.t_emergence T₂ := by
  unfold Brockian.t_emergence Brockian.t_Planck
  rw [mul_lt_mul_right (by norm_num : (0:ℝ) < 1)]
  exact rpow_lt_rpow_of_exponent_lt Brockian.GoldenRatio.gt_one h

theorem Brockian.TemporalDynamics.phi_quantized_step {T₁ T₂ : Brockian.MathematicalTruth} 
    (h : T₂.complexity = T₁.complexity + 1) :
    Brockian.t_emergence T₂ = Brockian.phi * Brockian.t_emergence T₁ := by
  unfold Brockian.t_emergence Brockian.t_Planck; rw [h]; push_cast
  rw [rpow_add Brockian.GoldenRatio.pos, rpow_one]; ring

/-
Definitions of potential and actualized states, and the dichotomy theorem.
-/
def Brockian.TemporalDynamics.is_potential (T : Brockian.MathematicalTruth) (t : ℝ) : Prop := t < Brockian.t_emergence T
def Brockian.TemporalDynamics.is_actualized (T : Brockian.MathematicalTruth) (t : ℝ) : Prop := t ≥ Brockian.t_emergence T

theorem Brockian.TemporalDynamics.emergence_dichotomy (T : Brockian.MathematicalTruth) (t : ℝ) :
    Brockian.TemporalDynamics.is_potential T t ∨ Brockian.TemporalDynamics.is_actualized T t := by
  unfold Brockian.TemporalDynamics.is_potential Brockian.TemporalDynamics.is_actualized; exact lt_or_le t (Brockian.t_emergence T)

/-
Definitions for Spectral Theory: MathSpace, operators, and eigenmodes.
-/
def Brockian.MathSpace := Brockian.MathematicalTruth → ℂ

def Brockian.SpectralTheory.PhiOperator (T : Brockian.MathematicalTruth) : Brockian.MathematicalTruth where
  statement := T.statement
  complexity := Brockian.phi * T.complexity
  complexity_pos := mul_pos Brockian.GoldenRatio.pos T.complexity_pos

def Brockian.SpectralTheory.phi_op (f : Brockian.MathSpace) : Brockian.MathSpace := fun T => f (Brockian.SpectralTheory.PhiOperator T)

def Brockian.SpectralTheory.TemporalLaplacian (f : Brockian.MathSpace) : Brockian.MathSpace := 
  fun T => Brockian.SpectralTheory.phi_op f T - f T

def Brockian.SpectralTheory.eigenmode (n : ℕ) : Brockian.MathSpace := 
  fun T => (T.complexity : ℂ) ^ n

def Brockian.SpectralTheory.eigenvalue (n : ℕ) : ℂ := (Brockian.phi : ℂ) ^ n - 1

/-
Theorems about eigenmodes: they satisfy the eigenmode equation and have distinct eigenvalues.
-/
theorem Brockian.SpectralTheory.eigenmode_equation (n : ℕ) :
    Brockian.SpectralTheory.TemporalLaplacian (Brockian.SpectralTheory.eigenmode n) = (fun T => Brockian.SpectralTheory.eigenvalue n * Brockian.SpectralTheory.eigenmode n T) := by
      unfold Brockian.SpectralTheory.TemporalLaplacian Brockian.SpectralTheory.eigenmode Brockian.SpectralTheory.eigenvalue Brockian.SpectralTheory.phi_op;
      simp +zetaDelta at * ; ring;
      norm_num [ ← mul_pow, Brockian.SpectralTheory.PhiOperator ]

theorem Brockian.SpectralTheory.eigenvalues_distinct (n m : ℕ) (h : n ≠ m) : Brockian.SpectralTheory.eigenvalue n ≠ Brockian.SpectralTheory.eigenvalue m := by
  cases' lt_or_gt_of_ne h with h h;
  · unfold Brockian.SpectralTheory.eigenvalue;
    exact ne_of_apply_ne Complex.re ( by norm_cast; exact ne_of_lt ( sub_lt_sub_right ( pow_lt_pow_right₀ ( show ( Brockian.phi : ℝ ) > 1 by exact mod_cast Brockian.GoldenRatio.gt_one ) h ) _ ) );
  · unfold Brockian.SpectralTheory.eigenvalue;
    norm_cast;
    exact ne_of_gt ( by exact sub_lt_sub_right ( pow_lt_pow_right₀ ( show 1 < Brockian.phi from by exact lt_div_iff₀' ( by positivity ) |>.2 <| by nlinarith [ Real.sqrt_nonneg 5, Real.sq_sqrt ( show 0 ≤ 5 by norm_num ) ] ) h ) _ )

