/-
Lemma: The inner product of f with itself is the integral of the squared norm of f.
-/
theorem Brockian.SpectralTheory.inner_eq_integral_norm_sq (f : Brockian.MathSpace) :
    Brockian.SpectralTheory.inner f f = ∫ T, (Complex.normSq (f T) : ℂ) ∂Brockian.SpectralTheory.MeasureSpace := by
      have h_inner_product : Brockian.SpectralTheory.inner f f = ∫ T, f T * star (f T) ∂Brockian.SpectralTheory.MeasureSpace := by
        rfl;
      convert h_inner_product using 2 ; norm_num [ Complex.mul_conj, Complex.normSq_eq_norm_sq ]

