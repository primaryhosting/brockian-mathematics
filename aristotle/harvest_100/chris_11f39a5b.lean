/-
Checking MemLp availability.
-/
#check MeasureTheory.MemLp

/-
Theorem: Inner product is positive definite (restricted to L2 functions).
-/
open MeasureTheory

theorem Brockian.SpectralTheory.inner_pos_def (f : Brockian.MathSpace) (hf : MemLp f 2 Brockian.SpectralTheory.MeasureSpace) :
    (Brockian.SpectralTheory.inner f f).re ≥ 0 ∧ (Brockian.SpectralTheory.inner f f = 0 ↔ f = 0) := by
      have h_integral_zero : ∫⁻ (x : Brockian.MathematicalTruth), ‖f x‖ₑ^2 ∂Brockian.SpectralTheory.MeasureSpace = 0 ↔ f = 0 := by
        rw [ MeasureTheory.lintegral_eq_zero_iff' ];
        · simp +decide [ Filter.EventuallyEq, MeasureTheory.ae_iff ];
          constructor <;> intro h <;> simp_all +decide [ funext_iff, Brockian.SpectralTheory.MeasureSpace ];
          · exact funext fun x => Classical.not_not.1 fun hx => h.subset hx;
          · exact Set.eq_empty_of_forall_notMem fun x hx => hx rfl;
        · exact?;
      have h_integral_zero : ∫ (x : Brockian.MathematicalTruth), Complex.normSq (f x) ∂Brockian.SpectralTheory.MeasureSpace = 0 ↔ f = 0 := by
        rw [ MeasureTheory.integral_eq_lintegral_of_nonneg_ae ];
        · rw [ ← h_integral_zero, ← MeasureTheory.lintegral_congr_ae ];
          rw [ ENNReal.toReal_eq_zero_iff ];
          any_goals exact fun x => ‖f x‖ₑ ^ 2;
          · have := hf.2;
            rw [ MeasureTheory.eLpNorm_eq_lintegral_rpow_enorm ] at this ; aesop;
            · norm_num;
            · norm_num;
          · filter_upwards [ ] with x using by simp +decide [ Complex.normSq_eq_norm_sq, ENNReal.ofReal_pow ] ;
        · exact Filter.Eventually.of_forall fun x => Complex.normSq_nonneg _;
        · exact?;
      have h_integral_zero : (Brockian.SpectralTheory.inner f f).re = ∫ (x : Brockian.MathematicalTruth), Complex.normSq (f x) ∂Brockian.SpectralTheory.MeasureSpace := by
        convert Brockian.SpectralTheory.inner_re_eq_integral_normSq f using 1;
      simp_all +decide [ Complex.ext_iff ];
      exact ⟨ MeasureTheory.integral_nonneg fun x => Complex.normSq_nonneg _, fun h => by rw [ show ( Brockian.SpectralTheory.inner 0 0 : ℂ ) = 0 by exact MeasureTheory.integral_eq_zero_of_ae <| Filter.Eventually.of_forall fun x => by aesop ] ; norm_num ⟩

/-
Theorem: Eigenmodes are orthogonal.
-/
theorem Brockian.SpectralTheory.eigenmodes_orthogonal : ∀ n m : ℕ, n ≠ m → Brockian.SpectralTheory.inner (Brockian.SpectralTheory.eigenmode n) (Brockian.SpectralTheory.eigenmode m) = 0 := by
  unfold Brockian.SpectralTheory.inner;
  intro n m hnm.MeasureSpace;
  unfold Brockian.SpectralTheory.MeasureSpace;
  simp +decide [ Brockian.SpectralTheory.eigenmode ];
  rw [ MeasureTheory.integral_def ];
  split_ifs <;> norm_num;
  · rename_i h₁ h₂;
    rw [ MeasureTheory.integrable_count_iff ] at h₂;
    convert absurd ( h₂.tendsto_cofinite_zero ) _;
    rw [ Metric.tendsto_nhds ] ; norm_num;
    refine' ⟨ 1, zero_lt_one, _ ⟩;
    refine' Set.infinite_of_injective_forall_mem ( show Function.Injective ( fun k : ℕ => ⟨ True, 1 + k, by positivity ⟩ ) from fun a b h => by simpa using congr_arg ( fun x : Brockian.MathematicalTruth => x.complexity ) h ) fun k => _ ; norm_num;
    exact one_le_mul_of_one_le_of_one_le ( one_le_pow₀ ( by rw [ abs_of_nonneg ] <;> linarith ) ) ( one_le_pow₀ ( by rw [ abs_of_nonneg ] <;> linarith ) );
  · exact?

/-
Helper lemma: Integral of squared norm is zero iff function is zero (for L2 functions on counting measure).
-/
lemma Brockian.SpectralTheory.integral_normSq_eq_zero_iff_of_memLp {α : Type*} [MeasurableSpace α] [MeasurableSingletonClass α] (f : α → ℂ) (hf : MeasureTheory.MemLp f 2 MeasureTheory.Measure.count) :
    ∫ x, Complex.normSq (f x) ∂MeasureTheory.Measure.count = 0 ↔ f = 0 := by
      rw [ MeasureTheory.integral_eq_zero_iff_of_nonneg_ae ];
      · simp +decide [ Filter.EventuallyEq, funext_iff, Complex.normSq_eq_norm_sq ];
      · exact Filter.Eventually.of_forall fun x => Complex.normSq_nonneg _;
      · have := hf.integrable_norm_pow two_ne_zero;
        simpa only [ Complex.normSq_eq_norm_sq ] using this

