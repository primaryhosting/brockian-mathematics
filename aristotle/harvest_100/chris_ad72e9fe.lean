  exp (-s * (Real.log p.val : ℂ)) * exp (-s * I * phi * Real.log p.val)

/-- The Brockian Euler factor at prime p (Paper §4.1) -/
@[simp] def brockianEuler (p : BPrime) (s : ℂ) : ℂ := 
  (1 - spiralTerm p s)⁻¹

/-- The Brockian zeta function as Euler product (Paper §4.1) -/
@[simp] def brockianZeta (s : ℂ) : ℂ := 
  ∏' p : BPrime, brockianEuler p s

