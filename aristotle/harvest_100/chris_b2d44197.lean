  Quotient.lift (fun f : {f : PenroseTilingVertices gamma → ℂ // 
      AEStronglyMeasurable f (verticesMeasure gamma)} =>
    AEEqFun.mk (rawAdjacency gamma f.1) (by
      apply Measurable.aestronglyMeasurable
