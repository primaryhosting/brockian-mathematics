/-
Almost everywhere equality implies pointwise equality for counting measure
-/
lemma ae_eq_eq_of_count {α : Type*} [MeasurableSpace α] [MeasurableSingletonClass α] 
    (f g : α → ℂ) (h : f =ᵐ[Measure.count] g) : f = g := by
  ext x
  have h_null : Measure.count {a | ¬ f a = g a} = 0 := h
  have h_empty : {a | ¬ f a = g a} = ∅ := by
    rw [← Measure.count_eq_zero_iff]
    exact h_null
  have h_x : x ∉ {a | ¬ f a = g a} := by
    rw [h_empty]
    exact Set.not_mem_empty x
  simpa using h_x

