  filter_upwards [] with u using by simp +decide [mul_comm c, mul_assoc]

/-
Degree operator preserves Lp membership
-/
lemma degreeAEEqFun_memLp (gamma : Fin 5 → ℝ)
    (f : PenroseTilingVertices gamma →ₘ[verticesMeasure gamma] ℂ)
    (hf : f ∈ MeasureTheory.Lp ℂ 2 (verticesMeasure gamma)) :
    degreeAEEqFun gamma f ∈ MeasureTheory.Lp ℂ 2 (verticesMeasure gamma) := by
  obtain ⟨g, hg⟩ := f
  have h_memLp : MemLp (fun u => degreeFunction gamma u * g u) 2 (verticesMeasure gamma) := by
    apply memLp_degree
    rw [MeasureTheory.MemLp]
    rw [MeasureTheory.Lp.mem_Lp_iff_eLpNorm_lt_top] at hf
    aesop
  convert h_memLp using 1
  constructor <;> intro h <;> rw [MeasureTheory.Lp] at * <;> norm_num at *
  · exact h_memLp
  · convert h_memLp.eLpNorm_lt_top using 1
    rw [MeasureTheory.eLpNorm_congr_ae]
    exact AEEqFun.coeFn_mk _ _

/-
Degree as linear map on ℓ²
-/
def degreeLinearMap (gamma : Fin 5 → ℝ) : l2_space gamma →ₗ[ℂ] l2_space gamma where
  toFun f := ⟨degreeAEEqFun gamma f.1, degreeAEEqFun_memLp gamma f.1 f.2⟩
  map_add' f g := by
    apply Subtype.eq
    exact degreeAEEqFun_add gamma f.1 g.1
  map_smul' c f := by
    apply Subtype.eq
    exact degreeAEEqFun_smul gamma c f.1

/-
THE GRAPH LAPLACIAN: Δ = D - A
-/
def graphLaplacian (gamma : Fin 5 → ℝ) : l2_space gamma →ₗ[ℂ] l2_space gamma :=
  degreeLinearMap gamma - adjacencyLinearMap gamma

/-
Bound on the adjacency operator norm
-/
lemma adjacency_operator_norm_le_10 (gamma : Fin 5 → ℝ) (f : l2_space gamma) :
    ‖adjacencyLinearMap gamma f‖ ≤ 10 * ‖f‖ := by
      -- By definition of the adjacency operator, we have ‖(adjacencyLinearMap gamma) f‖ ≤ 10 * ‖f‖.
      have h_adj_norm : ∀ (f : PenroseTilingVertices gamma → ℂ), MemLp f 2 (verticesMeasure gamma) → eLpNorm (rawAdjacency gamma f) 2 (verticesMeasure gamma) ≤ 10 * eLpNorm f 2 (verticesMeasure gamma) := by
        exact?
      generalize_proofs at *;
      have h_adj_norm : ∀ (f : PenroseTilingVertices gamma →ₘ[verticesMeasure gamma] ℂ), eLpNorm (adjacencyAEEqFun gamma f) 2 (verticesMeasure gamma) ≤ 10 * eLpNorm f 2 (verticesMeasure gamma) := by
        rintro ⟨ f, hf ⟩
        generalize_proofs at *;
        by_cases h : MeasureTheory.MemLp f 2 ( verticesMeasure gamma ) <;> simp_all +decide [ MeasureTheory.eLpNorm_congr_ae ];
        · convert h_adj_norm f h using 1
          generalize_proofs at *;
          rw [ MeasureTheory.eLpNorm_congr_ae ];
          exact MeasureTheory.AEEqFun.coeFn_mk _ _ |> fun h => h.trans ( by aesop );
        · simp_all +decide [ MeasureTheory.eLpNorm_eq_lintegral_rpow_enorm ];
          rw [ MeasureTheory.memLp_two_iff_integrable_sq_norm ] at h ; simp_all +decide [ MeasureTheory.Integrable ];
          · simp_all +decide [ MeasureTheory.HasFiniteIntegral ];
            rw [ h ] ; norm_num;
            exact hf.norm.aemeasurable.pow_const 2 |> fun h => h.aestronglyMeasurable;
          · exact hf
      generalize_proofs at *;
      convert ENNReal.toReal_mono _ ( h_adj_norm f.1 ) using 1 <;> norm_num [ ENNReal.toReal_mul ];
      · exact?;
      · exact ENNReal.mul_ne_top ENNReal.coe_ne_top ( MeasureTheory.Lp.eLpNorm_ne_top _ )
