/-- A unitary (i.e. linear isometric equivalence) representation of a group 
    on a complex Hilbert space. 
    
    For D₅, there are 4 irreducible representations:
    - χ₀: trivial (dim 1)
    - χ₁: sign representation (dim 1)
    - χ₂: 2-dimensional, character involves cos(2π/5) = (φ-1)/2
    - χ₃: 2-dimensional, character involves cos(4π/5) = -φ/2
    
    where φ = (1+√5)/2 is the golden ratio. -/
structure UnitaryRep (G : Type*) [Group G]
    (H : Type u) [NormedAddCommGroup H] [InnerProductSpace ℂ H] :=
  (ρ : G →* (H ≃ₗᵢ[ℂ] H))

attribute [simp] UnitaryRep.ρ

/-- The representation is unitary: ρ(g) preserves the inner product. -/
lemma UnitaryRep.preserves_inner {G : Type*} [Group G]
    {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    (rep : UnitaryRep G H) (g : G) (x y : H) :
    inner ℂ (rep.ρ g x) (rep.ρ g y) = inner ℂ x y := by
  exact (rep.ρ g).inner_map_map x y

#check LinearPMap
#check IsSelfAdjoint

/-- Self-adjointness for LinearPMap (unbounded operators). -/
def LinearPMap.IsSelfAdjoint {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (T : LinearPMap ℂ H H) : Prop :=
  T.adjoint = T

/-- An "unbounded operator" packaged with a self-adjointness certificate.
    
    For the Brockian program, the key examples are:
    - Δ₀: hyperbolic Laplacian on L²(Y₀(5))
    - Δ: hyperbolic Laplacian on L²(X(5))
    - B: the Brockian operator = P_φ Δ P_φ + V
    
    Self-adjointness is crucial: it implies Spec(B) ⊆ ℝ. -/
structure SelfAdjointUnbounded
    (H : Type u) [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H] :=
  (A : LinearPMap ℂ H H)
  (selfAdjoint : A.IsSelfAdjoint)

/-- The domain of an unbounded self-adjoint operator. -/
def SelfAdjointUnbounded.domain {H : Type u} 
    [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (T : SelfAdjointUnbounded H) : Submodule ℂ H :=
  T.A.domain

/--
A family of bounded operators (index type `ι`) intended to model Hecke operators:
- each operator is self-adjoint
- operators commute pairwise

For Γ₀(5), the Hecke operators T_p (p ≠ 5) are:
  (T_p f)(z) = (1/√p) Σ_{j=0}^{p-1} f((z+j)/p) + √p · f(pz)

They commute with the Laplacian and with each other.
-/
structure CommutingSelfAdjointFamily (ι : Type*)
    (H : Type u) [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H] :=
  (T : ι → (H →L[ℂ] H))
  (selfAdjoint : ∀ i, IsSelfAdjoint (T i))
  (commute : ∀ i j, Commute (T i) (T j))

/-- Hecke operators indexed by primes coprime to the level. -/
def HeckeIndex (N : ℕ) := {p : ℕ // Nat.Prime p ∧ ¬(p ∣ N)}

/-- A unitary involution on a Hilbert space (intended: Atkin–Lehner W₅).

    For Γ₀(5), the Atkin-Lehner involution is:
      W₅ : z ↦ -1/(5z)

    This is the only "obvious" symmetry of Y₀(5) beyond the identity.
    It satisfies W₅² = 1 and commutes with all Hecke operators. -/
structure UnitaryInvolution
    (H : Type u) [NormedAddCommGroup H] [InnerProductSpace ℂ H] :=
  (W : H ≃ₗᵢ[ℂ] H)
  (involutive : W.trans W = LinearIsometryEquiv.refl ℂ H)

attribute [simp] UnitaryInvolution.involutive

lemma UnitaryInvolution.sq_eq_one {H : Type u}
    [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    (W : UnitaryInvolution H) (x : H) : W.W (W.W x) = x := by
      -- Since $W$ is a unitary involution, by definition, $W.W * W.W = 1$.
      have h_inv : W.W * W.W = 1 := by
        -- By definition of unitary involution, we know that $W.W * W.W = 1$.
        apply W.involutive;
      exact congr_arg ( fun f => f x ) h_inv

