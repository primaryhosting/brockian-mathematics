/-!
## Setting

A *system* consists of a finite set `ι` of elements, each of which can be in one of
finitely many states `S`.  A global state of the system is a function `x : ι → S`.
The dynamics is given by a *mechanism*: for every element `i`, a conditional
probability `p i x s` that `i` will be in state `s` at the next time step, given that
the system is currently in the global state `x`.  Different elements are updated
independently, so the transition probability of the whole system is the product of
the individual mechanisms.
-/

/-- A finite discrete stochastic system: `p i x s` is the probability that element `i`
transitions to state `s` when the system is currently in global state `x`.
The mechanism is assumed strictly positive (every next state has positive
probability), which is the usual non-degeneracy assumption making the
Kullback–Leibler divergences below finite. -/
structure System (ι S : Type*) [Fintype ι] [DecidableEq ι] [Fintype S] where
  /-- `p i x s` = probability that element `i` is in state `s` at the next step. -/
  p : ι → (ι → S) → S → ℝ
  /-- Every transition has strictly positive probability. -/
  pos : ∀ i x s, 0 < p i x s
  /-- The mechanism of each element is a probability distribution on states. -/
  sum_one : ∀ i x, ∑ s, p i x s = 1

variable {ι S : Type*} [Fintype ι] [DecidableEq ι] [Fintype S]

/-- The transition probability of the whole system: the probability of moving from
global state `x` to global state `y`. -/
def transition (M : System ι S) (x y : ι → S) : ℝ := ∏ i, M.p i x (y i)

/-- `patch A x w` agrees with `x` on `A` and with `w` outside of `A`. -/
def patch (A : Finset ι) (x w : ι → S) : ι → S := fun j => if j ∈ A then x j else w j

/-- The mechanism of element `i` after *cutting* all its incoming connections from
outside the part `A`: the inputs coming from outside `A` are replaced by independent
uniform noise, i.e. they are averaged out. -/
noncomputable def cutMech (M : System ι S) (A : Finset ι) (i : ι) (x : ι → S) (s : S) : ℝ :=
  (∑ w : ι → S, M.p i (patch A x w) s) / (Fintype.card (ι → S) : ℝ)

/-- The transition probability of the system whose connections *across* the
bipartition `{A, Aᶜ}` have been cut: each element is driven only by the elements
lying on its own side of the partition, the inputs from the other side being
replaced by independent noise. -/
noncomputable def cutTransition (M : System ι S) (A : Finset ι) (x y : ι → S) : ℝ :=
  ∏ i, cutMech M (if i ∈ A then A else Aᶜ) i x (y i)

/-- Kullback–Leibler divergence between two distributions on global states. -/
noncomputable def klDiv (P Q : (ι → S) → ℝ) : ℝ := ∑ y, P y * Real.log (P y / Q y)

/-- The *effective information* generated by the system in state `x` across the
bipartition `{A, Aᶜ}`: how much the actual transition probability distribution
differs (in the information-theoretic sense) from the one of the system with the
connections across the partition cut. -/
noncomputable def effectiveInfo (M : System ι S) (A : Finset ι) (x : ι → S) : ℝ :=
  klDiv (transition M x) (cutTransition M A x)

/-- The bipartitions of the system, encoded by one of their two (nonempty) parts. -/
noncomputable def bipartitions (ι : Type*) [Fintype ι] [DecidableEq ι] : Finset (Finset ι) :=
  Finset.univ.filter (fun A => A.Nonempty ∧ A ≠ Finset.univ)

/-- **Integrated information** `Φ` of the system in state `x`: the minimum, over all
bipartitions of the system, of the effective information generated across that
bipartition. -/
noncomputable def Phi (M : System ι S) (x : ι → S) : ℝ :=
  sInf {r : ℝ | ∃ A ∈ bipartitions ι, r = effectiveInfo M A x}

/-- The mechanism of element `i` depends only on the current states of the elements
of `A`. -/
def DependsOnlyOn (M : System ι S) (i : ι) (A : Finset ι) : Prop :=
  ∀ x x' : ι → S, (∀ j ∈ A, x j = x' j) → M.p i x = M.p i x'

/-- The system is *disconnected* along the bipartition `{A, Aᶜ}`: no element of `A`
receives an input from outside `A`, and no element outside `A` receives an input
from `A`.  Both parts are required to be nonempty. -/
def DisconnectedAlong (M : System ι S) (A : Finset ι) : Prop :=
  A.Nonempty ∧ A ≠ Finset.univ ∧ (∀ i ∈ A, DependsOnlyOn M i A) ∧
    (∀ i ∉ A, DependsOnlyOn M i Aᶜ)

/-! ## Basic facts -/

lemma card_pi_pos (x : ι → S) : 0 < Fintype.card (ι → S) := Fintype.card_pos_iff.mpr ⟨x⟩

lemma transition_pos (M : System ι S) (x y : ι → S) : 0 < transition M x y :=
  Finset.prod_pos (fun i _ => M.pos i x (y i))

lemma cutMech_pos (M : System ι S) (A : Finset ι) (i : ι) (x : ι → S) (s : S) :
    0 < cutMech M A i x s := by
  apply div_pos
  · exact Finset.sum_pos (fun w _ => M.pos _ _ _) ⟨x, Finset.mem_univ _⟩
  · exact_mod_cast card_pi_pos x

lemma cutMech_sum_one (M : System ι S) (A : Finset ι) (i : ι) (x : ι → S) :
    ∑ s, cutMech M A i x s = 1 := by
  have hN : (Fintype.card (ι → S) : ℝ) ≠ 0 := by
    have := card_pi_pos x; positivity
  unfold cutMech
  rw [← Finset.sum_div, Finset.sum_comm]
  simp only [M.sum_one, Finset.sum_const, Finset.card_univ, nsmul_eq_mul, mul_one]
  field_simp

lemma cutTransition_pos (M : System ι S) (A : Finset ι) (x y : ι → S) :
    0 < cutTransition M A x y :=
  Finset.prod_pos (fun i _ => cutMech_pos M _ i x (y i))

lemma transition_sum_one (M : System ι S) (x : ι → S) : ∑ y, transition M x y = 1 := by
  unfold transition
  rw [← Fintype.prod_sum]
  simp [M.sum_one]

lemma cutTransition_sum_one (M : System ι S) (A : Finset ι) (x : ι → S) :
    ∑ y, cutTransition M A x y = 1 := by
  unfold cutTransition
  rw [← Fintype.prod_sum]
  simp [cutMech_sum_one M _ _ x]

/-- Gibbs' inequality: the Kullback–Leibler divergence between two strictly positive
probability distributions is nonnegative. -/
lemma klDiv_nonneg (P Q : (ι → S) → ℝ) (hP : ∀ y, 0 < P y) (hQ : ∀ y, 0 < Q y)
    (hPs : ∑ y, P y = 1) (hQs : ∑ y, Q y = 1) : 0 ≤ klDiv P Q := by
  have key : ∀ y, P y - Q y ≤ P y * Real.log (P y / Q y) := by
    intro y
    have hpne : P y ≠ 0 := (hP y).ne'
    have hqne : Q y ≠ 0 := (hQ y).ne'
    have h1 : Real.log (Q y / P y) ≤ Q y / P y - 1 :=
      Real.log_le_sub_one_of_pos (div_pos (hQ y) (hP y))
    have h2 : Real.log (Q y / P y) = - Real.log (P y / Q y) := by
      rw [← Real.log_inv]; congr 1; field_simp
    rw [h2] at h1
    have h3 : P y * (1 - Q y / P y) ≤ P y * Real.log (P y / Q y) := by
      apply mul_le_mul_of_nonneg_left _ (hP y).le
      linarith
    calc P y - Q y = P y * (1 - Q y / P y) := by field_simp
      _ ≤ _ := h3
  have h := Finset.sum_le_sum (fun y (_ : y ∈ Finset.univ) => key y)
  rw [Finset.sum_sub_distrib, hPs, hQs] at h
  simpa [klDiv] using h

lemma effectiveInfo_nonneg (M : System ι S) (A : Finset ι) (x : ι → S) :
    0 ≤ effectiveInfo M A x :=
  klDiv_nonneg _ _ (transition_pos M x) (cutTransition_pos M A x)
    (transition_sum_one M x) (cutTransition_sum_one M A x)

/-- Cutting the incoming connections from outside `A` does not change the mechanism of
an element whose mechanism depends only on the elements of `A`. -/
lemma cutMech_eq_of_dependsOnlyOn (M : System ι S) (A : Finset ι) (i : ι)
    (h : DependsOnlyOn M i A) (x : ι → S) (s : S) : cutMech M A i x s = M.p i x s := by
  have hN : (Fintype.card (ι → S) : ℝ) ≠ 0 := by
    have := card_pi_pos x; positivity
  have hw : ∀ w : ι → S, M.p i (patch A x w) s = M.p i x s := by
    intro w
    have : M.p i (patch A x w) = M.p i x := by
      apply h
      intro j hj
      simp [patch, hj]
    rw [this]
  unfold cutMech
  rw [Finset.sum_congr rfl (fun w _ => hw w)]
  simp only [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
  field_simp

/-- If the system is disconnected along `{A, Aᶜ}`, cutting the (nonexistent)
connections across the partition does not change the dynamics. -/
lemma cutTransition_eq_of_disconnected (M : System ι S) (A : Finset ι)
    (hA : DisconnectedAlong M A) (x y : ι → S) :
    cutTransition M A x y = transition M x y := by
  obtain ⟨-, -, hin, hout⟩ := hA
  unfold cutTransition transition
  refine Finset.prod_congr rfl (fun i _ => ?_)
  by_cases hi : i ∈ A
  · simp only [hi, if_true]
    exact cutMech_eq_of_dependsOnlyOn M A i (hin i hi) x (y i)
  · simp only [hi, if_false]
    exact cutMech_eq_of_dependsOnlyOn M Aᶜ i (hout i hi) x (y i)

lemma effectiveInfo_eq_zero_of_disconnected (M : System ι S) (A : Finset ι)
    (hA : DisconnectedAlong M A) (x : ι → S) : effectiveInfo M A x = 0 := by
  unfold effectiveInfo klDiv
  refine Finset.sum_eq_zero (fun y _ => ?_)
  rw [cutTransition_eq_of_disconnected M A hA x y,
    div_self (transition_pos M x y).ne', Real.log_one, mul_zero]

/-! ## Main theorem -/

/-- **Integrated information vanishes for a disconnected system.**
If a finite stochastic system splits into two nonempty parts `A` and `Aᶜ` with no
causal connections between them, then its integrated information `Φ`, defined as the
minimum over all bipartitions of the effective information generated across the
bipartition, is zero in every state. -/
theorem iit_phi_partition (M : System ι S) (A : Finset ι) (hA : DisconnectedAlong M A)
    (x : ι → S) : Phi M x = 0 := by
  have hAmem : A ∈ bipartitions ι := by
    simp only [bipartitions, Finset.mem_filter, Finset.mem_univ, true_and]
    exact ⟨hA.1, hA.2.1⟩
  have hmem : (0 : ℝ) ∈ {r : ℝ | ∃ A ∈ bipartitions ι, r = effectiveInfo M A x} :=
    ⟨A, hAmem, (effectiveInfo_eq_zero_of_disconnected M A hA x).symm⟩
  have hlb : ∀ r ∈ {r : ℝ | ∃ A ∈ bipartitions ι, r = effectiveInfo M A x}, (0 : ℝ) ≤ r := by
    rintro r ⟨B, -, rfl⟩
    exact effectiveInfo_nonneg M B x
  refine le_antisymm ?_ ?_
  · exact csInf_le ⟨0, hlb⟩ hmem
  · exact le_csInf ⟨0, hmem⟩ hlb

/-! ## A concrete example

The hypotheses of the theorem are satisfiable: two noisy copy-gates that each only
listen to themselves form a system that is disconnected along the bipartition
`{true} | {false}`. -/

/-- Two independent noisy copy-gates: element `i` keeps its state with probability
`3/4` and flips it with probability `1/4`, regardless of the other element. -/
noncomputable def twoIndependentGates : System Bool Bool where
  p := fun i x s => if x i = s then 3 / 4 else 1 / 4
  pos := by intro i x s; split <;> norm_num
  sum_one := by intro i x; rcases x i <;> simp <;> norm_num

lemma twoIndependentGates_disconnected :
    DisconnectedAlong twoIndependentGates {true} := by
  refine ⟨⟨true, by simp⟩, ?_, ?_, ?_⟩
  · intro h
    have : (false : Bool) ∈ ({true} : Finset Bool) := by rw [h]; simp
    simp at this
  · intro i hi x x' h
    simp only [Finset.mem_singleton] at hi
    subst hi
    funext s
    simp [twoIndependentGates, h true (by simp)]
  · intro i hi x x' h
    have hif : i = false := by cases i <;> simp_all
    subst hif
    funext s
    have hf : x false = x' false := h false (by simp)
    simp [twoIndependentGates, hf]

example (x : Bool → Bool) : Phi twoIndependentGates x = 0 :=
  iit_phi_partition twoIndependentGates {true} twoIndependentGates_disconnected x

end Frontier

