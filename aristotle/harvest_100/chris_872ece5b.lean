theorem B_selfAdjoint_clean {H : Type*}
    [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (BS : BrockianSystem H) : IsSelfAdjoint BS.B := by
      -- Since P_φ is self-adjoint and Δ is self-adjoint, their product P_φ Δ P_φ is also self-adjoint. Adding V, which is self-adjoint, preserves self-adjointness. Therefore, B is self-adjoint.
      apply BrockianSystem.B_selfAdjoint BS
