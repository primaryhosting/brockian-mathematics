═══════════════════════════════════════════════════════════════════════════ -/

/-- The dihedral group D₅ of order 10, symmetries of the regular pentagon.
    This group acts on the level-5 modular curve X(5) via deck transformations. -/
abbrev D5 := DihedralGroup 5

/-- D₅ has exactly 10 elements: 5 rotations and 5 reflections. -/
theorem D5_card : Fintype.card D5 = 10 := by
  rw [DihedralGroup.card]
  norm_num

/-- The golden ratio φ = (1 + √5)/2 ≈ 1.618...
    This appears naturally in D₅ representation theory via cos(2π/5) = (φ-1)/2. -/
def φ : ℝ := (1 + Real.sqrt 5) / 2

/-- The golden ratio satisfies its defining quadratic equation.
    This is the positive root of x² - x - 1 = 0. -/
theorem phi_eq : φ^2 = φ + 1 := by
  simp only [φ]
  have h : Real.sqrt 5 ^ 2 = 5 := Real.sq_sqrt (by norm_num : (5 : ℝ) ≥ 0)
  ring_nf
  rw [h]
  ring

/-- The primitive 5th root of unity ω = exp(2πi/5).
    The character values of D₅ involve ω and its conjugate. -/
def ω : ℂ := Complex.exp (2 * Real.pi * Complex.I / 5)

/-! ═══════════════════════════════════════════════════════════════════════════
    SECTION 2: D₅ REPRESENTATION THEORY
═══════════════════════════════════════════════════════════════════════════ -/

/-- Index for the four irreducible representations of D₅.

    D₅ has exactly 4 irreps:
    • trivial:   1-dimensional, χ(g) = 1 for all g
    • sign:      1-dimensional, χ(r) = 1, χ(sr) = -1
    • golden:    2-dimensional, χ(rᵏ) = ωᵏ + ω⁻ᵏ = 2cos(2πk/5)
    • conjugate: 2-dimensional, χ(rᵏ) = ω²ᵏ + ω⁻²ᵏ = 2cos(4πk/5)

    The "golden" irrep is special: its character involves cos(2π/5) = (φ-1)/2. -/
inductive D5IrrepIndex where
  | trivial    -- 1-dimensional trivial representation
  | sign       -- 1-dimensional sign representation
  | golden     -- 2-dimensional, character involves φ
  | conjugate  -- 2-dimensional, character involves -1/φ
  deriving DecidableEq, Repr

/-- Coercion helper: LinearIsometryEquiv to ContinuousLinearMap.
    This is needed because ρ(g) : H ≃ₗᵢ[ℂ] H but we need H →L[ℂ] H for sums. -/
def repCLM {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    (ρ : D5 → (H ≃ₗᵢ[ℂ] H)) (g : D5) : H →L[ℂ] H :=
  (ρ g).toContinuousLinearEquiv.toContinuousLinearMap

/-- Powers of the primitive 5th root of unity. -/
def ωPow (k : ℕ) : ℂ := ω ^ k

/-- Character values for the 2-dimensional irreps: ωᵏ + ω̄ᵏ = 2cos(2πk/5). -/
def goldenTrace (k : ℕ) : ℂ := ωPow k + star (ωPow k)

/-- Dimension of each D₅ irrep. -/
def D5IrrepDimension (idx : D5IrrepIndex) : ℂ :=
  match idx with
  | .trivial => 1
  | .sign => 1
  | .golden => 2
  | .conjugate => 2

/-- The character table of D₅.

    χ_trivial(g) = 1 for all g
    χ_sign(rᵏ) = 1, χ_sign(sr^k) = -1
    χ_golden(rᵏ) = ωᵏ + ω⁻ᵏ, χ_golden(srᵏ) = 0
    χ_conjugate(rᵏ) = ω²ᵏ + ω⁻²ᵏ, χ_conjugate(srᵏ) = 0 -/
def D5_character (idx : D5IrrepIndex) (g : D5) : ℂ :=
  match idx, g with
  | .trivial, _ => 1
  | .sign, DihedralGroup.r _ => 1
  | .sign, DihedralGroup.sr _ => -1
  | .golden, DihedralGroup.r j => goldenTrace (ZMod.val j)
  | .golden, DihedralGroup.sr _ => 0
  | .conjugate, DihedralGroup.r j => goldenTrace (2 * ZMod.val j)
  | .conjugate, DihedralGroup.sr _ => 0

/-- The Peter-Weyl isotypic projector formula:
    P_χ = (dim χ / |G|) Σ_{g ∈ G} conj(χ(g)) ρ(g)

    This is the standard formula from representation theory. -/
def isotypicProjectorFormula {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (ρ : D5 → (H ≃ₗᵢ[ℂ] H)) (idx : D5IrrepIndex) : H →L[ℂ] H :=
  (D5IrrepDimension idx * (Fintype.card D5 : ℂ)⁻¹) • ∑ g : D5, star (D5_character idx g) • repCLM ρ g

