    rw [ ← Set.ncard_coe_finset ] ; aesop;
  exact h_finite.trans ( le_trans ( Finset.card_union_le _ _ ) ( by exact le_trans ( add_le_add ( Finset.card_image_le ) ( Finset.card_image_le ) ) ( by decide ) ) )

