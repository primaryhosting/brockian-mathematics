      obtain ⟨k, hk⟩ := hv;
      -- By definition of potentialNeighbors, if v is adjacent to u, then v is either u + pentagonVertex k or u - pentagonVertex k for some k.
      simp [potentialNeighbors, adjacent] at *;
      grind

