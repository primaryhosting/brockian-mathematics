    rintro z ⟨n, rfl, _⟩
    exact Set.mem_range_self n
  exact Set.Countable.to_subtype (Set.Countable.mono h_subset h_range)

#check measurable_of_countable

-- Adjacency on AEEqFun with proper quotient structure
def A_ae : (Vertices →ₘ[μ] ℂ) → (Vertices →ₘ[μ] ℂ) :=
  Quotient.lift (fun f : {f : Vertices → ℂ // AEStronglyMeasurable f μ} =>
    AEEqFun.mk (A_raw f.1) (by
    exact?))
    (fun _ _ h => AEEqFun.mk_eq_mk.mpr <| by
      -- If two functions are almost everywhere equal, then their sums over finite sets are also almost everywhere equal.
      have h_sum_ae_eq : ∀ (f g : Vertices → ℂ), f =ᵐ[μ] g → ∀ u : Vertices, ∑ v ∈ PenroseGraph.neighborFinset u, f v = ∑ v ∈ PenroseGraph.neighborFinset u, g v := by
        intro f g h u; exact (by
        apply Finset.sum_congr rfl;
        -- Since the neighborFinset is finite, each element in it is a specific vertex. The hypothesis h states that f and g are equal almost everywhere with respect to the counting measure. Since the counting measure assigns a positive measure to each singleton set, the equality f x = g x must hold for every x in the neighborFinset.
        have h_eq : ∀ x : Vertices, f x = g x := by
          convert ae_eq_of_count h;
          exact ⟨ fun h => funext h, fun h => h ▸ fun x => rfl ⟩;
        exact fun x hx => h_eq x);
      exact Filter.Eventually.of_forall fun u => h_sum_ae_eq _ _ h u)

/-- Degree as complex-valued function -/
def deg_fn (u : Vertices) : ℂ := (PenroseGraph.degree u : ℂ)

/-- Degree is bounded by 10 -/
lemma deg_fn_bound (u : Vertices) : ‖deg_fn u‖ ≤ 10 := by
  simp [deg_fn]
  convert degree_bound u using 1

/-- Raw degree operator: multiplication by degree -/
def D_raw (f : Vertices → ℂ) (u : Vertices) : ℂ := deg_fn u * f u

/-- Degree operator preserves ℓ² -/
lemma memLp_D_raw {f : Vertices → ℂ} (hf : MemLp f 2 μ) : MemLp (D_raw f) 2 μ := by
  have h_deg_bound : ∀ u : Vertices, ‖deg_fn u‖ ≤ 10 := by
    exact?;
  refine' MeasureTheory.MemLp.mono' _ _ _;
  refine' fun u => 10 * ‖f u‖;
  · exact MeasureTheory.MemLp.const_mul ( hf.norm ) _;
  · exact?;
  · filter_upwards [ ] with u using by simpa [ D_raw ] using mul_le_mul_of_nonneg_right ( h_deg_bound u ) ( norm_nonneg _ ) ;

def D_ae : (Vertices →ₘ[μ] ℂ) → (Vertices →ₘ[μ] ℂ) :=
  Quotient.lift (fun f : {f : Vertices → ℂ // AEStronglyMeasurable f μ} =>
    AEEqFun.mk (D_raw f.1) (Measurable.aestronglyMeasurable (measurable_of_countable (D_raw f.1))))
    (fun _ _ h => AEEqFun.mk_eq_mk.mpr <| by rw [ae_eq_of_count h])

lemma D_ae_add (f g : Vertices →ₘ[μ] ℂ) : D_ae (f + g) = D_ae f + D_ae g := by
  obtain ⟨ f, hf ⟩ := f; obtain ⟨ g, hg ⟩ := g; simp +decide [ hf, hg, D_raw ] ;
  erw [ AEEqFun.mk_eq_mk ];
  filter_upwards [ ] with x using by simp +decide [ D_raw ] ; ring;

lemma D_ae_smul (c : ℂ) (f : Vertices →ₘ[μ] ℂ) : D_ae (c • f) = c • D_ae f := by
  -- By definition of D_ae, we have D_ae (c • f) = Quotient.lift (fun g => AEEqFun.mk (D_raw g.1) (by sorry)) (fun _ _ h => AEEqFun.mk_eq_mk.mpr <| by sorry)
  simp [D_ae];
  -- By definition of scalar multiplication in the quotient space, we have:
  have h_scalar_mul : ∀ (c : ℂ) (f : Vertices →ₘ[μ] ℂ), D_ae (c • f) = c • D_ae f := by
    intros c f
    simp [D_ae];
    obtain ⟨ g, hg ⟩ := f;
    erw [ Quotient.lift_mk, Quotient.lift_mk ];
    erw [ MeasureTheory.AEEqFun.mk_eq_mk ];
    filter_upwards [ ] with x using by simp +decide [ D_raw ] ; ring;
  convert h_scalar_mul c f using 1

lemma D_ae_memLp (f : Vertices →ₘ[μ] ℂ) (hf : f ∈ Lp ℂ 2 μ) : D_ae f ∈ Lp ℂ 2 μ := by
  obtain ⟨ g, hg ⟩ := f;
  convert memLp_D_raw _;
  rotate_left;
  exact g;
  · rw [ MeasureTheory.MemLp ];
    rw [ MeasureTheory.Lp ] at hf ; aesop;
  · rw [ MeasureTheory.Lp.mem_Lp_iff_memLp ];
    erw [ MeasureTheory.memLp_congr_ae ];
    exact MeasureTheory.AEEqFun.coeFn_mk _ _

/-- The degree operator as a bounded linear map on ℓ² -/
def D : L2 →ₗ[ℂ] L2 where
  toFun f := ⟨D_ae f.1, D_ae_memLp f.1 f.2⟩
  map_add' f g := Subtype.eq (D_ae_add f.1 g.1)
  map_smul' c f := Subtype.eq (D_ae_smul c f.1)

lemma A_ae_add (f g : Vertices →ₘ[μ] ℂ) : A_ae (f + g) = A_ae f + A_ae g := by
  obtain ⟨ f, hf ⟩ := f;
  obtain ⟨ g, hg ⟩ := g;
  erw [ AEEqFun.mk_eq_mk ];
  filter_upwards [ ] with u;
  unfold A_raw; simp +decide [ Finset.sum_add_distrib ] ;

lemma A_ae_smul (c : ℂ) (f : Vertices →ₘ[μ] ℂ) : A_ae (c • f) = c • A_ae f := by
  obtain ⟨f, _⟩ := f
  convert AEEqFun.mk_eq_mk.mpr _
  filter_upwards with u
  simp [A_raw, Finset.mul_sum]

lemma A_ae_memLp (f : Vertices →ₘ[μ] ℂ) (hf : f ∈ Lp ℂ 2 μ) : A_ae f ∈ Lp ℂ 2 μ := by
  -- Since $A_ae$ is a bounded operator, the composition of $A_ae$ with any $L^2$ function is also in $L^2$.
  have h_bounded : ∀ f : Vertices →ₘ[μ] ℂ, f ∈ MeasureTheory.Lp ℂ 2 μ → A_ae f ∈ MeasureTheory.Lp ℂ 2 μ := by
    intro f hf;
    -- Since $A_{\text{raw}}$ is bounded, the composition of $A_{\text{raw}}$ with any $L^2$ function is also in $L^2$.
    have h_bounded : ∀ f : Vertices → ℂ, MeasureTheory.MemLp f 2 μ → MeasureTheory.MemLp (A_raw f) 2 μ := by
      intro f hf;
      have h_bounded : MeasureTheory.eLpNorm (A_raw f) 2 μ ≤ 10 * MeasureTheory.eLpNorm f 2 μ := by
        exact?;
      constructor;
      · exact?;
      · exact lt_of_le_of_lt h_bounded ( ENNReal.mul_lt_top ( by norm_num ) ( hf.eLpNorm_lt_top ) );
    obtain ⟨ g, hg ⟩ := f;
    rw [ MeasureTheory.Lp.mem_Lp_iff_eLpNorm_lt_top ] at *;
    obtain ⟨ g', hg' ⟩ := h_bounded g ( by
      constructor <;> aesop );
    convert hg' using 1;
    erw [ MeasureTheory.eLpNorm_congr_ae ( MeasureTheory.AEEqFun.coeFn_mk _ _ ) ];
  exact h_bounded f hf

/-- The adjacency operator as a bounded linear map on ℓ² -/
def A : L2 →ₗ[ℂ] L2 where
  toFun f := ⟨A_ae f.1, A_ae_memLp f.1 f.2⟩
  map_add' f g := Subtype.eq (A_ae_add f.1 g.1)
  map_smul' c f := Subtype.eq (A_ae_smul c f.1)

/--
THE GRAPH LAPLACIAN: Δ = D - A

This operator represents the quantum Hamiltonian for an electron on the
Penrose lattice. Its eigenvalues are the allowed energy levels, and its
eigenfunctions are the quantum states.

PHYSICAL INTERPRETATION:
- Δψ = λψ means ψ is a stationary state with energy λ
- The spectrum of Δ determines all quantum properties
- Diffraction patterns arise from Fourier transforms of eigenfunctions
-/
def Δ : L2 →ₗ[ℂ] L2 := D - A

/--
THEOREM: The Laplacian is bounded

‖Δ‖ ≤ 20 follows from ‖D‖ ≤ 10 and ‖A‖ ≤ 10.
This ensures Δ is a well-defined operator on ℓ².
-/
theorem Δ_bounded : ∃ C : ℝ, 0 < C ∧ ∀ f : L2, ‖Δ f‖ ≤ C * ‖f‖ := by
  have h_bounded : ∃ C : ℝ, ∀ f : L2, ‖Δ f‖ ≤ C * ‖f‖ := by
    have hD : ∃ C_D : ℝ, ∀ f : L2, ‖D f‖ ≤ C_D * ‖f‖ := by
      use 10;
      intro f;
      -- By definition of $D$, we know that for any $f \in L^2$, $\|D f\| \leq 10 \|f\|$.
      have hD_le : ∀ f : Vertices → ℂ, MeasureTheory.eLpNorm (D_raw f) 2 μ ≤ 10 * MeasureTheory.eLpNorm f 2 μ := by
        intro f;
        have h_deg_le : ∀ u : Vertices, ‖D_raw f u‖ ≤ 10 * ‖f u‖ := by
          exact fun u => by rw [ show D_raw f u = ( PenroseGraph.degree u : ℂ ) * f u by rfl ] ; exact by rw [ norm_mul ] ; exact mul_le_mul_of_nonneg_right ( mod_cast degree_bound u ) ( norm_nonneg _ ) ;
        rw [ MeasureTheory.eLpNorm_eq_lintegral_rpow_enorm, MeasureTheory.eLpNorm_eq_lintegral_rpow_enorm ];
        · have h_integral_le : ∫⁻ u : Vertices, ‖D_raw f u‖ₑ ^ 2 ∂μ ≤ ∫⁻ u : Vertices, (10 * ‖f u‖ₑ) ^ 2 ∂μ := by
            apply_rules [ MeasureTheory.lintegral_mono ];
            exact fun u => pow_le_pow_left₀ ( by positivity ) ( by simpa [ ← ENNReal.ofReal_coe_nnreal ] using ENNReal.ofReal_le_ofReal ( h_deg_le u ) ) _;
          simp_all +decide [ mul_pow, MeasureTheory.lintegral_const_mul' ];
          convert ENNReal.rpow_le_rpow h_integral_le _ using 1 <;> norm_num;
          rw [ ENNReal.mul_rpow_of_nonneg ] <;> norm_num;
          rw [ show ( 100 : ENNReal ) = 10 ^ 2 by norm_num, ← ENNReal.rpow_natCast, ← ENNReal.rpow_mul ] ; norm_num;
        · norm_num;
        · norm_num;
        · norm_num;
        · norm_num;
      convert hD_le f.1 using 1;
      rw [ ← ENNReal.toReal_le_toReal ] <;> norm_num;
      · simp +decide [ ← ENNReal.toReal_le_toReal, MeasureTheory.Lp.norm_def ];
        erw [ MeasureTheory.eLpNorm_congr_ae ];
        -- Since $D_ae$ is defined as the quotient lift of $D_raw$, and $D_raw$ is measurable, the equality holds almost everywhere.
        have hD_ae_eq : ∀ f : Vertices → ℂ, D_ae (AEEqFun.mk f (by
        exact?)) = AEEqFun.mk (D_raw f) (by
        exact Measurable.aestronglyMeasurable ( by measurability )) := by
          exact?
        generalize_proofs at *;
        convert hD_ae_eq f.1 using 1;
        -- Apply the hypothesis `hD_ae_eq` to conclude the proof.
        apply Iff.intro;
        · exact?;
        · intro h;
          convert hD_ae_eq f.1 using 1;
          constructor <;> intro h <;> rw [ ← AEEqFun.mk_eq_mk ] at * <;> aesop;
      · refine' ne_of_lt ( lt_of_le_of_lt ( hD_le _ ) _ );
        exact ENNReal.mul_lt_top ( by norm_num ) ( by exact f.2 );
      · -- Since $f$ is in $L^2$, its $L^2$ norm is finite, so multiplying by 10 keeps it finite.
        have h_finite : MeasureTheory.eLpNorm f 2 μ ≠ ⊤ := by
          exact?;
        exact ENNReal.mul_ne_top ENNReal.coe_ne_top h_finite
    have hA : ∃ C_A : ℝ, ∀ f : L2, ‖A f‖ ≤ C_A * ‖f‖ := by
      have hA : ∀ f : Vertices → ℂ, MeasureTheory.eLpNorm (A_raw f) 2 μ ≤ 10 * MeasureTheory.eLpNorm f 2 μ := by
        exact?;
      have hA : ∀ f : Vertices →ₘ[μ] ℂ, MeasureTheory.eLpNorm (A_ae f) 2 μ ≤ 10 * MeasureTheory.eLpNorm f 2 μ := by
        intro f
        unfold A_ae;
        obtain ⟨ g, hg ⟩ := f.exists_rep;
        rw [ ← hg ];
        convert hA g using 1;
        · erw [ Quotient.lift_mk ];
          rw [ MeasureTheory.eLpNorm_congr_ae ( MeasureTheory.AEEqFun.coeFn_mk _ _ ) ];
        · erw [ MeasureTheory.eLpNorm_congr_ae ( MeasureTheory.AEEqFun.coeFn_mk _ _ ) ];
      use 10;
      intro f; specialize hA f.1; simp_all +decide [ MeasureTheory.Lp.norm_def ] ;
      convert ENNReal.toReal_mono _ hA using 1 ; norm_num [ MeasureTheory.eLpNorm ];
      exact ENNReal.mul_ne_top ENNReal.coe_ne_top ( MeasureTheory.Lp.memLp _ |> fun h => h.eLpNorm_ne_top )
    exact ⟨ hD.choose + hA.choose, fun f => by simpa only [ Δ ] using le_trans ( norm_sub_le _ _ ) ( add_le_add ( hD.choose_spec f ) ( hA.choose_spec f ) ) |> le_trans <| by ring_nf; norm_num ⟩;
  exact ⟨ Max.max h_bounded.choose 1, by positivity, fun f => le_trans ( h_bounded.choose_spec f ) ( mul_le_mul_of_nonneg_right ( le_max_left _ _ ) ( norm_nonneg _ ) ) ⟩

lemma norm_A_le (f : L2) : ‖A f‖ ≤ 10 * ‖f‖ := by
  -- The norm in L2 is defined via eLpNorm
  rw [Lp.norm_def, Lp.norm_def]
  -- We need to relate A f to A_raw f
  -- A f is defined via A_ae, which is the ae-equivalence class of A_raw
  -- So eLpNorm (A f) = eLpNorm (A_raw f)
  have h_eq : MeasureTheory.eLpNorm (A f) 2 μ = MeasureTheory.eLpNorm (A_raw f) 2 μ := by
    -- This requires unfolding definitions and using eLpNorm_congr_ae
    -- The eLpNorm of the adjacency operator is the same as the eLpNorm of A_raw because the quotient map preserves the norm.
    apply Eq.symm; exact (by
    convert MeasureTheory.eLpNorm_congr_ae _;
    -- Since the adjacency operator is linear and the quotient map preserves the norm, the two functions are equal almost everywhere.
    have h_eq : ∀ f : Vertices → ℂ, A_raw f =ᵐ[μ] A_ae (AEEqFun.mk f (by
    exact?)) := by
      all_goals generalize_proofs at *;
      intro f
      generalize_proofs at *;
      have h_eq : A_ae (AEEqFun.mk f ‹_›) = AEEqFun.mk (A_raw f) (by
      exact?) := by
        exact?
      generalize_proofs at *;
      rw [ h_eq ];
      exact?
    generalize_proofs at *;
    convert h_eq _;
    -- By definition of A, we have A f = A_ae (AEEqFun.mk f).
    simp [A])
  rw [h_eq]
  -- Now use A_raw_bound
  have h_bound := A_raw_bound f
  -- Convert from ENNReal to Real
  -- eLpNorm is ENNReal, we need to be careful
  convert ENNReal.toReal_mono _ h_bound;
  · rw [ ENNReal.toReal_mul, ENNReal.toReal_ofNat ];
  · -- Since $f$ is in $L^2$, its $L^2$ norm is finite. Multiplying a finite number by 10 still gives a finite number, so it can't be top.
    have h_finite : MeasureTheory.eLpNorm (f : Vertices →ₘ[μ] ℂ) 2 μ ≠ ⊤ := by
      exact?;
    exact ENNReal.mul_ne_top ENNReal.coe_ne_top h_finite

lemma norm_D_le (f : L2) : ‖D f‖ ≤ 10 * ‖f‖ := by
  norm_num [ Norm.norm ];
  -- Apply the bound on the degree operator and the fact that the L2 norm is preserved under multiplication by a bounded operator.
  have h_deg_bound : ∀ f : Vertices → ℂ, MeasureTheory.eLpNorm (D_raw f) 2 μ ≤ 10 * MeasureTheory.eLpNorm f 2 μ := by
    intro f
    have h_deg_bound : ∀ u : Vertices, ‖deg_fn u * f u‖ ≤ 10 * ‖f u‖ := by
      exact fun u => by rw [ norm_mul ] ; exact mul_le_mul_of_nonneg_right ( deg_fn_bound u ) ( norm_nonneg _ ) ;
    convert MeasureTheory.eLpNorm_mono_ae _ using 1;
    rotate_left;
    exact ℂ;
    exact inferInstance;
    exact fun u => 10 * f u;
    · simp_all +decide [ D_raw ];
    · norm_num [ MeasureTheory.eLpNorm ];
      norm_num [ MeasureTheory.eLpNorm' ];
      norm_num [ mul_pow, MeasureTheory.lintegral_const_mul' ];
      rw [ ENNReal.mul_rpow_of_nonneg ] <;> norm_num;
      norm_num [ ENorm.enorm ];
      rw [ show ( 100 : ENNReal ) = 10 ^ 2 by norm_num, ← ENNReal.rpow_natCast, ← ENNReal.rpow_mul ] ; norm_num;
  convert ENNReal.toReal_mono _ ( h_deg_bound f.1 ) using 1;
  · erw [ MeasureTheory.eLpNorm_congr_ae ];
    -- Since $D$ is defined as the multiplication by the degree function, and $D_raw$ is the same thing, the equality holds almost everywhere.
    have h_eq : ∀ f : Vertices → ℂ, D_ae (AEEqFun.mk f (by
    exact?)) = AEEqFun.mk (D_raw f) (by
    exact Measurable.aestronglyMeasurable ( by exact Measurable.mul ( by exact? ) ( by exact? ) )) := by
      exact?
    generalize_proofs at *;
    convert h_eq f.1 |> fun h => h.symm ▸ MeasureTheory.AEEqFun.coeFn_mk _ _;
    -- By definition of $D$, we know that $D(f) = D_ae(f)$.
    simp [D];
  · norm_num [ ENNReal.toReal_mul ];
  · exact ENNReal.mul_ne_top ENNReal.coe_ne_top ( MeasureTheory.Lp.eLpNorm_ne_top _ )

#check Δ_bounded
