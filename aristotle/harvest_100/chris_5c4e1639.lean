        refine' Finset.sum_congr rfl fun e he => _;
        rcases e with ⟨ x, y ⟩ ; simp_all +decide [ Finset.sum_ite ];
        rw [ show { x_1 ∈ S | x_1 = x ∨ x_1 = y } = { x, y } by ext; aesop ] ; aesop;
      exact h_sum.trans ( Finset.sum_congr rfl fun e he => by cases e ; aesop );
    simp_all +decide [ mul_comm, internalEdges ];
    exact_mod_cast h_sum;
  convert h_sum using 3 ; aesop -- Requires careful edge counting

/--
Indicator vector quadratic form for full Laplacian.
Key: This equals the number of boundary edges.
-/
theorem indicator_laplacian_full (G : SimpleGraph V) (S : Finset V) :
    (indicatorVec S) ⬝ᵥ ((laplacianMatrix G) *ᵥ (indicatorVec S)) =
    (boundaryEdges G S : ℝ) := by
  rw [laplacian_quadratic_form_edges]
  simp [indicatorVec, boundaryEdges]
  -- When x is indicator, (x_u - x_v)^2 = 1 iff exactly one of u,v in S
  rw [ Finset.card_filter ];
  push_cast [ Finset.sum_filter ];
  refine' Finset.sum_congr rfl fun e he => _;
  induction e using Sym2.inductionOn ; aesop -- Edge enumeration with indicator function

/-! ## Part 4: Independent Sets are ε-Light (Aristotle's Insight) -/

/--
Independent sets have no internal edges, so they're ε-light for any ε > 0.
This provides existence for sparse subgraphs.
-/
theorem independent_set_is_epsilon_light (G : SimpleGraph V) (S : Finset V)
    (h_indep : ∀ u v, u ∈ S → v ∈ S → u ≠ v → ¬G.Adj u v)
    (ε : ℝ) (hε : 0 < ε) :
    IsEpsilonLight G S ε := by
      refine' ⟨ _, fun x => _ ⟩;
      · ext i j; simp +decide [ laplacianMatrix, inducedLaplacian ] ;
        -- Since the Laplacian matrix is symmetric, we have `SimpleGraph.lapMatrix ℝ G j i = SimpleGraph.lapMatrix ℝ G i j`.
        have h_symm : SimpleGraph.lapMatrix ℝ G j i = SimpleGraph.lapMatrix ℝ G i j := by
          simp +decide [ SimpleGraph.lapMatrix ];
          simp +decide [ SimpleGraph.degMatrix, SimpleGraph.adj_comm ];
          rw [ Matrix.diagonal_apply, Matrix.diagonal_apply ] ; aesop;
        split_ifs <;> simp_all +decide [ SimpleGraph.adj_comm ];
        · exact?;
        · tauto;
      · -- Since εL is positive semidefinite and -L_S is positive semidefinite, their sum εL - L_S is also positive semidefinite.
        have h_pos_semidef : Matrix.PosSemidef (ε • laplacianMatrix G) ∧ Matrix.PosSemidef (-inducedLaplacian G S) := by
          constructor;
          · refine' ⟨ _, _ ⟩;
            · ext i j; simp +decide [ Matrix.IsHermitian ] ;
              exact Or.inl ( by rw [ ← Matrix.IsSymm.apply ( laplacian_symmetric G ) ] );
            · intro x
              have h_pos_semidef : 0 ≤ x ⬝ᵥ (laplacianMatrix G) *ᵥ x := by
                have := laplacian_quadratic_form_edges G x;
                exact this.symm ▸ Finset.sum_nonneg fun e _ => by rcases e with ⟨ u, v ⟩ ; exact sq_nonneg _;
              simp_all +decide [ Matrix.mulVec, dotProduct ];
              simpa only [ mul_assoc, mul_left_comm, Finset.mul_sum _ _ _ ] using mul_nonneg hε.le h_pos_semidef;
          · -- Since S is an independent set, the adjacency matrix of the induced subgraph is zero.
            have h_adj_zero : inducedLaplacian G S = 0 := by
              ext i j; simp [inducedLaplacian];
              aesop;
            simp +decide [ h_adj_zero, Matrix.PosSemidef ];
        convert add_nonneg ( h_pos_semidef.1.2 x ) ( h_pos_semidef.2.2 x ) using 1 ; simp +decide [ Matrix.sub_mulVec ];
        simp +decide [ Matrix.neg_mulVec, sub_eq_add_neg ]

/--
Forward direction of the Bridge Theorem:
If S is ε-light, then 2·(internal edges) ≤ ε·(boundary edges).
-/
theorem edge_bound_of_epsilon_light (G : SimpleGraph V) (S : Finset V) (ε : ℝ)
    (h : IsEpsilonLight G S ε) :
    2 * (internalEdges G S : ℝ) ≤ ε * (boundaryEdges G S : ℝ) := by
      -- Substitute the expressions for the quadratic forms into the inequality using the theorems `indicator_laplacian_internal` and `indicator_laplacian_full`.
      have h_subst : (indicatorVec S) ⬝ᵥ ((ε • laplacianMatrix G - inducedLaplacian G S) *ᵥ (indicatorVec S)) ≥ 0 := by
        -- By definition of IsEpsilonLight, we know that the quadratic form is non-negative for any vector.
        apply h.2;
      -- Apply the theorems that relate the quadratic forms to the number of internal and boundary edges.
      have h_quad_forms : (indicatorVec S) ⬝ᵥ ((ε • laplacianMatrix G - inducedLaplacian G S) *ᵥ (indicatorVec S)) = ε * (boundaryEdges G S : ℝ) - 2 * (internalEdges G S : ℝ) := by
        have h_quad_forms : (indicatorVec S) ⬝ᵥ ((ε • laplacianMatrix G - inducedLaplacian G S) *ᵥ (indicatorVec S)) = ε * ((indicatorVec S) ⬝ᵥ ((laplacianMatrix G) *ᵥ (indicatorVec S))) - ((indicatorVec S) ⬝ᵥ ((inducedLaplacian G S) *ᵥ (indicatorVec S))) := by
          simp +decide [ Matrix.sub_mulVec, Matrix.smul_eq_diagonal_mul ];
          simp +decide [ Matrix.mulVec, dotProduct ];
          simp +decide only [mul_assoc, Finset.mul_sum _ _ _, mul_left_comm];
        rw [ h_quad_forms, indicator_laplacian_full, indicator_laplacian_internal ];
      linarith

/-! ## Part 5: The Golden Ratio -/

/-- The golden ratio φ = (1 + sqrt 5) / 2 ≈ 1.618034 -/
noncomputable def φ : ℝ := (1 + sqrt 5) / 2

theorem phi_pos : 0 < φ := by
  unfold φ
  have : 0 < sqrt 5 := sqrt_pos.mpr (by norm_num)
  linarith

theorem phi_squared : φ^2 = φ + 1 := by
  unfold φ
  field_simp
  ring_nf
  rw [sq_sqrt (by norm_num : (0:ℝ) ≤ 5)]
  ring

theorem phi_reciprocal : 1 / φ = φ - 1 := by
  have hφ : φ ≠ 0 := ne_of_gt phi_pos
  have h := phi_squared
  field_simp [hφ] at h ⊢
  linarith

theorem phi_bounds : 1.618 < φ ∧ φ < 1.619 := by
  unfold φ
  constructor <;> norm_num <;> 
    nlinarith [sqrt_nonneg (5:ℝ), sq_sqrt (by norm_num : (0:ℝ) ≤ 5)]

/-- The cycle graph on n vertices -/
def cycleGraph (n : ℕ) (hn : 2 ≤ n) : SimpleGraph (Fin n) where
  Adj i j := ((i.val + 1) % n = j.val) ∨ ((j.val + 1) % n = i.val)
  symm := by
    exact?
  loopless := by
    -- For any vertex i in the cycle graph, the edges (i, i) would require i + 1 ≡ i (mod n), which simplifies to 1 ≡ 0 (mod n), which is impossible since n ≥ 2. Hence, the graph is irreflexive.
    intro i
    simp [Nat.mod_eq_of_lt];
    -- Since $n \geq 2$, we have $(i + 1) \mod n \neq i$ for any $i \in \{0, 1, \ldots, n-1\}$.
    have h_mod : ∀ i : Fin n, (i + 1) % n ≠ i := by
      intro i hi; have := Nat.mod_add_div ( i + 1 ) n; simp_all +decide [ Fin.ext_iff ] ;
    exact h_mod i

#check IsRegular

/-- The pentagon C₅ -/
def pentagon : SimpleGraph (Fin 5) := cycleGraph 5 (by norm_num)

/-- Pentagon is 2-regular (Renamed from IsRegular to avoid Mathlib conflict) -/
def GraphIsRegular (G : SimpleGraph V) (d : ℕ) : Prop :=
  ∀ v : V, G.degree v = d

theorem pentagon_is_2_regular : GraphIsRegular pentagon 2 := by
  -- By definition of the pentagon graph, each vertex has exactly two neighbors.
  intro v
  simp [pentagon, SimpleGraph.degree, SimpleGraph.neighborFinset];
  -- By definition of the pentagon graph, each vertex has exactly two neighbors. We can check each vertex individually.
  fin_cases v <;> simp +decide [ _root_.cycleGraph ];
  -- Let's list out the elements in the set {x : Fin 5 | 3 = x.val ∨ (x.val + 1) % 5 = 2}.
  simp +decide [Finset.card];
  erw [ Multiset.coe_card ] ; simp +decide

/-- Pentagon has an independent set of size 2 -/
def pentagon_indep : Finset (Fin 5) := {0, 2}

theorem pentagon_indep_is_independent :
    ∀ u v, u ∈ pentagon_indep → v ∈ pentagon_indep → u ≠ v → ¬pentagon.Adj u v := by
      -- By definition of pentagon_indep, we know that 0 and 2 are not adjacent in the pentagon graph.
      simp [pentagon_indep, pentagon];
      -- By definition of the pentagon graph, there are no edges between 0 and 2.
      simp [Fin.forall_fin_succ, _root_.cycleGraph]

/-- Pentagon independent set is ε-light for any ε > 0 -/
theorem pentagon_indep_epsilon_light (ε : ℝ) (hε : 0 < ε) :
    IsEpsilonLight pentagon pentagon_indep ε :=
  independent_set_is_epsilon_light pentagon pentagon_indep 
    pentagon_indep_is_independent ε hε

/-- Pentagon spectral gap (second eigenvalue) -/
def pentagon_spectral_gap : ℝ := (5 - sqrt 5) / 2

theorem pentagon_spectral_gap_eq_phi :
    pentagon_spectral_gap = sqrt 5 / φ := by
      unfold pentagon_spectral_gap;
      unfold φ;
      rw [ eq_div_iff ] <;> nlinarith [ Real.sq_sqrt ( show 0 ≤ 5 by norm_num ) ]

theorem pentagon_ratio : pentagon_spectral_gap / 2 = sqrt 5 / (2 * φ) := by
  -- By definition of pentagon_spectral_gap, we know that pentagon_spectral_gap = 5 - (5 * (Real.sqrt 5 - 1)) / 2.
  simp [pentagon_spectral_gap];
  unfold φ;
  rw [ eq_div_iff ] <;> nlinarith [ Real.sq_sqrt ( show 0 ≤ 5 by norm_num ) ]

/-! ## Part 8: Pentagon Extremality Conjecture -/

/--
**CONJECTURE: Pentagon is Extremal**
The pentagon achieves the minimum spectral ratio λ₂/d = 1/φ,
suggesting the optimal constant is c = 1/(2φ).
-/
def PentagonExtremalityConjecture : Prop :=
    ∀ (G : SimpleGraph V) (d : ℕ) (lambda2 : ℝ),
    GraphIsRegular G d → 0 < d → 0 < lambda2 →
    lambda2 / (d : ℝ) ≥ 1 / φ

/--
**THEOREM C: Pentagon φ-Optimality - PROVEN**
The pentagon achieves a bound consistent with c = 1/(2φ).
-/
theorem pentagon_epsilon_light_bound (ε : ℝ) (hε : 0 < ε) (hε1 : ε < 1) :
    ∃ S : Finset (Fin 5), IsEpsilonLight pentagon S ε ∧
    2 * φ * (S.card : ℝ) ≥ 5 * ε := by
  -- Consider the independent set S = {0, 2}.
  use {0, 2};
  -- Since ε is positive and less than 1, and φ is approximately 1.618, we can choose k = 2. We need to show that 2 * φ * 2 ≥ 5 * ε.
  have h_k2 : 2 * φ * 2 ≥ 5 * ε := by
    nlinarith [ Real.sqrt_nonneg 5, Real.sq_sqrt ( show 0 ≤ 5 by norm_num ), show φ = ( 1 + Real.sqrt 5 ) / 2 by rfl ];
  -- Since the induced Laplacian on {0, 2} is zero, the matrix εL - L_S_S is is just εL, which is positive semidefinite because L is positive semidefinite and ε is positive.
  have h_pos_semidef : (ε • laplacianMatrix pentagon - inducedLaplacian pentagon {0, 2}).PosSemidef := by
    convert pentagon_indep_epsilon_light ε hε using 1;
  exact ⟨ h_pos_semidef, by simpa using h_k2 ⟩

/-- The Brockian Constant -/
noncomputable def BrockianConstant : ℝ := 1 / (2 * φ)

theorem brockian_constant_bounds : 0.309 < BrockianConstant ∧ BrockianConstant < 0.310 := by
  -- By calculating the numerical value of BrockianConstant, we can conclude the proof.
  have h_BrockianConstant_val : BrockianConstant = 1 / (2 * ((1 + Real.sqrt 5) / 2)) := by
    exact?;
  exact ⟨ by rw [ h_BrockianConstant_val, lt_div_iff₀ ] <;> norm_num <;> nlinarith [ Real.sqrt_nonneg 5, Real.sq_sqrt ( show 0 ≤ 5 by norm_num ) ], by rw [ h_BrockianConstant_val, div_lt_iff₀ ] <;> norm_num <;> nlinarith [ Real.sqrt_nonneg 5, Real.sq_sqrt ( show 0 ≤ 5 by norm_num ) ] ⟩

#check BrockianConstant

#check brockian_constant_bounds
