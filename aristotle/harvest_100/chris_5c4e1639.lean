/-- Induced Laplacian on subset S (Corrected to Adjacency for consistency with theorems) -/
def inducedLaplacian (G : SimpleGraph V) (S : Finset V) : Matrix V V ℝ :=
  let G' := G.induce ↑S
  Matrix.of (fun i j => 
    if h : i ∈ S ∧ j ∈ S then 
      (G'.adjMatrix ℝ) ⟨i, h.1⟩ ⟨j, h.2⟩ 
    else 0)

/-- Core Definition: S is ε-light if εL - L_S is PSD -/
def IsEpsilonLight (G : SimpleGraph V) (S : Finset V) (ε : ℝ) : Prop :=
  (ε • laplacianMatrix G - inducedLaplacian G S).PosSemidef

/-- Indicator vector -/
def indicatorVec (S : Finset V) : V → ℝ :=
  fun v => if v ∈ S then 1 else 0

/-- Internal edges (both endpoints in S) -/
def internalEdges (G : SimpleGraph V) (S : Finset V) : ℕ :=
  (G.edgeFinset.filter (fun e => ∀ v ∈ e, v ∈ S)).card

/-- Boundary edges (exactly one endpoint in S) -/
def boundaryEdges (G : SimpleGraph V) (S : Finset V) : ℕ :=
  (G.edgeFinset.filter (fun e => ∃ v ∈ e, v ∈ S ∧ ∃ w ∈ e, w ∉ S)).card

/--
Indicator vector quadratic form for induced Laplacian.
Key: This equals 2 times the number of internal edges.
-/
theorem indicator_laplacian_internal (G : SimpleGraph V) (S : Finset V) :
    (indicatorVec S) ⬝ᵥ ((inducedLaplacian G S) *ᵥ (indicatorVec S)) =
    2 * (internalEdges G S : ℝ) := by
  simp [inducedLaplacian, indicatorVec, dotProduct, Matrix.mulVec]
  -- The quadratic form counts each edge twice (once from each endpoint)
  have h_sum : (∑ x ∈ S, ∑ x_1 ∈ S, if G.Adj x x_1 then 1 else 0) = 2 * (internalEdges G S : ℝ) := by
    have h_sum : (∑ x ∈ S, ∑ x_1 ∈ S, if G.Adj x x_1 then 1 else 0) = ∑ e ∈ G.edgeFinset.filter (fun e => ∀ v ∈ e, v ∈ S), 2 := by
      have h_sum : (∑ x ∈ S, ∑ x_1 ∈ S, if G.Adj x x_1 then 1 else 0) = ∑ e ∈ G.edgeFinset.filter (fun e => ∀ v ∈ e, v ∈ S), (if e.IsDiag then 0 else 2) := by
        have h_sum : ∀ x ∈ S, ∑ x_1 ∈ S, (if G.Adj x x_1 then 1 else 0) = ∑ e ∈ G.edgeFinset.filter (fun e => ∀ v ∈ e, v ∈ S), (if e.IsDiag then 0 else (if x ∈ e then 1 else 0)) := by
          intro x hx
          have h_sum : ∑ x_1 ∈ S, (if G.Adj x x_1 then 1 else 0) = ∑ e ∈ G.edgeFinset.filter (fun e => ∀ v ∈ e, v ∈ S), (if e.IsDiag then 0 else (if x ∈ e then 1 else 0)) := by
            have h_sum : Finset.filter (fun x_1 => G.Adj x x_1) S = Finset.biUnion (G.edgeFinset.filter (fun e => ∀ v ∈ e, v ∈ S)) (fun e => if e.IsDiag then ∅ else if x ∈ e then Finset.filter (fun y => y ∈ e ∧ y ≠ x) S else ∅) := by
              ext y; simp [Finset.mem_biUnion, Finset.mem_filter];
              constructor <;> intro hxy;
              · use Sym2.mk (x, y);
                aesop;
              · -- Since $a$ is not diagonal and $x \in a$, $a$ must be an edge between $x$ and $y$.
                obtain ⟨a, ha₁, ha₂⟩ := hxy
                have ha₃ : a = Sym2.mk (x, y) := by
                  cases a ; aesop;
                aesop
            rw [ ← Finset.sum_filter, h_sum, Finset.sum_biUnion ];
            · refine' Finset.sum_congr rfl fun e he => _;
              split_ifs <;> simp_all +decide [ Finset.filter_ne', Finset.filter_and ];
              rw [ Finset.card_eq_one ];
              rcases e with ⟨ u, v ⟩ ; aesop;
            · intro e he f hf hne; simp_all +decide [ Finset.disjoint_left ] ;
              rcases e with ⟨ u, v ⟩ ; rcases f with ⟨ w, x ⟩ ; aesop;
