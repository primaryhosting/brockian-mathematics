    -- By definition of φ, we know that φ^2 = φ + 1.
    apply phi_squared;
  -- Using the fact that φ^2 = φ + 1, we can rewrite φ^(n+2) as φ^(n+1) * φ^2.
  rw [pow_add, h_phi_sq]
  ring

