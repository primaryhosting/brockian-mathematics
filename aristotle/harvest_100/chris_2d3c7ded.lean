/-- ★ THE GOLDEN EQUATION: φ² = φ + 1
    
    This is the defining property of the golden ratio.
    From this, all other properties flow.
-/
theorem phi_squared : φ ^ 2 = φ + 1 := by
  unfold φ
  field_simp
  ring_nf
  rw [Real.sq_sqrt (by norm_num : (0 : ℝ) ≤ 5)]
  ring

/-- The reciprocal relation: 1/φ = φ - 1
    
    An immediate consequence of the golden equation.
    Shows φ is its own "reciprocal shifted by 1".
-/
theorem phi_reciprocal : 1 / φ = φ - 1 := by
  have h := phi_squared
  field_simp [phi_ne_zero]
  linarith [h]

/-- Alternative form: φ² - φ - 1 = 0 -/
theorem phi_equation : φ ^ 2 - φ - 1 = 0 := by
  have h := phi_squared
  linarith

/-- Vieta's sum: φ + ψ = 1 -/
theorem phi_psi_sum : φ + ψ = 1 := by
  -- Adding the definitions of φ and ψ, we get:
