      rw [pow_succ', h_phi_sq];
    linear_combination' h_phi_cubed;
  -- Substitute φ^2 = φ + 1 into the equation for φ^3.
  rw [h_phi3, phi_squared]
  ring

/-- φ⁴ = 3φ + 2 -/
theorem phi_fourth : φ ^ 4 = 3 * φ + 2 := by
  -- We can prove this by induction on $n$.
  have h_phi_induction : ∀ n : ℕ, φ ^ (n + 2) = φ ^ (n + 1) + φ ^ n := by
    -- We'll use the fact that φ satisfies the equation φ² = φ + 1.
    have h_phi_sq : φ^2 = φ + 1 := by
      -- By definition of $φ$, we know that $φ^2 = φ + 1$.
      rw [phi_squared];
    exact fun n => by linear_combination h_phi_sq * φ ^ n;
  norm_num [ pow_succ, h_phi_induction ] ; ring

/-- General Fibonacci relation: φⁿ⁺² = φⁿ⁺¹ + φⁿ -/
theorem phi_fibonacci (n : ℕ) : φ ^ (n + 2) = φ ^ (n + 1) + φ ^ n := by
  -- Using the fact that φ^2 = φ + 1, we can rewrite φ^(n+2) as φ^(n+2) = φ^n * φ^2.
