/-- Vieta's product: φ · ψ = -1 -/
theorem phi_psi_product : φ * ψ = -1 := by
  -- By definition of φ and ψ, we have φ * ψ = ((1 + Real.sqrt 5) / 2) * ((1 - Real.sqrt 5) / 2).
  simp [φ, ψ]

/-- φ and ψ are roots of x² - x - 1 = 0 -/
theorem phi_psi_roots (x : ℝ) :
    x ^ 2 - x - 1 = 0 ↔ x = φ ∨ x = ψ := by
      -- By definition of φ and ψ, we know that φ^2 - φ - 1 = 0 and ψ^2 - ψ - 1 = 0.
