/-- The golden ratio φ = (1 + √5)/2 ≈ 1.618... -/
def φ : ℝ := (1 + Real.sqrt 5) / 2

/-- The golden conjugate ψ = (1 - √5)/2 ≈ -0.618... -/
def ψ : ℝ := (1 - Real.sqrt 5) / 2

/-- φ is positive -/
theorem phi_pos : 0 < φ := by
  unfold φ
  have h : 0 < Real.sqrt 5 := by positivity
  linarith

/-- φ is nonzero (useful for division) -/
theorem phi_ne_zero : φ ≠ 0 := ne_of_gt phi_pos

/-- φ exceeds 1 -/
