/-- ★ The Brockian spiral: γ(t) = exp(t(1 + iφ)) -/
def spiral (t : ℝ) : ℂ := Complex.exp ((t : ℂ) * (1 + (_root_.φ : ℂ) * Complex.I))

/-- ★ FUNDAMENTAL: The spiral has exponential radial growth: ‖γ(t)‖ = eᵗ -/
theorem spiral_norm (t : ℝ) : ‖spiral t‖ = Real.exp t := by
  unfold spiral
