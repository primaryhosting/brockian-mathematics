/-- Spiral term satisfies |spiralTerm(p,s)| = p^(-Re(s)) for real s -/
theorem spiralTerm_norm_real (p : BPrime) (s : ℂ) (hs : s.im = 0) :
    ‖spiralTerm p s‖ = (p.val : ℝ) ^ (-s.re) := by
      -- The norm of the first exponential term is $e^{-s.re \cdot \log p.val}$.
      have h1 : ‖Complex.exp (-s * (Real.log p.val : ℂ))‖ = Real.exp (-s.re * Real.log p.val) := by
        -- The norm of the exponential term is $e^{-s.re \cdot \log p.val}$ because the exponential of a real number is just the real exponential function.
        simp [Complex.norm_exp];
        norm_num [ hs, Complex.log_re, Complex.log_im ];
      -- The norm of the second exponential term is 1.
      have h2 : ‖Complex.exp (-s * Complex.I * _root_.φ * Real.log p.val)‖ = 1 := by
        -- The norm of the exponential term is 1 because the exponent is purely imaginary.
        simp [Complex.norm_exp];
        norm_num [ hs, Complex.log_im ];
      unfold spiralTerm;
      rw [ norm_mul, h1, h2, Real.rpow_def_of_pos ( Nat.cast_pos.mpr p.isPrime.pos ) ] ; ring

