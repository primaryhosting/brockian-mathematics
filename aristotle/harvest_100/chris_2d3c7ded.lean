/-- The phase of spiralPrime(p) is φ log p (mod 2π) -/
theorem spiralPrime_phase (p : BPrime) :
    ∃ k : ℤ, Complex.arg (spiralPrime p) = _root_.φ * Real.log p.val - 2 * Real.pi * k := by
  unfold spiralPrime
  exact spiral_phase _

/-- Two primes have the same norm iff they're equal -/
theorem spiralPrime_norm_inj (p q : BPrime) :
    ‖spiralPrime p‖ = ‖spiralPrime q‖ → p.val = q.val := by
  intro h
  rw [spiralPrime_norm, spiralPrime_norm] at h
  exact Nat.cast_injective h

theorem pentagonal_average_linear_proven (f g : ℂ → ℂ) (α β : ℂ) (s : ℂ) :
    pentagonalAverage (fun s => α * f s + β * g s) s =
      α * pentagonalAverage f s + β * pentagonalAverage g s := by
  unfold pentagonalAverage
  simp only [Finset.sum_add_distrib, mul_add, add_mul, Finset.mul_sum, Finset.sum_mul]
  ring
