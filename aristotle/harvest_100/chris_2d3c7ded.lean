theorem spiralPrime_norm (p : BPrime) : ‖spiralPrime p‖ = (p.val : ℝ) := by
  unfold spiralPrime
  rw [spiral_norm]
  exact Real.exp_log (Nat.cast_pos.mpr p.isPrime.pos)

/-- ★ The Brockian character: χ_B(n) = n^(iφ) = exp(iφ log n) -/
def character (n : ℕ) : ℂ := 
  if n = 0 then 0 else Complex.exp (_root_.φ * Complex.I * Real.log n)

/-- χ_B(1) = 1 -/
@[simp] theorem character_one : character 1 = 1 := by
  unfold character
  simp

/-- χ_B(0) = 0 -/
@[simp] theorem character_zero : character 0 = 0 := by
  unfold character
  simp

/-- ★★ FUNDAMENTAL: Complete multiplicativity χ_B(mn) = χ_B(m)χ_B(n) -/
theorem character_multiplicative (m n : ℕ) (hm : m ≠ 0) (hn : n ≠ 0) :
    character (m * n) = character m * character n := by
  unfold character
  simp [hm, hn, Real.log_mul]
  rw [← Complex.exp_add]
  ring_nf

/-- ★ FUNDAMENTAL: Unitarity |χ_B(n)| = 1 for n > 0 -/
theorem character_unitary (n : ℕ) (hn : n ≠ 0) :
    ‖character n‖ = 1 := by
      -- The norm of the exponential term is 1, so we can simplify the expression.
      have h_exp_norm : ‖Complex.exp (_root_.φ * Complex.I * Real.log n)‖ = 1 := by
        -- The norm of the exponential of an imaginary number is 1.
        simp [Complex.norm_exp];
        norm_num [ Complex.log_im ];
      -- Since the norm of the exponential term is 1, we can conclude that the norm of the character is also 1.
      convert h_exp_norm using 1;
      -- Since the character is defined as the exponential term, their norms are equal.
      simp [character];
      -- Since $n \neq 0$, the if statement simplifies to the else part, which is the exponential term.
      simp [hn]

/-- Pentagonal rotation: shift by 2πik/5 -/
def pentagonalRotation (k : Fin 5) (s : ℂ) : ℂ :=
  s + (2 * Real.pi * Complex.I * (k.val : ℂ)) / 5

/-- The D₅ pentagonal averaging operator -/
def pentagonalAverage (f : ℂ → ℂ) (s : ℂ) : ℂ :=
  (1 / 5) * ∑ k : Fin 5, f (pentagonalRotation k s)

/-- ★ Pentagonal average is linear -/
theorem pentagonal_average_linear (f g : ℂ → ℂ) (α β : ℂ) (s : ℂ) :
    pentagonalAverage (fun s => α * f s + β * g s) s =
      α * pentagonalAverage f s + β * pentagonalAverage g s := by
        -- Apply the linearity of summation and factor out the constants α and β.
        simp [pentagonalAverage, Finset.sum_add_distrib, mul_add, add_mul, Finset.mul_sum, Finset.sum_mul];
        -- By commutativity and associativity of multiplication, we can rearrange the terms in the sums.
        simp [mul_comm, mul_assoc, mul_left_comm]

/-- The spiral term in the Euler product -/
def spiralTerm (p : BPrime) (s : ℂ) : ℂ :=
  Complex.exp (-s * (Real.log p.val : ℂ)) * 
  Complex.exp (-s * Complex.I * _root_.φ * Real.log p.val)

/-- The Brockian Euler factor -/
def brockianEuler (p : BPrime) (s : ℂ) : ℂ := 
  (1 - spiralTerm p s)⁻¹

/-- The Brockian zeta function (formal Euler product) -/
def brockianZeta (s : ℂ) : ℂ := 
  ∏' p : BPrime, brockianEuler p s

/-- Goldbach representation count: # of ways to write n = p + q with p, q prime -/
def goldbachCount (n : ℕ) : ℕ :=
  ((Finset.range (n / 2 + 1)).filter
    (fun p => Nat.Prime p ∧ Nat.Prime (n - p))).card

/-- ★ If count ≥ 1, then Goldbach pairs exist -/
theorem goldbach_from_count {n : ℕ} (h : goldbachCount n ≥ 1) :
    ∃ p q, Nat.Prime p ∧ Nat.Prime q ∧ p + q = n := by
      -- By definition of `goldbachCount`, if `goldbachCount n ≥ 1`, then there exists at least one pair of primes `(p, q)` such that `p + q = n`.
      simp [goldbachCount] at h;
      -- By definition of `Finset.Nonempty`, there exists some `p` in the set such that `Nat.Prime p` and `Nat.Prime (n - p)`.
      obtain ⟨p, hp⟩ : ∃ p ∈ Finset.range (n / 2 + 1), Nat.Prime p ∧ Nat.Prime (n - p) := by
        -- By definition of nonemptiness, there exists some element in the set.
        apply Finset.nonempty_iff_ne_empty.mpr h.ne_empty |> fun ⟨p, hp⟩ => ⟨p, by simpa using hp⟩;
      exact ⟨ p, n - p, hp.2.1, hp.2.2, Nat.add_sub_of_le ( by linarith [ Finset.mem_range.mp hp.1, Nat.div_mul_le_self n 2 ] ) ⟩

/-- Spectral model framework -/
structure GoldbachSpectralModel where
  mainTerm : ℕ → ℝ
  errorTerm : ℕ → ℝ
  error_nonneg : ∀ n, 0 ≤ errorTerm n
  approximation : ∀ n, n > 2 → Even n →
    |(goldbachCount n : ℝ) - mainTerm n| ≤ errorTerm n
  threshold : ℕ
  margin : ∀ n, n > threshold → mainTerm n - errorTerm n ≥ 1 / 2

/-- For large n, the spectral model guarantees count ≥ 1 -/
theorem goldbach_count_positive_large (M : GoldbachSpectralModel) :
    ∀ n, n > max 2 M.threshold → Even n → goldbachCount n ≥ 1 := by
      -- By definition of GoldbachSpectralModel, for any even n > max 2 M.threshold, there exists a prime p such that n - p is also prime.
      have h_prime_pair : ∀ n > max 2 M.threshold, Even n → ∃ p, Nat.Prime p ∧ Nat.Prime (n - p) := by
        -- By definition of GoldbachSpectralModel, there exists a spectral parameter s such that the Brockian Zeta function's properties imply the existence of primes p and q with p + q = n.
        obtain ⟨s, hs⟩ := M;
        intro n hn hn_even
        have h_prime_pair : goldbachCount n ≥ 1 := by
          -- Since $s n - hs n \geq 1/2$ and $|goldbachCount n - s n| \leq hs n$, we have $goldbachCount n \geq s n - hs n \geq 1/2$.
          have h_goldbach_count_half : goldbachCount n ≥ s n - hs n := by
            linarith [ abs_le.mp ( ‹∀ n > 2, Even n → |( goldbachCount n : ℝ ) - s n| ≤ hs n› n ( lt_of_le_of_lt ( le_max_left _ _ ) hn ) hn_even ) ];
          exact Nat.one_le_iff_ne_zero.mpr ( by rintro h; norm_num [ h ] at h_goldbach_count_half; linarith [ ‹∀ n > _, s n - hs n ≥ 1 / 2› n ( lt_of_le_of_lt ( le_max_right _ _ ) hn ) ] );
        obtain ⟨ p, hp ⟩ := goldbach_from_count h_prime_pair; use p; aesop;
      generalize_proofs at *;
      -- By definition of goldbachCount, if there exists a prime p such that n - p is also prime, then the goldbachCount is at least 1.
      intros n hn h_even
      obtain ⟨p, hp_prime, hp_prime'⟩ := h_prime_pair n hn h_even
      have h_goldbach_count : goldbachCount n ≥ 1 := by
        refine' Finset.card_pos.mpr _;
        by_cases hp_le : p ≤ n / 2;
        · exact ⟨ p, Finset.mem_filter.mpr ⟨ Finset.mem_range.mpr ( by linarith [ Nat.div_mul_le_self n 2 ] ), hp_prime, hp_prime' ⟩ ⟩;
        · exact ⟨ n - p, Finset.mem_filter.mpr ⟨ Finset.mem_range.mpr ( by omega ), hp_prime', by simpa [ Nat.sub_sub_self ( show p ≤ n from le_of_not_ge fun h => by rw [ tsub_eq_zero_iff_le.mpr h ] at hp_prime'; exact Nat.not_prime_zero hp_prime' ) ] using hp_prime ⟩ ⟩
      exact h_goldbach_count

/-- ★ CONDITIONAL GOLDBACH THEOREM -/
theorem goldbach_conditional (M : GoldbachSpectralModel)
    (h_small : ∀ n, n ≤ max 2 M.threshold → n > 2 → Even n →
               ∃ p q, Nat.Prime p ∧ Nat.Prime q ∧ p + q = n) :
    ∀ n, n > 2 → Even n →
    ∃ p q, Nat.Prime p ∧ Nat.Prime q ∧ p + q = n := by
  intro n hn heven
  by_cases h : n ≤ max 2 M.threshold
  · exact h_small n h hn heven
  · push_neg at h
    exact goldbach_from_count (goldbach_count_positive_large M n h heven)

