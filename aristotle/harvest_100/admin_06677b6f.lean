/-
Combinatorial maps (rotation systems) of genus zero, and Euler's formula.

A *combinatorial map* consists of a finite set `D` of darts, a permutation `σ`
whose cycles are the vertices, and a fixed-point-free involution `α` pairing the
two darts of each edge.  The cycles of `σ * α` are the faces.  A map is
*connected* when the group generated by `σ` and `α` acts transitively, and it has
*genus zero* (i.e. it is a plane map) when `V - E + F = 2`.

Here the vertices are labelled by a type `V` via a map `w : D → V` whose fibres
are exactly the cycles of `σ`.
-/
import RequestProject.CycleCount

namespace FiveColor

open Equiv Equiv.Perm SimpleGraph

section Counting

variable {D : Type*} [Fintype D] [DecidableEq D]

open scoped Classical in
/-- The cycle of `x` under `π`, as a `Finset`. -/
noncomputable def cycFiber (π : Perm D) (x : D) : Finset D :=
  Finset.univ.filter (fun z => π.SameCycle z x)

open scoped Classical in
theorem mem_cycFiber {π : Perm D} {x z : D} : z ∈ cycFiber π x ↔ π.SameCycle z x := by
  simp [cycFiber]

theorem card_fiberwise (π : Perm D) [Fintype (Quotient (SameCycle.setoid π))] :
    Fintype.card D = ∑ c : Quotient (SameCycle.setoid π), (cycFiber π c.out).card := by
  classical
  have h := Finset.card_eq_sum_card_fiberwise
    (f := fun a : D => cyc π a) (s := (Finset.univ : Finset D))
    (t := (Finset.univ : Finset (Quotient (SameCycle.setoid π))))
    (fun a _ => Finset.mem_univ _)
  rw [Finset.card_univ] at h
  rw [h]
  refine Finset.sum_congr rfl ?_
  intro c _
  have hout : cyc π c.out = c := Quotient.out_eq c
  congr 1
  ext a
  simp only [Finset.mem_filter, Finset.mem_univ, true_and, mem_cycFiber]
  constructor
  · intro h1
    exact cyc_eq_iff.1 (by rw [h1, hout])
  · intro h1
    rw [← hout]
    exact cyc_eq_iff.2 h1

theorem mul_numCycles_le_card (π : Perm D) (k : ℕ)
    (h : ∀ x : D, k ≤ (cycFiber π x).card) : k * numCycles π ≤ Fintype.card D := by
  classical
  letI : Fintype (Quotient (SameCycle.setoid π)) := Fintype.ofFinite _
  rw [card_fiberwise π]
  calc k * numCycles π
      = ∑ _c : Quotient (SameCycle.setoid π), k := by
        rw [Finset.sum_const, Finset.card_univ, smul_eq_mul, mul_comm]
        congr 1
        simp [numCycles, Nat.card_eq_fintype_card]
    _ ≤ _ := Finset.sum_le_sum (fun c _ => h c.out)

theorem card_le_mul_numCycles (π : Perm D) (k : ℕ)
    (h : ∀ x : D, (cycFiber π x).card ≤ k) : Fintype.card D ≤ k * numCycles π := by
  classical
  letI : Fintype (Quotient (SameCycle.setoid π)) := Fintype.ofFinite _
  rw [card_fiberwise π]
  calc ∑ c : Quotient (SameCycle.setoid π), (cycFiber π c.out).card
      ≤ ∑ _c : Quotient (SameCycle.setoid π), k := Finset.sum_le_sum (fun c _ => h c.out)
    _ = k * numCycles π := by
        rw [Finset.sum_const, Finset.card_univ, smul_eq_mul, mul_comm]
        congr 1
        simp [numCycles, Nat.card_eq_fintype_card]

theorem cycFiber_of_fixed {π : Perm D} {x : D} (hx : π x = x) : cycFiber π x = {x} := by
  classical
  ext z
  simp only [mem_cycFiber, Finset.mem_singleton]
  constructor
  · rintro ⟨i, hi⟩
    have hfix : ∀ j : ℤ, (π ^ j) x = x := fun j =>
      Equiv.Perm.zpow_apply_eq_self_of_apply_eq_self hx j
    have h2 := congrArg (fun y => (π ^ (-i)) y) hi
    simp only [← Perm.mul_apply, ← zpow_add] at h2
    simp only [neg_add_cancel, zpow_zero, Perm.coe_one, id_eq] at h2
    rw [hfix (-i)] at h2
    exact h2
  · rintro rfl
    exact SameCycle.rfl

end Counting

/-- A connected genus-zero combinatorial map with vertices labelled by `V`. -/
structure Rot (V : Type*) where
  /-- the (finite) set of darts -/
  D : Type
  [fin : Fintype D]
  [dec : DecidableEq D]
  /-- the rotation: its cycles are the vertices -/
  σ : Perm D
  /-- the edge involution -/
  α : Perm D
  /-- the vertex labelling -/
  w : D → V
  α_inv : ∀ d, α (α d) = d
  w_sigma : ∀ d, w (σ d) = w d
  w_surj : Function.Surjective w
  w_cycle : ∀ d e, w d = w e → σ.SameCycle d e
  noloop : ∀ d, w (α d) ≠ w d
  conn : ∀ d e, Relation.ReflTransGen (fun x y => y = σ x ∨ y = α x) d e
  euler : 2 + numCycles α ≤ numCycles σ + numCycles (σ * α)

attribute [instance] Rot.fin Rot.dec

namespace Rot

variable {V : Type*} (M : Rot V)

/-- A map is simple when distinct edges have distinct pairs of endpoints. -/
def Simple : Prop := ∀ d e, M.w d = M.w e → M.w (M.α d) = M.w (M.α e) → d = e

theorem α_ne (d : M.D) : M.α d ≠ d := fun h => M.noloop d (by rw [h])

theorem w_of_sameCycle {d e : M.D} (h : M.σ.SameCycle d e) : M.w d = M.w e := by
  obtain ⟨n, hn⟩ := h.exists_nat_pow_eq
  subst hn
  clear h
  induction n with
  | zero => rfl
  | succ n ih =>
      have he : ((M.σ ^ (n + 1)) d) = M.σ ((M.σ ^ n) d) := by rw [pow_succ']; rfl
      rw [he, M.w_sigma]
      exact ih

/-- The underlying simple graph of a map. -/
def graph : SimpleGraph V where
  Adj u v := u ≠ v ∧ ∃ d, M.w d = u ∧ M.w (M.α d) = v
  symm := by
    rintro u v ⟨huv, d, hd, hd'⟩
    exact ⟨huv.symm, M.α d, hd', by rw [M.α_inv]; exact hd⟩
  loopless := ⟨by rintro u ⟨h, -⟩; exact h rfl⟩

theorem graph_adj_iff {u v : V} :
    M.graph.Adj u v ↔ u ≠ v ∧ ∃ d, M.w d = u ∧ M.w (M.α d) = v := Iff.rfl

theorem graph_adj_of_dart (d : M.D) : M.graph.Adj (M.w d) (M.w (M.α d)) :=
  ⟨fun h => M.noloop d h.symm, d, rfl, rfl⟩

/-- `G` is a spanning subgraph of the graph of the map. -/
def Spans (G : SimpleGraph V) : Prop := ∀ u v, G.Adj u v → ∃ d, M.w d = u ∧ M.w (M.α d) = v

theorem le_graph {G : SimpleGraph V} (h : M.Spans G) : G ≤ M.graph :=
  fun _ _ huv => ⟨huv.ne, h _ _ huv⟩

theorem spans_graph : M.Spans M.graph := fun _ _ h => h.2

/-- The number of vertices of the map is the cardinality of `V`. -/
theorem numCycles_sigma : numCycles M.σ = Nat.card V := by
  classical
  refine Nat.card_eq_of_bijective
    (f := fun c : Quotient (SameCycle.setoid M.σ) =>
      Quotient.liftOn c M.w (fun a b h => M.w_of_sameCycle h)) ⟨?_, ?_⟩
  · intro c₁ c₂ h
    induction c₁ using Quotient.inductionOn with
    | _ x =>
      induction c₂ using Quotient.inductionOn with
      | _ y =>
        simp only [Quotient.liftOn_mk] at h
        exact Quotient.sound (M.w_cycle x y h)
  · intro u
    obtain ⟨d, rfl⟩ := M.w_surj u
    exact ⟨cyc M.σ d, rfl⟩

/-- The cycles of `α` are the pairs `{d, α d}`. -/
theorem alpha_sameCycle_iff {z x : M.D} : M.α.SameCycle z x ↔ z = x ∨ z = M.α x := by
  have hsq : M.α * M.α = 1 := Equiv.ext (fun y => M.α_inv y)
  have hsq2 : M.α ^ (2 : ℤ) = 1 := by
    rw [show (2 : ℤ) = ((2 : ℕ) : ℤ) from rfl, zpow_natCast, pow_two, hsq]
  have hα2 : ∀ i : ℤ, M.α ^ i = 1 ∨ M.α ^ i = M.α := by
    intro i
    rcases Int.even_or_odd i with ⟨k, hk⟩ | ⟨k, hk⟩
    · left
      rw [hk, show k + k = 2 * k by ring, zpow_mul, hsq2, one_zpow]
    · right
      rw [hk, zpow_add, zpow_mul, hsq2, one_zpow, one_mul, zpow_one]
  constructor
  · rintro ⟨i, hi⟩
    rcases hα2 i with h | h <;> rw [h] at hi
    · left; simpa using hi
    · right; rw [← hi, M.α_inv]
  · rintro (rfl | rfl)
    · exact SameCycle.rfl
    · exact ⟨1, by simp [M.α_inv]⟩

theorem card_darts_eq : Fintype.card M.D = 2 * numCycles M.α := by
  classical
  have hfib : ∀ x : M.D, cycFiber M.α x = {x, M.α x} := by
    intro x
    ext z
    simp only [mem_cycFiber, Finset.mem_insert, Finset.mem_singleton]
    exact M.alpha_sameCycle_iff
  have hcard : ∀ x : M.D, (cycFiber M.α x).card = 2 := by
    intro x
    rw [hfib x, Finset.card_insert_of_notMem (by simp [Ne.symm (M.α_ne x)]),
      Finset.card_singleton]
  exact le_antisymm (card_le_mul_numCycles M.α 2 (fun x => (hcard x).le))
    (mul_numCycles_le_card M.α 2 (fun x => (hcard x).ge))

theorem three_le_face_card (hs : M.Simple) (hdeg : ∀ d, M.σ d ≠ d) (x : M.D) :
    3 ≤ (cycFiber (M.σ * M.α) x).card := by
  classical
  set φ := M.σ * M.α with hφ
  have hφa : ∀ z, φ z = M.σ (M.α z) := fun z => rfl
  have h1 : φ x ≠ x := by
    intro h
    have hw : M.w (M.σ (M.α x)) = M.w (M.α x) := M.w_sigma _
    rw [hφa] at h
    rw [h] at hw
    exact M.noloop x hw.symm
  have h2 : φ (φ x) ≠ x := by
    intro h
    have hy : M.w (φ x) = M.w (M.α x) := by rw [hφa]; exact M.w_sigma _
    have hx2 : M.w (M.α (φ x)) = M.w x := by
      have hw : M.w (M.σ (M.α (φ x))) = M.w (M.α (φ x)) := M.w_sigma _
      rw [← hw, ← hφa, h]
    by_cases hcase : φ x = M.α x
    · exact hdeg (M.α x) (by rw [hφa] at hcase; exact hcase)
    · exact hcase (hs (M.α x) (φ x) hy.symm (by rw [M.α_inv]; exact hx2.symm)).symm
  have h3 : φ x ≠ φ (φ x) := fun h => h1 ((Equiv.injective φ) h).symm
  have hsub : ({x, φ x, φ (φ x)} : Finset M.D) ⊆ cycFiber φ x := by
    intro z hz
    simp only [Finset.mem_insert, Finset.mem_singleton] at hz
    rcases hz with rfl | rfl | rfl
    · exact mem_cycFiber.2 SameCycle.rfl
    · exact mem_cycFiber.2 (show φ.SameCycle x (φ x) from ⟨1, by simp⟩).symm
    · refine mem_cycFiber.2 (show φ.SameCycle x (φ (φ x)) from ⟨2, ?_⟩).symm
      rw [show (2 : ℤ) = ((2 : ℕ) : ℤ) from rfl, zpow_natCast, pow_two]
      rfl
  have hnotmem1 : x ∉ ({φ x, φ (φ x)} : Finset M.D) := by
    simp only [Finset.mem_insert, Finset.mem_singleton]
    push_neg
    exact ⟨Ne.symm h1, Ne.symm h2⟩
  have hnotmem2 : φ x ∉ ({φ (φ x)} : Finset M.D) := by
    simp only [Finset.mem_singleton]
    exact h3
  have hc : ({x, φ x, φ (φ x)} : Finset M.D).card = 3 := by
    rw [Finset.card_insert_of_notMem hnotmem1, Finset.card_insert_of_notMem hnotmem2,
      Finset.card_singleton]
  calc 3 = ({x, φ x, φ (φ x)} : Finset M.D).card := hc.symm
    _ ≤ _ := Finset.card_le_card hsub

/-- Euler's formula: a simple plane map with no vertices of degree at most one
satisfies `E + 6 ≤ 3V`. -/
theorem edge_bound (hs : M.Simple) (hdeg : ∀ d, M.σ d ≠ d) :
    numCycles M.α + 6 ≤ 3 * numCycles M.σ := by
  have hF : 3 * numCycles (M.σ * M.α) ≤ Fintype.card M.D :=
    mul_numCycles_le_card _ 3 (M.three_le_face_card hs hdeg)
  have hE := M.card_darts_eq
  have he := M.euler
  omega

end Rot

section Degrees

variable {V : Type*} [Fintype V]

open scoped Classical in
/-- The neighbourhood of a vertex, as a `Finset`. -/
noncomputable def nbrs (G : SimpleGraph V) (u : V) : Finset V :=
  Finset.univ.filter (fun v => G.Adj u v)

open scoped Classical in
theorem mem_nbrs {G : SimpleGraph V} {u v : V} : v ∈ nbrs G u ↔ G.Adj u v := by
  simp [nbrs]

namespace Rot

variable (M : Rot V)

/-- The degree of a vertex is at most the size of the corresponding cycle of `σ`. -/
theorem card_nbrs_le_fiber (d : M.D) :
    (nbrs M.graph (M.w d)).card ≤ (cycFiber M.σ d).card := by
  classical
  refine Finset.card_le_card_of_injOn
    (fun v => if h : ∃ e, M.w e = M.w d ∧ M.w (M.α e) = v then h.choose else d) ?_ ?_
  · intro v hv
    have hadj : M.graph.Adj (M.w d) v := mem_nbrs.1 hv
    have hex : ∃ e, M.w e = M.w d ∧ M.w (M.α e) = v := hadj.2
    simp only [Finset.mem_coe, dif_pos hex]
    exact mem_cycFiber.2 (M.w_cycle _ _ hex.choose_spec.1)
  · intro v₁ h₁ v₂ h₂ heq
    have hex₁ : ∃ e, M.w e = M.w d ∧ M.w (M.α e) = v₁ := (mem_nbrs.1 h₁).2
    have hex₂ : ∃ e, M.w e = M.w d ∧ M.w (M.α e) = v₂ := (mem_nbrs.1 h₂).2
    simp only [dif_pos hex₁, dif_pos hex₂] at heq
    rw [← hex₁.choose_spec.2, ← hex₂.choose_spec.2, heq]

/-- Every simple plane map has a vertex of degree at most five. -/
theorem exists_low_degree (hs : M.Simple) : ∃ u : V, (nbrs M.graph u).card ≤ 5 := by
  classical
  by_contra hc
  push_neg at hc
  have hfib : ∀ x : M.D, 6 ≤ (cycFiber M.σ x).card :=
    fun x => le_trans (hc (M.w x)) (M.card_nbrs_le_fiber x)
  have hdeg : ∀ d, M.σ d ≠ d := by
    intro d hd
    have h := hfib d
    rw [cycFiber_of_fixed hd] at h
    simp at h
  have h1 : 6 * numCycles M.σ ≤ Fintype.card M.D := mul_numCycles_le_card _ 6 hfib
  have h2 := M.card_darts_eq
  have h3 := M.edge_bound hs hdeg
  omega

end Rot

end Degrees

end FiveColor

/-
Surgery on combinatorial maps: deleting an edge and contracting an edge.

Both operations remove the two darts of one edge from the map; the rotation is
adjusted using `skip` (and, for a contraction, a transposition which merges the
two vertex cycles).  In both cases the Euler characteristic does not decrease,
so genus zero is preserved.
-/
import RequestProject.Map

namespace FiveColor

open Equiv Equiv.Perm SimpleGraph

namespace Rot

variable {V : Type*}

/-- The pair of darts of the edge through `d₀`. -/
def edgePair (M : Rot V) (d₀ : M.D) : Finset M.D := {d₀, M.α d₀}

variable {M : Rot V}

theorem mem_edgePair {d₀ z : M.D} : z ∈ M.edgePair d₀ ↔ z = d₀ ∨ z = M.α d₀ := by
  simp [edgePair]

theorem alpha_notMem_edgePair {d₀ z : M.D} (hz : z ∉ M.edgePair d₀) :
    M.α z ∉ M.edgePair d₀ := by
  intro h
  rcases mem_edgePair.1 h with h | h
  · refine hz (mem_edgePair.2 (Or.inr ?_))
    have := congrArg M.α h
    rwa [M.α_inv] at this
  · refine hz (mem_edgePair.2 (Or.inl ?_))
    have := congrArg M.α h
    rwa [M.α_inv, M.α_inv] at this

theorem skip_alpha_apply {d₀ : M.D} (z : {z : M.D // z ∉ M.edgePair d₀}) :
    (skip M.α (M.edgePair d₀) z).1 = M.α z.1 := by
  obtain ⟨x, hx⟩ := z
  exact skip_apply_of_not_mem _ _ hx (alpha_notMem_edgePair hx)

theorem sameCycle_skip_sigma {d₀ : M.D} (z : {z : M.D // z ∉ M.edgePair d₀}) :
    M.σ.SameCycle (skip M.σ (M.edgePair d₀) z).1 z.1 :=
  sameCycle_of_skip M.σ _ (show (skip M.σ (M.edgePair d₀)).SameCycle
    (skip M.σ (M.edgePair d₀) z) z from ⟨-1, by simp⟩)

/-- Number of edges drops when an edge is removed. -/
theorem numCycles_skip_alpha_lt (d₀ : M.D) :
    numCycles (skip M.α (M.edgePair d₀)) + 1 ≤ numCycles M.α :=
  numCycles_skip_lt (x := d₀) (fun y hy => mem_edgePair.2 (M.alpha_sameCycle_iff.1 hy))

/-- A generic tool for transferring connectivity along a surgery. -/
theorem conn_transfer (M : Rot V) {D' : Type} (σ' α' : Perm D') (T : M.D → D')
    (hσ : ∀ z, Relation.ReflTransGen (fun a b => b = σ' a ∨ b = α' a) (T z) (T (M.σ z)))
    (hα : ∀ z, Relation.ReflTransGen (fun a b => b = σ' a ∨ b = α' a) (T z) (T (M.α z)))
    (hsurj : Function.Surjective T) :
    ∀ z₁ z₂ : D', Relation.ReflTransGen (fun a b => b = σ' a ∨ b = α' a) z₁ z₂ := by
  have key : ∀ a c : M.D, Relation.ReflTransGen (fun x y => y = M.σ x ∨ y = M.α x) a c →
      Relation.ReflTransGen (fun a b => b = σ' a ∨ b = α' a) (T a) (T c) := by
    intro a c h
    induction h with
    | refl => exact Relation.ReflTransGen.refl
    | tail _ hstep ih =>
        rcases hstep with rfl | rfl
        · exact ih.trans (hσ _)
        · exact ih.trans (hα _)
  intro z₁ z₂
  obtain ⟨a, rfl⟩ := hsurj z₁
  obtain ⟨b, rfl⟩ := hsurj z₂
  exact key a b (M.conn a b)

theorem reflTransGen_of_sameCycle' {D' : Type} [Fintype D'] [DecidableEq D']
    {σ' α' : Perm D'} {a b : D'} (h : σ'.SameCycle a b) :
    Relation.ReflTransGen (fun x y => y = σ' x ∨ y = α' x) a b :=
  Relation.ReflTransGen.mono (fun _ _ h => Or.inl h) (reflTransGen_of_sameCycle h)

section Delete

variable {d₀ f : M.D} (hfne : f ≠ d₀) (hfw : M.w f = M.w d₀) (hfa : M.w (M.α f) = M.w (M.α d₀))

include hfne hfw hfa

theorem del_f_notMem : f ∉ M.edgePair d₀ := by
  intro h
  rcases mem_edgePair.1 h with h | h
  · exact hfne h
  · exact M.noloop d₀ (by rw [← hfw, h])

theorem del_alpha_f_notMem : M.α f ∉ M.edgePair d₀ :=
  alpha_notMem_edgePair (del_f_notMem hfne hfw hfa)

theorem del_sigma_d₀_notMem : M.σ d₀ ∉ M.edgePair d₀ := by
  intro h
  rcases mem_edgePair.1 h with h | h
  · exact hfne ((M.w_cycle f d₀ hfw).eq_of_right (h : M.σ d₀ = d₀))
  · exact M.noloop d₀ (M.w_of_sameCycle (h ▸ (⟨1, by simp⟩ : M.σ.SameCycle d₀ (M.σ d₀)))).symm

theorem del_sigma_alpha_d₀_notMem : M.σ (M.α d₀) ∉ M.edgePair d₀ := by
  intro h
  rcases mem_edgePair.1 h with h | h
  · refine M.noloop d₀ ?_
    have hw : M.w (M.σ (M.α d₀)) = M.w (M.α d₀) := M.w_sigma _
    rw [h] at hw
    exact hw.symm
  · have hne : M.α f ≠ M.α d₀ := fun hc => hfne (by
      have := congrArg M.α hc
      rwa [M.α_inv, M.α_inv] at this)
    exact hne ((M.w_cycle (M.α f) (M.α d₀) hfa).eq_of_right (h : M.σ (M.α d₀) = M.α d₀))

/-- Every cycle of `σ` meets the complement of the deleted edge. -/
theorem del_sigma_cycle_meets (x : M.D) :
    ∃ y, M.σ.SameCycle x y ∧ y ∉ M.edgePair d₀ := by
  by_cases hx : x ∈ M.edgePair d₀
  · rcases mem_edgePair.1 hx with rfl | rfl
    · exact ⟨f, (M.w_cycle f x hfw).symm, del_f_notMem hfne hfw hfa⟩
    · exact ⟨M.α f, (M.w_cycle (M.α f) (M.α d₀) hfa).symm, del_alpha_f_notMem hfne hfw hfa⟩
  · exact ⟨x, SameCycle.rfl, hx⟩

theorem del_face_cycle_meets (x : M.D) :
    ∃ y, (M.σ * M.α * Equiv.swap d₀ (M.α d₀)).SameCycle x y ∧ y ∉ M.edgePair d₀ := by
  set ψ := M.σ * M.α * Equiv.swap d₀ (M.α d₀) with hψ
  by_cases hx : x ∈ M.edgePair d₀
  · rcases mem_edgePair.1 hx with rfl | rfl
    · refine ⟨ψ x, ⟨1, by simp⟩, ?_⟩
      have : ψ x = M.σ x := by
        simp [hψ, M.α_inv]
      rw [this]
      exact del_sigma_d₀_notMem hfne hfw hfa
    · refine ⟨ψ (M.α d₀), ⟨1, by simp⟩, ?_⟩
      have : ψ (M.α d₀) = M.σ (M.α d₀) := by
        simp [hψ, Equiv.swap_apply_right]
      rw [this]
      exact del_sigma_alpha_d₀_notMem hfne hfw hfa
  · exact ⟨x, SameCycle.rfl, hx⟩

/-- The face permutation of the map with an edge deleted. -/
theorem del_face_eq :
    skip M.σ (M.edgePair d₀) * skip M.α (M.edgePair d₀) =
      skip (M.σ * M.α * Equiv.swap d₀ (M.α d₀)) (M.edgePair d₀) := by
  refine Equiv.ext (fun z => Subtype.ext ?_)
  obtain ⟨x, hx⟩ := z
  have h1 : ∀ x, x ∉ M.edgePair d₀ →
      M.σ (M.α x) = (M.σ * M.α * Equiv.swap d₀ (M.α d₀)) x := by
    intro x hx
    have hne1 : x ≠ d₀ := fun h => hx (mem_edgePair.2 (Or.inl h))
    have hne2 : x ≠ M.α d₀ := fun h => hx (mem_edgePair.2 (Or.inr h))
    simp [Equiv.swap_apply_of_ne_of_ne hne1 hne2]
  have h2 : ∀ z, z ∈ M.edgePair d₀ →
      M.σ z = (M.σ * M.α * Equiv.swap d₀ (M.α d₀)) z := by
    intro z hz
    rcases mem_edgePair.1 hz with rfl | rfl
    · simp [M.α_inv]
    · simp [Equiv.swap_apply_right]
  have := skip_comp_eq (π := M.σ) (ρ := M.σ * M.α * Equiv.swap d₀ (M.α d₀)) (β := M.α)
    (S := M.edgePair d₀) h1 h2 (fun x hx => alpha_notMem_edgePair hx) hx
  simp only [Perm.mul_apply]
  rw [show (skip M.α (M.edgePair d₀) ⟨x, hx⟩) = ⟨M.α x, alpha_notMem_edgePair hx⟩ from
    Subtype.ext (skip_alpha_apply ⟨x, hx⟩)]
  exact this

/-- The retraction of darts used to transfer connectivity through a deletion. -/
noncomputable def delT (z : M.D) : {z : M.D // z ∉ M.edgePair d₀} :=
  if h : z ∈ M.edgePair d₀ then
    (if z = d₀ then ⟨f, del_f_notMem hfne hfw hfa⟩
      else ⟨M.α f, del_alpha_f_notMem hfne hfw hfa⟩)
  else ⟨z, h⟩

theorem delT_of_notMem {z : M.D} (hz : z ∉ M.edgePair d₀) :
    delT hfne hfw hfa z = ⟨z, hz⟩ := by
  simp only [delT, dif_neg hz]

theorem delT_d₀ : delT hfne hfw hfa d₀ = ⟨f, del_f_notMem hfne hfw hfa⟩ := by
  simp only [delT, dif_pos (mem_edgePair.2 (Or.inl rfl)), if_true]

theorem delT_alpha_d₀ :
    delT hfne hfw hfa (M.α d₀) = ⟨M.α f, del_alpha_f_notMem hfne hfw hfa⟩ := by
  simp only [delT, dif_pos (mem_edgePair.2 (Or.inr rfl)), if_neg (M.α_ne d₀)]

theorem w_delT (z : M.D) : M.w (delT hfne hfw hfa z).1 = M.w z := by
  by_cases hz : z ∈ M.edgePair d₀
  · rcases mem_edgePair.1 hz with rfl | rfl
    · rw [delT_d₀]; exact hfw
    · rw [delT_alpha_d₀]; exact hfa
  · rw [delT_of_notMem hfne hfw hfa hz]

theorem delT_surjective : Function.Surjective (delT hfne hfw hfa) := by
  intro z
  exact ⟨z.1, by rw [delT_of_notMem hfne hfw hfa z.2]⟩

/-- Deleting an edge which has a parallel companion. -/
noncomputable def deleteEdge : Rot V where
  D := {z : M.D // z ∉ M.edgePair d₀}
  σ := skip M.σ (M.edgePair d₀)
  α := skip M.α (M.edgePair d₀)
  w := fun z => M.w z.1
  α_inv := fun z => Subtype.ext (by rw [skip_alpha_apply, skip_alpha_apply, M.α_inv])
  w_sigma := fun z => M.w_of_sameCycle (sameCycle_skip_sigma z)
  w_surj := by
    intro u
    obtain ⟨d, rfl⟩ := M.w_surj u
    by_cases hd : d ∈ M.edgePair d₀
    · rcases mem_edgePair.1 hd with rfl | rfl
      · exact ⟨⟨f, del_f_notMem hfne hfw hfa⟩, hfw⟩
      · exact ⟨⟨M.α f, del_alpha_f_notMem hfne hfw hfa⟩, hfa⟩
    · exact ⟨⟨d, hd⟩, rfl⟩
  w_cycle := fun d e h => skip_sameCycle _ _ (M.w_cycle _ _ h)
  noloop := fun d => by
    show M.w ((skip M.α (M.edgePair d₀) d).1) ≠ M.w d.1
    rw [skip_alpha_apply]
    exact M.noloop d.1
  conn := by
    classical
    refine conn_transfer M _ _ (delT hfne hfw hfa) ?_ ?_ (delT_surjective hfne hfw hfa)
    · -- σ-steps
      intro z
      refine reflTransGen_of_sameCycle' (skip_sameCycle M.σ _ ?_)
      refine M.w_cycle _ _ ?_
      rw [w_delT, w_delT, M.w_sigma]
    · -- α-steps
      intro z
      refine Relation.ReflTransGen.single (Or.inr ?_)
      by_cases hz : z ∈ M.edgePair d₀
      · rcases mem_edgePair.1 hz with rfl | rfl
        · rw [delT_d₀, delT_alpha_d₀]
          refine Subtype.ext ?_
          rw [skip_alpha_apply]
        · rw [delT_alpha_d₀, M.α_inv, delT_d₀]
          refine Subtype.ext ?_
          rw [skip_alpha_apply, M.α_inv]
      · rw [delT_of_notMem hfne hfw hfa hz,
          delT_of_notMem hfne hfw hfa (alpha_notMem_edgePair hz)]
        refine Subtype.ext ?_
        rw [skip_alpha_apply]
  euler := by
    have hE := numCycles_skip_alpha_lt (M := M) d₀
    have hV : numCycles M.σ ≤ numCycles (skip M.σ (M.edgePair d₀)) :=
      numCycles_le_skip _ _ (del_sigma_cycle_meets hfne hfw hfa)
    have hF : numCycles (M.σ * M.α * Equiv.swap d₀ (M.α d₀)) ≤
        numCycles (skip (M.σ * M.α * Equiv.swap d₀ (M.α d₀)) (M.edgePair d₀)) :=
      numCycles_le_skip _ _ (del_face_cycle_meets hfne hfw hfa)
    have hF2 := numCycles_sub_one_le_mul_swap (M.σ * M.α) d₀ (M.α d₀)
    have he := M.euler
    rw [del_face_eq hfne hfw hfa]
    omega

theorem w_alpha_delT (z : M.D) :
    M.w (M.α (delT hfne hfw hfa z).1) = M.w (M.α z) := by
  by_cases hz : z ∈ M.edgePair d₀
  · rcases mem_edgePair.1 hz with rfl | rfl
    · rw [delT_d₀]; exact hfa
    · rw [delT_alpha_d₀, M.α_inv, M.α_inv]; exact hfw
  · rw [delT_of_notMem hfne hfw hfa hz]

theorem deleteEdge_w (z : {z : M.D // z ∉ M.edgePair d₀}) :
    (deleteEdge hfne hfw hfa).w z = M.w z.1 := rfl

theorem deleteEdge_alpha_w (z : {z : M.D // z ∉ M.edgePair d₀}) :
    (deleteEdge hfne hfw hfa).w ((deleteEdge hfne hfw hfa).α z) = M.w (M.α z.1) := by
  show M.w ((skip M.α (M.edgePair d₀) z).1) = _
  rw [skip_alpha_apply]

/-- Deleting a parallel edge does not change the underlying graph. -/
theorem deleteEdge_graph_ge : M.graph ≤ (deleteEdge hfne hfw hfa).graph := by
  rintro u v ⟨hne, d, rfl, rfl⟩
  refine ⟨hne, delT hfne hfw hfa d, ?_, ?_⟩
  · rw [deleteEdge_w, w_delT]
  · rw [deleteEdge_alpha_w, w_alpha_delT]

theorem deleteEdge_card_lt :
    Fintype.card (deleteEdge hfne hfw hfa).D < Fintype.card M.D := by
  classical
  show Fintype.card {z : M.D // z ∉ M.edgePair d₀} < Fintype.card M.D
  have h1 : Fintype.card {z : M.D // z ∉ M.edgePair d₀}
      = Fintype.card M.D - Fintype.card {z : M.D // z ∈ M.edgePair d₀} := by
    simp [Fintype.card_subtype_compl (p := fun z : M.D => z ∈ M.edgePair d₀)]
  have h2 : Fintype.card {z : M.D // z ∈ M.edgePair d₀} = (M.edgePair d₀).card :=
    Fintype.card_coe _
  have h3 : Fintype.card {z : M.D // z ∈ M.edgePair d₀} ≤ Fintype.card M.D :=
    Fintype.card_subtype_le _
  have h4 : 0 < (M.edgePair d₀).card :=
    Finset.card_pos.2 ⟨d₀, mem_edgePair.2 (Or.inl rfl)⟩
  omega

end Delete

/-- Every map can be turned into a simple map with at least the same graph, by
repeatedly deleting parallel edges. -/
theorem exists_simple_aux :
    ∀ (n : ℕ) (M : Rot V), Fintype.card M.D = n →
      ∃ N : Rot V, N.Simple ∧ M.graph ≤ N.graph := by
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    intro M hM
    by_cases hs : M.Simple
    · exact ⟨M, hs, le_rfl⟩
    · have hs' : ∃ d e, M.w d = M.w e ∧ M.w (M.α d) = M.w (M.α e) ∧ d ≠ e := by
        by_contra hc
        push_neg at hc
        exact hs (fun d e h1 h2 => hc d e h1 h2)
      obtain ⟨d, e, hw, ha, hne⟩ := hs'
      obtain ⟨N, hN, hle⟩ := ih (Fintype.card (deleteEdge hne hw ha).D)
        (by rw [← hM]; exact deleteEdge_card_lt hne hw ha) _ rfl
      exact ⟨N, hN, le_trans (deleteEdge_graph_ge hne hw ha) hle⟩

theorem exists_simple (M : Rot V) : ∃ N : Rot V, N.Simple ∧ M.graph ≤ N.graph :=
  exists_simple_aux _ M rfl

end Rot

end FiveColor

