/-
Cycle counting toolkit for permutations of a finite type.

This file develops the combinatorial facts about numbers of cycles (orbits) of
permutations that are needed for Euler's formula for combinatorial maps:

* `numCycles π` : the number of cycles of a permutation `π`;
* `skip π S` : the permutation of the complement of `S` obtained from `π` by
  "skipping over" the elements of `S`;
* the effect on the number of cycles of multiplying by a transposition.
-/
import Mathlib

namespace FiveColor

open Equiv Equiv.Perm

variable {D : Type*} [Fintype D] [DecidableEq D]

/-- The class of `x` in the quotient by "being in the same cycle". -/
abbrev cyc (π : Perm D) (x : D) : Quotient (SameCycle.setoid π) :=
  Quotient.mk (SameCycle.setoid π) x

omit [Fintype D] [DecidableEq D] in
theorem cyc_eq_iff {π : Perm D} {x y : D} : cyc π x = cyc π y ↔ π.SameCycle x y :=
  Quotient.eq (r := SameCycle.setoid π)

/-- The number of cycles (orbits) of a permutation of a finite type. -/
noncomputable def numCycles (π : Perm D) : ℕ := Nat.card (Quotient (SameCycle.setoid π))

omit [Fintype D] [DecidableEq D] in
theorem cyc_surjective (π : Perm D) : Function.Surjective (cyc π) := by
  intro c; exact ⟨c.out, c.out_eq⟩

/-- If every `ρ`-cycle is contained in a `π`-cycle then `π` has at most as many
cycles as `ρ`. -/
theorem numCycles_le_of_imp {π ρ : Perm D}
    (h : ∀ x y, ρ.SameCycle x y → π.SameCycle x y) : numCycles π ≤ numCycles ρ := by
  refine Nat.card_le_card_of_surjective (f := fun c : Quotient (SameCycle.setoid ρ) =>
      Quotient.liftOn c (fun x => cyc π x) (fun x y hxy => cyc_eq_iff.2 (h x y hxy))) ?_
  intro c
  obtain ⟨x, rfl⟩ := cyc_surjective π c
  exact ⟨cyc ρ x, rfl⟩

/-- From a step-wise statement to a statement about whole cycles. -/
theorem sameCycle_of_forall_step {π ρ : Perm D} (h : ∀ x, ρ.SameCycle x (π x)) :
    ∀ x y, π.SameCycle x y → ρ.SameCycle x y := by
  have key : ∀ (n : ℕ) (x : D), ρ.SameCycle x ((π ^ n) x) := by
    intro n
    induction n with
    | zero => intro x; exact SameCycle.rfl
    | succ n ih =>
        intro x
        have h2 : ρ.SameCycle ((π ^ n) x) (π ((π ^ n) x)) := h _
        have he : ((π ^ (n + 1)) x) = π ((π ^ n) x) := by rw [pow_succ']; rfl
        rw [he]
        exact (ih x).trans h2
  intro x y hxy
  obtain ⟨n, hn⟩ := hxy.exists_nat_pow_eq
  rw [← hn]
  exact key n x

/-- A `SameCycle` relation yields reachability by forward steps (finite type). -/
theorem reflTransGen_of_sameCycle {π : Perm D} {x y : D} (h : π.SameCycle x y) :
    Relation.ReflTransGen (fun a b => b = π a) x y := by
  obtain ⟨n, hn⟩ := h.exists_nat_pow_eq
  subst hn
  clear h
  induction n with
  | zero => exact Relation.ReflTransGen.refl
  | succ n ih =>
      refine ih.tail ?_
      rw [pow_succ']
      rfl

section Skip

theorem skip_exists (π : Perm D) (S : Finset D) (x : D) (hx : x ∉ S) :
    ∃ k : ℕ, 1 ≤ k ∧ (π ^ k) x ∉ S := by
  refine ⟨orderOf π, orderOf_pos π, ?_⟩
  rw [pow_orderOf_eq_one]
  simpa using hx

variable (π : Perm D) (S : Finset D)

/-- The number of steps needed to skip out of `S`. -/
noncomputable def skipIdx (x : {z : D // z ∉ S}) : ℕ :=
  Nat.find (skip_exists π S x.1 x.2)

theorem skipIdx_pos (x : {z : D // z ∉ S}) : 1 ≤ skipIdx π S x :=
  (Nat.find_spec (skip_exists π S x.1 x.2)).1

theorem skipIdx_not_mem (x : {z : D // z ∉ S}) : (π ^ (skipIdx π S x)) x.1 ∉ S :=
  (Nat.find_spec (skip_exists π S x.1 x.2)).2

theorem skipIdx_min {x : {z : D // z ∉ S}} {k : ℕ} (hk : 1 ≤ k) (hk' : k < skipIdx π S x) :
    (π ^ k) x.1 ∈ S := by
  by_contra hc
  have := Nat.find_min' (skip_exists π S x.1 x.2) (⟨hk, hc⟩ : 1 ≤ k ∧ (π ^ k) x.1 ∉ S)
  simp only [skipIdx] at hk'
  omega

/-- The underlying function of `skip`. -/
noncomputable def skipFun (x : {z : D // z ∉ S}) : {z : D // z ∉ S} :=
  ⟨(π ^ (skipIdx π S x)) x.1, skipIdx_not_mem π S x⟩

theorem skipFun_aux {x y : {z : D // z ∉ S}}
    (h : (π ^ (skipIdx π S x)) x.1 = (π ^ (skipIdx π S y)) y.1)
    (hlt : skipIdx π S x < skipIdx π S y) : False := by
  have hpx := skipIdx_pos π S x
  have key : (π ^ (skipIdx π S y - skipIdx π S x)) y.1 = x.1 := by
    apply (Equiv.injective (π ^ (skipIdx π S x)))
    rw [← Perm.mul_apply, ← pow_add,
      show skipIdx π S x + (skipIdx π S y - skipIdx π S x) = skipIdx π S y by omega]
    exact h.symm
  have hmem := skipIdx_min π S (x := y) (k := skipIdx π S y - skipIdx π S x)
    (by omega) (by omega)
  rw [key] at hmem
  exact x.2 hmem

theorem skipFun_injective : Function.Injective (skipFun π S) := by
  intro x y hxy
  have hx : (π ^ (skipIdx π S x)) x.1 = (π ^ (skipIdx π S y)) y.1 := congrArg Subtype.val hxy
  rcases lt_trichotomy (skipIdx π S x) (skipIdx π S y) with h | h | h
  · exact absurd (skipFun_aux π S hx h) (by simp)
  · refine Subtype.ext ?_
    rw [h] at hx
    exact (Equiv.injective (π ^ (skipIdx π S y))) hx
  · exact absurd (skipFun_aux π S hx.symm h) (by simp)

/-- `π` with the elements of `S` skipped over: a permutation of the complement of `S`. -/
noncomputable def skip : Perm {z : D // z ∉ S} :=
  Equiv.ofBijective (skipFun π S) ((Finite.injective_iff_bijective).1 (skipFun_injective π S))

theorem skip_apply (x : {z : D // z ∉ S}) :
    (skip π S x).1 = (π ^ (skipIdx π S x)) x.1 := rfl

theorem skip_apply_of_not_mem {x : D} (hx : x ∉ S) (hπx : π x ∉ S) :
    (skip π S ⟨x, hx⟩).1 = π x := by
  have h1 : skipIdx π S ⟨x, hx⟩ = 1 := by
    have hle : skipIdx π S ⟨x, hx⟩ ≤ 1 := Nat.find_min' _ ⟨le_refl 1, by simpa using hπx⟩
    have := skipIdx_pos π S ⟨x, hx⟩
    omega
  rw [skip_apply, h1, pow_one]

theorem sameCycle_of_skip {x y : {z : D // z ∉ S}} (h : (skip π S).SameCycle x y) :
    π.SameCycle x.1 y.1 := by
  have step : ∀ z : {w : D // w ∉ S}, π.SameCycle z.1 (skip π S z).1 := by
    intro z
    exact ⟨skipIdx π S z, by rw [skip_apply]; simp⟩
  obtain ⟨n, hn⟩ := h.exists_nat_pow_eq
  subst hn
  clear h
  induction n with
  | zero => exact SameCycle.rfl
  | succ n ih =>
      have he : ((skip π S) ^ (n + 1)) x = skip π S (((skip π S) ^ n) x) := by
        rw [pow_succ']; rfl
      rw [he]
      exact ih.trans (step _)

theorem skip_sameCycle {x y : {z : D // z ∉ S}} (h : π.SameCycle x.1 y.1) :
    (skip π S).SameCycle x y := by
  obtain ⟨n, hn⟩ := h.exists_nat_pow_eq
  clear h
  induction n using Nat.strong_induction_on generalizing x with
  | _ n ih =>
    rcases Nat.eq_zero_or_pos n with rfl | hn0
    · simp only [pow_zero, Perm.coe_one, id_eq] at hn
      exact (Subtype.ext hn : x = y) ▸ SameCycle.rfl
    · have hkpos : 1 ≤ skipIdx π S x := skipIdx_pos π S x
      have hkn : skipIdx π S x ≤ n := by
        by_contra hc
        push_neg at hc
        have := skipIdx_min π S (x := x) (k := n) hn0 (by omega)
        rw [hn] at this
        exact y.2 this
      have hx' : ((π ^ (n - skipIdx π S x)) (skip π S x).1) = y.1 := by
        rw [skip_apply, ← Perm.mul_apply, ← pow_add, Nat.sub_add_cancel hkn]
        exact hn
      have h2 := ih (n - skipIdx π S x) (by omega) (x := skip π S x) hx'
      exact (show (skip π S).SameCycle x (skip π S x) from ⟨1, by simp⟩).trans h2

theorem numCycles_skip_le : numCycles (skip π S) ≤ numCycles π := by
  refine Nat.card_le_card_of_injective
    (f := fun c : Quotient (SameCycle.setoid (skip π S)) =>
      Quotient.liftOn c (fun x => cyc π x.1)
        (fun x y hxy => cyc_eq_iff.2 (sameCycle_of_skip π S hxy))) ?_
  intro c₁ c₂ h
  induction c₁ using Quotient.inductionOn with
  | _ x =>
    induction c₂ using Quotient.inductionOn with
    | _ y =>
      simp only [Quotient.liftOn_mk] at h
      exact Quotient.sound (skip_sameCycle π S (cyc_eq_iff.1 h))

/-- If no cycle of `π` is contained in `S`, then skipping `S` does not decrease the
number of cycles. -/
theorem numCycles_le_skip (h : ∀ x : D, ∃ y, π.SameCycle x y ∧ y ∉ S) :
    numCycles π ≤ numCycles (skip π S) := by
  refine Nat.card_le_card_of_surjective
    (f := fun c : Quotient (SameCycle.setoid (skip π S)) =>
      Quotient.liftOn c (fun x => cyc π x.1)
        (fun x y hxy => cyc_eq_iff.2 (sameCycle_of_skip π S hxy))) ?_
  intro c
  obtain ⟨x, rfl⟩ := cyc_surjective π c
  obtain ⟨y, hxy, hy⟩ := h x
  exact ⟨Quotient.mk _ ⟨y, hy⟩, by simpa using cyc_eq_iff.2 hxy.symm⟩

theorem skipIdx_eq_of_chain {π : Perm D} {S : Finset D} {x : D} (hx : x ∉ S) {k : ℕ} (hk : 1 ≤ k)
    (hout : (π ^ k) x ∉ S) (hmid : ∀ j, 1 ≤ j → j < k → (π ^ j) x ∈ S) :
    skipIdx π S ⟨x, hx⟩ = k := by
  have hle : skipIdx π S ⟨x, hx⟩ ≤ k := Nat.find_min' _ ⟨hk, hout⟩
  by_contra hne
  have hlt : skipIdx π S ⟨x, hx⟩ < k := by omega
  exact (skipIdx_not_mem π S ⟨x, hx⟩) (hmid _ (skipIdx_pos π S ⟨x, hx⟩) hlt)

theorem skip_eq_of_chain {π : Perm D} {S : Finset D} {x : D} (hx : x ∉ S) {k : ℕ} (hk : 1 ≤ k)
    (hout : (π ^ k) x ∉ S) (hmid : ∀ j, 1 ≤ j → j < k → (π ^ j) x ∈ S) :
    (skip π S ⟨x, hx⟩).1 = (π ^ k) x := by
  rw [skip_apply, skipIdx_eq_of_chain hx hk hout hmid]

/-- Comparison of skipped permutations: if `π ∘ β = ρ` off `S` and `π = ρ` on `S`,
then skipping `S` gives the same permutation. -/
theorem skip_comp_eq {π ρ β : Perm D} {S : Finset D}
    (h1 : ∀ x, x ∉ S → π (β x) = ρ x) (h2 : ∀ z, z ∈ S → π z = ρ z)
    (h3 : ∀ x, x ∉ S → β x ∉ S) {x : D} (hx : x ∉ S) :
    (skip π S ⟨β x, h3 x hx⟩).1 = (skip ρ S ⟨x, hx⟩).1 := by
  set k := skipIdx ρ S ⟨x, hx⟩ with hk
  have hkpos : 1 ≤ k := skipIdx_pos ρ S ⟨x, hx⟩
  have hkout : (ρ ^ k) x ∉ S := skipIdx_not_mem ρ S ⟨x, hx⟩
  have hkmid : ∀ j, 1 ≤ j → j < k → (ρ ^ j) x ∈ S := fun j hj hjk => skipIdx_min ρ S hj hjk
  have key : ∀ j, 1 ≤ j → j ≤ k → (π ^ j) (β x) = (ρ ^ j) x := by
    intro j
    induction j with
    | zero => intro h; omega
    | succ n ih =>
        intro _ hnk
        rcases Nat.eq_zero_or_pos n with rfl | hn
        · simp only [zero_add, pow_one]
          exact h1 x hx
        · have hstep := ih hn (by omega)
          have hmem : (ρ ^ n) x ∈ S := hkmid n hn (by omega)
          have e1 : (π ^ (n + 1)) (β x) = π ((π ^ n) (β x)) := by rw [pow_succ']; rfl
          have e2 : (ρ ^ (n + 1)) x = ρ ((ρ ^ n) x) := by rw [pow_succ']; rfl
          rw [e1, e2, hstep, h2 _ hmem]
  rw [skip_eq_of_chain (h3 x hx) hkpos (by rw [key k hkpos le_rfl]; exact hkout)
    (fun j hj hjk => by rw [key j hj hjk.le]; exact hkmid j hj hjk), key k hkpos le_rfl,
    skip_apply]

/-- If some whole cycle of `π` is contained in `S`, skipping `S` loses at least one
cycle. -/
theorem numCycles_skip_lt {π : Perm D} {S : Finset D} {x : D}
    (hx : ∀ y, π.SameCycle y x → y ∈ S) : numCycles (skip π S) + 1 ≤ numCycles π := by
  classical
  have hinj : Function.Injective
      (fun c : Quotient (SameCycle.setoid (skip π S)) =>
        (⟨Quotient.liftOn c (fun z => cyc π z.1)
          (fun z z' h => cyc_eq_iff.2 (sameCycle_of_skip π S h)), by
            induction c using Quotient.inductionOn with
            | _ z =>
              simp only [Quotient.liftOn_mk]
              intro hc
              exact z.2 (hx z.1 (cyc_eq_iff.1 hc))⟩ :
          {c : Quotient (SameCycle.setoid π) // c ≠ cyc π x})) := by
    intro c₁ c₂ h
    induction c₁ using Quotient.inductionOn with
    | _ z₁ =>
      induction c₂ using Quotient.inductionOn with
      | _ z₂ =>
        have h' : cyc π z₁.1 = cyc π z₂.1 := congrArg Subtype.val h
        exact Quotient.sound (skip_sameCycle π S (cyc_eq_iff.1 h'))
  have hcard := Nat.card_le_card_of_injective _ hinj
  have hnc : Nat.card (Quotient (SameCycle.setoid (skip π S))) = numCycles (skip π S) := rfl
  rw [hnc] at hcard
  have hsub : Nat.card {c : Quotient (SameCycle.setoid π) // c ≠ cyc π x} = numCycles π - 1 := by
    simp only [numCycles]
    rw [Nat.card_eq_fintype_card, Nat.card_eq_fintype_card]
    simpa using Fintype.card_subtype_compl
      (p := fun c : Quotient (SameCycle.setoid π) => c = cyc π x)
  have hpos : 1 ≤ numCycles π := by
    have hne : Nonempty (Quotient (SameCycle.setoid π)) := ⟨cyc π x⟩
    simp only [numCycles]
    exact Nat.one_le_iff_ne_zero.2 (by simp)
  omega

end Skip

section Transposition

/-- Multiplying by a transposition merges or splits a cycle; in particular the number
of cycles drops by at most one. -/
theorem numCycles_sub_one_le_mul_swap (π : Perm D) (a b : D) :
    numCycles π - 1 ≤ numCycles (π * Equiv.swap a b) := by
  classical
  set ρ := π * Equiv.swap a b with hρ
  set g : D → Quotient (SameCycle.setoid π) :=
    fun x => if π.SameCycle x b then cyc π a else cyc π x with hg
  have hstep : ∀ x, g (ρ x) = g x := by
    intro x
    by_cases hxa : x = a
    · rw [hxa]
      have h1 : ρ a = π b := by simp [hρ]
      rw [h1]
      have hsc : π.SameCycle (π b) b := ⟨-1, by simp⟩
      simp only [hg, if_pos hsc]
      by_cases h : π.SameCycle a b <;> simp [h]
    · by_cases hxb : x = b
      · rw [hxb]
        have h1 : ρ b = π a := by simp [hρ]
        rw [h1]
        have hbb : π.SameCycle b b := SameCycle.rfl
        simp only [hg, if_pos hbb]
        by_cases h : π.SameCycle (π a) b
        · simp [h]
        · simp only [if_neg h]
          exact (cyc_eq_iff.2 ⟨-1, by simp⟩ : cyc π (π a) = cyc π a)
      · have h1 : ρ x = π x := by
          simp [hρ, Equiv.swap_apply_of_ne_of_ne hxa hxb]
        rw [h1]
        have hs : π.SameCycle (π x) b ↔ π.SameCycle x b := sameCycle_apply_left
        by_cases h : π.SameCycle x b
        · simp [hg, h, hs.2 h]
        · have h' : ¬ π.SameCycle (π x) b := fun hc => h (hs.1 hc)
          simp only [hg, if_neg h, if_neg h']
          exact cyc_eq_iff.2 ⟨-1, by simp⟩
  have hconst : ∀ x y, ρ.SameCycle x y → g x = g y := by
    intro x y hxy
    obtain ⟨n, hn⟩ := hxy.exists_nat_pow_eq
    subst hn
    clear hxy
    induction n with
    | zero => simp
    | succ n ih =>
        have h1 : ((ρ ^ (n + 1)) x) = ρ ((ρ ^ n) x) := by rw [pow_succ']; rfl
        rw [h1, hstep]
        exact ih
  set ĝ : Quotient (SameCycle.setoid ρ) → Quotient (SameCycle.setoid π) :=
    fun c => Quotient.liftOn c g (fun x y h => hconst x y h) with hĝ
  have hrange : ∀ c : Quotient (SameCycle.setoid π), c ≠ cyc π b →
      ∃ e : Quotient (SameCycle.setoid ρ), ĝ e = c := by
    intro c hc
    obtain ⟨x, rfl⟩ := cyc_surjective π c
    have hxb : ¬ π.SameCycle x b := fun h => hc (cyc_eq_iff.2 h)
    exact ⟨Quotient.mk _ x, by simp [hĝ, hg, hxb]⟩
  choose ψ hψ using hrange
  have hinj : Function.Injective
      (fun c : {c : Quotient (SameCycle.setoid π) // c ≠ cyc π b} => ψ c.1 c.2) := by
    intro c₁ c₂ h
    have h2 := congrArg ĝ h
    simp only at h2
    rw [hψ, hψ] at h2
    exact Subtype.ext h2
  have hcard : Nat.card {c : Quotient (SameCycle.setoid π) // c ≠ cyc π b} ≤ numCycles ρ :=
    Nat.card_le_card_of_injective _ hinj
  have hsub : Nat.card {c : Quotient (SameCycle.setoid π) // c ≠ cyc π b} = numCycles π - 1 := by
    classical
    simp only [numCycles]
    rw [Nat.card_eq_fintype_card, Nat.card_eq_fintype_card]
    simpa using Fintype.card_subtype_compl
      (p := fun c : Quotient (SameCycle.setoid π) => c = cyc π b)
  omega

/-- In the "merge" case the two swapped points end up in a common cycle. -/
theorem sameCycle_mul_swap_self {π : Perm D} {a b : D} (hab : ¬ π.SameCycle a b) :
    (π * Equiv.swap a b).SameCycle a b := by
  classical
  set ρ := π * Equiv.swap a b with hρ
  have hex : ∃ k : ℕ, 1 ≤ k ∧ (π ^ k) b = b := by
    refine ⟨orderOf π, orderOf_pos π, ?_⟩
    rw [pow_orderOf_eq_one]; rfl
  set m := Nat.find hex with hm
  have hmpos : 1 ≤ m := (Nat.find_spec hex).1
  have hmb : (π ^ m) b = b := (Nat.find_spec hex).2
  have hmin : ∀ j, 1 ≤ j → j < m → (π ^ j) b ≠ b := by
    intro j hj hjm hc
    have := Nat.find_min' hex (⟨hj, hc⟩ : 1 ≤ j ∧ (π ^ j) b = b)
    simp only [← hm] at this
    omega
  have hnea : ∀ j : ℕ, (π ^ j) b ≠ a := by
    intro j hc
    exact hab ⟨-(j : ℤ), by rw [zpow_neg, zpow_natCast, ← hc]; simp⟩
  have key : ∀ k : ℕ, k ≤ m - 1 → (ρ ^ k) (π b) = (π ^ k) (π b) := by
    intro k
    induction k with
    | zero => simp
    | succ k ih =>
        intro hk
        have hk' : k ≤ m - 1 := by omega
        have h1 : (ρ ^ (k + 1)) (π b) = ρ ((ρ ^ k) (π b)) := by rw [pow_succ']; rfl
        rw [h1, ih hk']
        have h2 : (π ^ k) (π b) = (π ^ (k + 1)) b := by
          rw [← Perm.mul_apply, ← pow_succ]
        rw [h2]
        have hnb : (π ^ (k + 1)) b ≠ b := hmin (k + 1) (by omega) (by omega)
        have hna : (π ^ (k + 1)) b ≠ a := hnea (k + 1)
        have h3 : ρ ((π ^ (k + 1)) b) = π ((π ^ (k + 1)) b) := by
          simp [hρ, Equiv.swap_apply_of_ne_of_ne hna hnb]
        rw [h3, ← Perm.mul_apply, ← Perm.mul_apply, ← pow_succ, ← pow_succ']
  have hρa : ρ a = π b := by simp [hρ]
  refine ⟨(m : ℤ), ?_⟩
  rw [zpow_natCast]
  have h1 : (ρ ^ m) a = (ρ ^ (m - 1)) (ρ a) := by
    rw [← Perm.mul_apply, ← pow_succ]
    congr 2
    omega
  rw [h1, hρa, key (m - 1) le_rfl]
  have h2 : (π ^ (m - 1)) (π b) = (π ^ m) b := by
    rw [← Perm.mul_apply, ← pow_succ]
    congr 2
    omega
  rw [h2, hmb]

/-- In the "merge" case cycles of `π` are contained in cycles of `π * swap a b`. -/
theorem sameCycle_mul_swap {π : Perm D} {a b : D} (hab : ¬ π.SameCycle a b) {x y : D}
    (h : π.SameCycle x y) : (π * Equiv.swap a b).SameCycle x y := by
  classical
  set ρ := π * Equiv.swap a b with hρ
  have hab' : ρ.SameCycle a b := sameCycle_mul_swap_self hab
  refine sameCycle_of_forall_step (π := π) (ρ := ρ) ?_ x y h
  intro z
  by_cases hza : z = a
  · rw [hza]
    have hb : ρ b = π a := by simp [hρ]
    have h2 : ρ.SameCycle b (π a) := hb ▸ (⟨1, by simp⟩ : ρ.SameCycle b (ρ b))
    exact hab'.trans h2
  · by_cases hzb : z = b
    · rw [hzb]
      have ha : ρ a = π b := by simp [hρ]
      have h2 : ρ.SameCycle a (π b) := ha ▸ (⟨1, by simp⟩ : ρ.SameCycle a (ρ a))
      exact hab'.symm.trans h2
    · have h1 : ρ z = π z := by simp [hρ, Equiv.swap_apply_of_ne_of_ne hza hzb]
      exact ⟨1, by simp [h1]⟩

end Transposition

end FiveColor

