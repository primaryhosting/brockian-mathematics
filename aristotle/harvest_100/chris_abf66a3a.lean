/-- Trivial projector is self-adjoint -/
theorem P_trivial_selfAdjoint (ρ : UnitaryRep H) : IsSelfAdjoint (P_trivial ρ) := by
  rw [ IsSelfAdjoint ];
  -- By definition of $P_{\text{trivial}}$, we have
  have hP_trivial : P_trivial ρ = (1 / 10 : ℂ) • ∑ g : D5, ρ.toCLM g := by
    exact?;
  -- By definition of the adjoint, we know that star (ρ.toCLM g) = ρ.toCLM g⁻¹.
  have h_adj : ∀ g : D5, star (ρ.toCLM g) = ρ.toCLM g⁻¹ := by
    exact?;
  -- By changing the variable of summation from $g$ to $g^{-1}$, we can show that the sum is equal to itself.
  have h_sum_inv : ∑ g : D5, ρ.toCLM g⁻¹ = ∑ g : D5, ρ.toCLM g := by
    exact Equiv.sum_comp ( Equiv.inv _ ) fun g => ρ.toCLM g;
  simp_all +decide [ Finset.mul_sum _ _ _, Finset.sum_mul _ _ _, smul_smul, mul_comm ]

lemma chi_inverse (irrep : D5Irrep) (g : D5) : χ_of_elem irrep g⁻¹ = star (χ_of_elem irrep g) := by
  -- By definition of χ_of_elem, we know that it is real.
  have h_real : ∀ g : D5, χ_of_elem irrep g = star (χ_of_elem irrep g) := by
    have h_real : ∀ c : D5ConjClass, χ irrep c = star (χ irrep c) := by
      intro c;
      fin_cases irrep <;> fin_cases c <;> norm_num [ χ ];
    exact fun g => h_real _;
  have h_conj_eq : ∀ g : D5, χ_of_elem irrep (g⁻¹) = χ_of_elem irrep g := by
    intros g
    induction' g with g ih;
    · fin_cases g <;> rfl;
    · cases ih ; rfl;
  grind
