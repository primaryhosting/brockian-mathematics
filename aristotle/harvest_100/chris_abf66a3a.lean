theorem sum_chi_golden_proven : ∑ g : D5, χ_of_elem .golden g = 0 := by
  -- Apply the lemma that states the sum of the golden character over all elements of D5 is zero.
  apply sum_chi_golden

def golden_convolution_sum (k : D5) : ℂ :=
  ∑ g : D5, χ_of_elem .golden g * χ_of_elem .golden (g⁻¹ * k)

theorem golden_convolution_r0 : golden_convolution_sum (DihedralGroup.r 0) = 5 * χ_of_elem .golden (DihedralGroup.r 0) := by
  -- Apply the golden_convolution lemma with k = r0.
  apply golden_convolution

lemma golden_convolution_C0 :
    ∑ g : D5, χ_of_elem .golden g * χ_of_elem .golden (g⁻¹ * 1) = 5 * χ_of_elem .golden 1 := by
      -- Apply the golden convolution theorem with k = 1.
      apply golden_convolution

lemma golden_convolution_C1 :
    ∑ g : D5, χ_of_elem .golden g * χ_of_elem .golden (g⁻¹ * DihedralGroup.r 1) = 5 * χ_of_elem .golden (DihedralGroup.r 1) := by
      -- Apply the golden_convolution theorem with k = DihedralGroup.r 1.
      apply golden_convolution

lemma golden_convolution_C2 :
    ∑ g : D5, χ_of_elem .golden g * χ_of_elem .golden (g⁻¹ * DihedralGroup.r 2) = 5 * χ_of_elem .golden (DihedralGroup.r 2) := by
      -- Apply the golden convolution theorem with k = r2.
      apply golden_convolution

lemma golden_convolution_C3 :
    ∑ g : D5, χ_of_elem .golden g * χ_of_elem .golden (g⁻¹ * DihedralGroup.sr 0) = 5 * χ_of_elem .golden (DihedralGroup.sr 0) := by
      -- Apply the hypothesis `golden_convolution` with `k = DihedralGroup.sr 0`.
      apply golden_convolution

lemma chi_golden_class_fun (g h : D5) : χ_of_elem .golden (h * g * h⁻¹) = χ_of_elem .golden g := by
  -- By the properties of the character function, we know that χ_of_elem .golden (h * g * h⁻¹) = χ_of_elem .golden g because characters are class functions.
  have h_char_conj : ∀ g h : D5, conjClass (h * g * h⁻¹) = conjClass g := by
    decide +revert;
  exact congr_arg ( fun x => χ D5Irrep.golden x ) ( h_char_conj g h )

lemma golden_convolution_invar (k x : D5) :
    (∑ g : D5, χ_of_elem .golden g * χ_of_elem .golden (g⁻¹ * (x * k * x⁻¹))) =
    ∑ g : D5, χ_of_elem .golden g * χ_of_elem .golden (g⁻¹ * k) := by
      -- By the properties of the conjugation and the fact that the sum is over a finite group, we can change variables in the sum.
      have h_conj_equiv : ∀ x : D5, ∑ g : D5, χ_of_elem D5Irrep.golden g * χ_of_elem D5Irrep.golden (g⁻¹ * (x * k * x⁻¹)) = ∑ g : D5, χ_of_elem D5Irrep.golden (x * g * x⁻¹) * χ_of_elem D5Irrep.golden ((x * g * x⁻¹)⁻¹ * (x * k * x⁻¹)) := by
        intro x
        apply Finset.sum_bij (fun g _ => x⁻¹ * g * x);
        · simp;
        · aesop;
        · exact fun b _ => ⟨ x * b * x⁻¹, Finset.mem_univ _, by group ⟩;
        · simp +decide [ mul_assoc ];
      -- Since conjugation preserves the conjugacy classes, the sums over conjugacy classes are equal.
      have h_conj_classes : ∀ x : D5, ∑ g : D5, χ_of_elem D5Irrep.golden (x * g * x⁻¹) * χ_of_elem D5Irrep.golden ((x * g * x⁻¹)⁻¹ * (x * k * x⁻¹)) = ∑ g : D5, χ_of_elem D5Irrep.golden g * χ_of_elem D5Irrep.golden (g⁻¹ * k) := by
        intro x
        have h_conj_classes : ∀ g : D5, χ_of_elem D5Irrep.golden (x * g * x⁻¹) = χ_of_elem D5Irrep.golden g := by
          exact?;
        simp_all +decide [ mul_assoc, inv_mul_eq_iff_eq_mul ];
        grind;
      rw [ h_conj_equiv, h_conj_classes ]

/-- The golden projector is idempotent: P² = P -/
theorem P_golden_idempotent (ρ : UnitaryRep H) :
    P_golden ρ * P_golden ρ = P_golden ρ := by
      -- By definition of $P_golden$, we have $P_golden ρ = (2 / 10 : ℂ) • ∑ g : D5, (star (χ_of_elem .golden g)) • (ρ g)$.
      have hP_golden : P_golden ρ = (2 / 10 : ℂ) • ∑ g : D5, (star (χ_of_elem .golden g)) • (ρ.toCLM g) := by
        exact?;
      -- By definition of $P_golden$, we can expand $P_golden ρ * P_golden ρ$.
      have h_expand : P_golden ρ * P_golden ρ = (4 / 100 : ℂ) • ∑ g : D5, ∑ h : D5, (star (χ_of_elem .golden g) * star (χ_of_elem .golden h)) • (ρ.toCLM (g * h)) := by
        rw [hP_golden];
        ext; simp +decide [ Finset.mul_sum _ _ _, Finset.sum_mul, mul_assoc, mul_left_comm, smul_smul ] ; ring;
        simp +decide [ Finset.smul_sum, smul_smul, mul_assoc, mul_comm, mul_left_comm, Finset.sum_mul ] ; ring!;
        congr! 3;
        rename_i g hg h hh; exact (by
        exact congr_arg ( fun f => f ‹_› ) ( ρ.map_mul' g h ) ▸ rfl);
      -- By definition of $P_golden$, we can rewrite the double sum as a single sum.
      have h_double_sum : ∑ g : D5, ∑ h : D5, (star (χ_of_elem .golden g) * star (χ_of_elem .golden h)) • (ρ.toCLM (g * h)) = ∑ k : D5, (∑ g : D5, star (χ_of_elem .golden g) * χ_of_elem .golden (g⁻¹ * k)) • (ρ.toCLM k) := by
        have h_double_sum : ∀ g : D5, ∑ h : D5, (star (χ_of_elem .golden g) * star (χ_of_elem .golden h)) • (ρ.toCLM (g * h)) = ∑ k : D5, (star (χ_of_elem .golden g) * star (χ_of_elem .golden (g⁻¹ * k))) • (ρ.toCLM k) := by
          intro g
          apply Finset.sum_bij (fun h _ => g * h);
          · simp;
          · simp +decide;
          · exact fun b _ => ⟨ g⁻¹ * b, Finset.mem_univ _, by simp +decide ⟩;
          · simp +decide [ mul_assoc ];
        simp +decide only [h_double_sum, Finset.sum_smul];
        rw [ Finset.sum_comm ];
        -- Since the character values are real, their complex conjugates are equal to themselves.
        have h_real : ∀ g : D5, star (χ_of_elem .golden g) = χ_of_elem .golden g := by
          exact?;
        aesop;
      -- By definition of $P_golden$, we can simplify the inner sum.
      have h_inner_sum : ∀ k : D5, ∑ g : D5, star (χ_of_elem .golden g) * χ_of_elem .golden (g⁻¹ * k) = 5 * star (χ_of_elem .golden k) := by
        -- By definition of $P_golden$, we can simplify the inner sum using the convolution property.
        have h_inner_sum : ∀ k : D5, ∑ g : D5, star (χ_of_elem .golden g) * χ_of_elem .golden (g⁻¹ * k) = star (∑ g : D5, χ_of_elem .golden g * χ_of_elem .golden (g⁻¹ * k)) := by
          simp +decide [ Complex.conj_ofReal, Complex.conj_I ];
          intro k; congr; ext x; rw [ Complex.ext_iff ] ; simp +decide [ χ_golden_real ] ;
          have := χ_golden_real ( conjClass x ) ; have := χ_golden_real ( conjClass ( x⁻¹ * k ) ) ; simp_all +decide [ Complex.ext_iff ] ;
          unfold χ_of_elem; aesop;
        intro k
        rw [h_inner_sum];
        rw [ golden_convolution ];
        norm_num [ Complex.ext_iff ];
      simp_all +decide [ Finset.mul_sum _ _ _, Finset.sum_mul ];
      norm_num [ Finset.smul_sum, MulAction.mul_smul ];
      norm_num [ ← smul_assoc ];
      exact Finset.sum_congr rfl fun _ _ => by ring;

theorem golden_convolution_proven (k : D5) :
    ∑ g : D5, χ_of_elem .golden g * χ_of_elem .golden (g⁻¹ * k) = 5 * χ_of_elem .golden k := by
      -- Apply the convolution formula theorem to conclude the proof.
      apply golden_convolution

theorem golden_convolution_direct (k : D5) :
    ∑ g : D5, χ_of_elem .golden g * χ_of_elem .golden (g⁻¹ * k) = 5 * χ_of_elem .golden k := by
      -- Apply the convolution lemma to conclude the proof.
      apply golden_convolution_proven

theorem UnitaryRep.toCLM_mul_rev (ρ : UnitaryRep H) (g h : D5) :
    ρ.toCLM (g * h) = ρ.toCLM h * ρ.toCLM g := by
  simp [UnitaryRep.toCLM, ρ.map_mul']
  ext
  simp

lemma sum_smul_reindex (f : D5 → ℂ) (ρ : UnitaryRep H) :
    ∑ g : D5, ∑ h : D5, f g • ρ.toCLM (g * h) = (∑ g : D5, f g) • ∑ k : D5, ρ.toCLM k := by
      rw [ Finset.sum_smul ];
      refine' Finset.sum_congr rfl fun g _ => _;
      rw [ Finset.smul_sum ];
      conv_rhs => rw [ ← Equiv.sum_comp ( Equiv.mulLeft g ) ] ;
      rfl

lemma sum_rho_invariant (ρ : UnitaryRep H) (g : D5) :
    ρ.toCLM g * (∑ h : D5, ρ.toCLM h) = ∑ h : D5, ρ.toCLM h := by
      rw [ Finset.mul_sum _ _ _ ];
      simp +decide [ ← UnitaryRep.toCLM_mul_rev, ρ.map_mul' ];
      exact Equiv.sum_comp ( Equiv.mulRight g ) fun x => ρ.toCLM x

lemma projector_mul_eq_sum_convolution (f1 f2 : D5 → ℂ) (ρ : UnitaryRep H) :
    (∑ g : D5, f1 g • ρ.toCLM g) * (∑ h : D5, f2 h • ρ.toCLM h) =
    ∑ k : D5, (∑ g : D5, f1 g * f2 (k * g⁻¹)) • ρ.toCLM k := by
      -- Expand the product of sums. Use `UnitaryRep.toCLM_mul_rev` to combine `ρ(g) * ρ(h) = ρ(h * g)`.
      have h_expand : (∑ g : D5, f1 g • ρ.toCLM g) * (∑ h : D5, f2 h • ρ.toCLM h) = ∑ g : D5, ∑ h : D5, (f1 g * f2 h) • ρ.toCLM (h * g) := by
        simp +decide [ Finset.sum_mul _ _ _, Finset.mul_sum, smul_smul, mul_comm, UnitaryRep.toCLM_mul_rev ];
      -- By reindexing the inner sum over `h` to `k = h * g`, we get `h = k * g⁻¹`.
      have h_reindex : ∀ g : D5, ∑ h : D5, (f1 g * f2 h) • ρ.toCLM (h * g) = ∑ k : D5, (f1 g * f2 (k * g⁻¹)) • ρ.toCLM k := by
        intro g;
        rw [ ← Equiv.sum_comp ( Equiv.mulRight g⁻¹ ) ] ; simp +decide;
      rw [ h_expand, Finset.sum_congr rfl fun g hg => h_reindex g ];
      simp +decide only [Finset.sum_smul];
      rw [ Finset.sum_comm ]

theorem P_golden_trivial_orthog (ρ : UnitaryRep H) :
    P_golden ρ * P_trivial ρ = 0 := by
      -- Expand the product using the convolution lemma.
      have h_expand : (∑ g : D5, star (χ_of_elem .golden g) • ρ.toCLM g) * (∑ h : D5, star (χ_of_elem .trivial h) • ρ.toCLM h) = ∑ k : D5, (∑ g : D5, star (χ_of_elem .golden g) * star (χ_of_elem .trivial (k * g⁻¹))) • ρ.toCLM k := by
        exact?;
      convert congr_arg ( fun x : ( H →L[ℂ] H ) => ( ( 2 : ℂ ) / 10 ) • ( ( 1 : ℂ ) / 10 ) • x ) h_expand using 1;
      · unfold P_golden P_trivial; norm_num [ ← smul_assoc ] ;
        unfold isotypicProjector; norm_num [ ← smul_assoc ] ;
        erw [ show D5Irrep.trivial.dim = 1 by rfl, show D5Irrep.golden.dim = 2 by rfl ] ; norm_num;
      · -- By definition of $\chi$, we know that $\chi_{\text{trivial}}(k * g⁻¹) = 1$ for all $k$ and $g$.
        have h_trivial : ∀ k g : D5, χ_of_elem .trivial (k * g⁻¹) = 1 := by
          unfold χ_of_elem;
          exact fun k g => by rcases conjClass ( k * g⁻¹ ) with ( _ | _ | _ | _ | _ | _ | _ | _ | _ | _ | _ ) <;> trivial;
        simp_all +decide [ Finset.smul_sum ];
        rw [ show ( ∑ x : D5, ( starRingEnd ℂ ) ( χ_of_elem D5Irrep.golden x ) ) = 0 from by simpa [ Complex.ext_iff ] using congr_arg Star.star ( sum_chi_golden_proven ) ] ; norm_num

lemma P_trivial_eq_sum_rho (ρ : UnitaryRep H) :
    P_trivial ρ = (1/10 : ℂ) • ∑ g : D5, ρ.toCLM g := by
      -- By definition of $P_{\text{trivial}}$, we have $P_{\text{trivial}} \rho = \frac{1}{10} \sum_{g \in D_5} \rho(g)$.
      simp [P_trivial, isotypicProjector];
      -- Since the trivial representation's character is always 1, we have star (χ_of_elem .trivial g) = 1 for all g.
      have h_trivial_char : ∀ g : D5, star (χ_of_elem .trivial g) = 1 := by
        -- Since the trivial representation's character is always 1, we have star (χ_of_elem .trivial g) = 1 for all g by definition.
        intros g
        simp [χ_of_elem, χ];
        cases conjClass g <;> simp +decide;
      simp_all +decide [ div_eq_inv_mul ];
      erw [ D5Irrep.dim ] ; norm_num

lemma sum_smul_rho_mul_sum_rho (f : D5 → ℂ) (ρ : UnitaryRep H) :
    (∑ g : D5, f g • ρ.toCLM g) * (∑ h : D5, ρ.toCLM h) = (∑ g : D5, f g) • (∑ h : D5, ρ.toCLM h) := by
      -- By the properties of the inner product and the fact that ρ(g) is unitary, we can simplify the expression using the invariance of the sum under conjugation.
      have h_simp : ∀ g : D5, ρ.toCLM g * (∑ h : D5, ρ.toCLM h) = ∑ h : D5, ρ.toCLM h := by
        exact?;
      simp_all +decide [ funext_iff, Finset.sum_mul ];
      exact?

lemma sum_star_chi_golden : ∑ g : D5, star (χ_of_elem .golden g) = 0 := by
