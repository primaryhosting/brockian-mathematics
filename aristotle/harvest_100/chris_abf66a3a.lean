    intro x
    simp [star_chi_golden]
  simp only [h_real]
  -- Use commutativity of character argument
  have h_comm : ∀ g, χ_of_elem .golden (k * g⁻¹) = χ_of_elem .golden (g⁻¹ * k) := by
    intro g
    apply chi_golden_comm
  simp only [h_comm]
  -- Use convolution
  exact golden_convolution_proven k

