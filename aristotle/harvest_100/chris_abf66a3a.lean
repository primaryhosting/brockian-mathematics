lemma chi_golden_comm (a b : D5) : χ_of_elem .golden (a * b) = χ_of_elem .golden (b * a) := by
  -- By Lemma 2, we know that the character is invariant under conjugation.
  have h_conj : ∀ (g h : D5), χ_of_elem .golden (h * g * h⁻¹) = χ_of_elem .golden g := by
    exact?;
  specialize h_conj ( a * b ) b ; simp_all +decide [ mul_assoc ] ;

