      exact h_goldbach

structure GoldbachSpectralModel where
  mainTerm : ℕ → ℝ
  errorBound : ℕ → ℝ
  error_nonneg : ∀ n, 0 ≤ errorBound n
  margin_positive : ∀ n, mainTerm n ≥ errorBound n + 1

/-- ★★ CONDITIONAL GOLDBACH THEOREM -/
theorem goldbach_conditional (M : GoldbachSpectralModel) (n : ℕ) 
    (hn : Even n) (h2 : 2 < n)
    (h_correct : |(goldbachCount n : ℝ) - M.mainTerm n| ≤ M.errorBound n) :
    ∃ p q, Nat.Prime p ∧ Nat.Prime q ∧ p + q = n := by
  apply goldbach_from_count
  have h_main : M.mainTerm n ≥ M.errorBound n + 1 := M.margin_positive n
  have : (goldbachCount n : ℝ) ≥ M.mainTerm n - M.errorBound n := by
    have := abs_le.mp h_correct
    linarith
  have : (goldbachCount n : ℝ) ≥ 1 := by linarith
  exact Nat.one_le_cast.mp this

theorem summable_prime_rpow_inv {s : ℝ} (hs : 1 < s) :
    Summable (fun p : BPrime => (p.val : ℝ) ^ (-s)) := by
      -- The sum over primes of p^(-s) is a subseries of the sum over all natural numbers of n^(-s), which converges for s > 1.
      have h_pseries : Summable (fun n : ℕ => (n : ℝ) ^ (-s)) := by
        exact Real.summable_nat_rpow.2 ( by linarith );
      -- Since the primes are a subset of the natural numbers, and the sum over the natural numbers converges, the sum over the primes must also converge.
      have h_subseries : Summable (fun p : ℕ => (p : ℝ) ^ (-s)) → Summable (fun p : BPrime => (p.val : ℝ) ^ (-s)) := by
        intro h;
        convert h.comp_injective ( show Function.Injective ( fun p : BPrime => p.val ) from fun p q h => by cases p; cases q; aesop ) using 1;
      grind

