/-- ★★ THE BROCKIAN QUASI-CHARACTER: χ_B(n) = n^(iφ) = exp(iφ log n) -/
def character (n : ℕ) : ℂ :=
  if h : n = 0 then 0 else Complex.exp (((φ * Real.log (n : ℝ)) : ℂ) * Complex.I)

@[simp] theorem character_zero : character 0 = 0 := by simp [character]

@[simp] theorem character_one : character 1 = 1 := by
  simp [character, Real.log_one]

theorem character_ne_zero {n : ℕ} (hn : n ≠ 0) : character n ≠ 0 := by
  simp [character, hn, Complex.exp_ne_zero]

theorem character_unitary {n : ℕ} (hn : n ≠ 0) : ‖character n‖ = 1 := by
  -- The norm of the complex exponential is 1 because it lies on the unit circle.
  simp [character, Complex.norm_exp];
  -- Since $n \neq 0$, we have $\| \exp(i \varphi \log n) \| = 1$.
  simp [hn, Complex.norm_exp];
  -- Since $n$ is a positive integer, its logarithm is real, so the imaginary part of $\log(n)$ is zero.
  simp [Complex.log_im]

