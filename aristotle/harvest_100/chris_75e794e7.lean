def pentagonalShift (k : Fin 5) (s : ℂ) : ℂ :=
  s + (2 * Real.pi * Complex.I * (k.val : ℂ)) / 5

def pentagonalAverage (f : ℂ → ℂ) (s : ℂ) : ℂ :=
  (1 / 5 : ℂ) * ∑ k : Fin 5, f (pentagonalShift k s)

theorem pentagonal_average_linear_proven (f g : ℂ → ℂ) (α β : ℂ) (s : ℂ) :
    pentagonalAverage (fun z => α * f z + β * g z) s =
      α * pentagonalAverage f s + β * pentagonalAverage g s := by
        -- By definition of pentagonalAverage, we can expand the left-hand side.
        simp [pentagonalAverage];
        -- By the linearity of summation and multiplication, we can split the left-hand side into two separate sums.
        simp [Finset.sum_add_distrib, mul_add, add_mul, Finset.mul_sum, Finset.sum_mul];
        -- By commutativity and associativity of multiplication, we can rearrange the terms in the sum.
        simp [mul_assoc, mul_comm, mul_left_comm]

theorem pentagonal_average_const_proven (c : ℂ) (s : ℂ) :
    pentagonalAverage (fun _ => c) s = c := by
      -- By definition of pentagonalAverage, we have:
      simp [pentagonalAverage]

theorem pentagonalShift_zero_proven (s : ℂ) : pentagonalShift 0 s = s := by
  -- By definition of pentagonalShift, we have pentagonalShift 0 s = s + 0 * (if s = 0 then 1 else ω).
  simp [pentagonalShift]

theorem pentagonalShift_re_proven (k : Fin 5) (s : ℂ) :
    (pentagonalShift k s).re = s.re := by
      -- The real part of the pentagonal shift is equal to the real part of the original point because \( \omega \) is a primitive fifth root of unity.
      simp [pentagonalShift]

theorem character_unitary_proven {n : ℕ} (hn : n ≠ 0) : ‖character n‖ = 1 := by
  -- The norm of the exponential function with an imaginary argument is 1.
  have h_exp_norm : ∀ θ : ℝ, ‖Complex.exp (θ * Complex.I)‖ = 1 := by
    -- The norm of the exponential of an imaginary number is 1 because it lies on the unit circle in the complex plane.
    intros θ
    simp [Complex.norm_exp];
  -- Apply the fact that the norm of the exponential function with an imaginary argument is 1.
  convert h_exp_norm (φ * Real.log n) using 1;
  -- By definition of character, we have character n = Complex.exp (φ * Real.log n * Complex.I).
  simp [character];
  -- Since $n \neq 0$, the if condition is false, so we can simplify the expression.
  simp [hn]
