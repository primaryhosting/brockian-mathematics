        exact BS.projectors.selfAdjoint _;
      have hΔ_self_adjoint : IsSelfAdjoint BS.Δ := by
        exact BS.hΔ
      have hV_self_adjoint : IsSelfAdjoint BS.V := by
        exact BS.hV;
      simp_all +decide [ IsSelfAdjoint ];
      rw [ mul_assoc ]

