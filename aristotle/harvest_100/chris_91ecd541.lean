/-- The dihedral group D₅ (symmetries of regular pentagon) -/
abbrev D5 := DihedralGroup 5

/-- D₅ has exactly 10 elements -/
theorem D5_card : Fintype.card D5 = 10 := by
  simpa using DihedralGroup.card (n := 5)

/-- Four irreducible representations of D₅ -/
inductive D5IrrepIndex where
  | trivial    -- 1D: χ(g) = 1
  | sign       -- 1D: χ(r) = 1, χ(s) = -1
  | golden     -- 2D: related to φ = (1+√5)/2
  | conjugate  -- 2D: complex conjugate
  deriving DecidableEq, Repr, Fintype

/-- Dimension of each irrep -/
def D5IrrepIndex.dimension : D5IrrepIndex → ℕ
  | .trivial => 1
  | .sign => 1
  | .golden => 2
  | .conjugate => 2

/-- Dimension formula: 1² + 1² + 2² + 2² = 10 = |D₅| -/
theorem dimension_sum : ∑ idx : D5IrrepIndex, (idx.dimension)^2 = Fintype.card D5 := by
  rw [D5_card]; decide

/-- **Isotypic Projectors**: Decompose Hilbert space into irrep subspaces -/
class IsotypicProjectors (H : Type*) [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] (ρ : D5 → (H ≃ₗᵢ[ℂ] H)) where
  projector : D5IrrepIndex → (H →L[ℂ] H)
  selfAdjoint : ∀ idx, IsSelfAdjoint (projector idx)
  idempotent : ∀ idx, projector idx * projector idx = projector idx
  orthogonal : ∀ i j, i ≠ j → projector i * projector j = 0
  complete : projector .trivial + projector .sign + projector .golden + projector .conjugate = 1

/-- **Brockian System**: Complete package for spectral analysis -/
structure BrockianSystem (H : Type*) [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] where
  /-- D₅ unitary representation -/
  ρ : D5 → (H ≃ₗᵢ[ℂ] H)
  /-- Isotypic projectors -/
  [projectors : IsotypicProjectors H ρ]
  /-- Laplacian/scaling operator (self-adjoint) -/
  Δ : H →L[ℂ] H
  hΔ : IsSelfAdjoint Δ
  /-- Regularized potential (self-adjoint) -/
  V : H →L[ℂ] H
  hV : IsSelfAdjoint V

attribute [instance] BrockianSystem.projectors

/-- **The Brockian Operator** B = P_φ Δ P_φ + V
    Combines: geometry (Δ) + symmetry filter (P_φ) + regularization (V) -/
noncomputable def B {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (BS : BrockianSystem H) : H →L[ℂ] H :=
  let P_φ := BS.projectors.projector .golden
  P_φ * BS.Δ * P_φ + BS.V

/-- **PROVEN: B is self-adjoint (Hermitian)** -/
theorem B_selfAdjoint {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (BS : BrockianSystem H) : IsSelfAdjoint (B BS) := by
      unfold B;
      -- Since $P_φ$ is self-adjoint, we have $P_φ^* = P_φ$.
