/-- For large n, the spectral model forces goldbachCount n ≥ 1. -/
theorem goldbach_count_positive_large (M : GoldbachSpectralModel) :
    ∀ n, n > max 2 M.threshold → Even n → goldbachCount n ≥ 1 := by
  intro n hn heven
  have hn2 : n > 2 := lt_of_le_of_lt (Nat.le_max_left 2 M.threshold) hn
  have hnT : n > M.threshold := lt_of_le_of_lt (Nat.le_max_right 2 M.threshold) hn
  have happrox := M.approximation n hn2 heven
  have hlower : M.mainTerm n - M.errorTerm n ≤ (goldbachCount n : ℝ) :=
    lower_bound_from_abs happrox
  have hmargin : (1/2 : ℝ) ≤ M.mainTerm n - M.errorTerm n := M.margin n hnT
  have hhalf : (1/2 : ℝ) ≤ (goldbachCount n : ℝ) := le_trans hmargin hlower
  -- convert to ℕ: if count < 1 then count=0, contradiction with 1/2 ≤ 0
  by_contra hnot
  have hlt1 : goldbachCount n < 1 := Nat.lt_of_not_ge hnot
  have hz : goldbachCount n = 0 := (Nat.lt_one_iff).1 hlt1
  have : (goldbachCount n : ℝ) = 0 := by simpa [hz]
  linarith [hhalf, this]

/-- The *conditional* Goldbach theorem: model + small verification ⇒ Goldbach for all even n>2. -/
theorem goldbach_conditional (M : GoldbachSpectralModel)
    (h_small : ∀ n, n ≤ max 2 M.threshold → n > 2 → Even n →
               ∃ p q, Nat.Prime p ∧ Nat.Prime q ∧ p + q = n) :
    ∀ n, n > 2 → Even n →
      ∃ p q, Nat.Prime p ∧ Nat.Prime q ∧ p + q = n := by
  intro n hn heven
  by_cases hsmall : n ≤ max 2 M.threshold
  · exact h_small n hsmall hn heven
  · have hnlarge : n > max 2 M.threshold := lt_of_not_ge hsmall
    have hcount : goldbachCount n ≥ 1 := goldbach_count_positive_large M n hnlarge heven
    exact goldbach_from_count hcount

