/-- A pentagonal “shift” action used for averaging (formal scaffold). -/
noncomputable def pentagonalShift (k : Fin 5) (s : ℂ) : ℂ :=
  s + (2 * Real.pi * Complex.I * (k.val : ℂ)) / 5

/-- The D₅-style average operator. -/
noncomputable def pentagonalAverage (f : ℂ → ℂ) (s : ℂ) : ℂ :=
  (1 / (5 : ℂ)) * ∑ k : Fin 5, f (pentagonalShift k s)

/-- Linearity of pentagonalAverage (proved, stable). -/
theorem pentagonal_average_linear (f g : ℂ → ℂ) (α β : ℂ) (s : ℂ) :
    pentagonalAverage (fun z => α * f z + β * g z) s =
      α * pentagonalAverage f s + β * pentagonalAverage g s := by
        -- Apply the linearity of summation to split the sum into two parts.
        simp [pentagonalAverage, Finset.sum_add_distrib, mul_add, add_mul, mul_assoc, add_assoc, Finset.mul_sum];
        -- By the commutativity of multiplication, we can rearrange the terms inside the sums.
        simp [mul_comm, mul_assoc, mul_left_comm]

