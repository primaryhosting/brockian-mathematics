/-- Spiral γ(t) = exp(t) · exp(i φ t).
    (Same geometry as exp(t(1 + iφ)), but algebraically easier in Lean.) -/
noncomputable def spiral (t : ℝ) : ℂ :=
  Complex.exp (t : ℂ) * Complex.exp (Complex.I * ((phi * t) : ℂ))

/-- The spiral has exponential radial growth: ‖γ(t)‖ = exp(t). -/
theorem spiral_norm (t : ℝ) : ‖spiral t‖ = Real.exp t := by
  unfold spiral
  -- norm multiplicativity
