    -- ‖exp z‖ = exp(Re z)
    simpa using (Complex.norm_exp (t : ℂ))
  -- second factor: purely imaginary exponent ⇒ Re = 0 ⇒ norm = exp 0 = 1
  have hRe : (Complex.I * ((phi * t) : ℂ)).re = 0 := by
    -- compute Re(I * (real)) = 0
    simp [Complex.mul_re, Complex.I_re, Complex.I_im]
  have h2 : ‖Complex.exp (Complex.I * ((phi * t) : ℂ))‖ = 1 := by
    -- ‖exp z‖ = exp(Re z)
    simpa [Complex.norm_exp, hRe]
      using (Complex.norm_exp (Complex.I * ((phi * t) : ℂ)))
  -- combine
  simpa [h1, h2]

/-- A prime packaged as a type. -/
structure BPrime where
  val : ℕ
  isPrime : Nat.Prime val

instance : Coe BPrime ℕ := ⟨BPrime.val⟩

/-- Map primes to the spiral at t = log p. -/
noncomputable def spiralPrime (p : BPrime) : ℂ := spiral (Real.log (p.val : ℝ))

/-- Fundamental: the norm of spiralPrime equals the prime itself. -/
theorem spiralPrime_norm (p : BPrime) : ‖spiralPrime p‖ = (p.val : ℝ) := by
  unfold spiralPrime
  rw [spiral_norm]
  have hp : 0 < (p.val : ℝ) := by
    exact Nat.cast_pos.mpr p.isPrime.pos
  simpa using (Real.exp_log hp)

/-! Brockian Character -/

/-- χ_B(n) = exp(i phi log n), with χ_B(0)=0 for convenience. -/
noncomputable def brockianChar (n : ℕ) : ℂ :=
  if h : n = 0 then 0 else
    Complex.exp (Complex.I * ((phi * Real.log (n : ℝ)) : ℂ))

@[simp] theorem brockian_char_zero : brockianChar 0 = 0 := by
  -- By definition of brockianChar, we have brockianChar 0 = 0.
  simp [brockianChar]

@[simp] theorem brockian_char_one : brockianChar 1 = 1 := by
  -- By definition of brockianChar, we know that brockianChar 1 = 1.
  simp [brockianChar]

/-- Unitary: ‖χ_B(n)‖ = 1 for n ≠ 0. -/
theorem brockian_char_unitary (n : ℕ) (hn : n ≠ 0) :
    ‖brockianChar n‖ = 1 := by
      -- By definition of $brockianChar$, we have $brockianChar(n) = \phi^{n-1}$.
      simp [brockianChar];
      -- The norm of the exponential of a purely imaginary number is 1.
      simp [hn, Complex.norm_exp];
      -- The imaginary part of the logarithm of a natural number is zero because the logarithm of a real number is real.
      simp [Complex.log_im]

/-- Completely multiplicative on ℕ\{0}. -/
theorem brockian_char_multiplicative (m n : ℕ) (hm : m ≠ 0) (hn : n ≠ 0) :
    brockianChar (m * n) = brockianChar m * brockianChar n := by
      unfold brockianChar;
      -- Using the property of logarithms that $\log(mn) = \log(m) + \log(n)$, we can simplify the exponents.
      have h_log : Real.log (m * n) = Real.log m + Real.log n := by
        -- Apply the logarithm property that $\log(ab) = \log(a) + \log(b)$ for positive real numbers $a$ and $b$.
        apply Real.log_mul; exact Nat.cast_ne_zero.mpr hm; exact Nat.cast_ne_zero.mpr hn;
      simp_all +decide [ ← Complex.exp_add, mul_add ]

/-- Goldbach representation count: number of primes p ≤ n/2 with n-p prime. -/
def goldbachCount (n : ℕ) : ℕ :=
  ((Finset.range (n / 2 + 1)).filter (fun p => Nat.Prime p ∧ Nat.Prime (n - p))).card

/-- If goldbachCount n ≥ 1 then ∃ primes p q with p + q = n. -/
theorem goldbach_from_count {n : ℕ} (h : goldbachCount n ≥ 1) :
    ∃ p q, Nat.Prime p ∧ Nat.Prime q ∧ p + q = n := by
      contrapose! h;
      -- By definition of goldbachCount, if there are no primes p and q such that p + q = n, then goldbachCount n is zero.
      simp [goldbachCount];
      -- By definition of $h$, if $x$ is prime and $x < n / 2 + 1$, then $n - x$ is not prime.
      intros x hx hx_prime
      by_contra h_contra
      have h_sum : x + (n - x) = n := by
        omega;
      -- Apply the hypothesis `h` to obtain a contradiction.
      apply h x (n - x) hx_prime h_contra h_sum

/-- Spectral model predicting Goldbach counts via main term + error. -/
structure GoldbachSpectralModel where
  mainTerm : ℕ → ℝ
  errorTerm : ℕ → ℝ
  error_nonneg : ∀ n, 0 ≤ errorTerm n
  approximation : ∀ n, n > 2 → Even n →
    |(goldbachCount n : ℝ) - mainTerm n| ≤ errorTerm n
  threshold : ℕ
  margin : ∀ n, n > threshold → (1 / 2 : ℝ) ≤ mainTerm n - errorTerm n

/-- If |x - m| ≤ e then m - e ≤ x. -/
lemma lower_bound_from_abs {x m e : ℝ} (h : |x - m| ≤ e) : m - e ≤ x := by
  -- By definition of absolute value, we know that |x - m| ≤ e implies m - e ≤ x ≤ m + e. Therefore, we can conclude that m - e ≤ x.
  linarith [abs_le.mp h]

