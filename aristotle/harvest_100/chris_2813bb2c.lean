abbrev D5 := DihedralGroup 5

def phi : ℝ := (1 + Real.sqrt 5) / 2

theorem D5_card : Fintype.card D5 = 10 := DihedralGroup.card

inductive D5IrrepIndex where | trivial | sign | golden | conjugate 
  deriving DecidableEq, Repr

theorem selfAdjoint_spectrum_real {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (T : H →L[ℂ] H) (hT : IsSelfAdjoint T) :
    ∀ μ ∈ spectrum ℂ T, (μ : ℂ).im = 0 := by
  intro μ hμ; exact (Complex.ext_iff.mp (IsSelfAdjoint.mem_spectrum_eq_re hT hμ)).2

class IsotypicProjectors (H : Type*) [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (ρ : D5 → (H ≃ₗᵢ[ℂ] H)) where
  projector : D5IrrepIndex → (H →L[ℂ] H)
  selfAdjoint : ∀ idx, (projector idx).adjoint = projector idx
  complete : projector .trivial + projector .sign + projector .golden + projector .conjugate = 1

def RefinedWeylTerm (t : ℝ) : ℝ :=
  let Gamma_part := (Complex.arg (Complex.Gamma (1/4 + Complex.I * t / 2)))
  let Pi_part := -(t / 2) * Real.log Real.pi
  (t / (2 * Real.pi)) * Real.log (t / (2 * Real.pi * Real.exp 1)) + 7/8 + (1 / Real.pi) * Gamma_part

class BrockianAxioms where
  rh_bridge : (∀ s : ℂ, completedRiemannZeta₀ s = 0 ∧ 0 < s.re ∧ s.re < 1 → s.re = 1/2) → RiemannHypothesis

structure HeckeBasedPotential (H : Type*) [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H] where
  T : ℕ → (H →L[ℂ] H) -- Hecke operators on Y₀(5)
  c : ℕ → ℝ           -- Coefficients derived from vonMangoldt(n)/n^(1/2) [cite: 109, 114]
  V : H →L[ℂ] H
  V_sa : IsSelfAdjoint V

structure BrockianSystem (H : Type*) [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H] where
  ρ : D5 → (H ≃ₗᵢ[ℂ] H)
  [projectors : IsotypicProjectors H ρ]
  Δ : H →L[ℂ] H -- Scaling operator (Haar measure generator)
  hΔ : IsSelfAdjoint Δ
  V : H →L[ℂ] H -- Regularized potential [cite: 117]
  hV : IsSelfAdjoint V
  B : H →L[ℂ] H
  hB_def : B = (IsotypicProjectors.projector ρ D5IrrepIndex.golden) * Δ * (IsotypicProjectors.projector ρ D5IrrepIndex.golden) + V
  hB_spec : ∀ s : ℂ, completedRiemannZeta₀ (1/2 + I * s) = 0 ↔ ∃ μ ∈ spectrum ℂ B, s = μ

theorem B_selfAdjoint {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (BS : BrockianSystem H) : IsSelfAdjoint BS.B := by
      -- Since $P$ is a projection, it is self-adjoint. Also, $\Delta$ and $V$ are self-adjoint by definition. The product of self-adjoint operators is self-adjoint.
      have h_selfadjoint : IsSelfAdjoint (BS.projectors.projector .golden) ∧ IsSelfAdjoint BS.Δ ∧ IsSelfAdjoint BS.V := by
        exact ⟨ BS.projectors.selfAdjoint _, BS.hΔ, BS.hV ⟩;
      -- Since $P$ is a projection, it is self-adjoint. Also, $\Delta$ and $V$ are self-adjoint by definition. The product of self-adjoint operators is self-adjoint, so $P\Delta P$ is self-adjoint.
      have hPDeltap_selfadjoint : IsSelfAdjoint ((BS.projectors.projector .golden) * BS.Δ * (BS.projectors.projector .golden)) := by
        simp_all +decide [ ContinuousLinearMap.ext_iff, IsSelfAdjoint ];
      -- Since $V$ is self-adjoint, adding it to $P\Delta P$ (which is self-adjoint) results in a self-adjoint operator.
      have hB_selfadjoint : IsSelfAdjoint (BS.B) := by
        have hV_selfadjoint : IsSelfAdjoint BS.V := by
          exact h_selfadjoint.2.2
        convert hPDeltap_selfadjoint.add hV_selfadjoint using 1;
        exact?;
      exact hB_selfadjoint

theorem RH_of_Brockian {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    [BrockianAxioms] (BS : BrockianSystem H) : RiemannHypothesis := by
      -- Apply the BrockianAxioms to conclude the Riemann Hypothesis.
      apply (‹BrockianAxioms›.rh_bridge);
      -- Let's choose any $s$ such that $completedRiemannZeta₀ s = 0$ and $0 < s.re < 1$.
      intro s hs
      obtain ⟨hs1, hs2⟩ := hs;
      -- By the properties of the operator $B$, we know that its spectrum is real.
      have h_spectrum_real : ∀ μ ∈ spectrum ℂ BS.B, μ.im = 0 := by
        apply selfAdjoint_spectrum_real;
        exact?;
      -- By definition of $B$, we know that $s = \mu$ for some $\mu \in \sigma(B)$.
      obtain ⟨μ, hμ⟩ : ∃ μ ∈ spectrum ℂ BS.B, s = 1 / 2 + Complex.I * μ := by
        have := BS.hB_spec;
        specialize this ( ( s - 1 / 2 ) / Complex.I ) ; simp_all +decide [ Complex.ext_iff, div_eq_inv_mul ] ;
        simp_all +decide [ ← mul_assoc ];
        exact ⟨ this.choose, this.choose_spec.1, by linear_combination -this.choose_spec.2.2, this.choose_spec.2.1 ⟩;
      aesop

opaque Trace {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] (T : H →L[ℂ] H) : ℂ

opaque ExplicitFormulaPrimeSum : ℂ

def GrandTraceIdentity {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H] 
    (BS : BrockianSystem H) : Prop :=
    (Trace (BS.projectors.projector .golden * BS.B)) = (ExplicitFormulaPrimeSum)
