#check twin_prime_complete_clustering
#check quadruplet_unique_pattern
#check MetallicMeans.golden_ratio_is_metallic_1

def isEigenvalue (T : L2_Z5 → L2_Z5) (val : ℂ) :=
  ∃ f : L2_Z5, f ≠ (fun _ => 0) ∧ T f = fun r => val * f r

