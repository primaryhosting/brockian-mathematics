  (phi ^ 1 : ℂ) * f Ray.ray_1 * star (g Ray.ray_1) +
  (phi ^ 2 : ℂ) * f Ray.ray_2 * star (g Ray.ray_2) +
  (phi ^ 3 : ℂ) * f Ray.ray_3 * star (g Ray.ray_3) +
  (phi ^ 4 : ℂ) * f Ray.ray_4 * star (g Ray.ray_4)

def transferOperator (X : ℕ) (f : L2_Z5) : L2_Z5 :=
  fun k => 
    ∑ p ∈ (Finset.range (X + 1)).filter Nat.Prime, 
      (1 / Real.sqrt p : ℂ) * f (assignRay ((k.toNat + p) % 5))

def metallicMean (n : ℕ) : ℝ := (n + Real.sqrt (n^2 + 4)) / 2

theorem MetallicMeans.equation (n : ℕ) :
    let ψ := metallicMean n
    ψ ^ 2 = n * ψ + 1 := by
  unfold metallicMean
  ring
  rw [Real.sq_sqrt] <;> nlinarith

theorem MetallicMeans.golden_ratio_is_metallic_1 : metallicMean 1 = phi := by
  unfold metallicMean phi
  norm_num

