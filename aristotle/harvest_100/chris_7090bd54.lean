      have h_prod : ∏ p ∈ (Nat.primeFactors n \ {2}), (1 - 1 / ((p : ℝ) - 1)^2) ≥ 1 / 2 := by
        -- Since the product of terms of the form $(1 - 1 / (p - 1)^2)$ is greater than or equal to $1/2$ for any finite set of primes $p$, we can conclude that the singular series is bounded below by $1/2$.
        have h_prod_bound : ∀ {S : Finset ℕ}, (∀ p ∈ S, Nat.Prime p ∧ p > 2) → (∏ p ∈ S, (1 - 1 / ((p - 1) ^ 2 : ℝ))) ≥ 1 / 2 := by
          intros S hS
          have h_prod_bound : (∏ p ∈ S, (1 - 1 / ((p - 1) ^ 2 : ℝ))) ≥ (∏ p ∈ Finset.Icc 3 (Finset.sup S id), (1 - 1 / ((p - 1) ^ 2 : ℝ))) := by
            rw [ ← Finset.prod_sdiff ( show S ⊆ Finset.Icc 3 ( Finset.sup S id ) from fun p hp => Finset.mem_Icc.mpr ⟨ by linarith [ hS p hp ], Finset.le_sup ( f := id ) hp ⟩ ) ];
            refine' mul_le_of_le_one_left ( Finset.prod_nonneg fun x hx => sub_nonneg.mpr <| div_le_self zero_le_one <| one_le_pow₀ <| by linarith [ show ( x : ℝ ) ≥ 3 by norm_cast; linarith [ hS x hx ] ] ) _;
            exact Finset.prod_le_one ( fun x hx => sub_nonneg.mpr <| div_le_self zero_le_one <| one_le_pow₀ <| by linarith [ show ( x : ℝ ) ≥ 3 by norm_cast; linarith [ Finset.mem_Icc.mp <| Finset.mem_sdiff.mp hx |>.1 ] ] ) fun x hx => sub_le_self _ <| by positivity;
          -- Notice that $\prod_{p=3}^{m} (1 - 1 / (p - 1)^2) = \frac{m}{2(m - 1)}$ for any $m \geq 3$.
          have h_prod_formula : ∀ m : ℕ, 3 ≤ m → (∏ p ∈ Finset.Icc 3 m, (1 - 1 / ((p - 1) ^ 2 : ℝ))) = (m : ℝ) / (2 * (m - 1)) := by
            intro m hm
            induction' m, hm using Nat.le_induction with m ih;
            · norm_num;
            · erw [ Finset.prod_Ioc_succ_top ( by linarith ), ‹∏ p ∈ Finset.Icc 3 m, _ = _› ] ; push_cast ; ring;
              -- Combine and simplify the terms on the left-hand side.
              field_simp
              ring;
              nlinarith only [ inv_mul_cancel₀ ( by linarith [ ( by norm_cast : ( 3 : ℝ ) ≤ m ) ] : ( -1 + m : ℝ ) ≠ 0 ), ( by norm_cast : ( 3 : ℝ ) ≤ m ) ];
          by_cases hS_empty : S = ∅;
          · norm_num [ hS_empty ];
          · refine le_trans ?_ h_prod_bound;
            rw [ h_prod_formula _ ( Nat.succ_le_of_lt ( show 2 < S.sup id from lt_of_lt_of_le ( hS _ ( Classical.choose_spec ( Finset.nonempty_of_ne_empty hS_empty ) ) |>.2 ) ( Finset.le_sup ( f := id ) ( Classical.choose_spec ( Finset.nonempty_of_ne_empty hS_empty ) ) ) ) ) ];
            -- Since $m \geq 3$, we have $1/2 \leq m / (2(m-1))$.
            have h_ineq : ∀ m : ℕ, 3 ≤ m → 1 / 2 ≤ (m : ℝ) / (2 * (m - 1)) := by
              exact fun m hm => by rw [ div_le_div_iff₀ ] <;> linarith [ show ( m : ℝ ) ≥ 3 by norm_cast ] ;
            exact h_ineq _ ( Nat.succ_le_of_lt ( show 2 < S.sup id from lt_of_lt_of_le ( hS _ ( Classical.choose_spec ( Finset.nonempty_of_ne_empty hS_empty ) ) |>.2 ) ( Finset.le_sup ( f := id ) ( Classical.choose_spec ( Finset.nonempty_of_ne_empty hS_empty ) ) ) ) );
        exact h_prod_bound fun p hp => ⟨ Nat.prime_of_mem_primeFactors <| Finset.mem_sdiff.mp hp |>.1, Nat.lt_of_le_of_ne ( Nat.Prime.two_le <| Nat.prime_of_mem_primeFactors <| Finset.mem_sdiff.mp hp |>.1 ) <| Ne.symm <| by aesop ⟩;
      unfold hardyLittlewoodSingularSeries;
      rw [ if_pos ( Nat.even_iff.mp hn_even ) ] ; linarith

noncomputable def hardyLittlewoodMain (n : ℕ) : ℝ :=
  hardyLittlewoodSingularSeries n * (n : ℝ) / (Real.log n) ^ 2

noncomputable def hardyLittlewoodError (n : ℕ) : ℝ :=
  if n ≤ 100 then 0 else 100 * (n : ℝ) / (Real.log n) ^ 3

noncomputable def hardyLittlewoodError' (n : ℕ) : ℝ :=
  if n ≤ 1 then 100 else 100 * (n : ℝ) / (Real.log n) ^ 3

lemma hardyLittlewoodError_nonneg' : ∀ n, 0 ≤ hardyLittlewoodError' n := by
  intro n
  unfold hardyLittlewoodError'
  split
  · norm_num
  · apply div_nonneg (by positivity) (by positivity)

def HardyLittlewoodApproximationStmt : Prop :=
  ∀ n, n > 2 → Even n →
    |(goldbachReps n : ℝ) - hardyLittlewoodMain n| ≤ hardyLittlewoodError' n

noncomputable def hardyLittlewoodMainCorrected (n : ℕ) : ℝ :=
  if Even n then hardyLittlewoodMain n else 1

noncomputable def hardyLittlewoodErrorCorrected (n : ℕ) : ℝ :=
  if Even n then hardyLittlewoodError' n else 0

lemma hardyLittlewoodErrorCorrected_nonneg : ∀ n, 0 ≤ hardyLittlewoodErrorCorrected n := by
  intro n
  unfold hardyLittlewoodErrorCorrected
  split_ifs
  · exact hardyLittlewoodError_nonneg' n
  · norm_num
