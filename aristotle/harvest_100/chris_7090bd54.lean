def goldbachPairs (n : ℕ) : Finset ℕ :=
  (Finset.range (n / 2 + 1)).filter (fun p => Nat.Prime p ∧ Nat.Prime (n - p))

def goldbachReps (n : ℕ) : ℕ := (goldbachPairs n).card

lemma goldbach_rep_exists {n : ℕ} (h : goldbachReps n ≥ 1) :
    ∃ p q, Nat.Prime p ∧ Nat.Prime q ∧ p + q = n := by
      -- By definition of `goldbachReps`, if `goldbachReps n ≥ 1`, then there exists at least one pair `(p, q)` in `goldbachPairs n`.
      obtain ⟨p, hp⟩ : ∃ p ∈ goldbachPairs n, True := by
        -- Since the cardinality of `goldbachPairs n` is at least 1, the set is non-empty.
        have h_nonempty : goldbachPairs n ≠ ∅ := by
          exact Finset.Nonempty.ne_empty ( Finset.card_pos.mp h );
        exact Exists.elim ( Finset.nonempty_of_ne_empty h_nonempty ) fun x hx => ⟨ x, hx, trivial ⟩;
      -- By definition of `goldbachPairs`, if `p ∈ goldbachPairs n`, then `p` is a prime and `n - p` is also a prime.
      obtain ⟨hp_prime, hq_prime⟩ : Nat.Prime p ∧ Nat.Prime (n - p) := by
        exact Finset.mem_filter.mp hp.1 |>.2;
      -- By definition of `goldbachPairs`, if `p ∈ goldbachPairs n`, then `p` is a prime and `n - p` is also a prime. Therefore, we can take `q = n - p`.
      use p, n - p;
      exact ⟨ hp_prime, hq_prime, Nat.add_sub_of_le <| le_of_not_gt fun h => by { rw [ tsub_eq_zero_iff_le.mpr h.le ] at hq_prime; norm_num at hq_prime } ⟩

