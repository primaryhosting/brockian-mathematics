/-- **Sexy Chain Constraints**: Corrected ray constraints for chains of length k. -/
theorem HarmonicArch.sexy_chain_constraints (p k : ℕ)
    (hp : p.Prime) (h : p > 5) (hchain : HarmonicArch.isSexyChainStart p k) :
    (k % 5 = 4 → HarmonicArch.ray p = ⟨1, by decide⟩) ∧
    (k % 5 = 3 → HarmonicArch.ray p = ⟨1, by decide⟩ ∨ HarmonicArch.ray p = ⟨2, by decide⟩) ∧
    (k % 5 = 2 → HarmonicArch.ray p ≠ ⟨4, by decide⟩) := by
      refine' ⟨ _, _, _ ⟩ <;> intro hk' <;> have := hchain 0 <;> have := hchain 1 <;> have := hchain 2 <;> have := hchain 3 <;> have := hchain 4 <;> simp_all +decide [ Nat.add_mod, Nat.mul_mod ];
      · rcases k with ( _ | _ | _ | _ | _ | k ) <;> simp_all +arith +decide [ Nat.add_mod, Nat.mul_mod ];
        · -- Since $p$, $p+6$, $p+12$, and $p+18$ are all primes, none of them can be divisible by 5.
          have h_not_div_5 : ¬(5 ∣ p) ∧ ¬(5 ∣ (p + 6)) ∧ ¬(5 ∣ (p + 12)) ∧ ¬(5 ∣ (p + 18)) := by
            exact ⟨ by rw [ hp.dvd_iff_eq ] <;> linarith, by rw [ Nat.dvd_prime ‹Nat.Prime ( p + 6 ) › ] ; aesop_cat, by rw [ Nat.dvd_prime ‹Nat.Prime ( p + 12 ) › ] ; aesop_cat, by rw [ Nat.dvd_prime ‹Nat.Prime ( p + 18 ) › ] ; aesop_cat ⟩;
          unfold HarmonicArch.ray; norm_num [ Nat.dvd_iff_mod_eq_zero, Nat.add_mod ] at *; have := Nat.mod_lt p ( by decide : 5 > 0 ) ; interval_cases p % 5 <;> simp_all +decide ;
        · -- Since $p$, $p + 6$, $p + 12$, $p + 18$, and $p + 24$ are all primes, one of them must be divisible by 5.
          have h_div_5 : 5 ∣ p ∨ 5 ∣ (p + 6) ∨ 5 ∣ (p + 12) ∨ 5 ∣ (p + 18) ∨ 5 ∣ (p + 24) := by
            grind +ring;
          simp_all +decide [ Nat.Prime.dvd_iff_eq ];
      · rcases k with ( _ | _ | _ | _ | k ) <;> simp_all +arith +decide [ Nat.add_mod, Nat.mul_mod ];
        · -- Since $p$ is a prime greater than 5, it cannot be divisible by 5. Therefore, $p$ must be congruent to 1 or 2 modulo 5.
          have h_mod : p % 5 = 1 ∨ p % 5 = 2 := by
            have := Nat.mod_lt p ( by decide : 5 > 0 ) ; interval_cases _ : p % 5 <;> simp_all +decide [ ← Nat.dvd_iff_mod_eq_zero, hp.dvd_iff_eq ] ;
            · exact absurd ( Nat.dvd_of_mod_eq_zero ( show ( p + 12 ) % 5 = 0 by norm_num [ Nat.add_mod, ‹p % 5 = _› ] ) ) ( by rw [ this.dvd_iff_eq ] <;> linarith );
            · exact absurd ( Nat.dvd_of_mod_eq_zero ( show ( p + 6 ) % 5 = 0 by norm_num [ *, Nat.add_mod ] ) ) ( by rw [ ‹Nat.Prime ( p + 6 ) ›.dvd_iff_eq ] <;> linarith );
          exact Or.imp ( fun h => by exact Fin.ext h ) ( fun h => by exact Fin.ext h ) h_mod;
        · -- Since $p$ is a prime greater than 5, it cannot be divisible by 5. Therefore, $p$ must be congruent to 1 or 2 modulo 5.
          have h_mod : p % 5 = 1 ∨ p % 5 = 2 := by
            have := Nat.mod_lt p ( by decide : 5 > 0 ) ; interval_cases _ : p % 5 <;> simp_all +decide [ ← Nat.dvd_iff_mod_eq_zero, hp.dvd_iff_eq ] ;
            · exact absurd ( Nat.dvd_of_mod_eq_zero ( show ( p + 12 ) % 5 = 0 by norm_num [ *, Nat.add_mod ] ) ) ( by rw [ ‹Nat.Prime ( p + 12 ) ›.dvd_iff_eq ] <;> linarith );
            · exact absurd ( Nat.dvd_of_mod_eq_zero ( show ( p + 6 ) % 5 = 0 by norm_num [ *, Nat.add_mod ] ) ) ( by rw [ ‹Nat.Prime ( p + 6 ) ›.dvd_iff_eq ] <;> linarith );
          unfold HarmonicArch.ray; aesop;
      · -- If $p \equiv 4 \pmod{5}$, then $p + 6 \equiv 0 \pmod{5}$, which contradicts the primality of $p + 6$ since $p + 6 > 5$.
        by_contra h_contra
        have h_div : 5 ∣ (p + 6) := by
          -- Since $p \equiv 4 \pmod{5}$, we have $p + 6 \equiv 4 + 6 \equiv 10 \equiv 0 \pmod{5}$.
          have h_mod : p % 5 = 4 := by
            exact congr_arg Fin.val h_contra;
          norm_num [ Nat.dvd_iff_mod_eq_zero, Nat.add_mod, h_mod ];
        rcases k with ( _ | _ | _ | _ | k ) <;> simp_all +arith +decide [ Nat.Prime.dvd_iff_eq ]

