/-- **Sexy Chain Length Constraint**: Length k mod 5 determines starting ray -/
theorem HarmonicArch.sexy_chain_length_constraint (p k : ℕ)
    (hp : p.Prime) (h : p > 5) (hchain : HarmonicArch.isSexyChainStart p k) (hk : k ≥ 3) :
  k % 5 = 0 → False := by
  intro hk0
  obtain ⟨m, hm⟩ : ∃ m, k = 5 * m := by
    exact Nat.dvd_of_mod_eq_zero hk0
  have h_div : ∃ i < k, (p + 6 * i) % 5 = 0 := by
    exact ⟨ ( 5 - p % 5 ) % 5, by omega, by omega ⟩;
  obtain ⟨ i, hi, hi' ⟩ := h_div; have := Nat.dvd_of_mod_eq_zero hi'; ( have := hchain i hi; simp_all +decide [ Nat.Prime.dvd_iff_eq ] ; );
  linarith [ show i = 0 by linarith ]

