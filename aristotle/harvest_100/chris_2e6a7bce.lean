/-! ## §8. Quadratic Residue Structure -/

/-- **Perfect squares land on rays {0, 1, 4}**: n² mod 5 ∈ {0, 1, 4} for all n. -/
theorem HarmonicArch.perfect_square_rays (n : ℕ) :
    (n ^ 2) % 5 = 0 ∨ (n ^ 2) % 5 = 1 ∨ (n ^ 2) % 5 = 4 := by
  have hlt : n % 5 < 5 := Nat.mod_lt n (by decide)
  have hcases : n % 5 = 0 ∨ n % 5 = 1 ∨ n % 5 = 2 ∨ n % 5 = 3 ∨ n % 5 = 4 := by omega
  rcases hcases with h | h | h | h | h <;> simp [Nat.pow_mod, h] <;> omega

/-- **Rays 2 and 3 are forbidden for squares**: No perfect square is ≡ 2 or 3 (mod 5). -/
theorem HarmonicArch.square_nonresidues (n : ℕ) :
    (n ^ 2) % 5 ≠ 2 ∧ (n ^ 2) % 5 ≠ 3 := by
  have := HarmonicArch.perfect_square_rays n
  omega

/-! ## §9. Craig-Ono Prime-Detecting Certificates -/

/-- Divisor power sum: σₛ(n) = Σ_{d|n} dˢ. -/
def HarmonicArch.sigma (s n : ℕ) : ℤ :=
  ∑ d ∈ n.divisors, (d : ℤ) ^ s

/-- For primes, σₛ(p) = 1 + pˢ (since the only divisors are 1 and p). -/
lemma HarmonicArch.sigma_of_prime (p s : ℕ) (hp : p.Prime) :
    HarmonicArch.sigma s p = 1 + (p : ℤ) ^ s := by
  simp [HarmonicArch.sigma, hp]
  grind

/-- The Craig-Ono k = 6 certificate: cert₆(n) = (n²−n+1)σ₁(n) − σ₃(n). -/
def HarmonicArch.cert6 (n : ℕ) : ℤ :=
  ((n : ℤ) ^ 2 - (n : ℤ) + 1) * HarmonicArch.sigma 1 n - HarmonicArch.sigma 3 n

/-- **cert₆ vanishes on primes**: For any prime p, cert₆(p) = 0.
    This connects to the Craig-Ono theory of prime-detecting certificates
    via Eisenstein series and modular forms. -/
theorem HarmonicArch.cert6_vanishes_on_primes (p : ℕ) (hp : p.Prime) :
    HarmonicArch.cert6 p = 0 := by
  simp [HarmonicArch.cert6, hp]
  have h_sigma1 : HarmonicArch.sigma 1 p = 1 + p := by
    unfold HarmonicArch.sigma
    rw [hp.sum_divisors]
    norm_num [add_comm]
  have h_sigma3 : HarmonicArch.sigma 3 p = 1 + p^3 := by
    unfold HarmonicArch.sigma
    rw [hp.sum_divisors]
    simp [pow_succ, sq]
    ring
  simpa only [h_sigma1, h_sigma3] using by ring

/-! ## §10. Golden Ratio and Pentagonal Geometry -/

/-- The golden ratio φ = (1 + √5)/2. -/
def HarmonicArch.φ : ℝ := (1 + Real.sqrt 5) / 2

/-- **φ satisfies its defining quadratic**: φ² = φ + 1. -/
theorem HarmonicArch.phi_squared : HarmonicArch.φ ^ 2 = HarmonicArch.φ + 1 := by
  -- By definition of φ, we know that φ^2 = φ + 1. This follows from the quadratic equation that φ satisfies.
  rw [HarmonicArch.φ]
  field_simp
  ring;
  -- Simplify the left-hand side by combining like terms.
  simp [sq]
  ring

/-- **φ is positive**. -/
theorem HarmonicArch.phi_pos : 0 < HarmonicArch.φ := by
  -- By definition of $HarmonicArch.φ$, we know that $HarmonicArch.φ = 4$.
  simp [HarmonicArch.φ];
  -- Since $\sqrt{5}$ is positive, we have $1 + \sqrt{5} > 0$.
  apply add_pos_of_pos_of_nonneg; norm_num; exact Real.sqrt_nonneg 5

