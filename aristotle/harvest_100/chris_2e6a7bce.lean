def HarmonicArch.primeCountAbove5 (x : ℕ) : ℕ :=
  (Finset.range x).filter (fun p => p.Prime ∧ p > 5) |>.card

/-- Deviation of ray density from uniform distribution -/
def HarmonicArch.rayDensityDeviation (j : HarmonicArch.ActiveRay) (x : ℕ) : ℤ :=
  (HarmonicArch.rayPrimeCount j x : ℤ) - (HarmonicArch.primeCountAbove5 x : ℤ) / 4

/-- **Asymptotic Ray Balance**: Each ray contains ~25% of primes as x → ∞ -/
def HarmonicArch.RayDensityAsymptoticStmt (j : HarmonicArch.ActiveRay) : Prop :=
  ∀ ε > 0, ∃ N : ℕ, ∀ x ≥ N,
    |(HarmonicArch.rayPrimeCount j x : ℝ) / (HarmonicArch.primeCountAbove5 x : ℝ) - 0.25| < ε

/-- **Bounded Oscillation**: Deviation grows slower than √x -/
def HarmonicArch.RayDensityBoundedOscillationStmt (j : HarmonicArch.ActiveRay) : Prop :=
  ∃ C : ℝ, C > 0 ∧ ∀ x : ℕ, x ≥ 1000000 →
    |(HarmonicArch.rayDensityDeviation j x : ℝ)| ≤ C * Real.sqrt x

/-- **Golden Ratio Frequency Conjecture**: Oscillations have frequency log φ -/
def HarmonicArch.GoldenFrequencyConjectureStmt (j : HarmonicArch.ActiveRay) : Prop :=
  ∃ A θ : ℝ, A > 0 ∧
