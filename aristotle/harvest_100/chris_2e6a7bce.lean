    Function.LeftInverse HarmonicArch.rotateInv HarmonicArch.rotate := by
  intro j
  cases j with | mk v hv => 
    exact Fin.ext (by simp [HarmonicArch.rotate, HarmonicArch.rotateInv]; omega)

/-- rotateInv is a right inverse of rotate. -/
