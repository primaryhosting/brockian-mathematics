/-! ## §6. Sexy Prime Transition Constraints -/

/-- The three allowed ray transitions for sexy primes (p, p+6) with p > 5. -/
inductive HarmonicArch.SexyTransition : HarmonicArch.RaySpace → HarmonicArch.RaySpace → Prop
  | ray1_to_ray2 : HarmonicArch.SexyTransition ⟨1, by decide⟩ ⟨2, by decide⟩
  | ray2_to_ray3 : HarmonicArch.SexyTransition ⟨2, by decide⟩ ⟨3, by decide⟩
  | ray3_to_ray4 : HarmonicArch.SexyTransition ⟨3, by decide⟩ ⟨4, by decide⟩

/-- **Ray 4 forbidden for sexy primes**: If p ≡ 4 (mod 5) then p + 6 ≡ 0 (mod 5). -/
theorem HarmonicArch.sexy_primes_not_ray4 (p : ℕ) (hp : p.Prime) (hp6 : (p + 6).Prime)
    (h : p > 5) : HarmonicArch.ray p ≠ ⟨4, by decide⟩ := by
  intro hray
  have : p % 5 = 4 := congr_arg Fin.val hray
  have : (p + 6) % 5 = 0 := by omega
  have : 5 ∣ (p + 6) := Nat.dvd_of_mod_eq_zero this
  rw [hp6.dvd_iff_eq] at this <;> omega

/-- **Sexy primes follow sequential transitions**: 1→2, 2→3, or 3→4. -/
theorem HarmonicArch.sexy_follow_allowed_transitions (p : ℕ)
    (hp : p.Prime) (hp6 : (p + 6).Prime) (h : p > 5) :
    HarmonicArch.SexyTransition (HarmonicArch.ray p) (HarmonicArch.ray (p + 6)) := by
  have hmod_ne0 : p % 5 ≠ 0 := fun h0 =>
    HarmonicArch.ray_zero_singularity p hp h (Fin.ext h0)
  have hmod_ne4 : p % 5 ≠ 4 := fun h4 =>
    HarmonicArch.sexy_primes_not_ray4 p hp hp6 h (Fin.ext h4)
  have hlt : p % 5 < 5 := Nat.mod_lt p (by decide)
  have hcases : p % 5 = 1 ∨ p % 5 = 2 ∨ p % 5 = 3 := by omega
  rcases hcases with h1 | h2 | h3
  · have : HarmonicArch.ray p = ⟨1, by decide⟩ := Fin.ext h1
    have : HarmonicArch.ray (p + 6) = ⟨2, by decide⟩ := 
      Fin.ext (by simp [HarmonicArch.ray, Nat.add_mod, h1])
    simp_all
    exact HarmonicArch.SexyTransition.ray1_to_ray2
  · have : HarmonicArch.ray p = ⟨2, by decide⟩ := Fin.ext h2
    have : HarmonicArch.ray (p + 6) = ⟨3, by decide⟩ := 
      Fin.ext (by simp [HarmonicArch.ray, Nat.add_mod, h2])
    simp_all
    exact HarmonicArch.SexyTransition.ray2_to_ray3
  · have : HarmonicArch.ray p = ⟨3, by decide⟩ := Fin.ext h3
    have : HarmonicArch.ray (p + 6) = ⟨4, by decide⟩ := 
      Fin.ext (by simp [HarmonicArch.ray, Nat.add_mod, h3])
    simp_all
    exact HarmonicArch.SexyTransition.ray3_to_ray4

/-! ## §7. Prime Quadruplet Theorem -/

/-- **Unique quadruplet pattern**: Every prime quadruplet (p, p+2, p+6, p+8)
    with p > 5 has the unique ray signature (1, 3, 2, 4). -/
theorem HarmonicArch.quadruplet_unique_pattern (p : ℕ)
    (hp : p.Prime) (hp2 : (p + 2).Prime) (hp6 : (p + 6).Prime) (hp8 : (p + 8).Prime)
    (h : p > 5) :
    (HarmonicArch.ray p, HarmonicArch.ray (p + 2), HarmonicArch.ray (p + 6), HarmonicArch.ray (p + 8)) =
