/-! ## §4. D₄ Symmetry Structure -/

/-- Rotation: cyclic shift j ↦ (j + 1) mod 4. -/
def HarmonicArch.rotate (j : HarmonicArch.ActiveRay) : HarmonicArch.ActiveRay :=
  ⟨(j.val + 1) % 4, Nat.mod_lt _ (by decide)⟩

/-- Inverse rotation: j ↦ (j + 3) mod 4. -/
