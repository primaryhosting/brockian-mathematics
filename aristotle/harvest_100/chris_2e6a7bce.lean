  ) |>.card

/-- Total count of twin prime pairs up to x -/
def HarmonicArch.twinPrimeCount (x : ℕ) : ℕ :=
  (Finset.range x).filter (fun p => p.Prime ∧ (p + 2).Prime ∧ p > 5) |>.card

/-- **Probability Conservation**: The three allowed transitions sum to 1 -/
theorem HarmonicArch.twin_transitions_sum_to_one (x : ℕ) (hx : x ≥ 10000000) :
  let total := HarmonicArch.twinTransitionCount ⟨1, by decide⟩ ⟨3, by decide⟩ x +
               HarmonicArch.twinTransitionCount ⟨2, by decide⟩ ⟨4, by decide⟩ x +
               HarmonicArch.twinTransitionCount ⟨4, by decide⟩ ⟨1, by decide⟩ x
  total = HarmonicArch.twinPrimeCount x := by
  -- Every twin prime pair (p, p+2) with p > 5 must satisfy one of the three allowed ray transitions.
  have h_twin_transition_cases : ∀ p : ℕ, p.Prime ∧ (p + 2).Prime ∧ p > 5 →
      (HarmonicArch.ray p = ⟨1, by decide⟩ ∧ HarmonicArch.ray (p + 2) = ⟨3, by decide⟩) ∨
      (HarmonicArch.ray p = ⟨2, by decide⟩ ∧ HarmonicArch.ray (p + 2) = ⟨4, by decide⟩) ∨
      (HarmonicArch.ray p = ⟨4, by decide⟩ ∧ HarmonicArch.ray (p + 2) = ⟨1, by decide⟩) := by
        intros p hp
        have h_rays : (HarmonicArch.ray p) ≠ ⟨0, by decide⟩ ∧ (HarmonicArch.ray (p + 2)) ≠ ⟨0, by decide⟩ := by
          exact ⟨ HarmonicArch.ray_zero_singularity p hp.1 hp.2.2, HarmonicArch.ray_zero_singularity ( p + 2 ) hp.2.1 ( by linarith ) ⟩;
        have h_rays : (HarmonicArch.ray p).val = 1 ∧ (HarmonicArch.ray (p + 2)).val = 3 ∨
                       (HarmonicArch.ray p).val = 2 ∧ (HarmonicArch.ray (p + 2)).val = 4 ∨
                       (HarmonicArch.ray p).val = 4 ∧ (HarmonicArch.ray (p + 2)).val = 1 := by
                         unfold HarmonicArch.ray at *; simp_all +decide ;
                         grind;
        exact Or.imp ( fun h => ⟨ Fin.ext h.1, Fin.ext h.2 ⟩ ) ( Or.imp ( fun h => ⟨ Fin.ext h.1, Fin.ext h.2 ⟩ ) ( fun h => ⟨ Fin.ext h.1, Fin.ext h.2 ⟩ ) ) h_rays;
  unfold HarmonicArch.twinTransitionCount HarmonicArch.twinPrimeCount; rw [ ← Finset.card_union_of_disjoint, ← Finset.card_union_of_disjoint ] ; congr ; ext p ; aesop;
  · rw [ Finset.disjoint_left ] ; aesop;
  · exact Finset.disjoint_filter.mpr ( by aesop )

/-- **φ⁻² Transition Theorem**: Transitions 1→3 and 4→1 occur with probability φ⁻² -/
def HarmonicArch.TwinTransitionPhiSquaredStmt (x : ℕ) : Prop :=
  x ≥ 10000000 →
  let freq_1_3 := (HarmonicArch.twinTransitionCount ⟨1, by decide⟩ ⟨3, by decide⟩ x : ℝ) / 
                  (HarmonicArch.twinPrimeCount x : ℝ)
  let freq_4_1 := (HarmonicArch.twinTransitionCount ⟨4, by decide⟩ ⟨1, by decide⟩ x : ℝ) / 
                  (HarmonicArch.twinPrimeCount x : ℝ)
  |freq_1_3 - (1 / HarmonicArch.φ ^ 2)| < 0.05 ∧ 
  |freq_4_1 - (1 / HarmonicArch.φ ^ 2)| < 0.05

