    HarmonicArch.reflect (HarmonicArch.rotate (HarmonicArch.reflect j)) =
    HarmonicArch.rotate (HarmonicArch.rotate (HarmonicArch.rotate j)) := by
  rcases j with ⟨_ | _ | _ | _ | j, hj⟩ <;> trivial

/-- rotateInv is a left inverse of rotate. -/
