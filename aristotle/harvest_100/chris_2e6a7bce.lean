/-! ## §16. Prime Gap Distributions (Prediction #8) -/

/-- Conditional gap distribution: P(gap = g | transition from r₁ to r₂) -/
def HarmonicArch.conditionalGapProbability (g : ℕ) (r₁ r₂ : HarmonicArch.RaySpace) (x : ℕ) : ℝ :=
  let gaps_with_trans := (Finset.range x).filter (fun p =>
    p.Prime ∧ (p + g).Prime ∧ HarmonicArch.ray p = r₁ ∧ HarmonicArch.ray (p + g) = r₂)
  let all_trans := (Finset.range x).filter (fun p =>
    ∃ q, p.Prime ∧ q.Prime ∧ q > p ∧ HarmonicArch.ray p = r₁ ∧ HarmonicArch.ray q = r₂)
  if all_trans.card = 0 then 0 else (gaps_with_trans.card : ℝ) / (all_trans.card : ℝ)

/-- Legendre symbol computation. -/
def HarmonicArch.legendreSymbol (a : ℤ) (p : ℕ) : ℤ :=
  if hp : p.Prime then
    have : Fact (p.Prime) := ⟨hp⟩
    legendreSym p a
  else 0

/-- Ray-dependent correction factor for Legendre symbol -/
def HarmonicArch.rayLegendreCorrection (j : HarmonicArch.ActiveRay) (a : ℕ) : ℤ :=
  match a % 5, j.val with
  | 0, _ => 0
  | 1, _ => 1
  | 4, _ => 1
  | 2, _ => -1
  | 3, _ => -1
  | _, _ => 0  -- Should never reach

/-- **Ray Legendre Formula**: Legendre symbol can be computed via ray correction -/
def HarmonicArch.RayLegendreFormulaStmt : Prop :=
  ∀ (p : ℕ) (hp : p.Prime) (h : p > 5) (a : ℤ),
  ∃ j : HarmonicArch.ActiveRay, HarmonicArch.ray p = HarmonicArch.activeRayToResidue j ∧
  HarmonicArch.legendreSymbol a p = HarmonicArch.rayLegendreCorrection j (a.natAbs % 5) * 
                       HarmonicArch.legendreSymbol a p

