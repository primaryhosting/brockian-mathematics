example : |HarmonicArch.φ - 1.618| < 0.001 := by
  unfold HarmonicArch.φ
  norm_num
  -- We'll use the fact that $\sqrt{5} \approx 2.236$ to estimate the value.
  have h_sqrt_approx : 2.236 < Real.sqrt 5 ∧ Real.sqrt 5 < 2.237 := by
    -- We'll use the fact that $\sqrt{5} \approx 2.236$ to show that $2.236 < \sqrt{5} < 2.237$.
    norm_num [Real.lt_sqrt, Real.sqrt_lt];
  -- By combining the results from the approximation, we can conclude the proof.
  apply abs_lt.mpr
  constructor
  linarith
  linarith

