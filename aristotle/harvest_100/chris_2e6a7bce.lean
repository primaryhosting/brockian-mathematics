theorem HarmonicArch.rotate_bijective : Function.Bijective HarmonicArch.rotate :=
  ⟨HarmonicArch.rotateInv_left_inverse.injective,
   HarmonicArch.rotateInv_right_inverse.surjective⟩

/-- **Reflection is bijective** (immediate from involution). -/
theorem HarmonicArch.reflect_bijective : Function.Bijective HarmonicArch.reflect :=
  Function.bijective_iff_has_inverse.mpr
    ⟨HarmonicArch.reflect, HarmonicArch.reflect_involution, HarmonicArch.reflect_involution⟩

/-! ## §5. Twin Prime Transition Constraints -/

