  ∀ (p : ℕ) (hp : p.Prime) (h : p > 5),
  HarmonicArch.isFibonacciWieferich p →
  ∃ k : ℕ, k > 0 ∧ k ∣ HarmonicArch.pisanoPeriod ∧
  HarmonicArch.fibMod p k = 0

