  (∀ j k : HarmonicArch.ActiveRay, 
    (∃ᶠ p in Filter.atTop, p.Prime ∧ HarmonicArch.ray p = HarmonicArch.activeRayToResidue j) ↔
    (∃ᶠ q in Filter.atTop, q.Prime ∧ HarmonicArch.ray q = HarmonicArch.activeRayToResidue k)) →
  ∀ N : ℕ, ∃ p > N, p.Prime ∧ (p + 2).Prime

/-- Ray density connects to prime number theorem -/
theorem HarmonicArch.ray_density_from_pnt
  (h_asymp : ∀ j, HarmonicArch.RayDensityAsymptoticStmt j)
  (h_pnt : ∀ ε > 0, ∃ N : ℕ, ∀ x ≥ N, |(HarmonicArch.primeCountAbove5 x : ℝ) / (x / Real.log x) - 1| < ε) :
  ∀ j : HarmonicArch.ActiveRay, ∀ ε > 0, ∃ N : ℕ, ∀ x ≥ N,
    |(HarmonicArch.rayPrimeCount j x : ℝ) / (x / (4 * Real.log x)) - 1| < ε := by
  intro j ε hε
  -- We want to show |rayPrimeCount / (x/4logx) - 1| < ε
  -- Let A = rayPrimeCount, B = primeCount, C = x/logx.
  -- We want |A / (C/4) - 1| < ε => |4A/C - 1| < ε.
  -- We have |A/B - 1/4| < δ1 (from h_asymp)
  -- We have |B/C - 1| < δ2 (from h_pnt)
  -- 4A/C - 1 = 4(A/C - 1/4) = 4(A/B * B/C - 1/4)
  -- = 4( (1/4 + e1) * (1 + e2) - 1/4 ) where |e1|<δ1, |e2|<δ2
  -- = 4( 1/4 + 1/4 e2 + e1 + e1 e2 - 1/4 )
  -- = e2 + 4e1 + 4e1e2
  -- We need |e2 + 4e1 + 4e1e2| < ε.
  -- |e2 + 4e1 + 4e1e2| ≤ |e2| + 4|e1| + 4|e1||e2| < δ2 + 4δ1 + 4δ1δ2
  -- Choose δ1, δ2 small enough.
  -- For example, choose δ1 < min(1, ε/12) and δ2 < ε/3.
  -- Then 4δ1 < ε/3.
  -- 4δ1δ2 < 4 * 1 * ε/3 = 4ε/3 (too big).
  -- Let's be more careful.
  -- Choose δ1 < min(1, ε/13) and δ2 < min(1, ε/3).
  -- Then |e2| < ε/3.
  -- 4|e1| < 4ε/13 < ε/3.
  -- 4|e1||e2| < 4 * (ε/13) * 1 < ε/3.
  -- Sum < ε.
  -- By multiplying both sides of the inequality from h �_�asymp by 4, we can relate the ratio of the ray's prime count to x/(4 log x) to the ratio of the ray's prime count to the total primes.
  have h_mul : ∀ ε > 0, ∃ N : ℕ, ∀ x ≥ N, |((HarmonicArch.rayPrimeCount j x : ℝ) / (HarmonicArch.primeCountAbove5 x : ℝ)) - 0.25| < ε / 4 := by
    exact fun ε hε => h_asymp j ( ε / 4 ) ( div_pos hε zero_lt_four ) |> fun ⟨ N, hN ⟩ => ⟨ N, fun x hx => by simpa using hN x hx ⟩;
  obtain ⟨ N₁, hN₁ ⟩ := h_pnt ( Min.min 1 ( ε / 8 ) ) ( lt_min zero_lt_one ( by positivity ) ) ; obtain ⟨ N₂, hN₂ ⟩ := h_mul ( Min.min 1 ( ε / 8 ) ) ( lt_min zero_lt_one ( by positivity ) ) ; use Max.max N₁ N₂; intro x hx; specialize hN₁ x ( le_trans ( le_max_left _ _ ) hx ) ; specialize hN₂ x ( le_trans ( le_max_right _ _ ) hx ) ; norm_num [ abs_lt ] at *;
  by_cases h : ( x : ℝ ) / Real.log x = 0 <;> by_cases h' : ( HarmonicArch.primeCountAbove5 x : ℝ ) = 0 <;> simp_all +decide [ div_eq_mul_inv, mul_assoc, mul_comm, mul_left_comm ];
  · rcases h with ( rfl | rfl | h ) <;> norm_cast at *;
  · constructor <;> nlinarith [ inv_mul_cancel₀ ( show ( x : ℝ ) ≠ 0 by exact_mod_cast h.1 ), inv_mul_cancel₀ ( show ( HarmonicArch.primeCountAbove5 x : ℝ ) ≠ 0 by exact_mod_cast h' ), Real.log_pos ( show ( x : ℝ ) > 1 by exact_mod_cast lt_of_le_of_ne ( Nat.succ_le_of_lt ( Nat.pos_of_ne_zero h.1 ) ) ( Ne.symm h.2.1 ) ), mul_le_mul_of_nonneg_left ( show ( Min.min 1 ( ε * 8⁻¹ ) : ℝ ) ≤ ε * 8⁻¹ by exact min_le_right _ _ ) ( show ( 0 : ℝ ) ≤ 4 by norm_num ) ]

/-- **Wieferich Ray 1 Dominance**: Ray 1 has highest Wieferich density -/
def HarmonicArch.WieferichRay1DominanceStmt : Prop :=
  ∀ x : ℕ, x ≥ 100000 →
    let total := ∑ j : HarmonicArch.ActiveRay, HarmonicArch.wieferichRayCount j x
    total > 0 →
    (HarmonicArch.wieferichRayCount ⟨0, by decide⟩ x : ℝ) / (total : ℝ) > 0.35

lemma HarmonicArch.tendsto_mul_ratios {f g h : ℕ → ℝ} {a b : ℝ} 
  (hf : Filter.Tendsto (fun x => f x / g x) Filter.atTop (nhds a)) 
  (hg : Filter.Tendsto (fun x => g x / h x) Filter.atTop (nhds b)) 
  (hg_ne : Filter.Eventually (fun x => g x ≠ 0) Filter.atTop) : 
  Filter.Tendsto (fun x => f x / h x) Filter.atTop (nhds (a * b)) := by
  have h_mul := Filter.Tendsto.mul hf hg
  refine Filter.Tendsto.congr' ?_ h_mul
  filter_upwards [hg_ne] with x hx
  field_simp [hx]

/-- Ray density connects to prime number theorem -/
theorem HarmonicArch.ray_density_from_pnt_v2
  (h_asymp : ∀ j, HarmonicArch.RayDensityAsymptoticStmt j)
  (h_pnt : ∀ ε > 0, ∃ N : ℕ, ∀ x ≥ N, |(HarmonicArch.primeCountAbove5 x : ℝ) / (x / Real.log x) - 1| < ε) :
  ∀ j : HarmonicArch.ActiveRay, ∀ ε > 0, ∃ N : ℕ, ∀ x ≥ N,
    |(HarmonicArch.rayPrimeCount j x : ℝ) / (x / (4 * Real.log x)) - 1| < ε := by
      -- Apply the provided solution steps to conclude the proof.
      apply Classical.byContradiction
      intro h_contra;
      convert HarmonicArch.ray_density_from_pnt _ _ using 1;
      · aesop;
      · assumption;
      · assumption

