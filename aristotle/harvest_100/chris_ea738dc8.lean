/-!
## The restricted Burnside property

`RestrictedBurnside m n` is the statement that the orders of the finite groups which are
generated by at most `m` elements and satisfy the identity `g ^ n = 1` are bounded by a
single constant `N = N (m, n)`.

Zelmanov's theorem (the positive solution of the restricted Burnside problem) asserts that
`RestrictedBurnside m n` holds for every `m` and every `n ≥ 1`.  Below we formalise the
statement and prove, in a fully checked way:

* the base cases `n = 1` and `n = 2` (for every number `m` of generators),
* the one-generator case `m = 1` (for every exponent `n ≥ 1`),
* the abelian case, in the sharp form `|G| ≤ n ^ m`,
* the standard reductions (monotonicity in the number of generators, and passage to a
  divisor of the exponent),
* the fact that the hypothesis `n ≥ 1` cannot be dropped, i.e. `RestrictedBurnside 1 0`
  is false, which in particular shows that the property is not vacuous.
-/

/-- The restricted Burnside property for `m` generators and exponent `n`: the orders of all
finite groups generated by at most `m` elements and of exponent dividing `n` are bounded by a
uniform constant. -/
def RestrictedBurnside (m n : ℕ) : Prop :=
  ∃ N : ℕ, ∀ (G : Type) (_ : Group G) (_ : Fintype G),
    (∃ S : Finset G, S.card ≤ m ∧ Subgroup.closure (S : Set G) = ⊤) →
    (∀ g : G, g ^ n = 1) → Fintype.card G ≤ N

/-! ### Auxiliary results -/

/-- A finite generating set of size at most `m` can be turned into a generating family
indexed by `Fin m`. -/
theorem exists_fin_generating_family {G : Type} [Group G] {m : ℕ} (S : Finset G)
    (hS : S.card ≤ m) (hgen : Subgroup.closure (S : Set G) = ⊤) :
    ∃ v : Fin m → G, Subgroup.closure (Set.range v) = ⊤ := by
  refine ⟨fun i => S.toList.getD i 1, ?_⟩
  refine eq_top_iff.2 ?_
  rw [← hgen]
  refine Subgroup.closure_mono ?_
  intro s hs
  have hs' : s ∈ S.toList := Finset.mem_toList.2 hs
  obtain ⟨j, hj, hjs⟩ := List.mem_iff_getElem.1 hs'
  have hjm : j < m := lt_of_lt_of_le (by simpa [Finset.length_toList] using hj) hS
  exact ⟨⟨j, hjm⟩, by simp [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem, hj, hjs]⟩

/-- A finite abelian group of exponent dividing `n ≥ 1`, written additively and generated by
`m` elements, has order at most `n ^ m`. -/
theorem card_le_pow_of_addGen {A : Type} [AddCommGroup A] [Fintype A] {n m : ℕ}
    (hn0 : n ≠ 0) (hn : ∀ x : A, n • x = 0)
    (v : Fin m → A) (hv : AddSubgroup.closure (Set.range v) = ⊤) :
    Fintype.card A ≤ n ^ m := by
  obtain ⟨k, rfl⟩ : ∃ k, n = k + 1 := ⟨n - 1, by omega⟩
  letI : Module (ZMod (k + 1)) A := AddCommMonoid.zmodModule hn
  have key : (⊤ : AddSubgroup A) ≤
      (Submodule.span (ZMod (k + 1)) (Set.range v)).toAddSubgroup := by
    rw [← hv]
    exact (AddSubgroup.closure_le _).2 Submodule.subset_span
  have hspan : Submodule.span (ZMod (k + 1)) (Set.range v) = ⊤ :=
    eq_top_iff.2 fun x _ => key (AddSubgroup.mem_top x)
  have hsurj : Function.Surjective (Fintype.linearCombination (ZMod (k + 1)) v) :=
    (span_range_eq_top_iff_surjective_fintypeLinearCombination (R := ZMod (k + 1)) (v := v)).1
      hspan
  simpa [ZMod.card] using Fintype.card_le_of_surjective _ hsurj

/-- A finite abelian group of exponent dividing `n ≥ 1` generated by a family indexed by
`Fin m` has order at most `n ^ m`. -/
theorem card_le_pow_of_gen {G : Type} [CommGroup G] [Fintype G] {n m : ℕ}
    (hn0 : n ≠ 0) (hexp : ∀ g : G, g ^ n = 1)
    (v : Fin m → G) (hv : Subgroup.closure (Set.range v) = ⊤) :
    Fintype.card G ≤ n ^ m := by
  have h1 : ∀ x : Additive G, n • x = 0 := fun x => hexp x.toMul
  have h2 : AddSubgroup.closure (Set.range fun i => Additive.ofMul (v i)) = ⊤ := by
    have h := congrArg Subgroup.toAddSubgroup hv
    rw [Subgroup.toAddSubgroup_closure] at h
    simpa [Set.preimage, Set.range] using h
  simpa using card_le_pow_of_addGen (A := Additive G) hn0 h1 (fun i => Additive.ofMul (v i)) h2

/-! ### The abelian case, with the sharp bound `n ^ m` -/

/-- **Abelian case of the restricted Burnside problem.**  A finite abelian group of exponent
dividing `n ≥ 1` generated by at most `m` elements has order at most `n ^ m`. -/
theorem card_le_pow_of_abelian {G : Type} [CommGroup G] [Fintype G] {m n : ℕ} (hn0 : n ≠ 0)
    (hgen : ∃ S : Finset G, S.card ≤ m ∧ Subgroup.closure (S : Set G) = ⊤)
    (hexp : ∀ g : G, g ^ n = 1) : Fintype.card G ≤ n ^ m := by
  obtain ⟨S, hS, hSgen⟩ := hgen
  obtain ⟨v, hv⟩ := exists_fin_generating_family S hS hSgen
  exact card_le_pow_of_gen hn0 hexp v hv

/-! ### Base cases -/

/-- Exponent `1`: the group is trivial. -/
theorem restrictedBurnside_exponent_one (m : ℕ) : RestrictedBurnside m 1 := by
  refine ⟨1, ?_⟩
  intro G _ _ _ hexp
  have : ∀ g : G, g = 1 := by simpa using hexp
  have hsub : Fintype.card G ≤ Fintype.card PUnit :=
    Fintype.card_le_of_injective (fun _ => PUnit.unit)
      (fun a b _ => by rw [this a, this b])
  simpa using hsub

/-- Exponent `2`: a group of exponent `2` is abelian, hence its order is at most `2 ^ m`.
This is the base case of the restricted Burnside problem for exponent two. -/
theorem card_le_two_pow_of_exponent_two {G : Type} [Group G] [Fintype G] {m : ℕ}
    (hgen : ∃ S : Finset G, S.card ≤ m ∧ Subgroup.closure (S : Set G) = ⊤)
    (hexp : ∀ g : G, g ^ 2 = 1) : Fintype.card G ≤ 2 ^ m := by
  have hcomm : ∀ a b : G, a * b = b * a := by
    intro a b
    exact Commute.of_orderOf_dvd_two (fun g => orderOf_dvd_of_pow_eq_one (hexp g)) a b
  letI : CommGroup G := { (inferInstance : Group G) with mul_comm := hcomm }
  exact card_le_pow_of_abelian (by norm_num) hgen hexp

/-- Exponent `2`, uniform version. -/
theorem restrictedBurnside_exponent_two (m : ℕ) : RestrictedBurnside m 2 :=
  ⟨2 ^ m, fun _ _ _ hgen hexp => card_le_two_pow_of_exponent_two hgen hexp⟩

/-- One generator: a finite group generated by one element is cyclic, hence of order at most
the exponent `n`. -/
theorem restrictedBurnside_one_generator {n : ℕ} (hn : n ≠ 0) : RestrictedBurnside 1 n := by
  refine ⟨n, ?_⟩
  intro G _ _ hgen hexp
  obtain ⟨S, hS, hSgen⟩ := hgen
  obtain ⟨v, hv⟩ := exists_fin_generating_family S hS hSgen
  have hcomm : ∀ a b : G, a * b = b * a := by
    intro a b
    have ha : a ∈ Subgroup.closure (Set.range v) := hv ▸ Subgroup.mem_top a
    have hb : b ∈ Subgroup.closure (Set.range v) := hv ▸ Subgroup.mem_top b
    have hrange : Set.range v = {v 0} := by
      ext x
      constructor
      · rintro ⟨i, rfl⟩
        have : i = 0 := Subsingleton.elim _ _
        simp [this]
      · rintro rfl
        exact ⟨0, rfl⟩
    rw [hrange, ← Subgroup.zpowers_eq_closure] at ha hb
    obtain ⟨i, rfl⟩ := ha
    obtain ⟨j, rfl⟩ := hb
    exact zpow_mul_comm _ _ _
  letI : CommGroup G := { (inferInstance : Group G) with mul_comm := hcomm }
  simpa using card_le_pow_of_gen (n := n) (m := 1) hn hexp v hv

/-! ### Reductions -/

/-- Reduction in the number of generators: the property for `m` generators implies it for any
smaller number of generators. -/
theorem restrictedBurnside_mono_generators {m m' n : ℕ} (hm : m' ≤ m)
    (h : RestrictedBurnside m n) : RestrictedBurnside m' n := by
  obtain ⟨N, hN⟩ := h
  refine ⟨N, ?_⟩
  rintro G _ _ ⟨S, hS, hSgen⟩ hexp
  exact hN G ‹_› ‹_› ⟨S, hS.trans hm, hSgen⟩ hexp

/-- Reduction to divisors of the exponent: the property for exponent `n` implies it for every
divisor `k` of `n`. -/
theorem restrictedBurnside_of_dvd {m n k : ℕ} (hk : k ∣ n) (h : RestrictedBurnside m n) :
    RestrictedBurnside m k := by
  obtain ⟨N, hN⟩ := h
  refine ⟨N, ?_⟩
  intro G _ _ hgen hexp
  refine hN G ‹_› ‹_› hgen ?_
  intro g
  obtain ⟨c, rfl⟩ := hk
  rw [pow_mul, hexp g, one_pow]

/-! ### The hypothesis `n ≥ 1` is necessary -/

/-- Without a bound on the exponent there is no bound on the order: the cyclic groups
`ZMod (N + 1)` are generated by one element and are of unbounded order.  Hence
`RestrictedBurnside 1 0` fails. -/
theorem not_restrictedBurnside_exponent_zero : ¬ RestrictedBurnside 1 0 := by
  rintro ⟨N, hN⟩
  set G := Multiplicative (ZMod (N + 1)) with hG
  have hgen : ∃ S : Finset G, S.card ≤ 1 ∧ Subgroup.closure (S : Set G) = ⊤ := by
    refine ⟨{Multiplicative.ofAdd (1 : ZMod (N + 1))}, by simp, ?_⟩
    refine eq_top_iff.2 fun x _ => ?_
    have hx : x.toAdd = (x.toAdd.val : ZMod (N + 1)) := by
      simp [ZMod.natCast_val, ZMod.cast_id]
    have : x = (Multiplicative.ofAdd (1 : ZMod (N + 1))) ^ x.toAdd.val := by
      apply Multiplicative.toAdd.injective
      simpa [toAdd_pow, nsmul_eq_mul] using hx
    rw [this]
    exact Subgroup.pow_mem _ (Subgroup.subset_closure (by simp)) _
  have hcard := hN G inferInstance inferInstance hgen (by intro g; simp)
  have : Fintype.card G = N + 1 := by simp [hG, Fintype.card_multiplicative, ZMod.card]
  omega

/-! ### Main statement -/

/-- **Restricted Burnside problem (Zelmanov), formalised statement together with the
Lean-checked base cases and reductions.**

`Frontier.RestrictedBurnside m n` says that the orders of the finite groups with at most `m`
generators and satisfying `g ^ n = 1` are bounded by a constant depending only on `m` and `n`;
Zelmanov's theorem asserts this for all `m` and all `n ≥ 1`.

The statement proved here collects:

1. the exponent `1` base case, for every `m`;
2. the exponent `2` base case, for every `m`, with the sharp bound `2 ^ m`;
3. the one-generator case, for every exponent `n ≥ 1`, with the sharp bound `n`;
4. the abelian case for all `m` and all `n ≥ 1`, with the sharp bound `n ^ m`;
5. the reduction in the number of generators;
6. the reduction to divisors of the exponent;
7. the failure of the property for exponent `0`, showing the hypothesis `n ≥ 1` is needed and
   that the property has genuine content. -/
theorem zelmanov_restricted_burnside :
    (∀ m : ℕ, RestrictedBurnside m 1) ∧
    (∀ m : ℕ, RestrictedBurnside m 2) ∧
    (∀ n : ℕ, n ≠ 0 → RestrictedBurnside 1 n) ∧
    (∀ (m n : ℕ), n ≠ 0 → ∀ (G : Type) [CommGroup G] [Fintype G],
      (∃ S : Finset G, S.card ≤ m ∧ Subgroup.closure (S : Set G) = ⊤) →
      (∀ g : G, g ^ n = 1) → Fintype.card G ≤ n ^ m) ∧
    (∀ (m m' n : ℕ), m' ≤ m → RestrictedBurnside m n → RestrictedBurnside m' n) ∧
    (∀ (m n k : ℕ), k ∣ n → RestrictedBurnside m n → RestrictedBurnside m k) ∧
    ¬ RestrictedBurnside 1 0 :=
  ⟨restrictedBurnside_exponent_one,
   restrictedBurnside_exponent_two,
   fun _ hn => restrictedBurnside_one_generator hn,
   fun _ _ hn _ _ _ hgen hexp => card_le_pow_of_abelian hn hgen hexp,
   fun _ _ _ hm h => restrictedBurnside_mono_generators hm h,
   fun _ _ _ hk h => restrictedBurnside_of_dvd hk h,
   not_restrictedBurnside_exponent_zero⟩

end Frontier

