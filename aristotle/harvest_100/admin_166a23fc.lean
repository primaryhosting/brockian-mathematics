import Mathlib

/-!
# Unitary Time Evolution
Category: Quantum Physics
Target: QPhys.unitary_time_evolution
Verification: pending
Provenance: Aristotle theorem prover (Harmonic)
-/

open NormedSpace Complex

namespace QPhys

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]

/-- The time-evolution operator `U(t) = exp(-i H t / ℏ)` generated by a Hamiltonian `H`
acting on a complex Hilbert space `E`. -/
noncomputable def timeEvolution (hbar : ℝ) (H : E →L[ℂ] E) (t : ℝ) : E →L[ℂ] E :=
  exp ((-(Complex.I * (t / hbar))) • H)

/-- Key intermediate lemma: if `H` is self-adjoint, then the generator `-i H t / ℏ`
of the time evolution is skew-adjoint. -/
theorem neg_I_smul_mem_skewAdjoint {H : E →L[ℂ] E} (hH : IsSelfAdjoint H) (hbar t : ℝ) :
    (-(Complex.I * (t / hbar))) • H ∈ skewAdjoint (E →L[ℂ] E) := by
  rw [skewAdjoint.mem_iff, star_smul, hH.star_eq, ← neg_smul]
  congr 1
  simp

/-- **Unitary time evolution.** For a self-adjoint Hamiltonian `H` on a complex Hilbert space,
the time-evolution operator `U(t) = exp(-i H t / ℏ)` is unitary for every real time `t`. -/
theorem unitary_time_evolution {H : E →L[ℂ] E} (hH : IsSelfAdjoint H) (hbar t : ℝ) :
    timeEvolution hbar H t ∈ unitary (E →L[ℂ] E) := by
  let +nondep : NormedAlgebra ℚ (E →L[ℂ] E) := .restrictScalars ℚ ℂ _
  exact exp_mem_unitary_of_mem_skewAdjoint (neg_I_smul_mem_skewAdjoint hH hbar t)

/-- Explicit form of unitarity: `U(t)⋆ * U(t) = 1` and `U(t) * U(t)⋆ = 1`. -/
theorem unitary_time_evolution_star_mul_self {H : E →L[ℂ] E} (hH : IsSelfAdjoint H) (hbar t : ℝ) :
    star (timeEvolution hbar H t) * timeEvolution hbar H t = 1 ∧
      timeEvolution hbar H t * star (timeEvolution hbar H t) = 1 :=
  ⟨(Unitary.mem_iff.mp (unitary_time_evolution hH hbar t)).1,
    (Unitary.mem_iff.mp (unitary_time_evolution hH hbar t)).2⟩

end QPhys

