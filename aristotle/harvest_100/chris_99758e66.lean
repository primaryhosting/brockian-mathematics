/-- A Ray Pair is principal if it is active (non-E) and satisfies the gap constraint. -/
structure RayPair where
  r1 : BrockRay
  r2 : BrockRay

/-- The set of principal pairs for a given gap $g$. -/
def principalPairs (g : ℕ) : Finset RayPair :=
  (univ : Finset BrockRay).biUnion fun r1 =>
    ((univ : Finset BrockRay).filter fun r2 =>
      r1 ≠ .E ∧ r2 ≠ .E ∧
      (r2.residue.val : ℤ) = (r1.residue.val + g) % 5).image (fun r2 => ⟨r1, r2⟩)

/-- THEOREM 2.1 (The Universal Law): For any gap $g$ coprime to 5,
    there are exactly 3 principal ray configurations. -/
theorem principal_pair_count (g : ℕ) (hg : Nat.gcd g 5 = 1) :
    (principalPairs g).card = 3 := by
      unfold principalPairs;
      rw [ Finset.card_biUnion ];
      · rw [ ← Nat.mod_add_div g 5 ] at *; have := Nat.mod_lt g ( by decide : 5 > 0 ) ; interval_cases g % 5 <;> simp_all +decide ;
        · norm_num [ Int.add_emod, Int.mul_emod ];
          norm_cast;
        · norm_num [ Int.add_emod, Int.mul_emod ];
          norm_cast;
        · norm_num [ Int.add_emod, Int.mul_emod ];
          norm_cast;
        · norm_num [ Int.add_emod, Int.mul_emod ];
          norm_cast;
      · -- Since the residue of r1 is unique for each r1, if two pairs (r1, r2) and (r1', r2') are in the image, then r1 must equal r1'.
        intros r1 r2 hr1 hr2 h_inter;
        rw [ Function.onFun, Finset.disjoint_left ] ; contrapose! h_inter ; aesop

/-- Mapping Fibonacci numbers to Brockian Rays. -/
def fibRay (n : ℕ) : BrockRay :=
  match (Nat.fib n) % 5 with
  | 0 => .E | 1 => .A | 2 => .B | 3 => .C | 4 => .D | _ => .E

/-- THEOREM 2.5 (The Fibonacci Kernel): Every 5th Fibonacci number lands on Ray E.
    This reinforces Ray E as the "spectral sink" or "forbidden zone". -/
theorem fib_every_5_on_E (k : ℕ) : fibRay (5 * k) = .E := by
  -- By definition of Fibonacci sequence modulo 5, we know that $F(5k) \equiv 0 \pmod{5}$ for any $k$.
  have h_fib_mod : ∀ k, Nat.fib (5 * k) % 5 = 0 := by
    -- By the periodicity of the Fibonacci sequence modulo 5, we know that $F_{5k} \equiv 0 \pmod{5}$ for any $k$.
    have h_periodic : ∀ n, Nat.fib (n + 20) % 5 = Nat.fib n % 5 := by
      norm_num [ Nat.fib_add, Nat.add_mod, Nat.mul_mod ];
    intro k; induction' k using Nat.strong_induction_on with k ih; rcases k with ( _ | _ | _ | _ | k ) <;> simp +arith +decide [ *, Nat.mul_succ ] ;
  -- By definition of $fibRay$, we know that $fibRay (5 * k) = E$ since $5 * k$ is a multiple of 5.
  simp [fibRay, h_fib_mod]

inductive RayPattern | star | spiral | special deriving DecidableEq

/-- Mapping residues mod 10 to geometric signatures.
    Spiral (1,4,6,9): Logarithmic winding dynamics (+ bias).
    Star (2,3,7,8): Pentagram skipping dynamics (- bias). -/
def residuePattern (n : ℕ) : RayPattern :=
  match n % 10 with
  | 1 | 4 | 6 | 9 => .spiral
  | 2 | 3 | 7 | 8 => .star
  | _             => .special

/-- THEOREM 3.1 (Pattern Reflection): The pattern is invariant under reflection $n \mapsto 10-n$. -/
theorem pattern_reflection_invariance (n : ℕ) :
    residuePattern n = residuePattern (10 - (n % 10)) := by
      -- By definition of residuePattern, we know that it depends on the last digit of n modulo 10.
      have h_last_digit : ∀ n, residuePattern n = residuePattern (n % 10) := by
        -- By definition of residuePattern, we know that it only depends on the last digit of n.
        intros n
        simp [residuePattern];
      rw [ h_last_digit ];
      have := Nat.mod_lt n ( by decide : 0 < 10 ) ; interval_cases n % 10 <;> trivial;

