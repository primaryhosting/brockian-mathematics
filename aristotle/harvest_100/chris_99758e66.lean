/-- THEOREM 4.3 (Riemann Hypothesis Reduction):
    If a Brockian System exists, then the Riemann Hypothesis is true. -/
theorem RH_of_BrockianSystem {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (BS : BrockianSystem H) : RiemannHypothesis := by
  intro s hζ h_not_trivial h_ne_one
  let t := (s - 1/2) / I
  have hs_eq : s = 1/2 + I * t := by
    rw [ mul_div_cancel₀ _ Complex.I_ne_zero, add_sub_cancel ]
  have h_spec_iff := BS.hB_spec t
  have h_completed_vanishes : completedRiemannZeta s = 0 := by
    -- By definition of the completed Riemann zeta function, we have completedRiemannZeta(s) = π^(-s/2) * Γ(s/2) * riemannZeta(s).
    have h_def : completedRiemannZeta s = Real.pi ^ (-s / 2) * Complex.Gamma (s / 2) * riemannZeta s := by
      -- By definition of the completed Riemann zeta function, we have completedRiemannZeta(s) = π^(-s/2) * Γ(s/2) * riemannZeta(s). This follows directly from the definition.
      rw [completedRiemannZeta];
      rw [ riemannZeta ];
      rw [ HurwitzZeta.hurwitzZetaEven ];
      simp +decide [ HurwitzZeta.completedHurwitzZetaEven, Function.update ];
      unfold HurwitzZeta.hurwitzEvenFEPair; norm_num [ Complex.Gammaℝ ] ;
      by_cases hs : s = 0 <;> simp +decide [ hs, mul_div_cancel₀, Real.pi_ne_zero ];
      · norm_num [ hs, riemannZeta ] at *;
        norm_num [ HurwitzZeta.hurwitzZetaEven ] at hζ;
      · rw [ mul_div_cancel₀ ];
        norm_num [ Complex.Gamma_eq_zero_iff, hs, Real.pi_ne_zero ];
        field_simp;
        exact fun n => fun hn => h_not_trivial ⟨ n - 1, by cases n <;> norm_num at * <;> ring_nf at * <;> simp_all +singlePass ⟩;
    rw [ h_def, hζ, MulZeroClass.mul_zero ]
  have h_t_eig : ∃ μ ∈ spectrum ℂ BS.B, t = μ := by
    grind
  have h_t_real : t.im = 0 := by
    -- Since $B$ is self-adjoint, its eigenvalues are real.
    have h_B_real : ∀ μ ∈ spectrum ℂ BS.B, μ.im = 0 := by
      have h_B_real : IsSelfAdjoint BS.B := by
        exact?;
      exact?;
    grind
  have h_re_s : s.re = 1/2 := by
    norm_num [ Complex.ext_iff ] at * ; linarith
  exact h_re_s

