/-!
## Setting

We treat the one–dimensional case of Noether's theorem.  The configuration space is `ℝ`, a *path*
is a function `q : ℝ → ℝ` of time with velocity `q'`, and the dynamics comes from a Lagrangian
`L : ℝ → ℝ → ℝ`, written `L x v` for position `x` and velocity `v`, with action
`S[q] = ∫ L (q t) (q' t) dt`.

The two partial derivatives of `L` are carried as data, `L₁ = ∂L/∂x` and `L₂ = ∂L/∂v`
(the momentum); the hypothesis `HasPartials L L₁ L₂` says exactly that `L` is differentiable
with those partial derivatives.

A **smooth symmetry** is generated by a smooth vector field `X : ℝ → ℝ` on configuration space:
the flow moves positions by `x ↦ x + s * X x + o(s)` and hence velocities by
`v ↦ v + s * (X' x * v) + o(s)`.  Invariance of the action under this flow, to first order in the
flow parameter `s`, is the statement `IsFlowSymmetry`:
`(d/ds)|₀ L (x + s * X x) (v + s * (X' x * v)) = 0` for all `x, v`.

**Noether's theorem (1D).**  Along any solution of the Euler–Lagrange equation
`(d/dt) (L₂ (q t) (q' t)) = L₁ (q t) (q' t)` the *Noether current*
`J t = L₂ (q t) (q' t) * X (q t)` is conserved.
-/

/-- The Noether current attached to a Lagrangian momentum `L₂ = ∂L/∂v`, a path `q` with velocity
`q'`, and an infinitesimal symmetry `X`: `J t = (∂L/∂v) (q t, q' t) * X (q t)`. -/
noncomputable def noetherCurrent (L₂ : ℝ → ℝ → ℝ) (q q' X : ℝ → ℝ) (t : ℝ) : ℝ :=
  L₂ (q t) (q' t) * X (q t)

/-- `L₁ x v • fst + L₂ x v • snd`, the candidate total derivative of `L` at `(x, v)`. -/
noncomputable def lagrangianDeriv (L₁ L₂ : ℝ → ℝ → ℝ) (x v : ℝ) : (ℝ × ℝ) →L[ℝ] ℝ :=
  (L₁ x v) • (ContinuousLinearMap.fst ℝ ℝ ℝ) + (L₂ x v) • (ContinuousLinearMap.snd ℝ ℝ ℝ)

@[simp]
theorem lagrangianDeriv_apply (L₁ L₂ : ℝ → ℝ → ℝ) (x v a b : ℝ) :
    lagrangianDeriv L₁ L₂ x v (a, b) = L₁ x v * a + L₂ x v * b := by
  simp [lagrangianDeriv]

/-- `L` is differentiable with partial derivatives `L₁ = ∂L/∂x` and `L₂ = ∂L/∂v`. -/
def HasPartials (L L₁ L₂ : ℝ → ℝ → ℝ) : Prop :=
  ∀ x v : ℝ, HasFDerivAt (fun p : ℝ × ℝ => L p.1 p.2) (lagrangianDeriv L₁ L₂ x v) (x, v)

/-- The vector field `X` (with derivative `X'`) generates a symmetry of the Lagrangian `L`:
the value of `L` is unchanged, to first order, along the prolonged flow of `X`. -/
def IsFlowSymmetry (L : ℝ → ℝ → ℝ) (X X' : ℝ → ℝ) : Prop :=
  ∀ x v : ℝ, HasDerivAt (fun s : ℝ => L (x + s * X x) (v + s * (X' x * v))) 0 0

/-- The infinitesimal form of the symmetry condition. -/
def IsInfinitesimalSymmetry (L₁ L₂ : ℝ → ℝ → ℝ) (X X' : ℝ → ℝ) : Prop :=
  ∀ x v : ℝ, L₁ x v * X x + L₂ x v * (X' x * v) = 0

/-- The Euler–Lagrange equation for a path `q` with velocity `q'`:
`(d/dt) (∂L/∂v) (q t, q' t) = (∂L/∂x) (q t, q' t)`. -/
def SatisfiesEulerLagrange (L₁ L₂ : ℝ → ℝ → ℝ) (q q' : ℝ → ℝ) : Prop :=
  ∀ t : ℝ, HasDerivAt (fun s : ℝ => L₂ (q s) (q' s)) (L₁ (q t) (q' t)) t

/-- The prolonged flow curve `s ↦ (x + s * X x, v + s * (X' x * v))` has velocity
`(X x, X' x * v)` at `s = 0`. -/
theorem hasDerivAt_flowCurve (X X' : ℝ → ℝ) (x v : ℝ) :
    HasDerivAt (fun s : ℝ => (x + s * X x, v + s * (X' x * v))) (X x, X' x * v) 0 := by
  have h1 : HasDerivAt (fun s : ℝ => x + s * X x) (X x) 0 := by
    simpa using (((hasDerivAt_id (0 : ℝ)).mul_const (X x)).const_add x)
  have h2 : HasDerivAt (fun s : ℝ => v + s * (X' x * v)) (X' x * v) 0 := by
    simpa using (((hasDerivAt_id (0 : ℝ)).mul_const (X' x * v)).const_add v)
  exact h1.prodMk h2

/-- A first–order flow symmetry of a differentiable Lagrangian satisfies the infinitesimal
symmetry identity `L₁ * X + L₂ * (X' * v) = 0`. -/
theorem isInfinitesimalSymmetry_of_isFlowSymmetry
    (L L₁ L₂ : ℝ → ℝ → ℝ) (X X' : ℝ → ℝ)
    (hL : HasPartials L L₁ L₂) (hsym : IsFlowSymmetry L X X') :
    IsInfinitesimalSymmetry L₁ L₂ X X' := by
  intro x v
  have hcurve := hasDerivAt_flowCurve X X' x v
  have hcomp :
      HasDerivAt (fun s : ℝ => L (x + s * X x) (v + s * (X' x * v)))
        (lagrangianDeriv L₁ L₂ x v (X x, X' x * v)) 0 := by
    have hL' : HasFDerivAt (fun p : ℝ × ℝ => L p.1 p.2) (lagrangianDeriv L₁ L₂ x v)
        ((fun s : ℝ => (x + s * X x, v + s * (X' x * v))) 0) := by
      simpa using hL x v
    simpa using hL'.comp_hasDerivAt (0 : ℝ) hcurve
  have := hcomp.unique (hsym x v)
  simpa using this

/-- **Key step.**  The Noether current has vanishing time derivative along any solution of the
Euler–Lagrange equations, for any infinitesimal symmetry. -/
theorem hasDerivAt_noetherCurrent_zero
    (L₁ L₂ : ℝ → ℝ → ℝ) (q q' X X' : ℝ → ℝ)
    (hq : ∀ t : ℝ, HasDerivAt q (q' t) t)
    (hX : ∀ x : ℝ, HasDerivAt X (X' x) x)
    (hEL : SatisfiesEulerLagrange L₁ L₂ q q')
    (hsym : IsInfinitesimalSymmetry L₁ L₂ X X')
    (t : ℝ) :
    HasDerivAt (noetherCurrent L₂ q q' X) 0 t := by
  have hXq : HasDerivAt (fun s : ℝ => X (q s)) (X' (q t) * q' t) t :=
    (hX (q t)).comp t (hq t)
  have h := (hEL t).mul hXq
  have hzero :
      L₁ (q t) (q' t) * X (q t) + L₂ (q t) (q' t) * (X' (q t) * q' t) = 0 :=
    hsym (q t) (q' t)
  simpa [noetherCurrent, hzero] using h

/-- Noether's theorem in infinitesimal form: the current is constant in time. -/
theorem noether_conservation_of_infinitesimalSymmetry
    (L₁ L₂ : ℝ → ℝ → ℝ) (q q' X X' : ℝ → ℝ)
    (hq : ∀ t : ℝ, HasDerivAt q (q' t) t)
    (hX : ∀ x : ℝ, HasDerivAt X (X' x) x)
    (hEL : SatisfiesEulerLagrange L₁ L₂ q q')
    (hsym : IsInfinitesimalSymmetry L₁ L₂ X X') :
    ∀ t₀ t₁ : ℝ, noetherCurrent L₂ q q' X t₀ = noetherCurrent L₂ q q' X t₁ := by
  have hd : ∀ t : ℝ, HasDerivAt (noetherCurrent L₂ q q' X) 0 t := fun t =>
    hasDerivAt_noetherCurrent_zero L₁ L₂ q q' X X' hq hX hEL hsym t
  have hdiff : Differentiable ℝ (noetherCurrent L₂ q q' X) := fun t => (hd t).differentiableAt
  have hderiv : ∀ t : ℝ, deriv (noetherCurrent L₂ q q' X) t = 0 := fun t => (hd t).deriv
  exact fun t₀ t₁ => is_const_of_deriv_eq_zero hdiff hderiv t₀ t₁

/-- **Noether's theorem, one–dimensional case.**

Let `L : ℝ → ℝ → ℝ` be a Lagrangian, differentiable with partial derivatives `L₁ = ∂L/∂x` and
`L₂ = ∂L/∂v`, and let `X : ℝ → ℝ` be a smooth vector field on the configuration space with
derivative `X'`.  Assume `X` generates a symmetry of the action: the Lagrangian is invariant, to
first order, along the prolonged flow `(x, v) ↦ (x + s * X x, v + s * (X' x * v))`.

Then along every solution `q` (with velocity `q'`) of the Euler–Lagrange equation, the associated
Noether current `J t = L₂ (q t) (q' t) * X (q t)` is a conserved quantity: it takes the same value
at all times. -/
theorem noether_conservation
    (L L₁ L₂ : ℝ → ℝ → ℝ) (q q' X X' : ℝ → ℝ)
    (hL : HasPartials L L₁ L₂)
    (hq : ∀ t : ℝ, HasDerivAt q (q' t) t)
    (hX : ∀ x : ℝ, HasDerivAt X (X' x) x)
    (hEL : SatisfiesEulerLagrange L₁ L₂ q q')
    (hsym : IsFlowSymmetry L X X') :
    ∀ t₀ t₁ : ℝ, noetherCurrent L₂ q q' X t₀ = noetherCurrent L₂ q q' X t₁ :=
  noether_conservation_of_infinitesimalSymmetry L₁ L₂ q q' X X' hq hX hEL
    (isInfinitesimalSymmetry_of_isFlowSymmetry L L₁ L₂ X X' hL hsym)

/-!
## Consequences

Two classical instances: translation invariance gives conservation of momentum, and the free
particle then has constant velocity.
-/

/-- **Conservation of momentum.**  If the Lagrangian is translation invariant (`∂L/∂x = 0`), then
the momentum `p t = (∂L/∂v) (q t, q' t)` is conserved along solutions. -/
theorem momentum_conservation
    (L₂ : ℝ → ℝ → ℝ) (q q' : ℝ → ℝ)
    (hq : ∀ t : ℝ, HasDerivAt q (q' t) t)
    (hEL : SatisfiesEulerLagrange (fun _ _ => 0) L₂ q q') :
    ∀ t₀ t₁ : ℝ, L₂ (q t₀) (q' t₀) = L₂ (q t₁) (q' t₁) := by
  have h :=
    noether_conservation_of_infinitesimalSymmetry (fun _ _ => 0) L₂ q q'
      (fun _ => 1) (fun _ => 0) hq
      (fun x => by simpa using hasDerivAt_const x (1 : ℝ)) hEL (by intro x v; ring)
  intro t₀ t₁
  simpa [noetherCurrent] using h t₀ t₁

/-- A concrete instance: for the free particle `L x v = v ^ 2 / 2` the Euler–Lagrange equation is
`q'' = 0`, and the conserved Noether current for the translation symmetry `X = 1` is the velocity
itself. -/
theorem free_particle_velocity_conservation
    (q q' q'' : ℝ → ℝ)
    (hq : ∀ t : ℝ, HasDerivAt q (q' t) t)
    (hq' : ∀ t : ℝ, HasDerivAt q' (q'' t) t)
    (hnewton : ∀ t : ℝ, q'' t = 0) :
    ∀ t₀ t₁ : ℝ, q' t₀ = q' t₁ := by
  have hEL : SatisfiesEulerLagrange (fun _ _ => 0) (fun _ v => v) q q' := by
    intro t
    simpa [hnewton t] using hq' t
  simpa using momentum_conservation (fun _ v => v) q q' hq hEL

/-- The free particle Lagrangian `L x v = v ^ 2 / 2` really is differentiable with partial
derivatives `∂L/∂x = 0` and `∂L/∂v = v`, and translation `X = 1` really is a symmetry of it. -/
theorem freeParticle_hasPartials :
    HasPartials (fun _ v : ℝ => v ^ 2 / 2) (fun _ _ => 0) (fun _ v => v) ∧
      IsFlowSymmetry (fun _ v : ℝ => v ^ 2 / 2) (fun _ => 1) (fun _ => 0) := by
  constructor
  · intro x v
    have hg : HasDerivAt (fun w : ℝ => w ^ 2 / 2) v v := by
      simpa using ((hasDerivAt_id v).pow 2).div_const 2
    have h := hg.comp_hasFDerivAt (x, v) (hasFDerivAt_snd (𝕜 := ℝ) (p := (x, v)))
    refine h.congr_fderiv (ContinuousLinearMap.ext fun p => ?_)
    simp [lagrangianDeriv]
  · intro x v
    simpa using hasDerivAt_const (0 : ℝ) (v ^ 2 / 2)

/-- Non-vacuity check: all the hypotheses of `noether_conservation` are simultaneously satisfiable,
and the resulting conserved current can be any prescribed nonzero value.  Here the system is the
free particle `L x v = v ^ 2 / 2`, the path is the uniform motion `q t = c * t + b`, the symmetry is
the translation `X = 1`, and the Noether current is the (constant) momentum `c`. -/
theorem noether_conservation_example (b c : ℝ) :
    HasPartials (fun _ v : ℝ => v ^ 2 / 2) (fun _ _ => 0) (fun _ v => v) ∧
      IsFlowSymmetry (fun _ v : ℝ => v ^ 2 / 2) (fun _ => 1) (fun _ => 0) ∧
      (∀ t : ℝ, HasDerivAt (fun s : ℝ => c * s + b) ((fun _ : ℝ => c) t) t) ∧
      (∀ x : ℝ, HasDerivAt (fun _ : ℝ => (1 : ℝ)) ((fun _ : ℝ => (0 : ℝ)) x) x) ∧
      SatisfiesEulerLagrange (fun _ _ => 0) (fun _ v => v) (fun s : ℝ => c * s + b)
        (fun _ => c) ∧
      (∀ t : ℝ,
        noetherCurrent (fun _ v : ℝ => v) (fun s : ℝ => c * s + b) (fun _ => c) (fun _ => 1) t
          = c) := by
  refine ⟨freeParticle_hasPartials.1, freeParticle_hasPartials.2, ?_, ?_, ?_, ?_⟩
  · intro t
    simpa using ((hasDerivAt_id t).const_mul c).add_const b
  · intro x
    simpa using hasDerivAt_const x (1 : ℝ)
  · intro t
    simpa using hasDerivAt_const t c
  · intro t
    simp [noetherCurrent]

end Frontier

