/-!
# Tightened Predicate Refines Original
Category: Proof-Carrying Apps
Target: PCA.Isolation.tightened_predicate_refines_original
Verification: pending
Provenance: Aristotle theorem prover (Harmonic)
-/

namespace PCA.Isolation

/-- Syntax of the isolation engine's guard predicates over atomic capability
checks drawn from `α`.  The language is the positive (negation-free) fragment
generated by `⊤`, `⊥`, atoms, conjunction and disjunction: this is exactly the
fragment the engine uses to describe which requests a sandboxed component may
perform. -/
inductive Pred (α : Type u) where
  | tru : Pred α
  | fls : Pred α
  | atom : α → Pred α
  | and : Pred α → Pred α → Pred α
  | or : Pred α → Pred α → Pred α
  deriving DecidableEq

namespace Pred

/-- Semantics of a guard predicate relative to an environment `env` assigning a
truth value to every atomic capability check. -/
def eval {α : Type u} (env : α → Bool) : Pred α → Bool
  | tru => true
  | fls => false
  | atom a => env a
  | and p q => eval env p && eval env q
  | or p q => eval env p || eval env q

/-- `p.Accepts env` holds when the environment (i.e. the request) `env` is
admitted by the guard predicate `p`. -/
def Accepts {α : Type u} (p : Pred α) (env : α → Bool) : Prop := eval env p = true

/-- Tightening a guard predicate by an extra side condition `g`: every leaf of
the predicate is guarded by `g`.  This is the operation the isolation engine
performs when it installs an additional policy constraint. -/
def tighten {α : Type u} (g : Pred α) : Pred α → Pred α
  | tru => g
  | fls => fls
  | atom a => and g (atom a)
  | and p q => and (tighten g p) (tighten g q)
  | or p q => or (tighten g p) (tighten g q)

end Pred

open Pred

/-- **Soundness of tightening.** Every request accepted by the tightened
predicate is accepted by the original one: the tightened predicate *refines*
the original. -/
theorem tightened_predicate_refines_original {α : Type u} (g : Pred α)
    (p : Pred α) (env : α → Bool) (h : eval env (tighten g p) = true) :
    eval env p = true := by
  induction p with
  | tru => rfl
  | fls => simp [tighten, eval] at h
  | atom a =>
      simp only [tighten, eval, Bool.and_eq_true] at h
      exact h.2
  | and p q ihp ihq =>
      simp only [tighten, eval, Bool.and_eq_true] at h ⊢
      exact ⟨ihp h.1, ihq h.2⟩
  | or p q ihp ihq =>
      simp only [tighten, eval, Bool.or_eq_true] at h ⊢
      exact h.imp ihp ihq

/-- Refinement stated at the level of accepted requests: everything the
tightened predicate accepts, the original predicate accepts too. -/
theorem accepts_tighten_imp_accepts {α : Type u} (g : Pred α) (p : Pred α)
    (env : α → Bool) (h : (tighten g p).Accepts env) : p.Accepts env :=
  tightened_predicate_refines_original g p env h

/-- **Completeness of tightening.** Whenever the extra side condition `g` holds,
the tightened predicate accepts exactly what the original predicate accepts, so
tightening never rejects a legitimate request inside the guarded region. -/
theorem eval_tighten_of_guard {α : Type u} (g : Pred α) (p : Pred α)
    (env : α → Bool) (hg : eval env g = true) :
    eval env (tighten g p) = eval env p := by
  induction p with
  | tru => simpa [tighten, eval] using hg
  | fls => rfl
  | atom a => simp [tighten, eval, hg]
  | and p q ihp ihq => simp [tighten, eval, ihp, ihq]
  | or p q ihp ihq => simp [tighten, eval, ihp, ihq]

/-- If the side condition fails, the tightened predicate rejects every
request. -/
theorem eval_tighten_of_not_guard {α : Type u} (g : Pred α) (p : Pred α)
    (env : α → Bool) (hg : eval env g = false) :
    eval env (tighten g p) = false := by
  induction p with
  | tru => simpa [tighten] using hg
  | fls => rfl
  | atom a => simp [tighten, eval, hg]
  | and p q ihp ihq => simp [tighten, eval, ihp, ihq]
  | or p q ihp ihq => simp [tighten, eval, ihp, ihq]

end PCA.Isolation

