            intro g hg_coprime; rw [ Nat.gcd_comm ] at hg_coprime; rw [ Nat.gcd_rec ] at hg_coprime; have := Nat.mod_lt g ( by decide : 5 > 0 ) ; interval_cases g % 5 <;> trivial;
