/-- Mapping Fibonacci numbers to Brockian Rays. -/
def fibRay (n : ℕ) : BrockRay :=
  match (Nat.fib n) % 5 with
  | 0 => .E | 1 => .A | 2 => .B | 3 => .C | 4 => .D | _ => .E

/-- THEOREM 2.5 (The Fibonacci Kernel): Every 5th Fibonacci number lands on Ray E.
    This reinforces Ray E as the "spectral sink" or "forbidden zone". -/
theorem fib_every_5_on_E (k : ℕ) : fibRay (5 * k) = .E := by
  -- By definition of Fibonacci sequence, we know that $F_{5k}$ is divisible by 5.
  have h_fib_div : 5 ∣ Nat.fib (5 * k) := by
    -- We can prove this by induction on $k$.
    induction' k with k ih;
    · decide +revert;
    · norm_num [ Nat.fib_add, Nat.mul_succ ];
      omega;
  -- Since $5 \mid \text{Nat.fib}(5k)$, we have $\text{Nat.fib}(5k) \mod 5 = 0$.
  have h_mod : Nat.fib (5 * k) % 5 = 0 := by
    exact Nat.mod_eq_zero_of_dvd h_fib_div;
  -- By definition of `fibRay`, if `Nat.fib (5 * k) % 5 = 0`, then `fibRay (5 * k) = BrockRay.E`.
  unfold fibRay; aesop

