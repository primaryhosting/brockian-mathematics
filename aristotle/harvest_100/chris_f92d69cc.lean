/-- The five Brockian rays corresponding to residues mod 5.
    Ray E acts as the geometric kernel (0, 5). -/
inductive BrockRay | E | A | B | C | D deriving DecidableEq, Repr, Fintype

/-- The residue map is the fundamental bridge from $\mathbb{N}$ to $D_5$. -/
def BrockRay.residue : BrockRay → Fin 5
  | E => 0 | A => 1 | B => 2 | C => 3 | D => 4

/-- The membership predicate. -/
def BrockRay.contains (r : BrockRay) (n : ℕ) : Prop :=
  n % 5 = r.residue.val

/-- THEOREM 0.1 (Partition): Every natural number belongs to exactly one ray.
    This provides the unbreakable set-theoretic foundation. -/
theorem unique_membership (n : ℕ) : ∃! r : BrockRay, r.contains n := by
  -- By definition of BrockRay, every natural number n is in exactly one of the parity classes E, A, B, C, or D.
  have h_unique : ∀ n : ℕ, ∃! r : BrockRay, r.contains n := by
    intro n
    use if n % 5 = 0 then BrockRay.E else if n % 5 = 1 then BrockRay.A else if n % 5 = 2 then BrockRay.B else if n % 5 = 3 then BrockRay.C else BrockRay.D;
    -- By definition of BrockRay, each remainder corresponds to exactly one BrockRay.
    simp [BrockRay.contains];
    have := Nat.mod_lt n ( by decide : 5 > 0 ) ; interval_cases n % 5 <;> simp +decide ;
  exact h_unique n

