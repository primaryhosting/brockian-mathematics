/-- A Ray Pair is principal if it is active (non-E) and satisfies the gap constraint. -/
structure RayPair where
  r1 : BrockRay
  r2 : BrockRay

/-- The set of principal pairs for a given gap $g$. -/
def principalPairs (g : ℕ) : Finset RayPair :=
  (univ : Finset BrockRay).biUnion fun r1 =>
    ((univ : Finset BrockRay).filter fun r2 =>
      r1 ≠ .E ∧ r2 ≠ .E ∧
      (r2.residue.val : ℤ) = (r1.residue.val + g) % 5).image (fun r2 => ⟨r1, r2⟩)

/-- THEOREM 2.1 (The Universal Law): For any gap $g$ coprime to 5,
    there are exactly 3 principal ray configurations. -/
theorem principal_pair_count (g : ℕ) (hg : Nat.gcd g 5 = 1) :
