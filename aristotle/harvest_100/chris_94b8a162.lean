set_option synthInstance.maxSize 128

set_option relaxedAutoImplicit false
set_option autoImplicit false

noncomputable section

/-
Define D5 as the Dihedral Group of order 10 and prove its cardinality is 10.
-/
abbrev D5 := DihedralGroup 5

theorem D5_card : Fintype.card D5 = 10 := by
  simpa [D5] using (DihedralGroup.card (n := 5))

/-
Define the index set for D5 irreducible representations.
-/
inductive D5IrrepIndex where
  | trivial
  | sign
  | golden
  | conjugate
  deriving DecidableEq, Repr, Fintype

/-
Define the IsotypicProjectors class with projector axioms.
-/
class IsotypicProjectors (H : Type*) [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] (ρ : D5 → (H ≃ₗᵢ[ℂ] H)) where
  /-- The projector for each irrep. -/
  projector : D5IrrepIndex → (H →L[ℂ] H)
  /-- Each projector is self-adjoint: P* = P. -/
  selfAdjoint : ∀ idx, IsSelfAdjoint (projector idx)
  /-- Each projector is idempotent: P² = P. -/
  idempotent : ∀ idx, projector idx * projector idx = projector idx
  /-- Different projectors are orthogonal: Pᵢ Pⱼ = 0 for i ≠ j. -/
  orthogonal : ∀ i j, i ≠ j → projector i * projector j = 0
  /-- Projectors sum to identity (completeness). -/
  complete :
    projector .trivial + projector .sign + projector .golden + projector .conjugate = 1

/-
Prove orthogonality of golden and trivial projectors, and idempotence of the golden projector.
-/
theorem golden_trivial_orthog {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] (ρ : D5 → (H ≃ₗᵢ[ℂ] H)) [IP : IsotypicProjectors H ρ] :
    IP.projector .golden * IP.projector .trivial = 0 :=
  IP.orthogonal .golden .trivial (by decide)

theorem golden_idempotent {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] (ρ : D5 → (H ≃ₗᵢ[ℂ] H)) [IP : IsotypicProjectors H ρ] :
    IP.projector .golden * IP.projector .golden = IP.projector .golden :=
  IP.idempotent .golden

/-
Define the BrockianSystem structure containing the representation, projectors, and operators.
-/
structure BrockianSystem (H : Type*) [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] where
  /-- D₅ representation on H. -/
  ρ : D5 → (H ≃ₗᵢ[ℂ] H)
  /-- Isotypic projectors for the D₅-action. -/
  [projectors : IsotypicProjectors H ρ]
  /-- Laplacian / scaling operator. -/
  Δ : H →L[ℂ] H
  /-- Δ is self-adjoint. -/
  hΔ : IsSelfAdjoint Δ
  /-- Regularized potential. -/
  V : H →L[ℂ] H
  /-- V is self-adjoint. -/
  hV : IsSelfAdjoint V

attribute [instance] BrockianSystem.projectors

/-
Define the golden projector P_golden and the Brockian operator B.
-/
def P_golden {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (BS : BrockianSystem H) : H →L[ℂ] H :=
  BS.projectors.projector .golden

def B {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (BS : BrockianSystem H) : H →L[ℂ] H :=
  P_golden BS * BS.Δ * P_golden BS + BS.V

/-
Helper lemmas for star operation on continuous linear maps.
-/
theorem star_add_eq {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (A B : H →L[ℂ] H) : star (A + B) = star A + star B :=
  star_add A B

theorem star_mul_eq {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (A B : H →L[ℂ] H) : star (A * B) = star B * star A :=
  star_mul A B

/-
Check the definition of RiemannHypothesis.
-/
#check RiemannHypothesis

/-
Prove that the Brockian operator B is self-adjoint.
-/
theorem B_self_adjoint {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (BS : BrockianSystem H) : IsSelfAdjoint (B BS) := by
      -- The Brockian operator B is given by P_golden BS * BS.Δ * P_golden BS + BS.V, where Δ is self-adjoint and V is self-adjoint.
      have hB : IsSelfAdjoint (P_golden BS * BS.Δ * P_golden BS) ∧ IsSelfAdjoint BS.V := by
        -- Since $P_golden BS$ is a projector, it is self-adjoint. Also, $\Delta$ is self-adjoint by assumption. Therefore, $P_golden BS * \Delta * P_golden BS$ is self-adjoint.
        have h_self_adjoint : IsSelfAdjoint (P_golden BS) ∧ IsSelfAdjoint BS.Δ := by
          exact ⟨ BS.projectors.selfAdjoint _, BS.hΔ ⟩;
        simp_all +decide [ IsSelfAdjoint, star_mul ];
        exact ⟨ by rw [ mul_assoc ], BS.hV ⟩;
      exact IsSelfAdjoint.add hB.1 hB.2

/-
Check the definition of RiemannHypothesis and the existence of the spectrum lemma.
-/
#print RiemannHypothesis
#check IsSelfAdjoint.im_eq_zero_of_mem_spectrum

