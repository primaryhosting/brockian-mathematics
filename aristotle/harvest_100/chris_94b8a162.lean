example {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H] :
    CStarAlgebra (H →L[ℂ] H) := by infer_instance

/-
Check if H ->L[C] H is a StarModule over C.
-/
example {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H] :
    StarModule ℂ (H →L[ℂ] H) := by infer_instance

/-
Prove that the Riemann Hypothesis follows from the spectral realization of zeta zeros.
-/
theorem RH_of_Brockian_Spine {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] (BS : BrockianSystem H)
    (hB_spec : ∀ z : ℂ,
      riemannZeta z = 0 →
      ¬(∃ n : ℕ, z = -2 * (n + 1)) →
      z ≠ 1 →
      ∃ μ ∈ spectrum ℂ (B BS), z = (1/2 : ℂ) + Complex.I * μ) :
    RiemannHypothesis := by
      unfold RiemannHypothesis;
      intro s hs h1 h2
      obtain ⟨μ, hμ⟩ := hB_spec s hs h1 h2;
      have := B_self_adjoint BS;
      have := this.im_eq_zero_of_mem_spectrum hμ.1; aesop;

/-
Verify the manual proof for RH.
-/
theorem RH_proof_check {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] (BS : BrockianSystem H)
    (hB_spec : ∀ z : ℂ,
      riemannZeta z = 0 →
      ¬(∃ n : ℕ, z = -2 * (n + 1)) →
      z ≠ 1 →
      ∃ μ ∈ spectrum ℂ (B BS), z = (1/2 : ℂ) + Complex.I * μ) :
    RiemannHypothesis := by
  intro z hz_zero hz_nontriv hz_ne_one
  obtain ⟨μ, hμ_spec, hz_eq⟩ := hB_spec z hz_zero hz_nontriv hz_ne_one
  have hμ_real : μ.im = 0 := IsSelfAdjoint.im_eq_zero_of_mem_spectrum (B_self_adjoint BS) hμ_spec
  rw [hz_eq]
  simp only [Complex.add_re, Complex.mul_re, Complex.I_re, Complex.I_im, hμ_real, zero_mul, mul_zero, sub_zero, add_zero]
  norm_num
