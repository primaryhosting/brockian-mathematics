/-
# Polya Isomer Count
Category: Chemistry
Target: Chem.polya_isomer_count
Verification: pending
Provenance: Aristotle theorem prover (Harmonic)
-/

import Mathlib

/-!
## Setting

A molecular skeleton is modelled by a finite set `P` of substitution positions carrying an
action of a finite symmetry group `G`.  A *substitution pattern* is an assignment
`P → C` of a substituent (from a finite set `C`) to each position, and `G` acts on such
patterns by moving positions around (`arrowAction`).  Two patterns describe the same
*isomer* exactly when they lie in the same `G`-orbit, so the number of isomers is the
cardinality of the orbit space `Quotient (MulAction.orbitRel G (P → C))`.

Pólya's enumeration theorem says that this number is the average, over `g ∈ G`, of
`|C| ^ (number of cycles of g on P)`, the number of cycles of `g` being the number of
orbits of the cyclic group `⟨g⟩ = Subgroup.zpowers g` on `P`.
-/

namespace Chem

attribute [local instance] arrowAction

variable {G : Type*} [Group G] {P : Type*} [MulAction G P] {C : Type*}

/-- If a colouring `f : P → C` is fixed by `g`, then it is constant along the
orbits of the cyclic group generated by `g`. -/
theorem apply_smul_eq_of_mem_zpowers {g : G} {f : P → C} (hf : g • f = f)
    {h : G} (hh : h ∈ Subgroup.zpowers g) (x : P) : f (h • x) = f x := by
  have hg : g ∈ MulAction.stabilizer G f := hf
  have hmem : h ∈ MulAction.stabilizer G f := Subgroup.zpowers_le.mpr hg hh
  have hinv : h⁻¹ • f = f := inv_smul_eq_iff.mpr hmem.symm
  have hx : f (h⁻¹⁻¹ • x) = f x := congrFun hinv x
  simpa using hx

/-- The colourings fixed by `g` are exactly the functions on the orbit space of
`⟨g⟩` acting on the positions. -/
def fixedColoringsEquiv (g : G) :
    (MulAction.fixedBy (P → C) g) ≃
      (Quotient (MulAction.orbitRel (Subgroup.zpowers g) P) → C) where
  toFun f := Quotient.lift f.1 (by
    rintro a b hab
    obtain ⟨h, rfl⟩ := hab
    exact apply_smul_eq_of_mem_zpowers f.2 h.2 b)
  invFun F := ⟨fun x => F (Quotient.mk _ x), by
    ext x
    show F (Quotient.mk _ (g⁻¹ • x)) = F (Quotient.mk _ x)
    congr 1
    exact Quotient.sound ⟨⟨g⁻¹, Subgroup.inv_mem _ (Subgroup.mem_zpowers g)⟩, rfl⟩⟩
  left_inv f := rfl
  right_inv F := by
    funext q
    induction q using Quotient.inductionOn
    rfl

/-- **Pólya / Burnside isomer count.**  For a finite symmetry group `G` acting on the
finite set `P` of substitution positions of a skeleton, and a finite set `C` of
substituents, the number of substitution isomers (orbits of colourings) multiplied by
`|G|` equals the cycle-index sum `∑_{g ∈ G} |C| ^ c(g)`, where `c(g)` is the number of
cycles of `g` on the positions, i.e. the number of orbits of `⟨g⟩` on `P`. -/
theorem polya_isomer_count (G : Type*) [Group G] [Fintype G]
    (P : Type*) [Fintype P] [MulAction G P] (C : Type*) [Finite C] :
    Nat.card (Quotient (MulAction.orbitRel G (P → C))) * Nat.card G
      = ∑ g : G, Nat.card C ^ Nat.card (Quotient (MulAction.orbitRel (Subgroup.zpowers g) P)) := by
  classical
  haveI : Fintype C := Fintype.ofFinite C
  haveI : ∀ a : G, Fintype (MulAction.fixedBy (P → C) a) := fun _ => Fintype.ofFinite _
  haveI : Fintype (Quotient (MulAction.orbitRel G (P → C))) := Fintype.ofFinite _
  have burnside := MulAction.sum_card_fixedBy_eq_card_orbits_mul_card_group G (P → C)
  rw [Nat.card_eq_fintype_card, Nat.card_eq_fintype_card, ← burnside]
  refine Finset.sum_congr rfl fun g _ => ?_
  haveI : Fintype (Quotient (MulAction.orbitRel (Subgroup.zpowers g) P)) := Fintype.ofFinite _
  rw [← Nat.card_eq_fintype_card, ← Nat.card_fun]
  exact Nat.card_congr (fixedColoringsEquiv g)

/-- The averaged form of Pólya's enumeration theorem: the number of substitution isomers
equals `(1/|G|) ∑_{g ∈ G} |C| ^ c(g)`. -/
theorem polya_isomer_count_average (G : Type*) [Group G] [Fintype G] [Nonempty G]
    (P : Type*) [Fintype P] [MulAction G P] (C : Type*) [Finite C] :
    (Nat.card (Quotient (MulAction.orbitRel G (P → C))) : ℚ)
      = (∑ g : G, (Nat.card C : ℚ) ^ Nat.card (Quotient (MulAction.orbitRel
          (Subgroup.zpowers g) P))) / Nat.card G := by
  have hG : (Nat.card G : ℚ) ≠ 0 := by
    simp [Nat.card_eq_fintype_card, Fintype.card_ne_zero]
  rw [eq_div_iff hG]
  have := polya_isomer_count G P C
  exact_mod_cast congrArg (fun n : ℕ => (n : ℚ)) this

/-!
## Computing the cycle numbers, and a worked example
-/

/-- The identity contributes one cycle per position: `⟨1⟩` acts trivially. -/
theorem card_cycles_one (G : Type*) [Group G] (P : Type*) [MulAction G P] :
    Nat.card (Quotient (MulAction.orbitRel (Subgroup.zpowers (1 : G)) P)) = Nat.card P := by
  refine Nat.card_congr (Equiv.symm (Equiv.ofBijective
    (Quotient.mk (MulAction.orbitRel (Subgroup.zpowers (1 : G)) P))
    ⟨?_, Quotient.mk_surjective⟩))
  intro a b hab
  obtain ⟨h, rfl⟩ := Quotient.exact hab
  obtain ⟨n, hn⟩ := h.2
  have h1 : (h : G) = 1 := by simpa using hn.symm
  simp [show h = 1 from Subtype.ext h1]

/-- A group acting transitively on a nonempty set has a single orbit. -/
theorem card_orbits_of_pretransitive (G : Type*) [Group G] (P : Type*) [MulAction G P]
    [Nonempty P] [MulAction.IsPretransitive G P] :
    Nat.card (Quotient (MulAction.orbitRel G P)) = 1 := by
  have hs : Subsingleton (Quotient (MulAction.orbitRel G P)) := by
    constructor
    refine Quotient.ind₂ fun a b => ?_
    obtain ⟨g, hg⟩ := MulAction.exists_smul_eq G b a
    exact Quotient.sound ⟨g, hg⟩
  have hn : Nonempty (Quotient (MulAction.orbitRel G P)) :=
    ⟨Quotient.mk _ (Classical.arbitrary P)⟩
  rw [Nat.card_eq_one_iff_unique]
  exact ⟨hs, hn⟩

/-- A worked instance of the theorem: a skeleton with two equivalent positions, whose
symmetry group is the full permutation group of the two positions.  With `k`
substituents available there are `(k ^ 2 + k) / 2` isomers, stated here without
division. -/
theorem polya_two_equivalent_positions (C : Type*) [Finite C] :
    Nat.card (Quotient (MulAction.orbitRel (Equiv.Perm (Fin 2)) (Fin 2 → C))) * 2
      = Nat.card C ^ 2 + Nat.card C := by
  have hcard : Nat.card (Equiv.Perm (Fin 2)) = 2 := by
    simp [Nat.card_eq_fintype_card, Fintype.card_perm]
  have key := polya_isomer_count (Equiv.Perm (Fin 2)) (Fin 2) C
  rw [hcard] at key
  rw [key]
  have huniv : (Finset.univ : Finset (Equiv.Perm (Fin 2))) = {1, Equiv.swap 0 1} := by decide
  have hne : (1 : Equiv.Perm (Fin 2)) ≠ Equiv.swap 0 1 := by decide
  rw [huniv, Finset.sum_pair hne]
  have h1 : Nat.card (Quotient (MulAction.orbitRel
      (Subgroup.zpowers (1 : Equiv.Perm (Fin 2))) (Fin 2))) = 2 := by
    rw [card_cycles_one]
    simp
  have htrans : MulAction.IsPretransitive
      (Subgroup.zpowers (Equiv.swap (0 : Fin 2) 1)) (Fin 2) := by
    constructor
    intro x y
    by_cases h : x = y
    · exact ⟨1, by simp [h]⟩
    · refine ⟨⟨Equiv.swap 0 1, Subgroup.mem_zpowers _⟩, ?_⟩
      show Equiv.swap (0 : Fin 2) 1 x = y
      fin_cases x <;> fin_cases y <;> simp_all
  have h2 : Nat.card (Quotient (MulAction.orbitRel
      (Subgroup.zpowers (Equiv.swap (0 : Fin 2) 1)) (Fin 2))) = 1 :=
    card_orbits_of_pretransitive _ _
  rw [h1, h2, pow_one]

end Chem

