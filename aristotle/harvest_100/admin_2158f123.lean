/-!
# Unitary Time Evolution
Category: Quantum Physics
Target: QPhys.unitary_time_evolution
Verification: pending
Provenance: Aristotle theorem prover (Harmonic)
-/

open NormedSpace Complex

namespace QPhys

section StarAlgebra

variable {A : Type*} [NormedRing A] [NormedAlgebra ℂ A] [StarRing A] [ContinuousStar A]
  [CompleteSpace A] [StarModule ℂ A]

/-- The time-evolution operator `U(t) = exp(-i H t / ℏ)` generated by a Hamiltonian `H`
(an element of a complex Banach star-algebra, e.g. a bounded operator on a Hilbert space). -/
noncomputable def evolution (hbar : ℝ) (H : A) (t : ℝ) : A :=
  exp ((-(Complex.I * (t : ℂ) / (hbar : ℂ))) • H)

omit [ContinuousStar A] [CompleteSpace A] in
/-- For self-adjoint `H` and real `t`, the element `-i H t / ℏ` is skew-adjoint. -/
theorem neg_I_smul_mem_skewAdjoint {H : A} (hH : IsSelfAdjoint H) (hbar t : ℝ) :
    (-(Complex.I * (t : ℂ) / (hbar : ℂ))) • H ∈ skewAdjoint A := by
  rw [skewAdjoint.mem_iff, star_smul, hH.star_eq, ← neg_smul]
  congr 1
  simp
  ring

/-- **Unitary time evolution.**  For a self-adjoint Hamiltonian `H` in a complex Banach
star-algebra, the time-evolution operator `U(t) = exp(-i H t / ℏ)` is unitary for every
real time `t`. -/
theorem unitary_time_evolution {H : A} (hH : IsSelfAdjoint H) (hbar t : ℝ) :
    evolution hbar H t ∈ unitary A := by
  let +nondep : NormedAlgebra ℚ A := .restrictScalars ℚ ℂ A
  exact exp_mem_unitary_of_mem_skewAdjoint (neg_I_smul_mem_skewAdjoint hH hbar t)

/-- `U(t)⋆ U(t) = 1`. -/
theorem star_evolution_mul_self {H : A} (hH : IsSelfAdjoint H) (hbar t : ℝ) :
    star (evolution hbar H t) * evolution hbar H t = 1 :=
  (Unitary.mem_iff.mp (unitary_time_evolution hH hbar t)).1

/-- `U(t) U(t)⋆ = 1`. -/
theorem evolution_mul_star_self {H : A} (hH : IsSelfAdjoint H) (hbar t : ℝ) :
    evolution hbar H t * star (evolution hbar H t) = 1 :=
  (Unitary.mem_iff.mp (unitary_time_evolution hH hbar t)).2

end StarAlgebra

section Hilbert

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]

/-- Concrete form on a complex Hilbert space: the time evolution generated by a self-adjoint
bounded operator `H` is a unitary operator. -/
theorem unitary_time_evolution_operator {H : E →L[ℂ] E} (hH : IsSelfAdjoint H) (hbar t : ℝ) :
    evolution hbar H t ∈ unitary (E →L[ℂ] E) :=
  unitary_time_evolution hH hbar t

/-- Time evolution preserves inner products (hence probabilities). -/
theorem inner_evolution_evolution {H : E →L[ℂ] E} (hH : IsSelfAdjoint H) (hbar t : ℝ)
    (x y : E) :
    inner ℂ (evolution hbar H t x) (evolution hbar H t y) = inner ℂ x y := by
  have h := star_evolution_mul_self hH hbar t
  have := congrArg (fun L : E →L[ℂ] E => (inner ℂ x (L y) : ℂ)) h
  simpa [ContinuousLinearMap.star_eq_adjoint, ContinuousLinearMap.adjoint_inner_right,
    inner_conj_symm] using this

/-- Time evolution preserves norms (conservation of probability). -/
theorem norm_evolution_apply {H : E →L[ℂ] E} (hH : IsSelfAdjoint H) (hbar t : ℝ) (x : E) :
    ‖evolution hbar H t x‖ = ‖x‖ := by
  have h := inner_evolution_evolution hH hbar t x x
  have h1 : ‖evolution hbar H t x‖ ^ 2 = ‖x‖ ^ 2 := by
    have hx := inner_self_eq_norm_sq (𝕜 := ℂ) (evolution hbar H t x)
    have hy := inner_self_eq_norm_sq (𝕜 := ℂ) x
    have h2 := congrArg (RCLike.re (K := ℂ)) h
    rw [hx, hy] at h2
    exact h2
  rw [← Real.sqrt_sq (norm_nonneg (evolution hbar H t x)), ← Real.sqrt_sq (norm_nonneg x), h1]

end Hilbert

end QPhys

