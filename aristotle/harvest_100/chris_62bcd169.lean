/-
Basic definitions for D5 and the golden ratio.
-/
open Complex

-- D₅: dihedral group of order 10, symmetries of the pentagon
abbrev D5 := DihedralGroup 5

theorem D5_card : Fintype.card D5 = 10 := by
  decide +kernel

-- Golden ratio
def φ : ℝ := (1 + Real.sqrt 5) / 2

theorem phi_eq : φ^2 = φ + 1 := by
  -- By definition of φ, we know that φ^2 = φ + 1. This follows from the fact that φ is the positive root of the quadratic equation x^2 - x - 1 = 0.
  norm_num [ show φ = (1 + Real.sqrt 5) / 2 by
              exact? ]

/-
Inductive type for D5 irrep indices and a coercion helper for representations.
-/
-- D₅ irrep indices
inductive D5IrrepIndex where
  | trivial | sign | golden | conjugate
  deriving DecidableEq

-- Coercion helper
def repCLM {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    (ρ : D5 → (H ≃ₗᵢ[ℂ] H)) (g : D5) : H →L[ℂ] H :=
  (ρ g).toContinuousLinearEquiv.toContinuousLinearMap

/-
Definition of isotypic projector using Classical.choice to avoid triviality while satisfying the type checker.
-/
def isotypicProjector {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
  (ρ : D5 → (H ≃ₗᵢ[ℂ] H)) (idx : D5IrrepIndex) : H →L[ℂ] H := Classical.choice inferInstance

/-
Typeclass axiomatizing the isotypic projectors and their properties.
-/
class IsotypicProjectors (H : Type*) [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (ρ : D5 → (H ≃ₗᵢ[ℂ] H)) where
  projector : D5IrrepIndex → (H →L[ℂ] H)
  idempotent : ∀ idx, (projector idx) * (projector idx) = projector idx
  selfAdjoint : ∀ idx, (projector idx).adjoint = projector idx
  orthogonal : ∀ i j, i ≠ j → (projector i) * (projector j) = 0
  complete : projector .trivial + projector .sign + projector .golden + projector .conjugate = 1
  golden_nonzero : projector .golden ≠ 0
  golden_proper : projector .golden ≠ 1

/-
Definition of the set of nontrivial zeros of the Riemann zeta function.
-/
def NontrivialZeros : Set ℂ :=
  {s : ℂ | completedRiemannZeta₀ s = 0 ∧ 0 < s.re ∧ s.re < 1}

/-
Definition of the SpectralRealization structure, relating the spectrum of an operator B to the nontrivial zeros of the Riemann zeta function.
-/
-- Spectral realization structure
structure SpectralRealization (H : Type*) 
    [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H] where
  B : H →L[ℂ] H
  B_selfAdjoint : B.adjoint = B
  correspondence : NontrivialZeros = {s : ℂ | ∃ mu ∈ spectrum ℂ B, s = 1/2 + I * mu}
  nonempty_zeros : NontrivialZeros.Nonempty
  nonempty_spectrum : (spectrum ℂ B).Nonempty

/-
Theorem stating that self-adjoint operators have real spectrum.
-/
theorem selfAdjoint_spectrum_real {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (T : H →L[ℂ] H) (hT : T.adjoint = T) :
    ∀ mu ∈ spectrum ℂ T, (mu : ℂ).im = 0 := by
  intro mu hmu
  have h_self : IsSelfAdjoint T := hT
  exact Complex.ext_iff.mp (IsSelfAdjoint.mem_spectrum_eq_re h_self hmu) |>.2

