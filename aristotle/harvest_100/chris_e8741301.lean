import Mathlib

/-!
Supplementary results for `Math.pell_11` (stated with Mathlib available):
the Pell equation `x² − 11 y² = 1` has infinitely many integer solutions.
-/

namespace Math

/-- The step map generated by the fundamental solution `(10, 3)`. -/
def pellStep : ℤ × ℤ → ℤ × ℤ := fun p => (10 * p.1 + 33 * p.2, 3 * p.1 + 10 * p.2)

/-- Iterating `pellStep` from the fundamental solution `(10, 3)`. -/
def pellSol (n : ℕ) : ℤ × ℤ := pellStep^[n] (10, 3)

theorem pellStep_preserves (p : ℤ × ℤ) (h : p.1 ^ 2 - 11 * p.2 ^ 2 = 1) :
    (pellStep p).1 ^ 2 - 11 * (pellStep p).2 ^ 2 = 1 := by
  simp only [pellStep]
  nlinarith [h]

/-- Every `pellSol n` solves the Pell equation, and its entries are positive
and strictly increasing, so there are infinitely many solutions. -/
theorem pellSol_spec (n : ℕ) :
    (pellSol n).1 ^ 2 - 11 * (pellSol n).2 ^ 2 = 1 ∧ 0 < (pellSol n).2 ∧
      0 < (pellSol n).1 ∧ (pellSol n).2 < (pellSol (n + 1)).2 := by
  induction n with
  | zero =>
    refine ⟨by norm_num [pellSol], by norm_num [pellSol], by norm_num [pellSol], ?_⟩
    simp [pellSol, pellStep]
  | succ n ih =>
    obtain ⟨hsol, hy, hx, -⟩ := ih
    have hstep : pellSol (n + 1) = pellStep (pellSol n) := by
      simp [pellSol, Function.iterate_succ_apply']
    have hstep2 : pellSol (n + 2) = pellStep (pellSol (n + 1)) := by
      simp [pellSol, Function.iterate_succ_apply']
    refine ⟨by rw [hstep]; exact pellStep_preserves _ hsol, ?_, ?_, ?_⟩
    · rw [hstep]; simp only [pellStep]; nlinarith
    · rw [hstep]; simp only [pellStep]; nlinarith
    · rw [hstep2]
      simp only [pellStep]
      rw [hstep]
      simp only [pellStep]
      nlinarith

/-- The set of integer solutions of `x² − 11 y² = 1` is infinite. -/
theorem pell_11_infinite : {p : ℤ × ℤ | p.1 ^ 2 - 11 * p.2 ^ 2 = 1}.Infinite := by
  have hmono : StrictMono (fun n : ℕ => (pellSol n).2) := by
    apply strictMono_nat_of_lt_succ
    intro n
    exact (pellSol_spec n).2.2.2
  have hinj : Function.Injective (fun n : ℕ => pellSol n) := by
    intro a b hab
    exact hmono.injective (congrArg Prod.snd hab)
  apply Set.infinite_of_injective_forall_mem (f := fun n : ℕ => pellSol n) hinj
  intro n
  exact (pellSol_spec n).1

end Math

/-!
# Pell 11
Category: Pure Mathematics
Target: Math.pell_11
Verification: pending
Provenance: Aristotle theorem prover (Harmonic)
-/

namespace Math

/-- The Pell equation `x² − 11·y² = 1` has a nontrivial integer solution,
i.e. one with `y ≠ 0`: indeed `10² − 11·3² = 100 - 99 = 1`. -/
theorem pell_11 : ∃ x y : Int, x ^ 2 - 11 * y ^ 2 = 1 ∧ y ≠ 0 :=
  ⟨10, 3, by decide, by decide⟩

end Math

