# Unitary Time Evolution
Category: Quantum Physics
Target: QPhys.unitary_time_evolution
Verification: pending
Provenance: Aristotle theorem prover (Harmonic)
-/

import Mathlib

open NormedSpace
open scoped Matrix

namespace QPhys

/-- The time-evolution operator `U(t) = exp(-i H t / ℏ)` generated by a Hamiltonian `H`
in a complex Banach `*`-algebra `A` (e.g. complex matrices, or bounded operators on a
Hilbert space). -/
noncomputable def timeEvolution {A : Type*} [NormedRing A] [NormedAlgebra ℂ A]
    [CompleteSpace A] [StarRing A] [ContinuousStar A] [StarModule ℂ A]
    (hbar : ℝ) (H : A) (t : ℝ) : A :=
  exp ((-Complex.I * t / hbar) • H)

/-- **Unitary time evolution.** For a self-adjoint Hamiltonian `H`, the operator
`U(t) = exp(-i H t / ℏ)` is unitary for every real time `t`, i.e.
`U(t)* U(t) = 1 = U(t) U(t)*`. -/
theorem unitary_time_evolution {A : Type*} [NormedRing A] [NormedAlgebra ℂ A]
    [CompleteSpace A] [StarRing A] [ContinuousStar A] [StarModule ℂ A]
    (H : A) (hH : IsSelfAdjoint H) (hbar t : ℝ) :
    timeEvolution hbar H t ∈ unitary A := by
  let +nondep : NormedAlgebra ℚ A := .restrictScalars ℚ ℂ A
  have hstar : star (timeEvolution hbar H t) = exp ((Complex.I * t / hbar) • H) := by
    rw [timeEvolution, star_exp, star_smul, hH.star_eq]
    congr 1
    simp
  have hc : Commute ((Complex.I * t / hbar) • H) ((-Complex.I * t / hbar) • H) :=
    ((Commute.refl H).smul_left _).smul_right _
  refine ⟨?_, ?_⟩
  · rw [hstar, timeEvolution, ← exp_add_of_commute hc, ← add_smul,
      show (Complex.I * t / hbar + -Complex.I * t / hbar) = 0 by ring, zero_smul, exp_zero]
  · rw [hstar, timeEvolution, ← exp_add_of_commute hc.symm, ← add_smul,
      show (-Complex.I * t / hbar + Complex.I * t / hbar) = 0 by ring, zero_smul, exp_zero]

/-- Matrix form: for a Hermitian matrix `H`, the matrix `exp(-i H t / ℏ)` is unitary,
i.e. `U(t)ᴴ * U(t) = 1` and `U(t) * U(t)ᴴ = 1`. -/
theorem unitary_time_evolution_matrix {n : ℕ} (H : Matrix (Fin n) (Fin n) ℂ)
    (hH : H.IsHermitian) (hbar t : ℝ) :
    (exp ((-Complex.I * t / hbar) • H))ᴴ * exp ((-Complex.I * t / hbar) • H) = 1 ∧
      exp ((-Complex.I * t / hbar) • H) * (exp ((-Complex.I * t / hbar) • H))ᴴ = 1 := by
  classical
  letI : NormedRing (Matrix (Fin n) (Fin n) ℂ) := Matrix.linftyOpNormedRing
  letI : NormedAlgebra ℂ (Matrix (Fin n) (Fin n) ℂ) := Matrix.linftyOpNormedAlgebra
  have h := unitary_time_evolution (A := Matrix (Fin n) (Fin n) ℂ) H hH hbar t
  exact ⟨h.1, h.2⟩

end QPhys

