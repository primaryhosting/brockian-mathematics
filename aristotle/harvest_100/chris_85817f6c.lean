/-- `(5775, 6128)` is generated by the sigma criterion with `k = 4`, `p = 383`. -/
theorem generated_5775_6128 : GeneratedBySigmaCriterion 4 383 5775 6128 := by
  refine ⟨by norm_num, by norm_num, by norm_num, by norm_num, by norm_num, by norm_num, ?_⟩
  rw [sigmaOne_5775]
  norm_num

/-- **Main result.** `(5775, 6128)` is a betrothed (quasi-amicable) pair, obtained from the
sigma criterion with `k = 4`, `p = 383`. -/
theorem betrothed_5775_6128 : IsBetrothedPair 5775 6128 :=
  isBetrothedPair_of_sigmaCriterion generated_5775_6128

/-- The same fact, verified directly from the kernel computations of `σ 5775` and `σ 6128`. -/
theorem betrothed_5775_6128_direct : IsBetrothedPair 5775 6128 :=
  ⟨by norm_num, by norm_num, by norm_num, by rw [sigmaOne_5775], by rw [sigmaOne_6128]⟩

