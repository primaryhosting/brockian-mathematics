import Mathlib

namespace Brockian.BetrothedNumbers

open Finset

/-- The sum-of-divisors function `σ₁ n = ∑_{d ∣ n} d`. -/
def sigmaOne (n : ℕ) : ℕ := ∑ d ∈ n.divisors, d

/-- Two distinct positive numbers `m` and `n` are a *betrothed* (quasi-amicable) pair when
each is the sum of the nontrivial proper divisors of the other, i.e.
`σ(m) = σ(n) = m + n + 1`. -/
def IsBetrothedPair (m n : ℕ) : Prop :=
  0 < m ∧ 0 < n ∧ m ≠ n ∧ sigmaOne m = m + n + 1 ∧ sigmaOne n = m + n + 1

/-- `σ` of a power of two. -/
lemma sigmaOne_two_pow (k : ℕ) : sigmaOne (2 ^ k) = 2 ^ (k + 1) - 1 := by
  rw [sigmaOne, Nat.sum_divisors_prime_pow Nat.prime_two]
  simp [Nat.geomSum_eq]

/-- `σ` of a prime. -/
lemma sigmaOne_prime {p : ℕ} (hp : p.Prime) : sigmaOne p = p + 1 := by
  have : sigmaOne (p ^ 1) = p + 1 := by
    rw [sigmaOne, Nat.sum_divisors_prime_pow hp]
    simp [Finset.sum_range_succ, add_comm]
  simpa using this

/-- The sigma value of `2 ^ k * p` for an odd prime `p`. -/
lemma sigmaOne_two_pow_mul_prime {k p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) :
    sigmaOne (2 ^ k * p) = (2 ^ (k + 1) - 1) * (p + 1) := by
  have hcop : Nat.Coprime (2 ^ k) p := by
    refine Nat.Coprime.pow_left _ ?_
    exact (Nat.coprime_primes Nat.prime_two hp).mpr (fun h => hp2 h.symm)
  rw [sigmaOne, hcop.sum_divisors_mul, ← sigmaOne, ← sigmaOne, sigmaOne_two_pow,
    sigmaOne_prime hp]

/-- The **sigma criterion** for generating a betrothed pair from parameters `k` and an odd
prime `p`: the second member is `n = 2 ^ k * p`, whose sigma value is forced to be
`(2 ^ (k+1) - 1) * (p + 1)`; if the number `m` determined by `m + n + 1 = σ(n)` is positive,
distinct from `n`, and has the same sigma value, then `(m, n)` is a betrothed pair. -/
def GeneratedBySigmaCriterion (k p m n : ℕ) : Prop :=
  p.Prime ∧ p ≠ 2 ∧ n = 2 ^ k * p ∧ 0 < m ∧ m ≠ n ∧
    m + n + 1 = (2 ^ (k + 1) - 1) * (p + 1) ∧ sigmaOne m = (2 ^ (k + 1) - 1) * (p + 1)

/-- Any pair produced by the sigma criterion is indeed a betrothed pair. -/
theorem isBetrothedPair_of_sigmaCriterion {k p m n : ℕ}
    (h : GeneratedBySigmaCriterion k p m n) : IsBetrothedPair m n := by
  obtain ⟨hp, hp2, hn, hm, hmn, hsum, hsig⟩ := h
  have hσn : sigmaOne n = (2 ^ (k + 1) - 1) * (p + 1) := by
    rw [hn]; exact sigmaOne_two_pow_mul_prime hp hp2
  refine ⟨hm, ?_, hmn, ?_, ?_⟩
  · subst hn
    exact Nat.mul_pos (Nat.two_pow_pos k) hp.pos
  · rw [hsig, hsum]
  · rw [hσn, hsum]

