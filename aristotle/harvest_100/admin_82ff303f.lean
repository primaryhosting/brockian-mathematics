namespace QPhys

open Matrix

variable {n : ℕ}

/-- The time-evolution operator `U(t) = exp(-i H t / ℏ)` generated by a Hamiltonian `H`
(represented as an `n × n` complex matrix), with reduced Planck constant `hbar`. -/
noncomputable def timeEvolution (hbar : ℝ) (H : Matrix (Fin n) (Fin n) ℂ) (t : ℝ) :
    Matrix (Fin n) (Fin n) ℂ :=
  NormedSpace.exp (-(Complex.I * (t / hbar)) • H)

/-- If `H` is self-adjoint, the generator `-i H t / ℏ` of the time evolution is skew-adjoint. -/
theorem conjTranspose_generator (hbar : ℝ) {H : Matrix (Fin n) (Fin n) ℂ}
    (hH : H.IsHermitian) (t : ℝ) :
    (-(Complex.I * (t / hbar)) • H)ᴴ = -(-(Complex.I * (t / hbar)) • H) := by
  simp [hH.eq]

/-- **Unitary time evolution.** For a self-adjoint Hamiltonian `H`, the operator
`U(t) = exp(-i H t / ℏ)` is unitary for every real time `t`. -/
theorem unitary_time_evolution (hbar : ℝ) {H : Matrix (Fin n) (Fin n) ℂ}
    (hH : H.IsHermitian) (t : ℝ) :
    timeEvolution hbar H t ∈ Matrix.unitaryGroup (Fin n) ℂ := by
  set A : Matrix (Fin n) (Fin n) ℂ := -(Complex.I * (t / hbar)) • H with hA
  have hstar : Aᴴ = -A := conjTranspose_generator hbar hH t
  rw [timeEvolution, ← hA, Matrix.mem_unitaryGroup_iff, Matrix.star_eq_conjTranspose,
    ← Matrix.exp_conjTranspose, hstar,
    ← Matrix.exp_add_of_commute _ _ (Commute.refl A).neg_right, add_neg_cancel,
    NormedSpace.exp_zero]

/-- Explicit form of unitarity: `U(t)ᴴ * U(t) = 1` and `U(t) * U(t)ᴴ = 1`. -/
theorem timeEvolution_conjTranspose_mul_self (hbar : ℝ) {H : Matrix (Fin n) (Fin n) ℂ}
    (hH : H.IsHermitian) (t : ℝ) :
    (timeEvolution hbar H t)ᴴ * timeEvolution hbar H t = 1 ∧
      timeEvolution hbar H t * (timeEvolution hbar H t)ᴴ = 1 := by
  have h := unitary_time_evolution hbar hH t
  rw [Matrix.mem_unitaryGroup_iff'] at h
  refine ⟨by simpa [Matrix.star_eq_conjTranspose] using h, ?_⟩
  have h' := unitary_time_evolution hbar hH t
  rw [Matrix.mem_unitaryGroup_iff] at h'
  simpa [Matrix.star_eq_conjTranspose] using h'

/-- `U(0) = 1`: no evolution at time zero. -/
theorem timeEvolution_zero (hbar : ℝ) (H : Matrix (Fin n) (Fin n) ℂ) :
    timeEvolution hbar H 0 = 1 := by
  simp [timeEvolution, NormedSpace.exp_zero]

/-- The group law `U(s + t) = U(s) * U(t)`. -/
theorem timeEvolution_add (hbar : ℝ) (H : Matrix (Fin n) (Fin n) ℂ) (s t : ℝ) :
    timeEvolution hbar H (s + t) = timeEvolution hbar H s * timeEvolution hbar H t := by
  have hgen : (-(Complex.I * ((s + t : ℝ) / hbar)) • H)
      = (-(Complex.I * (s / hbar)) • H) + (-(Complex.I * (t / hbar)) • H) := by
    rw [← add_smul]
    congr 1
    push_cast
    ring
  rw [timeEvolution, hgen,
    Matrix.exp_add_of_commute _ _ (((Commute.refl H).smul_left _).smul_right _)]
  rfl

section Hilbert

open NormedSpace

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]

/-- The time-evolution operator `U(t) = exp(-i H t / ℏ)` for a bounded Hamiltonian `H`
acting on a complex Hilbert space `E`. -/
noncomputable def timeEvolutionCLM (hbar : ℝ) (H : E →L[ℂ] E) (t : ℝ) : E →L[ℂ] E :=
  exp (-(Complex.I * (t / hbar)) • H)

/-- **Unitary time evolution on a Hilbert space.** For a bounded self-adjoint Hamiltonian `H`
on a complex Hilbert space, `U(t) = exp(-i H t / ℏ)` is unitary for every real time `t`. -/
theorem unitary_time_evolution_hilbert (hbar : ℝ) {H : E →L[ℂ] E} (hH : IsSelfAdjoint H)
    (t : ℝ) : timeEvolutionCLM hbar H t ∈ unitary (E →L[ℂ] E) := by
  letI : NormedAlgebra ℚ (E →L[ℂ] E) := .restrictScalars ℚ ℂ _
  apply exp_mem_unitary_of_mem_skewAdjoint
  rw [skewAdjoint.mem_iff, star_smul, hH.star_eq]
  simp [Complex.conj_ofReal]

/-- Unitary time evolution preserves the norm of every state, i.e. probability is conserved. -/
theorem norm_timeEvolutionCLM_apply (hbar : ℝ) {H : E →L[ℂ] E} (hH : IsSelfAdjoint H)
    (t : ℝ) (x : E) : ‖timeEvolutionCLM hbar H t x‖ = ‖x‖ :=
  ContinuousLinearMap.norm_map_of_mem_unitary (unitary_time_evolution_hilbert hbar hH t) x

end Hilbert

