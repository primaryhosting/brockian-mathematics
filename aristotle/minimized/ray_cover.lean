import Mathlib

set_option linter.mathlibStandardSet false

open scoped BigOperators
open scoped Real
open scoped Nat
open scoped Classical
open scoped Pointwise

set_option maxHeartbeats 0
set_option maxRecDepth 4000
set_option synthInstance.maxHeartbeats 20000
set_option synthInstance.maxSize 128

set_option relaxedAutoImplicit false
set_option autoImplicit false

noncomputable section

open scoped BigOperators

open Finset

/-- The `p`-ray indexed by `i : ZMod p` as a subset of `ℕ`. -/

def ray (p : ℕ) (i : ZMod p) : Set ℕ :=
  {n : ℕ | (n : ZMod p) = i}

/-- Membership in a ray is exactly the cast-to-`ZMod p` equality. -/

theorem ray_cover (p : ℕ) (n : ℕ) : ∃ i : ZMod p, n ∈ ray p i := by
  refine ⟨(n : ZMod p), ?_⟩
  simp [ray]

/-- Cycle adjacency on `ZMod p`: neighbors differ by `±1`. -/
