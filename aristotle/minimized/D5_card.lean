/-- A unitary representation of a group on a Hilbert space. -/
structure UnitaryRep (G : Type*) [Group G] (H : Type*) 
    [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H] where
  /-- The group homomorphism to unitary operators. -/
  ρ : G →* (H ≃ₗᵢ[ℂ] H)

/-- Unitary representations preserve inner products. -/

theorem UnitaryRep.preserves_inner {G : Type*} [Group G] {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H] (rep : UnitaryRep G H) (g : G) (x y : H) :
    inner ℂ (rep.ρ g x) (rep.ρ g y) = inner ℂ x y :=
  (rep.ρ g).inner_map_map x y

/-- Convert to continuous linear map. -/

def UnitaryRep.toCLM {G : Type*} [Group G] {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H] (rep : UnitaryRep G H) (g : G) : H →L[ℂ] H := (rep.ρ g).toContinuousLinearEquiv

/-- Adjoint equals inverse for unitary operators. -/

theorem UnitaryRep.star_eq_inv {G : Type*} [Group G] {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H] (rep : UnitaryRep G H) (g : G) : star (rep.toCLM g) = rep.toCLM g⁻¹ := by
