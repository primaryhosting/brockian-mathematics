/-- PSD ordering: M ⪯ N means N - M is PSD -/

def e {V : Type*} [Fintype V] [DecidableEq V] (v : V) : V → ℝ := fun i => if i = v then 1 else 0

/-- Rank-1 edge matrix (e_u - e_v)(e_u - e_v)^T -/

def edgeMat {V : Type*} [Fintype V] [DecidableEq V] (u v : V) : Matrix V V ℝ :=
  Matrix.vecMulVec (e u - e v) (e u - e v)

/--
Vertex chunk: A_v := (1/2) Σ_{u~v} (e_v - e_u)(e_v - e_u)^T

These are PSD vertex contributions. Summing over all vertices 
recovers the Laplacian.
-/

def Av {V : Type*} [Fintype V] [DecidableEq V] (G : SimpleGraph V) (v : V) : Matrix V V ℝ := by
  classical
  exact ((1/2 : ℝ) • ∑ u ∈ G.neighborFinset v, edgeMat v u)

open scoped BigOperators Matrix
open Finset Matrix SimpleGraph Real

/-- Laplacian matrix L (Mathlib built-in) -/
abbrev L {V : Type*} [Fintype V] [DecidableEq V] (G : SimpleGraph V) : Matrix V V ℝ :=
  G.lapMatrix ℝ

/--
G_S = (V, E(S,S)) as in Question 6:
Same vertex set V, edges restricted to pairs inside S.
-/

def IsEpsilonLight {V : Type*} [Fintype V] [DecidableEq V] (G : SimpleGraph V) (S : Finset V) (ε : ℝ) : Prop :=
  (ε • L G - Ls G S).PosSemidef

/--
If Σ_{v∈S} A_v ⪯ εL, then S is ε-light.

Proof: PSD is closed under addition:
  εL - L_S = (εL - Σ A_v) + (Σ A_v - L_S)
-/

theorem epsilonLight_of_sumAv {V : Type*} [Fintype V] [DecidableEq V] (G : SimpleGraph V) (S : Finset V) (ε : ℝ)
    (hBridge : Ls G S ⪯ ∑ v ∈ S, Av G v) :
    (∑ v ∈ S, Av G v) ⪯ ε • L G → IsEpsilonLight G S ε := by
      intro h;
      -- By transitivity of the PSD order, if L_S ≤ ∑_{v ∈ S} A_v and ∑_{v ∈ S} A_v ≤ ε • L, then L_S ≤ ε • L.
      have hTrans : (ε • L G - Ls G S).PosSemidef := by
        have h1 : (ε • L G - ∑ v ∈ S, Av G v).PosSemidef := by
          exact?
        have h2 : (∑ v ∈ S, Av G v - Ls G S).PosSemidef := by
          exact?
        convert h1.add h2 using 1 ; abel_nf;
      exact hTrans
