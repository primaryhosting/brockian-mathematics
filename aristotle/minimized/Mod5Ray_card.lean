/-- Ray classification based on mod 5 residues -/
inductive Mod5Ray : Type
  | ray_0 : Mod5Ray  -- n ≡ 0 (mod 5)
  | ray_1 : Mod5Ray  -- n ≡ 1 (mod 5) 
  | ray_2 : Mod5Ray  -- n ≡ 2 (mod 5)
  | ray_3 : Mod5Ray  -- n ≡ 3 (mod 5)
  | ray_4 : Mod5Ray  -- n ≡ 4 (mod 5)
  deriving DecidableEq, Inhabited, Fintype

def Mod5Ray.toNat : Mod5Ray → Fin 5
  | ray_0 => 0
  | ray_1 => 1
  | ray_2 => 2
  | ray_3 => 3
  | ray_4 => 4

def Mod5Ray.toString : Mod5Ray → String
  | ray_0 => "Ray_0"
  | ray_1 => "Ray_1"
  | ray_2 => "Ray_2"
  | ray_3 => "Ray_3"
  | ray_4 => "Ray_4"

instance : ToString Mod5Ray := ⟨Mod5Ray.toString⟩

theorem Mod5Ray.card : Fintype.card Mod5Ray = 5 := by decide

/-- Ray assignment function -/

def assignRay (n : ℕ) : Mod5Ray :=
  match n % 5 with
  | 0 => Mod5Ray.ray_0
  | 1 => Mod5Ray.ray_1
  | 2 => Mod5Ray.ray_2
  | 3 => Mod5Ray.ray_3
  | _ => Mod5Ray.ray_4

def rayTransition (p g : ℕ) : Mod5Ray × Mod5Ray :=
  (assignRay p, assignRay (p + g))

/-- THEOREM: Twin primes follow exactly 3 transitions -/

theorem twin_prime_transitions (p : ℕ) (hp : Nat.Prime p) (hp2 : Nat.Prime (p + 2))
    (h : p > 5) :
    rayTransition p 2 ∈
    ({(Mod5Ray.ray_1, Mod5Ray.ray_3),
      (Mod5Ray.ray_2, Mod5Ray.ray_4),
      (Mod5Ray.ray_4, Mod5Ray.ray_1)} : Finset (Mod5Ray × Mod5Ray)) := by
        -- Since $p$ is a prime greater than 5, it must be of the form $5k+1$, $5k+2$, $5k+3$, or $5k+4$.
        have h_mod : p % 5 = 1 ∨ p % 5 = 2 ∨ p % 5 = 3 ∨ p % 5 = 4 := by
          have := Nat.mod_lt p ( by decide : 5 > 0 ) ; interval_cases _ : p % 5 <;> simp_all +decide [ ← Nat.dvd_iff_mod_eq_zero, hp.dvd_iff_eq ] ;
        rcases h_mod with ( h | h | h | h ) <;> unfold rayTransition <;> simp +decide [ *, Nat.add_mod ];
        · unfold assignRay; simp +decide [ *, Nat.add_mod ] ;
        · unfold assignRay; simp +decide [ *, Nat.add_mod ] ;
        · exact absurd ( Nat.dvd_of_mod_eq_zero ( show ( p + 2 ) % 5 = 0 from by norm_num [ Nat.add_mod, h ] ) ) ( by rw [ hp2.dvd_iff_eq ] <;> linarith );
        · unfold assignRay; simp +decide [ *, Nat.add_mod ] ;

/-- Corollary: 100% of twins follow these transitions -/

theorem twin_prime_complete_clustering (x : ℕ) (hx : x > 5) :
    let total_twins := (Finset.range (x + 1)).filter (fun p =>
      Nat.Prime p ∧ Nat.Prime (p + 2) ∧ p > 5) |>.card
    let allowed_twins := (Finset.range (x + 1)).filter (fun p =>
      Nat.Prime p ∧ Nat.Prime (p + 2) ∧ p > 5 ∧
      rayTransition p 2 ∈ ({(Mod5Ray.ray_1, Mod5Ray.ray_3),
                            (Mod5Ray.ray_2, Mod5Ray.ray_4),
                            (Mod5Ray.ray_4, Mod5Ray.ray_1)} :
                           Finset (Mod5Ray × Mod5Ray))) |>.card
    allowed_twins = total_twins := by
      -- Since any twin prime pair (p, p+2) with p > 5 must have rayTransition p 2 in the allowed set, the two sets are equal.
      have h_eq_sets : {p ∈ Finset.range (x + 1) | Nat.Prime p ∧ Nat.Prime (p + 2) ∧ p > 5} = {p ∈ Finset.range (x + 1) | Nat.Prime p ∧ Nat.Prime (p + 2) ∧ p > 5 ∧ rayTransition p 2 ∈ ({(Mod5Ray.ray_1, Mod5Ray.ray_3), (Mod5Ray.ray_2, Mod5Ray.ray_4), (Mod5Ray.ray_4, Mod5Ray.ray_1)} : Finset (Mod5Ray × Mod5Ray))} := by
        -- By definition of rayTransition, if p is a twin prime greater than 5, then rayTransition p 2 must be one of the allowed transitions.
        have h_reverse : ∀ p, Nat.Prime p → Nat.Prime (p + 2) → p > 5 → rayTransition p 2 ∈ ({(Mod5Ray.ray_1, Mod5Ray.ray_3), (Mod5Ray.ray_2, Mod5Ray.ray_4), (Mod5Ray.ray_4, Mod5Ray.ray_1)} : Finset (Mod5Ray × Mod5Ray)) := by
          -- By definition of rayTransition, we know that for any twin prime p > 5, rayTransition p 2 is in the set {(Mod5Ray.ray_1, Mod5Ray.ray_3), (Mod5Ray.ray_2, Mod5Ray.ray_4), (Mod5Ray.ray_4, Mod5Ray.ray_1)}.
          intros p hp hp2 hp_gt5
          apply twin_prime_transitions p hp hp2 hp_gt5;
        grind;
      -- Since the sets are equal, their cardinalities are equal.
      apply congr_arg Finset.card h_eq_sets.symm

theorem cousin_prime_transitions (p : ℕ) (hp : Nat.Prime p) (hp4 : Nat.Prime (p + 4))
    (h : p > 5) :
    rayTransition p 4 ∈
    ({(Mod5Ray.ray_2, Mod5Ray.ray_1),
      (Mod5Ray.ray_3, Mod5Ray.ray_2),
      (Mod5Ray.ray_4, Mod5Ray.ray_3)} : Finset (Mod5Ray × Mod5Ray)) := by
        -- By examining the possible values of $p \mod 5$, we can see that the only valid transitions are $(Mod5Ray.ray_2, Mod5Ray.ray_1)$, $(Mod5Ray.ray_3, Mod5Ray.ray_2)$, and $(Mod5Ray.ray_4, Mod5Ray.ray_3)$.
        have h_cases : p % 5 = 2 ∨ p % 5 = 3 ∨ p % 5 = 4 := by
          -- Since $p$ is a prime greater than 5, it cannot be divisible by 5. Therefore, $p \mod 5$ must be 1, 2, 3, or 4.
          have h_mod5 : p % 5 ≠ 0 := by
            exact fun con => by have := Nat.dvd_of_mod_eq_zero con; rw [ hp.dvd_iff_eq ] at this <;> linarith;
          -- Since $p$ is a prime greater than 5, it cannot be divisible by 5. Therefore, $p \mod 5$ must be 1, 2, 3, or 4. However, if $p \mod 5 = 1$, then $p + 4$ would be divisible by 5, which contradicts the fact that $p + 4$ is prime. Hence, $p \mod 5$ must be 2, 3, or 4.
          have h_mod5_cases : p % 5 = 1 → False := by
            exact fun h => by have := Nat.dvd_of_mod_eq_zero ( show ( p + 4 ) % 5 = 0 by norm_num [ Nat.add_mod, h ] ) ; rw [ hp4.dvd_iff_eq ] at this <;> linarith;
          have := Nat.mod_lt p ( by decide : 5 > 0 ) ; interval_cases _ : p % 5 <;> tauto;
        rcases h_cases with ( h_cases | h_cases | h_cases ) <;> unfold rayTransition <;> simp +decide [ *, Nat.add_mod ];
        · unfold assignRay; simp +decide [ *, Nat.add_mod ] ;
        · unfold assignRay; simp +decide [ *, Nat.add_mod ] ;
        · unfold assignRay; simp +decide [ *, Nat.add_mod ] ;

theorem sexy_prime_transitions (p : ℕ) (hp : Nat.Prime p) (hp6 : Nat.Prime (p + 6))
    (h : p > 5) :
    rayTransition p 6 ∈
    ({(Mod5Ray.ray_1, Mod5Ray.ray_2),
      (Mod5Ray.ray_2, Mod5Ray.ray_3),
      (Mod5Ray.ray_3, Mod5Ray.ray_4)} : Finset (Mod5Ray × Mod5Ray)) := by
        -- Since p is prime and greater than 5, its residue modulo 5 must be 1, 2, 3, or 4. Therefore, the ray of p is either ray_1, ray_2, ray_3, or ray_4.
        have h_residue : p % 5 = 1 ∨ p % 5 = 2 ∨ p % 5 = 3 ∨ p % 5 = 4 := by
          -- Since p is a prime greater than 5, it cannot be divisible by 5. Therefore, p % 5 must be 1, 2, 3, or 4.
          have h_mod : p % 5 ≠ 0 := by
            exact fun con => by have := Nat.dvd_of_mod_eq_zero con; rw [ hp.dvd_iff_eq ] at this <;> linarith;
          generalize_proofs at *; (
          -- Since p is a prime greater than 5, it cannot be divisible by 5. Therefore, p % 5 must be 1, 2, 3, or 4. We can use the fact that the remainder when dividing by 5 can only be 0, 1, 2, 3, or 4.
          have h_mod : p % 5 < 5 := by
            exact Nat.mod_lt _ ( by decide )
          generalize_proofs at *; (
          interval_cases p % 5 <;> trivial;));
        -- By definition of rayTransition, we have rayTransition p 6 = (assignRay p, assignRay (p + 6)).
        simp [rayTransition, assignRay];
        rcases h_residue with ( h | h | h | h ) <;> norm_num [ Nat.add_mod, h ];
        -- Since $p \equiv 4 \pmod{5}$ and $p + 6 \equiv 0 \pmod{5}$, we have $p + 6$ is divisible by 5.
        have h_div : 5 ∣ (p + 6) := by
          norm_num [ Nat.dvd_iff_mod_eq_zero, Nat.add_mod, h ];
        rw [ hp6.dvd_iff_eq ] at h_div <;> linarith

/-- Prime Triplets (p, p+2, p+6) -/

theorem triplet_026_patterns (p : ℕ) (hp : Nat.Prime p) (hp2 : Nat.Prime (p + 2))
    (hp6 : Nat.Prime (p + 6)) (h : p > 5) :
    (assignRay p, assignRay (p + 2), assignRay (p + 6)) ∈
    ({(Mod5Ray.ray_1, Mod5Ray.ray_3, Mod5Ray.ray_2),
      (Mod5Ray.ray_2, Mod5Ray.ray_4, Mod5Ray.ray_3)} :
     Finset (Mod5Ray × Mod5Ray × Mod5Ray)) := by
       -- By examining the possible values of $p \mod 5$, we can see that the only valid triplets are $(1, 3, 2)$ and $(2, 4, 3)$.
       have h_cases : (p % 5 = 1 ∧ (p + 2) % 5 = 3 ∧ (p + 6) % 5 = 2) ∨ (p % 5 = 2 ∧ (p + 2) % 5 = 4 ∧ (p + 6) % 5 = 3) := by
         -- By examining the possible values of $p \mod 5$, we can see that the only valid triplets are $(1, 3, 2)$ and $(2, 4, 3)$ because $p$ cannot be divisible by 5.
         have h_cases : p % 5 ≠ 0 ∧ (p + 2) % 5 ≠ 0 ∧ (p + 6) % 5 ≠ 0 := by
           exact ⟨ fun h' => by have := Nat.dvd_of_mod_eq_zero h'; rw [ hp.dvd_iff_eq ] at this <;> linarith, fun h' => by have := Nat.dvd_of_mod_eq_zero h'; rw [ hp2.dvd_iff_eq ] at this <;> linarith, fun h' => by have := Nat.dvd_of_mod_eq_zero h'; rw [ hp6.dvd_iff_eq ] at this <;> linarith ⟩;
         norm_num [ Nat.add_mod ] at h_cases ⊢; have := Nat.mod_lt p ( by decide : 5 > 0 ) ; interval_cases p % 5 <;> trivial;
       unfold assignRay; aesop;

theorem quadruplet_unique_pattern (p : ℕ) (hp : Nat.Prime p) (hp2 : Nat.Prime (p + 2))
    (hp6 : Nat.Prime (p + 6)) (hp8 : Nat.Prime (p + 8)) (h : p > 5) :
    (assignRay p, assignRay (p + 2), assignRay (p + 6), assignRay (p + 8)) =
    (Mod5Ray.ray_1, Mod5Ray.ray_3, Mod5Ray.ray_2, Mod5Ray.ray_4) := by
      -- By examining the possible values of $p \mod 5$, we can deduce the rays for $p$, $p+2$, $p+6$, and $p+8$.
      have h_mod5 : p % 5 = 1 := by
        -- Since $p$, $p+2$, $p+6$, and $p+8$ are all primes greater than 5, they cannot be divisible by 5.
        have h_not_div_5 : ¬(5 ∣ p) ∧ ¬(5 ∣ (p + 2)) ∧ ¬(5 ∣ (p + 6)) ∧ ¬(5 ∣ (p + 8)) := by
          norm_num [ Nat.Prime.dvd_iff_eq hp, Nat.Prime.dvd_iff_eq hp2, Nat.Prime.dvd_iff_eq hp6, Nat.Prime.dvd_iff_eq hp8 ];
          grind;
        grind;
      -- Since $p \mod 5 = 1$, we have $p + 2 \mod 5 = 3$, $p + 6 \mod 5 = 2$, and $p + 8 \mod 5 = 4$.
      have h_mod5_add : (p + 2) % 5 = 3 ∧ (p + 6) % 5 = 2 ∧ (p + 8) % 5 = 4 := by
        norm_num [ Nat.add_mod, h_mod5 ];
      -- By definition of assignRay, we can conclude the equalities for each component.
      simp [assignRay, h_mod5, h_mod5_add]

