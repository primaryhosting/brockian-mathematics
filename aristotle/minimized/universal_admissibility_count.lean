        rw [ show ( Finset.univ.filter fun n : ZMod q => n ≠ 0 ∧ n ≠ - ( g : ZMod q ) ) = Finset.univ \ { 0, - ( g : ZMod q ) } by ext; aesop ];
        rw [ Finset.card_sdiff ] ; norm_num [ Finset.card_univ, hg ];
      unfold admissible_residues;
      simpa [ add_eq_zero_iff_eq_neg ] using h_card

