/-- The set of primes p ≤ n/2 such that n - p is also prime.
We restrict to p ≤ n/2 to avoid counting (p, n-p) and (n-p, p) separately. -/

def goldbachPairs (n : ℕ) : Finset ℕ :=
  (Finset.range (n / 2 + 1)).filter (fun p => Nat.Prime p ∧ Nat.Prime (n - p))

/-- **Goldbach representation count** G(n): number of prime pairs summing to n.

For n = 10: {(3,7), (5,5)} → G(10) = 2
For n = 12: {(5,7)} → G(12) = 1
For large even n, Hardy-Littlewood predicts G(n) ~ C(n) · n/(log n)²
where C(n) is the singular series. -/

def goldbachReps (n : ℕ) : ℕ := (goldbachPairs n).card

/-- Goldbach reps are nonnegative (trivial but useful) -/

lemma goldbachReps_nonneg (n : ℕ) : 0 ≤ goldbachReps n := by
  -- The cardinality of any set is non-negative.
  apply Nat.zero_le

/-- **Key bridge lemma**: If G(n) ≥ 1, then Goldbach holds for n.
This is the "representation count → existence" direction. -/

def Goldbach (n : ℕ) : Prop :=
  ∃ p q, Nat.Prime p ∧ Nat.Prime q ∧ p + q = n

/-- **Weak Goldbach**: Every odd n > 5 is a sum of three primes
