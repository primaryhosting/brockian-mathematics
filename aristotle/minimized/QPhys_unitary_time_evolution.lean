namespace QPhys

open NormedSpace

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]

/-- The time-evolution operator `U(t) = exp(-i H t / ℏ)` generated by a bounded operator `H`
(the Hamiltonian) on a complex Hilbert space `E`, with reduced Planck constant `ℏ`. -/

noncomputable def timeEvolution (hbar : ℝ) (H : E →L[ℂ] E) (t : ℝ) : E →L[ℂ] E :=
  exp ((-Complex.I * (t / hbar) : ℂ) • H)

/-- If `H` is self-adjoint, then `-i (t/ℏ) H` is skew-adjoint for every real `t`. -/

theorem smul_selfAdjoint_mem_skewAdjoint {hbar : ℝ} {H : E →L[ℂ] E}
    (hH : IsSelfAdjoint H) (t : ℝ) :
    ((-Complex.I * (t / hbar) : ℂ) • H) ∈ skewAdjoint (E →L[ℂ] E) := by
  rw [skewAdjoint.mem_iff, star_smul, hH.star_eq]
  rw [← neg_smul]
  congr 1
  simp

/-- **Unitarity of quantum time evolution.** For a self-adjoint (bounded) Hamiltonian `H` on a
complex Hilbert space, the operator `U(t) = exp(-i H t / ℏ)` is unitary for every real time `t`. -/

theorem unitary_time_evolution (hbar : ℝ) (H : E →L[ℂ] E) (hH : IsSelfAdjoint H) (t : ℝ) :
    timeEvolution hbar H t ∈ unitary (E →L[ℂ] E) := by
  let +nondep : NormedAlgebra ℚ (E →L[ℂ] E) := .restrictScalars ℚ ℂ _
  exact exp_mem_unitary_of_mem_skewAdjoint (smul_selfAdjoint_mem_skewAdjoint hH t)

/-- Explicit form of unitarity: `U(t)⋆ * U(t) = 1` and `U(t) * U(t)⋆ = 1`. -/
