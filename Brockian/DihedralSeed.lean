/-
Rotation on indices: +1 in ZMod 5.
-/
def Brock.Core.rot (a : ZMod 5) : ZMod 5 := a + 1

#check star

#check Complex.exp

#check (star : ℂ → ℂ)

#check Complex.I

#check Real.pi

/-
Reflection on geometry: complex conjugation.
-/
def Brock.Core.ref (z : ℂ) : ℂ := star z

/-
Primitive 5th root of unity in ℂ.
-/
def Brock.Core.ω : ℂ := Complex.exp (2 * Real.pi * Complex.I / 5)

/-
Embedding of ZMod 5 into ℂ by powers of ω (using `val`).
-/
