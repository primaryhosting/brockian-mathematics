    rw [ ← Complex.exp_nat_mul ] ; ring;
  exact h_exp.trans ( Complex.exp_two_pi_mul_I )

/-
emb is 5-periodic: emb(a+5) = emb(a).
-/
lemma Brock.Geom.emb_periodic (a : ZMod 5) : Brock.Geom.ω ^ (a.val + 5) = Brock.Geom.ω ^ a.val := by
  rw [ pow_add, Brock.Geom.ω_pow_five, mul_one ]

/-
The rotation equivariance: emb(rot a) = ω · emb(a).
-/
lemma Brock.Geom.emb_rot (a : ZMod 5) : Brock.Geom.emb (Brock.Geom.rot a) = Brock.Geom.ω * Brock.Geom.emb a := by
  unfold Brock.Geom.emb Brock.Geom.rot;
  fin_cases a <;> simp +decide [ pow_succ' ];
  · exact pow_one _;
  · simp +decide [ ZMod.val ] ; ring!;
    rfl;
  · exact?;
  · simp +decide [ ZMod.val ] ; ring!;
    rfl;
  · norm_num [ ZMod.val ];
    rw [ ← pow_succ', Brock.Geom.ω_pow_five ]

/-
Rotation is a distance-preserving map on the pentagon.
-/
theorem Brock.Geom.pentDist_rot_invariant (a b : ZMod 5) :
    Brock.Geom.pentDist (Brock.Geom.rot a) (Brock.Geom.rot b) = Brock.Geom.pentDist a b := by
