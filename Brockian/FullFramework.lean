Corrected Transition predicate: s is in the domain, and the labels are i and j. We do NOT require step(s) to be in the domain, to match the Good-Start Law.
-/
def Brock.KernelV2.Transition {S : Type u} {k : ℕ} (sys : Brock.Kernel.LabeledSystem S k) (i j : Fin k) (s : S) : Prop :=
  sys.dom s ∧
  sys.label s = i ∧ sys.label (sys.step s) = j

/-
The corrected transition-count kernel K(i,j).
-/
def Brock.KernelV2.K {S : Type u} [Fintype S] {k : ℕ} (sys : Brock.Kernel.LabeledSystem S k) [DecidablePred sys.dom] (i j : Fin k) : ℕ :=
  (Finset.univ.filter (Brock.KernelV2.Transition sys i j)).card

/-
Corrected Row predicate.
-/
def Brock.KernelV2.RowPred {S : Type u} {k : ℕ} (sys : Brock.Kernel.LabeledSystem S k) (i : Fin k) (s : S) : Prop :=
  sys.dom s ∧ sys.label s = i

/-
Corrected Column predicate.
-/
def Brock.KernelV2.ColPred {S : Type u} {k : ℕ} (sys : Brock.Kernel.LabeledSystem S k) (j : Fin k) (s : S) : Prop :=
  sys.dom s ∧ sys.label (sys.step s) = j

/-
Decidability for RowPred V2.
-/
instance {S : Type u} [Fintype S] {k : ℕ} {sys : Brock.Kernel.LabeledSystem S k} [DecidablePred sys.dom] (i : Fin k) :
    DecidablePred (Brock.KernelV2.RowPred sys i) :=
  fun s => inferInstanceAs (Decidable (sys.dom s ∧ sys.label s = i))

/-
Decidability for ColPred V2.
-/
instance {S : Type u} [Fintype S] {k : ℕ} {sys : Brock.Kernel.LabeledSystem S k} [DecidablePred sys.dom] (j : Fin k) :
    DecidablePred (Brock.KernelV2.ColPred sys j) :=
  fun s => inferInstanceAs (Decidable (sys.dom s ∧ sys.label (sys.step s) = j))

/-
Row-sum theorem V2.
-/
theorem Brock.KernelV2.row_sum {S : Type u} [Fintype S] {k : ℕ} (sys : Brock.Kernel.LabeledSystem S k) [DecidablePred sys.dom] (i : Fin k) :
    ∑ j : Fin k, Brock.KernelV2.K sys i j =
    (Finset.univ.filter (Brock.KernelV2.RowPred sys i)).card := by
      unfold Brock.KernelV2.K;
      simp +decide only [Finset.card_filter, Transition, RowPred];
      rw [ Finset.sum_comm, Finset.sum_congr rfl ] ; aesop

/-
Column-sum theorem V2.
-/
theorem Brock.KernelV2.col_sum {S : Type u} [Fintype S] {k : ℕ} (sys : Brock.Kernel.LabeledSystem S k) [DecidablePred sys.dom] (j : Fin k) :
    ∑ i : Fin k, Brock.KernelV2.K sys i j =
    (Finset.univ.filter (Brock.KernelV2.ColPred sys j)).card := by
      simp +decide only [K];
      simp +decide only [Finset.card_filter];
      rw [ Finset.sum_comm ];
      refine' Finset.sum_congr rfl fun x _ => _;
      unfold Brock.KernelV2.Transition Brock.KernelV2.ColPred; aesop;

/-
Total-sum theorem V2: sum equals |dom|.
-/
theorem Brock.KernelV2.total_sum {S : Type u} [Fintype S] {k : ℕ} (sys : Brock.Kernel.LabeledSystem S k) [DecidablePred sys.dom] :
    ∑ i : Fin k, ∑ j : Fin k, Brock.KernelV2.K sys i j =
    (Finset.univ.filter sys.dom).card := by
      convert Brock.KernelV2.col_sum sys using 1;
      constructor <;> intro h;
      · exact?;
      · rw [ Finset.sum_comm, Finset.sum_congr rfl fun j _ => h j ];
        rw [ ← Finset.card_biUnion ];
        · congr with x ; simp +decide [ Brock.KernelV2.ColPred ];
        · intro i _ j _ hij; simp_all +decide [ Finset.disjoint_left, Brock.KernelV2.ColPred ] ;

/-
The Brockian transition matrix as a 2×2 real matrix. M = [[1, 1], [1, 0]]
-/
def Brock.Eigenvalue.M : Matrix (Fin 2) (Fin 2) ℝ :=
  !![1, 1; 1, 0]

/-
The golden ratio φ = (1 + √5) / 2.
-/
noncomputable def Brock.Eigenvalue.φ : ℝ := (1 + Real.sqrt 5) / 2

/-
The conjugate of the golden ratio ψ = (1 - √5) / 2.
-/
noncomputable def Brock.Eigenvalue.ψ : ℝ := (1 - Real.sqrt 5) / 2

/-
φ is positive.
-/
lemma Brock.Eigenvalue.φ_pos : 0 < Brock.Eigenvalue.φ := by
  exact div_pos ( by positivity ) ( by positivity )

/-
φ > 1.
-/
lemma Brock.Eigenvalue.φ_gt_one : 1 < Brock.Eigenvalue.φ := by
  exact lt_div_iff₀' zero_lt_two |>.2 ( by nlinarith [ Real.sqrt_nonneg 5, Real.sq_sqrt ( show 0 ≤ 5 by norm_num ) ] )

/-
The defining identity: φ² = φ + 1.
-/
theorem Brock.Eigenvalue.φ_sq : Brock.Eigenvalue.φ ^ 2 = Brock.Eigenvalue.φ + 1 := by
  unfold Brock.Eigenvalue.φ; ring_nf; norm_num; ring;

/-
Similarly: ψ² = ψ + 1.
-/
theorem Brock.Eigenvalue.ψ_sq : Brock.Eigenvalue.ψ ^ 2 = Brock.Eigenvalue.ψ + 1 := by
  unfold Brock.Eigenvalue.ψ; ring_nf; norm_num; ring;

/-
φ + ψ = 1 (sum of roots = trace of M).
-/
theorem Brock.Eigenvalue.φ_add_ψ : Brock.Eigenvalue.φ + Brock.Eigenvalue.ψ = 1 := by
  unfold Brock.Eigenvalue.φ Brock.Eigenvalue.ψ; ring;

/-
φ * ψ = -1 (product of roots = determinant of M = 0·1 - 1·1 = -1).
-/
theorem Brock.Eigenvalue.φ_mul_ψ : Brock.Eigenvalue.φ * Brock.Eigenvalue.ψ = -1 := by
  unfold Brock.Eigenvalue.φ Brock.Eigenvalue.ψ; ring_nf; norm_num;

/-
φ and ψ are the roots of the characteristic polynomial x² - x - 1 = 0.
-/
theorem Brock.Eigenvalue.φ_is_root : Brock.Eigenvalue.φ ^ 2 - Brock.Eigenvalue.φ - 1 = 0 := by
  rw [ show Brock.Eigenvalue.φ = ( 1 + Real.sqrt 5 ) / 2 by rfl ] ; ring_nf ; norm_num;

/-
ψ is a root.
-/
theorem Brock.Eigenvalue.ψ_is_root : Brock.Eigenvalue.ψ ^ 2 - Brock.Eigenvalue.ψ - 1 = 0 := by
  rw [ show Brock.Eigenvalue.ψ = ( 1 - Real.sqrt 5 ) / 2 by rfl ] ; ring_nf ; norm_num;

/-
φ is an eigenvalue of M.
-/
theorem Brock.Eigenvalue.φ_is_eigenvalue : (Brock.Eigenvalue.M.mulVec ![(1 : ℝ), 1/Brock.Eigenvalue.φ]) = Brock.Eigenvalue.φ • ![(1 : ℝ), 1/Brock.Eigenvalue.φ] := by
  ext i; fin_cases i <;> norm_num [ Brock.Eigenvalue.M ] ; ring;
  · field_simp;
    rw [ add_div', div_eq_iff ] <;> nlinarith [ Brock.Eigenvalue.φ_pos, Brock.Eigenvalue.φ_sq ];
  · rw [ mul_inv_cancel₀ ( by exact ne_of_gt ( by exact ( by exact ( by exact ( show 0 < ( 1 + Real.sqrt 5 ) / 2 by positivity ) ) ) ) ) ]

/-
ψ is an eigenvalue of M.
-/
theorem Brock.Eigenvalue.ψ_is_eigenvalue : (Brock.Eigenvalue.M.mulVec ![(1 : ℝ), 1/Brock.Eigenvalue.ψ]) = Brock.Eigenvalue.ψ • ![(1 : ℝ), 1/Brock.Eigenvalue.ψ] := by
  ext i; fin_cases i <;> norm_num [ Matrix.vecHead, Matrix.vecTail, Matrix.mulVec ] ; ring!;
  · unfold Brock.Eigenvalue.M Brock.Eigenvalue.ψ; norm_num; ring; norm_num;
    grind;
  · norm_num [ Brock.Eigenvalue.M, Brock.Eigenvalue.ψ ];
    grind

/-
The Fibonacci sequence satisfies the Brockian recurrence.
-/
def Brock.Eigenvalue.Fib : ℕ → ℕ
  | 0 => 0
  | 1 => 1
  | (n + 2) => Brock.Eigenvalue.Fib (n + 1) + Brock.Eigenvalue.Fib n

/-
The Fibonacci recurrence is Fib(n+2) = Fib(n+1) + Fib(n).
-/
theorem Brock.Eigenvalue.fib_recurrence (n : ℕ) : Brock.Eigenvalue.Fib (n + 2) = Brock.Eigenvalue.Fib (n + 1) + Brock.Eigenvalue.Fib n := rfl

/-
M^n encodes Fibonacci numbers: (M^n)₀₀ = Fib(n+1).
-/
theorem Brock.Eigenvalue.M_pow_fib (n : ℕ) :
    (Brock.Eigenvalue.M ^ n) 0 0 = (Brock.Eigenvalue.Fib (n + 1) : ℝ) := by
      induction' n using Nat.strong_induction_on with n ih;
      rcases n with ( _ | _ | n ) <;> norm_num [ pow_succ, Matrix.mul_apply ] at *;
      · norm_cast;
      · exact?;
      · have h_recurrence : ∀ (n : ℕ), (Brock.Eigenvalue.M ^ (n + 2)) 0 0 = (Brock.Eigenvalue.M ^ (n + 1)) 0 0 + (Brock.Eigenvalue.M ^ n) 0 0 := by
          intro n; rw [ pow_succ', pow_succ' ] ; norm_num [ Matrix.mul_apply ] ; ring;
          unfold Brock.Eigenvalue.M; norm_num; ring;
        convert h_recurrence n using 1 ; ring;
        · rw [ add_comm 2 n, pow_add ] ; simp +decide [ Matrix.mul_apply ] ; ring;
          norm_num [ sq, Matrix.mul_apply ] ; ring;
        · rw [ ih _ <| Nat.lt_succ_self _, ih _ <| Nat.lt_succ_of_lt <| Nat.lt_succ_self _ ] ; norm_cast

/-
Binet's formula (statement): Fib(n) = (φⁿ - ψⁿ) / √5.
-/
theorem Brock.Eigenvalue.binet_formula (n : ℕ) :
    (Brock.Eigenvalue.Fib n : ℝ) = (Brock.Eigenvalue.φ ^ n - Brock.Eigenvalue.ψ ^ n) / Real.sqrt 5 := by
      -- We'll use induction to prove that the formula holds for all n.
      induction' n using Nat.strong_induction_on with n ih;
      rcases n with ( _ | _ | n ) <;> norm_num [ ih, Brock.Eigenvalue.fib_recurrence ];
      · unfold Brock.Eigenvalue.φ Brock.Eigenvalue.ψ; ring_nf; norm_num;
        rfl;
      · rw [ ih n ( by linarith ) ] ; ring ; norm_num [ pow_succ, Brock.Eigenvalue.φ, Brock.Eigenvalue.ψ ] ; ring;

/-
Decidability for RowPred V2.
-/
instance {S : Type u} [Fintype S] {k : ℕ} {sys : Brock.Kernel.LabeledSystem S k} [DecidablePred sys.dom] (i : Fin k) :
    DecidablePred (Brock.KernelV2.RowPred sys i) :=
  fun s => inferInstanceAs (Decidable (sys.dom s ∧ sys.label s = i))

/-
Decidability for ColPred V2.
-/
instance {S : Type u} [Fintype S] {k : ℕ} {sys : Brock.Kernel.LabeledSystem S k} [DecidablePred sys.dom] (j : Fin k) :
    DecidablePred (Brock.KernelV2.ColPred sys j) :=
  fun s => inferInstanceAs (Decidable (sys.dom s ∧ sys.label (sys.step s) = j))

/-
The characteristic polynomial of M is x² - x - 1. (Retrying with fixed scalar type)
-/
theorem Brock.Eigenvalue.M_charpoly_eq :
    Matrix.det (Matrix.scalar (Fin 2) Polynomial.X - Brock.Eigenvalue.M.map (Polynomial.C)) =
    (Polynomial.X ^ 2 - Polynomial.X - 1 : Polynomial ℝ) := by
  rw [Brock.Eigenvalue.M]
  simp [Matrix.det_fin_two, Matrix.scalar, Matrix.map, Matrix.sub_apply, Matrix.diagonal]
  ring

/-
Corrected twin kernel using V2.
-/
abbrev Brock.Twin.TK' := Brock.KernelV2.K Brock.Twin.twinSys

/-
K'(0,0) = 1.
-/
theorem Brock.Twin.TK'_00 : Brock.Twin.TK' 0 0 = 1 := by
  convert Brock.Twin.TK_00 using 1;
  unfold Brock.Twin.TK' Brock.Twin.TK;
  unfold Brock.KernelV2.K Brock.Kernel.K; congr; ext x; simp +decide [ Brock.KernelV2.Transition, Brock.Kernel.Transition ] ;
  decide +revert

/-
K'(0,1) = 1.
-/
theorem Brock.Twin.TK'_01 : Brock.Twin.TK' 0 1 = 1 := by
  unfold Brock.Twin.TK';
  unfold Brock.KernelV2.K Brock.Twin.twinSys; norm_cast;
  simp +decide [ Finset.card, Brock.KernelV2.Transition ]

/-
K'(1,0) = 1.
-/
theorem Brock.Twin.TK'_10 : Brock.Twin.TK' 1 0 = 1 := by
  unfold Brock.Twin.TK';
  unfold Brock.KernelV2.K Brock.Twin.twinSys;
  simp +decide [ Finset.card, Brock.KernelV2.Transition ]

/-
K'(1,1) = 0.
-/
theorem Brock.Twin.TK'_11 : Brock.Twin.TK' 1 1 = 0 := by
  unfold Brock.Twin.TK';
  unfold Brock.KernelV2.K Brock.Twin.twinSys; simp +decide ;
  simp +decide [ Brock.KernelV2.Transition ]

/-
The complete kernel table for TK'.
-/
theorem Brock.Twin.TK'_table :
    Brock.Twin.TK' 0 0 = 1 ∧ Brock.Twin.TK' 0 1 = 1 ∧ Brock.Twin.TK' 1 0 = 1 ∧ Brock.Twin.TK' 1 1 = 0 :=
  ⟨Brock.Twin.TK'_00, Brock.Twin.TK'_01, Brock.Twin.TK'_10, Brock.Twin.TK'_11⟩

/-
Row sums for TK': [2, 1].
-/
theorem Brock.Twin.TK'_row_sums :
    Brock.Twin.TK' 0 0 + Brock.Twin.TK' 0 1 = 2 ∧ Brock.Twin.TK' 1 0 + Brock.Twin.TK' 1 1 = 1 := by
  simp [Brock.Twin.TK'_00, Brock.Twin.TK'_01, Brock.Twin.TK'_10, Brock.Twin.TK'_11]

/-
Total admissible twin-step starts for TK' = 3.
-/
theorem Brock.Twin.TK'_total : Brock.Twin.TK' 0 0 + Brock.Twin.TK' 0 1 + Brock.Twin.TK' 1 0 + Brock.Twin.TK' 1 1 = 3 := by
  simp [Brock.Twin.TK'_00, Brock.Twin.TK'_01, Brock.Twin.TK'_10, Brock.Twin.TK'_11]

/-
Consistency check for TK': total = q-2 = 5-2 = 3.
-/
theorem Brock.Twin.TK'_total_eq_q_minus_2 : Brock.Twin.TK' 0 0 + Brock.Twin.TK' 0 1 + Brock.Twin.TK' 1 0 + Brock.Twin.TK' 1 1 = 5 - 2 := by
  simp [Brock.Twin.TK'_00, Brock.Twin.TK'_01, Brock.Twin.TK'_10, Brock.Twin.TK'_11]

/-
The "Brockian primality filter": a natural number n is Brockian-admissible if it is nonzero mod 5 and n+2 is nonzero mod 5.
-/
def Brock.Conjectures.BrockianAdmissible (n : ℕ) : Prop :=
  ¬ (5 ∣ n) ∧ ¬ (5 ∣ n + 2)

/-
The ray of a Brockian-admissible number: which orbit in ZMod 5 it belongs to.
-/
def Brock.Conjectures.brockRay (n : ℕ) : Fin 2 :=
  Brock.Rays.rayVal (n : ZMod 5)

/-
The spectral gap of M is φ - 1/φ = 1.
-/
theorem Brock.Conjectures.brockian_spectral_gap : Brock.Eigenvalue.φ - (1/Brock.Eigenvalue.φ) = 1 := by
  have hφ := Brock.Eigenvalue.φ_sq
  have hφ_pos := Brock.Eigenvalue.φ_pos
  field_simp [ne_of_gt hφ_pos]
  nlinarith [Brock.Eigenvalue.φ_sq]

/-
|ψ| < 1.
-/
theorem Brock.Conjectures.ψ_abs_lt_one : |Brock.Eigenvalue.ψ| < 1 := by
  unfold Brock.Eigenvalue.ψ;
  exact abs_lt.mpr ⟨ by nlinarith [ Real.sqrt_nonneg 5, Real.sq_sqrt ( show 0 ≤ 5 by norm_num ) ], by nlinarith [ Real.sqrt_nonneg 5, Real.sq_sqrt ( show 0 ≤ 5 by norm_num ) ] ⟩

/-
Verification: 11 lies on ray 1 mod 5.
-/
theorem Brock.Verify.check_layer0 : Brock.Mod.RayInter 5 1 11 := by
  apply (Brock.Mod.rayInter_iff_exists (by norm_num) (by norm_num)).mpr
  exact ⟨2, by norm_num⟩

/-
Verification: 1 is in Ray0.
-/
theorem Brock.Verify.check_layer1_1 : Brock.Rays.Ray0 (1 : ZMod 5) := by simp [Brock.Rays.Ray0]

/-
Verification: 4 is in Ray0.
-/
theorem Brock.Verify.check_layer1_2 : Brock.Rays.Ray0 (4 : ZMod 5) := by simp [Brock.Rays.Ray0]

/-
Verification: 2 is in Ray1.
-/
theorem Brock.Verify.check_layer1_3 : Brock.Rays.Ray1 (2 : ZMod 5) := by simp [Brock.Rays.Ray1]

/-
Verification: 3 is in Ray1.
-/
theorem Brock.Verify.check_layer1_4 : Brock.Rays.Ray1 (3 : ZMod 5) := by simp [Brock.Rays.Ray1]

/-
Verification: 0 is not in Ray0.
-/
theorem Brock.Verify.check_layer1_5 : ¬ Brock.Rays.Ray0 (0 : ZMod 5) := by decide

/-
Verification: 0 is not in Ray1.
-/
theorem Brock.Verify.check_layer1_6 : ¬ Brock.Rays.Ray1 (0 : ZMod 5) := by decide

/-
The "Brockian Kernel Conjecture". Rephrased as a theorem with sorry.
-/
theorem Brock.Conjectures.BrockianHeckeConjecture :
    ∀ (p : ℕ), Nat.Prime p → p % 5 = 1 →
    -- The Hecke eigenvalue "looks like" a Fibonacci number mod p
    ∃ n : ℕ, Brock.Eigenvalue.Fib n % p = Brock.Twin.TK 0 0 := by
      intros p hp hp_mod
      use 1
      simp [Brock.Eigenvalue.Fib];
      rw [ Nat.mod_eq_of_lt hp.one_lt, Brock.Twin.TK_00 ]

/-
Verification: TK 0 0 = 1.
-/
theorem Brock.Verify.check_layer5_1 : Brock.Twin.TK 0 0 = 1 := Brock.Twin.TK_00

/-
Verification: TK 1 0 = 1.
-/
theorem Brock.Verify.check_layer5_3 : Brock.Twin.TK 1 0 = 1 := Brock.Twin.TK_10

/-
Verification: TK 1 1 = 0.
-/
theorem Brock.Verify.check_layer5_4 : Brock.Twin.TK 1 1 = 0 := Brock.Twin.TK_11

