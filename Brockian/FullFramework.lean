instance : DecidablePred (fun r : ZMod 5 => Brock.Rays.Ray0 r) :=
  inferInstanceAs (DecidablePred Brock.Rays.Ray0)

/-
Every nonzero residue mod 5 lies in Ray0 or Ray1.
-/
theorem Brock.Rays.ray_partition (r : ZMod 5) (hr : r ≠ 0) : Brock.Rays.Ray0 r ∨ Brock.Rays.Ray1 r := by
  fin_cases r <;> simp_all [Brock.Rays.Ray0, Brock.Rays.Ray1]

/-
The two rays are disjoint.
-/
theorem Brock.Rays.ray_disjoint (r : ZMod 5) : ¬(Brock.Rays.Ray0 r ∧ Brock.Rays.Ray1 r) := by
  native_decide +revert

/-
For nonzero r: Ray0 r ↔ ¬ Ray1 r.
-/
theorem Brock.Rays.ray0_iff_not_ray1 (r : ZMod 5) (hr : r ≠ 0) : Brock.Rays.Ray0 r ↔ ¬ Brock.Rays.Ray1 r :=
  ⟨fun h0 h1 => Brock.Rays.ray_disjoint r ⟨h0, h1⟩,
   fun hn => (Brock.Rays.ray_partition r hr).resolve_right hn⟩

/-
For nonzero r: Ray1 r ↔ ¬ Ray0 r.
-/
theorem Brock.Rays.ray1_iff_not_ray0 (r : ZMod 5) (hr : r ≠ 0) : Brock.Rays.Ray1 r ↔ ¬ Brock.Rays.Ray0 r :=
  ⟨fun h1 h0 => Brock.Rays.ray_disjoint r ⟨h0, h1⟩,
   fun hn => (Brock.Rays.ray_partition r hr).resolve_left hn⟩

/-
Ray0 characterization via rayVal.
-/
theorem Brock.Rays.ray0_iff_rayVal_eq_zero (r : ZMod 5) (hr : r ≠ 0) :
    Brock.Rays.Ray0 r ↔ Brock.Rays.rayVal r = 0 := by
      native_decide +revert

/-
Ray1 characterization via rayVal.
-/
theorem Brock.Rays.ray1_iff_rayVal_eq_one (r : ZMod 5) (hr : r ≠ 0) :
    Brock.Rays.Ray1 r ↔ Brock.Rays.rayVal r = 1 := by
      native_decide +revert

