/-
n lies on the residue ray r modulo m. Defined as n ≡ r (mod m) in the sense of Nat.ModEq.
-/
def Brock.Mod.RayInter (m r n : ℕ) : Prop := Nat.ModEq m n r

/-
If r < m then r % m = r. (Convenience wrapper.)
-/
lemma Brock.Mod.mod_lt_self {m r : ℕ} (hr : r < m) : r % m = r :=
  Nat.mod_eq_of_lt hr

/-
Division algorithm: n = m*(n/m) + n%m.
-/
lemma Brock.Mod.div_mod_eq {m n : ℕ} (hm : 0 < m) : n = m * (n / m) + (n % m) := by
  linarith [Nat.div_add_mod n m, Nat.mul_comm m (n / m)]

/-
Core equivalence: ModEq m n r ↔ n % m = r, when r < m.
-/
theorem Brock.Mod.modEq_iff_mod_eq {m r n : ℕ} (hr : r < m) :
    Nat.ModEq m n r ↔ n % m = r := by
  simp [Nat.ModEq, Brock.Mod.mod_lt_self hr]

/-
Normal form: n ≡ r (mod m) ↔ ∃ t : ℕ, n = m*t + r.
-/
theorem Brock.Mod.modEq_iff_exists {m r n : ℕ} (hm : 0 < m) (hr : r < m) :
    Nat.ModEq m n r ↔ ∃ t : ℕ, n = m * t + r := by
  rw [Brock.Mod.modEq_iff_mod_eq hr]
  constructor
  · intro h
    exact ⟨n / m, by linarith [Nat.div_add_mod n m, Nat.mul_comm m (n / m),
                                 Nat.mod_add_div n m]⟩
  · rintro ⟨t, rfl⟩
    simp [Nat.add_mul_mod_self_left, Brock.Mod.mod_lt_self hr]

/-
RayInter normal form.
-/
theorem Brock.Mod.rayInter_iff_exists {m r n : ℕ} (hm : 0 < m) (hr : r < m) :
    Brock.Mod.RayInter m r n ↔ ∃ t : ℕ, n = m * t + r :=
  Brock.Mod.modEq_iff_exists hm hr

/-
Construction: m*t + r lies on ray r.
-/
theorem Brock.Mod.rayInter_mul_add {m r t : ℕ} (hm : 0 < m) (hr : r < m) :
    Brock.Mod.RayInter m r (m * t + r) :=
  (Brock.Mod.rayInter_iff_exists hm hr).mpr ⟨t, rfl⟩

/-
Ray 0: residues {1, 4} mod 5. These are the quadratic residues mod 5 (since 1² ≡ 1 and 2² ≡ 4 mod 5), forming one reflection orbit.
-/
def Brock.Rays.Ray0 (r : ZMod 5) : Prop := r = 1 ∨ r = 4

/-
Ray 1: residues {2, 3} mod 5. These are the quadratic non-residues mod 5, forming the other reflection orbit.
-/
def Brock.Rays.Ray1 (r : ZMod 5) : Prop := r = 2 ∨ r = 3

/-
Decidability instance for Ray0.
-/
instance : DecidablePred Brock.Rays.Ray0 := fun r => inferInstanceAs (Decidable (r = 1 ∨ r = 4))

/-
Decidability instance for Ray1.
-/
instance : DecidablePred Brock.Rays.Ray1 := fun r => inferInstanceAs (Decidable (r = 2 ∨ r = 3))

/-
Ray label: 0 for Ray0, 1 for Ray1. Defined on all of ZMod 5 (with r=0 mapping to 1 arbitrarily).
-/
def Brock.Rays.rayVal (r : ZMod 5) : Fin 2 :=
  if Brock.Rays.Ray0 r then (0 : Fin 2) else (1 : Fin 2)

/-
Redundant instance but included in user code.
