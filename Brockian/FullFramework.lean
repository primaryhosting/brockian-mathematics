/-
ω lies on the unit circle: ‖ω‖ = 1.
-/
lemma Brock.Geom.norm_ω : ‖Brock.Geom.ω‖ = 1 := by
  unfold Brock.Geom.ω; norm_num [ Complex.norm_exp ] ;

/-
Multiplication by ω is an isometry.
-/
lemma Brock.Geom.norm_mul_ω (z : ℂ) : ‖Brock.Geom.ω * z‖ = ‖z‖ := by
  rw [ norm_mul, Brock.Geom.norm_ω ] ; norm_num

/-
ω⁵ = 1: the 5-periodicity.
