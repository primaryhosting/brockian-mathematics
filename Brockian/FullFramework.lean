/-
Rotation: +1 in ZMod 5.
-/
def Brock.Geom.rot (a : ZMod 5) : ZMod 5 := a + 1

/-
Reflection: complex conjugation.
-/
noncomputable def Brock.Geom.ref (z : ℂ) : ℂ := starRingEnd ℂ z

/-
Distance between embedded pentagon vertices.
-/
