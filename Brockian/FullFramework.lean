/-
ref is an involution: ref(ref z) = z.
-/
theorem Brock.Geom.ref_involutive (z : ℂ) : Brock.Geom.ref (Brock.Geom.ref z) = z := by
  exact Complex.conj_conj z

/-
Conjugation preserves norm.
-/
lemma Brock.Geom.norm_ref (z : ℂ) : ‖Brock.Geom.ref z‖ = ‖z‖ := by
  exact Complex.norm_conj _

/-
Reflection is a distance-preserving map.
-/
theorem Brock.Geom.pentDist_ref_invariant (a b : ZMod 5) :
    ‖Brock.Geom.ref (Brock.Geom.emb a) - Brock.Geom.ref (Brock.Geom.emb b)‖ = Brock.Geom.pentDist a b := by
      simp [Brock.Geom.pentDist, Brock.Geom.ref];
      rw [ ← map_sub, Complex.norm_conj ]

/-
The 5 pentagon vertices are distinct (all pairwise distances positive).
-/
theorem Brock.Geom.emb_injective : Function.Injective Brock.Geom.emb := by
  -- The function ω^k is injective over the integers modulo 5 because ω is a primitive 5th root of unity.
  have h_injective : ∀ (k1 k2 : ℕ), k1 < 5 → k2 < 5 → ω ^ k1 = ω ^ k2 → k1 = k2 := by
    intros k1 k2 hk1 hk2 h_eq
    have h_exp : Complex.exp (2 * Real.pi * Complex.I * k1 / 5) = Complex.exp (2 * Real.pi * Complex.I * k2 / 5) := by
      convert h_eq using 1 <;> push_cast [ Brock.Geom.ω ] <;> rw [ ← Complex.exp_nat_mul ] <;> ring
    have h_k : ∃ m : ℤ, k1 = k2 + 5 * m := by
      rw [ Complex.exp_eq_exp_iff_exists_int ] at h_exp; obtain ⟨ m, hm ⟩ := h_exp; exact ⟨ m, by rw [ ← @Int.cast_inj ℂ ] ; push_cast; rw [ Complex.ext_iff ] at *; norm_num [ Complex.exp_re, Complex.exp_im ] at *; nlinarith [ Real.pi_pos ] ⟩ ;
    have h_zero : k1 = k2 := by
      omega
    exact h_zero;
  exact fun a b h => by simpa [ ZMod.val_injective _ |>.eq_iff ] using h_injective _ _ ( ZMod.val_lt a ) ( ZMod.val_lt b ) <| by simpa [ pow_add, pow_mul ] using h;

/-
Translate a pattern Γ by starting residue r₀.
-/
def Brock.Count.translate {q : ℕ} [NeZero q] (r₀ : ZMod q) (Γ : Finset (ZMod q)) : Finset (ZMod q) :=
  Γ.image (· + r₀)

/-
r₀ is a bad start: the pattern, shifted by r₀, hits 0.
-/
def Brock.Count.BadStart {q : ℕ} [NeZero q] (Γ : Finset (ZMod q)) (r₀ : ZMod q) : Prop :=
  (0 : ZMod q) ∈ Brock.Count.translate r₀ Γ

/-
The set of all bad starts (equals the negation image of Γ).
-/
def Brock.Count.BadStarts {q : ℕ} [NeZero q] (Γ : Finset (ZMod q)) : Finset (ZMod q) :=
  Γ.image (fun g => -g)

/-
The set of all good starts.
-/
def Brock.Count.GoodStarts {q : ℕ} [NeZero q] (Γ : Finset (ZMod q)) : Finset (ZMod q) :=
  Finset.univ \ Brock.Count.BadStarts Γ

/-
r₀ is a good start iff it is not a bad start.
-/
def Brock.Count.GoodStart {q : ℕ} [NeZero q] (Γ : Finset (ZMod q)) (r₀ : ZMod q) : Prop :=
  ¬ Brock.Count.BadStart Γ r₀

/-
Characterization of translate membership.
-/
lemma Brock.Count.mem_translate_iff {q : ℕ} [NeZero q] {Γ : Finset (ZMod q)} {r₀ x : ZMod q} :
    x ∈ Brock.Count.translate r₀ Γ ↔ ∃ g ∈ Γ, g + r₀ = x := by
      unfold Brock.Count.translate; aesop;

/-
r₀ is bad iff r₀ ∈ BadStarts Γ.
-/
lemma Brock.Count.badStart_iff {q : ℕ} [NeZero q] {Γ : Finset (ZMod q)} {r₀ : ZMod q} :
    Brock.Count.BadStart Γ r₀ ↔ r₀ ∈ Brock.Count.BadStarts Γ := by
      unfold Brock.Count.BadStart;
      unfold Brock.Count.translate Brock.Count.BadStarts; aesop;

/-
Negation on ZMod q is injective.
-/
lemma Brock.Count.neg_injective_zmod {q : ℕ} [NeZero q] : Function.Injective (fun g : ZMod q => -g) :=
  fun a b h => neg_injective h

/-
|BadStarts Γ| = |Γ|.
-/
theorem Brock.Count.card_badStarts {q : ℕ} [NeZero q] (Γ : Finset (ZMod q)) :
    (Brock.Count.BadStarts Γ).card = Γ.card := by
      convert Finset.card_image_of_injective Γ ( Brock.Count.neg_injective_zmod ) using 1

/-
THE GOOD-START LAW: |GoodStarts Γ| = q - |Γ|.
-/
theorem Brock.Count.good_start_law {q : ℕ} [NeZero q] (Γ : Finset (ZMod q)) :
    (Brock.Count.GoodStarts Γ).card = q - Γ.card := by
      -- By definition, the set of good starts is the complement of the set of bad starts in the universal set.
      have h_complement : Brock.Count.GoodStarts Γ = Finset.univ \ Brock.Count.BadStarts Γ := by
        exact?;
      rw [ h_complement, Finset.card_sdiff ] ; norm_num [ Finset.card_univ ];
      rw [ Brock.Count.card_badStarts ]

/-
The q-2 law: if Γ has exactly two distinct elements, good starts = q-2.
-/
theorem Brock.Count.good_start_law_two {q : ℕ} [NeZero q] {g : ZMod q} (hg : g ≠ 0) :
    (Brock.Count.GoodStarts ({0, g} : Finset (ZMod q))).card = q - 2 := by
      rw [ Brock.Count.good_start_law ];
      rw [ Finset.card_insert_of_notMem, Finset.card_singleton ] ; aesop

/-
Declare universe u.
-/
universe u

/-
A labeled dynamical system on a finite state space.
-/
structure Brock.Kernel.LabeledSystem (S : Type u) (k : ℕ) where
  step  : S → S
  label : S → Fin k
  dom   : S → Prop

/-
Transition predicate: s is in the domain, its step is in the domain, and the labels are i and j respectively.
-/
def Brock.Kernel.Transition {S : Type u} {k : ℕ} (sys : Brock.Kernel.LabeledSystem S k) (i j : Fin k) (s : S) : Prop :=
  sys.dom s ∧ sys.dom (sys.step s) ∧
  sys.label s = i ∧ sys.label (sys.step s) = j

/-
The transition-count kernel K(i,j).
-/
def Brock.Kernel.K {S : Type u} [Fintype S] {k : ℕ} (sys : Brock.Kernel.LabeledSystem S k) [DecidablePred sys.dom] (i j : Fin k) : ℕ :=
  (Finset.univ.filter (Brock.Kernel.Transition sys i j)).card

/-
Row predicate: s is admissible with label i.
-/
def Brock.Kernel.RowPred {S : Type u} {k : ℕ} (sys : Brock.Kernel.LabeledSystem S k) (i : Fin k) (s : S) : Prop :=
  sys.dom s ∧ sys.dom (sys.step s) ∧ sys.label s = i

/-
Column predicate: s is admissible with step-label j.
-/
def Brock.Kernel.ColPred {S : Type u} {k : ℕ} (sys : Brock.Kernel.LabeledSystem S k) (j : Fin k) (s : S) : Prop :=
  sys.dom s ∧ sys.dom (sys.step s) ∧ sys.label (sys.step s) = j

/-
Decidability instance for RowPred.
-/
instance {S : Type u} [Fintype S] {k : ℕ} {sys : Brock.Kernel.LabeledSystem S k} [DecidablePred sys.dom] (i : Fin k) :
    DecidablePred (Brock.Kernel.RowPred sys i) :=
  fun s => inferInstanceAs (Decidable (sys.dom s ∧ sys.dom (sys.step s) ∧ sys.label s = i))

/-
Decidability instance for ColPred.
-/
instance {S : Type u} [Fintype S] {k : ℕ} {sys : Brock.Kernel.LabeledSystem S k} [DecidablePred sys.dom] (j : Fin k) :
    DecidablePred (Brock.Kernel.ColPred sys j) :=
  fun s => inferInstanceAs (Decidable (sys.dom s ∧ sys.dom (sys.step s) ∧ sys.label (sys.step s) = j))

/-
Row-sum theorem: ∑_j K(i,j) = |{s : RowPred sys i s}|.
-/
theorem Brock.Kernel.row_sum {S : Type u} [Fintype S] {k : ℕ} (sys : Brock.Kernel.LabeledSystem S k) [DecidablePred sys.dom] (i : Fin k) :
    ∑ j : Fin k, Brock.Kernel.K sys i j =
    (Finset.univ.filter (Brock.Kernel.RowPred sys i)).card := by
      unfold Brock.Kernel.K;
      rw [ ← Finset.card_biUnion ];
      · congr with x ; simp +decide [ Brock.Kernel.Transition, Brock.Kernel.RowPred ];
      · intros j hj j' hj' hij; simp_all +decide [ Finset.disjoint_left, Brock.Kernel.Transition ] ;

/-
Column-sum theorem: ∑_i K(i,j) = |{s : ColPred sys j s}|.
-/
theorem Brock.Kernel.col_sum {S : Type u} [Fintype S] {k : ℕ} (sys : Brock.Kernel.LabeledSystem S k) [DecidablePred sys.dom] (j : Fin k) :
    ∑ i : Fin k, Brock.Kernel.K sys i j =
    (Finset.univ.filter (Brock.Kernel.ColPred sys j)).card := by
      unfold Brock.Kernel.K;
      have h_filter : Finset.filter (Brock.Kernel.ColPred sys j) Finset.univ = Finset.biUnion (Finset.univ : Finset (Fin k)) fun i => Finset.filter (Brock.Kernel.Transition sys i j) Finset.univ := by
        ext s; simp [Brock.Kernel.ColPred, Brock.Kernel.Transition];
      rw [ h_filter, Finset.card_biUnion ];
      intro i _ j _ hij; simp_all +decide [ Finset.disjoint_left, Brock.Kernel.Transition ] ;

/-
Total-sum theorem: ∑_{i,j} K(i,j) = |admissible domain|.
-/
theorem Brock.Kernel.total_sum {S : Type u} [Fintype S] {k : ℕ} (sys : Brock.Kernel.LabeledSystem S k) [DecidablePred sys.dom] :
    ∑ i : Fin k, ∑ j : Fin k, Brock.Kernel.K sys i j =
    (Finset.univ.filter (fun s => sys.dom s ∧ sys.dom (sys.step s))).card := by
      rw [ ← Finset.sum_product' ];
      simp +decide only [K];
      rw [ ← Finset.card_biUnion ];
      · congr with s ; simp +decide [ Brock.Kernel.Transition ];
      · intro x hx y hy hxy; simp_all +decide [ Finset.disjoint_left, Brock.Kernel.Transition ] ;
        grind

/-
Decidability instance for RowPred.
-/
instance {S : Type u} [Fintype S] {k : ℕ} {sys : Brock.Kernel.LabeledSystem S k} [DecidablePred sys.dom] (i : Fin k) :
    DecidablePred (Brock.Kernel.RowPred sys i) :=
  fun s => inferInstanceAs (Decidable (sys.dom s ∧ sys.dom (sys.step s) ∧ sys.label s = i))

/-
Decidability instance for ColPred.
-/
instance {S : Type u} [Fintype S] {k : ℕ} {sys : Brock.Kernel.LabeledSystem S k} [DecidablePred sys.dom] (j : Fin k) :
    DecidablePred (Brock.Kernel.ColPred sys j) :=
  fun s => inferInstanceAs (Decidable (sys.dom s ∧ sys.dom (sys.step s) ∧ sys.label (sys.step s) = j))

