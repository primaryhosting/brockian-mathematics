/-
Ray 0 residues in ZMod 5: {1, 4}.
-/
def Ray0 (r : ZMod 5) : Prop := r = 1 ∨ r = 4

/-
Ray 1 residues in ZMod 5: {2, 3}.
-/
def Ray1 (r : ZMod 5) : Prop := r = 2 ∨ r = 3

/-
Decidability instance for Ray0.
-/
instance : DecidablePred Ray0 :=
  fun r => inferInstanceAs (Decidable (r = 1 ∨ r = 4))

/-
Decidability instance for Ray1.
-/
instance : DecidablePred Ray1 :=
  fun r => inferInstanceAs (Decidable (r = 2 ∨ r = 3))

/-
Ray label: 0 for Ray0, 1 otherwise.
-/
def rayVal (r : ZMod 5) : Fin 2 :=
  if Ray0 r then 0 else 1

/-
Nonzero residues lie in exactly one ray.
-/
theorem ray_partition (r : ZMod 5) (h : r ≠ 0) :
    Ray0 r ∨ Ray1 r := by
  fin_cases r <;> simp_all [Ray0, Ray1]

/-
Rays are disjoint.
-/
theorem ray_disjoint (r : ZMod 5) :
    ¬ (Ray0 r ∧ Ray1 r) := by
  fin_cases r <;> decide

/-
Negation preserves Ray0.
-/
theorem neg_preserves_ray0 (r : ZMod 5) :
    Ray0 (-r) ↔ Ray0 r := by
  fin_cases r <;> decide

/-
Negation preserves Ray1.
-/
theorem neg_preserves_ray1 (r : ZMod 5) :
    Ray1 (-r) ↔ Ray1 r := by
  fin_cases r <;> decide

/-
Twin admissibility in ZMod 5.
-/
theorem twin_admissible (r : ZMod 5)
    (h₁ : r ≠ 0) (h₂ : r + 2 ≠ 0) :
    r = 1 ∨ r = 2 ∨ r = 4 := by
      native_decide +revert

/-
Translate a finite pattern Γ by r₀.
-/
def Count.translate {q : ℕ} [NeZero q]
    (r₀ : ZMod q) (Γ : Finset (ZMod q)) :
    Finset (ZMod q) :=
  Γ.image (· + r₀)

/-
Bad starts: shifts that place some pattern element on zero.
-/
def Count.BadStarts {q : ℕ} [NeZero q]
    (Γ : Finset (ZMod q)) :
    Finset (ZMod q) :=
  Γ.image (fun g => -g)

/-
Good starts: complement in universe.
-/
def Count.GoodStarts {q : ℕ} [NeZero q]
    (Γ : Finset (ZMod q)) :
    Finset (ZMod q) :=
  (Finset.univ : Finset (ZMod q)) \ Count.BadStarts Γ

/-
Negation is injective on ZMod q.
-/
lemma Count.neg_injective_zmod {q : ℕ} [NeZero q] :
    Function.Injective (fun g : ZMod q => -g) :=
  fun _ _ h => neg_injective h

/-
Cardinality of BadStarts equals cardinality of Γ.
-/
theorem Count.card_badStarts {q : ℕ} [NeZero q]
    (Γ : Finset (ZMod q)) :
    (Count.BadStarts Γ).card = Γ.card :=
  Finset.card_image_of_injective Γ Count.neg_injective_zmod

/-
Good-Start Law: |GoodStarts| = q - |Γ|.
-/
theorem Count.good_start_law {q : ℕ} [NeZero q]
    (Γ : Finset (ZMod q)) :
    (Count.GoodStarts Γ).card = q - Γ.card := by
      unfold Count.GoodStarts;
      simp +decide [ Finset.card_sdiff, Finset.card_univ ];
      rw [ Count.card_badStarts ]

/-
A labeled dynamical system with domain predicate.
-/
structure Kernel.LabeledSystem (S : Type*) (k : ℕ) where
  step  : S → S
  label : S → Fin k
  dom   : S → Prop

/-
V2 transition: only dom s required.
-/
def Kernel.TransitionV2 {S : Type*} {k : ℕ}
    (sys : Kernel.LabeledSystem S k)
    (i j : Fin k) (s : S) : Prop :=
  sys.dom s ∧ sys.label s = i ∧ sys.label (sys.step s) = j

/-
Finite kernel count.
-/
def Kernel.K {S : Type*} [Fintype S] {k : ℕ}
    (sys : Kernel.LabeledSystem S k)
    [DecidablePred sys.dom]
    (i j : Fin k) : ℕ :=
  (Finset.univ.filter (Kernel.TransitionV2 sys i j)).card

/-
The twin-step system: s ↦ s+2 on ZMod 5.
-/
def Twin.twinSys : Kernel.LabeledSystem (ZMod 5) 2 where
  step  := fun r => r + 2
  label := rayVal
  dom   := fun r => r ≠ 0 ∧ r + 2 ≠ 0

/-
Decidability instance for twinSys.dom.
-/
instance : DecidablePred Twin.twinSys.dom :=
  fun r => inferInstanceAs (Decidable (r ≠ 0 ∧ r + 2 ≠ 0))

/-
The corrected 2×2 twin-step transition kernel TK'.
-/
abbrev Twin.TK' : Fin 2 → Fin 2 → ℕ := Kernel.K Twin.twinSys

/-
TK'(0,0) = 1.
-/
theorem Twin.TK'_00 : Twin.TK' 0 0 = 1 := by
  unfold Twin.TK' Kernel.K;
  simp +decide [ Finset.card, Kernel.TransitionV2 ]

/-
TK'(0,1) = 1.
-/
theorem Twin.TK'_01 : Twin.TK' 0 1 = 1 := by
  unfold Twin.TK' Kernel.K;
  unfold Kernel.TransitionV2; simp +decide [ Finset.card_eq_one ] ;
  simp +decide [ Finset.ext_iff, Set.ext_iff ]

/-
TK'(1,0) = 1.
-/
theorem Twin.TK'_10 : Twin.TK' 1 0 = 1 := by
  unfold Twin.TK' Kernel.K;
  unfold Kernel.TransitionV2; simp +decide [ Finset.card ] ;
  erw [ Multiset.coe_card ] ; simp +decide [ Twin.twinSys ] ;

/-
TK'(1,1) = 0.
-/
theorem Twin.TK'_11 : Twin.TK' 1 1 = 0 := by
  unfold Twin.TK';
  unfold Kernel.K;
  simp +decide [ Kernel.TransitionV2 ]

/-
Total = 3.
-/
theorem Twin.TK'_total :
    Twin.TK' 0 0 + Twin.TK' 0 1 + Twin.TK' 1 0 + Twin.TK' 1 1 = 3 := by
  simp [Twin.TK'_00, Twin.TK'_01, Twin.TK'_10, Twin.TK'_11]

/-
Complete kernel table.
-/
theorem Twin.TK'_table :
    Twin.TK' 0 0 = 1 ∧ Twin.TK' 0 1 = 1 ∧ Twin.TK' 1 0 = 1 ∧ Twin.TK' 1 1 = 0 :=
  ⟨Twin.TK'_00, Twin.TK'_01, Twin.TK'_10, Twin.TK'_11⟩

/-
The golden ratio φ = (1 + √5)/2.
-/
def Golden.φ : ℝ := (1 + Real.sqrt 5) / 2

/-
The conjugate ψ = (1 - √5)/2.
-/
def Golden.ψ : ℝ := (1 - Real.sqrt 5) / 2

/-
√5 squared equals 5.
-/
private lemma Golden.sqrt5_sq : Real.sqrt 5 * Real.sqrt 5 = 5 :=
  Real.mul_self_sqrt (by norm_num)

/-
φ is positive.
-/
theorem Golden.phi_pos : 0 < Golden.φ := by
  unfold Golden.φ
  apply div_pos _ two_pos
  linarith [Real.sqrt_nonneg 5]

/-
φ ≠ 0.
-/
theorem Golden.phi_ne_zero : Golden.φ ≠ 0 := ne_of_gt Golden.phi_pos

/-
φ > 1.
-/
theorem Golden.phi_gt_one : 1 < Golden.φ := by
  exact lt_div_iff₀' ( by norm_num ) |>.2 ( by nlinarith [ Real.sqrt_nonneg 5, Real.sq_sqrt ( show 0 ≤ 5 by norm_num ) ] )

/-
The golden ratio equation: φ² = φ + 1.
-/
theorem Golden.phi_squared : Golden.φ ^ 2 = Golden.φ + 1 := by
  unfold Golden.φ
  have h5 : Real.sqrt 5 * Real.sqrt 5 = 5 := Golden.sqrt5_sq
  field_simp
  nlinarith [h5, Real.sqrt_nonneg 5]

/-
Similarly: ψ² = ψ + 1.
-/
theorem Golden.psi_squared : Golden.ψ ^ 2 = Golden.ψ + 1 := by
  unfold Golden.ψ
  have h5 : Real.sqrt 5 * Real.sqrt 5 = 5 := Golden.sqrt5_sq
  field_simp
  nlinarith [h5, Real.sqrt_nonneg 5]

/-
Sum of roots equals trace of M.
-/
theorem Golden.phi_plus_psi : Golden.φ + Golden.ψ = 1 := by
  unfold Golden.φ Golden.ψ; ring

/-
Product of roots equals -det(M).
-/
theorem Golden.phi_times_psi : Golden.φ * Golden.ψ = -1 := by
  unfold Golden.φ Golden.ψ
  have h5 : Real.sqrt 5 * Real.sqrt 5 = 5 := Golden.sqrt5_sq
  field_simp
  nlinarith [h5]

/-
φ is a root of x² - x - 1 = 0.
-/
theorem Golden.phi_is_root : Golden.φ ^ 2 - Golden.φ - 1 = 0 := by
  linarith [Golden.phi_squared]

/-
ψ is a root of x² - x - 1 = 0.
-/
theorem Golden.psi_is_root : Golden.ψ ^ 2 - Golden.ψ - 1 = 0 := by
  linarith [Golden.psi_squared]

/-
Spectral gap identity: φ - 1/φ = 1.
-/
theorem Golden.spectral_gap_identity : Golden.φ - 1 / Golden.φ = 1 := by
  have hφ := Golden.phi_ne_zero
  have hφsq := Golden.phi_squared
  field_simp [hφ]
  nlinarith [hφsq]

/-
|ψ| < 1.
-/
theorem Golden.psi_abs_lt_one : |Golden.ψ| < 1 := by
  unfold Golden.ψ; rw [ abs_of_nonpos ] <;> nlinarith [ Real.sqrt_nonneg 5, Real.sq_sqrt ( show 0 ≤ 5 by norm_num ) ] ;

/-
The 2×2 Brockian transfer matrix M = [[1,1],[1,0]].
-/
def Matrix_.M : Matrix (Fin 2) (Fin 2) ℝ := !![1, 1; 1, 0]

/-
Characteristic polynomial of M is x² - x - 1.
-/
theorem Matrix_.M_charpoly :
    Matrix.det (Matrix.scalar (Fin 2) Polynomial.X -
      Matrix_.M.map Polynomial.C) =
    (Polynomial.X ^ 2 - Polynomial.X - 1 : Polynomial ℝ) := by
  simp [Matrix_.M, Matrix.det_fin_two, Matrix.scalar,
        Matrix.map, Matrix.sub_apply, Matrix.diagonal]
  ring

/-
φ is an eigenvalue of M with eigenvector [1, 1/φ].
-/
theorem Matrix_.phi_eigenvalue :
    Matrix_.M.mulVec ![(1 : ℝ), 1 / Golden.φ] =
    Golden.φ • ![(1 : ℝ), 1 / Golden.φ] := by
      ext i; fin_cases i <;> norm_num [ Matrix.mulVec ] ; ring;
      · unfold Matrix.vecHead Matrix.vecTail Matrix_.M; norm_num; ring_nf; norm_num [ Golden.φ ] ; ring;
        grind;
      · unfold Matrix.vecHead Matrix.vecTail Matrix_.M; norm_num; ring;
        rw [ mul_inv_cancel₀ ( by exact ne_of_gt ( by exact div_pos ( add_pos zero_lt_one ( Real.sqrt_pos.mpr ( by norm_num ) ) ) zero_lt_two ) ) ]

